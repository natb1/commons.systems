{
  "permissions": {
    "allow": [
      "Artifact",
      "Skill(file-issue)",
      "Skill(ref-issue-labels)",
      "Skill(ref-memory-management)",
      "Skill(ref-write-instructions)",
      "Skill(rsi-audit)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(tail:*)",
      "Bash(tee:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(gh api /repos/*/issues/*:*)",
      "Bash(gh api repos/*/issues/*:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(.claude/skills/rsi-audit/scripts/aggregate-usage.sh:*)",
      "Bash(.claude/skills/rsi-audit/scripts/test-aggregate-usage.sh:*)",
      "Bash(.claude/skills/file-issue/scripts/file-issue-usage-snapshot:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/post-pr-comment.sh:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-complete-phase:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-mark-complete:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-mark-deviation:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-mark-parse-job-done:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-open-pr:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-write-plan:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-write-phase-log:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-write-recommendation:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/commit-merge-push:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-plan-finalize:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-apply-planned:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-close-resolved:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-stamp-session:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/dispatch-context-pack:*)",
      "Bash(.claude/skills/dispatch-propagate/scripts/run-pr-checks-wait.sh:*)",
      "Bash(.github/scripts/check-type-safety-escapes.sh:*)",
      "Bash(packages/intentionsutil/scripts/graph-commit:*)",
      "Bash(packages/intentionsutil/scripts/land-align-round:*)",
      "Bash(gh search:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(node --import tsx/esm:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vite:*)",
      "Bash(npx vitest:*)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__claude-in-chrome__select_browser"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approve-artifact.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approve-workflow-commands.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dispatch-office-hours-strip.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dispatch-stop.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stamp-dispatch-session.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stamp-dispatch-session.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/apply-nix-env-config.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        ".git"
      ]
    }
  },
  "showClearContextOnPlanAccept": true
}
