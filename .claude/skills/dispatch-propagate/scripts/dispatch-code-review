#!/usr/bin/env bash
# dispatch-code-review — the verified `claude -p '/code-review ...'` invocation
# primitive for the /review-fix Step 1b exclusive pre-stage.
#
# Usage:
#   dispatch-code-review --target <rev-range> --out-dir <dir> \
#     [--effort low|medium|high|xhigh|max|ultra] [--no-comment]
#
#   --target      the diff target passed through to /code-review (the SKILL
#                 passes $MERGE_BASE). Validated against
#                 ^[A-Za-z0-9._/@^~-]+$ before being spliced into the prompt
#                 string, so it cannot inject additional CLI arguments.
#   --out-dir     directory for the durable artifacts (output.txt, fix.patch,
#                 touched-files.txt, summary.txt); created if absent.
#   --effort      default "low". See "Effort level" below — do not raise this
#                 default without new measurement.
#   --no-comment  omit --comment (used by the test suite; the SKILL never
#                 passes it).
#
# Effort level — why the default is "low", not "max" or "medium"
# -----------------------------------------------------------------------------
# The plan this script implements originally defaulted --effort to "max". Unit
# 1's measured investigation (references/code-review-invocation.md §1.2, §7)
# falsified that assumption:
#   - a `max`-effort review of a real, non-trivial diff ran >39 minutes and was
#     still incomplete when killed — $371 of price-proxy spend for ZERO bytes
#     of output. `claude -p` buffers all output until the run completes, so a
#     killed/timed-out run is a total loss, not a partial result.
#   - a `medium`-effort run against the same diff also did not complete within
#     300s (tested directly, main session, 2026-07-31).
#   - only `low` effort is measured to reliably complete: 14-30s observed,
#     ~$1.40-$1.77 price-proxy each (§5.4, §7).
# `low` is therefore the only effort level currently proven to fit this
# script's timeout budget. `medium`/`high`/`xhigh`/`max`/`ultra` remain
# available via --effort for callers who have their own measured basis for a
# larger timeout, but this script does not default to them. Effort-level
# tuning (is `low` good enough review depth for the dispatch lane, is there a
# workable middle ground) is an OPEN follow-up for strategy-token-economy —
# not settled by this script.
#
# Exit codes
# -----------------------------------------------------------------------------
#   0  invoked, verified, summary on stdout
#   1  `claude -p` exited non-zero
#   2  invalid arguments, or empty output
#   3  output carries a rejection / unavailability signature
#   4  timed out
set -euo pipefail

PROG="dispatch-code-review"

TARGET=""
OUT_DIR=""
EFFORT="low"
NO_COMMENT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --out-dir)
      OUT_DIR="${2:-}"
      shift 2
      ;;
    --effort)
      EFFORT="${2:-}"
      shift 2
      ;;
    --no-comment)
      NO_COMMENT=1
      shift
      ;;
    *)
      echo "$PROG: unknown argument '$1'" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  echo "$PROG: --target is required and must be non-empty" >&2
  exit 2
fi
if [[ -z "$OUT_DIR" ]]; then
  echo "$PROG: --out-dir is required and must be non-empty" >&2
  exit 2
fi

# Reject anything that could inject additional arguments into the `claude -p`
# prompt string via the spliced --target value.
if ! [[ "$TARGET" =~ ^[A-Za-z0-9._/@^~-]+$ ]]; then
  echo "$PROG: --target '$TARGET' contains characters outside the allowed set (^[A-Za-z0-9._/@^~-]+\$)" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"
OUT_DIR="$(cd "$OUT_DIR" && pwd)"

# The out-dir commonly lives inside the repo (the SKILL passes a "tmp/..."
# relative path), and this script writes its own artifacts into it
# (output.txt, fix.patch, touched-files.txt) before the touched-files diff
# runs. Those artifacts are not review edits and must never be attributed to
# the built-in — compute the out-dir's repo-relative path (when it is inside a
# repo) so both the untracked-file snapshots and the final tracked-diff list
# can exclude it.
OUT_DIR_REL=""
if GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  case "$OUT_DIR" in
    "$GIT_ROOT"/*)
      OUT_DIR_REL="${OUT_DIR#"$GIT_ROOT"/}"
      ;;
  esac
fi

SUMMARY_FILE="$OUT_DIR/summary.txt"
OUTPUT_FILE="$OUT_DIR/output.txt"
PATCH_FILE="$OUT_DIR/fix.patch"
TOUCHED_FILE="$OUT_DIR/touched-files.txt"
UNTRACKED_BEFORE_FILE="$OUT_DIR/untracked-before.txt"

# --- Step 1: resolve the CLI -------------------------------------------------
# Mirrors dispatch-spawn-job:221 (DISPATCH_SPAWN_JOB_CLAUDE_CMD) so the test
# suite can stub the CLI.
CLAUDE_CMD="${DISPATCH_CODE_REVIEW_CLAUDE_CMD:-claude}"

# --- Step 2: idempotent resume ------------------------------------------------
# The nested session is expensive; re-running a completed review on a resumed
# pass would double the cost and re-post duplicate --comment comments.
if [[ -f "$SUMMARY_FILE" ]] && grep -q '^status=ok$' "$SUMMARY_FILE"; then
  cat "$SUMMARY_FILE"
  exit 0
fi

# --- Step 3: capture the before-image ----------------------------------------
# `git stash create` writes a commit object capturing the worktree + index
# WITHOUT touching either, and prints nothing on a clean tree. This is the
# mechanical ground truth for "what the built-in changed" (strategy-token-economy
# clarification 25) — not any agent's self-report.
BEFORE=$(git stash create)
if [[ -z "$BEFORE" ]]; then
  BEFORE=$(git rev-parse HEAD)
fi

# `git stash create` does not capture untracked files; snapshot them separately
# so newly-untracked paths created by --fix can be unioned into touched-files.
git status --porcelain --untracked-files=all \
  | awk '$1=="??"{print $2}' >"$OUT_DIR/.untracked-before.raw"
if [[ -n "$OUT_DIR_REL" ]]; then
  grep -v -e "^${OUT_DIR_REL}/" -e "^${OUT_DIR_REL}\$" "$OUT_DIR/.untracked-before.raw" \
    | sort >"$UNTRACKED_BEFORE_FILE" || true
else
  sort "$OUT_DIR/.untracked-before.raw" >"$UNTRACKED_BEFORE_FILE"
fi
rm -f "$OUT_DIR/.untracked-before.raw"

# --- Step 4: invoke -----------------------------------------------------------
PROMPT="/code-review $EFFORT --fix"
if [[ -z "$NO_COMMENT" ]]; then
  PROMPT="$PROMPT --comment"
fi
PROMPT="$PROMPT $TARGET"

set +e
timeout "${DISPATCH_CODE_REVIEW_TIMEOUT:-540}"s \
  "$CLAUDE_CMD" -p "$PROMPT" --permission-mode acceptEdits \
  </dev/null >"$OUTPUT_FILE" 2>&1
rc=$?
set -e

# --- Step 5: verify at the source ---------------------------------------------
# Exit status PLUS output signature — exit status alone is never sufficient:
# an unavailable/unknown command exits 0 (references/code-review-invocation.md
# §8), so a rejection is detectable only by grepping the captured text.
OUTPUT_CONTENT="$(cat "$OUTPUT_FILE" 2>/dev/null || true)"
OUTPUT_STRIPPED="${OUTPUT_CONTENT//[[:space:]]/}"

# Reject patterns — corrected against Unit 1's measured findings
# (references/code-review-invocation.md §8), not the plan's original guesses:
#   - the literal "Unknown slash command" never appears; the real string is
#     "Unknown command: <command-name>" at exit 0. Prefix-match only — the CLI
#     echoes the caller-supplied command name after the colon, so the pattern
#     must never try to match the whole line.
#   - "cannot be used with Skill tool due to disable-model-invocation" is the
#     four-day silent-substitution regression signature — kept, not reproducible
#     via this entry point but retained as a regression guard.
#   - "use /review for a local review instead" is present as a literal string
#     in the 2.1.220 CLI binary though not observed at runtime in Unit 1.
REJECT_PATTERNS=(
  '^Unknown command: '
  'cannot be used with Skill tool due to disable-model-invocation'
  'use /review for a local review instead'
)

if [[ "$rc" -eq 124 ]]; then
  echo "$PROG: 'claude -p' timed out after ${DISPATCH_CODE_REVIEW_TIMEOUT:-540}s (target=$TARGET, effort=$EFFORT)" >&2
  echo "$OUTPUT_CONTENT" >&2
  exit 4
fi

if [[ "$rc" -ne 0 ]]; then
  echo "$PROG: 'claude -p' exited $rc" >&2
  echo "$OUTPUT_CONTENT" >&2
  exit 1
fi

if [[ -z "$OUTPUT_STRIPPED" ]]; then
  echo "$PROG: 'claude -p' produced empty output" >&2
  exit 2
fi

for pattern in "${REJECT_PATTERNS[@]}"; do
  if grep -qE "$pattern" "$OUTPUT_FILE"; then
    echo "$PROG: output matches rejection/unavailability signature: $pattern" >&2
    echo "$OUTPUT_CONTENT" >&2
    exit 3
  fi
done

# --- Step 6: derive the applied edits mechanically ----------------------------
# Never trust the review's self-report of what it fixed (Unit 1 §1.3: the
# built-in decides for itself whether to apply a fix, and can decline). The
# git diff against the before-image is the sole source of truth.
# Exclude the out-dir's own path (this script's artifacts: output.txt,
# fix.patch, touched-files.txt, summary.txt) from the tracked-diff list too —
# it commonly lives inside the repo, and those artifacts were written by this
# script in Step 4/this step, never by the review's --fix edits.
if [[ -n "$OUT_DIR_REL" ]]; then
  git diff --name-only "$BEFORE" \
    | grep -v -e "^${OUT_DIR_REL}/" -e "^${OUT_DIR_REL}\$" >"$TOUCHED_FILE" || true
else
  git diff --name-only "$BEFORE" >"$TOUCHED_FILE"
fi

git status --porcelain --untracked-files=all \
  | awk '$1=="??"{print $2}' >"$OUT_DIR/.untracked-after.raw"
if [[ -n "$OUT_DIR_REL" ]]; then
  grep -v -e "^${OUT_DIR_REL}/" -e "^${OUT_DIR_REL}\$" "$OUT_DIR/.untracked-after.raw" \
    | sort >"$OUT_DIR/.untracked-after.txt" || true
else
  sort "$OUT_DIR/.untracked-after.raw" >"$OUT_DIR/.untracked-after.txt"
fi
rm -f "$OUT_DIR/.untracked-after.raw"
comm -13 "$UNTRACKED_BEFORE_FILE" "$OUT_DIR/.untracked-after.txt" \
  >>"$TOUCHED_FILE" || true
rm -f "$OUT_DIR/.untracked-after.txt"

sort -u "$TOUCHED_FILE" -o "$TOUCHED_FILE"
# Drop a leading blank line comm/sort can leave behind on an empty union.
sed -i '/^$/d' "$TOUCHED_FILE"

git diff "$BEFORE" >"$PATCH_FILE"

# wc -l counts newlines, undercounting a final line with no trailing newline
# (git diff --name-only's own output ends in one, but the post-sort/sed rewrite
# above does not guarantee it survives) — grep -c '.' counts non-blank lines
# regardless of trailing-newline presence.
TOUCHED_COUNT=$(grep -c . "$TOUCHED_FILE" 2>/dev/null || true)
[[ -z "$TOUCHED_COUNT" ]] && TOUCHED_COUNT=0

# --- Step 7: emit the compact summary -----------------------------------------
{
  echo "status=ok"
  echo "exit_code=0"
  echo "findings_path=$OUTPUT_FILE"
  echo "patch_path=$PATCH_FILE"
  echo "touched_files_count=$TOUCHED_COUNT"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    echo "touched_file=$f"
  done <"$TOUCHED_FILE"
} >"$SUMMARY_FILE"

cat "$SUMMARY_FILE"
exit 0
