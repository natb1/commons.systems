#!/usr/bin/env bash
# Mark a dispatch workflow phase complete on a PR.
# Usage: dispatch-complete-phase <pr-num> <phase>
#
# Maps a completed phase to its accumulating dispatch:* progress label and
# applies it to the PR. (Ensure-label-exists-first then add-via-REST ordering is
# explained inline at the code below.)
#
# This script is the single source of truth for the dispatch:* label
# create metadata (color and description).
#
# Phase → label:
#   qa     → dispatch:qa-done
#   review → dispatch:reviewed
#
# Missing args or an unknown phase is a clear error, not a fallback.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

PR_NUM="${1:-}"
PHASE="${2:-}"

if [[ -z "$PR_NUM" || -z "$PHASE" ]]; then
  echo "error: usage: dispatch-complete-phase <pr-num> <phase>" >&2
  exit 1
fi

case "$PHASE" in
  qa)      LABEL="dispatch:qa-done" ;;
  review)  LABEL="dispatch:reviewed" ;;
  *)
    echo "error: unknown phase: $PHASE (expected qa or review)" >&2
    exit 1
    ;;
esac

# Ensure the label exists (idempotent), then add it via REST. `gh label create`
# stays porcelain (REST POST /repos/.../labels — not a migration target). Tolerate
# only an already-exists error; surface anything else rather than silently dropping
# the label. A PR is an issue in REST, so the labels POST targets issues/<PR>/labels.
SUFFIX="${LABEL#dispatch:}"
if ! create_out=$(gh label create "$LABEL" --color BFD4F2 \
    --description "dispatch workflow: $SUFFIX phase complete" 2>&1); then
  case "$create_out" in
    *already\ exists*|*already_exists*) : ;;   # label already present — fine
    *) echo "error: dispatch-complete-phase: gh label create failed: $create_out" >&2; exit 1 ;;
  esac
fi
gh_issue_set_labels_rest "$PR_NUM" "$LABEL"
