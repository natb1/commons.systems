#!/usr/bin/env bash
# dispatch-config-load — load and validate a local dispatch config file.
#
# Reads non-version-controlled config from a project-root dispatch.config/
# directory (outside every git worktree, shared across worktrees). Validates
# the parsed JSON against the schema for the requested config type and prints
# the normalized result to stdout.
#
# Usage:
#   dispatch-config-load <projects|jit|statements|target-workers|budget-etl|epic|auto-merge|force-opus|sweep>
#
# Config files live in <project-root>/dispatch.config/. The project root is
# resolved via resolve_project_root (lib.sh).
#
# Stdout protocol:
#   <normalized JSON>   file present and valid — prints jq-normalized JSON.
#   no-config           file absent — the feature is treated as inert.
#
# Exit codes:
#   0  valid JSON printed, or file absent (no-config).
#   1  file present but invalid JSON or fails schema validation.
#   2  usage error or environment misconfiguration.
#
# Environment overrides for testability:
#   DISPATCH_CONFIG_DIR   Override the config directory path. When set and
#                         non-empty, the script does NOT require a git repo.
#                         Default: <project-root>/dispatch.config/
#
# ---- Schema: projects.json --------------------------------------------------
#
# Top-level object with a required "projects" array. Each element is an object
# with these required fields:
#
#   key             string (non-empty) — local identifier for the project.
#   owner           string (non-empty) — GitHub org or user owning the project.
#   number          number             — GitHub project number.
#   statusField     string (non-empty) — name of the project's Status field.
#   statusInProgress string (non-empty) — Status option name for "in progress".
#   statusDone      string (non-empty) — Status option name for "done".
#
# Example (see projects.example.json):
#   {
#     "projects": [
#       { "key": "example-project", "owner": "example-owner", "number": 1,
#         "statusField": "Status", "statusInProgress": "In Progress",
#         "statusDone": "Done" }
#     ]
#   }
#
# ---- Schema: jit.json -------------------------------------------------------
#
# Top-level object with a required "jits" array. Each element is an object
# with these required fields:
#
#   key     string (non-empty) — unique identifier for the jit. Used as the
#           label suffix: the engine stamps "jit:<key>" on created issues.
#   repo    string (non-empty) — GitHub repo in "owner/repo" form.
#   label   string (non-empty) — full label name, typically "jit:<key>".
#   title   string (non-empty) — issue title.
#   body    string (non-empty) — issue body.
#   project string (non-empty) — "key" of an entry in projects.json.
#
# Optional timing fields (each must be a string if present):
#
#   remindAfterClose  duration string, e.g. "12h" — cadence jit: how long
#                     after the last closed issue to create the next one.
#   dueAfterClose     duration string, e.g. "24h" — cadence jit: due time
#                     offset from the last closed issue's closedAt.
#   dueAfterCreate    duration string — check-script jit: due time offset
#                     from the issue's createdAt.
#   debounce          duration string, e.g. "1h" — how often the jit engine
#                     re-checks this jit (skips network calls within window).
#   check             object with "script" (string) and optional "args" keys —
#                     check-script jit: run this script to decide whether to
#                     create an issue.
#
# Timing-field semantics (cadence vs check-script) are validated by the JIT
# engine, not here. This loader only checks types.
#
#   skill   string — optional; names a skill to run when this jit's reminder
#           is selected. Absent → the reminder is summarized and the job
#           stops. Not a timing field.
#
# Example (see jit.example.json):
#   {
#     "jits": [
#       { "key": "example-chore", "repo": "example-owner/example-repo",
#         "label": "jit:example-chore", "title": "Example recurring chore",
#         "body": "Recurring example chore. Close this issue when done.",
#         "project": "example-project",
#         "remindAfterClose": "12h", "dueAfterClose": "24h", "debounce": "1h" }
#     ]
#   }
#
# ---- Schema: statements.json -----------------------------------------------
#
# Top-level object with a required "statements" array. Each element is an object
# with these required fields:
#
#   key     string (non-empty) — local identifier for the scan entry. Also used
#           as the issue label suffix: the scan stamps "statements:<key>" on
#           filed parse-job issues.
#   dir     string (non-empty) — absolute path to the shared statements folder
#           to scan.
#   repo    string (non-empty) — GitHub repo in "owner/repo" form.
#   label   string (non-empty) — full label name stamped on filed parse-job
#           issues, typically "statements:<key>".
#   project string (non-empty) — "key" of an entry in projects.json.
#
# Optional fields (each must be the stated type if present):
#
#   debounce    string — duration string, e.g. "1h". How often the scan
#               re-checks this entry (local rate-limiter; skips network calls
#               within window).
#   extensions  array  — filename extensions to scan, e.g. ["qfx","ofx","csv",
#               "pdf"]. When absent the scan script applies its own default set.
#   snapshot    string — absolute path to the encrypted `.benc` snapshot that
#               the parse-job handler reads and overwrites in place.
#
# Example (see statements.example.json):
#   {
#     "statements": [
#       { "key": "example-bank", "dir": "/home/user/statements/example-bank",
#         "repo": "example-owner/example-repo",
#         "label": "statements:example-bank",
#         "project": "example-project",
#         "debounce": "1h", "extensions": ["qfx","ofx","csv","pdf"] }
#     ]
#   }
#
# ---- Schema: epic.json ------------------------------------------------------
#
# Top-level object with a required "labels" array. Each element is a non-empty
# string — the label name(s) that designate an issue as an epic.
#
#   labels    array (required) — list of label names that mark an issue as an
#             epic (e.g. ["epic"]). Each element must be a non-empty string.
#
# Example (see epic.example.json):
#   {
#     "labels": ["epic"]
#   }
#
# ---- Schema: target-workers.json -------------------------------------------
#
# Top-level object with optional tunables for `dispatch-target-workers`. Each
# field must be a number when present; absent fields fall back to the
# defaults baked into `dispatch-target-workers`. The six percentage fields
# must be in (0, 100]; weekly_curve_power, max_concurrent_workers, and
# weekly_terminal_windows must be > 0 with no upper bound (weekly_terminal_windows
# additionally must be >= 1, since it is a count of trailing 5-hour windows).
# Cross-field checks: two ordering checks fire only when both members of a pair
# are explicitly present (absent fields fall back to the script defaults, which
# the validator does not know) — five_hour_target_floor_pct <=
# five_hour_target_ceiling_pct, and exhaustion_threshold_pct >
# five_hour_target_ceiling_pct. A fourth check is the anchor-ordering constraint,
# which instead applies the algorithm defaults for any absent field (unlike the
# ordering checks), because the canonical misconfiguration sets
# weekly_pace_floor_pct alone: it rejects configs where weekly_pace_floor_pct >
# weekly_terminal_pct − weekly_increment_cap_pct · weekly_terminal_windows (the
# derived shoulder), under which the early-week floor would sit above the
# shoulder the rise climbs to. The Stage 1 pace curve is now an explicitly-
# anchored floor→shoulder→terminal max curve, monotone BY CONSTRUCTION, so no
# separate monotonicity check is needed.
#
#   weekly_pace_floor_pct          default 50   early-week floor
#   weekly_terminal_pct            default 100  envelope terminal W(1)
#   weekly_terminal_windows        default 2    count of trailing 5-hour windows
#                                               the terminal segment spans (>= 1)
#   weekly_increment_cap_pct       default 10   per-window hard ceiling
#   weekly_curve_power             default 1    convexity; >1 back-loads
#   five_hour_target_floor_pct     default 50   used_5h % at/below which workers
#                                               are max
#   five_hour_target_ceiling_pct   default 80   used_5h % at/above which workers
#                                               are zero
#   max_concurrent_workers         default 8
#   exhaustion_threshold_pct       default 98   used_% at/near 100 treated as genuine token exhaustion
#
# Example (see target-workers.example.json):
#   {
#     "weekly_pace_floor_pct": 50,
#     "weekly_terminal_pct": 100,
#     "weekly_terminal_windows": 2,
#     "weekly_increment_cap_pct": 10,
#     "weekly_curve_power": 1,
#     "five_hour_target_floor_pct": 50,
#     "five_hour_target_ceiling_pct": 80,
#     "max_concurrent_workers": 8,
#     "exhaustion_threshold_pct": 98
#   }
#
# ---- Schema: budget-etl.json -----------------------------------------------
#
# Top-level object with four required non-empty string path fields. Read by the
# config-driven /budget-etl skill; the paths are machine-specific and live in
# the uncommitted dispatch.config/budget-etl.json. Paths may contain spaces
# (e.g. "/mnt/g/My Drive/budget") and must be quoted by every consumer.
#
#   downloads    string (non-empty) — directory new statement files land in.
#   statements   string (non-empty) — root of the institution/account archive.
#   snapshotDir  string (non-empty) — directory holding immutable budget
#                snapshots (budget-<ts>.enc.json).
#   current      string (non-empty) — the authoritative current snapshot file,
#                kept equal to the newest snapshot; supplies rules + prior
#                transactions to each merge.
#
# Example (see budget-etl.example.json):
#   {
#     "downloads": "/mnt/c/Users/example/Downloads",
#     "statements": "/mnt/g/My Drive/budget/statements",
#     "snapshotDir": "/mnt/g/My Drive/budget/snapshots",
#     "current": "/mnt/g/My Drive/budget/budget.enc.json"
#   }
#
# ---- Schema: auto-merge.json -----------------------------------------------
#
# Top-level object gating the dispatch-auto-merge reconciler. Read by
# dispatch-auto-merge. UNLIKE every other config type, auto-merge INVERTS the
# generic absent→inert convention documented above (see "Stdout protocol"): an absent file
# → no-config → ARMED (auto-merge is ON by default). The file exists only as an
# opt-OUT kill-switch for incident response.
#
#   enabled       boolean (required when the file is present) — kill-switch.
#                 false turns auto-merging off; true (redundant with the absent-
#                 file default) keeps it on.
#
# Example (see auto-merge.example.json) — the kill-switch form:
#   {
#     "enabled": false
#   }
#
# ---- Schema: force-opus.json ------------------------------------------------
#
# Top-level object gating a manual Opus override for dispatch-spawned workers.
# This config type follows the GENERIC absent→inert convention (see "Stdout
# protocol" above): when the file is absent, no-config is emitted and the
# feature is OFF (inert) — workers use their normal model. Do NOT confuse this
# with auto-merge, which INVERTS that convention (absent → ON). force-opus
# does NOT invert; absent means OFF.
#
#   enabled       boolean (required when the file is present) — opt-in toggle.
#                 true forces all dispatch-spawned workers onto Opus; false
#                 (or file absent) leaves model selection at the default.
#
# Example (see force-opus.example.json) — the opt-in form:
#   {
#     "enabled": true
#   }
#
# ---- Schema: strict-preflight.json -----------------------------------------
#
# Top-level object gating the dispatch pre-spawn preflight gate.
# This config type follows the GENERIC absent→inert convention (see "Stdout
# protocol" above): when the file is absent, no-config is emitted and the
# feature is OFF (inert) — the preflight gate is disabled. Do NOT confuse this
# with auto-merge, which INVERTS that convention (absent → ON). strict-preflight
# does NOT invert; absent means OFF, the preflight gate is disabled.
#
#   enabled       boolean (required when the file is present) — opt-in toggle.
#                 true arms the pre-spawn preflight gate; false (or file absent)
#                 leaves it off.
#
# Example (see strict-preflight.example.json) — the opt-in form:
#   {
#     "enabled": true
#   }
#
# ---- Schema: sweep.json -----------------------------------------------------
#
# Top-level object with optional tunables for `dispatch-sweep`. Each field must
# be a number when present; absent fields fall back to the defaults baked into
# `dispatch-sweep`. This config type follows the GENERIC absent→inert convention
# (see "Stdout protocol" above): when the file is absent, no-config is emitted
# and the feature uses the consumer's built-in defaults.
#
#   notInSyncGraceSeconds   number (optional, must be > 0) — how long, in
#                           seconds, a not-in-sync worktree must remain in that
#                           state before dispatch-sweep reaps it. The default
#                           value (86400 = 24 h) is baked into dispatch-sweep,
#                           not here. Absent → dispatch-sweep uses its default.
#
# Example (see sweep.example.json):
#   {
#     "notInSyncGraceSeconds": 86400
#   }
#
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# ---- Step 0: parse arguments ------------------------------------------------

CONFIG_TYPE="${1:-}"
case "$CONFIG_TYPE" in
  projects|jit|statements|target-workers|budget-etl|epic|auto-merge|force-opus|strict-preflight|sweep) ;;
  *)
    echo "error: usage: dispatch-config-load <projects|jit|statements|target-workers|budget-etl|epic|auto-merge|force-opus|strict-preflight|sweep>" >&2
    exit 2
    ;;
esac

# ---- Step 1: resolve the config directory -----------------------------------
# An explicit DISPATCH_CONFIG_DIR is authoritative and bypasses the git lookup —
# tests rely on this. Otherwise the config lives at the shared project-root
# dispatch.config/ (not a per-worktree path) so all worktrees share one config.
# resolve_project_root (lib.sh) returns the project root in both classic (.git)
# and bare (.bare) layouts.
if [[ -n "${DISPATCH_CONFIG_DIR:-}" ]]; then
  CONFIG_DIR="$DISPATCH_CONFIG_DIR"
else
  PROJECT_ROOT=$(resolve_project_root) \
    || { echo "error: not in a git repo and DISPATCH_CONFIG_DIR is unset" >&2; exit 2; }
  CONFIG_DIR="$PROJECT_ROOT/dispatch.config"
fi

# ---- Step 2: locate the target file -----------------------------------------

CONFIG_FILE="$CONFIG_DIR/${CONFIG_TYPE}.json"

if [[ ! -e "$CONFIG_FILE" ]]; then
  echo "no-config"
  exit 0
fi

# ---- Step 3: parse and validate ---------------------------------------------

# Validate JSON syntax first. jq exits non-zero on invalid JSON; 2>&1 folds its
# error message into $PARSED so it can be surfaced without a temp file.
if ! PARSED=$(jq '.' "$CONFIG_FILE" 2>&1); then
  echo "error: $CONFIG_FILE: invalid JSON: $PARSED" >&2
  exit 1
fi

# An empty or whitespace-only file produces zero JSON values: jq '.' prints
# nothing and exits 0, leaving $PARSED empty. Treat that as malformed input.
if [[ -z "$PARSED" ]]; then
  echo "error: $CONFIG_FILE: file is empty or contains no JSON value" >&2
  exit 1
fi

# Run schema validation. The validator emits one error-description line per
# problem and nothing when the config is valid.
case "$CONFIG_TYPE" in
  projects)
    ERRORS=$(jq -r '
      # top-level value must be an object; .projects must be an array
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      elif (.projects | type) != "array" then
        "top-level .projects must be an array, got \(.projects | type)"
      else
        .projects | to_entries[] |
        .value as $item |
        (.key + 1) as $idx |
        if ($item | type) != "object" then
          "projects[\($idx)]: must be an object, got \($item | type)"
        else
          # required string fields (non-empty)
          (["key","owner","statusField","statusInProgress","statusDone"] |
          .[] |
          . as $field |
          if ($item | has($field)) | not then
            "projects[\($idx)]: missing required field \($field)"
          elif ($item[$field] | type) != "string" then
            "projects[\($idx)]: \($field) must be a string, got \($item[$field] | type)"
          elif ($item[$field] | length) == 0 then
            "projects[\($idx)]: \($field) must be a non-empty string"
          else
            empty
          end),
          # required number field
          if ($item | has("number")) | not then
            "projects[\($idx)]: missing required field number"
          elif ($item["number"] | type) != "number" then
            "projects[\($idx)]: number must be a number, got \($item["number"] | type)"
          else
            empty
          end
        end
      end
    ' "$CONFIG_FILE")
    ;;
  jit)
    ERRORS=$(jq -r '
      # top-level value must be an object; .jits must be an array
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      elif (.jits | type) != "array" then
        "top-level .jits must be an array, got \(.jits | type)"
      else
        .jits | to_entries[] |
        .value as $item |
        (.key + 1) as $idx |
        if ($item | type) != "object" then
          "jits[\($idx)]: must be an object, got \($item | type)"
        else
          # required string fields (non-empty)
          (["key","repo","label","title","body","project"] |
          .[] |
          . as $field |
          if ($item | has($field)) | not then
            "jits[\($idx)]: missing required field \($field)"
          elif ($item[$field] | type) != "string" then
            "jits[\($idx)]: \($field) must be a string, got \($item[$field] | type)"
          elif ($item[$field] | length) == 0 then
            "jits[\($idx)]: \($field) must be a non-empty string"
          else
            empty
          end),
          # optional string fields — must be strings if present
          (["remindAfterClose","dueAfterClose","dueAfterCreate","debounce","skill"] |
          .[] |
          . as $field |
          if ($item | has($field)) and ($item[$field] | type) != "string" then
            "jits[\($idx)]: \($field) must be a string if present, got \($item[$field] | type)"
          else
            empty
          end),
          # skill, if present, names a skill the jit-reminder path invokes via
          # the Skill tool — constrain it to a skill-name slug so a malformed
          # value is rejected at config load rather than reaching the caller.
          (if ($item | has("skill")) and (($item.skill | type) == "string")
              and (($item.skill | test("^[a-z][a-z0-9-]*$")) | not) then
            "jits[\($idx)]: skill must be a lowercase skill-name slug (^[a-z][a-z0-9-]*$), got \"\($item.skill)\""
          else
            empty
          end)
        end
      end
    ' "$CONFIG_FILE")
    ;;
  statements)
    ERRORS=$(jq -r '
      # top-level value must be an object; .statements must be an array
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      elif (.statements | type) != "array" then
        "top-level .statements must be an array, got \(.statements | type)"
      else
        .statements | to_entries[] |
        .value as $item |
        (.key + 1) as $idx |
        if ($item | type) != "object" then
          "statements[\($idx)]: must be an object, got \($item | type)"
        else
          # required string fields (non-empty)
          (["key","dir","repo","label","project"] |
          .[] |
          . as $field |
          if ($item | has($field)) | not then
            "statements[\($idx)]: missing required field \($field)"
          elif ($item[$field] | type) != "string" then
            "statements[\($idx)]: \($field) must be a string, got \($item[$field] | type)"
          elif ($item[$field] | length) == 0 then
            "statements[\($idx)]: \($field) must be a non-empty string"
          else
            empty
          end),
          # optional string fields — must be strings if present
          (["debounce","snapshot"] |
          .[] |
          . as $field |
          if ($item | has($field)) and ($item[$field] | type) != "string" then
            "statements[\($idx)]: \($field) must be a string if present, got \($item[$field] | type)"
          else
            empty
          end),
          # optional array field: extensions
          (if ($item | has("extensions")) and ($item.extensions | type) != "array" then
            "statements[\($idx)]: extensions must be an array if present, got \($item.extensions | type)"
          else empty end)
        end
      end
    ' "$CONFIG_FILE")
    ;;
  epic)
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      elif (.labels | type) != "array" then
        "top-level .labels must be an array, got \(.labels | type)"
      else
        .labels | to_entries[] |
        .value as $item |
        (.key + 1) as $idx |
        if ($item | type) != "string" then
          "labels[\($idx)]: must be a string, got \($item | type)"
        elif ($item | length) == 0 then
          "labels[\($idx)]: must be a non-empty string"
        else
          empty
        end
      end
    ' "$CONFIG_FILE")
    ;;
  auto-merge)
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        # enabled: required boolean
        (if ($cfg | has("enabled")) | not then
          "missing required field enabled"
        elif ($cfg.enabled | type) != "boolean" then
          "enabled must be a boolean, got \($cfg.enabled | type)"
        else empty end)
      end
    ' "$CONFIG_FILE")
    ;;
  force-opus)
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        # enabled: required boolean
        (if ($cfg | has("enabled")) | not then
          "missing required field enabled"
        elif ($cfg.enabled | type) != "boolean" then
          "enabled must be a boolean, got \($cfg.enabled | type)"
        else empty end)
      end
    ' "$CONFIG_FILE")
    ;;
  strict-preflight)
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        # enabled: required boolean
        (if ($cfg | has("enabled")) | not then
          "missing required field enabled"
        elif ($cfg.enabled | type) != "boolean" then
          "enabled must be a boolean, got \($cfg.enabled | type)"
        else empty end)
      end
    ' "$CONFIG_FILE")
    ;;
  target-workers)
    # top-level value must be an object; all tunables are optional numbers.
    # `dispatch-target-workers` substitutes a baked-in default for any field
    # absent here, so absence is silent — only the type of present fields is
    # checked. The six percentage fields carry an additional `<= 100` bound;
    # weekly_curve_power, max_concurrent_workers, and weekly_terminal_windows
    # have no upper bound (weekly_terminal_windows additionally must be >= 1).
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        (["weekly_pace_floor_pct","weekly_terminal_pct",
          "weekly_terminal_windows",
          "weekly_increment_cap_pct","weekly_curve_power",
          "five_hour_target_floor_pct",
          "five_hour_target_ceiling_pct",
          "max_concurrent_workers",
          "exhaustion_threshold_pct"] |
         .[] |
         . as $field |
         # The percentage fields are bounded (0, 100]; the others are
         # unbounded above.
         ([ "weekly_pace_floor_pct","weekly_terminal_pct",
            "weekly_increment_cap_pct",
            "five_hour_target_floor_pct","five_hour_target_ceiling_pct",
            "exhaustion_threshold_pct" ]
            | index($field)) as $is_pct |
         if ($cfg | has($field)) | not then
           empty
         elif ($cfg[$field] | type) != "number" then
           "\($field) must be a number if present, got \($cfg[$field] | type)"
         elif $cfg[$field] <= 0 then
           "\($field) must be > 0 if present, got \($cfg[$field])"
         elif ($is_pct != null and $cfg[$field] > 100) then
           "\($field) must be <= 100 if present, got \($cfg[$field])"
         else
           empty
         end),
        # Cross-field ordering checks. Only fire when both members of a pair
        # are explicitly present and numeric — absent fields fall back to the
        # baked-in script defaults, which the validator does not know. An
        # inverted floor/ceiling pair otherwise validates field-by-field yet
        # silently breaks the pace curve (floor > cap spikes W; floor5 > ceil5
        # inverts the F band).
        (if ($cfg | has("weekly_terminal_windows"))
            and ($cfg.weekly_terminal_windows | type) == "number"
            and ($cfg.weekly_terminal_windows < 1)
         then "weekly_terminal_windows must be >= 1 (it is a count of trailing 5-hour windows), got \($cfg.weekly_terminal_windows)"
         else empty end),
        (if ($cfg | has("five_hour_target_floor_pct"))
            and ($cfg | has("five_hour_target_ceiling_pct"))
            and ($cfg.five_hour_target_floor_pct | type) == "number"
            and ($cfg.five_hour_target_ceiling_pct | type) == "number"
            and ($cfg.five_hour_target_floor_pct > $cfg.five_hour_target_ceiling_pct)
         then "five_hour_target_floor_pct must be <= five_hour_target_ceiling_pct, got floor \($cfg.five_hour_target_floor_pct) > ceiling \($cfg.five_hour_target_ceiling_pct)"
         else empty end),
        (if ($cfg | has("exhaustion_threshold_pct"))
            and ($cfg | has("five_hour_target_ceiling_pct"))
            and ($cfg.exhaustion_threshold_pct | type) == "number"
            and ($cfg.five_hour_target_ceiling_pct | type) == "number"
            and ($cfg.exhaustion_threshold_pct <= $cfg.five_hour_target_ceiling_pct)
         then "exhaustion_threshold_pct must be > five_hour_target_ceiling_pct (the override band collapses otherwise), got threshold \($cfg.exhaustion_threshold_pct) <= ceiling \($cfg.five_hour_target_ceiling_pct)"
         else empty end),
        # Anchor-ordering constraint. The Stage 1 pace curve is now an explicitly-
        # anchored floor→shoulder→terminal max curve, monotone BY CONSTRUCTION (a max
        # of monotone pieces), so the old #930/#1226 curve-monotonicity validator is
        # no longer needed. The only admissibility the validator must enforce is anchor
        # ordering: the early-week floor must not exceed the derived shoulder
        #   shoulder = weekly_terminal_pct − weekly_increment_cap_pct · weekly_terminal_windows
        # (otherwise the floor would sit above the shoulder the rise climbs to). Like
        # the old monotonicity check, this APPLIES the algorithm defaults for any absent
        # field (the canonical misconfiguration sets weekly_pace_floor_pct alone), so
        # `//` covers absence; a present-but-non-numeric field is skipped here (the
        # per-field type check above already flags it), guarded by explicit number-type
        # tests.
        (if ((($cfg.weekly_pace_floor_pct // 50) | type) == "number")
            and ((($cfg.weekly_terminal_pct // 100) | type) == "number")
            and ((($cfg.weekly_increment_cap_pct // 10) | type) == "number")
            and ((($cfg.weekly_terminal_windows // 2) | type) == "number")
         then
           ($cfg.weekly_pace_floor_pct // 50) as $floor |
           ($cfg.weekly_terminal_pct // 100) as $terminal |
           ($cfg.weekly_increment_cap_pct // 10) as $cap |
           ($cfg.weekly_terminal_windows // 2) as $nterm |
           ($terminal - $cap * $nterm) as $shoulder |
           if $floor > $shoulder then
             "weekly_pace_floor_pct (effective \($floor)) exceeds the derived shoulder \($shoulder) (= weekly_terminal_pct − weekly_increment_cap_pct · weekly_terminal_windows = \($terminal) − \($cap)·\($nterm)); the early-week floor would sit above the shoulder the rise climbs to. Lower weekly_pace_floor_pct, or raise weekly_terminal_pct / lower weekly_increment_cap_pct · weekly_terminal_windows."
           else empty end
         else empty end)
      end
    ' "$CONFIG_FILE")
    ;;
  budget-etl)
    # top-level value must be an object; four required non-empty string path
    # fields. Paths may contain spaces. Each must be an absolute path with no
    # ".." component — these values become filesystem destinations the budget-etl
    # skill writes to and reads bank statements from, so a relative or
    # parent-traversing path could redirect those writes outside the intended
    # Drive mount.
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        (["downloads","statements","snapshotDir","current"] |
         .[] |
         . as $field |
         if ($cfg | has($field)) | not then
           "missing required field \($field)"
         elif ($cfg[$field] | type) != "string" then
           "\($field) must be a string, got \($cfg[$field] | type)"
         elif ($cfg[$field] | length) == 0 then
           "\($field) must be a non-empty string"
         elif ($cfg[$field] | startswith("/") | not) then
           "\($field) must be an absolute path (start with /), got \($cfg[$field])"
         elif ($cfg[$field] | test("(^|/)\\.\\.(/|$)")) then
           "\($field) must not contain a \"..\" path component, got \($cfg[$field])"
         else
           empty
         end)
      end
    ' "$CONFIG_FILE")
    ;;
  sweep)
    # top-level value must be an object; all tunables are optional.
    # `dispatch-sweep` substitutes a baked-in default for any absent field, so
    # absence is silent — only the type of present fields is checked.
    ERRORS=$(jq -r '
      if type != "object" then
        "top-level value must be a JSON object, got \(type)"
      else
        . as $cfg |
        # notInSyncGraceSeconds: optional positive number
        (if ($cfg | has("notInSyncGraceSeconds")) | not then
          empty
        elif ($cfg.notInSyncGraceSeconds | type) != "number" then
          "notInSyncGraceSeconds must be a number if present, got \($cfg.notInSyncGraceSeconds | type)"
        elif $cfg.notInSyncGraceSeconds <= 0 then
          "notInSyncGraceSeconds must be > 0 if present, got \($cfg.notInSyncGraceSeconds)"
        elif ($cfg.notInSyncGraceSeconds | tostring | test("^[0-9]+$") | not) then
          # Mirror the env-override contract (^[0-9]+$): reject any value whose
          # rendered form is not a plain integer. This catches fractions (0.5)
          # and scientific notation (1e6 -> jq renders "1E+6"); both would reach
          # the dispatch-sweep bash `[[ "$age" -lt "$NOT_IN_SYNC_GRACE_S" ]]`
          # integer comparison, raise an arithmetic error, and fall through to
          # the reap branch — immediately force-reaping every not-in-sync worktree.
          "notInSyncGraceSeconds must be a whole number (integer), got \($cfg.notInSyncGraceSeconds)"
        else
          empty
        end)
      end
    ' "$CONFIG_FILE")
    ;;
esac

if [[ -n "$ERRORS" ]]; then
  while IFS= read -r line; do
    echo "error: $CONFIG_FILE: $line" >&2
  done <<< "$ERRORS"
  exit 1
fi

# ---- Step 4: print normalized JSON ------------------------------------------

printf '%s\n' "$PARSED"
