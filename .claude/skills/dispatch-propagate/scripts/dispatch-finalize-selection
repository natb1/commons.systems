#!/usr/bin/env bash
# dispatch-finalize-selection <worktree-path> — canonical Step 5 proceed-path
# exit. Takes the target worktree path as its one required argument, `cd`s into
# it, and writes the `tmp/dispatch-worktree` marker that signals "Step 5
# completed" (the lock script reads it on subsequent ticks to reclaim a
# marker-bearing foreign holder). The cd-first contract ensures the marker lands
# in the target worktree, not the caller's cwd. This script no longer releases
# the lock: the caller (dispatch-materialize-spawn) holds it through the spawn
# and releases it after the worker registers, closing the boot-gap re-selection
# race (#945). See `.claude/skills/dispatch-propagate/SKILL.md` Step 5 and
# reference.md "Releasing the lock".
#
# The marker carries the finalizing (holder) session's CLAUDE_CODE_SESSION_ID,
# not an empty flag: dispatch-acquire-lock reclaims a live foreign holder via
# the marker ONLY when the marker's content equals the recorded holder's
# sessionId. Writing our own session id here is what makes the marker name the
# recorded holder (this script runs in the holder's own context). An empty
# marker — e.g. the `touch` stamped by .claude/hooks/worktree-create.sh on
# every worktree creation — never reclaims a live mid-selection holder.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "dispatch-finalize-selection: missing required <worktree-path> argument" >&2
  exit 2
fi
if [[ $# -gt 1 ]]; then
  echo "dispatch-finalize-selection: unexpected extra arguments after <worktree-path>" >&2
  exit 2
fi
if [[ "$1" == -* ]]; then
  echo "dispatch-finalize-selection: flag-shaped argument '$1' is not a worktree path" >&2
  exit 2
fi

WORKTREE="$1"
cd "$WORKTREE" || {
  echo "dispatch-finalize-selection: cannot cd to '$WORKTREE'" >&2
  exit 2
}

# The marker is session-scoped: it names the finalizing holder so the lock can
# distinguish "THIS recorded holder finished Step 5" from a stale empty marker.
# An unset CLAUDE_CODE_SESSION_ID is a misconfigured environment — fail clear
# rather than write an inert empty marker.
SESSION_ID="${CLAUDE_CODE_SESSION_ID:-}"
[[ -n "$SESSION_ID" ]] || {
  echo "dispatch-finalize-selection: CLAUDE_CODE_SESSION_ID is unset" >&2
  exit 2
}

mkdir -p tmp
printf '%s\n' "$SESSION_ID" > tmp/dispatch-worktree
