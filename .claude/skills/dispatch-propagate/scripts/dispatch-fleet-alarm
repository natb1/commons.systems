#!/usr/bin/env bash
#
# dispatch-fleet-alarm — the shared alarm surface for out-of-band fleet-health
# readings.
#
# A fleet instrument (a watcher that reads the tick journal / daemon liveness,
# or a healer that fired a recovery action) turns its reading into a GRAPH NODE
# through this script, never into journald alone: journald is not a work queue
# and nothing in the fleet reads it back. One node per condition kind, found or
# created idempotently, its body refreshed on re-detection, completed when the
# condition definitively clears.
#
# Usage:
#   dispatch-fleet-alarm --kind <kind> --statement <text> --body-file <path>
#   dispatch-fleet-alarm --resolve --kind <kind>
#   dispatch-fleet-alarm -h|--help
#
# <kind> is a CLOSED enum (see KINDS below). Anything else exits 64 — an alarm
# surface with an open-ended id space would mint unbounded node ids from a
# caller typo.
#
# Node id: tactic-fleet-alarm-<kind>. Stable per condition kind, so find-or-
# create is idempotent: one open node per ongoing condition. The id shape is
# guarded by an ANCHORED regex built from the enum, never a bare prefix test —
# a bare `tactic-main-red-` startsWith test in dispatch-graph-main-red-sync once
# matched an unrelated hand-authored node and mechanically auto-completed it to
# phase:"done" (see that script's lines 52-58).
#
# Find-or-create follows the canonical recipe in
# .claude/skills/dispatch-diagnose-main/SKILL.md (lines 84-218): readNode
# classification (frontmatter only, never the body), then either the
# write-node.ts --file -> awk body-splice -> graph-commit mint path (absent or
# closed), or the dump-node.ts -> cmp -s -> graph-commit --base re-detection
# path (open), which SKIPS the commit entirely when the fresh body matches the
# on-disk body — a re-detection that finds the same condition must not churn a
# no-op commit.
#
# Exit codes:
#   0   the alarm landed; or a re-detection found no body diff (no commit); or
#       --resolve found nothing open to resolve.
#   1   the graph write failed (after retries), or the post-write blob
#       verification did not confirm the write on origin/main. The caller
#       degrades to journald-only for that pass — but must still report this
#       graph-write failure in its own output.
#   64  usage error / unknown kind.
#   69  environment error (missing node/npx/git/jq).
#
# graph-commit exiting 0 is NOT evidence anything landed (a named invariant in
# this codebase: a check whose failure mode is a silent PASS — graph-commit has
# a documented "nothing to push" rc-0 sub-case, and a wrong-repo invocation can
# exit 0 having landed nothing). Every successful commit here is followed by a
# blob comparison of intentions/<id>.md on origin/main against the local
# `git hash-object`; a mismatch is exit 1, not exit 0.
#
# NEVER FLEET-HALT: this script writes exactly intentions/<id>.md for its own
# alarm id and nothing else. It does not write blocked_by on any other node, it
# does not touch the pause sentinel, and it does not write office_hours on any
# node. A fleet instrument's job is to record a finding, not to stop the fleet.
#
# Dependency-injection seams (unset in production; used by
# test-dispatch-fleet-alarm.sh so the suite never touches the real graph or a
# real git remote). Each holds a command line, split on whitespace — the paths
# must not contain spaces:
#   DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD  default: <repo>/packages/intentionsutil/scripts/graph-commit
#   DISPATCH_FLEET_ALARM_WRITE_NODE_CMD    default: npx tsx <repo>/packages/intentionsutil/scripts/write-node.ts
#   DISPATCH_FLEET_ALARM_DUMP_NODE_CMD     default: npx tsx <repo>/packages/intentionsutil/scripts/dump-node.ts
#   DISPATCH_FLEET_ALARM_CLASSIFY_CMD      default: the node --import tsx/esm readNode one-liner below
#   DISPATCH_FLEET_ALARM_INTENTIONS_DIR    default: <repo>/intentions
#   DISPATCH_FLEET_ALARM_RETRIES           default: 3   (graph-commit attempts)
#   DISPATCH_FLEET_ALARM_RETRY_DELAY       default: 5   (seconds between attempts)
#
# NOT set -e: every risky step is guarded explicitly so the script always
# reaches an intentional exit (same convention as sibling
# dispatch-graph-main-red-sync).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# scripts -> dispatch-propagate -> skills -> .claude -> repo root (same
# convention as sibling dispatch-graph-main-red-sync lines 44-46).
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# The closed enum of alarm kinds. Extending it is a deliberate edit here.
KINDS=(tick-stale daemon-degraded busy-stall automerge-suppressed watch-unknown heal-fired heal-unknown)

usage() {
  cat <<'USAGE'
usage: dispatch-fleet-alarm --kind <kind> --statement <text> --body-file <path>
       dispatch-fleet-alarm --resolve --kind <kind>
       dispatch-fleet-alarm -h|--help

kinds: tick-stale daemon-degraded busy-stall automerge-suppressed
       watch-unknown heal-fired heal-unknown

Records an out-of-band fleet-health reading as the graph node
tactic-fleet-alarm-<kind> (find-or-create; body refreshed on re-detection).
--resolve completes an open alarm node to phase: "done" when its condition has
definitively cleared.

exit: 0 landed / no-op, 1 graph write failed, 64 usage, 69 environment.
USAGE
}

log() { printf 'dispatch-fleet-alarm: %s\n' "$*" >&2; }

# --- Argument parsing --------------------------------------------------------
KIND=""
STATEMENT=""
BODY_FILE=""
RESOLVE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --kind)
      [[ $# -ge 2 ]] || { log "--kind requires a value"; usage >&2; exit 64; }
      KIND="$2"; shift 2 ;;
    --statement)
      [[ $# -ge 2 ]] || { log "--statement requires a value"; usage >&2; exit 64; }
      STATEMENT="$2"; shift 2 ;;
    --body-file)
      [[ $# -ge 2 ]] || { log "--body-file requires a value"; usage >&2; exit 64; }
      BODY_FILE="$2"; shift 2 ;;
    --resolve) RESOLVE=1; shift ;;
    *) log "unknown argument: $1"; usage >&2; exit 64 ;;
  esac
done

[[ -n "$KIND" ]] || { log "--kind is required"; usage >&2; exit 64; }

# Closed-enum membership check.
KIND_OK=0
for k in "${KINDS[@]}"; do [[ "$k" == "$KIND" ]] && KIND_OK=1; done
if [[ "$KIND_OK" != "1" ]]; then
  log "unknown kind '$KIND' (allowed: ${KINDS[*]})"
  exit 64
fi

ID="tactic-fleet-alarm-$KIND"

# Anchored id guard built from the enum — NOT a prefix test. Belt-and-braces
# with the membership check above: nothing but an exact enum id may ever reach
# the write paths below.
KIND_ALT="$(IFS='|'; printf '%s' "${KINDS[*]}")"
ID_RE="^tactic-fleet-alarm-(${KIND_ALT})$"
if [[ ! "$ID" =~ $ID_RE ]]; then
  log "refusing to act on id '$ID' — it does not match the anchored alarm-id shape $ID_RE"
  exit 64
fi

if [[ "$RESOLVE" == "1" ]]; then
  if [[ -n "$STATEMENT" || -n "$BODY_FILE" ]]; then
    log "--resolve takes only --kind (no --statement / --body-file)"
    exit 64
  fi
else
  [[ -n "$STATEMENT" ]] || { log "--statement is required (or pass --resolve)"; usage >&2; exit 64; }
  [[ -n "$BODY_FILE" ]] || { log "--body-file is required (or pass --resolve)"; usage >&2; exit 64; }
  [[ -f "$BODY_FILE" ]] || { log "--body-file '$BODY_FILE' does not exist"; exit 64; }
fi

# --- Environment -------------------------------------------------------------
for bin in git jq node npx; do
  command -v "$bin" >/dev/null 2>&1 || { log "required command '$bin' not found on PATH"; exit 69; }
done

INTENTIONS_DIR="${DISPATCH_FLEET_ALARM_INTENTIONS_DIR:-$REPO_ROOT/intentions}"
NODE_FILE="$INTENTIONS_DIR/$ID.md"
# The path git sees. graph-commit stages exactly `intentions/<id>.md` relative
# to the repo it resolves, so origin/main lookups always use that spelling.
NODE_REL="intentions/$ID.md"

RETRIES="${DISPATCH_FLEET_ALARM_RETRIES:-3}"
RETRY_DELAY="${DISPATCH_FLEET_ALARM_RETRY_DELAY:-5}"

# Command seams. `read -r -a` splits on whitespace; production defaults contain
# no spaces (see the header note).
declare -a GRAPH_COMMIT_CMD WRITE_NODE_CMD DUMP_NODE_CMD CLASSIFY_CMD
if [[ -n "${DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD:-}" ]]; then
  read -r -a GRAPH_COMMIT_CMD <<<"$DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD"
else
  GRAPH_COMMIT_CMD=("$REPO_ROOT/packages/intentionsutil/scripts/graph-commit")
fi
# write-node.ts / dump-node.ts resolve intentions/ from import.meta.url, NOT
# cwd — so the copies invoked must be the ones inside the checkout being
# mutated. Hence the absolute $REPO_ROOT-anchored paths.
if [[ -n "${DISPATCH_FLEET_ALARM_WRITE_NODE_CMD:-}" ]]; then
  read -r -a WRITE_NODE_CMD <<<"$DISPATCH_FLEET_ALARM_WRITE_NODE_CMD"
else
  WRITE_NODE_CMD=(npx tsx "$REPO_ROOT/packages/intentionsutil/scripts/write-node.ts")
fi
if [[ -n "${DISPATCH_FLEET_ALARM_DUMP_NODE_CMD:-}" ]]; then
  read -r -a DUMP_NODE_CMD <<<"$DISPATCH_FLEET_ALARM_DUMP_NODE_CMD"
else
  DUMP_NODE_CMD=(npx tsx "$REPO_ROOT/packages/intentionsutil/scripts/dump-node.ts")
fi
if [[ -n "${DISPATCH_FLEET_ALARM_CLASSIFY_CMD:-}" ]]; then
  read -r -a CLASSIFY_CMD <<<"$DISPATCH_FLEET_ALARM_CLASSIFY_CMD"
else
  CLASSIFY_CMD=()
fi

# --- Helpers -----------------------------------------------------------------

# classify <id> -> prints absent | open | closed
# readNode reads only the YAML frontmatter, so classification never touches the
# body. done, or parked in office_hours, is a since-resolved node -> closed; a
# throw (no such file) -> absent.
classify() {
  if [[ ${#CLASSIFY_CMD[@]} -gt 0 ]]; then
    "${CLASSIFY_CMD[@]}" "$1"
    return
  fi
  (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { readNode } = await import("./packages/intentionsutil/src/store.js");
    try {
      const n = readNode(process.argv[1], process.argv[2]);
      process.stdout.write((n.phase === "done" || n.office_hours !== null) ? "closed\n" : "open\n");
    } catch {
      process.stdout.write("absent\n");
    }
  ' "$INTENTIONS_DIR" "$1")
}

# origin_blob -> prints the origin/main blob sha of the node file, or fails.
origin_blob() {
  git -C "$REPO_ROOT" rev-parse "origin/main:$NODE_REL" 2>/dev/null
}

# restore_from_blob <sha> — put the node file back to its origin/main content so
# a failed write never leaks a dirty intentions/ file (which would trip
# graph-commit's clean-tree assertion for every later writer).
restore_from_blob() {
  git -C "$REPO_ROOT" show "$1" > "$NODE_FILE"
}

# splice_body — replace everything after the closing frontmatter fence with the
# reading. write-node.ts gives a brand-new file the generated `# <statement>`
# placeholder body; bodies are durable and preserved on every later rewrite, so
# the splice is what puts the reading in. (The two-fence awk idiom, verbatim
# from dispatch-diagnose-main/SKILL.md:178-187.)
splice_body() {
  { awk '{print} /^---$/{c++; if(c==2) exit}' "$NODE_FILE"; cat "$BODY_FILE"; } > "$NODE_FILE.tmp" \
    && mv "$NODE_FILE.tmp" "$NODE_FILE"
}

# run_graph_commit <args...> — bounded retry around the landing primitive. All
# of graph-commit's chatter goes to stderr; this script's stdout stays quiet.
run_graph_commit() {
  local attempt=1
  while :; do
    if "${GRAPH_COMMIT_CMD[@]}" -C "$REPO_ROOT" "$@" 1>&2; then
      return 0
    fi
    if (( attempt >= RETRIES )); then
      log "graph-commit failed after $attempt attempt(s)"
      return 1
    fi
    attempt=$((attempt + 1))
    [[ "$RETRY_DELAY" == "0" ]] || sleep "$RETRY_DELAY"
  done
}

# verify_landed — graph-commit exit 0 is not evidence anything landed. Confirm
# by comparing the node's blob on origin/main against the local file's hash.
verify_landed() {
  # Refresh the remote-tracking ref where possible; the comparison itself is
  # authoritative, so a fetch failure is reported, not fatal.
  if ! git -C "$REPO_ROOT" fetch --quiet origin main 2>/dev/null; then
    log "could not fetch origin/main before verification; comparing against the local remote-tracking ref"
  fi
  local local_blob remote_blob
  if ! local_blob=$(git -C "$REPO_ROOT" hash-object -- "$NODE_FILE"); then
    log "could not hash $NODE_FILE for post-write verification"
    return 1
  fi
  if ! remote_blob=$(origin_blob) || [[ -z "$remote_blob" ]]; then
    log "post-write verification failed: $NODE_REL is absent from origin/main after a graph-commit that exited 0"
    return 1
  fi
  if [[ "$remote_blob" != "$local_blob" ]]; then
    log "post-write verification failed: origin/main:$NODE_REL is $remote_blob but the local write hashes to $local_blob — graph-commit exited 0 without landing this content"
    return 1
  fi
  return 0
}

TMP_DIR=""
cleanup() { [[ -n "$TMP_DIR" ]] && rm -rf "$TMP_DIR"; }
trap cleanup EXIT
TMP_DIR=$(mktemp -d) || { log "mktemp failed"; exit 69; }

STATE=$(classify "$ID") || {
  log "graph read of $ID failed — cannot classify the alarm node"
  exit 1
}
STATE="${STATE//[$'\t\r\n ']/}"

# --- --resolve ---------------------------------------------------------------
# Complete an open alarm node to phase: "done" when its condition has
# definitively cleared, so alarms do not accumulate. Only a DEFINITE clear
# resolves — the caller decides that; this script has no notion of an
# "unknown" reading, so an unknown reading simply never calls --resolve.
# Structure copied from dispatch-graph-main-red-sync lines 95-160, including its
# three load-bearing guards.
if [[ "$RESOLVE" == "1" ]]; then
  if [[ "$STATE" != "open" ]]; then
    log "no open $ID to resolve (state: $STATE) — nothing to do"
    exit 0
  fi

  MANIFEST=$( (cd "$REPO_ROOT" && "${DUMP_NODE_CMD[@]}" --out-dir "$TMP_DIR" "$ID") ) || {
    log "dump-node of $ID failed; cannot resolve"
    exit 1
  }

  # Guard 1: only when execution is null. A node past draft with a live
  # execution is an in-flight fix owning its own PR/qa/review lifecycle;
  # mechanical completion must never preempt it.
  if ! jq -e '.execution == null' "$TMP_DIR/$ID.json" >/dev/null 2>&1; then
    log "$ID has a non-null execution (an in-flight fix owns its lifecycle) — refusing to complete it mechanically"
    exit 0
  fi

  # Guard 2: capture the pre-mutation origin/main blob BEFORE mutating. A node
  # absent from origin/main at this instant is a HARD refusal: with no landed
  # blob there is nothing to roll back to, so mutating anyway would leak exactly
  # the dirty file the rollback exists to prevent.
  if ! FRESH_BLOB=$(origin_blob) || [[ -z "$FRESH_BLOB" ]]; then
    log "$NODE_REL does not exist on origin/main — refusing to mutate a node with no landed content to roll back to"
    exit 1
  fi

  if ! (
    set -o pipefail
    jq '.phase = "done"' "$TMP_DIR/$ID.json" > "$TMP_DIR/$ID.patched.json" || exit 1
    cd "$REPO_ROOT" || exit 1
    "${WRITE_NODE_CMD[@]}" --file "$TMP_DIR/$ID.patched.json" || exit 1
  ) 1>&2 || ! run_graph_commit --base "$MANIFEST" -m "graph: resolve fleet alarm $KIND" "$ID"; then
    # Guard 3: restore from the captured blob FIRST, then log. Never swallow the
    # failure with `|| true` — emit a greppable stderr diagnostic.
    restore_from_blob "$FRESH_BLOB"
    log "resolve of $ID failed; the write was rolled back to origin/main"
    exit 1
  fi

  if ! verify_landed; then
    log "resolve of $ID could not be verified on origin/main"
    exit 1
  fi
  log "resolved $ID (phase: done)"
  exit 0
fi

# --- Alarm: find-or-create ---------------------------------------------------
case "$STATE" in
  absent|closed)
    # Nothing to compare-and-swap against — mint fresh, no --base. A "closed"
    # node is a since-resolved condition that has recurred: mint over it rather
    # than reopening a completed record by hand.
    PRE_BLOB="$(origin_blob || true)"
    jq -n \
      --arg id "$ID" \
      --arg statement "$STATEMENT" \
      '{
        id: $id,
        kind: "tactic",
        statement: $statement,
        owner: "ai",
        status: "raw",
        parent: null,
        serves: ["strategy-autonomous-execution"],
        recovers: [],
        rationale: "Auto-created by dispatch-fleet-alarm from an out-of-band fleet instrument reading. See the body for the reading.",
        reading: null,
        gap: null,
        clarifications: [],
        tooling_goals: [],
        success_signal: null,
        attention: null,
        phase: null,
        execution: null,
        validates: [],
        blocked_by: [],
        office_hours: null,
        pace_exempt: true,
        rounds: null,
        attributes: {}
      }' > "$TMP_DIR/$ID.json" || { log "failed to build the node JSON for $ID"; exit 1; }
    # Field notes: serves -> strategy-autonomous-execution (rank is inherited
    # through that edge). success_signal null — these nodes are not registered
    # in read-sensors.ts. attention null — rank is never machine-injected.
    # pace_exempt true — a fleet-down finding must not be pace-gated.
    # phase null + status raw + execution null is the draft shape.

    if ! (
      cd "$REPO_ROOT" || exit 1
      "${WRITE_NODE_CMD[@]}" --file "$TMP_DIR/$ID.json" || exit 1
    ) 1>&2 || ! splice_body || ! run_graph_commit -m "graph: fleet alarm $KIND" "$ID"; then
      if [[ -n "$PRE_BLOB" ]]; then
        restore_from_blob "$PRE_BLOB"
      else
        rm -f "$NODE_FILE" "$NODE_FILE.tmp"
      fi
      log "minting $ID failed; the write was rolled back"
      exit 1
    fi
    if ! verify_landed; then
      log "minting $ID could not be verified on origin/main"
      exit 1
    fi
    log "landed new alarm node $ID"
    exit 0
    ;;

  open)
    # Re-detection during an ongoing condition. Capture the CAS token first,
    # then refresh the body ONLY if it actually changed — skip the commit
    # entirely when it did not, so a re-detection tick that finds the same
    # condition does not churn a no-op commit.
    MANIFEST=$( (cd "$REPO_ROOT" && "${DUMP_NODE_CMD[@]}" --out-dir "$TMP_DIR/base" "$ID") ) || {
      log "dump-node of $ID failed; cannot refresh the alarm body"
      exit 1
    }
    ONDISK_BODY="$TMP_DIR/$ID.ondisk-body"
    awk 'p; /^---$/{c++; if(c==2) p=1}' "$NODE_FILE" > "$ONDISK_BODY" || {
      log "could not read the on-disk body of $NODE_FILE"
      exit 1
    }
    if cmp -s "$BODY_FILE" "$ONDISK_BODY"; then
      log "$ID is already open with an identical reading — no commit"
      exit 0
    fi
    PRE_BLOB="$(origin_blob || true)"
    if ! splice_body || ! run_graph_commit --base "$MANIFEST" -m "graph: refresh fleet alarm $KIND" "$ID"; then
      if [[ -n "$PRE_BLOB" ]]; then
        restore_from_blob "$PRE_BLOB"
      fi
      log "refreshing $ID failed; the write was rolled back"
      exit 1
    fi
    if ! verify_landed; then
      log "refreshing $ID could not be verified on origin/main"
      exit 1
    fi
    log "refreshed alarm node $ID"
    exit 0
    ;;

  *)
    log "unexpected classification '$STATE' for $ID"
    exit 1
    ;;
esac
