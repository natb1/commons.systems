#!/usr/bin/env bash
#
# dispatch-fleet-alarm — the shared alarm surface for out-of-band fleet-health
# readings.
#
# A fleet instrument (a watcher that reads the tick journal / daemon liveness,
# or a healer that fired a recovery action) turns its reading into a GRAPH NODE
# through this script, never into journald alone: journald is not a work queue
# and nothing in the fleet reads it back. One node per condition kind, found or
# created idempotently, its body refreshed on re-detection, completed when the
# condition definitively clears.
#
# Usage:
#   dispatch-fleet-alarm --kind <kind> --statement <text> --body-file <path>
#   dispatch-fleet-alarm --resolve --kind <kind>
#   dispatch-fleet-alarm -h|--help
#
# <kind> is a CLOSED enum (see KINDS below). Anything else exits 64 — an alarm
# surface with an open-ended id space would mint unbounded node ids from a
# caller typo.
#
# Node id: tactic-fleet-alarm-<kind>. Stable per condition kind, so find-or-
# create is idempotent: one open node per ongoing condition. The id shape is
# guarded by an ANCHORED regex built from the enum, never a bare prefix test —
# a bare `tactic-main-red-` startsWith test in dispatch-graph-main-red-sync once
# matched an unrelated hand-authored node and mechanically auto-completed it to
# phase:"done" (see that script's lines 52-58).
#
# Find-or-create follows the canonical recipe in
# .claude/skills/dispatch-diagnose-main/SKILL.md (lines 84-218): readNode
# classification (frontmatter only, never the body), then either the
# write-node.ts --file -> awk body-splice -> graph-commit mint path (absent or
# closed), or the dump-node.ts -> cmp -s -> graph-commit --base re-detection
# path (open), which SKIPS the commit entirely when the fresh body matches the
# on-disk body — a re-detection that finds the same condition must not churn a
# no-op commit.
#
# TWO INDEPENDENT BRAKES ON THE RE-DETECTION PATH. Every commit here is a
# fetch + rebase + push to origin/main that arms the four required CI checks,
# and the callers re-detect on a 2-5 minute timer for as long as a condition
# persists. One brake is not enough:
#
#   1. The `cmp -s` body-identity gate above. It only holds if the CALLER keeps
#      volatile values (wall-clock timestamps, elapsed spans, pids, raw
#      liveness JSON) OUT of the body — an alarm body states the STABLE
#      IDENTITY of the condition (predicate, threshold, offending unit/node
#      ids) and the volatile reading goes to the caller's log line instead.
#      dispatch-fleet-watch and dispatch-heal-units are written to that
#      contract, and their suites assert it by comparing the bodies two
#      successive passes emit.
#   2. The MINIMUM REFRESH INTERVAL enforced here, which does not trust the
#      caller. A body that churns anyway (a new caller, a reworded reading, an
#      offending-id set that flaps) still cannot push more often than
#      DISPATCH_FLEET_ALARM_MIN_REFRESH_INTERVAL seconds per kind. The stamp is
#      written when a refresh REACHES graph-commit — success or failure — so a
#      failing push cannot retry-storm either. This matters most during an
#      outage (tick dead, daemon down, main red), i.e. exactly when the fleet
#      can least absorb a push per pass and when the load could itself keep
#      main red.
#
# The interval gates ONLY the re-detection refresh. Minting a first record of a
# condition, and resolving a cleared one, are once-per-episode transitions and
# are never delayed — an alarm that arrives an hour late is not an alarm.
#
# Exit codes:
#   0   the alarm landed; or a re-detection found no body diff (no commit); or
#       a re-detection was inside the minimum refresh interval (no commit); or
#       --resolve found nothing open to resolve; or the pass was skipped because
#       another graph writer holds this checkout's mutex (stdout disambiguates —
#       see the stdout protocol below).
#   1   the graph write failed (after retries), or the post-write blob
#       verification did not confirm the write on origin/main. The caller
#       degrades to journald-only for that pass — but must still report this
#       graph-write failure in its own output.
#   64  usage error / unknown kind.
#   69  environment error (missing node/npx/git/jq/flock, the graph-write mutex
#       could not be established at all — never downgrade that to an
#       unserialized write — or refs/remotes/origin/main does not resolve in this
#       checkout, which makes the pre-write blob capture meaningless; nothing is
#       mutated in that case).
#   70  the graph write failed AND its rollback could not complete, so a dirty
#       intentions/<id>.md is LEFT IN THE CHECKOUT. Distinct from 1 because the
#       residue trips graph-commit's unrelated-dirty-tracked-file pre-flight for
#       every later graph writer here: the caller must escalate (the log line
#       names the exact `git checkout --` that clears it), never retry.
#
# graph-commit exiting 0 is NOT evidence anything landed (a named invariant in
# this codebase: a check whose failure mode is a silent PASS — graph-commit has
# a documented "nothing to push" rc-0 sub-case, and a wrong-repo invocation can
# exit 0 having landed nothing). Every successful commit here is followed by a
# blob comparison of intentions/<id>.md on origin/main against the local
# `git hash-object`; a mismatch is exit 1, not exit 0.
#
# NEVER FLEET-HALT: this script writes exactly intentions/<id>.md for its own
# alarm id and nothing else. It does not write blocked_by on any other node, it
# does not touch the pause sentinel, and it does not write office_hours on any
# node. A fleet instrument's job is to record a finding, not to stop the fleet.
#
# ONE GRAPH WRITER PER CHECKOUT. Every caller is an unattended systemd timer —
# the fleet watchdog (every 5min) and the unit healer (every 2min) — and a
# single watcher pass can invoke this script up to nine times. They all write
# through graph-commit against the SAME checkout, and graph-commit rebases that
# checkout and, on its busy-main / far-ahead-HEAD paths, runs `git reset --hard`
# on it. Overlapping invocations in one worktree are a known corruption class:
# a graph write that exits 0 having landed NOTHING, a dirty intentions/<id>.md
# that trips every later writer's clean-tree assertion, or a `reset --hard`
# discarding an unrelated in-flight tree in the shared main worktree.
#
# So the ENTIRE region below — classify, dump-node, write-node, body splice,
# graph-commit, post-write verification, and the rollback paths — runs holding
# the checkout's graph-write mutex (lib.sh's graph_write_lock_acquire, at
# <repo-root>/tmp/graph-write.lock). It is taken NON-BLOCKING and held to
# process exit: a contended pass SKIPS (exit 0, stdout `skipped-locked`) instead
# of waiting, because a oneshot that blocks on a wedged holder pins its service
# until the next fire and stacks passes, whereas a skipped pass costs only
# latency — the caller re-derives its whole reading from scratch next pass, and
# a still-true condition is simply recorded then. The mutex is per-checkout on
# purpose: cross-checkout writers are already serialized at the remote by
# graph-commit's own refs/graph/landing-lock.
#
# Stdout protocol — exactly one word on a successful exit, so a caller can budget
# its graph writes without parsing log prose:
#   landed          a commit was made AND verified on origin/main.
#   noop            nothing needed writing (identical re-detection, a
#                   rate-limited refresh, nothing open to resolve, or a guard
#                   that declined to mutate).
#   skipped-locked  another graph writer holds this checkout's mutex; nothing
#                   was read and nothing was written on this pass.
# Nothing is printed on a failure exit — the non-zero rc is the whole signal.
#
# Dependency-injection seams (unset in production; used by
# test-dispatch-fleet-alarm.sh so the suite never touches the real graph or a
# real git remote). Each holds a command line, split on whitespace — the paths
# must not contain spaces:
#   DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD  default: <repo>/packages/intentionsutil/scripts/graph-commit
#   DISPATCH_FLEET_ALARM_VERIFY_LANDED_CMD default: <repo>/packages/intentionsutil/scripts/verify-landed
#   DISPATCH_FLEET_ALARM_WRITE_NODE_CMD    default: npx tsx <repo>/packages/intentionsutil/scripts/write-node.ts --dir <repo>/intentions
#   DISPATCH_FLEET_ALARM_DUMP_NODE_CMD     default: npx tsx <repo>/packages/intentionsutil/scripts/dump-node.ts --dir <repo>/intentions
#   DISPATCH_FLEET_ALARM_CLASSIFY_CMD      default: the node --import tsx/esm readNode one-liner below
#   DISPATCH_FLEET_ALARM_INTENTIONS_DIR    default: <repo>/intentions
#   DISPATCH_FLEET_ALARM_RETRIES           default: 3   (graph-commit attempts)
#   DISPATCH_FLEET_ALARM_RETRY_DELAY       default: 5   (seconds between attempts)
#
# Rate-limit seams (also production-tunable):
#   DISPATCH_FLEET_ALARM_STATE_DIR
#       Where the per-kind last-refresh stamp lives. Default:
#       ${XDG_DATA_HOME:-$HOME/.local/share}/commons-dispatch/fleet-alarm
#       A stamp is host-local scratch, deliberately NOT graph state: losing it
#       costs at most one extra refresh commit.
#   DISPATCH_FLEET_ALARM_MIN_REFRESH_INTERVAL
#       Seconds. Default 3600. 0 disables the brake (used by the test suite,
#       which asserts the gate separately with an explicit interval).
#
# Graph-write mutex seam (lib.sh):
#   DISPATCH_GRAPH_WRITE_LOCK_FILE
#       Overrides the mutex path, which otherwise derives from the resolved
#       repo root as <repo-root>/tmp/graph-write.lock. There is no "disable"
#       switch by design — an unserialized alarm write is the defect.
#
# NOT set -e: every risky step is guarded explicitly so the script always
# reaches an intentional exit (same convention as sibling
# dispatch-graph-main-red-sync).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# scripts -> dispatch-propagate -> skills -> .claude -> repo root (same
# convention as sibling dispatch-graph-main-red-sync lines 44-46).
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# lib.sh supplies the graph-write mutex (graph_write_lock_file /
# graph_write_lock_acquire) taken below. It is pure function definitions plus a
# handful of `${VAR:-default}` assignments, so sourcing it under `set -u` is
# safe (same pattern as sibling dispatch-acquire-lock).
# shellcheck source=/dev/null
if ! source "$SCRIPT_DIR/lib.sh"; then
  echo "dispatch-fleet-alarm: cannot source $SCRIPT_DIR/lib.sh" >&2
  exit 69
fi

# The closed enum of alarm kinds. Kept in bash array form because the --kind
# membership check and the anchored ID_RE below both need it in array context.
#
# SINGLE SOURCE OF TRUTH: `FLEET_ALARM_KINDS` in
# packages/intentionsutil/src/router.ts, which builds the router's
# candidate-exclusion regex from the same list. Extending the enum is a
# deliberate edit in BOTH files, in the same order — the drift guard in
# packages/intentionsutil/test/router.test.ts parses this very `KINDS=(...)`
# line and fails if the two ever diverge.
KINDS=(tick-stale daemon-degraded busy-stall automerge-suppressed unclaimed-hold main-checkout-held watch-unknown heal-fired heal-unknown)

usage() {
  cat <<'USAGE'
usage: dispatch-fleet-alarm --kind <kind> --statement <text> --body-file <path>
       dispatch-fleet-alarm --resolve --kind <kind>
       dispatch-fleet-alarm -h|--help

kinds: tick-stale daemon-degraded busy-stall automerge-suppressed
       unclaimed-hold main-checkout-held watch-unknown heal-fired heal-unknown

Records an out-of-band fleet-health reading as the graph node
tactic-fleet-alarm-<kind> (find-or-create; body refreshed on re-detection).
--resolve completes an open alarm node to phase: "done" when its condition has
definitively cleared. It refuses (no-op) on a node carrying a non-null
office_hours: a human park is theirs to clear, not this script's to complete.

exit: 0 landed / no-op, 1 graph write failed (rolled back), 64 usage,
      69 environment, 70 write failed and the rollback left a dirty node file.
USAGE
}

log() { printf 'dispatch-fleet-alarm: %s\n' "$*" >&2; }

# --- Argument parsing --------------------------------------------------------
KIND=""
STATEMENT=""
BODY_FILE=""
RESOLVE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --kind)
      [[ $# -ge 2 ]] || { log "--kind requires a value"; usage >&2; exit 64; }
      KIND="$2"; shift 2 ;;
    --statement)
      [[ $# -ge 2 ]] || { log "--statement requires a value"; usage >&2; exit 64; }
      STATEMENT="$2"; shift 2 ;;
    --body-file)
      [[ $# -ge 2 ]] || { log "--body-file requires a value"; usage >&2; exit 64; }
      BODY_FILE="$2"; shift 2 ;;
    --resolve) RESOLVE=1; shift ;;
    *) log "unknown argument: $1"; usage >&2; exit 64 ;;
  esac
done

[[ -n "$KIND" ]] || { log "--kind is required"; usage >&2; exit 64; }

# Closed-enum membership check.
KIND_OK=0
for k in "${KINDS[@]}"; do [[ "$k" == "$KIND" ]] && KIND_OK=1; done
if [[ "$KIND_OK" != "1" ]]; then
  log "unknown kind '$KIND' (allowed: ${KINDS[*]})"
  exit 64
fi

ID="tactic-fleet-alarm-$KIND"

# Anchored id guard built from the enum — NOT a prefix test. Belt-and-braces
# with the membership check above: nothing but an exact enum id may ever reach
# the write paths below.
KIND_ALT="$(IFS='|'; printf '%s' "${KINDS[*]}")"
ID_RE="^tactic-fleet-alarm-(${KIND_ALT})$"
if [[ ! "$ID" =~ $ID_RE ]]; then
  log "refusing to act on id '$ID' — it does not match the anchored alarm-id shape $ID_RE"
  exit 64
fi

if [[ "$RESOLVE" == "1" ]]; then
  if [[ -n "$STATEMENT" || -n "$BODY_FILE" ]]; then
    log "--resolve takes only --kind (no --statement / --body-file)"
    exit 64
  fi
else
  [[ -n "$STATEMENT" ]] || { log "--statement is required (or pass --resolve)"; usage >&2; exit 64; }
  [[ -n "$BODY_FILE" ]] || { log "--body-file is required (or pass --resolve)"; usage >&2; exit 64; }
  [[ -f "$BODY_FILE" ]] || { log "--body-file '$BODY_FILE' does not exist"; exit 64; }
fi

# --- Environment -------------------------------------------------------------
for bin in date flock git jq node npx; do
  command -v "$bin" >/dev/null 2>&1 || { log "required command '$bin' not found on PATH"; exit 69; }
done

INTENTIONS_DIR="${DISPATCH_FLEET_ALARM_INTENTIONS_DIR:-$REPO_ROOT/intentions}"
NODE_FILE="$INTENTIONS_DIR/$ID.md"
# The path git sees. graph-commit stages exactly `intentions/<id>.md` relative
# to the repo it resolves, so origin/main lookups always use that spelling.
NODE_REL="intentions/$ID.md"

RETRIES="${DISPATCH_FLEET_ALARM_RETRIES:-3}"
RETRY_DELAY="${DISPATCH_FLEET_ALARM_RETRY_DELAY:-5}"

# Minimum seconds between two re-detection refreshes of the SAME kind. See the
# "TWO INDEPENDENT BRAKES" note in the header.
STATE_DIR="${DISPATCH_FLEET_ALARM_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/commons-dispatch/fleet-alarm}"
MIN_REFRESH_INTERVAL="${DISPATCH_FLEET_ALARM_MIN_REFRESH_INTERVAL:-3600}"
if [[ ! "$MIN_REFRESH_INTERVAL" =~ ^[0-9]+$ ]]; then
  log "DISPATCH_FLEET_ALARM_MIN_REFRESH_INTERVAL must be a non-negative integer, got '$MIN_REFRESH_INTERVAL'"
  exit 64
fi
STAMP_FILE="$STATE_DIR/$KIND.last-refresh"

# Command seams. `read -r -a` splits on whitespace; production defaults contain
# no spaces (see the header note).
declare -a GRAPH_COMMIT_CMD WRITE_NODE_CMD DUMP_NODE_CMD CLASSIFY_CMD VERIFY_LANDED_CMD
if [[ -n "${DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD:-}" ]]; then
  read -r -a GRAPH_COMMIT_CMD <<<"$DISPATCH_FLEET_ALARM_GRAPH_COMMIT_CMD"
else
  GRAPH_COMMIT_CMD=("$REPO_ROOT/packages/intentionsutil/scripts/graph-commit")
fi
if [[ -n "${DISPATCH_FLEET_ALARM_VERIFY_LANDED_CMD:-}" ]]; then
  read -r -a VERIFY_LANDED_CMD <<<"$DISPATCH_FLEET_ALARM_VERIFY_LANDED_CMD"
else
  VERIFY_LANDED_CMD=("$REPO_ROOT/packages/intentionsutil/scripts/verify-landed")
fi
# write-node.ts / dump-node.ts take the store as a REQUIRED --dir (clarification
# 194/242); they no longer infer it from import.meta.url or from cwd. Both the
# script copy invoked AND the --dir it is handed are anchored at $REPO_ROOT, so
# the checkout read and the checkout mutated are the one being committed.
# The --dir is baked into the DEFAULT command only: an override supplied through
# the env var below is a caller-authored command line (the test stubs), and it
# owns its own arguments.
if [[ -n "${DISPATCH_FLEET_ALARM_WRITE_NODE_CMD:-}" ]]; then
  read -r -a WRITE_NODE_CMD <<<"$DISPATCH_FLEET_ALARM_WRITE_NODE_CMD"
else
  WRITE_NODE_CMD=(npx tsx "$REPO_ROOT/packages/intentionsutil/scripts/write-node.ts" --dir "$REPO_ROOT/intentions")
fi
if [[ -n "${DISPATCH_FLEET_ALARM_DUMP_NODE_CMD:-}" ]]; then
  read -r -a DUMP_NODE_CMD <<<"$DISPATCH_FLEET_ALARM_DUMP_NODE_CMD"
else
  DUMP_NODE_CMD=(npx tsx "$REPO_ROOT/packages/intentionsutil/scripts/dump-node.ts" --dir "$REPO_ROOT/intentions")
fi
if [[ -n "${DISPATCH_FLEET_ALARM_CLASSIFY_CMD:-}" ]]; then
  read -r -a CLASSIFY_CMD <<<"$DISPATCH_FLEET_ALARM_CLASSIFY_CMD"
else
  CLASSIFY_CMD=()
fi

# --- Helpers -----------------------------------------------------------------

# classify <id> -> prints absent | open | closed
# readNode reads only the YAML frontmatter, so classification never touches the
# body. `phase: done` alone is a since-resolved node -> closed; a throw (no
# such file) -> absent.
#
# PARK-AWARE (tactic-fleet-alarm-node-park-clobber-loop, ruling (b)): a
# non-null `office_hours` no longer classifies as closed on its own. It used
# to (a retired `|| n.office_hours !== null` disjunct here), on the theory
# that a human park was itself a form of resolution — but that conflated two
# unrelated meanings of a park: "this alarm is dismissed" and "a worker
# session froze, needs human attention, come back to the SAME condition."
# The second case is the common one (this
# script's own `--resolve` sets `phase: "done"` directly and never touches
# `office_hours`), and classifying it as `closed` routed it into the
# mint-fresh path below — which builds a brand-new frontmatter object from
# scratch and overwrites the file, discarding the parked `office_hours`
# record along with everything else a human or worker wrote. A node with
# `office_hours !== null` but `phase !== "done"` now reads `open` instead,
# which routes re-detection through the CAS refresh path (`splice_body` +
# `graph-commit --base`) that only ever rewrites the body after the second
# frontmatter fence — the park, and every other frontmatter field, survives
# untouched. `--resolve` (see below) remains the only path that can complete
# one of these nodes to `phase: "done"` — and it now REFUSES on a parked node
# (its Guard 1), so classifying a park as `open` cannot be turned around into
# mechanically completing the park.
classify() {
  if [[ ${#CLASSIFY_CMD[@]} -gt 0 ]]; then
    "${CLASSIFY_CMD[@]}" "$1"
    return
  fi
  (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { readNode } = await import("./packages/intentionsutil/src/store.js");
    try {
      const n = readNode(process.argv[1], process.argv[2]);
      process.stdout.write((n.phase === "done") ? "closed\n" : "open\n");
    } catch {
      process.stdout.write("absent\n");
    }
  ' "$INTENTIONS_DIR" "$1")
}

# origin_blob -> prints the origin/main blob sha of the node file, or fails
# with NO stdout. `git rev-parse <unresolvable-rev>` prints the literal
# unresolved arg to stdout even as it exits non-zero (a git quirk, not an
# error case we can rely on stderr alone to signal) — captured and discarded
# here so callers like `PRE_BLOB="$(origin_blob || true)"` see a genuinely
# empty string on failure instead of that echoed-back garbage, which would
# otherwise be mistaken for a real blob and route a failed mint's rollback
# into restore_from_blob (which correctly refuses to guess and leaves the
# file as-is) instead of the rm -f cleanup for a node with nothing to restore.
#
# A FAILURE HERE IS AMBIGUOUS ON ITS OWN, and the ambiguity is load-bearing:
# `2>/dev/null` silences BOTH "origin/main carries no such path" (an expected
# state — nothing to restore) AND "origin/main itself is unresolvable in this
# checkout" (an unfetched clone, a pruned or stale remote-tracking ref, a
# concurrent gc/fetch --prune, any git error — an ENVIRONMENT fault that says
# nothing about the graph). Callers whose next move depends on which one it was
# must gate on origin_main_ref_ok FIRST; see its note.
origin_blob() {
  local out
  out=$(git -C "$REPO_ROOT" rev-parse "origin/main:$NODE_REL" 2>/dev/null) || return 1
  printf '%s' "$out"
}

# origin_main_ref_ok -> 0 when refs/remotes/origin/main resolves in this
# checkout. Disambiguates origin_blob's two failure modes before any rollback
# decision is made from an empty blob: an empty PRE_BLOB is only evidence that
# "this node is absent from origin/main" when origin/main itself resolves.
# Without this gate an unfetched/pruned/stale remote-tracking ref reads as
# "nothing landed, nothing to restore" — and the mint rollback would then delete
# a tracked node file that origin/main actually carries, leaving a dirty TRACKED
# deletion that trips graph-commit's unrelated-dirty-file pre-flight for every
# later graph writer in this checkout. That is the fleet-halt the header forbids,
# arriving precisely during an outage (the alarm mints when main is red and the
# network is flaky), so the ref fault is an exit-69 environment error that
# touches nothing, never a rollback input.
origin_main_ref_ok() {
  git -C "$REPO_ROOT" rev-parse --verify --quiet origin/main >/dev/null 2>&1
}

# restore_from_blob <sha> — put the node file back to its origin/main content so
# a failed write never leaks a dirty intentions/ file (which would trip
# graph-commit's clean-tree assertion for every later writer).
#
# EVERY CALL SITE MUST CHECK THE STATUS. Returning 1 leaves the mutated file in
# place on purpose (better than manufacturing a 0-byte node), so a caller that
# invokes this bare and then logs "the write was rolled back" asserts a rollback
# that did not happen — while a dirty intentions/<id>.md sits in the checkout
# blocking every later graph write, and the alarm's own log (the only record of
# the incident) points investigators away from the cause. A failed rollback exits
# 70, not 1, so the caller can escalate instead of retrying.
restore_from_blob() {
  local tmp="$NODE_FILE.tmp"
  # `git show <sha> > "$NODE_FILE"` truncated the node file BEFORE git ran, so
  # a failing `git show` left a 0-byte node file — the rollback path
  # manufacturing exactly the corruption it exists to prevent. Stage to a tmp
  # and publish by rename instead: a failure now leaves the file untouched.
  if ! git -C "$REPO_ROOT" show "$1" > "$tmp"; then
    rm -f "$tmp"
    log "could not restore $NODE_REL from blob $1 — the node file was left as-is"
    return 1
  fi
  mv "$tmp" "$NODE_FILE"
}

# The owned-region markers. Everything BETWEEN them is this script's to rewrite;
# everything outside is somebody else's and is copied through untouched. Same
# contract, and the same whole-line matching, as dispatch-eval-finding's region.
BODY_REGION_OPEN='<!-- generated:dispatch-fleet-alarm -->'
BODY_REGION_CLOSE='<!-- /generated:dispatch-fleet-alarm -->'

# splice_body — rewrite THIS SCRIPT'S OWNED REGION of the body, preserving
# everything else. write-node.ts gives a brand-new file the generated
# `# <statement>` placeholder body, which is this script's to replace; anything
# else in the body belongs to whoever wrote it.
#
# This used to replace everything after the closing frontmatter fence
# wholesale. That was safe only while a re-detection could not land on a node a
# human had written in. It can: a parked alarm node (`office_hours != null`,
# `phase != "done"`) now classifies `open` and routes re-detection here, and the
# common reason such a node is parked is that a human is looking at it. The
# guard above claims "the alarm's own re-detection path still refreshes its body
# underneath the park, so nothing is lost by waiting" — that holds for
# frontmatter, which this function never touches, but it was false for the body:
# a human's diagnosis written into the parked node was discarded on the next
# detection tick and the discard was pushed to main.
#
# Bounding the generated content in a marker pair is what makes the guard's
# claim true as stated, rather than narrowing the claim to match the defect.
splice_body() {
  local tmp="$NODE_FILE.tmp"
  # Step 1 — frontmatter through the closing fence. awk's OWN status must gate
  # everything downstream: the previous `{ awk ...; cat ...; } > tmp && mv`
  # reported the GROUP's status, which is `cat`'s (always 0), so a fatal awk
  # was swallowed and a malformed tmp was still published.
  if ! awk '{print} /^---$/{c++; if(c==2) exit}' "$NODE_FILE" > "$tmp"; then
    rm -f "$tmp"
    log "could not read the frontmatter of $NODE_FILE — the body splice was abandoned"
    return 1
  fi
  # Step 2 — positive shape assertion. awk exits 0 on a file with NO fences at
  # all (and on a 0-byte file), so status alone is not enough. The extract ends
  # exactly at the second fence, so first and last lines must both be `---`.
  if [[ "$(head -n 1 "$tmp")" != "---" || "$(tail -n 1 "$tmp")" != "---" ]]; then
    rm -f "$tmp"
    log "$NODE_FILE has no complete YAML frontmatter — refusing to splice a malformed node file"
    return 1
  fi
  # Step 3 — refuse a reading that carries either marker on a line of its own.
  # The generated content is wrapped in the pair unconditionally below, so such
  # a reading would leave the body unbalanced and every later pass would refuse
  # it. Whole-line match only, so a marker quoted inline or indented inside a
  # fenced block — invisible to the region parser — stays legal.
  if [[ ! -r "$BODY_FILE" ]]; then
    rm -f "$tmp"
    log "$BODY_FILE cannot be read — the body splice was abandoned; NOTHING WAS WRITTEN"
    return 1
  fi
  if grep -qxF -e "$BODY_REGION_OPEN" -e "$BODY_REGION_CLOSE" "$BODY_FILE"; then
    rm -f "$tmp"
    log "$BODY_FILE carries a marker line of its own, and this script wraps the reading in that pair — writing it would leave $NODE_FILE with an unbalanced pair that every later pass refuses; NOTHING WAS WRITTEN. Indent or reword that line"
    return 1
  fi

  # Step 4 — the prior body: everything AFTER the closing frontmatter fence.
  local prior="$NODE_FILE.prior"
  if ! awk 'f{print} /^---$/{c++; if(c==2) f=1}' "$NODE_FILE" > "$prior"; then
    rm -f "$tmp" "$prior"
    log "could not read the existing body of $NODE_FILE — the body splice was abandoned"
    return 1
  fi

  local opens closes
  opens=$(grep -cxF "$BODY_REGION_OPEN" "$prior")
  closes=$(grep -cxF "$BODY_REGION_CLOSE" "$prior")
  if (( opens != closes || opens > 1 )); then
    rm -f "$tmp" "$prior"
    log "$NODE_FILE carries $opens opening and $closes closing '$BODY_REGION_OPEN' marker(s) — refusing to guess which bytes this script owns; repair the marker pair by hand"
    return 1
  fi

  if (( opens == 1 )); then
    # A balanced pair is not yet a well-formed region: an edit that swaps the
    # two leaves the count balanced with the close before the open.
    local open_line close_line
    open_line=$(grep -nxF "$BODY_REGION_OPEN" "$prior" | cut -d: -f1)
    close_line=$(grep -nxF "$BODY_REGION_CLOSE" "$prior" | cut -d: -f1)
    if (( close_line < open_line )); then
      rm -f "$tmp" "$prior"
      log "$NODE_FILE's '$BODY_REGION_CLOSE' marker appears before its '$BODY_REGION_OPEN' (close at line $close_line, open at line $open_line) — refusing to guess which bytes this script owns; repair the marker order by hand"
      return 1
    fi
    # Replace in place. The END guard makes truncation impossible even if the
    # ordering check above is ever weakened: were the close marker never hit,
    # `skip` would stay 1 and the loop would silently drop every line to EOF.
    if ! awk -v om="$BODY_REGION_OPEN" -v cm="$BODY_REGION_CLOSE" -v bf="$BODY_FILE" '
      $0 == om { print; while ((getline line < bf) > 0) print line; close(bf); skip = 1; next }
      skip && $0 == cm { print; skip = 0; next }
      !skip { print }
      END { if (skip) exit 1 }
    ' "$prior" >> "$tmp"; then
      rm -f "$tmp" "$prior"
      log "could not rewrite the owned region of $NODE_FILE from $BODY_FILE — the closing marker was never reached, so the rest of the body would have been dropped — the body splice was abandoned"
      return 1
    fi
    rm -f "$prior"
    mv "$tmp" "$NODE_FILE"
    return 0
  fi

  # No region yet. write-node.ts's placeholder body is a single `# <statement>`
  # heading and is this script's to replace; anything else was authored by
  # somebody and is kept, with the region appended after it.
  local authored
  authored=$(grep -v '^[[:space:]]*$' "$prior")
  if [[ -n "$authored" && ( "$authored" == *$'\n'* || "$authored" != '# '* ) ]]; then
    if ! cat "$prior" >> "$tmp"; then
      rm -f "$tmp" "$prior"
      log "could not preserve the existing body of $NODE_FILE — the body splice was abandoned"
      return 1
    fi
    # A prior body with no trailing newline would run its last line into the
    # opening marker.
    if [[ -s "$prior" && -n "$(tail -c 1 "$prior")" ]]; then
      printf '\n' >> "$tmp"
    fi
  fi
  rm -f "$prior"

  # Step 5 — the reading, wrapped in the pair, then publish atomically.
  if ! { printf '%s\n' "$BODY_REGION_OPEN" && cat "$BODY_FILE"; } >> "$tmp"; then
    rm -f "$tmp"
    log "could not read the reading from $BODY_FILE — the body splice was abandoned"
    return 1
  fi
  # A reading that does not end in a newline would glue the closing marker to
  # its last line and leave the pair unparseable on the next pass.
  if [[ -s "$BODY_FILE" && -n "$(tail -c 1 "$BODY_FILE")" ]]; then
    printf '\n' >> "$tmp"
  fi
  if ! printf '%s\n' "$BODY_REGION_CLOSE" >> "$tmp"; then
    rm -f "$tmp"
    log "could not close the owned region of $NODE_FILE — the body splice was abandoned"
    return 1
  fi
  mv "$tmp" "$NODE_FILE"
}

# refresh_stamp_read -> prints the epoch second of the last refresh that
# reached graph-commit for this kind, or nothing. An unreadable/garbage stamp
# prints nothing, which fails OPEN (the refresh proceeds): the brake exists to
# bound a churning caller, not to swallow a genuine reading because a scratch
# file went missing.
refresh_stamp_read() {
  local v
  [[ -r "$STAMP_FILE" ]] || return 0
  v=$(<"$STAMP_FILE") || return 0
  v="${v//[$'\t\r\n ']/}"
  [[ "$v" =~ ^[0-9]+$ ]] || return 0
  printf '%s' "$v"
}

# refresh_stamp_write — record NOW as this kind's last refresh attempt. Called
# when a refresh REACHES graph-commit, before the outcome is known, so a
# failing push cannot retry-storm. A write failure is logged, never fatal.
refresh_stamp_write() {
  local now
  now=$(date -u +%s) || { log "could not read the clock; the refresh rate-limit stamp was not updated"; return 0; }
  mkdir -p "$STATE_DIR" 2>/dev/null || { log "could not create the alarm state dir $STATE_DIR; the refresh rate-limit stamp was not updated"; return 0; }
  printf '%s\n' "$now" > "$STAMP_FILE.tmp" 2>/dev/null \
    && mv -f "$STAMP_FILE.tmp" "$STAMP_FILE" 2>/dev/null \
    || log "could not write the refresh rate-limit stamp $STAMP_FILE"
  return 0
}

# run_graph_commit <args...> — bounded retry around the landing primitive. All
# of graph-commit's chatter goes to stderr; this script's stdout carries only
# the one-word outcome (see the stdout protocol in the header).
#
# `9>&-` closes the graph-write mutex fd in the child. The flock lives on the
# open file description and is released only when the LAST referencing fd
# closes, so any background helper the push path ever forks (a git credential
# daemon, say) would inherit fd 9 and pin the mutex past our exit — silently
# skipping every later alarm pass on this host. Cost of the defense: one redir.
run_graph_commit() {
  local attempt=1
  while :; do
    if "${GRAPH_COMMIT_CMD[@]}" -C "$REPO_ROOT" "$@" 1>&2 9>&-; then
      return 0
    fi
    if (( attempt >= RETRIES )); then
      log "graph-commit failed after $attempt attempt(s)"
      return 1
    fi
    attempt=$((attempt + 1))
    [[ "$RETRY_DELAY" == "0" ]] || sleep "$RETRY_DELAY"
  done
}

# verify_landed — graph-commit exit 0 is not evidence anything landed. Confirm
# by comparing the node's blob on origin/main against the local file's hash.
#
# Delegates to the shared `verify-landed` primitive (three-valued:
# landed/not-landed/unknown, `unknown` never collapsed into `landed` — see
# that script's own header) rather than re-deriving the hash/compare sequence
# inline. `--node <id> --blob <blobsha>` is the exact predicate this call site
# needs: "does origin/main:intentions/<id>.md hash to what I just wrote
# locally". The id goes in its OWN argument, never concatenated into a spec
# token — see verify-landed's header for why a spliced id is a forged verdict.
#
# The fetch stays HERE, explicit, exactly as it was before this call site
# adopted verify-landed (`--no-fetch` below suppresses verify-landed's own):
# `9>&-` closes the graph-write mutex fd across it, for the same reason as
# run_graph_commit — a network-touching git that forks a credential helper
# must not inherit, and pin, the mutex fd — and verify-landed's own header is
# explicit that this discipline belongs to the CALLER, not to itself, which is
# exactly why its fetch cannot be the one used here.
verify_landed() {
  # A fetch failure is reported, not fatal: the comparison below is
  # authoritative against whatever `origin/main` ref this checkout already
  # has, and verify-landed (called with `--no-fetch`) will itself report
  # `unknown` rather than a false negative if that ref cannot resolve at all.
  if ! git -C "$REPO_ROOT" fetch --quiet origin main 2>/dev/null 9>&-; then
    log "could not fetch origin/main before verification; comparing against the local remote-tracking ref"
  fi
  local local_blob
  if ! local_blob=$(git -C "$REPO_ROOT" hash-object -- "$NODE_FILE"); then
    log "could not hash $NODE_FILE for post-write verification"
    return 1
  fi
  # $ID is already pinned to the closed alarm-id enum by the anchored $ID_RE
  # guard at start-up, so it cannot carry a delimiter; verify-landed re-validates
  # it in full and refuses anything else with a usage error, not a verdict.
  local vl_out vl_rc=0
  vl_out=$("${VERIFY_LANDED_CMD[@]}" --no-fetch -C "$REPO_ROOT" --node "$ID" --blob "$local_blob" 2>&1 9>&-) || vl_rc=$?
  if (( vl_rc == 0 )); then
    return 0
  fi
  # Any non-zero verify-landed exit (not-landed, unknown, or a usage/env
  # error) is treated uniformly as "not confirmed landed" — this function's
  # own contract is binary (0/1), and `unknown` must never be read as success.
  log "post-write verification failed (verify-landed exit $vl_rc) for $NODE_REL: $vl_out"
  return 1
}

# --- Graph-write mutex --------------------------------------------------------
# Taken BEFORE the first graph read, so the classification this pass acts on and
# the write it derives from that classification cannot be split by another
# writer's rebase / `git reset --hard` in this same checkout (see "ONE GRAPH
# WRITER PER CHECKOUT" in the header). Everything above this point is pure
# argument validation with no side effect, so a usage error still exits 64
# without contending for the mutex.
#
# Held on fd 9 until this process exits — there is no release verb, and none is
# wanted: releasing early would reopen the window. Non-blocking: a contended
# pass skips rather than stacking behind a holder.
LOCK_FILE_PATH="$(graph_write_lock_file "$REPO_ROOT" 2>/dev/null || printf '<unresolved>')"
graph_write_lock_acquire "$REPO_ROOT"
LOCK_RC=$?
case "$LOCK_RC" in
  0) ;;
  1)
    log "another graph writer holds $LOCK_FILE_PATH — skipping this alarm pass (nothing read, nothing written); the condition is re-derived on the caller's next pass"
    printf 'skipped-locked\n'
    exit 0
    ;;
  *)
    # Never downgrade to an unserialized write: an unusable mutex is an
    # environment error, and writing anyway is exactly the corruption the mutex
    # exists to prevent.
    log "could not establish the graph-write mutex at $LOCK_FILE_PATH (graph_write_lock_acquire rc=$LOCK_RC) — refusing to write unserialized"
    exit 69
    ;;
esac

TMP_DIR=""
cleanup() { [[ -n "$TMP_DIR" ]] && rm -rf "$TMP_DIR"; }
trap cleanup EXIT
TMP_DIR=$(mktemp -d) || { log "mktemp failed"; exit 69; }

STATE=$(classify "$ID") || {
  log "graph read of $ID failed — cannot classify the alarm node"
  exit 1
}
STATE="${STATE//[$'\t\r\n ']/}"

# --- --resolve ---------------------------------------------------------------
# Complete an open alarm node to phase: "done" when its condition has
# definitively cleared, so alarms do not accumulate. Only a DEFINITE clear
# resolves — the caller decides that; this script has no notion of an
# "unknown" reading, so an unknown reading simply never calls --resolve.
# Structure copied from dispatch-graph-main-red-sync lines 95-160, including its
# load-bearing guards.
if [[ "$RESOLVE" == "1" ]]; then
  if [[ "$STATE" != "open" ]]; then
    log "no open $ID to resolve (state: $STATE) — nothing to do"
    printf 'noop\n'
    exit 0
  fi

  MANIFEST=$( (cd "$REPO_ROOT" && "${DUMP_NODE_CMD[@]}" --out-dir "$TMP_DIR" "$ID") ) || {
    log "dump-node of $ID failed; cannot resolve"
    exit 1
  }

  # Guard 1: only when office_hours is null — the PARK guard
  # (tactic-fleet-alarm-node-park-clobber-loop, ruling (b) follow-up).
  #
  # classify() is deliberately park-aware: a node with a non-null office_hours
  # and phase != done now reads `open` rather than `closed`, which is what stops
  # the mint-fresh path from wiping the park. But `open` is also the state
  # --resolve acts on, so without this guard the same change hands --resolve a
  # parked node and it lands it at phase: "done" with office_hours still set.
  # The scenario is concrete: a worker freezes on an alarm node, a human parks it
  # with a question, the condition then clears on its own, the fleet watcher
  # calls --resolve on its next pass — and the human's park is completed out from
  # under them, their question never answered. Only a human clearing the park
  # (clear-park) may complete a parked alarm node; the alarm's own re-detection
  # path still refreshes its body underneath the park, so nothing is lost by
  # waiting. This is a precondition on --resolve, NOT a revert of classify():
  # reverting classify() would restore the clobber, which is the worse defect.
  if ! jq -e '.office_hours == null' "$TMP_DIR/$ID.json" >/dev/null 2>&1; then
    log "$ID carries a non-null office_hours (a human parked it and is owed an answer) — refusing to complete it mechanically; clear the park first"
    printf 'noop\n'
    exit 0
  fi

  # Guard 2: only when execution is null. A node past draft with a live
  # execution is an in-flight fix owning its own PR/qa/review lifecycle;
  # mechanical completion must never preempt it.
  if ! jq -e '.execution == null' "$TMP_DIR/$ID.json" >/dev/null 2>&1; then
    log "$ID has a non-null execution (an in-flight fix owns its lifecycle) — refusing to complete it mechanically"
    printf 'noop\n'
    exit 0
  fi

  # Guard 3: capture the pre-mutation origin/main blob BEFORE mutating. A node
  # absent from origin/main at this instant is a HARD refusal: with no landed
  # blob there is nothing to roll back to, so mutating anyway would leak exactly
  # the dirty file the rollback exists to prevent. Resolve the REF first so that
  # refusal names the right fault: an unresolvable origin/main is an environment
  # error (exit 69), not a statement about this node.
  if ! origin_main_ref_ok; then
    log "origin/main does not resolve in $REPO_ROOT (unfetched clone, or a pruned/stale remote-tracking ref) — refusing to mutate $ID without a trustworthy pre-write blob"
    exit 69
  fi
  if ! FRESH_BLOB=$(origin_blob) || [[ -z "$FRESH_BLOB" ]]; then
    log "$NODE_REL does not exist on origin/main — refusing to mutate a node with no landed content to roll back to"
    exit 1
  fi

  if ! (
    set -o pipefail
    jq '.phase = "done"' "$TMP_DIR/$ID.json" > "$TMP_DIR/$ID.patched.json" || exit 1
    cd "$REPO_ROOT" || exit 1
    "${WRITE_NODE_CMD[@]}" --file "$TMP_DIR/$ID.patched.json" || exit 1
  ) 1>&2 || ! run_graph_commit --base "$MANIFEST" -m "graph: resolve fleet alarm $KIND" "$ID"; then
    # Guard 4: restore from the captured blob FIRST, then log. Never swallow the
    # failure with `|| true` — emit a greppable stderr diagnostic. And never
    # log a rollback that did not happen: branch on restore_from_blob's status.
    if ! restore_from_blob "$FRESH_BLOB"; then
      log "resolve of $ID failed AND THE ROLLBACK FAILED — $NODE_REL was NOT restored and must be assumed dirty; a dirty node file blocks every later graph write in this checkout, so check git -C $REPO_ROOT status --porcelain -- $NODE_REL and restore it with git -C $REPO_ROOT checkout -- $NODE_REL"
      exit 70
    fi
    log "resolve of $ID failed; the write was rolled back to origin/main"
    exit 1
  fi

  if ! verify_landed; then
    log "resolve of $ID could not be verified on origin/main"
    exit 1
  fi
  log "resolved $ID (phase: done)"
  printf 'landed\n'
  exit 0
fi

# --- Alarm: find-or-create ---------------------------------------------------
case "$STATE" in
  absent|closed)
    # Nothing to compare-and-swap against — mint fresh, no --base. A "closed"
    # node is a since-resolved condition that has recurred: mint over it rather
    # than reopening a completed record by hand.
    #
    # The rollback below deletes the node file when this pass created it, so the
    # two inputs that decision rests on are established here, BEFORE any
    # mutation, and neither may be inferred from an ambiguous failure:
    #   * origin/main must resolve at all, or an empty PRE_BLOB is meaningless
    #     (see origin_main_ref_ok). In the `closed` case especially, the node
    #     file is real tracked content with a landed history — deleting it on a
    #     transient ref fault is a fleet-halt, not a rollback.
    #   * whether the file already existed. Only a file THIS pass created may be
    #     rm -f'd; anything pre-existing is someone else's content.
    if ! origin_main_ref_ok; then
      log "origin/main does not resolve in $REPO_ROOT (unfetched clone, or a pruned/stale remote-tracking ref) — refusing to mint $ID without a trustworthy pre-write blob"
      exit 69
    fi
    PRE_EXISTED=0
    [[ -e "$NODE_FILE" ]] && PRE_EXISTED=1
    PRE_BLOB="$(origin_blob || true)"
    jq -n \
      --arg id "$ID" \
      --arg statement "$STATEMENT" \
      '{
        id: $id,
        kind: "tactic",
        statement: $statement,
        owner: "ai",
        status: "raw",
        parent: null,
        serves: ["strategy-autonomous-execution"],
        recovers: [],
        rationale: "Auto-created by dispatch-fleet-alarm from an out-of-band fleet instrument reading. See the body for the reading.",
        reading: null,
        gap: null,
        clarifications: [],
        tooling_goals: [],
        success_signal: null,
        attention: null,
        phase: null,
        execution: null,
        validates: [],
        blocked_by: [],
        office_hours: null,
        pace_exempt: true,
        rounds: null,
        attributes: {}
      }' > "$TMP_DIR/$ID.json" || { log "failed to build the node JSON for $ID"; exit 1; }
    # Field notes: serves -> strategy-autonomous-execution (rank is inherited
    # through that edge). success_signal null — these nodes are not registered
    # in read-sensors.ts. attention null — rank is never machine-injected.
    # pace_exempt true — a fleet-down finding must not be pace-gated.
    # phase null + status raw + execution null is the draft shape.

    # Minting is never rate-GATED (a first record must not be delayed), but it
    # does set the stamp, so the interval is measured from the mint and a
    # churning caller cannot mint at t and refresh at t+2min.
    refresh_stamp_write
    if ! (
      cd "$REPO_ROOT" || exit 1
      "${WRITE_NODE_CMD[@]}" --file "$TMP_DIR/$ID.json" || exit 1
    ) 1>&2 || ! splice_body || ! run_graph_commit -m "graph: fleet alarm $KIND" "$ID"; then
      # Scratch first — it is always ours, on every branch below.
      rm -f "$NODE_FILE.tmp"
      if [[ -n "$PRE_BLOB" ]]; then
        if ! restore_from_blob "$PRE_BLOB"; then
          log "minting $ID failed AND THE ROLLBACK FAILED — $NODE_REL was NOT restored and must be assumed dirty; a dirty node file blocks every later graph write in this checkout, so check git -C $REPO_ROOT status --porcelain -- $NODE_REL and restore it with git -C $REPO_ROOT checkout -- $NODE_REL"
          exit 70
        fi
      elif [[ "$PRE_EXISTED" == "1" ]]; then
        # origin/main resolves and carries no blob for this path, yet the file
        # was already on disk before this pass — a local-only or not-yet-fetched
        # node. There is nothing to restore it TO, and deleting content this pass
        # did not create is exactly the tracked-deletion fleet-halt the rollback
        # exists to prevent. Leave it and say so plainly.
        log "minting $ID failed and $NODE_REL pre-existed this pass with no origin/main blob to restore — it was left as-is (NOT deleted) and may be dirty, which will block every later graph write in this checkout; inspect it, then restore or remove it by hand"
        exit 70
      else
        # Created by this pass, nothing landed: removing it is the whole rollback.
        rm -f "$NODE_FILE"
      fi
      log "minting $ID failed; the write was rolled back"
      exit 1
    fi
    if ! verify_landed; then
      log "minting $ID could not be verified on origin/main"
      exit 1
    fi
    log "landed new alarm node $ID"
    printf 'landed\n'
    exit 0
    ;;

  open)
    # Re-detection during an ongoing condition. Capture the CAS token first,
    # then refresh the body ONLY if it actually changed — skip the commit
    # entirely when it did not, so a re-detection tick that finds the same
    # condition does not churn a no-op commit.
    MANIFEST=$( (cd "$REPO_ROOT" && "${DUMP_NODE_CMD[@]}" --out-dir "$TMP_DIR/base" "$ID") ) || {
      log "dump-node of $ID failed; cannot refresh the alarm body"
      exit 1
    }
    ONDISK_BODY="$TMP_DIR/$ID.ondisk-body"
    awk 'p; /^---$/{c++; if(c==2) p=1}' "$NODE_FILE" > "$ONDISK_BODY" || {
      log "could not read the on-disk body of $NODE_FILE"
      exit 1
    }
    # Compare against THIS SCRIPT'S OWNED REGION, not the whole body. The body
    # may also carry authored content outside the region (a human's diagnosis on
    # a parked node, which splice_body now preserves), and that content is not
    # ours — including it here would make an unchanged reading look changed and
    # churn a commit on every re-detection tick.
    ONDISK_REGION="$TMP_DIR/$ID.ondisk-region"
    if grep -qxF "$BODY_REGION_OPEN" "$ONDISK_BODY"; then
      awk -v om="$BODY_REGION_OPEN" -v cm="$BODY_REGION_CLOSE" '
        $0 == om { inr = 1; next }
        $0 == cm { inr = 0; next }
        inr { print }
      ' "$ONDISK_BODY" > "$ONDISK_REGION" || {
        log "could not read the owned region of $NODE_FILE"
        exit 1
      }
    else
      # A node written before the region existed: the whole body was ours.
      cp "$ONDISK_BODY" "$ONDISK_REGION" || {
        log "could not read the on-disk body of $NODE_FILE"
        exit 1
      }
    fi
    if cmp -s "$BODY_FILE" "$ONDISK_REGION"; then
      log "$ID is already open with an identical reading — no commit"
      printf 'noop\n'
      exit 0
    fi
    # Second brake (see "TWO INDEPENDENT BRAKES" in the header): the body did
    # change, but a caller whose body churns every pass must still not push to
    # origin/main every pass. Refuse the refresh while inside the interval.
    if (( MIN_REFRESH_INTERVAL > 0 )); then
      LAST_REFRESH="$(refresh_stamp_read)"
      if [[ -n "$LAST_REFRESH" ]]; then
        NOW_EPOCH=$(date -u +%s) || NOW_EPOCH=""
        if [[ "$NOW_EPOCH" =~ ^[0-9]+$ ]]; then
          SINCE_REFRESH=$(( NOW_EPOCH - LAST_REFRESH ))
          # A stamp from the future (clock step) is treated as "just refreshed"
          # rather than as an infinitely old one.
          if (( SINCE_REFRESH < 0 )); then SINCE_REFRESH=0; fi
          if (( SINCE_REFRESH < MIN_REFRESH_INTERVAL )); then
            log "$ID was refreshed ${SINCE_REFRESH}s ago (minimum interval ${MIN_REFRESH_INTERVAL}s) — rate-limited, no commit; the reading is in this pass's log only"
            printf 'noop\n'
            exit 0
          fi
        fi
      fi
    fi
    # Same disambiguation as the mint path: an empty PRE_BLOB only means "no
    # landed content" when origin/main itself resolves. Nothing has been mutated
    # yet at this point, so a ref fault costs only this pass.
    if ! origin_main_ref_ok; then
      log "origin/main does not resolve in $REPO_ROOT (unfetched clone, or a pruned/stale remote-tracking ref) — refusing to refresh $ID without a trustworthy pre-write blob"
      exit 69
    fi
    PRE_BLOB="$(origin_blob || true)"
    refresh_stamp_write
    if ! splice_body || ! run_graph_commit --base "$MANIFEST" -m "graph: refresh fleet alarm $KIND" "$ID"; then
      if [[ -z "$PRE_BLOB" ]]; then
        # An open node with no origin/main blob: the body splice may already have
        # rewritten the on-disk file and there is nothing to restore it to. Never
        # claim a rollback that could not run.
        log "refreshing $ID failed and origin/main carries no blob for $NODE_REL to roll back to — the on-disk node was left as-is and may be dirty, which will block every later graph write in this checkout; inspect it before the next graph write"
        exit 70
      fi
      if ! restore_from_blob "$PRE_BLOB"; then
        log "refreshing $ID failed AND THE ROLLBACK FAILED — $NODE_REL was NOT restored and must be assumed dirty; a dirty node file blocks every later graph write in this checkout, so check git -C $REPO_ROOT status --porcelain -- $NODE_REL and restore it with git -C $REPO_ROOT checkout -- $NODE_REL"
        exit 70
      fi
      log "refreshing $ID failed; the write was rolled back"
      exit 1
    fi
    if ! verify_landed; then
      log "refreshing $ID could not be verified on origin/main"
      exit 1
    fi
    log "refreshed alarm node $ID"
    printf 'landed\n'
    exit 0
    ;;

  *)
    log "unexpected classification '$STATE' for $ID"
    exit 1
    ;;
esac
