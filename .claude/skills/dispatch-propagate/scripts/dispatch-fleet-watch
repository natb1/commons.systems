#!/usr/bin/env bash
#
# dispatch-fleet-watch — ONE-SHOT fleet-health watcher pass.
#
# Reads five independent fleet-health predicates, reports each one, and turns
# every finding (and every unreadable input) into a graph node through
# dispatch-fleet-alarm. Then it exits. It does NOT loop and it takes no deadline
# argument: cadence belongs to the systemd timer that invokes it, not to the
# watcher. A one-shot that the timer re-fires is restartable, observable in
# journald per pass, and cannot wedge in a sleep.
#
# THE SINGLE MOST IMPORTANT PROPERTY: every predicate is evaluated on every
# pass, and the pass NEVER exits on the first violation. The scratch predecessor
# (fleet-health-watch.sh) evaluated predicates in sequence and returned at the
# first finding — so one spurious finding silently stopped every LATER predicate
# from being read at all, and the fleet went unwatched while a watcher appeared
# to be running. Every verdict is collected first; reporting happens once, at
# the end, over the complete set.
#
# THE SECOND MOST IMPORTANT PROPERTY: an unreadable input is `unknown`, never
# `clear`. A watcher that reports "ok" because it could not read the thing it
# watches is worse than no watcher — it manufactures a false all-clear. Any
# `unknown` on any predicate raises a `watch-unknown` alarm naming every
# unreadable input, and the pass never prints a bare `ok`.
#
# Predicates (each returns clear | finding | unknown | quiet):
#   1. tick-stale            age of the newest routing-decisions.jsonl line
#   2. daemon-degraded       delegated to dispatch-daemon-liveness
#   3. busy-stall            sustained BUSY=0 across passes (state-file spanned)
#   4. automerge-suppressed  open tactic-main-red-* latch held too long
#   5. unclaimed-hold        a tracked hold blocking top-ranked work that no
#                            session and no reservation claims
#
# WHY TWO SNAPSHOTS, BOTH CAPTURED AT THE INPUT BOUNDARY:
#   Predicate 3 reads the live session array through
#   claude_agents_count_busy_workers, which already applies the worker keyspace
#   filter (`^[0-9]+-|^tactic-|^strategy-`, lib-claude-agents.sh:1043), and
#   predicate 5 reads it through worktree_has_live_session, one probe per
#   candidate hold/source worktree.
#   THE TWO PREDICATES DO NOT READ THE SAME VIEW. Predicate 3 reads the ACTIVE
#   view (`claude agents --json`, DISPATCH_AGENTS_SNAPSHOT, backing
#   `_claude_agents_raw`); worktree_has_live_session reads the REGISTERED view
#   (`claude agents --json --all`, DISPATCH_AGENTS_SNAPSHOT_ALL, backing
#   `_claude_agents_raw_registered`) — the two are documented as INDEPENDENT at
#   lib-claude-agents.sh:451-461. So this script captures BOTH machine-wide
#   snapshots per pass, via claude_agents_snapshot_capture and
#   claude_agents_snapshot_capture_registered, and exports both variables.
#   Without the registered capture, predicate 5 would still issue up to two live
#   `--all` round-trips PER CANDIDATE ROW.
#   History: the session-keyspace exclusion used to be bolted onto individual
#   predicates one at a time, and the bug recurred every single time a new
#   predicate was added — the new test read the raw array, forgot the filter,
#   and counted routers/human sessions as workers. The filter must be a PROPERTY
#   OF THE INPUT, captured once at the boundary, not a rule each test restates.
#   Predicate 5 inherited the filter for free, without knowing it exists —
#   exactly as this note predicted a fifth predicate would.
#   It does NOT inherit the fail direction, though, and that is the one thing a
#   later predicate must reason about for itself: see "FAIL DIRECTION" on
#   predicate 5 below. Each snapshot's READABILITY is therefore recorded at its
#   capture site (SNAPSHOT_OK for the active view, SNAPSHOT_ALL_OK for the
#   registered one), and predicate 5 gates on SNAPSHOT_ALL_OK — the bit for the
#   view its claim ladder actually reads.
#
# TWO DETAIL STRINGS PER PREDICATE, ON PURPOSE:
#   D_<P>  the READING — carries the live numbers (elapsed spans, ages, counts,
#          stamps). It goes to stdout/journald and to --json, both of which are
#          per-pass records where a changing number is the point.
#   B_<P>  the CONDITION IDENTITY — predicate, threshold, and the offending
#          unit/node ids, and nothing that changes while the condition merely
#          persists. This, and ONLY this, goes into a dispatch-fleet-alarm body.
# Why: an alarm body lands as a graph node on origin/main, and
# dispatch-fleet-alarm skips the commit when a re-detection's body matches the
# body already on disk. A body carrying `${TICK_AGE}s old`, an elapsed
# suppression span, or the raw liveness JSON (MainPID, ActiveEnterTimestamp,
# census pids) differs on EVERY pass, so a single sustained condition would
# fetch/rebase/push to main once per timer tick — ~720 pushes a day at this
# watcher's 5-minute cadence, each arming the four required CI checks, and all
# of it during an outage, when the fleet can least absorb it. The volatile
# reading is not lost: it is in the journald line for that pass.
# test-dispatch-fleet-watch.sh's body-stability case ratchets this by running
# two passes whose readings differ and asserting the emitted bodies are
# byte-identical.
#
# NEVER FLEET-HALT: this script does not write the pause sentinel, does not
# invoke any fleet-halt entry point (the stop/pause scripts), and never writes a blocking edge
# or an office-hours park onto any graph node. Its ONLY graph side effect is via
# dispatch-fleet-alarm, which touches exactly its own tactic-fleet-alarm-<kind>
# nodes. A watcher's job is to record a reading, not to stop the fleet. This is
# ratcheted by grep assertions in test-dispatch-fleet-watch.sh, which fail the
# suite if this file ever grows a pause-sentinel write, either park/blocking
# field name, or an invocation of any command with a known graph-write side
# effect.
#
# NEVER FLEET-RESUME EITHER — the mirror-image rule, and the subtler one. Every
# input this watcher reads must be read through a WRITE-FREE path, because a
# watchdog on an unattended timer has no authority to change the state it is
# watching. The live case is predicate 4: dispatch-graph-main-red-sync, invoked
# with no flag, does not merely read the open tactic-main-red-* latch — when
# repo-health reports main green it COMPLETES those nodes to phase "done", and
# dispatch-select-tick gates auto-merge SOLELY on that set being empty, so
# completing them merges PRs onto main. This watcher therefore invokes it as
# `--read-only` (see that script's header), which skips the recovery-completion
# loop entirely. Deciding that a red episode is over belongs to the scheduler's
# tick, on the tick's cadence, not to a 5-minute watchdog timer reading a
# possibly-transient green.
#
# PAUSE: dispatch_pause_state (lib-pause-state.sh) is consulted ONCE per pass.
#   paused   — predicates 1 and 3 are `quiet` (not evaluated, not reported as
#              clear/finding/unknown, and 3 additionally CLEARS its
#              busy_zero_since stamp so the pause window does not accumulate
#              toward the stall span). Predicates 2, 4 and 5 evaluate normally:
#              a paused fleet still has a live daemon, a suppressed auto-merge
#              latch is still suppressed, and an unclaimed hold blocking
#              top-ranked work is still blocking it. Paused scheduling with
#              manual-only dispatch is a supported STANDING operating mode, and
#              a top-ranked node blocked by a hold nobody is holding is exactly
#              what the human driving that paused fleet needs told.
#   unknown  — ALL FIVE predicates evaluate and emit as normal, each tagged
#              `pause=unknown`, AND the pass emits a watch-unknown finding
#              naming the unreadable pause state. Silencing on an unreadable
#              input is exactly the failure class this rewrite exists to close.
#
# Usage:
#   dispatch-fleet-watch          human-readable per-predicate report
#   dispatch-fleet-watch --json   machine-readable reading (mirrors the shape of
#                                 dispatch-daemon-liveness --json)
#   dispatch-fleet-watch -h|--help
#
# Exit codes:
#   0   every EVALUATED predicate is clear (quiet predicates do not count)
#   1   at least one finding
#   2   at least one unknown and no finding
#   64  usage error
#   69  environment error
#
# Thresholds (seconds):
#   DISPATCH_FLEET_WATCH_TICK_MAX_AGE      default 1500   (25m)
#   DISPATCH_FLEET_WATCH_IDLE_LIMIT        default 2700   (45m)
#   DISPATCH_FLEET_WATCH_SUPPRESSION_LIMIT default 21600  (6h)
#   DISPATCH_FLEET_WATCH_HOLD_MIN_AGE      default 86400  (24h) — how long a
#       hold must have sat unclaimed in the human review queue before it alerts.
#   DISPATCH_FLEET_WATCH_HOLD_TOP_K        default 10 (a COUNT, not seconds) —
#       how many top-ranked live nodes count as "important" for predicate 5's
#       blocked-source gate. Both are passed straight through to the enumerator.
#
# Paths:
#   DISPATCH_DECISION_LOG_FILE / DISPATCH_DECISION_LOG_DIR
#       Resolved EXACTLY as lib-decision-log.sh:68 resolves it, so that
#       library's existing test-override seam works here for free.
#   DISPATCH_FLEET_WATCH_STATE_FILE
#       Cross-pass state (busy_zero_since, suppression_since). Default:
#       ${XDG_DATA_HOME:-$HOME/.local/share}/commons-dispatch/fleet-watch-state.json
#       THIS FILE IS ITSELF A PREDICATE INPUT. Predicates 3 and 4 are SPAN
#       predicates: their verdict is a function of a first-seen stamp persisted
#       here. If the stamp cannot be read or cannot be written (unwritable
#       $HOME, full disk, corrupt JSON), the span cannot be trusted — and a
#       never-persisted stamp yields a span of zero on EVERY pass, i.e. a
#       permanent, self-renewing false `clear` that also keeps resolving any
#       live alarm. So a state read/write failure makes the affected predicate
#       `unknown` (naming this path), never `clear`: the header's
#       "unreadable input is unknown" rule applies to the predicates' own span
#       state exactly as it applies to their primary inputs.
#   DISPATCH_PAUSE_FLAG  — read by lib-pause-state.sh (never written here).
#
# Dependency-injection seams (unset in production; used by
# test-dispatch-fleet-watch.sh so the suite never touches systemd, a real
# `claude agents` daemon, or a real graph/git remote):
#   DISPATCH_FLEET_WATCH_LIVENESS_CMD  default: $SCRIPT_DIR/dispatch-daemon-liveness
#   DISPATCH_FLEET_WATCH_REDSYNC_CMD   default: $SCRIPT_DIR/dispatch-graph-main-red-sync
#                                      ALWAYS invoked with --read-only (see
#                                      "NEVER FLEET-RESUME EITHER" above); a
#                                      substitute must honour that flag.
#   DISPATCH_FLEET_WATCH_ALARM_CMD     default: $SCRIPT_DIR/dispatch-fleet-alarm
#   DISPATCH_FLEET_WATCH_HOLDALERT_CMD Executable run INSTEAD of the whole
#                                      predicate-5 enumerator invocation, with
#                                      NO arguments appended (mirrors
#                                      DISPATCH_HOLD_RECHECK_ENUM in
#                                      lib-stale-hold-recheck.sh). Its stdout
#                                      must carry the same 6-column TSV.
#   CLAUDE_AGENTS_CMD                  lib-claude-agents.sh's own `claude` seam
#   DISPATCH_GRAPH_MAIN_WORKTREE       lib-graph-worktree.sh's root override,
#                                      honoured by resolve_main_worktree (the
#                                      anchor for predicate 5's enumerator and
#                                      worktree probes)
#   DISPATCH_RESERVATION_DIR           lib-reservation-ledger.sh's ledger dir
#
# NOT set -e: every risky step is guarded explicitly so the pass always reaches
# its reporting block (same convention as sibling dispatch-graph-main-red-sync).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

log() { printf 'dispatch-fleet-watch: %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
usage: dispatch-fleet-watch [--json]
       dispatch-fleet-watch -h|--help

One-shot fleet-health watcher pass. Evaluates five predicates (tick-stale,
daemon-degraded, busy-stall, automerge-suppressed, unclaimed-hold), ALWAYS all
five, and records findings / unreadable inputs as graph nodes via
dispatch-fleet-alarm.

exit: 0 all clear, 1 finding, 2 unknown, 64 usage, 69 environment.
USAGE
}

JSON=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage >&2; exit 64 ;;
  esac
done

for tool in jq date; do
  command -v "$tool" >/dev/null 2>&1 || { log "required tool not found: $tool"; exit 69; }
done

# --- injected commands -------------------------------------------------------
LIVENESS_CMD="${DISPATCH_FLEET_WATCH_LIVENESS_CMD:-$SCRIPT_DIR/dispatch-daemon-liveness}"
REDSYNC_CMD="${DISPATCH_FLEET_WATCH_REDSYNC_CMD:-$SCRIPT_DIR/dispatch-graph-main-red-sync}"
ALARM_CMD="${DISPATCH_FLEET_WATCH_ALARM_CMD:-$SCRIPT_DIR/dispatch-fleet-alarm}"

# --- thresholds --------------------------------------------------------------
TICK_MAX_AGE="${DISPATCH_FLEET_WATCH_TICK_MAX_AGE:-1500}"
IDLE_LIMIT="${DISPATCH_FLEET_WATCH_IDLE_LIMIT:-2700}"
SUPPRESSION_LIMIT="${DISPATCH_FLEET_WATCH_SUPPRESSION_LIMIT:-21600}"
HOLD_MIN_AGE="${DISPATCH_FLEET_WATCH_HOLD_MIN_AGE:-86400}"
HOLD_TOP_K="${DISPATCH_FLEET_WATCH_HOLD_TOP_K:-10}"
for t in "$TICK_MAX_AGE" "$IDLE_LIMIT" "$SUPPRESSION_LIMIT" "$HOLD_MIN_AGE" "$HOLD_TOP_K"; do
  [[ "$t" =~ ^[0-9]+$ ]] || { log "threshold must be a non-negative integer, got '$t'"; exit 64; }
done

# --- paths -------------------------------------------------------------------
# Resolved exactly as lib-decision-log.sh:68 does, so DISPATCH_DECISION_LOG_FILE
# / DISPATCH_DECISION_LOG_DIR override this reader and that writer identically.
DECISION_LOG_FILE="${DISPATCH_DECISION_LOG_FILE:-${DISPATCH_DECISION_LOG_DIR:-$HOME/.local/share/commons-dispatch}/routing-decisions.jsonl}"
STATE_FILE="${DISPATCH_FLEET_WATCH_STATE_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/commons-dispatch/fleet-watch-state.json}"

NOW=$(date -u +%s)

WORK_DIR="$(mktemp -d)" || { log "mktemp failed"; exit 69; }
trap 'rm -rf "$WORK_DIR"' EXIT

# --- cross-pass state --------------------------------------------------------
# A tiny JSON object: {"busy_zero_since": <epoch|null>, "suppression_since": <epoch|null>}.
# This one-shot has no memory across runs, so a SPAN predicate (predicate 3's
# "sustained BUSY=0", predicate 4's "suppressed longer than 6h") needs its
# first-seen instant persisted here.
#
# BOTH helpers report failure through their EXIT STATUS, and every caller
# branches on it. An ABSENT state file is not a failure — it is the ordinary
# first-run "no stamp yet". A file that exists but cannot be read, will not
# parse, or holds a non-numeric stamp IS a failure, and so is a write that does
# not land: in either case the span this predicate is built on is unknowable,
# and the predicate must say `unknown` rather than compute a zero-length span
# and call it clear.
state_get() { # <key> -> prints value or empty; exit 1 = state UNREADABLE
  local key="$1" v
  [[ -e "$STATE_FILE" ]] || return 0   # absent = no stamp yet, not an error
  [[ -r "$STATE_FILE" ]] || return 1
  v=$(jq -r --arg k "$key" '.[$k] // empty' "$STATE_FILE" 2>/dev/null) || return 1
  [[ -z "$v" || "$v" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$v"
}

state_set() { # <key> <epoch|null>
  local key="$1" val="$2" tmp existing
  mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || { log "cannot create state dir for $STATE_FILE"; return 1; }
  existing='{}'
  if [[ -r "$STATE_FILE" ]]; then
    existing=$(jq -c . "$STATE_FILE" 2>/dev/null) || existing='{}'
    [[ -n "$existing" ]] || existing='{}'
  fi
  tmp="$WORK_DIR/state.$$.json"
  if [[ "$val" == "null" ]]; then
    jq -c --arg k "$key" 'del(.[$k])' <<<"$existing" > "$tmp" 2>/dev/null || return 1
  else
    jq -c --arg k "$key" --argjson v "$val" '.[$k] = $v' <<<"$existing" > "$tmp" 2>/dev/null || return 1
  fi
  mv -f "$tmp" "$STATE_FILE" 2>/dev/null || return 1
  return 0
}

# --- both snapshots at the input boundary ------------------------------------
# See the header ("WHY TWO SNAPSHOTS"). Capture failure is NOT fatal: the library
# falls back to a live per-call query, which carries its own UNKNOWN contract.
# shellcheck source=/dev/null
if ! source "$SCRIPT_DIR/lib-claude-agents.sh" 2>/dev/null; then
  log "cannot source lib-claude-agents.sh"
  exit 69
fi
# Predicate 5 additionally needs to know whether the REGISTERED-view read
# succeeded — see "FAIL DIRECTION" on that predicate. SNAPSHOT_ALL_OK is that
# bit; SNAPSHOT_OK is the ACTIVE-view sibling, which predicate 5 never reads.
# shellcheck source=/dev/null
if ! source "$SCRIPT_DIR/lib-graph-worktree.sh" 2>/dev/null; then
  log "cannot source lib-graph-worktree.sh"
  exit 69
fi
# shellcheck source=/dev/null
if ! source "$SCRIPT_DIR/lib-reservation-ledger.sh" 2>/dev/null; then
  log "cannot source lib-reservation-ledger.sh"
  exit 69
fi
SNAPSHOT_PATH="$WORK_DIR/agents-snapshot.json"
SNAPSHOT_OK=0
if claude_agents_snapshot_capture "$SNAPSHOT_PATH" 2>/dev/null; then
  export DISPATCH_AGENTS_SNAPSHOT="$SNAPSHOT_PATH"
  SNAPSHOT_OK=1
fi
# The REGISTERED view is a SEPARATE daemon query (`--all`) over a SEPARATE
# variable. Predicate 5's claim ladder reads only this one, so its readability
# is a separate bit — SNAPSHOT_OK says nothing about it.
SNAPSHOT_ALL_PATH="$WORK_DIR/agents-snapshot-all.json"
SNAPSHOT_ALL_OK=0
if claude_agents_snapshot_capture_registered "$SNAPSHOT_ALL_PATH" 2>/dev/null; then
  export DISPATCH_AGENTS_SNAPSHOT_ALL="$SNAPSHOT_ALL_PATH"
  SNAPSHOT_ALL_OK=1
fi

# --- pause state, read ONCE --------------------------------------------------
# shellcheck source=/dev/null
if ! source "$SCRIPT_DIR/lib-pause-state.sh" 2>/dev/null; then
  log "cannot source lib-pause-state.sh"
  exit 69
fi
PAUSE_STATE="$(dispatch_pause_state)"
PAUSED=0
PAUSE_UNKNOWN=0
case "$PAUSE_STATE" in
  paused) PAUSED=1 ;;
  unknown) PAUSE_UNKNOWN=1 ;;
esac

# =============================================================================
# Predicate evaluation. NOTHING below exits early — every predicate runs, its
# verdict is recorded, and reporting happens once at the end over the full set.
# =============================================================================

# --- 1. tick staleness -------------------------------------------------------
# B_TICK is set wherever it must differ from D_TICK — i.e. wherever D_TICK
# carries a value that changes while the condition merely persists (the age, the
# offending timestamp). See "TWO DETAIL STRINGS PER PREDICATE" in the header.
V_TICK="quiet"; D_TICK="paused — not evaluated"; B_TICK=""
if [[ "$PAUSED" -ne 1 ]]; then
  V_TICK="unknown"; D_TICK=""; B_TICK=""
  if [[ ! -r "$DECISION_LOG_FILE" ]]; then
    D_TICK="decision log not readable: $DECISION_LOG_FILE"
  else
    TICK_LAST_LINE=$(tail -n 1 "$DECISION_LOG_FILE" 2>/dev/null)
    if [[ -z "${TICK_LAST_LINE//[[:space:]]/}" ]]; then
      D_TICK="decision log is empty: $DECISION_LOG_FILE"
    elif ! TICK_TS=$(jq -r 'if type == "object" then (.ts // empty) else empty end' <<<"$TICK_LAST_LINE" 2>/dev/null) \
         || [[ -z "$TICK_TS" ]]; then
      D_TICK="last decision-log line has no parseable .ts: $DECISION_LOG_FILE"
    elif ! TICK_EPOCH=$(date -u -d "$TICK_TS" +%s 2>/dev/null) || [[ ! "$TICK_EPOCH" =~ ^[0-9]+$ ]]; then
      D_TICK="last decision-log timestamp will not parse: '$TICK_TS'"
      # The offending value is a per-line datum: a tick writing a fresh
      # unparseable timestamp every pass would churn the body. Identity only.
      B_TICK="the newest decision-log line's .ts will not parse: $DECISION_LOG_FILE"
    else
      TICK_AGE=$(( NOW - TICK_EPOCH ))
      if (( TICK_AGE > TICK_MAX_AGE )); then
        V_TICK="finding"
        D_TICK="newest routing decision is ${TICK_AGE}s old (limit ${TICK_MAX_AGE}s), ts=$TICK_TS"
        B_TICK="the newest routing decision is older than the ${TICK_MAX_AGE}s staleness limit"
      else
        V_TICK="clear"
        D_TICK="newest routing decision is ${TICK_AGE}s old (limit ${TICK_MAX_AGE}s)"
      fi
    fi
  fi
fi

# --- 2. daemon liveness ------------------------------------------------------
# NOT quiet under pause: a paused fleet still has a live daemon, and a dead
# daemon during a pause is exactly the state nobody would otherwise notice.
# Classification is delegated wholesale to dispatch-daemon-liveness (cgroup
# managed-vs-transient reasoning is that script's job, not restated here).
V_DAEMON="unknown"; D_DAEMON=""
LIVENESS_JSON=""
LIVENESS_OUT=$("$LIVENESS_CMD" --json 2>/dev/null)
LIVENESS_RC=$?
LIVENESS_VERDICT=""
LIVENESS_REASON=""
if [[ -n "${LIVENESS_OUT//[[:space:]]/}" ]] && jq -e . >/dev/null 2>&1 <<<"$LIVENESS_OUT"; then
  LIVENESS_JSON="$LIVENESS_OUT"
  LIVENESS_VERDICT=$(jq -r '.verdict // empty' <<<"$LIVENESS_OUT" 2>/dev/null)
  LIVENESS_REASON=$(jq -r '.degraded_reason // empty' <<<"$LIVENESS_OUT" 2>/dev/null)
fi
case "$LIVENESS_RC" in
  0)
    V_DAEMON="clear"
    D_DAEMON="daemon liveness: ${LIVENESS_VERDICT:-managed-live}"
    ;;
  2|3|4)
    V_DAEMON="finding"
    D_DAEMON="daemon liveness: ${LIVENESS_VERDICT:-<verdict unavailable, exit $LIVENESS_RC>}"
    [[ -n "$LIVENESS_REASON" ]] && D_DAEMON="$D_DAEMON — $LIVENESS_REASON"
    ;;
  *)
    V_DAEMON="unknown"
    D_DAEMON="dispatch-daemon-liveness exited $LIVENESS_RC (environment/unclassifiable) — daemon state unreadable"
    ;;
esac

# --- 3. sustained BUSY=0 -----------------------------------------------------
# The count comes from claude_agents_count_busy_workers, which already applies
# the worker keyspace filter and already returns 1 (its own UNKNOWN signal)
# rather than 0 on failure. Do NOT re-derive either here.
V_BUSY="quiet"; D_BUSY="paused — not evaluated"
BUSY_COUNT=""
# The span stamp is an INPUT to this predicate, not bookkeeping around it: an
# unreadable/unwritable stamp is an unreadable input (see the STATE_FILE note in
# the header) and produces `unknown`, never `clear`.
BUSY_STATE_OK=1
if ! BUSY_SINCE_BEFORE="$(state_get busy_zero_since)"; then
  BUSY_STATE_OK=0
  BUSY_SINCE_BEFORE=""
  log "cannot read busy_zero_since from $STATE_FILE"
fi
BUSY_SINCE_AFTER="$BUSY_SINCE_BEFORE"
if [[ "$PAUSED" -eq 1 ]]; then
  # A paused pass CLEARS the stamp: the pause window must not accumulate toward
  # the stall span, or the first pass after a long pause would alarm instantly.
  # The verdict stays `quiet` either way — a quiet predicate resolves nothing,
  # so a failed clear here cannot manufacture an all-clear; it can only leave a
  # stale stamp, which the first unpaused pass re-evaluates.
  if [[ -n "$BUSY_SINCE_BEFORE" ]]; then
    if state_set busy_zero_since null; then
      BUSY_SINCE_AFTER=""
    else
      log "failed to clear busy_zero_since in $STATE_FILE"
    fi
  fi
elif [[ "$BUSY_STATE_OK" -ne 1 ]]; then
  V_BUSY="unknown"
  D_BUSY="busy-stall span state unreadable: $STATE_FILE — busy_zero_since could not be read, so no stall span can be computed or trusted this pass"
else
  if ! BUSY_COUNT=$(claude_agents_count_busy_workers 2>/dev/null) || [[ ! "$BUSY_COUNT" =~ ^[0-9]+$ ]]; then
    # UNKNOWN. LEAVE THE STAMP UNTOUCHED — neither reset nor advanced. "I could
    # not read the session array" is not evidence that zero workers are busy,
    # and it is equally not evidence that some are: resetting would erase a
    # genuine accumulating stall, advancing would fabricate one.
    V_BUSY="unknown"
    D_BUSY="busy-worker count unreadable (claude_agents_count_busy_workers returned UNKNOWN); busy_zero_since left unchanged"
    BUSY_COUNT=""
  elif (( BUSY_COUNT > 0 )); then
    BUSY_STAMP_OK=1
    if [[ -n "$BUSY_SINCE_BEFORE" ]]; then
      if state_set busy_zero_since null; then
        BUSY_SINCE_AFTER=""
      else
        log "failed to clear busy_zero_since in $STATE_FILE"
        BUSY_STAMP_OK=0
      fi
    fi
    if [[ "$BUSY_STAMP_OK" -ne 1 ]]; then
      # Workers ARE busy, so the condition really is clear right now — but the
      # stale stamp we could not delete would fabricate a stall span on a later
      # pass. Report the broken state file rather than a clear that hides it.
      V_BUSY="unknown"
      D_BUSY="$BUSY_COUNT busy worker(s), but busy_zero_since could not be CLEARED in $STATE_FILE — the stale stamp would fabricate a stall span on a later pass"
      B_BUSY="workers are busy, but busy_zero_since could not be CLEARED in $STATE_FILE — the stale stamp would fabricate a stall span on a later pass"
    else
      V_BUSY="clear"
      D_BUSY="$BUSY_COUNT busy worker(s)"
    fi
  else
    BUSY_STAMP_OK=1
    if [[ -z "$BUSY_SINCE_BEFORE" ]]; then
      if state_set busy_zero_since "$NOW"; then
        BUSY_SINCE_AFTER="$NOW"
      else
        log "failed to record busy_zero_since in $STATE_FILE"
        BUSY_STAMP_OK=0
      fi
    fi
    if [[ "$BUSY_STAMP_OK" -ne 1 ]]; then
      # THE false-all-clear trap this branch exists to avoid: with the stamp
      # never persisted, BUSY_SINCE_AFTER stays empty, the span computes as 0,
      # and the predicate reports `clear` and RESOLVES any live busy-stall alarm
      # — on every pass, forever, while nothing is running. Report unknown and
      # name the unwritable file instead.
      V_BUSY="unknown"
      D_BUSY="0 busy workers, but the first-seen stamp could not be PERSISTED to $STATE_FILE — with no stamp the stall span can never accumulate, so no clear/finding verdict is possible"
    else
      BUSY_SPAN=$(( NOW - BUSY_SINCE_AFTER ))
      if (( BUSY_SPAN > IDLE_LIMIT )); then
        V_BUSY="finding"
        D_BUSY="0 busy workers for ${BUSY_SPAN}s (limit ${IDLE_LIMIT}s), since epoch ${BUSY_SINCE_AFTER}"
        B_BUSY="zero busy dispatch workers have been observed continuously for longer than the ${IDLE_LIMIT}s stall limit"
      else
        V_BUSY="clear"
        D_BUSY="0 busy workers for ${BUSY_SPAN}s (under the ${IDLE_LIMIT}s stall limit)"
      fi
    fi
  fi
fi

# --- 4. auto-merge suppression ----------------------------------------------
# READ-ONLY BY CONSTRUCTION: --read-only makes dispatch-graph-main-red-sync skip
# its recovery-completion loop, so this predicate reads the latch and changes
# nothing. Never drop the flag — see "NEVER FLEET-RESUME EITHER" in the header:
# unflagged, this call completes the open tactic-main-red-* nodes when
# repo-health happens to read green, which re-arms the auto-merge gate and
# merges PRs onto main from inside a watchdog pass.
# dispatch-graph-main-red-sync ALWAYS exits 0 by contract (so a caller's `|| true`
# can never swallow its signal); the signal is entirely in stdout. Branch on
# stdout content, NEVER on $?.
# Not quiet under pause: a held latch stays held while the fleet is paused, and
# 6h of suppression is worth knowing about either way.
V_AUTOMERGE="unknown"; D_AUTOMERGE=""
REDSYNC_OUT=$("$REDSYNC_CMD" --read-only 2>/dev/null)
RED_NODES="$(printf '%s' "$REDSYNC_OUT" | sed '/^[[:space:]]*$/d')"
# Same rule as predicate 3: the suppression span stamp is an INPUT here, and an
# unreadable/unwritable stamp is `unknown`, never `clear`.
SUPPRESSION_STATE_OK=1
if ! SUPPRESSION_SINCE_BEFORE="$(state_get suppression_since)"; then
  SUPPRESSION_STATE_OK=0
  SUPPRESSION_SINCE_BEFORE=""
  log "cannot read suppression_since from $STATE_FILE"
fi
SUPPRESSION_SINCE_AFTER="$SUPPRESSION_SINCE_BEFORE"
if [[ "$RED_NODES" == "UNKNOWN" ]]; then
  V_AUTOMERGE="unknown"
  D_AUTOMERGE="dispatch-graph-main-red-sync reported UNKNOWN — the main-red latch could not be read"
elif [[ "$SUPPRESSION_STATE_OK" -ne 1 ]]; then
  V_AUTOMERGE="unknown"
  D_AUTOMERGE="auto-merge suppression span state unreadable: $STATE_FILE — suppression_since could not be read, so no suppression span can be computed or trusted this pass"
elif [[ -z "$RED_NODES" ]]; then
  SUPPRESSION_STAMP_OK=1
  if [[ -n "$SUPPRESSION_SINCE_BEFORE" ]]; then
    if state_set suppression_since null; then
      SUPPRESSION_SINCE_AFTER=""
    else
      log "failed to clear suppression_since in $STATE_FILE"
      SUPPRESSION_STAMP_OK=0
    fi
  fi
  if [[ "$SUPPRESSION_STAMP_OK" -ne 1 ]]; then
    V_AUTOMERGE="unknown"
    D_AUTOMERGE="no open tactic-main-red-* node, but suppression_since could not be CLEARED in $STATE_FILE — the stale stamp would fabricate a suppression span on a later pass"
  else
    V_AUTOMERGE="clear"
    D_AUTOMERGE="no open tactic-main-red-* node; auto-merge is not suppressed"
  fi
else
  # Threshold-gated on purpose: a short red episode is NORMAL and already has
  # its own tactic-main-red-<sha> node elsewhere. Alarming on every episode
  # would train the reader to ignore this alarm kind entirely.
  SUPPRESSION_STAMP_OK=1
  if [[ -z "$SUPPRESSION_SINCE_BEFORE" ]]; then
    if state_set suppression_since "$NOW"; then
      SUPPRESSION_SINCE_AFTER="$NOW"
    else
      log "failed to record suppression_since in $STATE_FILE"
      SUPPRESSION_STAMP_OK=0
    fi
  fi
  RED_NODES_ONELINE="$(printf '%s' "$RED_NODES" | tr '\n' ' ')"
  if [[ "$SUPPRESSION_STAMP_OK" -ne 1 ]]; then
    # Without a persisted first-seen instant the span is 0 on every pass: the
    # latch could stay held indefinitely and this predicate would report clear
    # forever, resolving the very alarm that should be firing.
    V_AUTOMERGE="unknown"
    D_AUTOMERGE="auto-merge suppressed by open node(s) ${RED_NODES_ONELINE% }, but the first-seen stamp could not be PERSISTED to $STATE_FILE — with no stamp the suppression span can never accumulate, so no clear/finding verdict is possible"
  else
    SUPPRESSION_SPAN=$(( NOW - SUPPRESSION_SINCE_AFTER ))
    if (( SUPPRESSION_SPAN > SUPPRESSION_LIMIT )); then
      V_AUTOMERGE="finding"
      D_AUTOMERGE="auto-merge suppressed for ${SUPPRESSION_SPAN}s (limit ${SUPPRESSION_LIMIT}s) by open node(s): ${RED_NODES_ONELINE% }"
      # The node ids ARE the condition's identity and stay; the elapsed span is
      # the reading and does not.
      B_AUTOMERGE="auto-merge has been suppressed beyond the ${SUPPRESSION_LIMIT}s limit by open node(s): ${RED_NODES_ONELINE% }"
    else
      V_AUTOMERGE="clear"
      D_AUTOMERGE="auto-merge suppressed for ${SUPPRESSION_SPAN}s (under the ${SUPPRESSION_LIMIT}s limit) by open node(s): ${RED_NODES_ONELINE% }"
    fi
  fi
fi

# --- 5. an unclaimed hold blocking top-ranked work ---------------------------
# The condition: a tracked hold whose review nobody has picked up has sat in the
# human queue past HOLD_MIN_AGE while blocking a node among the graph's top
# HOLD_TOP_K live, unparked, eligible sources. Nothing else notices — the source
# is simply unselectable, forever, and the fleet looks busy on other work.
#
# Shape copied from lib-stale-hold-recheck.sh steps 1-3c: resolve the main
# checkout, enumerate through a tsx CLI anchored there, then run the SAME
# claimed ladder per candidate. The difference is what the ladder is FOR — there
# it gates a resolve, here it decides whether to alert.
#
# FAIL DIRECTION, and why it needs a guard the resolve sweep does not:
#   For the resolve sweep, fail-safe means KEEP, so an unknown session state
#   folding to "occupied" is exactly right. For an ALERT the same fold is
#   backwards: an unreadable daemon would read as "someone is on it" and
#   SUPPRESS the alarm — a false all-clear, the one failure this whole script
#   exists to prevent. worktree_has_live_session cannot report unknown
#   separately (occupied IS its unknown), so the readability of the daemon view
#   it reads is captured at the input boundary instead and consumed here:
#   no snapshot, no verdict. `unknown` raises watch-unknown and resolves nothing.
#   WHICH VIEW: the ladder below calls worktree_has_live_session, which reads the
#   REGISTERED view (`claude agents --json --all`), NOT the active view predicate
#   3 uses. The gate is therefore SNAPSHOT_ALL_OK. Gating on SNAPSHOT_OK (the
#   active view) would certify an input this predicate never reads: a registered
#   query that fails at probe time folds every candidate to "claimed", HOLD_COUNT
#   stays 0, and the pass reports `clear` — which does not merely suppress the
#   alarm, it sends `--resolve --kind unclaimed-hold` and closes an already-open
#   alarm node. Exporting DISPATCH_AGENTS_SNAPSHOT_ALL also pins the ladder to
#   the same bytes the gate certified, instead of re-querying per candidate row.
#
# Not quiet under pause — see the PAUSE block in the header.
V_HOLD="unknown"; D_HOLD=""; B_HOLD=""
HOLD_COUNT=0
HOLD_PAIRS=""      # identity: one `<hold-id> -> <source-id>` per line
HOLD_READINGS=""   # reading: the same pairs with ages and resolved attention
HOLD_ROOT="$(resolve_main_worktree 2>/dev/null)" || HOLD_ROOT=""
if [[ -z "$HOLD_ROOT" ]]; then
  D_HOLD="repo root unresolvable (no worktree has main checked out and DISPATCH_GRAPH_MAIN_WORKTREE is unset) — unclaimed holds could not be enumerated"
elif [[ "$SNAPSHOT_ALL_OK" -ne 1 || ! -r "$SNAPSHOT_ALL_PATH" ]]; then
  # See FAIL DIRECTION above: without a readable REGISTERED snapshot every
  # candidate would read as claimed and this predicate would report a silent
  # all-clear that ALSO resolves the alarm node. SNAPSHOT_OK is deliberately not
  # consulted — it certifies the active view, which this ladder never reads.
  D_HOLD="the machine-wide claude agents daemon snapshot (registered view, 'claude agents --json --all') could not be captured or is no longer readable — whether a session claims a hold is unreadable, and an unreadable claim must NOT be folded into 'claimed' here (that would suppress this alarm)"
else
  HOLD_OUT=""; HOLD_RC=0
  if [[ -n "${DISPATCH_FLEET_WATCH_HOLDALERT_CMD:-}" ]]; then
    HOLD_OUT=$( (cd "$HOLD_ROOT" && "$DISPATCH_FLEET_WATCH_HOLDALERT_CMD") 2>/dev/null ) || HOLD_RC=$?
  else
    HOLD_OUT=$( (cd "$HOLD_ROOT" && node --import tsx/esm \
      "$HOLD_ROOT/packages/intentionsutil/scripts/list-unclaimed-hold-alerts.ts" \
      --dir "$HOLD_ROOT/intentions" \
      --now "$(date -u -d "@$NOW" +%FT%TZ)" \
      --min-age-seconds "$HOLD_MIN_AGE" \
      --top-k "$HOLD_TOP_K") 2>/dev/null ) || HOLD_RC=$?
  fi
  if (( HOLD_RC != 0 )); then
    # An enumeration that could not run is NEVER "no unclaimed holds".
    D_HOLD="the unclaimed-hold enumerator exited $HOLD_RC — no hold was inspected this pass, which is NOT the same as no hold alerting"
    B_HOLD="the unclaimed-hold enumerator (list-unclaimed-hold-alerts.ts) could not be run"
  else
    HOLD_PARSE_OK=1
    # Seven columns, per list-unclaimed-hold-alerts.ts's stdout contract:
    # hold-id, source-id, kind, age-seconds, source-tier, source-band,
    # source-score. Columns 1-5 have never moved; band/score replaced the old
    # single `value` column when the resolved rank became the
    # (tier, band, score, depth) quadruple, with score APPENDED so this read
    # stays positional.
    while IFS=$'\t' read -r H_ID H_SRC H_KIND H_AGE H_TIER H_BAND H_SCORE; do
      [[ -n "${H_ID}${H_SRC}" ]] || continue
      # Unparseable is unknown, not clear: a row we cannot read may be the very
      # alert that matters. Both ids also become path components below.
      if [[ -z "$H_ID" || -z "$H_SRC" || ! "$H_AGE" =~ ^[0-9]+$ ]]; then
        HOLD_PARSE_OK=0; break
      fi
      case "$H_ID$H_SRC" in
        *..*|*/*|*[[:cntrl:]]*) HOLD_PARSE_OK=0; break ;;
      esac
      # CLAIMED — the "unclaimed" half, checked for the SOURCE and the HOLD
      # alike, exactly as lib-stale-hold-recheck.sh step 3c does. The full
      # worktree PATH goes to worktree_has_live_session, never a bare id.
      if reservation_exists "$H_SRC" 2>/dev/null \
        || worktree_has_live_session "$HOLD_ROOT/.claude/worktrees/$H_SRC" 2>/dev/null \
        || reservation_exists "$H_ID" 2>/dev/null \
        || worktree_has_live_session "$HOLD_ROOT/.claude/worktrees/$H_ID" 2>/dev/null; then
        continue
      fi
      HOLD_COUNT=$(( HOLD_COUNT + 1 ))
      HOLD_PAIRS+="$H_ID -> $H_SRC"$'\n'
      HOLD_READINGS+="$H_ID -> $H_SRC (${H_KIND:-<kind?>}, unclaimed ${H_AGE}s, source tier ${H_TIER:-<tier?>} band ${H_BAND:-<band?>} rank ${H_SCORE:-<score?>}); "
    done <<<"$HOLD_OUT"
    if [[ "$HOLD_PARSE_OK" -ne 1 ]]; then
      V_HOLD="unknown"
      D_HOLD="the unclaimed-hold enumerator emitted a row this pass could not parse (expected <hold-id>TAB<source-id>TAB<kind>TAB<age>TAB<tier>TAB<value>) — no verdict is possible"
      B_HOLD="the unclaimed-hold enumerator emitted an unparseable row"
    elif (( HOLD_COUNT > 0 )); then
      V_HOLD="finding"
      D_HOLD="$HOLD_COUNT unclaimed hold(s) blocking top-${HOLD_TOP_K} work: ${HOLD_READINGS%; }"
      # IDENTITY ONLY. The ages and the resolved tier/value are readings — they
      # move on essentially every graph commit, and a body carrying them would
      # push to origin/main once per 5-minute pass. Sorted so the same set of
      # pairs always renders the same bytes regardless of enumerator ordering.
      B_HOLD="tracked hold(s) have blocked top-ranked work while unclaimed by any session or reservation: $(printf '%s' "$HOLD_PAIRS" | sort | tr '\n' ';' | sed 's/;$//' | sed 's/;/; /g')"
    else
      V_HOLD="clear"
      D_HOLD="no unclaimed hold is blocking top-${HOLD_TOP_K} work (minimum unclaimed age ${HOLD_MIN_AGE}s)"
    fi
  fi
fi

# =============================================================================
# Reporting — runs ONCE, over the complete verdict set.
# =============================================================================
PAUSE_TAG=""
[[ "$PAUSE_UNKNOWN" -eq 1 ]] && PAUSE_TAG=" pause=unknown"

# Where no identity-only string was needed, the body detail IS the reading: an
# `unknown` detail names only the unreadable input (a path, an exit code, a
# threshold), and a `clear` detail never reaches a body at all. Only the
# branches that interpolate a live span/age/count set B_<P> explicitly above.
B_TICK="${B_TICK:-$D_TICK}"
B_DAEMON="${B_DAEMON:-$D_DAEMON}"
B_BUSY="${B_BUSY:-$D_BUSY}"
B_AUTOMERGE="${B_AUTOMERGE:-$D_AUTOMERGE}"
B_HOLD="${B_HOLD:-$D_HOLD}"

FINDING_COUNT=0
UNKNOWN_COUNT=0
UNKNOWN_REASONS=""

note_verdict() { # <verdict> <body-detail>
  case "$1" in
    finding) FINDING_COUNT=$((FINDING_COUNT + 1)) ;;
    unknown) UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1)); UNKNOWN_REASONS+="- $2"$'\n' ;;
  esac
}
# UNKNOWN_REASONS feeds the watch-unknown alarm BODY, so it is built from the
# B_ (identity) strings, not the D_ (reading) strings.
note_verdict "$V_TICK"      "tick-stale: $B_TICK"
note_verdict "$V_DAEMON"    "daemon-degraded: $B_DAEMON"
note_verdict "$V_BUSY"      "busy-stall: $B_BUSY"
note_verdict "$V_AUTOMERGE" "automerge-suppressed: $B_AUTOMERGE"
note_verdict "$V_HOLD"      "unclaimed-hold: $B_HOLD"

# An unreadable PAUSE state is itself an unreadable input — it must raise
# watch-unknown even when all five predicates happened to read cleanly.
if [[ "$PAUSE_UNKNOWN" -eq 1 ]]; then
  UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1))
  UNKNOWN_REASONS+="- pause-state: dispatch_pause_state returned unknown — the sentinel's parent directory exists but is not searchable, so pause state could not be determined. Every predicate was evaluated anyway (pause silences nothing when pause itself is unreadable)."$'\n'
fi

if [[ "$FINDING_COUNT" -gt 0 ]]; then
  EXIT_CODE=1
elif [[ "$UNKNOWN_COUNT" -gt 0 ]]; then
  EXIT_CODE=2
else
  EXIT_CODE=0
fi

# --- alarm dispatch ----------------------------------------------------------
ALARM_FAILED=0
raise_alarm() { # <kind> <statement> <body>
  local kind="$1" statement="$2" body="$3" bodyfile
  bodyfile="$WORK_DIR/alarm-$kind.md"
  printf '%s\n' "$body" > "$bodyfile"
  if ! "$ALARM_CMD" --kind "$kind" --statement "$statement" --body-file "$bodyfile" >&2; then
    log "dispatch-fleet-alarm --kind $kind failed; this pass is journald-only for that finding"
    ALARM_FAILED=1
  fi
}

resolve_alarm() { # <kind>
  local kind="$1"
  if ! "$ALARM_CMD" --resolve --kind "$kind" >&2; then
    log "dispatch-fleet-alarm --resolve --kind $kind failed"
    ALARM_FAILED=1
  fi
}

# One finding alarm per finding predicate; one resolve per DEFINITIVELY clear
# predicate. A `quiet` (paused) predicate resolves nothing — it was not
# evaluated, so it is not evidence the condition cleared. An `unknown`
# predicate resolves nothing either, for the same reason.
dispatch_predicate() { # <verdict> <kind> <statement> <body>
  case "$1" in
    finding) raise_alarm "$2" "$3" "$4" ;;
    clear)   resolve_alarm "$2" ;;
  esac
}

# EVERY body below is CONDITION IDENTITY ONLY — B_<P>, thresholds, paths, the
# pause enum, and the offending node ids. No wall-clock timestamp, no elapsed
# span, no first-seen epoch stamp, no pid, no raw liveness JSON. Those change on
# every pass while a condition merely persists, and each change is a push to
# origin/main plus four CI checks. The full reading for THIS pass is on stdout
# and in --json; the graph node records what is wrong, not when it was looked
# at. See "TWO DETAIL STRINGS PER PREDICATE" in the header.
dispatch_predicate "$V_TICK" tick-stale \
  "The dispatch tick has not recorded a routing decision recently" \
  "$B_TICK

Decision log: $DECISION_LOG_FILE
Threshold: DISPATCH_FLEET_WATCH_TICK_MAX_AGE=${TICK_MAX_AGE}s
Pause state: $PAUSE_STATE"

# The raw dispatch-daemon-liveness JSON is deliberately NOT embedded: it carries
# MainPID, ActiveEnterTimestamp, LastTriggerUSec and census pids, every one of
# which differs pass to pass. It goes to journald below instead.
[[ "$V_DAEMON" == "finding" && -n "$LIVENESS_JSON" ]] && \
  log "daemon-degraded raw dispatch-daemon-liveness --json: $LIVENESS_JSON"
dispatch_predicate "$V_DAEMON" daemon-degraded \
  "The managed dispatch daemon is not healthy" \
  "$B_DAEMON

Liveness exit code: $LIVENESS_RC
Liveness verdict: ${LIVENESS_VERDICT:-<unavailable>}
Degraded reason: ${LIVENESS_REASON:-<none>}
Pause state: $PAUSE_STATE (daemon liveness is evaluated regardless of pause)

The raw dispatch-daemon-liveness --json reading is in this pass's journald
output, not here: it embeds pids and unit timestamps that change every pass."

dispatch_predicate "$V_BUSY" busy-stall \
  "No dispatch worker has been busy for a sustained span" \
  "$B_BUSY

Threshold: DISPATCH_FLEET_WATCH_IDLE_LIMIT=${IDLE_LIMIT}s
State file: $STATE_FILE (busy_zero_since — the live value is in this pass's
journald output and in --json)
Pause state: $PAUSE_STATE"

dispatch_predicate "$V_AUTOMERGE" automerge-suppressed \
  "Auto-merge has been suppressed by an open main-red latch for a sustained span" \
  "$B_AUTOMERGE

Threshold: DISPATCH_FLEET_WATCH_SUPPRESSION_LIMIT=${SUPPRESSION_LIMIT}s
Open main-red node(s):
$RED_NODES
State file: $STATE_FILE (suppression_since — the live value is in this pass's
journald output and in --json)
Pause state: $PAUSE_STATE (auto-merge suppression is evaluated regardless of pause)"

# Identity only: the offending `<hold-id> -> <source-id>` pairs and the two
# threshold names. NOT the unclaimed ages and NOT the resolved source
# tier/value — those move on essentially every graph commit, so a body carrying
# them would push to origin/main once per 5-minute pass. They are on stdout and
# in --json for this pass instead.
dispatch_predicate "$V_HOLD" unclaimed-hold \
  "A tracked hold has blocked top-ranked work with no session claiming it" \
  "$B_HOLD

Thresholds: DISPATCH_FLEET_WATCH_HOLD_MIN_AGE=${HOLD_MIN_AGE}s,
DISPATCH_FLEET_WATCH_HOLD_TOP_K=${HOLD_TOP_K}
Pause state: $PAUSE_STATE (unclaimed holds are evaluated regardless of pause)"

# THE most important single behavior in this script: any unknown, for any
# reason, is announced. A watcher that cannot read its inputs must say so
# loudly rather than emit a false all-clear.
if [[ "$UNKNOWN_COUNT" -gt 0 ]]; then
  raise_alarm watch-unknown \
    "dispatch-fleet-watch could not read $UNKNOWN_COUNT of its inputs this pass" \
    "One or more fleet-health inputs were unreadable on this watcher pass. An
unreadable input is reported as UNKNOWN, never as clear — a false all-clear is
the failure this watcher exists to prevent.

Unreadable inputs:
$UNKNOWN_REASONS
Pause state: $PAUSE_STATE
Decision log: $DECISION_LOG_FILE
State file: $STATE_FILE"
fi

# --- output ------------------------------------------------------------------
if [[ "$JSON" -eq 1 ]]; then
  jq -n \
    --arg pause_state "$PAUSE_STATE" \
    --argjson exit_code "$EXIT_CODE" \
    --argjson finding_count "$FINDING_COUNT" \
    --argjson unknown_count "$UNKNOWN_COUNT" \
    --argjson alarm_failed "$( [[ "$ALARM_FAILED" -eq 1 ]] && echo true || echo false )" \
    --arg v_tick "$V_TICK" --arg d_tick "$D_TICK" \
    --arg v_daemon "$V_DAEMON" --arg d_daemon "$D_DAEMON" \
    --arg v_busy "$V_BUSY" --arg d_busy "$D_BUSY" \
    --arg v_automerge "$V_AUTOMERGE" --arg d_automerge "$D_AUTOMERGE" \
    --arg v_hold "$V_HOLD" --arg d_hold "$D_HOLD" \
    --argjson hold_count "$HOLD_COUNT" \
    --arg busy_count "${BUSY_COUNT:-}" \
    --arg busy_zero_since "${BUSY_SINCE_AFTER:-}" \
    --arg suppression_since "${SUPPRESSION_SINCE_AFTER:-}" \
    --arg red_nodes "$RED_NODES" \
    --argjson liveness_exit "$LIVENESS_RC" \
    --arg unknown_reasons "$UNKNOWN_REASONS" \
    '
    def blank_null: if . == "" then null else . end;
    {
      pause_state: $pause_state,
      exit_code: $exit_code,
      finding_count: $finding_count,
      unknown_count: $unknown_count,
      alarm_write_failed: $alarm_failed,
      predicates: {
        "tick-stale":            { verdict: $v_tick,      detail: $d_tick },
        "daemon-degraded":       { verdict: $v_daemon,    detail: $d_daemon, liveness_exit_code: $liveness_exit },
        "busy-stall":            { verdict: $v_busy,      detail: $d_busy,
                                   busy_count: ($busy_count | blank_null | if . == null then null else tonumber end),
                                   busy_zero_since: ($busy_zero_since | blank_null | if . == null then null else tonumber end) },
        "automerge-suppressed":  { verdict: $v_automerge, detail: $d_automerge,
                                   suppression_since: ($suppression_since | blank_null | if . == null then null else tonumber end),
                                   open_main_red_nodes: ($red_nodes | blank_null | if . == null then [] else split("\n") end) },
        "unclaimed-hold":        { verdict: $v_hold,      detail: $d_hold,
                                   candidate_count: $hold_count }
      },
      unknown_reasons: ($unknown_reasons | blank_null)
    }'
  exit "$EXIT_CODE"
fi

printf 'dispatch fleet watch: pause=%s\n' "$PAUSE_STATE"
printf '  tick-stale:           %-8s %s%s\n' "$V_TICK"      "$D_TICK"      "$PAUSE_TAG"
printf '  daemon-degraded:      %-8s %s%s\n' "$V_DAEMON"    "$D_DAEMON"    "$PAUSE_TAG"
printf '  busy-stall:           %-8s %s%s\n' "$V_BUSY"      "$D_BUSY"      "$PAUSE_TAG"
printf '  automerge-suppressed: %-8s %s%s\n' "$V_AUTOMERGE" "$D_AUTOMERGE" "$PAUSE_TAG"
printf '  unclaimed-hold:       %-8s %s%s\n' "$V_HOLD"      "$D_HOLD"      "$PAUSE_TAG"

# Never print a bare `ok` when anything is unknown — that is the false
# all-clear this watcher exists to prevent.
if [[ "$UNKNOWN_COUNT" -gt 0 ]]; then
  printf 'result: unknown (%s finding(s), %s unreadable input(s)) — watch-unknown alarm raised\n' \
    "$FINDING_COUNT" "$UNKNOWN_COUNT"
elif [[ "$FINDING_COUNT" -gt 0 ]]; then
  printf 'result: finding (%s)\n' "$FINDING_COUNT"
else
  printf 'result: ok\n'
fi
[[ "$ALARM_FAILED" -eq 1 ]] && printf 'note: at least one dispatch-fleet-alarm graph write FAILED this pass\n'

exit "$EXIT_CODE"
