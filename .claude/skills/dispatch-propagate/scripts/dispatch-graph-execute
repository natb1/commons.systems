#!/usr/bin/env bash
# dispatch-graph-execute — the graph lane's complete launch primitive (Shape B,
# strategy-graph-native-dispatch clarification 24). The graph sibling of the
# legacy issue-lane dispatch-launch-worker, keyed on `<id:kind:phase>` instead
# of `<N> <worktree>`. The legacy scripts (dispatch-materialize-spawn →
# dispatch-launch-worker) stay issue-lane-only and retire with the drain
# (tactic-legacy-router-removal).
#
# Called by dispatch-tick on a `graph <count> <id:kind:phase>...` decision.
# For each selected node it spawns the phase as its OWN top-level orchestrator
# session that invokes the phase skill DIRECTLY — not a runner session that
# invokes a workflow. This is the Shape-B fix: the top-level session already
# holds the Workflow tool, so a phase skill that is itself a workflow
# (/review-fix, /qa-fix) runs directly, instead of being fanned out as an
# agent() subagent (which is NOT granted the Workflow tool and parked every
# tick). The orchestrator runs on sonnet for every phase; opus is reintroduced
# only inside each phase's own workflow (e.g. /review-fix's fix author,
# /implement's per-unit /implement-unit).
#
# For each selected node it:
#
#   1. Validates the node id and maps the directive from the PERSISTED phase
#      (phase derivation never runs for node targets — strategy clarification 1):
#        strategy            → /align-tactics <node-id>
#        tactic implement    → /implement,  fix → /fix-checks, qa → /qa-fix,
#               review       → /review-fix, main-qa → /qa-main
#   2. Resolves orchestrator effort from the persisted phase via
#      dispatch-phase-effort (orthogonal to the model; implement → medium). The
#      orchestrator model is a launch-layer concern hardcoded to sonnet here
#      (ORCH_MODEL) — the shared per-phase SUBAGENT/worker model emitter is
#      shared with the legacy dispatch-launch-worker lane (where /implement
#      worktree sessions legitimately inherit Opus), so it is left untouched.
#   3. Launches the phase:
#        - Strategy lane: a strategy node has no PR/CI/merge gate and
#          /align-tactics owns its own worktree claim/entry, so it is NOT
#          pre-provisioned — spawn cwd=PROJECT_ROOT with prompt
#          `/align-tactics <id>` and let the skill enter its own worktree.
#        - Tactic lane: tactic phases derive their target from the worktree
#          branch (BRANCH split in implement/review-fix/fix-checks/qa-fix/
#          qa-main), so the cwd is load-bearing — pre-provision via
#          provision-node-worktree and spawn with --cwd <worktree>, prompt
#          `<skill> <id>`. Mechanical provision dispositions are handled here at
#          zero token cost (no `claude` session), mirroring
#          dispatch-launch-worker.
#   4. Hands off (does not drop) the node's reservation-ledger marker on a
#      successful kick: it is re-stamped `origin=spawned` with a fresh
#      timestamp (reservation_mark_spawned) instead of cleared outright, so the
#      claim survives the boot window before the worker's own live session
#      registers. It is released by reservation_sweep rule (a) once that
#      session registers, or by the handoff TTL if it never does. The
#      stale-selection (exit 12) and scope-stale (exit 13) dispositions still
#      clear the marker outright — no spawn happened there. On a failed kick
#      the marker is still LEFT for the sweep, so the budget still counts the
#      slot until reconciliation.
#
# Usage: dispatch-graph-execute [--allow-stale] <id:kind:phase> [<id:kind:phase> ...]
#
# Stdout: one line per node — one of:
#   launched <id> <skill>   the phase session was kicked.
#   waiting <id>            provision exit 10 (ci-waiting) — retry next tick.
#   skipped <id>            provision exit 12 (stale-selection) — no graph write.
#   scope-stale <id>        provision exit 13 — node demoted to implement.
#                           Rare post-sweep safety net now (the pre-selection
#                           dispatch-graph-scope-sweep enumerator handles the
#                           common case before launch), not the routine path.
#   parked <id>             a mechanical failure parked the node (office_hours
#                           graph write, never a label).
#   conflict-lane <id>      provision exit 11 (merge-conflict) — a
#                           /dispatch-conflict session was kicked in the node's
#                           own worktree to resolve the conflict on Lane 3. The
#                           first responder; no graph write, no strike counted.
#   held <id>               provision exit 11 where the conflict lane could NOT
#                           be kicked, on the CONFLICT_STRIKE_CAP-th such
#                           consecutive failure — a tracked hold tactic was
#                           born/re-entered via hold-node; the source's own
#                           office_hours is never written.
#   held <id> worktree-residue
#                           provision exit 14 (worktree unusable — mechanical
#                           residue from a dead session, NOT a content
#                           conflict). A `worktree-residue` tracked hold tactic
#                           was born/re-entered via hold-node, carrying the
#                           `git status` / `git diff --stat` evidence. Escalates
#                           on the FIRST occurrence — no strike ladder, because
#                           the state is steady and has no autonomous repair
#                           path. Never routed to the conflict lane; the
#                           source's own office_hours is never written.
#   refused <id> unknown-freshness
#                           provision exit 15 — the selection gate could not
#                           prove the store snapshot is fresh. An ENVIRONMENT
#                           condition, not a node defect: no graph write, no
#                           park. The reservation is cleared (mirrors exit 12)
#                           so the next tick re-selects once the fetch works.
#   failed <id> <reason>    the node could neither launch nor cleanly dispose.
#                           On exit 11 below the cap this is
#                           `failed <id> spawn-failed (strike N/CAP)`: the
#                           conflict-lane kick failed, the sidecar strike
#                           counter was bumped, and no graph write was made.
#
# Exit codes: 0 every node launched or cleanly disposed (launched/waiting/
# skipped/scope-stale/parked/conflict-lane/held — including the exit-14
# `held <id> worktree-residue` disposition — are all RC-0 dispositions);
# 1 at least one node could neither launch nor cleanly dispose (a spawn kick
# failed — no park is attempted, the marker is left for the sweep — or a
# park-node/hold-node/demote call itself failed); 2 usage/configuration error.
#
# Requires `dangerouslyDisableSandbox: true` — provision-node-worktree runs git,
# gh, and direnv, and dispatch-spawn-job spawns `claude --bg`.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-reservation-ledger.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-graph-worktree.sh"
# Best-effort decision-log attestation (tactic-graph-execute-fresh-main-read
# Unit 3) for a launch made with --allow-stale. Tolerant of a missing lib —
# the `command -v decision_log_append` guard below never wedges a launch.
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-decision-log.sh" 2>/dev/null || true

# --allow-stale: an operator override forwarded from the manual `dispatch`
# lane, parsed here as a single optional leading flag ahead of the
# <id:kind:phase> specs.
ALLOW_STALE=""
while [[ $# -gt 0 && "$1" == "--allow-stale" ]]; do
  ALLOW_STALE=1
  shift
done

if [[ $# -lt 1 ]]; then
  echo "usage: dispatch-graph-execute [--allow-stale] <id:kind:phase> [<id:kind:phase> ...]" >&2
  exit 2
fi

# Project root = the worktree with `main` checked out (substrate clarification
# 23). resolve_main_worktree honors DISPATCH_GRAPH_MAIN_WORKTREE, the test
# override.
PROJECT_ROOT=$(resolve_main_worktree 2>/dev/null)
if [[ -z "$PROJECT_ROOT" || ! -d "$PROJECT_ROOT" ]]; then
  echo "dispatch-graph-execute: cannot resolve the project root (no worktree with 'main' checked out)" >&2
  exit 2
fi

# The orchestrator session runs sonnet for every phase (Shape B). This is a
# launch-layer rule, hardcoded here rather than routed through the shared
# per-phase model emitter (which the legacy lane still depends on — see the
# header). Opus is reintroduced only inside each phase's own workflow.
ORCH_MODEL="sonnet"

# park-node / demote-node-to-implement / hold-node live under the
# intentionsutil package, not beside this script. Resolve them from the
# project root.
PARK_NODE="$PROJECT_ROOT/packages/intentionsutil/scripts/park-node"
DEMOTE_NODE="$PROJECT_ROOT/packages/intentionsutil/scripts/demote-node-to-implement"
HOLD_NODE="$PROJECT_ROOT/packages/intentionsutil/scripts/hold-node"

# Conflict-retry cap for the Producer 1 free-retry tier below (provision exit
# 11 — merge-conflict). A baked-in constant, deliberately NOT a
# `dispatch.config` tunable — parity with FIX_ATTEMPT_CAP
# (packages/intentionsutil/src/transitions.ts:101), which caps the CI-fix
# interrupt's own retry ladder the same way. Set higher than that cap (5, not
# 3): ticks are frequent and cheap, so the free tier's whole point is to spend
# cheap ticks rather than graph records; only after CONFLICT_STRIKE_CAP
# consecutive failures does this producer pay for a tracked hold.
CONFLICT_STRIKE_CAP=5

FAILURES=0

# hand_off_reservation <id> — the spawn handoff, at every successful-kick site.
# Non-fatal by design: the worker is already launched, so failing the kick here
# would be worse than the degradation. But the degradation is NOT silent — if the
# re-stamp fails (unwritable ledger dir, failed mv), the OLD marker survives with
# its selection-time origin, so reservation_sweep falls back to the pre-handoff
# lifecycle and reclaims it as dead-session-stranded once the 30s boot grace
# lapses. That is exactly the duplicate-worker window this handoff exists to
# close, so name the consequence on stderr where a log grep can find it.
hand_off_reservation() {
  local node_id="$1"
  reservation_mark_spawned "$node_id" || \
    echo "dispatch-graph-execute: WARNING: spawn handoff re-stamp failed for $node_id; the claim reverts to the pre-handoff sweep lifecycle and the boot-window duplicate-worker guard is OFF for this node" >&2
}

for spec in "$@"; do
  IFS=: read -r id kind phase <<<"$spec"
  if [[ -z "$id" || -z "$kind" || -z "$phase" ]]; then
    echo "failed $spec malformed-spec"
    FAILURES=$(( FAILURES + 1 ))
    continue
  fi

  # Validate the node id — it flows into --name and the spawn prompt (mirror
  # provision-node-worktree:52, dispatch-launch-worker id validation). The slug
  # regex already excludes numeric-prefixed (legacy gh lane) names.
  if [[ ! "$id" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
    echo "failed $id invalid-node-id"
    FAILURES=$(( FAILURES + 1 ))
    continue
  fi

  # Directive mapping from the persisted phase (never re-derived).
  case "$kind:$phase" in
    strategy:*)          SKILL="/align-tactics"; MODEL_PHASE="align-tactics" ;;
    tactic:align-tactics) SKILL="/align-tactics"; MODEL_PHASE="align-tactics" ;;
    tactic:implement)    SKILL="/implement";     MODEL_PHASE="implement" ;;
    tactic:fix)          SKILL="/fix-checks";    MODEL_PHASE="fix-checks" ;;
    tactic:conflict)     SKILL="/dispatch-conflict"; MODEL_PHASE="conflict" ;;
    tactic:qa)           SKILL="/qa-fix";        MODEL_PHASE="qa" ;;
    tactic:review)       SKILL="/review-fix";    MODEL_PHASE="review" ;;
    tactic:main-qa)      SKILL="/qa-main";       MODEL_PHASE="main-qa" ;;
    *)
      # An unmapped kind/phase is a selection-side defect; leave the
      # reservation for the sweep and surface it.
      echo "failed $id unmapped-kind-phase:$kind:$phase"
      FAILURES=$(( FAILURES + 1 ))
      continue
      ;;
  esac

  # Orchestrator effort is orthogonal to the (hardcoded sonnet) model. Empty
  # means "inherit the session default" — omit the flag entirely.
  EFFORT=$("$SCRIPT_DIR/dispatch-phase-effort" "$MODEL_PHASE") || EFFORT=""
  EFFORT_ARGS=()
  [[ -n "$EFFORT" ]] && EFFORT_ARGS=(--effort "$EFFORT")

  if [[ "$kind" == "strategy" || "$phase" == "align-tactics" ]]; then
    # Strategy lane (and a frozen-tactic align target): no pre-provision —
    # /align-tactics owns its own worktree claim/entry, keyed on the node id
    # (a strategy's id, or a frozen tactic's id). Spawn cwd=PROJECT_ROOT and let
    # the skill enter its worktree.
    if "$SCRIPT_DIR/dispatch-spawn-job" --no-verify --name "$id" \
        --cwd "$PROJECT_ROOT" --model "$ORCH_MODEL" "${EFFORT_ARGS[@]}" \
        "$SKILL $id" 1>&2; then
      # Hold the claim through the boot window; reservation_sweep rule (a)
      # releases it once the worker registers.
      hand_off_reservation "$id"
      echo "launched $id $SKILL"
    else
      echo "failed $id spawn-failed"
      FAILURES=$(( FAILURES + 1 ))
    fi
    continue
  fi

  # Tactic lane: pre-provision the worktree (cwd is load-bearing — the phase
  # skill derives its target from the branch). Route on the provision exit code;
  # NO `claude` session spawns on any non-zero path (mirrors the retired graph
  # tick workflow's per-node routing, moved up here at zero token cost).
  WT=$("$SCRIPT_DIR/provision-node-worktree" ${ALLOW_STALE:+--allow-stale} "$id" "$phase")
  prov_rc=$?
  case "$prov_rc" in
    0)
      # WT is the worktree path provision printed on stdout. A successful
      # provision means any prior merge-conflict retry state self-resolved;
      # reset the Producer 1 strike counter (below) so it means "consecutive
      # failures", not a lifetime total.
      rm -f "$PROJECT_ROOT/.claude/worktrees/$id.conflict-strikes"
      rm -f "$PROJECT_ROOT/.claude/worktrees/$id.conflict-lane"
      if "$SCRIPT_DIR/dispatch-spawn-job" --no-verify --name "$id" \
          --cwd "$WT" --model "$ORCH_MODEL" "${EFFORT_ARGS[@]}" \
          "$SKILL $id" 1>&2; then
        # Hold the claim through the boot window; reservation_sweep rule (a)
        # releases it once the worker registers.
        hand_off_reservation "$id"
        # Attestation (tactic-graph-execute-fresh-main-read Unit 3): when this
        # launch was made with an operator's --allow-stale override, record it
        # in the decision log so a stale dispatch is attributable after the
        # fact rather than silent (I17). Best-effort only — a missing lib, a
        # missing sidecar, or a jq failure must never wedge an already-kicked
        # launch, so every step here is guarded and non-fatal.
        if [[ -n "${ALLOW_STALE:-}" ]] && command -v decision_log_append >/dev/null 2>&1; then
          SNAPSHOT_SIDECAR="$PROJECT_ROOT/.claude/worktrees/$id.snapshot-provenance"
          allow_stale_json=$(jq -c -n \
            --arg ts       "$(date -u +%FT%TZ)" \
            --arg site     "graph-execute" \
            --arg target   "$id" \
            --arg phase    "$phase" \
            --arg disp     "allow-stale" \
            --argjson snapshot "$(cat "$SNAPSHOT_SIDECAR" 2>/dev/null || echo null)" \
            '{ts: $ts, site: $site, target: $target, phase: $phase, disposition: $disp, snapshot: $snapshot}' \
            2>/dev/null) && decision_log_append "$allow_stale_json" || true
        fi
        echo "launched $id $SKILL"
      else
        # Leave the reservation for the sweep — the budget keeps counting the
        # slot until the ledger reconciles, and the next tick may retry.
        echo "failed $id spawn-failed"
        FAILURES=$(( FAILURES + 1 ))
      fi
      ;;
    10)
      # ci-waiting: a draft PR's checks are still in progress. Leave the
      # reservation; the next tick re-selects once the CI verdict lands.
      #
      # NO STRIKE LADDER, and this is deliberate rather than an oversight. Exit
      # 10 is reachable ONLY when the selector's own ci-ready gate passed
      # moments earlier in this same tick — it is an intra-tick race, not a
      # sustained state. The SUSTAINED form of the same condition is already
      # counted one layer up, at graph-select-target's `ci-pending` arm, against
      # DISPATCH_CI_PENDING_STRIKE_CAP (lib.sh). A second independent counter
      # here would count the same stall twice and hold the node at half the
      # intended budget.
      echo "waiting $id"
      ;;
    11)
      # merge-conflict, Producer 1 (tactic-mechanical-park-producers). This is
      # a mechanical state with an autonomous resolver, not "no autonomous path
      # exists, a human is required".
      #
      # FIRST RESPONDER: route the conflict to /dispatch-conflict's Lane 3
      # ("node-branch git conflict", .claude/skills/dispatch-conflict/SKILL.md)
      # — it reproduces the aborted merge on the node's own branch, resolves it
      # via an opus subagent, verifies against the node's own plan, and pushes;
      # an ambiguous conflict escalates to a tracked hold there. Lane 3 is
      # entered by the source node id (or by the id of the provision-conflict
      # hold tracking it), which is what retires the blind up-to-4 retries the
      # strike counter used to spend before anyone looked at the conflict.
      #
      # The worktree path is deterministic (provision-node-worktree composes it
      # the same way; it only PRINTS it on exit 0), and exit 11 leaves that
      # worktree and its branch in place with the merge already aborted — the
      # exact state Lane 3's Step 3 expects.
      #
      # CONVERGENCE NOTE: this strike/hold branch is an interim step. A
      # separate in-flight tactic (tactic-graph-router-conflict-routing) is
      # expected to replace it with an `execution.conflict` interrupt; once
      # that lands, the cap it enforces will call this SAME hold-node
      # primitive instead of the strike-counting logic below — this branch is
      # expected to be replaced wholesale at that point, not extended. That
      # interrupt is simply a SECOND entry path into the same Lane 3 this
      # branch now kicks directly.
      # The backstop ladder's sidecar counts CONSECUTIVE failures to LAUNCH the
      # lane — that is what its hold reason asserts verbatim below. A successful
      # kick therefore has to reset it, exactly as the exit-0 path resets it
      # above; otherwise launch failures scattered across weeks and separated by
      # successful kicks accumulate into a hold whose stated reason ("could not
      # be launched for N consecutive ticks") is false.
      STRIKE_FILE="$PROJECT_ROOT/.claude/worktrees/$id.conflict-strikes"
      # LANE_FILE: a sidecar marker, same convention as STRIKE_FILE and
      # provision-node-worktree's own `.scope-fingerprint` — a plain file
      # outside every checkout, so it never dirties a tree and is never a
      # graph write. Written on a successful Lane 3 kick below so a later
      # sweep (not part of this unit) can detect a stuck lane. Fail-open on
      # loss: losing it just means no hold is ever raised for that episode —
      # never a spurious one.
      LANE_FILE="$PROJECT_ROOT/.claude/worktrees/$id.conflict-lane"
      # REAP CONTRACT: `--name "$id"` alone makes this session a graph-native
      # NODE WORKER — dispatch-stop.sh's discriminator 2 matches it (name ==
      # node id, `intentions/<id>.md` present) and hands it to
      # `dispatch-self-close --node "$id"`, which reaps only on a
      # `$CLAUDE_JOB_DIR/node-terminal` marker naming this node and otherwise
      # HOLDS the job alive. Both the name match and the `intentions/<id>.md`
      # presence hold in the primary checkout (graph writes are direct-push to
      # `main`), so this contract does not depend on which tree the session
      # spawns in. A held job stays live in `claude agents --json`, and
      # graph-select-target's `worktree_has_live_session` check is name-keyed on
      # the node id — so a Lane 3 session that never declares its terminal
      # disposition would make the node permanently unselectable AND permanently
      # occupy a live-session slot. Lane 3 therefore declares it on BOTH terminal
      # paths (`mark-node-terminal "$SOURCE_ID" conflict-resolved` at its Step 9,
      # `... conflict-hold` at its Step 10; Step 7's park-node writes its own).
      #
      # The spawn cwd is PROJECT_ROOT, not the node's own worktree: that
      # worktree is guaranteed stale on this path — its origin/main merge is
      # what just failed and was aborted, so a session spawned there reads its
      # own skill body and helpers out of a tree already known to be behind.
      # This has twice landed a session running a stale skill body — once
      # missing office_hours handling, once predating the terminal-declaration
      # contract above, deadlocking a worker slot for over an hour. Lane 3
      # instead drives the node worktree by absolute path (`git -C`) once it
      # needs it.
      #
      # Do not spawn this session under a name that is NOT the node id without
      # first teaching the selector's occupancy check about that name.
      #
      # No "${EFFORT_ARGS[@]}" here: the effort resolved above belongs to the
      # node's own phase skill, and this session runs /dispatch-conflict
      # instead — it inherits the session default.
      if "$SCRIPT_DIR/dispatch-spawn-job" --no-verify --name "$id" \
          --cwd "$PROJECT_ROOT" --model "$ORCH_MODEL" \
          "/dispatch-conflict $id" 1>&2; then
        rm -f "$STRIKE_FILE"
        # Best-effort bookkeeping only — never changes this branch's
        # disposition (echo/continue/exit code). One fixed line so a reader
        # can `sed -n 's/^spawned=//p' | head -n1`. Overwrite, not append: a
        # later kick for the same node starts a new episode.
        printf 'spawned=%s\n' "$(date -u +%s)" > "$LANE_FILE" || echo "dispatch-graph-execute: WARNING: could not write $LANE_FILE; a stuck conflict lane for $id will not be escalated" >&2
        # Hold the claim through the boot window; reservation_sweep rule (a)
        # releases it once the worker registers.
        hand_off_reservation "$id"
        echo "conflict-lane $id"
        continue
      fi

      # BACKSTOP (below): the conflict lane itself could not be kicked. Fall
      # back to the strike-then-hold ladder so repeated launch failures still
      # reach a human through a tracked hold rather than silently retrying
      # forever. This ladder is no longer the first responder.
      #
      # Strike counter: a sidecar file OUTSIDE every checkout (the same
      # convention as provision-node-worktree's own `.scope-fingerprint`
      # sidecar), so it never dirties a tree and is never a graph write.
      # Losing the counter (daemon restart, reaped worktree) is fine and
      # deliberately fail-open — it just grants more free retries.
      STRIKES=$(cat "$STRIKE_FILE" 2>/dev/null || echo 0)
      [[ "$STRIKES" =~ ^[0-9]+$ ]] || STRIKES=0
      STRIKES=$(( STRIKES + 1 ))

      if (( STRIKES < CONFLICT_STRIKE_CAP )); then
        # Below the cap: bump the sidecar and surface the failed kick. NO graph
        # write of any kind. The reservation is LEFT for the sweep and the
        # failure is counted — the same handling the exit-0 path gives its own
        # spawn failure, since this is that same failure.
        printf '%s\n' "$STRIKES" > "$STRIKE_FILE"
        echo "failed $id spawn-failed (strike $STRIKES/$CONFLICT_STRIKE_CAP)"
        FAILURES=$(( FAILURES + 1 ))
      else
        # Cap exceeded: escalate to a tracked hold (hold-node, units 1-2 of
        # this same plan) instead of parking the source directly. hold-node
        # births a small born-parked hold tactic carrying the office_hours
        # park and adds a blocked_by edge from the source — the source's own
        # office_hours is never written. The hold id is also a valid
        # /dispatch-conflict Lane 3 entry point (discriminator case 2), so a
        # human draining it can hand the same conflict back to the lane.
        TMPDIR_HOLD11=$(mktemp -d) || {
          echo "failed $id hold-mktemp-failed"
          FAILURES=$(( FAILURES + 1 ))
          continue
        }
        REASON_FILE="$TMPDIR_HOLD11/reason"
        RECOMMENDATION_FILE="$TMPDIR_HOLD11/recommendation"
        # Exit 11 has TWO causes, and this producer cannot tell them apart: the
        # branch does not merge origin/main clean, OR it does not merge its OWN
        # pushed tip origin/<id> clean (provision-node-worktree's pushed-tip
        # alignment, which runs first). Naming only origin/main here
        # would state something false half the time — exactly the wrong-reason
        # failure this hold path exists to avoid. The provision stderr line in
        # the tick journal names the actual conflicting ref.
        printf '%s\n' "This tactic's branch does not merge clean (provision exit 11) — either against \`origin/main\` or against its own pushed tip \`origin/$id\`; the provision stderr line in the tick journal names which ref — and the /dispatch-conflict Lane 3 session that resolves it could not be launched for $STRIKES consecutive ticks." > "$REASON_FILE"
        printf '%s\n' "Run \`/dispatch-conflict $id\` by hand (Lane 3 reproduces and resolves the merge on the node's own branch; it merges \`origin/$id\` before reproducing the \`origin/main\` merge, which covers both causes), or resolve the conflict directly in \`.claude/worktrees/$id\` and push the branch. Either way, also check why the autonomous launch kept failing. Then resolve THIS HOLD TACTIC to \`phase: done\` and prune it — clearing \`office_hours\` alone does not unblock the source." > "$RECOMMENDATION_FILE"
        if "$HOLD_NODE" "$id" --kind provision-conflict \
            --reason-file "$REASON_FILE" --recommendation-file "$RECOMMENDATION_FILE"; then
          rm -f "$STRIKE_FILE"
          rm -f "$LANE_FILE"
          echo "held $id"
        else
          echo "failed $id hold-failed"
          FAILURES=$(( FAILURES + 1 ))
        fi
        rm -rf "$TMPDIR_HOLD11"
      fi
      ;;
    12)
      # stale-selection: the directive changed after selection. Clear the claim
      # and make NO graph write; the next tick re-selects from current state.
      reservation_clear "$id" || true
      echo "skipped $id"
      ;;
    13)
      # scope-stale: the tactic's scope changed after the previous phase. The
      # common path for this disposition now runs BEFORE selection, in the
      # dispatch-graph-scope-sweep enumerator wired into dispatch-select-tick's
      # Step 1d (landed in a prior unit of this same plan) — so a metadata-only
      # scope-stale demote no longer routinely consumes a launch slot here. This
      # launch-time path only fires as a post-sweep safety re-check for scope
      # drift introduced between the sweep and this provision call (e.g. a
      # concurrent author/session edit landing in that window); it should be
      # rare. Demote to implement so its ladder re-runs against the merge-time
      # scope, and clear the reservation (mirrors case 12 above) so the demoted
      # node is freed for next-tick re-selection rather than staying counted
      # against the budget.
      reservation_clear "$id" || true
      if "$DEMOTE_NODE" "$id"; then
        echo "scope-stale $id"
      else
        echo "failed $id demote-failed"
        FAILURES=$(( FAILURES + 1 ))
      fi
      ;;
    14)
      # worktree-residue: provision-node-worktree's precondition guard refused
      # the worktree because it carries MECHANICAL RESIDUE from a dead session
      # (a dirty tracked tree, or a detached HEAD / in-progress operation it
      # could not auto-repair). This is NOT a content conflict — origin/main
      # merges clean the instant the residue is cleared — so it must never be
      # routed to /dispatch-conflict's Lane 3, whose whole contract assumes a
      # clean tree with a reproducible merge conflict.
      #
      # NO STRIKE LADDER. Exit 14 is a steady state with no autonomous repair
      # path: nothing a later tick does clears a dirty file or an unreferenced
      # detached HEAD, and the one repair that IS safe (aborting an in-progress
      # operation) already happened inside provision-node-worktree before it
      # chose this exit. So it escalates on the FIRST occurrence — deliberately
      # not reusing CONFLICT_STRIKE_CAP or the `.conflict-strikes` sidecar,
      # which count consecutive failures of a thing that could have succeeded.
      #
      # Like the exit-11 backstop, this births a born-parked HOLD TACTIC via
      # hold-node and adds a blocked_by edge from the source; the source's own
      # office_hours is never written, so NO park-node call belongs here.
      RESIDUE_WT="$PROJECT_ROOT/.claude/worktrees/$id"
      TMPDIR_HOLD14=$(mktemp -d) || {
        echo "failed $id hold-mktemp-failed"
        FAILURES=$(( FAILURES + 1 ))
        continue
      }
      REASON_FILE="$TMPDIR_HOLD14/reason"
      RECOMMENDATION_FILE="$TMPDIR_HOLD14/recommendation"
      # The evidence is captured HERE, once, so the drain has the diff in hand
      # without re-entering the worktree. The script runs `set -uo pipefail`
      # (no -e) and each git call is `|| echo`-guarded, so an unreadable
      # worktree yields an explanatory line rather than a silently empty
      # section — and cannot abort the loop.
      {
        printf '%s\n\n' "provision-node-worktree refused to provision this tactic's worktree: it carries mechanical residue from a dead session (exit 14), not a content conflict. \`origin/main\` merges clean once the residue is cleared — with one exception the status output below distinguishes: on the \`failed-merge-abort\` condition a merge git could NOT abort is still in progress (MERGE_HEAD present, \`UU\` paths), and that merge has to be finished or aborted before anything else."
        printf '%s\n' "\`git -C $RESIDUE_WT status --porcelain --untracked-files=no\`:"
        git -C "$RESIDUE_WT" status --porcelain --untracked-files=no 2>&1 \
          || echo "(could not read the worktree at $RESIDUE_WT)"
        printf '\n%s\n' "\`git -C $RESIDUE_WT diff --stat\`:"
        git -C "$RESIDUE_WT" diff --stat 2>&1 \
          || echo "(could not read the worktree at $RESIDUE_WT)"
      } > "$REASON_FILE"
      printf '%s\n' "Inspect the diff recorded above in \`.claude/worktrees/$id\` and decide what the uncommitted content IS. If it is unlanded work, land it — \`graph-commit\` for an intentions/ node write, or commit and push the branch for code — and never discard it sight-unseen; the uncommitted edit may be its only copy. If it is safely discardable (build output, a half-applied edit already landed elsewhere), clear it with \`git restore\` — but NOT while a merge is live: if the status above shows \`UU\` paths or the worktree has a MERGE_HEAD, abort or complete THAT merge first, since \`git restore\` inside one discards the wrong side. A detached HEAD with commits on it needs a branch before anything is reset, and a worktree sitting on a branch other than \`$id\` (the \`wrong-branch\` condition) needs that branch's own state settled before it is switched back. Once the worktree is clean, the next tick provisions it normally. Then resolve THIS HOLD TACTIC to \`phase: done\` and prune it — clearing \`office_hours\` alone does not unblock the source. \`resolve-hold $id --kind worktree-residue\` does the resolve and the source's \`blocked_by\` clear in one landed write." > "$RECOMMENDATION_FILE"
      if "$HOLD_NODE" "$id" --kind worktree-residue \
          --reason-file "$REASON_FILE" --recommendation-file "$RECOMMENDATION_FILE"; then
        echo "held $id worktree-residue"
      else
        echo "failed $id hold-failed"
        FAILURES=$(( FAILURES + 1 ))
      fi
      rm -rf "$TMPDIR_HOLD14"
      ;;
    15)
      # unknown-freshness: the selection gate could not prove the store snapshot
      # is at a freshly-fetched ref. An ENVIRONMENT condition, not a node defect —
      # no graph write, no park. Clear the reservation (mirrors case 12: no spawn
      # happened) so the next tick re-selects the node once the fetch works.
      reservation_clear "$id" || true
      echo "refused $id unknown-freshness"
      ;;
    *)
      # 2 / any other: a mechanical error (bad node id, unresolvable project
      # root, failed add/fetch). Park the node via the office_hours graph write.
      if "$PARK_NODE" "$id" \
          "provision-node-worktree failed for this tactic (exit $prov_rc)" \
          "Inspect the provisioning failure (git fetch/worktree add, direnv) in the tick journal, fix the environment, and re-run the phase."; then
        echo "parked $id"
      else
        echo "failed $id park-failed"
        FAILURES=$(( FAILURES + 1 ))
      fi
      ;;
  esac
done

(( FAILURES == 0 )) && exit 0 || exit 1
