#!/usr/bin/env bash
# dispatch-graph-main-red-sync — graph-native main-red latch reader + recovery
# completer (tactic-graph-main-self-heal). Extracted out of
# dispatch-select-tick's former inline Step 1c block into its own script,
# matching the script-per-concern convention already used by sibling scripts
# repo-health and graph-select-target in this directory — each is a small
# script dispatch-select-tick invokes via "$SCRIPT_DIR/<name>", independently
# fakeable by the test harness.
#
# A diagnosed red episode leaves an open graph tactic node
# `tactic-main-red-<shortsha>` (written/refreshed by dispatch-diagnose-main) —
# the gate's per-episode latch, serving strategy-main-health. A node is "open"
# while its phase is not "done" AND office_hours is null (a node parked in
# office_hours is a since-resolved episode). Once origin/main goes green again,
# this script completes the open node(s) to phase: "done" so the next red
# episode re-fires the gate on first detection. A graph write is a side effect
# of this script, not of the pure selector.
#
# Usage: dispatch-graph-main-red-sync
#
# Stdout protocol: each open tactic-main-red-* node's id, one per line — the
# SAME set read at the top of this run, regardless of whether the
# recovery-completion below succeeds this same invocation (mirrors the
# original inline block: every downstream consumer within one tick gates on
# this run's initial read, not a post-completion re-read). Nothing is printed
# when no node is open. On a graph-read failure the literal string `UNKNOWN` is
# printed instead of empty output — never silently "main healthy" on a
# transient read error. All diagnostic/log output goes to stderr, never
# stdout.
#
# Exit code: ALWAYS 0. The caller treats any non-empty stdout (including
# UNKNOWN) as "do not treat main as healthy" — this script must never exit
# non-zero in a way that could get swallowed as empty by a caller's `|| true`.
#
# NOT set -e: every risky step below is guarded explicitly (matching the
# sibling dispatch-select-tick / dispatch-graph-census convention), so the
# script always reaches its final exit 0.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# scripts → dispatch-propagate → skills → .claude → repo root (same convention
# as sibling script dispatch-graph-census).
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# --- Read the open tactic-main-red-* nodes (verbatim from the former inline
# Step 1c block, relocated) ---------------------------------------------------
OPEN_MAIN_RED=$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
  const { listNodes } = await import("./packages/intentionsutil/src/store.js");
  for (const n of listNodes("./intentions")) {
    if (!n.id.startsWith("tactic-main-red-")) continue;
    if (n.phase === "done") continue;
    if (n.office_hours !== null) continue;
    process.stdout.write(n.id + "\n");
  }
') ) || {
  echo 'dispatch-graph-main-red-sync: graph read of open tactic-main-red-* nodes failed; treating main health as UNKNOWN' >&2
  OPEN_MAIN_RED=UNKNOWN
}

if [[ -n "$OPEN_MAIN_RED" && "$OPEN_MAIN_RED" != "UNKNOWN" ]]; then
  # Use explicit exit-code capture: a failed probe would produce empty output,
  # which -z would treat as "green" and incorrectly complete the latch. The
  # probe lives in the standalone repo-health sensor: repo-health
  # --main-broken-sha runs the two-source CI aggregation and, as a side effect,
  # reconciles its durable label-free latch record. An empty stdout means green.
  MB_SHA=""
  if ! MB_SHA=$("$SCRIPT_DIR/repo-health" --main-broken-sha); then
    MB_SHA="UNKNOWN"
  fi
  if [[ -z "$MB_SHA" ]]; then
    # main is green again — complete each open tactic-main-red-* node to
    # phase: "done" (re-arming the gate). ONLY when the node's execution is
    # still null: a node past draft with a live execution is an in-flight fix
    # owning its own PR/qa/review lifecycle, which completes it normally; this
    # mechanical completion must never preempt in-progress work. Best-effort
    # per node — a single node's completion failing must not abort the run
    # (each write path is guarded with `|| true`).
    while IFS= read -r node_id; do
      [[ -n "$node_id" ]] || continue
      EXECUTION=$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
        const { readNode } = await import("./packages/intentionsutil/src/store.js");
        const n = readNode("./intentions", process.argv[1]);
        process.stdout.write((n.execution === null || n.execution === undefined) ? "null\n" : "set\n");
      ' "$node_id") ) || continue
      [[ "$EXECUTION" == "null" ]] || continue
      # Compare-and-swap edit: dump the current node (writes base-manifest.txt),
      # patch phase → "done", write it back through the validation gate, then
      # land it with graph-commit --base (the manifest refuses a stale-read
      # overwrite).
      COMPLETE_DIR=$(mktemp -d) || continue
      (
        cd "$REPO_ROOT" || exit 1
        MANIFEST=$(npx tsx packages/intentionsutil/scripts/dump-node.ts --out-dir "$COMPLETE_DIR" "$node_id") || exit 1
        jq '.phase = "done"' "$COMPLETE_DIR/$node_id.json" > "$COMPLETE_DIR/$node_id.patched.json" || exit 1
        npx tsx packages/intentionsutil/scripts/write-node.ts --file "$COMPLETE_DIR/$node_id.patched.json" || exit 1
        packages/intentionsutil/scripts/graph-commit --base "$MANIFEST" -m "graph: complete $node_id (main-health green)" "$node_id"
      ) 1>&2 || true
      rm -rf "$COMPLETE_DIR"
    done <<<"$OPEN_MAIN_RED"
  fi
fi

[[ -n "$OPEN_MAIN_RED" ]] && printf '%s\n' "$OPEN_MAIN_RED"
exit 0
