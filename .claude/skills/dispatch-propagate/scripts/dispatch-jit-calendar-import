#!/usr/bin/env bash
# dispatch-jit-calendar-import — file one jit:calendar reminder issue per
# pressing Google Calendar event, and close issues whose event has ended.
#
# A standalone JIT generator. Unlike dispatch-jit-engine's one-issue-per-jit
# model, this importer fans out per calendar event: today's events and
# upcoming events whose earliest reminder trigger is already in the past each
# get their own jit:calendar issue in the configured repo. Reconciliation runs
# every tick: open issues whose recorded event-end has passed are closed.
#
# Two rules drive the file-set:
#
#   Rule 1 — today's events. Every not-yet-ended event on the primary calendar
#            whose start is before end-of-today (local). All-day events count.
#            Declined events are excluded.
#   Rule 2 — passed reminders. Every upcoming event whose earliest reminder
#            trigger time (event start − reminder minutes) is already in the
#            past. Triggers come from reminders.overrides[].minutes, or from
#            the calendar's defaultReminders when reminders.useDefault is true.
#
# An event matching both rules produces exactly one issue (dedup on event ID).
#
# Each created issue carries the configured label (default jit:calendar) and a
# machine-readable marker line in its body — the marker is the single source
# of truth for event ↔ issue identity and event end time:
#
#   <!-- dispatch:calendar event=<id> start=<RFC3339> end=<RFC3339> -->
#
# OAuth — no credentials are stored in this file. The Google OAuth client
# credentials and refresh token are read at runtime from three env vars:
#
#   GOOGLE_CALENDAR_CLIENT_ID
#   GOOGLE_CALENDAR_CLIENT_SECRET
#   GOOGLE_CALENDAR_REFRESH_TOKEN
#
# Per the pass/GPG section of .claude/rules/sandbox.md, source them from the
# secret store before invoking this script, e.g.
#
#   export GOOGLE_CALENDAR_CLIENT_ID="$(pass show google-calendar/client-id)"
#   export GOOGLE_CALENDAR_CLIENT_SECRET="$(pass show google-calendar/client-secret)"
#   export GOOGLE_CALENDAR_REFRESH_TOKEN="$(pass show google-calendar/refresh-token)"
#
# (Warm the gpg-agent cache once in an interactive shell first, as that rule
# describes.) With any of the three env vars unset the script exits silently —
# the no-config path, exactly as dispatch-jit-engine is a no-op with no
# jit.json.
#
# One-time refresh-token bootstrap (done by the user, not by this script):
#   1. Create a Google Cloud project and an OAuth 2.0 Client ID of type
#      "Desktop app". Note the client id and client secret.
#   2. Enable the Calendar API on the project.
#   3. Run the consent flow once interactively (the simplest path is the
#      Google OAuth 2.0 Playground at developers.google.com/oauthplayground
#      configured with your own client id/secret and the
#      https://www.googleapis.com/auth/calendar.readonly scope) and capture
#      the refresh token it issues.
#   4. Store all three values in pass under stable paths and source them as
#      env vars before invoking /dispatch.
#
# Per-tick behavior:
#   1. No-config gate — any of the three OAuth env vars unset → exit 0 silent.
#   2. Resolve the state file. Debounce: if NOW − lastRun < CALENDAR_DEBOUNCE,
#      print `calendar: debounced` and exit 0 — no network call.
#   3. Exchange the refresh token for a short-lived access token.
#   4. List open issues with the configured label, parse markers, derive the
#      set of open event IDs and the issues whose recorded end < NOW.
#   5. Close past-event issues with a comment.
#   6. Fetch the primary calendar (for defaultReminders) and its events
#      (timeMin = start of today local, timeMax = NOW + CALENDAR_LOOKAHEAD).
#   7. Filter to Rule-1 ∪ Rule-2, exclude declined events, dedup by event ID,
#      drop events whose ID already has an open issue.
#   8. Ensure the configured label exists (idempotent).
#   9. For each remaining event, file a new issue with the marker, then add
#      it to the configured project via dispatch-project-item-add.
#  10. Record the run timestamp.
#
# Stdout protocol (one line per action):
#   calendar: created #<num> (<event-id>)
#   calendar: closed #<num> (<event-id>)
#   calendar: skipped (<reason>)
#   calendar: debounced
# Errors are written to stderr as:
#   calendar: error (<description>)
# Per-event hard errors do not abort the loop — the script continues with
# the next event and exits 1 at the end.
#
# Exit codes:
#   0  every event handled cleanly.
#   1  at least one per-event hard error.
#   2  the script itself cannot operate (no state dir, OAuth exchange failed
#      with no network access at all, etc.).
#
# Environment overrides for testability:
#   CALENDAR_REPO            Default: natb1/household.
#   CALENDAR_PROJECT_KEY     Default: household.
#   CALENDAR_LABEL           Default: jit:calendar.
#   CALENDAR_LOOKAHEAD       Default: 7d.
#   CALENDAR_DEBOUNCE        Default: 15m.
#   DISPATCH_CALENDAR_STATE_DIR  Override the state-file directory. When set,
#                                the script does NOT require a git repo.
#                                Default: <project-root>/tmp.
#   DISPATCH_CALENDAR_NOW    Override "now" as epoch seconds. Default: date +%s.
#
# Sandbox: callers must wrap this script with dangerouslyDisableSandbox: true —
# both `gh` (TLS via the macOS Security framework) and `curl` to Google's
# hosts need it (see .claude/rules/sandbox.md). The script itself sets nothing
# sandbox-related.
#
# NOT set -e: per-event hard errors must not abort the loop. Exit codes are
# captured explicitly with `|| rc=$?`.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---- parse_duration <str> — duration string to seconds ----------------------
# Copied inline from dispatch-jit-engine. Accepts <int><unit> where unit is one
# of s|m|h|d|w. Prints the duration in seconds on stdout and returns 0. On
# unparseable input prints nothing and returns 1.
parse_duration() {
  local spec="$1" num unit
  if [[ ! "$spec" =~ ^([0-9]+)([smhdw])$ ]]; then
    return 1
  fi
  num="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]}"
  case "$unit" in
    s) printf '%s\n' "$(( num * 1 ))" ;;
    m) printf '%s\n' "$(( num * 60 ))" ;;
    h) printf '%s\n' "$(( num * 3600 ))" ;;
    d) printf '%s\n' "$(( num * 86400 ))" ;;
    w) printf '%s\n' "$(( num * 604800 ))" ;;
  esac
  return 0
}

# ---- Step 0: no-config gate -------------------------------------------------
# Any of the three OAuth env vars unset → silent no-op.
if [[ -z "${GOOGLE_CALENDAR_CLIENT_ID:-}" \
   || -z "${GOOGLE_CALENDAR_CLIENT_SECRET:-}" \
   || -z "${GOOGLE_CALENDAR_REFRESH_TOKEN:-}" ]]; then
  exit 0
fi

# ---- Step 1: resolve config env vars with defaults --------------------------
CALENDAR_REPO="${CALENDAR_REPO:-natb1/household}"
CALENDAR_PROJECT_KEY="${CALENDAR_PROJECT_KEY:-household}"
CALENDAR_LABEL="${CALENDAR_LABEL:-jit:calendar}"
CALENDAR_LOOKAHEAD="${CALENDAR_LOOKAHEAD:-7d}"
CALENDAR_DEBOUNCE="${CALENDAR_DEBOUNCE:-15m}"

# ---- Step 2: resolve the state directory and file --------------------------
# Same idiom as dispatch-jit-engine: an explicit DISPATCH_CALENDAR_STATE_DIR
# bypasses the git lookup (tests rely on it). Otherwise the state file lives
# at the shared <project-root>/tmp/, co-located with tmp/dispatch.lock.
if [[ -n "${DISPATCH_CALENDAR_STATE_DIR:-}" ]]; then
  STATE_DIR="$DISPATCH_CALENDAR_STATE_DIR"
else
  GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || { echo "calendar: error (not in a git repo and DISPATCH_CALENDAR_STATE_DIR is unset)" >&2; exit 2; }
  PROJECT_ROOT=$(dirname "$GIT_COMMON_DIR")
  STATE_DIR="$PROJECT_ROOT/tmp"
fi
STATE_FILE="$STATE_DIR/dispatch-jit-calendar-state.json"

NOW="${DISPATCH_CALENDAR_NOW:-$(date +%s)}"

HARD_ERROR=0

# ---- Step 3: debounce -------------------------------------------------------
if ! DEBOUNCE_SECS=$(parse_duration "$CALENDAR_DEBOUNCE"); then
  echo "calendar: error (cannot parse CALENDAR_DEBOUNCE='$CALENDAR_DEBOUNCE')" >&2
  exit 2
fi
if [[ -f "$STATE_FILE" ]]; then
  LAST_RUN=$(jq -r '.lastRun // empty' "$STATE_FILE" 2>/dev/null || echo "")
  if [[ -n "$LAST_RUN" ]] && (( NOW - LAST_RUN < DEBOUNCE_SECS )); then
    echo "calendar: debounced"
    exit 0
  fi
fi

# ---- Step 4: exchange the refresh token for an access token ----------------
TOKEN_RC=0
TOKEN_RESPONSE=$(curl -sf -X POST \
  --data-urlencode "client_id=${GOOGLE_CALENDAR_CLIENT_ID}" \
  --data-urlencode "client_secret=${GOOGLE_CALENDAR_CLIENT_SECRET}" \
  --data-urlencode "refresh_token=${GOOGLE_CALENDAR_REFRESH_TOKEN}" \
  --data-urlencode "grant_type=refresh_token" \
  "https://oauth2.googleapis.com/token" 2>/dev/null) || TOKEN_RC=$?
if [[ "$TOKEN_RC" -ne 0 ]]; then
  echo "calendar: error (refresh-token exchange failed: curl exit $TOKEN_RC)" >&2
  exit 2
fi
ACCESS_TOKEN=$(printf '%s' "$TOKEN_RESPONSE" | jq -r '.access_token // empty')
if [[ -z "$ACCESS_TOKEN" ]]; then
  ERR=$(printf '%s' "$TOKEN_RESPONSE" | jq -r '.error_description // .error // "no access_token in response"')
  echo "calendar: error (refresh-token exchange: $ERR)" >&2
  exit 2
fi

# ---- Step 5: list open jit:calendar issues ---------------------------------
# Limit guards a runaway loop and matches expected steady-state volume for a
# household calendar; if the list ever hits this ceiling, emit a warning so
# dedup misses surface instead of silently creating duplicates.
LIST_LIMIT=1000
LIST_RC=0
OPEN_JSON=$(gh issue list --repo "$CALENDAR_REPO" --label "$CALENDAR_LABEL" \
  --state open --json number,body --limit "$LIST_LIMIT" 2>&1) || LIST_RC=$?
if [[ "$LIST_RC" -ne 0 ]]; then
  echo "calendar: error (gh issue list failed: $OPEN_JSON)" >&2
  exit 1
fi

# Parse the marker line from each open issue body. Build two streams:
#   OPEN_EVENT_IDS — newline-separated list of event IDs with an open issue.
#   PAST_ISSUES    — newline-separated `<num> <event-id>` pairs whose recorded
#                    end is before NOW.
# The marker format is fixed:
#   <!-- dispatch:calendar event=<id> start=<RFC3339> end=<RFC3339> -->
# A bodyless or marker-less issue contributes nothing and is silently ignored —
# defensive: it cannot be reconciled against a calendar event.
parse_marker() {
  # Reads body text on stdin. Prints "event=<id> start=<start> end=<end>" or
  # nothing. Uses a single grep-with-regex to keep the parsing self-contained.
  local body="$1"
  # The canonical marker is always the LAST line appended to the body (Step 11),
  # after the attacker-influenceable fields (summary, location, description). Take
  # the last match so a crafted event description embedding an earlier fake marker
  # cannot spoof another event's identity (premature close / reminder suppression).
  printf '%s' "$body" \
    | grep -oE '<!-- dispatch:calendar event=[^ ]+ start=[^ ]+ end=[^ ]+ -->' \
    | tail -n1
}

OPEN_EVENT_IDS=""
PAST_ISSUES=""
ISSUE_COUNT=$(printf '%s' "$OPEN_JSON" | jq 'length')
if (( ISSUE_COUNT >= LIST_LIMIT )); then
  echo "calendar: error (open '$CALENDAR_LABEL' issues hit list limit $LIST_LIMIT; dedup may miss IDs and create duplicates — raise LIST_LIMIT or backlog must be cleared)" >&2
  HARD_ERROR=1
fi
for (( i = 0; i < ISSUE_COUNT; i++ )); do
  ISSUE_NUM=$(printf '%s' "$OPEN_JSON" | jq -r ".[$i].number")
  if [[ ! "$ISSUE_NUM" =~ ^[0-9]+$ ]]; then
    echo "calendar: error (non-numeric issue number '$ISSUE_NUM' from gh issue list; skipping)" >&2
    HARD_ERROR=1
    continue
  fi
  ISSUE_BODY=$(printf '%s' "$OPEN_JSON" | jq -r ".[$i].body // \"\"")
  MARKER=$(parse_marker "$ISSUE_BODY")
  [[ -z "$MARKER" ]] && continue
  if [[ "$MARKER" =~ event=([^[:space:]]+)[[:space:]]start=([^[:space:]]+)[[:space:]]end=([^[:space:]]+) ]]; then
    EVENT_ID="${BASH_REMATCH[1]}"
    EVENT_END="${BASH_REMATCH[3]}"
    OPEN_EVENT_IDS+="$EVENT_ID"$'\n'
    END_EPOCH=""
    END_EPOCH=$(date -d "$EVENT_END" +%s 2>/dev/null) || {
      echo "calendar: error (cannot parse marker end '$EVENT_END' on #$ISSUE_NUM)" >&2
      HARD_ERROR=1
      continue
    }
    if (( END_EPOCH <= NOW )); then
      PAST_ISSUES+="$ISSUE_NUM $EVENT_ID"$'\n'
    fi
  fi
done

# ---- Step 6: close past-event issues ---------------------------------------
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  read -r CLOSE_NUM CLOSE_EVT <<<"$line"
  CLOSE_RC=0
  CLOSE_OUT=$(gh issue close "$CLOSE_NUM" --repo "$CALENDAR_REPO" \
    --comment "Event ended; closing this calendar reminder." 2>&1) || CLOSE_RC=$?
  if [[ "$CLOSE_RC" -ne 0 ]]; then
    echo "calendar: error (gh issue close #$CLOSE_NUM failed: $CLOSE_OUT)" >&2
    HARD_ERROR=1
    continue
  fi
  echo "calendar: closed #$CLOSE_NUM ($CLOSE_EVT)"
done <<< "$PAST_ISSUES"

# ---- Step 7: fetch the primary calendar metadata ---------------------------
CAL_RC=0
CAL_META=$(curl -sf -H "Authorization: Bearer ${ACCESS_TOKEN}" \
  "https://www.googleapis.com/calendar/v3/calendars/primary" 2>/dev/null) \
  || CAL_RC=$?
if [[ "$CAL_RC" -ne 0 ]]; then
  echo "calendar: error (calendar metadata fetch failed: curl exit $CAL_RC)" >&2
  exit 1
fi
DEFAULT_REMINDERS_RC=0
DEFAULT_REMINDERS=$(printf '%s' "$CAL_META" | jq -c '.defaultReminders // []' 2>/dev/null) \
  || DEFAULT_REMINDERS_RC=$?
if [[ "$DEFAULT_REMINDERS_RC" -ne 0 || -z "$DEFAULT_REMINDERS" ]]; then
  echo "calendar: error (malformed calendar metadata; defaulting reminders to [])" >&2
  HARD_ERROR=1
  DEFAULT_REMINDERS='[]'
fi

# ---- Step 8: fetch events --------------------------------------------------
# Window: [start of today local, NOW + lookahead]. timeMin/timeMax are RFC3339.
if ! LOOKAHEAD_SECS=$(parse_duration "$CALENDAR_LOOKAHEAD"); then
  echo "calendar: error (cannot parse CALENDAR_LOOKAHEAD='$CALENDAR_LOOKAHEAD')" >&2
  exit 2
fi
TODAY_LOCAL_DATE=$(date -d "@$NOW" +%Y-%m-%d)
START_OF_TODAY_LOCAL=$(date -d "$TODAY_LOCAL_DATE 00:00:00" +%s)
# Bare date + relative day → next local midnight (DST-safe). Pairing an explicit
# "00:00:00" with "+ 1 day" yields today 23:00, not next midnight, under GNU date.
END_OF_TODAY_LOCAL=$(date -d "$TODAY_LOCAL_DATE + 1 day" +%s)
TIME_MIN_RFC3339=$(date -d "@$START_OF_TODAY_LOCAL" --iso-8601=seconds)
TIME_MAX_RFC3339=$(date -d "@$((NOW + LOOKAHEAD_SECS))" --iso-8601=seconds)

EVT_RC=0
EVENTS_JSON=$(curl -sf -G -H "Authorization: Bearer ${ACCESS_TOKEN}" \
  --data-urlencode "singleEvents=true" \
  --data-urlencode "orderBy=startTime" \
  --data-urlencode "timeMin=${TIME_MIN_RFC3339}" \
  --data-urlencode "timeMax=${TIME_MAX_RFC3339}" \
  --data-urlencode "maxResults=250" \
  "https://www.googleapis.com/calendar/v3/calendars/primary/events" 2>/dev/null) \
  || EVT_RC=$?
if [[ "$EVT_RC" -ne 0 ]]; then
  echo "calendar: error (events fetch failed: curl exit $EVT_RC)" >&2
  exit 1
fi

# ---- Step 9: filter and emit candidate events ------------------------------
# Project to a compact per-event shape, exclude cancelled and declined-by-self.
# reminders is the effective list — useDefault → defaultReminders, else
# overrides // [].
# Capture jq output into a variable first so a malformed EVENTS_JSON surfaces
# as an error instead of a silent empty EVENTS array hidden inside a process
# substitution.
PROJ_RC=0
EVENTS_PROJECTED=$(printf '%s' "$EVENTS_JSON" | jq -c \
  --argjson defaultReminders "$DEFAULT_REMINDERS" \
  '.items[]?
   | select(.status != "cancelled")
   | select(
       [.attendees // [] | .[] | select(.self == true and .responseStatus == "declined")] | length == 0
     )
   | {
       id: .id,
       summary: (.summary // "(no title)"),
       description: (.description // ""),
       location: (.location // ""),
       htmlLink: (.htmlLink // ""),
       start: (.start.dateTime // .start.date // ""),
       end:   (.end.dateTime   // .end.date   // ""),
       reminders: (
         if (.reminders.useDefault == true) then $defaultReminders
         else (.reminders.overrides // [])
         end
       )
     }' 2>/dev/null) || PROJ_RC=$?
if [[ "$PROJ_RC" -ne 0 ]]; then
  echo "calendar: error (events projection failed: malformed events response)" >&2
  exit 1
fi
if [[ -n "$EVENTS_PROJECTED" ]]; then
  mapfile -t EVENTS <<<"$EVENTS_PROJECTED"
else
  EVENTS=()
fi

# ---- Step 10: ensure the label exists (idempotent) -------------------------
LABEL_RC=0
LABEL_OUT=$(gh label create "$CALENDAR_LABEL" --repo "$CALENDAR_REPO" \
  --color ededed --description "Calendar event reminder" 2>&1) || LABEL_RC=$?
if [[ "$LABEL_RC" -ne 0 ]]; then
  if [[ "$LABEL_OUT" != *"already exists"* ]]; then
    echo "calendar: error (gh label create failed: $LABEL_OUT)" >&2
    HARD_ERROR=1
  fi
fi

# ---- Step 11: create new issues for matching events ------------------------
for evt in "${EVENTS[@]}"; do
  EVENT_ID=$(printf '%s' "$evt" | jq -r '.id')
  EVENT_START=$(printf '%s' "$evt" | jq -r '.start')
  EVENT_END=$(printf '%s' "$evt" | jq -r '.end')

  if [[ -z "$EVENT_ID" || -z "$EVENT_START" || -z "$EVENT_END" ]]; then
    continue
  fi

  # Already-open issue with this event ID — Rule 1/2 dedup against existing
  # open issues. A closed prior issue is NOT in OPEN_EVENT_IDS, so a re-file
  # is not suppressed.
  if printf '%s' "$OPEN_EVENT_IDS" | grep -Fxq "$EVENT_ID"; then
    echo "calendar: skipped (open issue exists for event $EVENT_ID)"
    continue
  fi

  START_EPOCH=""
  END_EPOCH=""
  START_EPOCH=$(date -d "$EVENT_START" +%s 2>/dev/null) || {
    echo "calendar: error (cannot parse event start '$EVENT_START' for event $EVENT_ID)" >&2
    HARD_ERROR=1
    continue
  }
  END_EPOCH=$(date -d "$EVENT_END" +%s 2>/dev/null) || {
    echo "calendar: error (cannot parse event end '$EVENT_END' for event $EVENT_ID)" >&2
    HARD_ERROR=1
    continue
  }

  # Skip events that have already ended — they should not be filed.
  if (( END_EPOCH <= NOW )); then
    echo "calendar: skipped (event $EVENT_ID already ended)"
    continue
  fi

  MATCH=0
  # Rule 1: today's not-yet-ended event.
  if (( START_EPOCH < END_OF_TODAY_LOCAL )); then
    MATCH=1
  fi
  # Rule 2: upcoming event with an already-passed reminder trigger.
  if [[ "$MATCH" -eq 0 ]] && (( START_EPOCH > NOW )); then
    while IFS= read -r minutes; do
      [[ -z "$minutes" ]] && continue
      [[ "$minutes" == "null" ]] && continue
      if [[ ! "$minutes" =~ ^[0-9]+$ ]]; then
        echo "calendar: error (non-numeric reminder minutes '$minutes' for event $EVENT_ID)" >&2
        HARD_ERROR=1
        continue
      fi
      TRIGGER=$(( START_EPOCH - minutes * 60 ))
      if (( TRIGGER <= NOW )); then
        MATCH=1
        break
      fi
    done < <(printf '%s' "$evt" | jq -r '.reminders[]?.minutes')
  fi

  if [[ "$MATCH" -eq 0 ]]; then
    echo "calendar: skipped (event $EVENT_ID matches no rule)"
    continue
  fi

  SUMMARY=$(printf '%s' "$evt" | jq -r '.summary')
  LOCATION=$(printf '%s' "$evt" | jq -r '.location')
  DESCRIPTION=$(printf '%s' "$evt" | jq -r '.description')
  HTML_LINK=$(printf '%s' "$evt" | jq -r '.htmlLink')

  # Truncate description for the body to keep issues compact.
  if (( ${#DESCRIPTION} > 500 )); then
    DESCRIPTION="${DESCRIPTION:0:500}…"
  fi

  # All-day events have date-only start/end (no 'T'); show them as "all-day"
  # instead of a misleading "00:00".
  if [[ "$EVENT_START" != *T* ]]; then
    START_LOCAL=$(date -d "$EVENT_START" '+%a %d %b %Y' 2>/dev/null || echo "$EVENT_START")
    TITLE="📅 ${SUMMARY} (all-day)"
    BODY="**When:** ${START_LOCAL} (all-day)"$'\n'
  else
    START_LOCAL=$(date -d "$EVENT_START" '+%a %d %b %Y, %H:%M' 2>/dev/null || echo "$EVENT_START")
    END_LOCAL=$(date -d "$EVENT_END" '+%H:%M' 2>/dev/null || echo "$EVENT_END")
    START_TIME_SHORT=$(date -d "$EVENT_START" '+%H:%M' 2>/dev/null || echo "$EVENT_START")
    TITLE="📅 ${SUMMARY} (${START_TIME_SHORT})"
    BODY="**When:** ${START_LOCAL}–${END_LOCAL}"$'\n'
  fi
  if [[ -n "$LOCATION" && "$LOCATION" != "null" ]]; then
    BODY+="**Where:** ${LOCATION}"$'\n'
  fi
  if [[ -n "$DESCRIPTION" && "$DESCRIPTION" != "null" ]]; then
    BODY+=$'\n'"${DESCRIPTION}"$'\n'
  fi
  if [[ -n "$HTML_LINK" && "$HTML_LINK" != "null" ]]; then
    BODY+=$'\n'"[Open in Google Calendar](${HTML_LINK})"$'\n'
  fi
  BODY+=$'\n'"<!-- dispatch:calendar event=${EVENT_ID} start=${EVENT_START} end=${EVENT_END} -->"

  CREATE_RC=0
  CREATE_OUT=$(gh issue create --repo "$CALENDAR_REPO" --label "$CALENDAR_LABEL" \
    --title "$TITLE" --body "$BODY" 2>&1) || CREATE_RC=$?
  if [[ "$CREATE_RC" -ne 0 ]]; then
    echo "calendar: error (gh issue create failed for event $EVENT_ID: $CREATE_OUT)" >&2
    HARD_ERROR=1
    continue
  fi
  ISSUE_URL=$(printf '%s' "$CREATE_OUT" | tail -n1)
  ISSUE_NUM="${ISSUE_URL##*/}"
  if [[ -z "$ISSUE_NUM" || ! "$ISSUE_NUM" =~ ^[0-9]+$ ]]; then
    echo "calendar: error (could not parse issue number from '$CREATE_OUT' for event $EVENT_ID)" >&2
    HARD_ERROR=1
    continue
  fi

  ADD_RC=0
  ADD_OUT=$("$SCRIPT_DIR/dispatch-project-item-add" "$CALENDAR_PROJECT_KEY" "$ISSUE_URL" 2>&1) \
    || ADD_RC=$?
  if [[ "$ADD_RC" -ne 0 ]]; then
    echo "calendar: error (could not add issue #$ISSUE_NUM to project '$CALENDAR_PROJECT_KEY': $ADD_OUT)" >&2
    HARD_ERROR=1
    continue
  fi

  echo "calendar: created #$ISSUE_NUM ($EVENT_ID)"
done

# ---- Step 12: record run timestamp -----------------------------------------
mkdir -p "$STATE_DIR"
printf '{"lastRun": %s}\n' "$NOW" >"$STATE_FILE"

if [[ "$HARD_ERROR" -ne 0 ]]; then
  exit 1
fi
exit 0
