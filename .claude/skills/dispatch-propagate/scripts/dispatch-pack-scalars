#!/usr/bin/env bash
# Extract the handful of scalars review-fix's parent thread needs from a
# dispatch-context-pack output, so the parent never has to hold the full pack
# (up to 60,000 chars of raw diff) in its own context.
#
# Usage: dispatch-context-pack <N> --pr --phase-log [--diff ...] \
#          | dispatch-pack-scalars --phase-log-out <path>
#
# Reads a full dispatch-context-pack output on stdin. Prints key=value lines
# to stdout, one per scalar, in the same convention dispatch-security-surface
# uses and SKILL.md parses with `sed -n 's/^key=//p'`:
#
#   pr_num=<N>                 — or pr_num=none when the PR section's first
#                                 line is the sentinel "PR: none".
#   labels=<comma-separated>   — omitted when pr_num=none (no labels line).
#   closes_issue=<N>           — zero or more lines, one per "Closes #<N>" in
#                                 the PR body.
#   phase_log=none             — when the PHASE-LOG section body is the
#                                 sentinel "phase-log: none".
#   phase_log_path=<path>      — otherwise: the section body is written to
#                                 the --phase-log-out path and this line names
#                                 it. Exactly one of phase_log= / phase_log_path=
#                                 is ever emitted.
#   changed_file_count=<N>     — a count only, sanity-check use; omitted when
#                                 no REAL "=== DIFF (base ...) ===" section is
#                                 present in the input (--diff was not
#                                 requested when the pack was built). "Real" is
#                                 defined by the anchoring rules below — a
#                                 body-pasted DIFF header does not count.
#
# No network access, no git, no gh — pure stdin extraction. Does not source
# lib.sh: this script needs none of its gh/git wrappers.
#
# --- Anchoring rules (security-relevant — do not simplify) -------------------
#
# The pack's canonical section order is PR -> PHASE-LOG -> DIFF. TWO regions of
# it are untrusted attacker-controllable text:
#
#   1. the PR *body*, inside the PR section — anything a PR author types;
#   2. the DIFF section — both the raw, UNPREFIXED file list under
#      '--- files ---' (a PR may add a file literally named
#      '=== PHASE-LOG #999 ===') and the hunk text under '--- hunks ---'.
#
# Region 1 sits BEFORE the real PHASE-LOG header; region 2 sits AFTER it. A
# naive "first header wins" loses to region 1 and a naive "last header wins"
# loses to region 2, so each section is anchored against the region that can
# forge it:
#
#   - the PR section is anchored on the FIRST '^=== PR ===' line — a forged
#     one inside the PR body can only appear later, after the real one;
#   - the PHASE-LOG section is anchored on the LAST '^=== PHASE-LOG #' line
#     STRICTLY BEFORE the real DIFF section — later than any body-pasted
#     decoy (region 1), earlier than any file-list decoy (region 2).
#
# Deriving "the real DIFF section start" is itself the security-critical step,
# because the obvious rule — "the FIRST '^=== DIFF (base ' line" — is forgeable
# from region 1: pasting
#
#     === PHASE-LOG #9 ===
#     evil
#     === DIFF (base 0000000) ===
#
# into the PR body moves that bound in FRONT of the real PHASE-LOG header and
# re-opens the body-forgery hole. The bound must come from a marker the
# attacker cannot place after the real one. That marker is '--- hunks ---':
#
#   a. last_hunks_line = the LAST '^--- hunks ---$' line. Everything the pack
#      emits after the real '--- hunks ---' marker is `git diff` output, whose
#      lines always carry a prefix ('diff --git ', 'index ', '--- a/',
#      '+++ b/', '@@', and content lines prefixed with a space / '+' / '-'),
#      plus an optional 'truncated: N files omitted' line — none of which can
#      produce a bare '^--- hunks ---$'. A file literally NAMED '--- hunks ---'
#      shows up only in the earlier '--- files ---' list, i.e. BEFORE the real
#      marker, so tail -n1 still lands on the real one.
#   b. real_diff_start = the LAST '^=== DIFF (base ' line occurring BEFORE
#      last_hunks_line. Body-pasted decoys are earlier than the real header;
#      the only pack-generated region between the real header and
#      '--- files ---' is the `git diff --stat` block, whose lines are
#      space-indented and so cannot match either.
#   c. no '^--- hunks ---$' line at all => the pack has NO real DIFF section
#      (a '=== DIFF (base ' line without one can only be body forgery). The
#      PHASE-LOG search then runs to EOF — safe, because with no diff section
#      nothing attacker-controlled follows the real PHASE-LOG header — and
#      changed_file_count is omitted, exactly as when --diff was not requested.
#
# changed_file_count uses the same real_diff_start (an unbounded "last DIFF
# header" would be hijacked by the very same forged filename), counting the
# non-empty lines between the first '^--- files ---$' at/after real_diff_start
# and last_hunks_line.
#
# pr_num and labels are read POSITIONALLY from the two lines immediately after
# the real PR header, never by grepping the whole input — grepping for e.g.
# '^PR #' anywhere would happily return a decoy planted in the PR body. This is
# the #1522 defect class: a forged header/line inside untrusted PR-authored
# content (body OR diff) must never be read as the real one.
set -euo pipefail

# --- parse args ----------------------------------------------------------

PHASE_LOG_OUT=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --phase-log-out)
      PHASE_LOG_OUT="${2:-}"
      shift 2
      ;;
    *)
      echo "dispatch-pack-scalars: error: unknown argument '$1'" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$PHASE_LOG_OUT" ]]; then
  echo "dispatch-pack-scalars: error: usage: dispatch-pack-scalars --phase-log-out <path>" >&2
  exit 2
fi

# --- read stdin once -------------------------------------------------------

input=$(cat)

# --- trim helper: strip leading/trailing blank lines, preserve interior ----
# ones (a phase-log body can legitimately contain blank lines between
# paragraphs — only the pack's own header/separator blank lines are noise).
trim_blank_edges() {
  local s="$1"
  s=$(printf '%s\n' "$s" | sed -e '/./,$!d')
  s=$(printf '%s\n' "$s" | tac | sed -e '/./,$!d' | tac)
  printf '%s' "$s"
}

# ============================================================================
# === PR section: pr_num, labels, closes_issue ===
# ============================================================================

first_pr_line=$(grep -n '^=== PR ===$' <<<"$input" | head -n1 | cut -d: -f1 || true)
if [[ -z "$first_pr_line" ]]; then
  echo "dispatch-pack-scalars: error: no '=== PR ===' section found in input" >&2
  echo "dispatch-pack-scalars: pass --pr to dispatch-context-pack to include the PR section" >&2
  exit 1
fi

first_content_line_no=$((first_pr_line + 1))
first_content_line=$(sed -n "${first_content_line_no}p" <<<"$input")

PR_NUM=""
LABELS=""
CLOSES_ISSUES=()

if [[ "$first_content_line" == "PR: none" ]]; then
  PR_NUM="none"
else
  if [[ "$first_content_line" =~ ^PR\ \#([0-9]+)$ ]]; then
    PR_NUM="${BASH_REMATCH[1]}"
  else
    echo "dispatch-pack-scalars: error: expected 'PR #<N>' or 'PR: none' immediately after '=== PR ===', got: $first_content_line" >&2
    exit 1
  fi

  labels_line_no=$((first_content_line_no + 1))
  labels_line=$(sed -n "${labels_line_no}p" <<<"$input")
  if [[ "$labels_line" =~ ^labels:\ (.*)$ ]]; then
    LABELS="${BASH_REMATCH[1]}"
  else
    echo "dispatch-pack-scalars: error: expected 'labels: ...' on the line after 'PR #$PR_NUM', got: $labels_line" >&2
    exit 1
  fi

  # PR body: everything from 3 lines after the header (PR #N / labels: / ci:)
  # to the section end, terminated by the next line starting a new section
  # ('^=== ') or EOF. Scan for 'Closes #<N>' lines within that bounded body —
  # bounding matters so a decoy 'Closes #<N>' pasted after a forged section
  # header elsewhere in the pack is never read as part of THIS PR's body.
  body_start=$((first_content_line_no + 3))
  pr_body=$(awk -v start="$body_start" 'NR>=start { if ($0 ~ /^=== /) exit; print }' <<<"$input")

  while IFS= read -r closes_num; do
    [[ -n "$closes_num" ]] && CLOSES_ISSUES+=("$closes_num")
  done < <(grep -oiE '^closes #[0-9]+' <<<"$pr_body" | grep -oE '[0-9]+' || true)
fi

# ============================================================================
# === Real DIFF section start (bounds the PHASE-LOG search) ===
# ============================================================================
#
# See "Anchoring rules" above: derive the bound from the LAST '--- hunks ---'
# marker (unforgeable after the fact), then take the LAST '=== DIFF (base '
# header before it. Empty result = this pack has no real DIFF section.

last_hunks_line=$(grep -n '^--- hunks ---$' <<<"$input" | tail -n1 | cut -d: -f1 || true)

real_diff_start=""
if [[ -n "$last_hunks_line" ]]; then
  real_diff_start=$(grep -n '^=== DIFF (base ' <<<"$input" \
    | awk -F: -v bound="$last_hunks_line" '$1 < bound { n = $1 } END { if (n) print n }' || true)
fi

# ============================================================================
# === PHASE-LOG section: phase_log / phase_log_path ===
# ============================================================================

if [[ -n "$real_diff_start" ]]; then
  # The LAST '=== PHASE-LOG #' header strictly before the real DIFF section.
  last_phaselog_line=$(grep -n '^=== PHASE-LOG #' <<<"$input" \
    | awk -F: -v bound="$real_diff_start" '$1 < bound { n = $1 } END { if (n) print n }' || true)
else
  # No real DIFF section: nothing attacker-controlled can follow the real
  # PHASE-LOG header, so the unbounded "last header wins" rule is safe.
  last_phaselog_line=$(grep -n '^=== PHASE-LOG #' <<<"$input" | tail -n1 | cut -d: -f1 || true)
fi
if [[ -z "$last_phaselog_line" ]]; then
  echo "dispatch-pack-scalars: error: no '=== PHASE-LOG #' section found in input" >&2
  echo "dispatch-pack-scalars: pass --phase-log to dispatch-context-pack to include the phase-log section" >&2
  exit 1
fi

phaselog_start=$((last_phaselog_line + 1))
phaselog_body_raw=$(awk -v start="$phaselog_start" 'NR>=start { if ($0 ~ /^=== /) exit; print }' <<<"$input")
phaselog_body=$(trim_blank_edges "$phaselog_body_raw")

PHASE_LOG_LINE=""
if [[ "$phaselog_body" == "phase-log: none" ]]; then
  PHASE_LOG_LINE="phase_log=none"
else
  printf '%s\n' "$phaselog_body" > "$PHASE_LOG_OUT"
  PHASE_LOG_LINE="phase_log_path=$PHASE_LOG_OUT"
fi

# ============================================================================
# === DIFF section (optional): changed_file_count ===
# ============================================================================
#
# Reuses real_diff_start / last_hunks_line derived above rather than an
# unbounded "last '^=== DIFF (base ' line wins": the same forged filename in
# the file list ('=== DIFF (base 0000000) ===' as a path) would hijack that,
# and a body-pasted decoy after the real section is likewise ignored here.
# Count the non-empty lines strictly between the first '^--- files ---$' at or
# after real_diff_start and the real '--- hunks ---' marker. Omitted (not an
# error) when the pack has no real DIFF section — i.e. built without --diff.

CHANGED_FILE_COUNT_LINE=""
if [[ -n "$real_diff_start" ]]; then
  file_count=$(awk -v start="$real_diff_start" -v stop="$last_hunks_line" '
    NR >= start && NR < stop {
      if (!infiles) { if ($0 == "--- files ---") infiles = 1; next }
      if ($0 ~ /./) n++
    }
    END { print n + 0 }' <<<"$input")
  CHANGED_FILE_COUNT_LINE="changed_file_count=$file_count"
fi

# --- emit --------------------------------------------------------------------

printf 'pr_num=%s\n' "$PR_NUM"
if [[ "$PR_NUM" != "none" ]]; then
  printf 'labels=%s\n' "$LABELS"
  for n in "${CLOSES_ISSUES[@]+"${CLOSES_ISSUES[@]}"}"; do
    printf 'closes_issue=%s\n' "$n"
  done
fi
printf '%s\n' "$PHASE_LOG_LINE"
[[ -n "$CHANGED_FILE_COUNT_LINE" ]] && printf '%s\n' "$CHANGED_FILE_COUNT_LINE"

exit 0
