#!/usr/bin/env bash
# dispatch-phase-model — emit the claude model override for a given dispatch phase.
#
# Design invariant (#2872): the phase ORCHESTRATOR is always Sonnet. A phase skill
# runs as a cheap top-level orchestrator that reads clear instructions from its
# SKILL body and delegates the genuinely complex, generative subtasks to Opus
# SUBAGENTS inside its Workflow (e.g. review-fix's `/code-review` and
# `/security-review` finders and its fix-authoring agents; qa-fix's triage,
# fix-plan, and auto-fix subagents). The orchestrator is NEVER promoted to Opus.
#
# There is deliberately no learned/adaptive policy that can bump the orchestrator
# to Opus. The retired #2028 phase-model-policy did exactly that for qa/review
# (promoting the orchestrator on a low hit-rate) and was removed in #2872: Opus
# tiering belongs at the `agent()`/subagent layer, owned by each phase skill, not
# at the orchestrator launch layer here.
#
# Phase → model map:
#   qa            → sonnet   (#1171: no product-code authoring; machine-verifiable
#                             checks + browser automation + summary writing)
#   review        → sonnet   (#1172: the review-fix orchestrator authors no fixes —
#                             finding detection and fix-authoring are delegated to
#                             Opus subagents, so the orchestrator runs on Sonnet)
#   fix-checks    → sonnet   (#2042: mechanical patch work; no product-code authoring)
#   fix-conflicts → sonnet   (#2042: mechanical patch work; no product-code authoring)
#   main-qa       → sonnet   (#2274: review-like; no product-code authoring)
#   ladder-eval   → opus     (the /rsi per-phase evaluation job spawned by
#                             dispatch-ladder-run at each phase boundary. Not a
#                             ladder rung — a pseudo-phase, so the job's tier is
#                             policy here rather than a `--model` literal at the
#                             spawn site. It authors no product code, but it
#                             reasons about evidence and its own blindness: a
#                             sonnet-tier run improvised a `find -newermt` call
#                             with a UTC bound that `find` silently parsed in
#                             the host's local zone, searched a window ~4 hours
#                             in the future, found nothing, and recorded its own
#                             blindness as proof no artifact existed. That is a
#                             judgment failure, not a mechanical one, so the
#                             lane is opus.)
#   *             → (empty)  unmapped phases inherit the session default
#
# Contract:
#   EMPTY stdout means "omit the --model flag, inherit the session default".
#   Callers MUST honor this contract: only pass --model <value> to `claude --bg`
#   when this script emits a non-empty value.
#
# Usage: dispatch-phase-model <phase>
#
# Exit codes:
#   0  resolved (an unmapped phase is NOT an error — it means "default").
#   2  missing, empty, or extra <phase> argument (usage error).
#
# NOT set -e: exits are handled explicitly.
set -uo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
  echo "dispatch-phase-model: expected a phase argument" >&2
  exit 2
fi
if [[ $# -gt 1 ]]; then
  echo "dispatch-phase-model: unexpected argument '$2'" >&2
  exit 2
fi

PHASE="$1"

# Static map. The orchestrator is always Sonnet for the workflow phases; every
# other phase inherits the session default (empty → no --model flag).
case "$PHASE" in
  qa|review|fix-checks|fix-conflicts|main-qa)
    printf '%s\n' "sonnet"
    ;;
  ladder-eval)
    printf '%s\n' "opus"
    ;;
  *)
    printf '%s\n' ""
    ;;
esac
