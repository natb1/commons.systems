#!/usr/bin/env bash
#
# dispatch-retriage-orphaned-followups — tick-time scan that re-triages
# orphaned review-finding follow-up issues whose source PR was closed without
# merging (issue #1812).
#
# When a review pass files an out-of-scope finding as a follow-up issue, that
# issue carries the static `dispatch:review-followup` label and a
# `<!-- dispatch:source-pr <N> -->` body marker recording which PR's review
# surfaced it.
# When PR #<N> later lands on main, the follow-up points at real, shipped code.
# But when PR #<N> is CLOSED WITHOUT MERGING (abandoned or superseded), the
# follow-up is orphaned: it points at a design that never landed. Such an orphan
# should be re-triaged by a human (closed as moot, or retargeted to whatever
# design did ship on main) rather than worked as-is.
#
# This scan finds those orphans and parks them on office-hours for human
# re-triage. It is an INVERSION scan: it inspects only the PRs actually cited by
# the `<!-- dispatch:source-pr <N> -->` body markers on currently-open
# `dispatch:review-followup`-labeled issues — never a window enumeration of all
# recently-closed PRs.
#
# Three-way PR-state gate (load-bearing): a cited PR's follow-ups are flagged
# ONLY IF the PR is `state == "closed"` AND `merged_at == null` AND the PR does
# not already carry the `dispatch:orphans-retriaged` marker. A merged PR
# (state "closed" + non-null merged_at) or a still-open PR (state "open") must
# NEVER be touched. (REST shape: lowercase state, snake_case merged_at — REST has
# no distinct MERGED state, so the merged-PR skip rides the merged_at arm.)
#
# Idempotency: the per-PR `dispatch:orphans-retriaged` label is the correct
# idempotency key — NOT an issue-level "is office-hours already present?" check.
# A human who resolves an orphan and removes `dispatch:office-hours` would be
# re-parked on the next tick if we keyed on the issue label. The per-PR marker
# guarantees each closed-unmerged PR's orphans are flagged exactly once.
#
# Best-effort: this is a tick scan and a tick scan must NEVER abort the chain.
# Every per-PR / per-issue gh failure warns to stderr and continues to the next
# item; the script ALWAYS exits 0. (NOT set -e, mirroring its sibling scans.)
#
# Sandbox note: the CALLER wraps every invocation of this script with
# dangerouslyDisableSandbox (per .claude/rules/sandbox.md) because `gh` needs
# network access and gh's TLS validation is blocked by the sandbox. This script
# therefore sets NOTHING sandbox-related itself.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

RETRIAGED_LABEL="dispatch:orphans-retriaged"
RETRIAGED_COLOR="5319e7"
RETRIAGED_DESC="dispatch: orphaned review follow-ups re-triaged after source PR closed unmerged"

# ---- Step 1: gather the open dispatch:review-followup-labeled follow-up issues
# The static `dispatch:review-followup` label is a cheap server-side pre-filter
# narrowing the fetch to candidate follow-ups; the per-PR source identity is then
# read from each issue's `<!-- dispatch:source-pr <N> -->` body marker, so the
# fetch must include bodies (--include-body).
# REST keeps this scan off the shared GraphQL rate-limit bucket (#1601). The
# per-PR state lookups in Step 2 are also REST (gh api .../pulls/$N, #2007), so
# the entire scan is GraphQL-free.
if ! OPEN_JSON=$(gh_issue_list_rest --state open --label dispatch:review-followup --include-body); then
  # Cannot scan without the open-issue set — best-effort, exit 0.
  echo "dispatch-retriage-orphaned-followups: warning: gh_issue_list_rest --state open --label dispatch:review-followup failed; skipping scan" >&2
  exit 0
fi

# Map: source-PR number `N` → space-separated list of open follow-up issue
# numbers. Built with process substitution (NOT a pipe) so the `declare -A`
# mutations survive the loop — a `| while read` would run the loop in a subshell
# and discard them.
declare -A PR_FOLLOWUPS=()
while read -r issue pr; do
  [[ -z "$issue" ]] && continue
  PR_FOLLOWUPS["$pr"]+="$issue "
done < <(printf '%s' "$OPEN_JSON" | jq -r '
  .[]
  | select((.body // "") | test("<!-- dispatch:source-pr [0-9]+ -->"))
  | ((.body // "") | [scan("<!-- dispatch:source-pr ([0-9]+) -->")] | last | .[0]) as $pr
  | "\(.number) \($pr)"
')

# ---- Step 2: for each distinct cited source PR, apply the three-way gate -----
for N in "${!PR_FOLLOWUPS[@]}"; do
  PR_RC=0
  PR_JSON=$(gh_retry gh api "repos/{owner}/{repo}/pulls/$N") || PR_RC=$?
  if [[ "$PR_RC" -ne 0 ]]; then
    echo "dispatch-retriage-orphaned-followups: warning: gh api repos/.../pulls/#$N failed; skipping" >&2
    continue
  fi

  STATE=$(printf '%s' "$PR_JSON" | jq -r '.state')
  MERGED_AT=$(printf '%s' "$PR_JSON" | jq -r '.merged_at')
  HAS_MARKER=$(printf '%s' "$PR_JSON" \
    | jq -r --arg l "$RETRIAGED_LABEL" 'any(.labels[]?; .name == $l)')

  # The three-way gate. REST has no MERGED state: a merged PR is state "closed"
  # with a non-null merged_at; an open PR is state "open"; an already-processed
  # PR carries the marker. Skip silently in every one of those cases — only a
  # "closed", never-merged (merged_at null), unmarked PR's follow-ups get flagged.
  if [[ "$STATE" != "closed" || "$MERGED_AT" != "null" || "$HAS_MARKER" == "true" ]]; then
    continue
  fi

  # ---- Step 3: park each open follow-up of this orphaned PR ------------------
  ALL_PARKED=true
  for issue in ${PR_FOLLOWUPS[$N]}; do
    [[ -z "$issue" ]] && continue
    if ! "$SCRIPT_DIR/dispatch-apply-office-hours" "$issue" \
        "source PR #$N was closed unmerged — orphaned review finding; re-triage: close as moot or retarget to the shipped design on main"; then
      echo "dispatch-retriage-orphaned-followups: warning: dispatch-apply-office-hours failed for issue #$issue (source PR #$N)" >&2
      ALL_PARKED=false
      continue
    fi
    echo "retriaged #$issue (source PR #$N closed unmerged)"
  done

  # If any park failed, skip the idempotency marker so a future tick retries the
  # unparked orphans. dispatch-apply-office-hours is idempotent, so re-running
  # the already-succeeded parks on that retry is harmless; the per-PR marker
  # still prevents re-processing once every orphan is parked.
  if [[ "$ALL_PARKED" != "true" ]]; then
    echo "dispatch-retriage-orphaned-followups: warning: not all follow-ups of PR #$N parked; deferring $RETRIAGED_LABEL marker for retry" >&2
    continue
  fi

  # ---- Mark the PR processed (idempotency key) ------------------------------
  # Apply after all parks succeeded. dispatch-apply-office-hours is itself
  # idempotent, so re-running a park is harmless; what must NOT happen is
  # re-parking a resolved orphan on a later tick, which the per-PR marker
  # prevents. Ensure the label exists (idempotent), then add it via REST. A PR is
  # an issue in REST, so the add targets issues/<PR>/labels. `gh label create`
  # stays porcelain (REST POST /repos/.../labels — not a migration target);
  # tolerate only an already-exists error and continue (non-aborting scan) on any
  # other create/add failure.
  if ! create_out=$(gh label create "$RETRIAGED_LABEL" \
      --color "$RETRIAGED_COLOR" --description "$RETRIAGED_DESC" 2>&1); then
    case "$create_out" in
      *already\ exists*|*already_exists*) : ;;   # label already present — fine
      *)
        echo "dispatch-retriage-orphaned-followups: warning: could not create label $RETRIAGED_LABEL: $create_out" >&2
        continue
        ;;
    esac
  fi
  if ! mark_out=$(gh_issue_set_labels_rest "$N" "$RETRIAGED_LABEL" 2>&1); then
    echo "dispatch-retriage-orphaned-followups: warning: could not mark PR #$N with $RETRIAGED_LABEL: $mark_out" >&2
    continue
  fi
done

# A tick scan must never abort the chain.
exit 0
