#!/usr/bin/env bash
# Map changed-surface flags → the surface-conditional finder-source set for the
# /review-fix Workflow fan-out (issue #890).
# Usage: printf 'surface=code\ndeps=true\napp_or_rules=true\n' | dispatch-review-finders
#
# Reads four key=value lines on stdin (as emitted by dispatch-security-surface,
# plus api_call_site which is computed separately at the review-fix args-build
# site), in any order, blank lines ignored:
#   surface=<empty|docs|tests|code>
#   deps=<true|false>
#   app_or_rules=<true|false>
#   api_call_site=<true|false>
# Missing keys default to: surface=empty, deps=false, app_or_rules=false,
# api_call_site=false.
#
# Prints finder source names to stdout, one per line, in this fixed order,
# omitting any not warranted by the surface flags:
#   code-review          (always)
#   input-validation     (surface==code)
#   secrets              (surface==code)
#   red-team             (surface==code)
#   security-review      (surface==code)
#   auth                 (surface==code AND app_or_rules==true)
#   data-exposure        (surface==code AND app_or_rules==true)
#   firebase             (surface==code AND (app_or_rules==true OR api_call_site==true))
#   cost                 (surface==code AND api_call_site==true)
#   codeql               (surface==code)
#   erosion              (surface==code)
#   npm                  (deps==true)
#
# surface empty/docs/tests => exactly code-review (zero security finders).
# surface==code       => 4 always-on security finders + codeql + erosion.
# app_or_rules==true  => additionally auth, data-exposure, firebase (7 total).
# api_call_site==true => additionally cost, and firebase if not already added by
#                        app_or_rules (i.e. firebase rides EITHER flag).
# deps==true          => additionally npm (independent of surface).
#
# No network access, no git, no gh — pure stdin → stdout classification.
#
# Consumer: .claude/workflows/review-fix.js mirrors this mapping in JS;
# this script is the normative spec for that inline JS logic.
#
# NOTE — code-review is still always-on regardless of surface (this roster is
# unchanged and remains normative for that), but it is no longer invoked as an
# AGENT in the Workflow's parallel finder fan-out. It runs as the serialized
# `claude -p '/code-review low --fix'` pre-stage in /review-fix SKILL.md Step 1b,
# before the Workflow is invoked at all — the `-p` user turn is the only entry
# point that can invoke a `disable-model-invocation` skill, and its `--fix` writes
# the working tree, so it must not run concurrently with the fan-out. That is why
# `agentFinderSet` in review-fix.js excludes code-review, alongside codeql/npm/
# erosion (which were never agents either — they arrive as prescanned findings).
# Nothing about this script's emitted stdout changes.
#
# NOTE — domain-sweep fold (tactic-review-domain-lens-consolidation): the JS agent
# fan-out (`agentFinderSet` in review-fix.js) now maps the `secrets` + `auth` +
# `data-exposure` SOURCES onto ONE agent called `domain-sweep`, whose brief carries
# each source's section under the same `app_or_rules` gating this script's SOURCE
# roster already encodes above (`secrets` unconditional on `surface=code`; `auth`/
# `data-exposure` only when `app_or_rules=true`). So the SOURCE roster this script
# emits and the AGENT roster in review-fix.js are now deliberately NOT 1:1 — three
# sources, one agent. Nothing about this script's own stdout output changes as a
# result; it remains the normative SOURCE-name spec, not an agent-name spec.
#
# NOTE — api-cost merge (tactic-review-api-cost-lens-merge): the JS agent fan-out
# (`agentFinderSet` in review-fix.js) now maps the `firebase` + `cost` SOURCES
# onto ONE agent called `api-cost`. Unlike the domain-sweep fold above, this also
# introduces a new GATE for the ADVISORY half: `cost` no longer rides
# `app_or_rules`, it gates on the `api_call_site` flag computed from diff content
# (does the diff ADD a call site for a metered/paid API, e.g. Firebase or another
# billed service) at the /review-fix SKILL.md args-build step, NOT by
# `dispatch-security-surface` (which only ever emitted `surface`/`deps`/
# `app_or_rules`).
#
# The SECURITY half does NOT move. `firebase` reviews Firestore rules
# permissiveness, emulator-only code on production paths, and Firebase key/config
# exposure — none of which the `api_call_site` pattern set matches (a rules diff
# adding `allow read, write: if request.auth != null;`, or an `initializeApp`/
# `connectFirestoreEmulator`/`apiKey` diff, yields `api_call_site=false`). Gating
# it on `api_call_site` ALONE would silently switch the firebase reviewer off for
# exactly the diffs it exists to review — a fail-open security-coverage
# regression. So `firebase` rides `app_or_rules || api_call_site`: it keeps its
# pre-merge trigger and additionally fires on API-call-site diffs outside the
# app/rules path set. `auth` and `data-exposure` are unaffected and remain gated
# on `app_or_rules` alone.
#
# Consequence for the merged agent: `api-cost` launches when EITHER flag is true,
# and its brief carries only the sections whose own gate is true — firebase-only
# on an app/rules diff that adds no call site, and both sections whenever
# api_call_site is true (a cost-only brief is unreachable, since api_call_site
# also satisfies firebase's gate). review-fix.js's apiCostDomains()/
# apiCostSections() take both flags and emit exactly the subset this roster does.
#
# As with domain-sweep, this script remains the normative SOURCE-name spec, not
# an agent-name spec — two sources, one agent, and nothing about this script's
# own stdout format changes as a result.
set -euo pipefail

# --- parse stdin ----------------------------------------------------------------

surface="empty"
deps="false"
app_or_rules="false"
api_call_site="false"

while IFS= read -r line; do
  # Skip blank / whitespace-only lines.
  [[ -z "${line//[[:space:]]/}" ]] && continue
  case "$line" in
    surface=*)   surface="${line#surface=}" ;;
    deps=*)      deps="${line#deps=}" ;;
    app_or_rules=*) app_or_rules="${line#app_or_rules=}" ;;
    api_call_site=*) api_call_site="${line#api_call_site=}" ;;
  esac
done

# --- emit finder set ------------------------------------------------------------

# Always-present finder (review quality, all surfaces including empty/docs/tests).
echo "code-review"

# Security finders: only when surface==code.
if [[ "$surface" == "code" ]]; then
  echo "input-validation"
  echo "secrets"
  echo "red-team"
  echo "security-review"

  # App/rules-specific security finders.
  if [[ "$app_or_rules" == "true" ]]; then
    echo "auth"
    echo "data-exposure"
  fi

  # The two sources the merged api-cost agent carries (review-fix.js), gated
  # SEPARATELY. firebase is the security half: it keeps its app/rules trigger AND
  # additionally fires on a diff-content call site, so widening the merged lens
  # never narrows security coverage. cost is the advisory half and rides
  # api_call_site alone.
  if [[ "$app_or_rules" == "true" || "$api_call_site" == "true" ]]; then
    echo "firebase"
  fi
  if [[ "$api_call_site" == "true" ]]; then
    echo "cost"
  fi

  echo "codeql"

  # Net-erosion structural metric (prescanned, issue #2064): like codeql/npm it
  # is NOT a JS agent (it arrives via prescanned_findings), but it belongs in this
  # normative finder-set spec, listed alongside codeql under the code surface.
  echo "erosion"
fi

# Dependency audit finder: gated on deps flag, independent of surface.
if [[ "$deps" == "true" ]]; then
  echo "npm"
fi
