#!/usr/bin/env bash
# Collapse the deterministic /dispatch-worker prelude into one call and print one
# directive. Usage: dispatch-route <N> <worktree-path>
#
# Runs the entire deterministic worker prelude — the worktree cross-check, the
# worktree provisioning + origin/main merge, the dispatch-ci-ready gate, and
# dispatch-phase — in a single invocation, so the worker model makes one Bash
# round-trip and never branches on intermediate exit codes itself. Prints exactly
# one directive line to stdout:
#
#   INVOKE /fix-checks              phase fix-checks   (draft PR, CI failed)
#   INVOKE /qa-fix                  phase qa           (draft, CI green, no label)
#   INVOKE /review-fix              phase review       (dispatch:qa-done / reviewed re-entry)
#   INVOKE /budget-parse-job       phase plan         (no PR, unplanned, statements:<key> label) — parse-job issue
#   INVOKE /implement              phase implement    (no PR + dispatch:planned)
#   INVOKE /dispatch-resolve-conflict  provisioning hit an origin/main merge conflict
#   RELEVANCE-REVIEW                phase plan         (no PR, unplanned) — routes to SKILL.md Step 2
#   STOP done                       phase done         (non-draft PR)
#   PUSH-STRANDED                   phase done, but worktree ahead of origin/<branch> — push then park
#   STOP waiting                    dispatch-ci-ready reports not-ready (draft PR CI pending)
#   STOP provision-failed           direnv/merge provisioning failed (non-conflict);
#                                   an office-hours-reason is written here before printing it
#   STOP wrong-worktree             cross-check failed (diagnostic on stderr); exits non-zero
#
# Usage error (missing <N> or <worktree-path>) → stderr message, exit 2 (matches
# the sibling-script convention).
#
# Provisioning (dispatch-provision-worktree) runs AFTER the cross-check and BEFORE
# phase derivation: the cross-check guards against merging into the wrong worktree,
# and the origin/main merge must complete before dispatch-ci-ready/dispatch-phase
# run so they — and the phase skill the worker later loads — read the up-to-date
# .claude/ tree (the merge can update those very scripts). This script's own code
# is the pre-merge version for this one invocation; its dispatch-ci-ready/dispatch-phase
# subprocesses pick up the merged tree. This is the worker counterpart of what
# restore-dispatch-skill.sh does on context-clear, relocated out of the router's
# held-lock fan-out loop (#1047 / part of #1044): the router does only the cheap
# `git worktree add`, and the multi-minute, budget-irrelevant provisioning runs here.
#
# The open-PR list is fetched ONCE here and exported as DISPATCH_PR_LIST; both
# dispatch-ci-ready and dispatch-phase honor that env contract and reuse the
# single snapshot — no redundant gh pr list. The genuine post-selection CI race
# (a push restarting CI between router selection and worker session end) is caught
# by dispatch-stop.sh's early not-ready gate, not here.
#
# Calls gh and (via dispatch-provision-worktree) git merge / direnv / npm — invoke
# with dangerouslyDisableSandbox: true. The merge is a tree-updating op over the
# read-only .claude/skills/** carve-out (see .claude/rules/sandbox.md).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

N="${1:-}"
WORKTREE_PATH="${2:-}"
if [[ -z "$N" || -z "$WORKTREE_PATH" ]]; then
  echo "error: usage: dispatch-route <N> <worktree-path>" >&2
  exit 2
fi
if [[ ! "$N" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: <N> must be a positive integer, got '$N'" >&2
  exit 2
fi

# Step 0 — worktree cross-check (the defensive prelude now owned by this script,
# described in dispatch-worker SKILL.md Step 1): derive the branch from the
# worktree toplevel's basename, assert the "<N>-" prefix and that the toplevel
# equals the passed <worktree-path>.
ACTUAL_TOPLEVEL=$(git rev-parse --show-toplevel)
ACTUAL_BRANCH=$(basename "$ACTUAL_TOPLEVEL")
EXPECTED="${N}-"
case "$ACTUAL_BRANCH" in
  ${EXPECTED}*) ;;
  *)
    echo "dispatch-route invoked with wrong worktree: expected branch '${EXPECTED}…' under worktrees/, got '${ACTUAL_BRANCH}'" >&2
    echo "The spawner must spawn the worker with cwd matching <worktree-path>." >&2
    echo "STOP wrong-worktree"
    exit 1
    ;;
esac
if [[ "$ACTUAL_TOPLEVEL" != "$WORKTREE_PATH" ]]; then
  echo "dispatch-route invoked with mismatched <worktree-path>: spawn cwd '$ACTUAL_TOPLEVEL' != argument '$WORKTREE_PATH'" >&2
  echo "STOP wrong-worktree"
  exit 1
fi

# Provision the worktree and merge origin/main — runs here, after the cross-check
# (so we never merge into the wrong worktree) and before phase derivation (so the
# merged tree's dispatch-ci-ready/dispatch-phase and the worker's later phase skill
# are current). dispatch-provision-worktree exits: 0 clean / already-up-to-date;
# 3 merge conflict (merge aborted, tree left clean); any other non-zero is a fetch
# or non-conflict merge failure. Capture its code without tripping `set -e`.
PROVISION_RC=0
"$SCRIPT_DIR/dispatch-provision-worktree" "$WORKTREE_PATH" || PROVISION_RC=$?
if [[ "$PROVISION_RC" -eq 3 ]]; then
  # A clean origin/main merge conflict — hand off to the conflict-resolver skill.
  echo "INVOKE /dispatch-resolve-conflict"
  exit 0
elif [[ "$PROVISION_RC" -ne 0 ]]; then
  # Fetch failure or a non-conflict merge failure — park the issue to office-hours.
  # Write the reason here (under the CLAUDE_JOB_DIR guard, atomically) so the worker
  # only has to stop; the Stop hook surfaces this file.
  if [[ -n "${CLAUDE_JOB_DIR:-}" && -d "$CLAUDE_JOB_DIR" ]]; then
    printf '%s\n' "dispatch-route: provisioning/merge of origin/main failed for #${N} (exit ${PROVISION_RC})" \
      > "$CLAUDE_JOB_DIR/office-hours-reason.tmp"
    mv "$CLAUDE_JOB_DIR/office-hours-reason.tmp" "$CLAUDE_JOB_DIR/office-hours-reason"
  fi
  echo "STOP provision-failed"
  exit 0
fi

# Fetch the open-PR list once; reuse it for every sibling call via the
# DISPATCH_PR_LIST env contract (dispatch-ci-ready and dispatch-phase both honor it).
DISPATCH_PR_LIST=$(gh pr list --state open --json number,headRefName,isDraft,statusCheckRollup,labels,mergeable)
export DISPATCH_PR_LIST

# Initial CI-ready gate. exit 0 (ready) → continue; exit 1 (waiting) → STOP waiting;
# any other exit code is a dispatch-ci-ready internal failure — propagate it.
CI_READY_RC=0
"$SCRIPT_DIR/dispatch-ci-ready" "$N" >/dev/null || CI_READY_RC=$?
if [[ "$CI_READY_RC" -eq 1 ]]; then
  echo "STOP waiting"
  exit 0
elif [[ "$CI_READY_RC" -ne 0 ]]; then
  echo "dispatch-route: dispatch-ci-ready exited $CI_READY_RC for $N" >&2
  exit "$CI_READY_RC"
fi

# Derive the phase against the same snapshot.
PHASE=$("$SCRIPT_DIR/dispatch-phase" "$N")

# Map the phase string to its directive.
case "$PHASE" in
  plan)
    # A no-PR unplanned target is normally a plan-phase issue → RELEVANCE-REVIEW.
    # But a statement parse-job issue (filed by dispatch-statements-scan, carrying a
    # configured statements:<key> label, with no PR) routes to /budget-parse-job
    # instead — it is a one-phase handler that never opens a code PR. The label
    # fetch happens ONLY here, inside the no-PR arm, so PR-bearing phases add no
    # extra gh call. dispatch-config-load distinguishes "config absent" (prints
    # "no-config", exit 0 — the normal state for repos without statement scanning)
    # from "config present but malformed" (exit 1) — surface the latter as an
    # error, treat the former as no configured labels (empty intersection →
    # unchanged RELEVANCE-REVIEW).
    STATEMENTS_CONFIG=$("$SCRIPT_DIR/dispatch-config-load" statements)
    if [[ "$STATEMENTS_CONFIG" == "no-config" ]]; then
      CONFIGURED_LABELS=""
    else
      CONFIGURED_LABELS=$(printf '%s' "$STATEMENTS_CONFIG" | jq -r '.statements[].label')
    fi
    PARSE_JOB=0
    if [[ -n "$CONFIGURED_LABELS" ]]; then
      ISSUE_LABELS=""
      ISSUE_LABELS=$(gh issue view "$N" --json labels | jq -r '.labels[].name') || {
        # gh failure (network error, auth issue, etc.) — fall back to the safe
        # default of RELEVANCE-REVIEW rather than exiting non-zero without a
        # directive, which would leave the stop hook with a misleading reason.
        echo "dispatch-route: gh issue view $N --json labels failed; defaulting to RELEVANCE-REVIEW" >&2
        echo "RELEVANCE-REVIEW"
        exit 0
      }
      # Non-empty intersection of the issue's labels with the configured
      # statements labels → this is a parse-job issue.
      if [[ -n "$ISSUE_LABELS" ]] \
        && comm -12 \
          <(printf '%s\n' "$CONFIGURED_LABELS" | sort -u) \
          <(printf '%s\n' "$ISSUE_LABELS" | sort -u) \
          | grep -q .; then
        PARSE_JOB=1
      fi
    fi
    if [[ "$PARSE_JOB" -eq 1 ]]; then
      echo "INVOKE /budget-parse-job"
    else
      echo "RELEVANCE-REVIEW"
    fi
    ;;
  implement)
    # A planned (dispatch:planned) no-PR issue routes straight to /implement, which
    # builds from the persisted <!-- dispatch:plan --> comment — planning already
    # happened in the plan phase, so no relevance review and no parse-job check (a
    # planned issue is never a parse-job).
    echo "INVOKE /implement"
    ;;
  fix-checks)   echo "INVOKE /fix-checks" ;;
  qa)           echo "INVOKE /qa-fix" ;;
  review)       echo "INVOKE /review-fix" ;;
  done)
    # #1105: never park a `done` PR whose worktree is ahead of its remote branch —
    # those unpushed dispatch-merge-main / resolve-conflict merges leave the PR
    # permanently CONFLICTING with no later tick able to push them.
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    git fetch origin "$CURRENT_BRANCH" >/dev/null 2>&1 || true
    AHEAD=$(git rev-list --count "origin/${CURRENT_BRANCH}..HEAD" 2>/dev/null || echo 0)
    if [[ "$AHEAD" -ne 0 ]]; then
      echo "PUSH-STRANDED"
    else
      echo "STOP done"
    fi
    ;;
  *)
    echo "dispatch-route: unexpected phase '$PHASE' for $N" >&2
    exit 1
    ;;
esac
exit 0
