#!/usr/bin/env bash
# dispatch-scan-recoverable-deaths — tick-time scan for transient API-error
# phase-worker deaths the Stop hook never saw, arming the EXISTING resume
# machinery (dispatch-schedule-rate-limit-resume) at most once per issue N.
#
# tactic-dispatch-legacy-rewire (Unit 2 audit) — DEFER-TO-UNIT-3 (delete-with-the-lane):
#   This scan is entirely legacy issue-lane: it enumerates `^[0-9]+-` worker
#   sessions (Step 5 name filter), reads the dispatch:office-hours label (guard b),
#   and derives phase/model via dispatch-phase (Step 6). Graph-lane node-id
#   workers are filtered out and its resume target (dispatch-schedule-rate-limit-resume
#   → dispatch-resume-worker) is the issue-lane worker machinery. The graph lane
#   (dispatch-graph-execute) has its own lock-free death handling and does NOT
#   want this issue-keyed scan. It dies with the legacy lane in Unit 3, which also
#   drops the dispatch-tick call site (dispatch-tick line ~409).
#
# Issue #2454. The Claude harness does NOT fire the Stop hook on an
# API/stream error, so dispatch-stop.sh Branch A's transient-death self-heal
# (#1733) never runs for those deaths — the session strands `failed`, its
# worktree held, until a human intervenes. This script relocates that recovery
# onto the always-on heartbeat-driven dispatch-tick: every autonomous tick it
# enumerates terminal phase-worker sessions, finds the transient-API deaths the
# Stop hook missed, and arms the same backed-off resume the hook would have.
#
# Best-effort by contract: ANY internal failure (daemon unreachable, missing
# transcript, jq error, gh/stat/schedule failure) logs to stderr and the script
# still exits 0. It must NEVER be the reason a tick aborts. The ONLY exit code
# is 0 — including the daemon-UNKNOWN early return.
#
# Session-state partition (the 8 states `claude agents --json --all` reports):
#   Active  → blocks N (a resume/launch is already in flight; never re-arm):
#             working, busy, waiting, idle, paused.
#   Terminal → selection pool (a worker that has ended this session):
#             stopped, failed, done.
#   "Terminal" is computed as membership in {stopped,failed,done}; EVERYTHING
#   else — the five active states AND any unexpected/unknown state — blocks N.
#   Folding unknown into "blocks N" is the fail-safe choice (never revive when
#   uncertain). The per-N active flag is computed across ALL rows for N, so a
#   single non-terminal row anywhere blocks the whole issue.
#
# Why `done` stays in the selection pool even though it is not itself
# resumable: phase workers reuse the same `<N>-slug` worktree across phases, so
# `--all` accumulates `done`, `failed`, and forked-`failed` rows for one N.
# Selection is "newest transcript-mtime over ALL terminal rows, THEN test the
# detector on that single newest transcript" — NOT "newest among matching
# candidates". That means a newer `done` (work completed) or a newer
# non-transient stop correctly supersedes an older transient-fail: the detector
# exits non-zero on the newer transcript and N is skipped, so superseded work is
# never revived. It lifts the detector's "last assistant turn only" philosophy
# across sessions.
#
# Accepted limitation (the issue's design — do NOT add further locking): a true
# concurrent Stop-hook-and-scan TOCTOU, where the hook and this scan both detect
# the same death and both arm before either's timer is visible to guard (c), is
# MITIGATED, NOT eliminated, by guard (c) (the pending-timer check) plus the
# shared per-issue retry counter that dispatch-schedule-rate-limit-resume bumps
# and caps. Two timers for the same (N, FIRE) collide on the unit name and
# systemd refuses the duplicate; two timers for different FIREs both bump the
# shared counter, so the cap still bounds total retries. This residual race is
# acceptable; no cross-process lock is added.

set -euo pipefail

# ---- Step 1: resolve SCRIPT_DIR & source the liveness lib --------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-claude-agents.sh"
# lib.sh is intentionally NOT sourced: it provides no logging helpers (siblings
# just `echo ... >&2`) and nothing else this script uses, and sourcing it would
# pull in unwanted source-time side effects.

# ---- Step 2: config / env overrides -----------------------------------------
# Every external command is overridable so the script is testable with fakes
# (mirrors dispatch-schedule-rate-limit-resume's DISPATCH_RATE_LIMIT_RESUME_*).

# Consumed by the sourced lib for its own `claude agents --json` calls; point it
# at the same command so a faked `claude` fakes every path (mirrors
# dispatch-resume-worker line ~139).
export CLAUDE_AGENTS_CMD="${CLAUDE_AGENTS_CMD:-claude}"

GH="${DISPATCH_SCAN_GH_CMD:-gh}"
SYSTEMCTL="${DISPATCH_SCAN_SYSTEMCTL_CMD:-systemctl}"
SCHEDULE_CMD="${DISPATCH_SCAN_SCHEDULE_CMD:-$SCRIPT_DIR/dispatch-schedule-rate-limit-resume}"
PHASE_CMD="${DISPATCH_SCAN_PHASE_CMD:-$SCRIPT_DIR/dispatch-phase}"
PHASE_MODEL_CMD="${DISPATCH_SCAN_PHASE_MODEL_CMD:-$SCRIPT_DIR/dispatch-phase-model}"
PHASE_EFFORT_CMD="${DISPATCH_SCAN_PHASE_EFFORT_CMD:-$SCRIPT_DIR/dispatch-phase-effort}"
DETECT_CMD="${DISPATCH_SCAN_DETECT_CMD:-$SCRIPT_DIR/dispatch-detect-transient-death}"

# ---- Step 3: enumerate every phase-worker session once ----------------------
# The lib filter is a regex test("^" + $prefix); `[0-9]` matches every
# `<N>-slug` phase worker. Rows are sessionId<TAB>state<TAB>cwd with NO name —
# the name is derived from the cwd basename. Return code 1 = UNKNOWN (daemon
# unreachable): fail safe — never park/resume on an unknowable registry.
if ! ROWS=$(claude_sessions_with_name_prefix_all '[0-9]'); then
  echo "dispatch-scan-recoverable-deaths: session registry UNKNOWN (daemon unqueryable); no-op" >&2
  exit 0
fi

# `[]` / no matches → empty ROWS → nothing to do.
if [[ -z "${ROWS//[[:space:]]/}" ]]; then
  exit 0
fi

# ---- Step 4: build the armed-timer N-set once -------------------------------
# Guard (c): skip N if a dispatch-rate-limit-resume-<N>-*.timer already exists.
# List ONCE here, extract the N values, and reuse the set per N. Anchor the
# TRAILING dash — match dispatch-rate-limit-resume-<N>- so N=17 does not match
# `...-170-...`.
declare -A ARMED_TIMER_N=()
timer_units=""
if timer_units=$("$SYSTEMCTL" --user list-units --type=timer --all --no-legend \
    'dispatch-rate-limit-resume-*' 2>/dev/null); then
  while IFS= read -r _tn; do
    [[ -n "$_tn" ]] || continue
    ARMED_TIMER_N["$_tn"]=1
  done < <(grep -oE 'dispatch-rate-limit-resume-[0-9]+-' <<<"$timer_units" \
             | sed -E 's/^dispatch-rate-limit-resume-([0-9]+)-$/\1/' || true)
fi

# ---- Step 5: group terminal rows by N, track per-N active state -------------
# Group by N (all rows for one N share cwd/name). For each N we accumulate every
# terminal row's "<mtime>\t<sessionId>\t<state>\t<cwd>" line, and a separate
# flag set when ANY row (terminal or not) for N is in a non-terminal/active
# state. The active flag must consider ALL rows, so it is updated before the
# terminal filter discards non-terminal rows.
declare -A N_ACTIVE=()       # N -> 1 if any row for N is active/blocking
declare -A N_TERMINAL=()     # N -> newline-joined "mtime\tsessionId\tstate\tcwd"
declare -A N_CWD=()          # N -> cwd (shared across rows)
declare -A N_NAME=()         # N -> name (basename of cwd)
ORDER=()                     # deterministic iteration order of Ns

is_terminal_state() {
  case "$1" in
    stopped|failed|done) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS=$'\t' read -r sessionId state cwd; do
  [[ -n "$sessionId" && -n "$cwd" ]] || continue
  name="$(basename "$cwd")"
  # Require the worker-name shape `^[0-9]+-`; skip anything else.
  [[ "$name" =~ ^[0-9]+- ]] || continue
  N="${name%%-*}"

  if [[ -z "${N_CWD[$N]:-}" ]]; then
    ORDER+=("$N")
    N_CWD["$N"]="$cwd"
    N_NAME["$N"]="$name"
  fi

  if is_terminal_state "$state"; then
    # Derive the transcript path and its mtime (missing transcript sorts oldest,
    # mtime 0). stat on a missing file aborts under set -e, so guard it.
    slug=$(printf '%s' "$cwd" | tr '/.' '--')
    transcript="$HOME/.claude/projects/$slug/$sessionId.jsonl"
    mtime=$(stat -c %Y "$transcript" 2>/dev/null || echo 0)
    [[ "$mtime" =~ ^[0-9]+$ ]] || mtime=0
    N_TERMINAL["$N"]="${N_TERMINAL[$N]:-}${mtime}	${sessionId}	${state}	${cwd}
"
  else
    # Active / unexpected state → block N (a resume/launch is in flight).
    N_ACTIVE["$N"]=1
  fi
done <<<"$ROWS"

# ---- Step 6: per-N selection & arm ------------------------------------------
# Per-N work is wrapped in a subshell `( ... ) || true` so one N's failure can
# never abort the loop or flip the script's exit code off 0. Grouping by N
# already gives "at most once per N per tick".

for N in "${ORDER[@]}"; do
  (
    cwd="${N_CWD[$N]}"
    name="${N_NAME[$N]}"

    # Guard (a) live: any active row for N → skip.
    if [[ -n "${N_ACTIVE[$N]:-}" ]]; then
      exit 0
    fi

    # No terminal rows (all rows were active and got skipped) → nothing to do.
    terminal="${N_TERMINAL[$N]:-}"
    [[ -n "${terminal//[[:space:]]/}" ]] || exit 0

    # Guard (c) pending timer: skip N if a rate-limit-resume timer is armed.
    if [[ -n "${ARMED_TIMER_N[$N]:-}" ]]; then
      exit 0
    fi

    # Guard (b) office-hours: deferred until AFTER (a)/(c) pass to avoid a gh
    # round-trip per terminal row. Fail safe — on a gh failure default to
    # `true` (parked → skip), never proceed on an unknown label state.
    oh=$("$GH" issue view "$N" --json labels \
           --jq 'any(.labels[]; .name=="dispatch:office-hours")' 2>/dev/null) || oh="true"
    if [[ "$oh" != "false" ]]; then
      exit 0
    fi

    # Selection rule (the crux): newest transcript-mtime over ALL terminal rows,
    # THEN test the detector on that single newest transcript. sort numeric-desc
    # on mtime (col 1) with a deterministic sessionId tiebreak (col 2). A missing
    # transcript has mtime 0 and sorts oldest.
    selected=$(printf '%s' "$terminal" | grep -v '^[[:space:]]*$' \
                 | sort -t'	' -k1,1nr -k2,2 | head -1) || selected=""
    [[ -n "$selected" ]] || exit 0

    IFS=$'\t' read -r _mtime sessionId _state _cwd <<<"$selected"
    [[ -n "$sessionId" ]] || exit 0

    slug=$(printf '%s' "$cwd" | tr '/.' '--')
    transcript="$HOME/.claude/projects/$slug/$sessionId.jsonl"

    # Run the detector on THAT single newest transcript only. Match (exit 0) →
    # resume target. Non-match / unreadable / tail of a `done` session → skip N.
    if ! "$DETECT_CMD" "$transcript"; then
      exit 0
    fi

    # Resolve model/effort exactly as dispatch-stop.sh Branch A does, then arm
    # the resume once for N. Per-call failures are tolerated (|| true).
    CURRENT_PHASE=$("$PHASE_CMD" "$N" 2>/dev/null || true)
    _model=$("$PHASE_MODEL_CMD" "$CURRENT_PHASE" 2>/dev/null || true)
    _effort=$("$PHASE_EFFORT_CMD" "$CURRENT_PHASE" 2>/dev/null || true)

    sched_out=$("$SCHEDULE_CMD" "$N" "$sessionId" "$cwd" "$name" "$_model" "$_effort" 2>&1) \
      && sched_rc=0 || sched_rc=$?
    if (( sched_rc != 0 )); then
      echo "dispatch-scan-recoverable-deaths: schedule failed for #$N (rc=$sched_rc): $sched_out" >&2
      exit 0
    fi
    case "$sched_out" in
      *escalated*)
        # Cap hit — the schedule script already parked the issue on office-hours.
        echo "dispatch-scan-recoverable-deaths: #$N rate-limit retries exhausted; parked office-hours" >&2 ;;
      *)
        # reseeded — timer armed.
        echo "dispatch-scan-recoverable-deaths: #$N armed resume: $sched_out" >&2 ;;
    esac
    exit 0
  ) || true
done

exit 0
