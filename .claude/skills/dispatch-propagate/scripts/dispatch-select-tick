#!/usr/bin/env bash
# dispatch-select-tick — the /dispatch-propagate router's selection orchestrator
# (the deterministic Steps 0-3 of the old SKILL.md, bundled into one script).
#
# Usage: dispatch-select-tick [--manual | <node-id>]
#
# Runs the lock acquisition, origin/main sync (only on `main`), the run-scoped
# concurrency gate, the JIT engine, the Calendar JIT importer, the statements
# scan, the orphaned-follow-up re-triage scan,
# and graph target selection as one deterministic sequence and prints exactly ONE
# decision line as its LAST stdout line. Any JIT
# `created`/`skipped`/`debounced` lines are passed through first, each prefixed
# `jit: `, followed by any `calendar: ...` lines, followed by any
# `statements: ...` lines, and any
# `retriage: ...` lines. The router (dispatch-tick)
# routes on the final decision line.
#
# The legacy gh-issue selection lane — explicit-arg resolution, the priority /
# pr / issue queue selector (dispatch-select-target), and the worktree
# materialization (dispatch-materialize-spawn) — was deleted in
# tactic-dispatch-legacy-rewire Unit 3. What remains is the graph selector plus
# the two lane-independent aux triggers (jit-reminder, main-broken) and the
# health/sync latches.
#
# Decision lines (the last stdout line is always exactly one of):
#   busy             lock held by another tick; nothing acquired, nothing released.
#   sync-failed      git fetch / merge --ff-only failed on `main` and the repair
#                    attempt-cap is not yet hit; lock released, reseed armed.
#                    dispatch-tick reads this to spawn the deduped repair job.
#   sync-repair-pending   a session is genuinely holding the main worktree —
#                    actively working there, or sitting there for less than
#                    DISPATCH_MAIN_CHECKOUT_STUCK_GRACE_S (default 1800s) —
#                    so the tick defers. BOUNDED: past that grace the tick
#                    stops deferring and falls through to the fetch/merge
#                    probe (see Decision A). lock released; reseed armed.
#   sync-broken      local main cannot ff-merge origin/main and the repair
#                    attempt-cap is hit (or the latch is already open); the
#                    repo-health durable record is the latch. lock released;
#                    reseed armed; nothing spawned.
#   concurrency-cap  effective-live count (busy workers + outstanding reservations) >= target,
#                    AND no main-broken item waits to bypass it (or the rate-limit
#                    window is genuinely exhausted); #725 re-seed scheduled; lock released.
#   graph <count> <id:kind:phase>...   the graph selector picked <count> nodes
#                    (tactic-graph-router-selector). Each node is already
#                    reserved in the ledger under its NODE ID (the durable
#                    claim), so the lock is RELEASED — the execute path
#                    (dispatch-graph-execute, via dispatch-tick) runs lock-free.
#   main-broken <sha>   origin/main is red; lock RELEASED (spawned as a bg job,
#                    which runs lock-free).
#   jit-reminder <repo> <num> <project> <item-id>   a JIT reminder is due; lock
#                    RELEASED (spawned as a bg job, which runs lock-free).
#   empty            nothing eligible; lock released.
#
# <gap> = max(1, TARGET_N − LIVE_COUNT) is the run-scoped spawn budget the graph
# fan-out consumes (always >= 1 on a target line). On the autonomous queue
# path LIVE_COUNT is the effective-live count,
# effective_live = busy_workers + outstanding_reservations — a reservation counts
# against the budget the instant it is written, with no wait for worker
# registration — and the tick sweeps stranded reservations before counting.
# A `--manual` run (the bare human-typed `/dispatch` shim) also reconciles the
# ledger before counting, then QUERIES the live-count and computes a
# context-dependent SPAWN_N = max(1, min(max(N_PRIO, GAP, 1), HEADROOM));
# it overrides the pace-curve throttle and, per human-dispatch-is-sovereign, always
# launches its one highest-ranking-available node even at the MAX_WORKERS ceiling
# (a bounded, deliberate max_concurrent_workers + 1 overage) — only the `--exhausted`
# floor (genuine rate-limit token exhaustion) still blocks it outright
# (SPAWN_N=0 → emits `concurrency-cap`), and emits <gap> = SPAWN_N.
# The autonomous no-arg queue path keeps the full gate, but with a pace-exempt
# bypass at cap (see the gate narrative below): a graph pace_exempt node, or a
# newly-red main, is still surfaced even at/over the worker budget. The only hard
# floor is genuine token exhaustion.
#
# The routing-decision log records BOTH bounds per run: `target_n` (the pace-curve
# target) and `max_workers` (the absolute max_concurrent_workers ceiling). Two
# fields, because one alone is ambiguous — a low target_n means nothing on its own
# until you can see whether the ceiling was also throttled. `max_workers` carries
# the resolved ceiling on every lane that consults it (the autonomous no-arg lane,
# which resolves it once up front, and `--manual`), and `null` on the lanes that
# deliberately do not: the explicit NODE_ARG single-node lane, which skips both the
# pace curve and the ceiling by design, and the early exits (busy, usage-error,
# sync-*) that return before either bound is read.
#
# Lock invariant: RELEASE the lock on every decision except busy (where nothing
# was acquired). Every terminal path — graph/empty/sync-failed/
# sync-repair-pending/sync-broken/concurrency-cap/main-broken/jit-reminder —
# releases before it emits; nothing holds the lock past select-tick. The graph
# release is safe because the per-node reservation markers (written before the
# emit) are the durable claim a concurrent tick's graph selector already skips on.
#
# Env: DISPATCH_MAIN_CHECKOUT_STUCK_GRACE_S (default 1800) — how long a
# non-working session may sit in the shared main checkout before Decision A
# stops deferring to it. 1800s is 2x DISPATCH_FROZEN_SESSION_GRACE_S's 900
# (lib-frozen-session-park.sh): a legitimate /commit-merge-push run in the main
# checkout can idle on a slow push or a CI wait, and the cost of waiting an
# extra 30 minutes is far below the cost of a spurious `sync-broken` latch.
#
# Requires `dangerouslyDisableSandbox: true` — sub-scripts write tmp state, call
# `gh`, and query the local Claude daemon over a Unix socket. The `--wait` lock
# acquisition needs an elevated Bash `timeout` (see SKILL.md Step 0).
# See .claude/rules/sandbox.md.
#
# Exit code: 0 on every decision line; 2 on an internal/usage error surfaced on
# stderr (e.g. non-numeric TARGET_N from dispatch-target-workers, or a positional
# arg — explicit targeting was removed with the legacy lane).
#
# NOT set -e: exits are handled explicitly (matching the sibling dispatch
# scripts).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Decision-log instrumentation (write-only, non-fatal; #2038) -------------
# Append EXACTLY ONE structured routing-decision record per run, via an EXIT
# trap. This is set up FIRST — before the arg-parse usage exits and before the
# `busy` early exit at Step 0 — so the trap fires on EVERY exit path, giving one
# record per run. It MUST NOT change the script's exit code, so it never calls
# `exit`. decision_log_append is write-only and ALWAYS returns 0 (see
# lib-decision-log.sh) — the log is a best-effort observability sink, so a
# failed source / missing tool degrades to a no-op rather than a hard error.
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-decision-log.sh" 2>/dev/null || true

# Accumulators, initialized to safe defaults before the trap is registered so an
# early exit (under `set -u`) never references an unset var. Each terminal site
# sets DLOG_DISPOSITION (and target/phase/skip_reason where meaningful) just
# before its echo/exit. The budget vars GAP / TARGET_N / LIVE_COUNT are declared
# later (Step 1b); the emitter reads them defensively as ${VAR:-}.
DLOG_DISPOSITION=""
DLOG_TARGET="none"
DLOG_PHASE=""
DLOG_SKIP_REASON=""

# _dlog_select_emit — build the JSON record and hand it to decision_log_append.
# Stdout-silent: the stdout tokens are load-bearing for dispatch-tick's `case`,
# so nothing here may leak to fd 1 (jq output is captured into a var; jq stderr
# is swallowed). Numeric budget fields may be empty on an early exit, so they are
# passed as strings and coerced in-filter (empty → JSON null) so jq never fails.
# `max_workers` carries the resolved `max_concurrent_workers` ceiling on every
# lane that consults it (the autonomous no-arg lane and `--manual`), and null on
# lanes that deliberately do not (the explicit NODE_ARG lane, and every early
# exit before the ceiling is read). It is what distinguishes a low `target_n`
# produced by the normal pace curve from one produced by a throttled ceiling.
_dlog_select_emit() {
  local json
  json=$(jq -c -n \
    --arg ts          "$(date -u +%FT%TZ)" \
    --arg site        "select-tick" \
    --arg target      "$DLOG_TARGET" \
    --arg phase       "$DLOG_PHASE" \
    --arg disposition "$DLOG_DISPOSITION" \
    --arg skip_reason "$DLOG_SKIP_REASON" \
    --arg target_n    "${TARGET_N:-}" \
    --arg max_workers "${MAX_WORKERS:-}" \
    --arg eff_live    "${LIVE_COUNT:-}" \
    --arg gap         "${GAP:-}" \
    '
    def num: if . == "" then null else (tonumber? // null) end;
    {
      ts:            $ts,
      site:          $site,
      target:        $target,
      phase:         $phase,
      disposition:   $disposition,
      skip_reason:   $skip_reason,
      target_n:      ($target_n | num),
      max_workers:   ($max_workers | num),
      effective_live: ($eff_live | num),
      gap:           ($gap | num)
    }' 2>/dev/null) || return 0
  command -v decision_log_append >/dev/null 2>&1 && decision_log_append "$json" || true
}

# Register the emit trap NOW, before the first terminal exit. The later
# DISPATCH_CI_VERDICT_CACHE cleanup trap (Step 0) re-registers a COMBINED
# handler rather than clobbering this one (`trap ... EXIT` replaces, not stacks).
trap '_dlog_select_emit' EXIT

MANUAL=""
NODE_ARG=""
for a in "$@"; do
  case "$a" in
    --manual) MANUAL=1 ;;
    --*) DLOG_DISPOSITION="usage-error"; DLOG_SKIP_REASON="unknown-flag"; echo "dispatch-select-tick: unknown flag '$a'" >&2; exit 2 ;;
    *)
      # Explicit issue/PR targeting (`dispatch <N>`) was the legacy issue lane's
      # entry point; that lane is gone and the graph selector owns target
      # selection. A positional arg shaped like a graph node id
      # (tactic-graph-explicit-node-dispatch Unit 2) is the new explicit
      # single-node targeting entry point — recognize it here, before the lock
      # is acquired or any mutating side-effect step runs. The regex is
      # provision-node-worktree's node-id slug shape, reused verbatim.
      if [[ "$a" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
        NODE_ARG="$a"
      else
        DLOG_DISPOSITION="usage-error"; DLOG_SKIP_REASON="explicit-targeting-removed"
        echo "dispatch-select-tick: explicit issue/PR targeting ('${a#\#}') was removed with the legacy issue lane; the graph selector owns target selection" >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -n "${NODE_ARG:-}" && -n "$MANUAL" ]]; then
  DLOG_DISPOSITION="usage-error"; DLOG_SKIP_REASON="node-arg-with-manual"
  echo "dispatch-select-tick: a node-id argument cannot be combined with --manual" >&2
  exit 2
fi

release_lock() {
  "$SCRIPT_DIR/dispatch-acquire-lock" --release >/dev/null 2>&1 || true
}

# refresh_lock — bump the lock-file mtime (the heartbeat) so a legitimately-long
# hold never goes stale and is never falsely reclaimed by the staleness cap
# (#2104). INVARIANT #2: call ONLY on a sub-step's completion, never inside a
# retry/poll/wait loop — a refresh inside a loop would keep mtime fresh while a
# holder spins there, defeating the cap. Best-effort: a noop (we no longer hold
# the lock) or any error is swallowed.
refresh_lock() {
  "$SCRIPT_DIR/dispatch-acquire-lock" --heartbeat >/dev/null 2>&1 || true
}

# --- Graph-lane decision emitter (tactic-graph-router-selector) ---------------
# Consumes `node <id> <kind> <phase>` lines from graph-select-target on stdin.
# For each node it writes one reservation-ledger marker under the NODE ID
# (uniform claiming, strategy clarification 13 — one claimed set and one
# ledger span both keyspaces: node ids beside issue numbers; a strategy id in
# the ledger keeps its strategy unselectable while its /align-tactics session
# is in flight). It then RELEASES the selection lock — the markers are the
# durable claim; the execute path (dispatch-graph-execute) runs lock-free —
# and emits the single `graph <count> <id:kind:phase>...` decision line.
# Callers must have sourced lib-reservation-ledger.sh. Every call site is on a
# path that does: the autonomous block (Step 1), the `--manual` block, and the
# explicit-node block all source it before Step 3a's shared call. (Before
# tactic-explicit-node-reservation-sweep-policy the explicit-node lane did NOT
# source it, so reservation_write here was an undefined command whose exit 127
# the `||` swallowed — explicit dispatch silently wrote no marker at all.)
#
# Optional $1 = the claim ORIGIN token passed through to reservation_write.
# Step 3a passes `explicit` on the explicit single-node lane so the sweep's
# rule (c-ttl) can TTL-reclaim the marker: that lane is typically run from
# inside a long-lived interactive session, and dispatch-graph-execute has
# deliberate paths that leave the reservation for the sweep — without an origin
# no sweep rule could ever reclaim it (rule (a) needs a live worker of that
# name, rule (c) needs the reserving session dead), so each failed explicit
# dispatch would permanently add 1 to LIVE_COUNT. Omitted (empty) on the
# autonomous and manual lanes, whose claims are consumed by the same tick's
# fan-out: a claim that reaches a successful spawn is re-stamped
# `origin=spawned` by dispatch-graph-execute and covered by the sweep's
# handoff rule (released once the worker registers as live, or via the
# bounded handoff TTL if it never does); the old rule (c) (dead-session
# reclamation) now only reclaims claims that never reached a spawn.
#   return 0 — decision line emitted; the caller exits 0.
#   return 1 — stdin held no node lines; the caller falls through to the
#              legacy selector.
emit_graph_selection() {
  local origin="${1:-}"
  local specs=() ids=() id kind phase line
  while IFS= read -r line; do
    case "$line" in
      node\ *)
        read -r _ id kind phase <<<"$line"
        [[ -n "$id" && -n "$kind" && -n "$phase" ]] || continue
        specs+=("$id:$kind:$phase")
        ids+=("$id")
        ;;
    esac
  done
  (( ${#specs[@]} > 0 )) || return 1
  for id in "${ids[@]}"; do
    # Mirror dispatch-materialize-spawn's posture: a failed ledger write is a
    # budget undercount, not a selection abort. `${origin:+"$origin"}` appends
    # the optional 4th arg only when an origin was supplied, so the 3-arg
    # autonomous/manual call is unchanged.
    reservation_write "$id" "$id" "${CLAUDE_CODE_SESSION_ID:-}" ${origin:+"$origin"} 1>&2 \
      || echo "dispatch-select-tick: reservation_write failed for $id; proceeding without a ledger entry (budget may undercount this slot)" >&2
  done
  release_lock
  DLOG_DISPOSITION="graph"
  DLOG_TARGET=$(IFS=,; printf '%s' "${ids[*]}")
  DLOG_PHASE="${specs[0]##*:}"
  echo "graph ${#specs[@]} ${specs[*]}"
  return 0
}

# --- Step 0: acquire the dispatch lock ---------------------------------------
# Let acquire-lock's stderr holder-diagnostic flow through on `busy`.
LOCK=$("$SCRIPT_DIR/dispatch-acquire-lock" --wait) || true
if [[ "$LOCK" == busy ]]; then
  DLOG_DISPOSITION="busy"
  echo "busy"
  exit 0
fi
if [[ "$LOCK" != acquired ]]; then
  DLOG_DISPOSITION="lock-error"
  echo "dispatch-select-tick: dispatch-acquire-lock returned unexpected '$LOCK'" >&2
  exit 2
fi

# Tick-scoped CI-verdict memoisation (#1601): one dir per tick, exported so the
# child chain (dispatch-select-target → dispatch-ci-ready/dispatch-phase) and
# dispatch-reconcile-ready all share a single REST check-runs fetch per SHA,
# instead of each re-fetching. Set BEFORE the BRANCH==main block: reconcile-ready
# and select-target both run on every tick regardless of branch.
if [[ -n "${CLAUDE_JOB_DIR:-}" ]]; then
  mkdir -p "$CLAUDE_JOB_DIR/tmp"
  DISPATCH_CI_VERDICT_CACHE=$(mktemp -d "$CLAUDE_JOB_DIR/tmp/ci-verdict.XXXXXX")
else
  DISPATCH_CI_VERDICT_CACHE=$(mktemp -d)
fi
export DISPATCH_CI_VERDICT_CACHE

# Tick-scoped `intentions/` enumeration memo, same shape as the CI-verdict cache
# above: one dir per tick, exported so the merge-and-reconcile band
# (graph-auto-merge, reconcile-graph-merged and the reconcile-graph.ts runs it
# spawns, reconcile-graph-review-stall) shares one strict parse of the store per
# distinct store state instead of re-parsing it in every process. Entries are
# content-addressed on the store's bytes (packages/intentionsutil/src/store-cache.ts),
# so a sweep that writes node files simply misses rather than serving stale nodes.
# Each entry is ~3 MB at the current graph size and a tick creates at most a
# handful — all removed by the trap below. Set BEFORE the BRANCH==main block for
# the same reason as its sibling: the reconcile band runs on every tick.
if [[ -n "${CLAUDE_JOB_DIR:-}" ]]; then
  mkdir -p "$CLAUDE_JOB_DIR/tmp"
  DISPATCH_GRAPH_NODE_CACHE=$(mktemp -d "$CLAUDE_JOB_DIR/tmp/graph-nodes.XXXXXX")
else
  DISPATCH_GRAPH_NODE_CACHE=$(mktemp -d)
fi
export DISPATCH_GRAPH_NODE_CACHE
# Re-register a COMBINED handler: the decision-log emit (registered early, above)
# plus BOTH of this tick's cache cleanups. `trap ... EXIT` REPLACES, so this must
# chain _dlog_select_emit explicitly or the real routing paths would emit no
# record, and it must keep the CI-verdict removal or that dir would leak.
trap '_dlog_select_emit; rm -rf "$DISPATCH_CI_VERDICT_CACHE" "$DISPATCH_GRAPH_NODE_CACHE"' EXIT

# --- Step 1: sync local main with origin/main (only on the main branch) -------
# The `--ff-only` merge is the precondition for all selection AND the recovery
# probe (#1495). On failure the tick auto-repairs: it arms a #725 reseed (so the
# chain keeps ticking) and emits `sync-failed`, which dispatch-tick reads to
# spawn a deduped /commit-merge-push bg job against the main worktree. A repair
# that hits an unresolvable conflict must not loop forever: after a bounded
# attempt cap it escalates to a find-or-create dispatch:sync-broken latch issue
# and stops respawning. A successful ff-merge ALWAYS resets the counter and
# closes any open latch, so a human who resolves the tree by hand auto-recovers.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [[ "$BRANCH" == "main" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib.sh"            # sync_repair_* + resolve_project_root
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-claude-agents.sh"   # claude_agents_list_sessions_in_cwd_all

  # Resolve the main worktree the same way dispatch-tick does: an explicit
  # DISPATCH_TICK_MAIN_WORKTREE override is authoritative and bypasses the git
  # lookup (tests rely on this); otherwise it is the project root itself — the
  # standard-layout primary checkout (was <project-root>/worktrees/main pre-de-bare).
  if [[ -n "${DISPATCH_TICK_MAIN_WORKTREE:-}" ]]; then
    MAIN_WORKTREE="$DISPATCH_TICK_MAIN_WORKTREE"
  else
    PROJECT_ROOT=$(resolve_project_root) \
      || { DLOG_DISPOSITION="internal-error"; DLOG_SKIP_REASON="resolve-project-root-failed"; echo "dispatch-select-tick: not in a git repo and DISPATCH_TICK_MAIN_WORKTREE is unset" >&2; exit 2; }
    MAIN_WORKTREE="$PROJECT_ROOT"   # de-bare: the project root IS the main checkout
  fi

  # Prevent-at-source guard: the main-sync below (`git merge --ff-only
  # origin/main`) can only fast-forward a checkout actually on `main`, and a
  # non-main primary checkout also breaks provision-node-worktree's project-root
  # resolution. If the primary checkout has drifted off `main` (the 2026-07-21
  # direct-to-main incident, PR #2925), fail loudly here rather than merging in
  # the wrong branch. Never auto-switch — that is a deliberate human/caller act.
  assert_primary_checkout_on_main "$MAIN_WORKTREE" || {
    DLOG_DISPOSITION="internal-error"
    DLOG_SKIP_REASON="primary-checkout-not-on-main"
    exit 2
  }

  # Decision A — defer while a session is genuinely holding the main worktree,
  # but BOUNDED, and fail OPEN on a daemon UNKNOWN (rc 1).
  #
  # WHY THIS IS NOT THE OLD NAME-AND-STATUS TEST. The former rule deferred
  # whenever a row named `sync-repair` had a status other than `stopped`. That
  # defer was UNBOUNDED in two independent ways, and a 3-day incident rode both:
  #   1. It read the ACTIVE view (claude_sessions_under), so a `stopped`/`done`
  #      session still sitting in the main checkout was INVISIBLE to it.
  #   2. A `blocked` session projects its coarse status as `idle`, never
  #      `stopped` — so `$3!="stopped"` read it as "still live" FOREVER.
  # Either way the tick emitted `sync-repair-pending` on every tick, never
  # reached the merge probe, and never bumped sync_repair_*, which made the
  # 3-attempt `sync-broken` escalation cap structurally unreachable.
  #
  # The rule now reads the REGISTERED view
  # (claude_agents_list_sessions_in_cwd_all, exact-cwd match, no keyspace
  # filter — a strict superset of the ACTIVE view, so a stopped/done holder is
  # visible) and defers only while a session is genuinely holding the tree:
  #   - state `working` (or coarse status `busy`) → actively mutating: defer.
  #   - otherwise, transcript idle age below the grace → still plausibly alive:
  #     defer. An UNMEASURABLE idle (rc 1: no transcript, or the helper failed
  #     to load) folds to DEFER — fail-safe, per _standdown_session_idle_s's
  #     documented "caller must keep" contract.
  #   - beyond the grace → STOP DEFERRING. Fall through to the fetch/merge
  #     probe below, unchanged.
  #
  # WHY FALLING THROUGH IS THE CORRECT ESCALATION, NOT A HAZARD:
  #   - `git merge --ff-only` on a dirty tree FAILS; it corrupts nothing.
  #   - A failed merge bumps sync_repair_bump_attempts (the existing failure
  #     branch below) and emits `sync-failed`.
  #   - dispatch-tick reads `sync-failed` and calls `dispatch-spawn-job --name
  #     sync-repair`, whose dedup sees the existing live `sync-repair` name and
  #     returns `deduped` — no duplicate repair session is spawned.
  #   - After 3 such ticks the existing attempt cap below fires: `repo-health
  #     --set-sync-broken --reason merge-failed` latches durably and the tick
  #     emits `sync-broken`. That is the escalation the old rule could never
  #     reach, and reaching it is the whole point of this bound.
  # This decides only whether the TICK WAITS on the session. It never reaps,
  # kills or parks it — `state: done` is the discriminator for REAPING, not for
  # HEALTH, and the stuck session's own disposition belongs to the sweeps.
  #
  # FAIL OPEN on rc 1 (daemon unqueryable): fall through to the merge, matching
  # the concurrency gate's fail-open philosophy — dispatch-spawn-job's own dedup
  # fails CLOSED on UNKNOWN, so no duplicate repair is spawned, and git's
  # index.lock contains the rare race.
  MAIN_STUCK_GRACE_S="${DISPATCH_MAIN_CHECKOUT_STUCK_GRACE_S:-1800}"
  [[ "$MAIN_STUCK_GRACE_S" =~ ^[0-9]+$ ]] || MAIN_STUCK_GRACE_S=1800
  # Guarded source, dispatch-tick's idiom: source only when the function is
  # absent, verify it arrived, and on failure degrade loudly (here: to the
  # fail-safe defer) rather than aborting the script.
  if ! declare -f _standdown_session_idle_s >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-standdown-recheck.sh" 2>/dev/null
  fi
  MAIN_NOW=$(date +%s)
  if MAIN_SESSIONS=$(claude_agents_list_sessions_in_cwd_all "$MAIN_WORKTREE"); then
    MAIN_DEFER_REASON=""
    MAIN_STUCK_ATTR=""
    while IFS=$'\t' read -r M_SID M_JOBID M_NAME M_STATE M_STATUS; do
      [[ -n "${M_SID}${M_NAME}${M_STATE}" ]] || continue
      # `state` is the granular field the registered listing carries; `status`
      # is the coarse busy/idle/stopped sibling. Either saying "working"/"busy"
      # means the session is legitimately mutating the tree — wait for it.
      if [[ "$M_STATE" == "working" || "$M_STATUS" == "busy" ]]; then
        MAIN_DEFER_REASON="main-checkout-active:${M_NAME:-<unnamed>}:${M_STATE:-<state?>}"
        break
      fi
      if ! declare -f _standdown_session_idle_s >/dev/null 2>&1; then
        echo "dispatch-select-tick: lib-standdown-recheck.sh failed to load; idle age of the session in the main checkout is unmeasurable — deferring (fail-safe)" >&2
        MAIN_DEFER_REASON="main-checkout-idle-unmeasurable:${M_NAME:-<unnamed>}:${M_STATE:-<state?>}"
        break
      fi
      if ! M_IDLE=$(_standdown_session_idle_s "$M_SID" "$MAIN_NOW" 2>/dev/null) \
         || [[ ! "$M_IDLE" =~ ^-?[0-9]+$ ]]; then
        # UNKNOWN idle (no transcript / unreadable mtime): the helper's
        # contract is "caller must keep". Defer.
        MAIN_DEFER_REASON="main-checkout-idle-unknown:${M_NAME:-<unnamed>}:${M_STATE:-<state?>}"
        break
      fi
      # Grace, following lib-frozen-session-park.sh:495-529 exactly, INCLUDING
      # its deliberate treatment of a negative (future-stamped) idle as
      # `< grace`: observe, never act.
      if (( M_IDLE < MAIN_STUCK_GRACE_S )); then
        MAIN_DEFER_REASON="main-checkout-within-grace:${M_NAME:-<unnamed>}:${M_STATE:-<state?>}"
        break
      fi
      # Beyond the grace: record the attribution and DO NOT defer for this row.
      MAIN_STUCK_ATTR="${MAIN_STUCK_ATTR:+$MAIN_STUCK_ATTR,}${M_NAME:-<unnamed>}:${M_STATE:-<state?>}"
      # stderr names the sessionId deliberately: the graph-node body the
      # main-checkout-held alarm writes omits it (it is a reading, not an
      # identity), so this line is where a debugger recovers it.
      echo "dispatch-select-tick: ${M_NAME:-<unnamed>} (session ${M_SID:-<sid?>}, job ${M_JOBID:-<id?>}, state ${M_STATE:-<state?>}/${M_STATUS:-<status?>}) has sat in the main checkout $MAIN_WORKTREE for ${M_IDLE}s >= grace ${MAIN_STUCK_GRACE_S}s; declining to defer and falling through to the fetch/merge probe" >&2
    done <<<"$MAIN_SESSIONS"
    if [[ -n "$MAIN_DEFER_REASON" ]]; then
      release_lock
      "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
      DLOG_DISPOSITION="sync-repair-pending"
      DLOG_SKIP_REASON="$MAIN_DEFER_REASON"
      echo "sync-repair-pending"
      exit 0
    fi
    # Attribute the DECLINED defer in the routing decision log, so the record
    # says WHICH session the tick stopped waiting on and in what state.
    if [[ -n "$MAIN_STUCK_ATTR" ]]; then
      DLOG_SKIP_REASON="main-checkout-stuck:$MAIN_STUCK_ATTR"
    fi
  fi

  # Fetch and merge probe. Fetch and merge are run separately (#1546) so a fetch
  # failure is distinguished from a merge divergence — both are captured to temps
  # and replayed to the journal so nothing is swallowed.
  if [[ -n "${CLAUDE_JOB_DIR:-}" ]]; then
    mkdir -p "$CLAUDE_JOB_DIR/tmp"
    FETCH_TMP=$(mktemp "$CLAUDE_JOB_DIR/tmp/sync-fetch.XXXXXX")
    SYNC_TMP=$(mktemp "$CLAUDE_JOB_DIR/tmp/sync-merge.XXXXXX")
  else
    FETCH_TMP=$(mktemp)
    SYNC_TMP=$(mktemp)
  fi
  fetch_ok=0; merge_ok=0
  if git fetch origin main 2>"$FETCH_TMP" 1>&2; then
    fetch_ok=1
    if git merge --ff-only origin/main 2>"$SYNC_TMP" 1>&2; then
      merge_ok=1
    fi
  fi
  cat "$FETCH_TMP" >&2
  cat "$SYNC_TMP" >&2
  FETCH_STDERR=$(cat "$FETCH_TMP")
  MERGE_STDERR=$(cat "$SYNC_TMP")
  rm -f "$FETCH_TMP" "$SYNC_TMP"

  if [[ "$merge_ok" == 1 ]]; then
    # SUCCESS — local main ff-merges clean. ALWAYS reset the attempt counter and
    # clear the sync-broken latch (Decision B: a clean probe means a human
    # resolved the tree, so the chain auto-recovers). The LATCH STATE now lives in
    # the repo-health sensor's durable label-free record — clear it there. The
    # gh-labeled dispatch:sync-broken issue stays as the human-visibility
    # announcement, so it is still closed here (kept in sync with the durable
    # clear). Then fall through to Step 1c — do NOT exit.
    sync_repair_reset_attempts
    "$SCRIPT_DIR/repo-health" --clear-sync-broken 1>&2 || true
    OPEN_SB=$(gh_issue_list_rest --state open --label "dispatch:sync-broken" | jq -r '.[].number')
    for n in $OPEN_SB; do
      gh_issue_close_rest "$n" \
        --comment "local main ff-merges clean again; closing the sync-broken latch" 1>&2 || true
    done
  else
    # FAILURE — local main is dirty or diverged. The latch is checked only AFTER
    # a failed merge (Decision B); the probe itself is never suppressed. The
    # "already latched?" state is read from the repo-health sensor's durable
    # label-free record (no gh, no dispatch:sync-broken label query) — the latch
    # state has moved off the legacy label surface.
    if [[ "$("$SCRIPT_DIR/repo-health" --sync-broken-latched)" == "latched" ]]; then
      # a. Already latched — a human owns the tree. Spawn nothing.
      release_lock
      "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
      DLOG_DISPOSITION="sync-broken"
      DLOG_SKIP_REASON="latched"
      echo "sync-broken"
      exit 0
    fi
    N=$(sync_repair_read_attempts)
    if [[ "$N" -ge 3 ]]; then
      # b. Attempt cap hit — set the durable label-free latch (repo-health) AND
      # file the find-or-create human-visibility issue (dispatch-escalate-sync-broken),
      # then stop respawning. The durable latch is the state the "already latched?"
      # read above consults; the labeled issue is the announcement kept in sync
      # with it. The escalate script reads the captured merge stderr on stdin.
      # This branch is terminal; it does NOT bump the counter.
      if [[ "$fetch_ok" == 0 ]]; then
        "$SCRIPT_DIR/repo-health" --set-sync-broken --reason fetch-failed 1>&2 || true
        "$SCRIPT_DIR/dispatch-escalate-sync-broken" --reason fetch-failed <<<"$FETCH_STDERR" 1>&2 || true
      else
        "$SCRIPT_DIR/repo-health" --set-sync-broken --reason merge-failed 1>&2 || true
        "$SCRIPT_DIR/dispatch-escalate-sync-broken" --reason merge-failed <<<"$MERGE_STDERR" 1>&2 || true
      fi
      release_lock
      "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
      DLOG_DISPOSITION="sync-broken"
      DLOG_SKIP_REASON="attempt-cap"
      echo "sync-broken"
      exit 0
    fi
    # c. Under the cap — bump the counter and let dispatch-tick spawn the repair.
    sync_repair_bump_attempts
    release_lock
    "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
    DLOG_DISPOSITION="sync-failed"
    echo "sync-failed"
    exit 0
  fi
fi

# Heartbeat: the origin/main sync (Step 1) is the first held best-effort sub-step.
# Refresh on its completion — unconditionally, outside the main-only block, so a
# non-main worktree or manual /dispatch tick refreshes too (#2104, invariant #2).
refresh_lock

# --- Step 1c: sync the main-red graph latch (tactic-graph-main-self-heal) ----
# The open-node read + green-main recovery-completion now live in their own
# script, dispatch-graph-main-red-sync (extracted from this file's former
# inline block so it is independently fakeable by the test harness, matching
# the repo-health / graph-select-target script-per-concern convention — see
# that script's header for the full contract: the open tactic-main-red-*
# read, the phase:"done" completion on green, and the stdout protocol). This
# runs every tick — independent of the local branch — including a capped
# tick, so recovery is observed even when no worker is spawned. A failed
# invocation (non-zero exit) is folded into UNKNOWN here too, so a transient
# failure of the sub-script never masquerades as "main healthy".
OPEN_MAIN_RED=$("$SCRIPT_DIR/dispatch-graph-main-red-sync") || OPEN_MAIN_RED=UNKNOWN

# --- Step 1d: reconcile router-owned PR readiness (best-effort) -------------
RECONCILE_OUT=$("$SCRIPT_DIR/dispatch-reconcile-ready") || true
if [[ -n "$RECONCILE_OUT" ]]; then
  while IFS= read -r ready_line; do
    [[ -n "$ready_line" ]] && echo "ready: $ready_line"
  done <<< "$RECONCILE_OUT"
fi

# --- Step 1d (cont.): auto-merge every ready PR (#1739) ----------------------
# Runs after dispatch-reconcile-ready (a PR demoted this tick is seen as draft
# and skipped). Auto-merge runs ONLY when
# OPEN_MAIN_RED is definitively empty — i.e. main health is known-good. It is
# suppressed both while main is broken (OPEN_MAIN_RED lists open tactic-main-red-*
# nodes, from Step 1c) and when main health is UNKNOWN (the Step 1c graph read
# failed): a transient read failure must not defeat this load-bearing safety gate.
# Auto-merge is ON by default; dispatch.config/auto-merge.json is an opt-OUT
# kill-switch (enabled:false suppresses it).
if [[ -z "$OPEN_MAIN_RED" ]]; then
  MERGE_OUT=$("$SCRIPT_DIR/dispatch-auto-merge") || true
  if [[ -n "$MERGE_OUT" ]]; then
    while IFS= read -r merge_line; do
      [[ -n "$merge_line" ]] && echo "merge: $merge_line"
    done <<< "$MERGE_OUT"
  fi
fi

# --- Step 1d (cont.): node-lane auto-merge (tick-owned) ----------------------
# Graph-lane analog of the issue-lane auto-merge block above. graph-auto-merge
# merges reviewed node-lane PRs this tick, keyed off each node's `reviewed`
# execution marker. reconcile-graph-merged (below, which runs unconditionally
# and already honors a grace window via its GRACE/AGE check) absorbs the merge
# to done/main-qa on a subsequent tick, so it never races a still-settling merge
# from this tick.
#
# NOT gated on $OPEN_MAIN_RED here: graph-auto-merge now performs the
# main-health admission gate ITSELF, via its own
# `dispatch-graph-main-red-sync --read-only` read
# (tactic-graph-auto-merge-main-health-gate). The gate moved INTO the script so
# a single-node caller — /dispatch-ladder — reuses it rather than
# re-implementing it; a caller-side copy here would be a second, drifting
# implementation of a load-bearing safety gate. The issue-lane block above keeps
# its `$OPEN_MAIN_RED` wrapper: dispatch-auto-merge has no such internal gate.
#
# One semantic consequence, deliberate and documented in graph-auto-merge's
# header: the script re-reads the latch LATER than Step 1c did, so a latch this
# very tick completed permits a merge in this tick rather than the next. Step 1c
# still runs unflagged and still owns the completion; $OPEN_MAIN_RED is still
# consumed by the issue-lane merge (:486) and the main-broken diagnosis gates
# (:821, :1148).
GRAPH_MERGE_OUT=$("$SCRIPT_DIR/graph-auto-merge") || true
if [[ -n "$GRAPH_MERGE_OUT" ]]; then
  while IFS= read -r merge_line; do
    [[ -n "$merge_line" ]] && echo "merge: $merge_line"
  done <<< "$GRAPH_MERGE_OUT"
fi

# --- Step 1d (cont.): post-merge reconciliation (#2512) ----------------------
# Closes any issue GitHub's merge-time auto-close silently left OPEN (see #2481).
# Runs unconditionally (NOT gated on $OPEN_MAIN_RED): it merges nothing, only repairs
# already-merged work's closing issues, so it is safe during a main-broken
# episode. Best-effort: a failure here must not abort the tick.
RECONCILE_MERGED_OUT=$("$SCRIPT_DIR/dispatch-reconcile-merged") || true
if [[ -n "$RECONCILE_MERGED_OUT" ]]; then
  while IFS= read -r recon_line; do
    [[ -n "$recon_line" ]] && echo "reconcile-merged: $recon_line"
  done <<< "$RECONCILE_MERGED_OUT"
fi

# Graph-lane analog: absorb out-of-band PR events for open graph-native tactics
# into graph state (tactic-graph-census-recurrence Unit 1). Without this the
# graph-native reconciler reconcile-graph-merged has no call-site, so a merged
# graph-native node is never moved to done and the selector re-selects it every
# tick as a stale review target. Runs unconditionally like its issue-lane
# sibling above (it only absorbs already-merged work, safe during a main-broken
# episode) and best-effort (a reconcile error must not abort the tick). This
# whole script runs with the sandbox disabled (see the header note), so
# reconcile-graph-merged's gh (TLS) + node --import tsx/esm (npm cache) needs
# are covered without an extra wrapper.
RECONCILE_GRAPH_OUT=$("$SCRIPT_DIR/reconcile-graph-merged") || true
if [[ -n "$RECONCILE_GRAPH_OUT" ]]; then
  while IFS= read -r graph_line; do
    [[ -n "$graph_line" ]] && echo "reconcile-graph: $graph_line"
  done <<< "$RECONCILE_GRAPH_OUT"
fi

# Review-stall recovery sweep (tactic-graph-review-exclusion-stall-recovery
# Unit 2). Runs unconditionally and best-effort right after reconcile-graph-
# merged absorbs what it can: it only acts on a still-OPEN PR (never races the
# merged/closed case reconcile-graph-merged owns) and only enters a fix
# interrupt on a regressed node (a strictly additive, reversible write —
# apply-fix-state --clear-fix resolves it later), so it is safe during a
# main-broken episode. This whole script already runs with the sandbox
# disabled (see the header note), covering the new script's gh (TLS) + node
# --import tsx/esm (npm cache) needs — no new sandbox wiring required.
REVIEW_STALL_OUT=$("$SCRIPT_DIR/reconcile-graph-review-stall") || true
if [[ -n "$REVIEW_STALL_OUT" ]]; then
  while IFS= read -r stall_line; do
    [[ -n "$stall_line" ]] && echo "review-stall: $stall_line"
  done <<< "$REVIEW_STALL_OUT"
fi

# Standing per-tick reconciliation-debt duty (tactic-graph-census-recurrence
# Unit 2). Runs right after the same-tick reconciler above absorbs what it can,
# so what remains is the persistent owed-prune / orphan debt a census must
# drain. Graph-only (no network — the per-tick duty is near-free), best-effort
# (a failure must not abort the tick). When accumulated debt crosses the
# configured threshold and no census node is already open, it births exactly one
# born-parked census tactic naming the batch and lands it via graph-commit; the
# born-parked node is the recurrence latch, so it births at most one at a time.
CENSUS_OUT=$("$SCRIPT_DIR/dispatch-graph-census") || true
if [[ -n "$CENSUS_OUT" ]]; then
  while IFS= read -r census_line; do
    [[ -n "$census_line" ]] && echo "census: $census_line"
  done <<< "$CENSUS_OUT"
fi

# Pre-selection scope-staleness sweep (tactic-tick-scriptable-then-spawn). Runs
# before the concurrency gate and selection below, so a scope-stale tactic is
# demoted to `implement` as a scriptable non-worker disposition here in phase 1
# rather than at worker-launch time (dispatch-graph-execute's exit-13 case, still
# present as a post-sweep safety net). Moving the metadata-only demote out of the
# launch group means it never silently consumes a SPAWN_N launch slot. Runs after
# the reconcilers above absorb what they can, so only persistent scope drift
# remains. Best-effort (a failure must not abort the tick); this whole script
# runs with the sandbox disabled (see the header note), covering the sweep's
# claude_agents_list_all daemon socket + demote-node-to-implement graph-commit.
SCOPE_SWEEP_OUT=$("$SCRIPT_DIR/dispatch-graph-scope-sweep") || true
if [[ -n "$SCOPE_SWEEP_OUT" ]]; then
  while IFS= read -r sweep_line; do
    [[ -n "$sweep_line" ]] && echo "scope-sweep: $sweep_line"
  done <<< "$SCOPE_SWEEP_OUT"
fi

# Pre-selection invalid-state sweep (tactic-invalid-state-lane Unit 4). The
# lane's selection-time detection arm: finds nodes held by a TERMINAL worker
# session — an INVALID state, where nothing is running yet the claim survives —
# and routes each through dispatch-invalid-state-route. It never parks, holds or
# reaps; the two defensive sweeps in dispatch-tick own the escalation, so this
# arm defers to them rather than adding a second park implementation. Its
# claimed set matches graph-select-target's exactly, so it cannot act on a node
# selection considers claimed. Best-effort (a failure must not abort the tick);
# this whole script runs with the sandbox disabled (see the header note), which
# covers the sweep's daemon socket read and the router's session spawn.
#
# BOUNDED. This runs INLINE on the scheduling path, between the heartbeat above
# and the `refresh_lock` below, and it calls the invalid-state router (up to its
# own per-invocation cap) — whose git reads, latch mint and graph landing push
# are not self-bounding. Left unbounded, one contended graph landing lock (any
# concurrent graph writer induces one) would hold this tick past its heartbeat
# window, let another tick steal the lock, and stall the fleet. The sweep bounds
# each router call itself; this is the outer bound on the whole sweep, and it
# takes the same posture `invalid_state_route_gate` takes for its router call
# (lib-frozen-session-park.sh): a missing `timeout` is a loud SKIP of the sweep,
# never a silent unbounded call (.claude/rules/code-style.md). The default budget
# covers the sweep's whole per-invocation router budget (cap 2 x the 60s per-call
# timeout) plus slack.
INVALID_STATE_TIMEOUT_BIN=$(command -v timeout 2>/dev/null) || INVALID_STATE_TIMEOUT_BIN=""
INVALID_STATE_SWEEP_BUDGET="${DISPATCH_INVALID_STATE_SWEEP_TIMEOUT_S:-180}"
[[ "$INVALID_STATE_SWEEP_BUDGET" =~ ^[0-9]+$ ]] || INVALID_STATE_SWEEP_BUDGET=180
if [[ -z "$INVALID_STATE_TIMEOUT_BIN" ]]; then
  echo "invalid-state: timeout not found; refusing to run an unbounded invalid-state sweep on the tick path; sweeping nothing"
else
  INVALID_STATE_SWEEP_RC=0
  INVALID_STATE_SWEEP_OUT=$("$INVALID_STATE_TIMEOUT_BIN" "$INVALID_STATE_SWEEP_BUDGET" \
    "$SCRIPT_DIR/dispatch-invalid-state-sweep" </dev/null) || INVALID_STATE_SWEEP_RC=$?
  if [[ -n "$INVALID_STATE_SWEEP_OUT" ]]; then
    while IFS= read -r sweep_line; do
      [[ -n "$sweep_line" ]] && echo "invalid-state: $sweep_line"
    done <<< "$INVALID_STATE_SWEEP_OUT"
  fi
  # 124 is `timeout`'s own code. Never silent: a truncated sweep that reads as a
  # clean pass is the sensors-rule failure this lane exists to fix.
  if (( INVALID_STATE_SWEEP_RC == 124 )); then
    echo "invalid-state: sweep exceeded its ${INVALID_STATE_SWEEP_BUDGET}s budget and was cut short — remaining candidates deferred to the next tick (the lock heartbeat must not be starved)"
  fi
fi

# Heartbeat: refresh after the auto-merge and reconcile-merged sub-steps complete (#2104, #2512).
refresh_lock

# --- Step 1b: run-scoped concurrency gate (autonomous queue path only) -------
# Runs ONLY on the autonomous queue path. The `--manual` run (the bare
# human-typed `/dispatch` shim) DIVERGES here: it runs its OWN
# context-dependent fan-out computation (the `elif [[ -n "$MANUAL" ]]` branch
# below) instead of this gate — it queries the live-count, overrides the
# pace-curve throttle but honors the `--exhausted` floor and the MAX_WORKERS
# ceiling, and emits <gap> = SPAWN_N (or `concurrency-cap` when SPAWN_N=0).
# On the autonomous queue path the gate is evaluated ONCE per run. Before
# counting, the gate sweeps stranded reservations (reservation_sweep) so it
# reconciles the ledger first. LIVE_COUNT is then the effective-live count,
# effective_live = busy_workers + outstanding_reservations
# (claude_agents_count_busy_workers + reservation_count), not busy workers alone
# — a reservation counts against the budget the instant it is written, with no
# wait for worker registration. Under cap: GAP bounds how many workers a fan-out
# run may spawn, and normal selection (Step 3) already runs rank-first, so a
# high-rank item under budget is handled there. Daemon UNKNOWN (the busy-worker
# read fails; reservation_count never fails) → fail CLOSED: release the lock,
# schedule the reseed, and emit `concurrency-cap` (see the `else` branch below)
# rather than assume GAP=1. Before this fix (2026-07-21 incident), an
# uncorroborated empty `claude agents --json` read (sandboxed/blocked, exit 0,
# `[]`) was indistinguishable from a genuine "no live sessions" and fell
# through to GAP=1, letting a manual tick launch a duplicate `/implement`
# worker onto a worktree that already had a live session — dispatch-spawn-job's
# own per-worktree dedup consumes that same ambiguous read (see
# lib-claude-agents.sh's EMPTY-READ CORROBORATION section), so it was never an
# independent last-line defense.
#
# AT cap (LIVE_COUNT >= TARGET_N) the budget no longer hard-stops the run. The
# budget paces only NON-pace-exempt autonomous fan-out; pace-exempt/main-broken
# work bypasses it. There are three cases, evaluated in order:
#   1. `dispatch-target-workers --exhausted` reports `exhausted` (the 5-hour or
#      weekly window is genuinely ~100% used, reset still ahead) → HARD STOP for
#      everything: release the lock, schedule the #725 re-seed, emit
#      `concurrency-cap`. No probe, no spawn — launching workers with no tokens
#      is pure noise. This is distinct from "paced to 0 / at cap", which the
#      pace/ramp math can produce while tokens remain; --exhausted is computed
#      from telemetry independently of that math.
#   2. Otherwise resolve the absolute ceiling (`dispatch-target-workers --max`)
#      and compute PACE_GAP = max(0, MAX_WORKERS − LIVE_COUNT) — the genuine
#      headroom under max_concurrent_workers, which is absolute for autonomous
#      scheduling. PACE_GAP == 0 CLOSES the lane (never probed:
#      `at-cap-ceiling-full`); a non-numeric/unreadable ceiling also closes it
#      (`at-cap-ceiling-unreadable`) — fail CLOSED rather than admit an
#      unbounded bypass. Otherwise probe `graph-select-target
#      --pace-exempt-only --top PACE_GAP` (the authored `pace_exempt` flag is
#      the graph home of the legacy `priority` label): a hit HOLDS the lock and
#      fills the lane to the ceiling, up to PACE_GAP gate-exempt workers. They
#      are still counted by claude_agents_count_busy_workers on later ticks, so
#      they suppress non-pace-exempt fan-out: the flag bypasses the pace GATE,
#      not the COUNT.
#   3. Otherwise check `repo-health --main-broken-sha` (its own live CI probe;
#      a main that broke WHILE at cap is surfaced here even though no other
#      item is pace-exempt) → release the lock, echo `main-broken <sha>` (the
#      lock-free diagnose bg job spawns downstream).
#   4. Neither bypass fires (no pace-exempt item, main healthy) → the unchanged
#      hard cap: release the lock, schedule the #725 re-seed, emit
#      `concurrency-cap`. (The legacy `dispatch-select-target --priority-only`
#      probe this bypass used to run — including its `pr ...`/`issue ...`/
#      `waiting <N>` dispositions and the `dispatch-schedule-target-reseed`
#      CI-pending reseed — was deleted with the rest of the gh-issue lane in
#      tactic-dispatch-legacy-rewire Unit 3.)
GAP=1
if [[ -z "$MANUAL" && -z "$NODE_ARG" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-claude-agents.sh"
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-reservation-ledger.sh"
  TARGET_N=$("$SCRIPT_DIR/dispatch-target-workers")
  # Resolve the ABSOLUTE ceiling once, here at the top of the lane, so the
  # routing-decision log's `max_workers` field is populated on every exit from
  # this lane — including the internal-error exit just below. Deliberately
  # NON-FATAL and unguarded: an unreadable ceiling is not an error here. The one
  # place it is load-bearing (the at-cap pace-exempt sub-branch) does its own
  # numeric test and fails closed there. `--max` short-circuits inside
  # dispatch-target-workers before the rate-limit/telemetry load, so this costs
  # one cheap config read and writes no state.
  MAX_WORKERS=$("$SCRIPT_DIR/dispatch-target-workers" --max 2>/dev/null) || MAX_WORKERS=""
  if [[ ! "$TARGET_N" =~ ^[0-9]+$ ]]; then
    release_lock
    DLOG_DISPOSITION="internal-error"
    DLOG_SKIP_REASON="non-numeric-target"
    echo "dispatch-select-tick: dispatch-target-workers returned non-numeric target '$TARGET_N'" >&2
    exit 2
  fi
  # Reconcile the ledger before counting so the gate sees no stranded
  # reservations (sweep reclaim notes → stderr; best-effort).
  # reservation_sweep internally calls claude_agents_list_all, which reads
  # DISPATCH_AGENTS_SNAPSHOT (captured once by dispatch-tick before invoking
  # this script, #1452) when it is set — no live `claude agents --json` call.
  reservation_sweep 1>&2 || true
  # claude_agents_count_busy_workers also reads DISPATCH_AGENTS_SNAPSHOT (#1452),
  # so the gate issues zero live `claude agents --json` round-trips when the
  # snapshot is present. Both agent reads in this block are served from the same
  # per-tick snapshot.
  if BUSY=$(claude_agents_count_busy_workers); then
    RESV=$(reservation_count)
    LIVE_COUNT=$(( BUSY + RESV ))
    if (( LIVE_COUNT >= TARGET_N )); then
      echo "router: $LIVE_COUNT effective live ($BUSY busy + $RESV reserved) >= target $TARGET_N"
      # At the worker budget. The budget paces NON-pace-exempt autonomous
      # fan-out; pace-exempt/main-broken work bypasses it — but only up to the
      # absolute max_concurrent_workers ceiling, filling to PACE_GAP =
      # max(0, MAX_WORKERS − LIVE_COUNT) gate-exempt workers rather than the
      # single worker this lane used to admit. The only hard stop is
      # genuine token exhaustion: when the 5-hour or weekly window is actually
      # out of tokens (~100% used, reset still ahead), spawn nothing — including
      # the main-broken diagnose job. Distinguish "paced to 0 / at cap" (a
      # self-imposed throttle priority overrides) from "out of tokens" via the
      # telemetry-only --exhausted query.
      EXHAUSTED=$("$SCRIPT_DIR/dispatch-target-workers" --exhausted 2>/dev/null) || EXHAUSTED="ok"
      if [[ "$EXHAUSTED" == exhausted ]]; then
        release_lock
        "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
        DLOG_DISPOSITION="concurrency-cap"
        DLOG_SKIP_REASON="rate-limit-exhausted"
        echo "router: rate-limit window exhausted; no priority bypass"
        echo "concurrency-cap"
        exit 0
      fi
      # Not exhausted: apply the ABSOLUTE ceiling before probing. MAX_WORKERS was
      # already resolved once at the top of this lane (right after TARGET_N), so
      # it is simply consulted here. Exhaustion stays the hard floor and is
      # evaluated first (above); the ceiling is the second, independent bound.
      # The pace-exempt lane fills to
      #   PACE_GAP = max(0, MAX_WORKERS − LIVE_COUNT)
      # — genuine headroom under max_concurrent_workers, which is absolute for
      # autonomous scheduling (unlike the --manual branch, where a deliberate
      # human dispatch may take a bounded ceiling + 1 overage). PACE_GAP == 0
      # closes the lane: already at the ceiling, nothing to admit. A
      # non-numeric/unreadable ceiling ALSO closes the lane — fail CLOSED, since
      # the alternative is an unbounded bypass that compounds across ticks (the
      # gate re-evaluates every tick and keeps no memory of a prior bypass).
      # This deliberately diverges from graph-select-target's --standalone path,
      # which fails open to TOP=1; that is a different caller. Do NOT exit 2
      # here — that would also suppress the main-broken probe and the reseed
      # below, both of which must stay reachable when this lane is closed.
      PACE_LANE_CLOSED=""
      if [[ "$MAX_WORKERS" =~ ^[0-9]+$ ]]; then
        PACE_GAP=$(( MAX_WORKERS - LIVE_COUNT ))
        (( PACE_GAP < 0 )) && PACE_GAP=0
        (( PACE_GAP == 0 )) && PACE_LANE_CLOSED="at-cap-ceiling-full"
      else
        # Log-only (stderr), not a durable graph latch: this deliberately does
        # not write any operator-visible record beyond the routing-decision
        # log's `at-cap-ceiling-unreadable` skip_reason. Keeping this a bare
        # `echo` matters because the main-broken probe and reseed below this
        # at-cap block must stay reachable when the ceiling is unreadable —
        # anything heavier (a latch write, a retry) risks wedging that path.
        # Follow-up: tactic-config-unreadable-latch owns unifying this
        # config-read site with the other two in this script (:643 TARGET_N,
        # :814 the --manual branch's combined TARGET_N/MAX_WORKERS read) behind
        # one durable, operator-visible latch (the tactic-main-red-* shape).
        echo "dispatch-select-tick: dispatch-target-workers --max returned a non-numeric ceiling ('$MAX_WORKERS'); pace-exempt lane closed rather than admitting an unbounded bypass" >&2
        PACE_GAP=0
        PACE_LANE_CLOSED="at-cap-ceiling-unreadable"
      fi
      # Record the width this lane actually granted in the routing decision log
      # (the `gap` field), replacing the stale GAP=1 default set above.
      GAP=$PACE_GAP
      # Probe the graph pace-exempt lane (tactic-graph-router-selector; strategy
      # clarification 14 — the authored `pace_exempt` flag is the graph home of
      # the legacy priority label). The flag bypasses the pace GATE, not the
      # COUNT or the rank order: a bypassed worker is still counted by
      # claude_agents_count_busy_workers on later ticks, so it suppresses
      # non-pace-exempt fan-out from then on. The probe's own `--exhausted`
      # re-check inside graph-select-target is redundant here (checked above)
      # but keeps the lane self-contained for other callers.
      if (( PACE_GAP > 0 )); then
        GPRIO=$("$SCRIPT_DIR/graph-select-target" --pace-exempt-only --top "$PACE_GAP") \
          || { echo "dispatch-select-tick: graph-select-target --pace-exempt-only failed; falling through to the legacy priority probe" >&2; GPRIO="empty"; }
        if emit_graph_selection <<<"$GPRIO"; then
          DLOG_SKIP_REASON="pace-exempt-bypass-at-cap"
          exit 0
        fi
      fi
      # Graph pace-exempt lane empty or closed → the only surviving at-cap bypass is a
      # newly-red main: a red main outranks the pace budget and must still
      # spawn its diagnose job even at cap (the legacy priority-LABELED PR/issue
      # bypass and the CI-pending `waiting` reseed died with the legacy selector).
      # main-broken first-detection: probe repo-health only when no
      # tactic-main-red-* node is open yet (OPEN_MAIN_RED, Step 1c) — once
      # diagnose-main has written it, the latch stands down. repo-health
      # --main-broken-sha is the live CI probe and the durable label-free latch
      # writer in one (empty stdout / non-zero → green or UNKNOWN → no bypass).
      if [[ -z "$OPEN_MAIN_RED" ]] && MB_CAP=$("$SCRIPT_DIR/repo-health" --main-broken-sha) && [[ -n "$MB_CAP" ]]; then
        # Spawned as its own lock-free bg job — release the lock here.
        release_lock
        DLOG_DISPOSITION="main-broken"
        DLOG_TARGET="$MB_CAP"
        DLOG_SKIP_REASON="main-broken-bypass-at-cap"
        echo "main-broken $MB_CAP"
        exit 0
      fi
      # Nothing to bypass the cap → hard cap as before. The skip reason tells
      # the three closed-lane cases apart: `at-cap-no-priority` (lane probed,
      # nothing pace-exempt selectable), `at-cap-ceiling-full` (lane never
      # probed — already at max_concurrent_workers), and
      # `at-cap-ceiling-unreadable` (lane never probed — ceiling unreadable, so
      # the lane failed closed).
      release_lock
      "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
      DLOG_DISPOSITION="concurrency-cap"
      DLOG_SKIP_REASON="${PACE_LANE_CLOSED:-at-cap-no-priority}"
      echo "concurrency-cap"
      exit 0
    fi
    GAP=$(( TARGET_N - LIVE_COUNT ))
  else
    # daemon UNKNOWN (busy-worker read failed/uncorroborated, #lib-claude-agents
    # EMPTY-READ CORROBORATION): we cannot tell true occupancy, so this must NOT
    # be treated as headroom. Fail CLOSED — mirror the at-cap disposition above
    # (release lock, schedule reseed, concurrency-cap) rather than assume GAP=1
    # and risk spawning a duplicate worker onto an already-occupied worktree.
    release_lock
    "$SCRIPT_DIR/dispatch-schedule-reseed" 1>&2 || true
    DLOG_DISPOSITION="concurrency-cap"
    DLOG_SKIP_REASON="live-read-unverified"
    echo "router: busy-worker read unverified (daemon unreachable/uncorroborated); deferring rather than assuming headroom" >&2
    echo "concurrency-cap"
    exit 0
  fi
elif [[ -n "$MANUAL" ]]; then
  # --- manual context-dependent fan-out (#1458) ------------------------------
  # A bare human-typed `/dispatch` spawns enough workers to cover available
  # priority work eagerly while honoring the absolute MAX_WORKERS ceiling as its
  # governing target below the ceiling. It OVERRIDES the pace-curve throttle (a
  # budget pause to TARGET_N=0 still fans out) and, per human-dispatch-is-sovereign,
  # a deliberate human `/dispatch` always launches its one highest-ranking-available
  # node even at the ceiling — a bounded, deliberate max_concurrent_workers + 1
  # overage. Only genuine rate-limit token exhaustion (--exhausted) still blocks a
  # manual dispatch outright:
  #   HEADROOM = max(0, MAX_WORKERS − LIVE_COUNT)   ceiling below which HEADROOM governs
  #   GAP      = max(0, TARGET_N − LIVE_COUNT)      pace-curve budget gap
  #   N_PRIO   = count of selectable priority-LABELED (bypass) targets, capped at HEADROOM
  #   SPAWN_N  = max(1, min(max(N_PRIO, GAP, 1), HEADROOM))
  # The priority bypass and gap combine as a max (union), then are clamped by the
  # ceiling — except a floor of exactly one node re-asserts itself past the ceiling
  # when HEADROOM is 0, never wider. The fan-out itself runs rank-first through
  # dispatch-materialize-spawn's existing --gap N machinery (the highest rank level
  # is globally exhausted first; the `priority` label is the cap bypass, not an
  # ordering signal). LIVE_COUNT mirrors the
  # autonomous block's effective-live count (busy workers + reservations), and —
  # like that block — it SWEEPS the ledger before counting. The sweep is
  # load-bearing for TWO INDEPENDENT reasons; do not remove it as a redundant
  # optimization on the strength of only one of them:
  #   (1) Spawn-handoff double-counting. Since the spawn handoff landed, a claim
  #       is no longer cleared at the spawn kick but re-stamped `origin=spawned`
  #       and held until the worker registers, so between registration and the
  #       next sweep the SAME node is both a busy worker and an outstanding
  #       reservation. Counting unswept would charge it twice and shrink manual
  #       fan-out for up to a full tick interval. Sweep rule (a) drops exactly
  #       those redundant markers.
  #   (2) Cross-mode ledger freshness. Pause gates worker SPAWNING only, never
  #       ledger bookkeeping: dispatch-tick's paused branch sources
  #       lib-reservation-ledger.sh and reaps the ledger ahead of its
  #       short-circuit `exit 0` (landed as tactic-heartbeat-sweep-before-pause),
  #       so a paused heartbeat IS still a reaper and this manual sweep is NOT
  #       the ledger's only reconciler — do not read it as one. What it is, is
  #       the only reconciler that makes the ledger current AS OF THIS RUN: a
  #       manual dispatch must not consume a ledger that is up to one heartbeat
  #       interval stale (and arbitrarily stale when the heartbeat timer is
  #       stopped, masked, or has not fired since a worker session died).
  #       A stale count here is NOT merely "more conservative and therefore
  #       safe": dead-session orphan markers inflate live=N with phantom
  #       workers, and once they reach the ceiling HEADROOM hits 0 and manual
  #       fan-out gets throttled or zeroed outright — the shape of the
  #       2026-07-23 phantom-worker incident (`live=10` with no live worker
  #       actually running) — which is a failure, not caution. Required by
  #       strategy-graph-native-dispatch's 2026-07-23 cross-mode ledger-validity
  #       clarification. (That clarification named a
  #       `$XDG_DATA_HOME/commons-dispatch/paused` sentinel; its 2026-07-26
  #       amendment supersedes the mechanism with a dispatch.config/*.json
  #       boolean field — not yet built, tracked by
  #       tactic-dispatch-pause-config-field, so dispatch-tick still resolves
  #       DISPATCH_PAUSE_FLAG today — and leaves the spawning-not-bookkeeping
  #       semantics unchanged.)
  # Like the autonomous site, the call is best-effort (`|| true`): a failed sweep
  # must not block a deliberate human dispatch.
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-claude-agents.sh"
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-reservation-ledger.sh"
  reservation_sweep 1>&2 || true
  if BUSY=$(claude_agents_count_busy_workers); then
    RESV=$(reservation_count)
    LIVE_COUNT=$(( BUSY + RESV ))
    TARGET_N=$("$SCRIPT_DIR/dispatch-target-workers")
    MAX_WORKERS=$("$SCRIPT_DIR/dispatch-target-workers" --max)
    if [[ ! "$TARGET_N" =~ ^[0-9]+$ ]] || [[ ! "$MAX_WORKERS" =~ ^[0-9]+$ ]]; then
      release_lock
      DLOG_DISPOSITION="internal-error"
      DLOG_SKIP_REASON="non-numeric-target"
      echo "dispatch-select-tick: dispatch-target-workers returned non-numeric value (target '$TARGET_N', max '$MAX_WORKERS')" >&2
      exit 2
    fi
    EXHAUSTED=$("$SCRIPT_DIR/dispatch-target-workers" --exhausted 2>/dev/null) || EXHAUSTED="ok"
    HEADROOM=$(( MAX_WORKERS - LIVE_COUNT ))
    (( HEADROOM < 0 )) && HEADROOM=0
    if [[ "$EXHAUSTED" == exhausted ]]; then
      # Genuine token exhaustion is the one hard floor priority cannot override
      # — spawn nothing. Mirror the autonomous at-cap disposition: release the
      # lock and emit concurrency-cap. No reseed — a manual run is a one-shot;
      # the autonomous chain owns reseeds. No headroom under the ceiling no
      # longer short-circuits here: per human-dispatch-is-sovereign a deliberate
      # human `/dispatch` still launches its one highest-ranking-available node
      # at HEADROOM=0 (see the SPAWN_N floor-of-1 clamp below).
      release_lock
      DLOG_DISPOSITION="concurrency-cap"
      DLOG_SKIP_REASON="manual-rate-limit-exhausted"
      echo "router: manual fan-out: rate-limit window exhausted; nothing spawned"
      echo "concurrency-cap"
      exit 0
    fi
    GAP_BUDGET=$(( TARGET_N - LIVE_COUNT ))
    (( GAP_BUDGET < 0 )) && GAP_BUDGET=0
    # N_PRIO: the legacy priority-LABELED bypass count is gone with the legacy
    # selector; the graph pace-exempt lane owns pace-bypass now, and the graph
    # fan-out (graph-select-target --top GAP) is rank-first. Manual fan-out width
    # below the ceiling is therefore driven by the pace-curve gap alone; at the
    # ceiling a floor of exactly one node re-asserts itself: SPAWN_N = max(1,
    # min(max(N_PRIO, GAP_BUDGET, 1), HEADROOM)).
    N_PRIO=0
    # SPAWN_N = max(1, min(max(N_PRIO, GAP_BUDGET, 1), HEADROOM))
    SPAWN_N=$N_PRIO
    (( GAP_BUDGET > SPAWN_N )) && SPAWN_N=$GAP_BUDGET
    (( SPAWN_N < 1 )) && SPAWN_N=1
    (( SPAWN_N > HEADROOM )) && SPAWN_N=$HEADROOM
    # Floor re-asserts past the ceiling clamp: HEADROOM=0 must still yield one
    # deliberate node (human-dispatch-is-sovereign), never zero.
    (( SPAWN_N < 1 )) && SPAWN_N=1
    echo "router: manual fan-out: SPAWN_N=$SPAWN_N (headroom=$HEADROOM, n_prio=$N_PRIO, gap=$GAP_BUDGET, live=$LIVE_COUNT, max=$MAX_WORKERS)"
    GAP=$SPAWN_N
  else
    # daemon UNKNOWN (busy-worker read failed/uncorroborated). This deliberately
    # overrides human-dispatch-is-sovereign's floor-of-1 (documented above and
    # near the autonomous block's own bypass comments): sovereignty is meant to
    # override a KNOWN ceiling, not license spawning while blind to true
    # occupancy — a manual run here cannot tell a genuinely-idle worktree from
    # one a live worker already owns, and spawning onto the latter produces a
    # silent duplicate worker (a documented failure mode elsewhere in this
    # skill). No reseed — a manual run is one-shot; the autonomous chain owns
    # reseeds. The human's remedy is legible: re-run with
    # dangerouslyDisableSandbox: true so the daemon probe can actually reach
    # the socket, unlike a silent duplicate worker's remedy (there isn't one).
    release_lock
    DLOG_DISPOSITION="concurrency-cap"
    DLOG_SKIP_REASON="manual-live-read-unverified"
    echo "router: manual fan-out: busy-worker read unverified (daemon unreachable/uncorroborated); deferring rather than assuming headroom" >&2
    echo "concurrency-cap"
    exit 0
  fi
elif [[ -n "$NODE_ARG" ]]; then
  # Explicit single-node dispatch (tactic-graph-explicit-node-dispatch): skip
  # the pace-curve throttle and the MAX_WORKERS ceiling entirely — an explicit
  # human dispatch overrides the self-imposed pace curve, launching its one
  # named node without a ceiling check. The one hard floor every other path in
  # this file respects is genuine token exhaustion — mirror the --manual
  # branch's own EXHAUSTED check (do not invent new exhaustion logic).
  EXHAUSTED=$("$SCRIPT_DIR/dispatch-target-workers" --exhausted 2>/dev/null) || EXHAUSTED="ok"
  if [[ "$EXHAUSTED" == exhausted ]]; then
    release_lock
    DLOG_DISPOSITION="concurrency-cap"
    DLOG_SKIP_REASON="node-explicit-rate-limit-exhausted"
    echo "router: explicit node dispatch: rate-limit window exhausted; nothing spawned"
    echo "concurrency-cap"
    exit 0
  fi
  # Not exhausted: GAP stays 1 (its default above) — falls through to Step 3.
  # Reconcile the reservation ledger before Step 3 consults graph-select-target
  # --node (tactic-explicit-node-reservation-sweep-policy): an explicit human
  # dispatch of a named node should see accurate claim state, not a stale
  # marker left by a dead session. Mirrors the autonomous block's own sweep
  # call above (source + call, never fails the tick).
  #
  # The sourcing is also what makes Step 3a's emit_graph_selection →
  # reservation_write work on this lane at all — see that function's header.
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-claude-agents.sh"
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-reservation-ledger.sh"
  # Verify the load explicitly rather than absorbing failures with `|| true`
  # (the posture dispatch-tick's paused branch already takes, dispatch-tick:277).
  # reservation_sweep's contract is "return 0 — always", so a non-zero status
  # here could only mean the sources above failed (file missing, unreadable,
  # truncated) and the function is an undefined command. This script does not
  # use `set -e`, so a swallowed exit 127 would silently skip reconciliation on
  # exactly the path this tactic exists to reconcile — the explicit dispatch
  # would then still be refused `node-not-selectable` by the stale marker, with
  # nothing greppable in the tick journal to say why. Fail loud instead (see
  # .claude/rules/code-style.md). Still non-fatal: a human's named dispatch is
  # not worth aborting over an unreconciled ledger.
  if declare -f reservation_sweep >/dev/null 2>&1; then
    reservation_sweep 1>&2
  else
    echo "dispatch-select-tick: lib-reservation-ledger.sh failed to load; reservation ledger NOT swept for explicit node dispatch (a stale marker may refuse this node, and its own claim will not be recorded)" >&2
  fi
fi

# --- Step 2: run the JIT engine (best-effort) --------------------------------
# Pass its stdout lines through, prefixed; let stderr flow on a non-zero exit.
JIT_OUT=$("$SCRIPT_DIR/dispatch-jit-engine") || true
if [[ -n "$JIT_OUT" ]]; then
  while IFS= read -r jit_line; do
    [[ -n "$jit_line" ]] && echo "jit: $jit_line"
  done <<< "$JIT_OUT"
fi
# Heartbeat: refresh after the JIT engine sub-step completes (#2104).
refresh_lock

# --- Step 2b: run the Calendar JIT importer (best-effort) --------------------
# Files one reminder issue per pressing Google Calendar event and closes
# ended-event issues. Its own `calendar: ...` lines already carry the prefix;
# pass them through. A silent no-op when the OAuth env vars are unset.
CAL_OUT=$("$SCRIPT_DIR/dispatch-jit-calendar-import") || true
if [[ -n "$CAL_OUT" ]]; then
  while IFS= read -r cal_line; do
    [[ -n "$cal_line" ]] && echo "$cal_line"
  done <<< "$CAL_OUT"
fi
# Heartbeat: refresh after the calendar-import sub-step completes (#2104).
refresh_lock

# --- Step 2c: run the statements scan (best-effort) --------------------------
# Scans each configured statements folder and files one parse-job issue per new
# bank-statement file, deduped against GitHub state by sha256. A silent no-op
# when no statements.json config is present (machines that don't share a
# statements folder). Pass its stdout lines through, prefixed.
STMT_OUT=$("$SCRIPT_DIR/dispatch-statements-scan") || true
if [[ -n "$STMT_OUT" ]]; then
  while IFS= read -r stmt_line; do
    [[ -n "$stmt_line" ]] && echo "statements: $stmt_line"
  done <<< "$STMT_OUT"
fi
# Heartbeat: refresh after the statements-scan sub-step completes (#2104).
refresh_lock

# --- Step 2e: re-triage orphaned review follow-ups (best-effort) -------------
# Parks open dispatch:review-followup-labeled review follow-up issues (source PR
# read from the <!-- dispatch:source-pr <N> --> body marker) on office-hours
# when their source PR is found closed-unmerged (abandoned/superseded) — their
# findings point at code that never landed on main. Pass its stdout lines
# through, prefixed.
RETRIAGE_OUT=$("$SCRIPT_DIR/dispatch-retriage-orphaned-followups") || true
if [[ -n "$RETRIAGE_OUT" ]]; then
  while IFS= read -r retriage_line; do
    [[ -n "$retriage_line" ]] && echo "retriage: $retriage_line"
  done <<< "$RETRIAGE_OUT"
fi
# Heartbeat: refresh after the retriage sub-step completes (#2104).
refresh_lock

# --- Step 3: select the target -----------------------------------------------
# Explicit issue/PR targeting (`dispatch <N>`) was the legacy issue lane's entry
# point (dispatch-resolve-arg → dispatch-select-target → dispatch-materialize-spawn).
# That lane is gone; the graph selector owns target selection. A positional arg is
# rejected at arg-parse time above (before the lock or any side-effect step), so
# there is nothing to guard here.
#
# --- Step 3a: consult the graph selector (tactic-graph-router-selector) -------
# The graph selector is now the ONLY queue selector — the legacy gh selector
# (dispatch-select-target) and its worktree-materialization chain
# (dispatch-materialize-spawn → dispatch-launch-worker) were deleted in
# tactic-dispatch-legacy-rewire Unit 3. A selector failure degrades to `empty`
# (fall through to the aux triggers below) rather than wedging the tick.
GRAPH_ORIGIN=""
if [[ -n "$NODE_ARG" ]]; then
  GRAPH_OUT=$("$SCRIPT_DIR/graph-select-target" --node "$NODE_ARG") \
    || { echo "dispatch-select-tick: graph-select-target --node failed; treating as empty" >&2; GRAPH_OUT="empty"; }
  # Stamp the explicit lane's claim so reservation_sweep rule (c-ttl) can bound
  # its lifetime — see emit_graph_selection's header.
  GRAPH_ORIGIN="explicit"
else
  GRAPH_OUT=$("$SCRIPT_DIR/graph-select-target" --top "$GAP") \
    || { echo "dispatch-select-tick: graph-select-target failed; treating as empty" >&2; GRAPH_OUT="empty"; }
fi
if emit_graph_selection ${GRAPH_ORIGIN:+"$GRAPH_ORIGIN"} <<<"$GRAPH_OUT"; then
  exit 0
fi
if [[ -n "$NODE_ARG" ]]; then
  # Do NOT fall through to Step 3b's aux triggers (JIT reminder / main-broken) —
  # that would silently substitute an unrelated job for the node the human
  # explicitly asked for.
  release_lock
  DLOG_DISPOSITION="node-not-selectable"
  echo "node-not-selectable $NODE_ARG"
  exit 0
fi

# --- Step 3b: aux triggers when the graph queue is empty (KEEP) ---------------
# The two lane-independent aux triggers the deleted legacy selector used to emit
# from its default mode. Both spawn their own lock-free bg job downstream
# (dispatch-tick's jit-reminder / main-broken cases), so the lock is RELEASED
# here. Priority order is preserved from the old dispatch-select-target default
# mode: a due JIT reminder outranks a newly-red main.
JIT_LINE=$("$SCRIPT_DIR/dispatch-jit-scan") || JIT_LINE=""
if [[ -n "$JIT_LINE" ]]; then
  release_lock
  DLOG_DISPOSITION="jit-reminder"
  DLOG_TARGET=$(awk '{print $3}' <<<"$JIT_LINE")
  echo "$JIT_LINE"
  exit 0
fi

# main-broken first-detection latch: emit only when main is red AND no
# tactic-main-red-* node is open yet (OPEN_MAIN_RED, computed in Step 1c) — once
# diagnose-main has written it, the latch stands down so graph work flows while
# main is still red. repo-health --main-broken-sha is the live CI probe and the
# durable label-free latch writer in one; empty stdout / non-zero (green or an
# errored probe) means no gate. OPEN_MAIN_RED=UNKNOWN (Step 1c graph read failure)
# is non-empty, so this fail-safe skips emission rather than firing on unknown
# health.
if [[ -z "$OPEN_MAIN_RED" ]]; then
  if MB_SEL=$("$SCRIPT_DIR/repo-health" --main-broken-sha) && [[ -n "$MB_SEL" ]]; then
    release_lock
    DLOG_DISPOSITION="main-broken"
    DLOG_TARGET="$MB_SEL"
    echo "main-broken $MB_SEL"
    exit 0
  fi
fi

release_lock
DLOG_DISPOSITION="empty"
echo "empty"
exit 0
