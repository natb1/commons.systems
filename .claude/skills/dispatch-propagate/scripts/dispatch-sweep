#!/usr/bin/env bash
# dispatch-sweep — reconcile worktrees: reap merged/closed worktrees. Fired by the worker Stop-hook via dispatch-spawn-sweep (the retired /dispatch-propagate router was the old caller).
#
# Usage:
#   dispatch-sweep   — cleanup merged worktrees.
#
# Behavior, in order:
#   1. Enumerate registered worktrees under <project-root>/worktrees/, excluding
#      the main worktree and detached HEADs.
#   2. For each worktree, query its PR state directly with `gh pr list --head
#      <branch>` — unbounded by construction. A single creation-ordered
#      `gh pr list --limit N` window never sees the merged backlog tail once the
#      project accrues more than N PRs (#1313). Precedence over the branch's PRs:
#      any OPEN PR -> keep (active work); else any MERGED PR -> remove; else
#      (no PR) -> fall through to the issue path.
#   3. No-PR + issue-number branch: query the issue state. CLOSED -> remove;
#      OPEN -> keep; anything else is logged and skipped.
#   4. No-PR + no issue-number prefix: a bare node-id worktree (a graph
#      intention node, e.g. an office-hours review workspace). There is no PR
#      or issue to read, so this arm requires POSITIVE evidence of completion
#      rather than the absence of a signal — see the NODE-arm gates below.
#   A worktree is removed only when it is reservation-free, has no live session,
#      and is in sync (clean tree + zero unpushed commits). A per-worktree gh
#      failure is logged and isolated, never fatal (#1313).
#
# Environment overrides for testability:
#   DISPATCH_SWEEP_LOG_FILE   Override log path. Default: <root>/tmp/dispatch-sweep.log.
#   DISPATCH_SWEEP_NOW        Override UTC timestamp source (deterministic tests).
#   DISPATCH_SWEEP_NODE_MIN_AGE_S
#                             Minimum age (seconds) a bare node-id worktree must
#                             reach before the NODE arm may reap it. Precedence:
#                             sweep config nodeMinAgeSeconds -> this env override
#                             -> baked default (3600).
#
# Exit codes:
#   0  normal sweep completed (merged worktrees removed where possible).
#   2  invalid invocation (not in a git repo).
#
# NOT set -e: per-worktree errors should not abort the sweep — bookkeeping
# decisions must keep flowing into the log so the next worker Stop (via dispatch-spawn-sweep) can act.
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./lib.sh
source "$SCRIPT_DIR/lib.sh"
# shellcheck source=./lib-worktree-in-sync.sh
source "$SCRIPT_DIR/lib-worktree-in-sync.sh"
# shellcheck source=./lib-claude-agents.sh
source "$SCRIPT_DIR/lib-claude-agents.sh"
# shellcheck source=./lib-reservation-ledger.sh
source "$SCRIPT_DIR/lib-reservation-ledger.sh"
# shellcheck source=./lib-worktree-reap.sh
source "$SCRIPT_DIR/lib-worktree-reap.sh"

# Resolve project root via resolve_project_root (lib.sh); native worktrees live
# under <repo>/.claude/worktrees/ (the standard Claude Code layout).
PROJECT_ROOT=$(resolve_project_root) \
  || { echo "ERROR: not in a git repo" >&2; exit 2; }
WORKTREES_ROOT="$PROJECT_ROOT/.claude/worktrees"
# Test seam: an explicit DISPATCH_SWEEP_WORKTREES_ROOT overrides the derived
# container path (same convention as commit-merge-push's DISPATCH_WORKTREES_ROOT
# and DISPATCH_LOCK_FILE / DISPATCH_CONFIG_DIR).
[[ -n "${DISPATCH_SWEEP_WORKTREES_ROOT:-}" ]] && WORKTREES_ROOT="$DISPATCH_SWEEP_WORKTREES_ROOT"

LOG_FILE="${DISPATCH_SWEEP_LOG_FILE:-$PROJECT_ROOT/tmp/dispatch-sweep.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true

log() {
  local ts="${DISPATCH_SWEEP_NOW:-$(date -u +%FT%TZ)}"
  printf '%s [dispatch-sweep] %s\n' "$ts" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# Reject any argument — the script has only one mode.
if [[ $# -gt 0 ]]; then
  echo "ERROR: unknown argument(s): $*" >&2
  echo "usage: dispatch-sweep" >&2
  exit 2
fi

# ---- Not-in-sync reap: grace window + now-epoch ------------------------------
# A merged/closed worktree that is not in sync is skipped (recoverable work may
# be present), but an indefinitely-skipped worktree accumulates forever. After a
# bounded grace it is quarantined and force-reaped. Resolve the grace ONCE here.
# Precedence: sweep config notInSyncGraceSeconds → env override → baked default.
# `no-config` (file absent) means "use defaults", following the load-with-default
# pattern in dispatch-target-workers.
NOT_IN_SYNC_GRACE_S=86400
# Fold dispatch-config-load's stderr into CONFIG_OUT (2>&1, mirroring the loader's
# own idiom): a malformed sweep.json exits non-zero with a diagnostic on stderr,
# and discarding it would silently fall back to the default — over-/under-retaining
# worktrees with no operator signal. On failure the else-branch logs that diagnostic.
# The env override is the lowest-precedence fallback: it must fire whenever the
# config does not supply a usable value — both when the file is absent (no-config)
# AND when the file is present but omits/malforms notInSyncGraceSeconds — so val is
# resolved first, then a single integer-guarded fallback chain handles env/default.
# The config path is integer-guarded (^[0-9]+$) to match the env path: jq -r emits
# floats/scientific-notation verbatim, and a non-integer in an arithmetic [[ -lt ]]
# would error and reap every not-in-sync worktree immediately.
if CONFIG_OUT=$("$SCRIPT_DIR/dispatch-config-load" sweep 2>&1); then
  val=""
  if [[ "$CONFIG_OUT" != "no-config" ]]; then
    val=$(jq -r '.notInSyncGraceSeconds // empty' <<<"$CONFIG_OUT")
  fi
  if [[ "$val" =~ ^[0-9]+$ ]]; then
    NOT_IN_SYNC_GRACE_S="$val"
  elif [[ "${DISPATCH_SWEEP_NOT_IN_SYNC_GRACE_S:-}" =~ ^[0-9]+$ ]]; then
    NOT_IN_SYNC_GRACE_S="$DISPATCH_SWEEP_NOT_IN_SYNC_GRACE_S"
  fi
else
  log "SWEEP_CONFIG_ERROR: $CONFIG_OUT"
  if [[ "${DISPATCH_SWEEP_NOT_IN_SYNC_GRACE_S:-}" =~ ^[0-9]+$ ]]; then
    NOT_IN_SYNC_GRACE_S="$DISPATCH_SWEEP_NOT_IN_SYNC_GRACE_S"
  fi
fi

# ---- NODE-arm minimum age ----------------------------------------------------
# The bare node-id arm (no PR, no issue-number prefix) reaps a worktree that
# carries no reservation marker of its own, so a worktree provisioned seconds ago
# — e.g. by `office-hours-graph`, which does `git worktree add` and only THEN
# launches the session the daemon registers asynchronously — must never be
# reapable inside that registration window. Resolve the floor the same way the
# not-in-sync grace is resolved: sweep config `nodeMinAgeSeconds` → env override →
# baked default, each integer-guarded (a non-integer in an arithmetic comparison
# would error and reap every node worktree immediately). CONFIG_OUT is reused from
# the block above; when the loader failed it holds a diagnostic, which jq rejects
# and the integer guard discards — falling through to env/default.
NODE_MIN_AGE_S=3600
node_val=""
if [[ -n "${CONFIG_OUT:-}" && "$CONFIG_OUT" != "no-config" ]]; then
  node_val=$(jq -r '.nodeMinAgeSeconds // empty' <<<"$CONFIG_OUT" 2>/dev/null)
fi
if [[ "$node_val" =~ ^[0-9]+$ ]]; then
  NODE_MIN_AGE_S="$node_val"
elif [[ "${DISPATCH_SWEEP_NODE_MIN_AGE_S:-}" =~ ^[0-9]+$ ]]; then
  NODE_MIN_AGE_S="$DISPATCH_SWEEP_NODE_MIN_AGE_S"
fi

# "now" in epoch seconds for marker age math. Distinct from DISPATCH_SWEEP_NOW
# (the ISO-8601 string used only for log() timestamps). reap_marker_record reads
# the same override internally so the stamp and the age math share one clock.
if [[ "${DISPATCH_SWEEP_NOW_EPOCH:-}" =~ ^[0-9]+$ ]]; then
  NOW_EPOCH="$DISPATCH_SWEEP_NOW_EPOCH"
else
  NOW_EPOCH=$(date -u +%s)
fi

# reap_or_skip_not_in_sync <suffix> <wt-path> <wt-branch> <wt-basename> <log-suffix>
# Shared decision for BOTH not-in-sync branches (merged + closed). <suffix> is the
# log token suffix (MERGED|CLOSED). It sits IN PLACE OF the bare
# `log "SKIP_*_NOT_IN_SYNC"` calls, INSIDE the existing reservation + live-session
# guards, so a reserved/live worktree never reaches this path (AC3 by construction).
#   1. marker absent → record (start the grace clock) → log SKIP_<SUFFIX>_NOT_IN_SYNC.
#   2. age < grace → log SKIP_<SUFFIX>_NOT_IN_SYNC with age/grace.
#   3. age >= grace → quarantine; on failure log SKIP_<SUFFIX>_NOT_IN_SYNC_QUARANTINE_FAILED
#      (worktree + marker left intact); on success assert dest is not inside the
#      worktree, force-remove the worktree + branch, clear the marker, log
#      REAP_<SUFFIX>_NOT_IN_SYNC.
reap_or_skip_not_in_sync() {
  local suffix="$1" wt_path="$2" wt_branch="$3" wt_basename="$4" log_suffix="$5"

  local marker_epoch
  if ! marker_epoch=$(reap_marker_read "$PROJECT_ROOT" "$wt_basename"); then
    # First not-in-sync observation: start the grace clock (write-once).
    reap_marker_record "$PROJECT_ROOT" "$wt_basename" || true
    log "SKIP_${suffix}_NOT_IN_SYNC: '$wt_path' branch=$wt_branch $log_suffix (grace clock started)"
    return 0
  fi

  local age=$((NOW_EPOCH - marker_epoch))
  if [[ "$age" -lt "$NOT_IN_SYNC_GRACE_S" ]]; then
    log "SKIP_${suffix}_NOT_IN_SYNC: '$wt_path' branch=$wt_branch $log_suffix age_seconds=$age grace_seconds=$NOT_IN_SYNC_GRACE_S"
    return 0
  fi

  # Aged past grace: quarantine BEFORE any destructive removal. A quarantine
  # failure ABORTS the reap (never force-remove on quarantine error — that is the
  # irreversible-data-loss path). Worktree and marker are left intact.
  local dest
  if ! dest=$(reap_quarantine "$PROJECT_ROOT" "$wt_path" "$wt_basename"); then
    log "SKIP_${suffix}_NOT_IN_SYNC_QUARANTINE_FAILED: '$wt_path' branch=$wt_branch $log_suffix age_seconds=$age grace_seconds=$NOT_IN_SYNC_GRACE_S"
    return 0
  fi

  # Belt-and-suspenders: the quarantine MUST NOT be inside the worktree we are
  # about to force-remove (else the removal deletes the quarantine — AC2
  # violated). With the root resolved from the runner this never fires, but assert
  # it with trailing-slash boundaries (so a sibling-prefix name does not false-fire).
  case "$dest/" in
    "$wt_path"/*)
      log "SKIP_${suffix}_NOT_IN_SYNC_QUARANTINE_FAILED: '$wt_path' branch=$wt_branch $log_suffix quarantine_inside_worktree='$dest'"
      return 0
      ;;
  esac
  case "$wt_path/" in
    "$dest"/*)
      log "SKIP_${suffix}_NOT_IN_SYNC_QUARANTINE_FAILED: '$wt_path' branch=$wt_branch $log_suffix worktree_inside_quarantine='$dest'"
      return 0
      ;;
  esac

  if git worktree remove --force "$wt_path" 2>>"$LOG_FILE"; then
    git worktree prune 2>/dev/null || true
    if ! git branch -D "$wt_branch" >>"$LOG_FILE" 2>&1; then
      log "BRANCH_DELETE_FAILED: branch=$wt_branch (worktree removed; branch retained)"
    fi
    reap_marker_clear "$PROJECT_ROOT" "$wt_basename" || true
    log "REAP_${suffix}_NOT_IN_SYNC: '$wt_path' branch=$wt_branch $log_suffix age_seconds=$age grace_seconds=$NOT_IN_SYNC_GRACE_S quarantine='$dest'"
  else
    log "SKIP_WORKTREE_REMOVE_FAILED: '$wt_path' branch=$wt_branch"
  fi
  return 0
}

# ---- NODE-arm gates: completion signal, age, cwd-keyed liveness -------------
# Every other removal path in this script keys off positive remote evidence that
# the work is finished (a MERGED PR, a CLOSED issue). A bare node-id worktree has
# neither, so the NODE arm must NOT reap on the mere absence of a signal — that
# would delete in-flight pre-PR node work and human office-hours review
# workspaces. These helpers supply the positive evidence instead.

# origin/main must be readable for the completion signal to mean anything. Resolve
# it ONCE: a missing/unfetchable remote ref makes every node reap fail safe (skip).
ORIGIN_MAIN_OK=0
if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null 2>&1; then
  ORIGIN_MAIN_OK=1
fi

# node_completion_state <node-id>
# Print a one-token state for the branch's intention node AS RECORDED ON
# origin/main, and return 0 ONLY when the node is provably finished:
#   done   — intentions/<node-id>.md exists at `phase: done` with `office_hours: null`
#   pruned — no such file on origin/main, but the path HAS history there (the node
#            existed and was pruned from the graph)
# Return 1 (never reap) with one of:
#   active-phase / parked        — the node is still in flight or parked for the
#                                  author (an office-hours workspace to preserve)
#   not-a-node                   — no file and no history: this branch was never a
#                                  graph node (a manually created worktree)
#   unknown-origin-main / unsafe-id / unparseable-frontmatter — cannot tell
# Frontmatter is matched at column 0 so nested keys never satisfy the gate, and
# anything other than the exact `null` / `done` literals is read as "not finished".
node_completion_state() {
  local node_id="$1"
  if [[ "$ORIGIN_MAIN_OK" != "1" ]]; then
    printf 'unknown-origin-main\n'
    return 1
  fi
  # The id becomes a path component in the `git show` pathspec — guard it the same
  # way the reservation ledger guards marker basenames.
  case "$node_id" in
    *..*|*/*|*[[:cntrl:]]*)
      printf 'unsafe-id\n'
      return 1
      ;;
  esac

  local body fm
  if body=$(git show "origin/main:intentions/$node_id.md" 2>/dev/null); then
    fm=$(awk 'NR == 1 && $0 == "---" { infm = 1; next } infm && $0 == "---" { exit } infm { print }' <<<"$body")
    if [[ -z "$fm" ]]; then
      printf 'unparseable-frontmatter\n'
      return 1
    fi
    if ! grep -qE '^office_hours:[[:space:]]*null[[:space:]]*$' <<<"$fm"; then
      # Non-null office_hours = an author park. The office-hours lane provisions
      # exactly these node worktrees for the human to engage in — never reap one.
      printf 'parked\n'
      return 1
    fi
    if ! grep -qE '^phase:[[:space:]]*done[[:space:]]*$' <<<"$fm"; then
      printf 'active-phase\n'
      return 1
    fi
    printf 'done\n'
    return 0
  fi

  # No node file on origin/main. Only a node that once existed there and was
  # pruned is reapable; an absent file with NO history means the branch was never
  # a graph node at all (a scratch/manual worktree), which this arm must not touch.
  local hist
  hist=$(git log -1 --format=%H origin/main -- "intentions/$node_id.md" 2>/dev/null)
  if [[ -n "$hist" ]]; then
    printf 'pruned\n'
    return 0
  fi
  printf 'not-a-node\n'
  return 1
}

# node_worktree_age_s <wt-path>
# Print the worktree's age in seconds, or return 1 when it cannot be determined.
# `<worktree>/.git` is the gitdir pointer file written once by `git worktree add`,
# so its mtime is a stable creation stamp — unlike the admin dir under
# .git/worktrees/<name>, which routine git operations rewrite.
node_worktree_age_s() {
  local pth="$1" mtime
  mtime=$(stat -c %Y "$pth/.git" 2>/dev/null) || return 1
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$(( NOW_EPOCH - mtime ))"
  return 0
}

# node_cwd_has_live_session <wt-path>
# cwd-keyed liveness, complementing the NAME-keyed worktree_has_live_session. A
# session resident in the worktree under some other name — an interactive session
# that entered it via EnterWorktree, or a manually created node worktree — is
# invisible to the name-keyed check, so ask the daemon by cwd as well.
#   return 0 — a live session runs under <wt-path>, OR the daemon is unqueryable
#              (UNKNOWN, claude_sessions_under rc 1) → treat as occupied.
#   return 1 — a definite empty result: no session resident there.
node_cwd_has_live_session() {
  local pth="$1" out
  if ! out=$(claude_sessions_under "$pth"); then
    return 0
  fi
  [[ -n "${out//[[:space:]]/}" ]]
}

# ---- Step 1: enumerate registered worktrees ---------------------------------
# list_worktree_records (lib.sh) walks `git worktree list --porcelain` and emits
# one tab-separated <issue-number>\t<path>\t<branch> record per worktree.
# split_worktree_record populates WT_NUM / WT_PATH / WT_BRANCH from each record.
# Detached HEADs and bare worktrees have an empty WT_BRANCH — skip those
# (no branch -> no PR lookup, nothing to reason about here).
# The path-level filtering stays at this call site: restrict to direct children
# of $WORKTREES_ROOT (<repo>/.claude/worktrees/<name>), excluding main. The main
# checkout is the repo root, not a child of $WORKTREES_ROOT, so it is already
# excluded; any deeper-nested worktree is out of scope.
WT_PATHS=()
WT_BRANCHES=()
WT_NUMS=()

while IFS= read -r wt_record; do
  split_worktree_record "$wt_record"
  # Skip detached-HEAD / bare records (no branch).
  [[ -z "$WT_BRANCH" ]] && continue
  # Restrict to direct children of $WORKTREES_ROOT/<name>, excluding main.
  [[ "$(dirname "$WT_PATH")" == "$WORKTREES_ROOT" \
     && "$(basename "$WT_PATH")" != "main" ]] || continue
  WT_PATHS+=("$WT_PATH")
  WT_BRANCHES+=("$WT_BRANCH")
  WT_NUMS+=("$WT_NUM")
done < <(list_worktree_records)

# ---- Step 2: per-worktree reconcile pass ------------------------------------
# Each worktree is processed reservation-first, then liveness, then by its own
# per-worktree PR state (gh pr list --head), then (only when there is no PR at
# all) by issue state. A merged/closed + in-sync worktree is removed along with
# its local branch; not-in-sync worktrees are logged with a SKIP line so the
# user can investigate — the unpushed work may belong to a live session.
# Liveness gate: even a removable worktree is skipped when a live session is
# registered under its basename (worktree_has_live_session) — the worker owns it
# and will clean up on its own tick. A per-worktree gh failure is isolated:
# logged and skipped, never aborting the whole sweep (#1313).
i=0
while [[ $i -lt ${#WT_PATHS[@]} ]]; do
  wt_path="${WT_PATHS[$i]}"
  wt_branch="${WT_BRANCHES[$i]}"
  wt_num="${WT_NUMS[$i]}"
  i=$((i + 1))

  # Reservation guard (loop-top, covers BOTH removal paths in one place): a
  # reserved worktree is claimed by a worker about to start — never reap it.
  if reservation_exists "$(basename "$wt_path")"; then
    log "SKIP_RESERVED: '$wt_path' branch=$wt_branch"
    continue
  fi

  # Per-worktree PR state (defect 3, #1313): query this branch's PRs directly
  # with `--head` instead of a creation-ordered `--limit N` window that never
  # sees the merged backlog tail. A failure here is isolated to this worktree
  # (defect 2, #1313): log and move on, never abort the sweep.
  if ! pr_json=$(gh_pr_list_rest --head "$wt_branch" --state all); then
    log "ERROR_PR_STATE_FETCH: branch=$wt_branch gh_pr_list_rest --head failed"
    continue
  fi

  # Precedence (a branch may have multiple PRs): any OPEN -> keep (active work).
  if [[ "$(jq '[.[] | select(.state == "OPEN")] | length' <<<"$pr_json")" -gt 0 ]]; then
    continue
  fi

  # Else any MERGED -> merged-remove path; capture the merged PR number to log.
  pr_num=$(jq -r 'map(select(.state == "MERGED"))[0].number // empty' <<<"$pr_json")
  if [[ -z "$pr_num" ]]; then
    # No PR at all -> issue path, but only for a dispatch-style branch with an
    # issue-number prefix. Otherwise there is nothing to reason about.
    if [[ -n "$wt_num" ]]; then
      issue_num="$wt_num"
      # Per-worktree issue fetch; a failure is isolated (defect 2, #1313).
      if ! issue_state=$(gh_issue_view_rest "$issue_num" | jq -r '.state'); then
        log "ERROR_ISSUE_STATE_FETCH: branch=$wt_branch issue=$issue_num gh_issue_view_rest failed"
        continue
      fi
      case "$issue_state" in
        CLOSED)
          if worktree_has_live_session "$wt_path"; then
            log "SKIP_CLOSED_LIVE_SESSION: '$wt_path' branch=$wt_branch issue=#$issue_num"
          elif worktree_in_sync "$wt_path" "$LOG_FILE" "dispatch-sweep"; then
            if git worktree remove "$wt_path" 2>>"$LOG_FILE"; then
              git worktree prune 2>/dev/null || true
              if ! git branch -D "$wt_branch" >>"$LOG_FILE" 2>&1; then
                log "BRANCH_DELETE_FAILED: branch=$wt_branch (worktree removed; branch retained)"
              fi
              # Clear any not-in-sync marker so a future same-named worktree never
              # inherits a stale grace timestamp.
              reap_marker_clear "$PROJECT_ROOT" "$(basename "$wt_path")" || true
              log "REMOVE_CLOSED_ISSUE: '$wt_path' branch=$wt_branch issue=#$issue_num"
            else
              log "SKIP_WORKTREE_REMOVE_FAILED: '$wt_path' branch=$wt_branch"
            fi
          else
            reap_or_skip_not_in_sync CLOSED "$wt_path" "$wt_branch" "$(basename "$wt_path")" "issue=#$issue_num"
          fi
          ;;
        OPEN)
          ;;
        *)
          log "ERROR_ISSUE_STATE_FETCH: branch=$wt_branch issue=$issue_num unexpected state='$issue_state'"
          continue
          ;;
      esac
    else
      # No PR and no issue-number prefix -> a bare node-id worktree (branch =
      # tactic id or similar, never had a PR, e.g. an office-hours session's
      # worktree). There is no PR or issue whose closure proves the work is
      # finished, so this arm reaps ONLY on positive evidence, in this order:
      #   1. completion signal — the node is `phase: done` + unparked on
      #      origin/main, or was pruned from the graph. An active phase, an
      #      author park (office_hours non-null), a branch that was never a node,
      #      or an unreadable origin/main all SKIP.
      #   2. minimum age — a just-provisioned worktree is never reaped inside the
      #      session-registration window (office-hours-graph adds the worktree
      #      before the daemon registers its session).
      #   3. liveness — name-keyed AND cwd-keyed, so a live session working in the
      #      worktree under any other name still blocks the reap.
      #   4. in sync. A not-in-sync node worktree is only ever SKIPPED: the
      #      quarantine/force-reap path deliberately does NOT apply here, because
      #      nothing proves the unpushed work in it is complete.
      if ! node_state=$(node_completion_state "$wt_branch"); then
        log "SKIP_NODE_NOT_COMPLETE: '$wt_path' branch=$wt_branch state=$node_state"
        continue
      fi
      node_age=$(node_worktree_age_s "$wt_path") || node_age=""
      if [[ ! "$node_age" =~ ^[0-9]+$ ]]; then
        log "SKIP_NODE_AGE_UNKNOWN: '$wt_path' branch=$wt_branch state=$node_state (no readable creation stamp)"
      elif [[ "$node_age" -lt "$NODE_MIN_AGE_S" ]]; then
        log "SKIP_NODE_TOO_YOUNG: '$wt_path' branch=$wt_branch state=$node_state age_seconds=$node_age min_age_seconds=$NODE_MIN_AGE_S"
      elif worktree_has_live_session "$wt_path"; then
        log "SKIP_NODE_LIVE_SESSION: '$wt_path' branch=$wt_branch"
      elif node_cwd_has_live_session "$wt_path"; then
        log "SKIP_NODE_LIVE_SESSION_CWD: '$wt_path' branch=$wt_branch"
      elif worktree_in_sync "$wt_path" "$LOG_FILE" "dispatch-sweep"; then
        if git worktree remove "$wt_path" 2>>"$LOG_FILE"; then
          git worktree prune 2>/dev/null || true
          if ! git branch -D "$wt_branch" >>"$LOG_FILE" 2>&1; then
            log "BRANCH_DELETE_FAILED: branch=$wt_branch (worktree removed; branch retained)"
          fi
          # Clear any not-in-sync marker so a future same-named worktree never
          # inherits a stale grace timestamp.
          reap_marker_clear "$PROJECT_ROOT" "$(basename "$wt_path")" || true
          log "REMOVE_NODE: '$wt_path' branch=$wt_branch state=$node_state age_seconds=$node_age"
        else
          log "SKIP_WORKTREE_REMOVE_FAILED: '$wt_path' branch=$wt_branch"
        fi
      else
        # NOT quarantined/force-reaped (unlike the MERGED/CLOSED arms): a merged
        # PR or closed issue proves that work is finished, and nothing here does.
        # Unpushed work in a node worktree is left alone for a human to inspect.
        log "SKIP_NODE_NOT_IN_SYNC: '$wt_path' branch=$wt_branch node=$wt_branch (no completion evidence for unpushed work; not quarantined)"
      fi
    fi
    continue
  fi

  # Branch is merged. Guard against removing a worktree a live worker owns.
  if worktree_has_live_session "$wt_path"; then
    log "SKIP_MERGED_LIVE_SESSION: '$wt_path' branch=$wt_branch pr=#$pr_num"
    continue
  fi

  # Tree-identity in-sync check (#1845): a squash-merge deletes the remote head
  # branch, so use worktree_merged_in_sync (not reachability) here. The helper
  # logs its own KEEP/ERROR reason.
  if worktree_merged_in_sync "$wt_path" "$LOG_FILE" "dispatch-sweep"; then
    if git worktree remove "$wt_path" 2>>"$LOG_FILE"; then
      git worktree prune 2>/dev/null || true
      if ! git branch -D "$wt_branch" >>"$LOG_FILE" 2>&1; then
        log "BRANCH_DELETE_FAILED: branch=$wt_branch (worktree removed; branch retained)"
      fi
      # Clear any not-in-sync marker so a future same-named worktree never
      # inherits a stale grace timestamp.
      reap_marker_clear "$PROJECT_ROOT" "$(basename "$wt_path")" || true
      log "REMOVE_MERGED: '$wt_path' branch=$wt_branch pr=#$pr_num"
    else
      log "SKIP_WORKTREE_REMOVE_FAILED: '$wt_path' branch=$wt_branch"
    fi
  else
    reap_or_skip_not_in_sync MERGED "$wt_path" "$wt_branch" "$(basename "$wt_path")" "pr=#$pr_num"
  fi
done

# ---- GC vanished markers -----------------------------------------------------
# Delete any not-in-sync marker whose basename is no longer a registered worktree
# (the worktree was removed by another path, or never re-registered). Prevents a
# future same-named worktree from inheriting a stale grace timestamp.
if marker_dir=$(reap_marker_dir "$PROJECT_ROOT") && [[ -d "$marker_dir" ]]; then
  declare -A registered=()
  for p in ${WT_PATHS[@]+"${WT_PATHS[@]}"}; do
    registered["$(basename "$p")"]=1
  done
  shopt -s nullglob
  for mf in "$marker_dir"/*; do
    [[ -f "$mf" ]] || continue
    mb=$(basename "$mf")
    if [[ -z "${registered[$mb]:-}" ]]; then
      reap_marker_clear "$PROJECT_ROOT" "$mb" || true
      log "GC_NOT_IN_SYNC_MARKER: vanished worktree basename=$mb"
    fi
  done
  shopt -u nullglob
fi

exit 0
