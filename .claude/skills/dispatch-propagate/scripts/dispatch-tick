#!/usr/bin/env bash
# dispatch-tick — the headless /dispatch-propagate tick: a thin bash sequencer
# over dispatch-select-tick → dispatch-graph-execute (+ aux bg jobs), with NO
# model session.
#
# Usage: dispatch-tick [--manual] [--allow-stale] [<node-id>]
#
# This is the scripted equivalent of the routing the dispatch-propagate SKILL.md
# (Tables 1 and 2) used to describe for a model router session. Replacing that
# model session is the point: a tick has no remaining model-decision seam — every
# branch is deterministic — so the per-tick `claude --bg` router session (a boot,
# a context load, and a teardown whose only job was to call two scripts and relay
# one line) is pure overhead. dispatch-tick runs the same two orchestrators
# headlessly.
#
# Because it is NOT itself a managed `claude --bg` job, there is nothing to
# self-close: where the model router would have called dispatch-self-close on a
# `propagate`/`drain` disposition, dispatch-tick simply exits 0. The autonomous
# tick is launched by systemd (the #725 heartbeat) and by the worker Stop-hook in
# a later unit; it runs bare and keeps the concurrency gate. A human-typed
# `dispatch` runs one tick as foreground bash, passing `--manual` to spawn a
# context-dependent SPAWN_N workers (rank-first), exempt from the pace-curve
# throttle but bounded by the `MAX_WORKERS` ceiling and the `--exhausted` floor.
# The audit record is this script's journal output
# (every captured stdout line is echoed through) plus the spawned workers'
# transcripts plus durable GitHub side effects (PR comments, `dispatch:*`
# labels) — so relay matters only for a human-run `dispatch` (foreground
# terminal bash), not for the autonomous tick.
#
# Manual `dispatch` cap semantics & selection lock:
#   `dispatch` (bare, no argument): skips the pace-curve throttle (a budget pause
#   to TARGET_N=0 still fans out) but honors the `MAX_WORKERS` ceiling and the
#   `--exhausted` hard floor; spawns SPAWN_N = min(HEADROOM, max(N_PRIO, GAP, 1))
#   workers, rank-first (the highest-rank queue targets; the graph `pace_exempt`
#   flag is the pace-curve/cap bypass, not an ordering signal). Emits
#   `concurrency-cap` when SPAWN_N=0 (at the ceiling or exhausted).
#
#   Exhaustion hard floor (both autonomous and manual paths): when the 5-hour or
#   weekly rate-limit window is at/near 100% used with `resets_at` still in the
#   future, `dispatch-target-workers --exhausted` reports `exhausted`. On BOTH the
#   autonomous and manual paths the tick emits `concurrency-cap` and spawns nothing
#   — even a waiting pace-exempt or main-broken item. This is a hard stop
#   on genuine token exhaustion, not the self-imposed pacing throttle that the
#   pace-exempt bypass is meant to override. The reseed-at-reset arm (scheduling a
#   #725 reseed when the window resets) is autonomous-only: a manual run is a
#   one-shot and does not arm a reseed.
#
#   Pace-exempt/main-broken bypass (autonomous path, at-cap, not exhausted): when
#   `LIVE_COUNT >= TARGET_N` but `--exhausted` reports `ok`, dispatch-select-tick
#   does NOT immediately emit `concurrency-cap`. It first probes
#   `graph-select-target --pace-exempt-only` (the authored `pace_exempt` flag is
#   the graph home of the legacy `priority` label); a hit holds the lock and
#   spawns up to `max_concurrent_workers - LIVE_COUNT` gate-exempt workers (0
#   closes the lane) — the ceiling is absolute for autonomous scheduling. If
#   that lane is empty, it checks `repo-health --main-broken-sha` — a main
#   that breaks while at the worker cap still surfaces and spawns the
#   diagnose job even at cap. Either
#   bypass still counts toward `LIVE_COUNT` and suppresses non-pace-exempt fan-out
#   on later ticks: it bypasses the GATE, not the COUNT. If both are empty, the
#   tick falls back to the normal `concurrency-cap` disposition and reseed. (The
#   `dispatch-select-target --priority-only` probe this bypass used to run was
#   deleted with the rest of the gh-issue lane in tactic-dispatch-legacy-rewire
#   Unit 3 — the graph selector and repo-health now own it entirely.)
#
#   Selection lock: the selection lock (`dispatch-acquire-lock`, acquired inside
#   `dispatch-select-tick`) is shared with the autonomous chain, so a manual run
#   cannot select the same target as an in-flight tick. Merge conflicts are handled
#   by the `/dispatch-conflict` phase routed through the worker.
#
# Behavior:
#   0. Frozen-session sweep (denied-command park, tactic-denied-command-parks-node):
#      calls lib-frozen-session-park.sh's `frozen_session_sweep` — no args, always
#      returns 0 — to park the graph node of any worker session frozen at a
#      permission/classifier denial (`claude agents` reports `state: blocked` with
#      a stale transcript). Runs on BOTH cadences: (a) the paused-branch early exit
#      (Step "Pause sentinel" below), alongside that branch's own
#      `reservation_sweep`, since that is the only autonomous path that never
#      reaches dispatch-select-tick's sweep; and (b) the normal path, immediately
#      after the per-tick `claude agents` snapshot capture and before Step 1's
#      `dispatch-select-tick` invocation. On the normal path it runs before
#      selection for two reasons: it reuses this tick's single daemon snapshot
#      instead of an extra round-trip, and any node the sweep parks lands
#      `office_hours` on `main` before Step 1 selects, so this tick's own
#      selection already excludes it. A load failure of
#      lib-frozen-session-park.sh is logged loudly and never aborts the tick — the
#      sweep is observability/containment, not a gate.
#   0.5 Terminal-without-disposition sweep (tactic-phase-terminal-requires-disposition):
#      calls lib-frozen-session-park.sh's `terminal_without_disposition_sweep` — no
#      args, always returns 0 — to surface any worker session whose graph node
#      reached a terminal Claude-agent state (`state: done`/`error`) without a
#      recorded disposition. Runs on the same two cadences as the frozen-session
#      sweep above, immediately after it, for the same reason: the paused-branch
#      `exit 0` is the only autonomous path that never reaches
#      dispatch-select-tick's own sweeps. On the normal path its placement before
#      Step 1 buys ONE thing only — any node it parks is already excluded from
#      this tick's own selection. It does NOT share the tick's daemon snapshot:
#      `claude_agents_list_terminal_workers` queries `claude agents --json --all`
#      DIRECTLY, because the snapshot is captured without `--all` and so lacks the
#      terminal rows the sweep exists to find, so the sweep costs one extra daemon
#      round-trip (its stand-down interlock's ACTIVE-view read IS
#      snapshot-backed). A load failure of lib-frozen-session-park.sh is logged
#      loudly and never aborts the tick.
#   1. Run dispatch-select-tick, echoing all of its stdout through (the
#      jit:/calendar: passthrough lines AND the decision line) so journald and a
#      live relay both see the narrative. The decision is its LAST stdout line.
#   2. Route on the decision line:
#        busy / concurrency-cap / sync-repair-pending / sync-broken
#                          → log a one-line note; exit 0. (select-tick already
#                            released the lock / scheduled any reseed.)
#        empty             → log a one-line note; exit 0. On the autonomous
#                            path additionally invokes dispatch-tick-recover
#                            (the #1445 continuation backstop, autonomous-only).
#        NOTE: on the autonomous path, `concurrency-cap` is emitted by
#        select-tick only after the pace-exempt bypass runs (see above):
#        at-cap + exhausted → concurrency-cap immediately;
#        at-cap + not exhausted + no pace-exempt/main-broken item → concurrency-cap;
#        at-cap + not exhausted + graph pace-exempt node → graph decision;
#        at-cap + not exhausted + newly-red main → main-broken decision.
#        main-broken <sha> → spawn /dispatch-diagnose-main <sha> as a bg job via
#                            dispatch-spawn-job (--name diagnose-main); exit 0.
#        sync-failed       → spawn /commit-merge-push as a bg job via
#                            dispatch-spawn-job (--name sync-repair) on the main
#                            worktree to auto-repair the wedged local main; exit 0.
#        jit-reminder ...  → spawn /dispatch-jit-reminder ... as a bg job via
#                            dispatch-spawn-job (--name jit-reminder-<num>); exit 0.
#        graph <count> <id:kind:phase>... → dispatch-graph-execute <spec>...
#                            (tactic-graph-router-selector: the graph lane's
#                            workflow-native execute path — the ONLY queue lane
#                            now). The lock is already released; the per-node
#                            reservations are the claim. On the autonomous path a
#                            successful execute arms a convergence reseed.
#        anything else     → diagnostic to stderr; exit 2.
#   3. Run the stand-down winner-liveness re-check sweep
#      (standdown_recheck_sweep, lib-standdown-recheck.sh) on TWO cadences: on
#      the paused branch (so a stranded stand-down marker still surfaces even
#      while dispatch is paused — that `exit 0` is the only autonomous path
#      that never reaches dispatch-select-tick's own sweeps), and on the
#      normal path, after the per-tick daemon snapshot is captured and before
#      Step 1 target selection (so it reuses the snapshot and any node it
#      parks is already excluded from this tick's own selection). Never gates
#      the tick — a load failure logs loudly and the tick continues.
#   4. Run the terminal-without-disposition sweep
#      (terminal_without_disposition_sweep, lib-frozen-session-park.sh, see
#      Behavior item 0.5 above) on the same two cadences as the frozen-session
#      sweep it is paired with. Never gates the tick — a load failure logs
#      loudly and the tick continues.
#   5. On the PAUSED branch only: drain the node lane (graph-auto-merge +
#      reconcile-graph-merged, both called unconditionally — graph-auto-merge
#      owns its own main-health admission gate internally) before the `exit 0`. A paused tick
#      schedules nothing but still lands reviewed, green node-lane PRs — see
#      the pause-sentinel block for the operator-facing statement of that
#      contract and for the three preconditions (main-checkout sync, the
#      selection lock, and a `timeout` around each drain call).
#
# The legacy gh-issue lane (explicit/pr/issue decisions →
# dispatch-materialize-spawn → dispatch-launch-worker, and the recoverable-death
# scan) was deleted in tactic-dispatch-legacy-rewire Unit 3; graph work runs
# through dispatch-graph-execute and its own per-node lifecycle.
#
# Requires `dangerouslyDisableSandbox: true` — the sub-scripts call `gh`, query
# the local Claude daemon over a Unix socket, and write tmp state (see
# `.claude/rules/sandbox.md`). dispatch-select-tick's `--wait` lock acquisition
# also needs an elevated Bash `timeout` (see SKILL.md Step 0).
#
# Manual inspection of the autonomous tick's journal (once systemd drives it):
#   journalctl --user -t dispatch-tick
#
# Exit codes: 0 on a routed disposition; 2 on an internal/usage error surfaced on
# stderr.
#
# NOT set -e: exits are handled explicitly (matching the sibling dispatch scripts).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

# --- Single cleanup trap for this tick (sentinel + workspace) (#1068, #1452) --
# Bash `trap` OVERWRITES per signal — it does not stack. The headless-liveness
# sentinel (#1068) and the per-tick snapshot workspace (#1452) both
# need removal on exit, so ONE cleanup function handles both and ONE trap installs
# it. A second `trap ... EXIT` anywhere below would silently drop one of these.
# SENTINEL is declared empty here and set later only on the headless path; the
# `${SENTINEL:-}` guard keeps cleanup safe under `set -u` regardless.
#
# Install the trap BEFORE the workspace creation and the sentinel write below, so
# it clears a partial workspace or partial sentinel if either setup fails and we
# abort. A single EXIT trap covers every `exit` below this point — intended.
#
# A SIGNAL MUST STOP THE TICK, NOT JUST TIDY UP AFTER IT. A single combined
# `trap fn EXIT INT TERM` whose handler only cleans up and RETURNS hands control
# straight back to the interrupted tick, which then carries on running with the
# headless-liveness sentinel ALREADY DELETED — so a concurrent tick resolves
# this still-live holder as dead and reclaims the selection lock mid-selection,
# which is the exact duplicate-spawn defect #1068 closes. So INT and TERM get
# their own registrations, and the handler TERMINATES the tick.
#
# IT TERMINATES BY RE-RAISING THE SIGNAL, NOT BY `exit 143`. systemd counts
# death by SIGHUP/SIGINT/SIGTERM/SIGPIPE as a clean stop but a 143/130 EXIT
# STATUS as a failure, and both units that run this script carry
# `OnFailure=dispatch-tick-recover.service`: the heartbeat service (lib.sh's
# `desired_service`) and the transient unit dispatch-spawn-tick launches. So
# exiting 143 would make an ordinary `systemctl --user stop
# dispatch-heartbeat.service` mid-tick arm a backstop reseed that relaunches the
# chain minutes later, and repeats escalate to a `dispatch:chain-stalled` issue.
# Clearing the handler's own registration and `kill`ing ourselves restores the
# default disposition, so the tick dies of the signal it was sent. A waiting
# shell still sees 143/130 — `wait` reports 128+signo for signal death — so
# callers and tests are unaffected. (dispatch-ladder-run does NOT do this: it
# has no OnFailure, by deliberate design — see dispatch-ladder-spawn:42-49.)
#
# DYING OF THE SIGNAL IS NOT BY ITSELF ENOUGH ON THE HEARTBEAT UNIT. That
# clean-stop rule is spelled with a carve-out — systemd.service(5), under
# `SuccessExitStatus=`: "in addition to the normal successful exit status 0 and,
# EXCEPT FOR Type=oneshot, the signals SIGHUP, SIGINT, SIGTERM, and SIGPIPE".
# dispatch-heartbeat.service IS Type=oneshot, so for that unit alone a re-raised
# SIGTERM would still end it `Failed with result 'signal'` and fire the
# OnFailure= anyway. lib.sh's `desired_service` therefore also carries
# `SuccessExitStatus=SIGTERM SIGINT`, and the two halves only work together:
# without the re-raise the exit STATUS fails the unit, without that line the
# SIGNAL fails it. The transient unit sets no Type=, so it is Type=simple and
# gets the carve-out already.
#
# `trap - EXIT` FIRST, because a signal handler that calls `exit` DOES run the
# EXIT trap afterwards — `exit` only fails to re-enter the trap it is already
# inside, which on the signal path is the INT/TERM trap and not this one.
# Without it the whole body would run a second time on every signal. Clearing
# it makes cleanup run exactly once on every path.
#
# `$?` is captured by hand on the FIRST line, before any command in the body can
# overwrite it, so the plain EXIT path still reports the tick's real status. It
# cannot be read from `$?` on the signal path: at handler entry on a signal `$?`
# is the last COMPLETED command's status, NOT 128+signo — which is why the two
# statuses are passed as literal arguments too. The trailing `exit "$rc"` is
# then unreachable on the signal path (the re-raise kills us first) and is kept
# only as the backstop for a `kill` that somehow does not land. Same shape as
# `vi_exit_trap` in test-dispatch-verify-instrument-invocation.sh, plus the
# re-raise.
SENTINEL=""
# The paused-branch node-lane drain below is the ONE place this script holds the
# selection lock in its own process; every other hold belongs to
# dispatch-select-tick, which acquires and releases it inside its own. Set to 1
# by that drain's acquire and back to 0 by its unconditional release, so a
# signal landing between the two does not strand the lock. It matters most for
# an INHERITED real session id (a hand-run tick, Ctrl-C during graph-auto-merge):
# there is no sentinel on that path, so resolve_holder_state asks the daemon,
# finds the session LIVE, and nothing reclaims the lock until it ages past
# MAX_HOLD_SECONDS (dispatch-acquire-lock, default 300s). The headless case
# self-heals through the removed sentinel and so hides this entirely.
TICK_LOCK_HELD=0
_dispatch_tick_cleanup() {
  local rc=${1:-$?} sig="${2:-}"
  if (( TICK_LOCK_HELD )); then
    "$SCRIPT_DIR/dispatch-acquire-lock" --release >/dev/null 2>&1 || true
    TICK_LOCK_HELD=0
  fi
  [[ -n "${SENTINEL:-}" ]] && rm -f "$SENTINEL"
  [[ -n "${DISPATCH_TICK_WORKSPACE:-}" ]] && rm -rf "$DISPATCH_TICK_WORKSPACE"
  trap - EXIT
  if [[ -n "$sig" ]]; then
    trap - "$sig"
    kill -"$sig" "$$"
  fi
  exit "$rc"
}
trap '_dispatch_tick_cleanup' EXIT
trap '_dispatch_tick_cleanup 130 INT' INT
trap '_dispatch_tick_cleanup 143 TERM' TERM

# Tick-scoped workspace holding the agents snapshot (#1452). Created
# unconditionally (both the autonomous and --manual paths run the
# selection/fan-out that consumes the snapshot), independent of the headless
# sentinel dir. The cleanup trap above removes it on every exit.
DISPATCH_TICK_WORKSPACE=$(mktemp -d "${TMPDIR:-/tmp}/dispatch-tick.XXXXXX")

# Resolve the canonical main worktree — the --cwd for the advisory diagnose-main
# and jit-reminder bg jobs. These are repo-global concerns (diagnose origin/main
# CI; remind about a JIT issue), not feature-worktree work, so they must spawn
# under one stable directory regardless of who invoked the tick. dispatch-spawn-job
# dedups on `--name` *under <cwd>*: pinning --cwd to the main worktree keeps that
# dedup consistent across the headless path (where $PWD is already the main
# worktree) and the terminal `dispatch` command (where $PWD is the caller's
# worktree) — otherwise a manual `dispatch` run could spawn a duplicate of a job
# the headless tick already started. Same idiom as dispatch-spawn-tick /
# dispatch-schedule-reseed; an explicit DISPATCH_TICK_MAIN_WORKTREE is
# authoritative and bypasses the git lookup (tests rely on this).
if [[ -n "${DISPATCH_TICK_MAIN_WORKTREE:-}" ]]; then
  MAIN_WORKTREE="$DISPATCH_TICK_MAIN_WORKTREE"
else
  PROJECT_ROOT=$(resolve_project_root) \
    || { echo "dispatch-tick: not in a git repo and DISPATCH_TICK_MAIN_WORKTREE is unset" >&2; exit 2; }
  MAIN_WORKTREE="$PROJECT_ROOT"   # de-bare: the project root IS the main checkout
fi

# --- Topic-usage daily producer (#2505) -------------------------------------
# Env-gated, detached, best-effort: launch topic-usage-writer.mjs once per UTC
# day to write per-topic/per-type token cost to Firestore.  The gate is OFF by
# default (DISPATCH_TOPIC_USAGE_ENABLED unset or not "1") so existing behaviour
# is completely unchanged on every normal tick.
#
# The producer OWNS sentinel writes; the tick only READS the sentinel to decide
# whether to launch, avoiding relaunching on every (frequent) tick. This
# once-per-UTC-day launch still yields COMPLETE day docs because the writer
# finalizes in arrears: each run re-produces the sentinel's last-day doc (whose
# earlier write captured only a partial day) before writing today's provisional
# snapshot, so day D's doc reflects the full day after the first tick of D+1.
if [[ "${DISPATCH_TOPIC_USAGE_ENABLED:-}" == "1" ]]; then
  _TU_GROUP_ID="${DISPATCH_TOPIC_USAGE_GROUP_ID:-}"
  if [[ -z "$_TU_GROUP_ID" ]]; then
    echo "dispatch-tick: WARNING: DISPATCH_TOPIC_USAGE_ENABLED=1 but DISPATCH_TOPIC_USAGE_GROUP_ID is unset; skipping topic-usage producer" >&2
  else
    _TU_STATE_DIR="${DISPATCH_TOPIC_USAGE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dispatch}"
    _TU_SENTINEL="$_TU_STATE_DIR/topic-usage-${_TU_GROUP_ID}.last-day"
    _TU_TODAY="$(date -u +%Y-%m-%d)"
    _TU_ALREADY_RAN=0
    if [[ -f "$_TU_SENTINEL" ]]; then
      _TU_LAST="$(cat "$_TU_SENTINEL")"
      if [[ "$_TU_LAST" == "$_TU_TODAY" ]]; then
        _TU_ALREADY_RAN=1
      fi
    fi
    if [[ "$_TU_ALREADY_RAN" == "0" ]]; then
      WRITER="${DISPATCH_TOPIC_USAGE_WRITER:-$SCRIPT_DIR/../../rsi-audit/scripts/topic-usage-writer.mjs}"
      mkdir -p "$_TU_STATE_DIR" 2>/dev/null || true
      # Launch detached so the producer survives tick exit and never blocks the
      # tick (a first-run backfill can take a while).  Backgrounding with `&`
      # inside the subshell always exits 0 after the fork, so a trailing `||`
      # can never observe a launch failure — check the precondition (node on
      # PATH) synchronously here and surface a missing-node error on the tick's
      # stderr at tick time.  Errors from node itself are captured in the log.
      if ! command -v node >/dev/null 2>&1; then
        echo "dispatch-tick: WARNING: node not found; topic-usage producer skipped" >&2
      else
        ( setsid node "$WRITER" >>"$_TU_STATE_DIR/topic-usage-producer.log" 2>&1 </dev/null & )
      fi
    fi
  fi
fi

# --- Step 0: parse flags -----------------------------------------------------
# Explicit issue/PR targeting (`dispatch-tick <N>`) was the legacy issue lane's
# entry point; that lane is gone and the graph selector owns target selection
# (dispatch-select-tick rejects any positional arg itself). Reject one here too,
# before any setup below runs.
MANUAL=""
NODE_ARG=""
ALLOW_STALE=""
for a in "$@"; do
  case "$a" in
    --manual) MANUAL=1 ;;
    --allow-stale) ALLOW_STALE=1 ;;
    --*)
      echo "dispatch-tick: unknown flag '$a'" >&2
      echo "usage: dispatch-tick [--manual] [--allow-stale] [<node-id>]" >&2
      exit 2
      ;;
    *)
      # A positional arg shaped like a graph node id
      # (tactic-graph-explicit-node-dispatch Unit 2) is the explicit
      # single-node targeting entry point; the graph selector owns everything
      # else. Reuse provision-node-worktree's node-id slug regex verbatim.
      if [[ "$a" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
        NODE_ARG="$a"
      else
        echo "dispatch-tick: explicit issue/PR targeting ('${a#\#}') was removed with the legacy issue lane; the graph selector owns target selection" >&2
        echo "usage: dispatch-tick [--manual] [--allow-stale] [<node-id>]" >&2
        exit 2
      fi
      ;;
  esac
done

# --manual (the "no specific target" fan-out mode) and an explicit single-node
# target are semantically incompatible. Reject the combination HERE — the if/elif
# dispatch below would otherwise silently take the --manual branch and drop the
# named node. dispatch-select-tick guards the same combination and exits 2, but
# it never sees both (the elif forwards only one), so mirror the guard at this
# entry point rather than leaving it unreachable.
if [[ -n "$MANUAL" && -n "$NODE_ARG" ]]; then
  echo "dispatch-tick: a node-id argument cannot be combined with --manual" >&2
  echo "usage: dispatch-tick [--manual] [--allow-stale] [<node-id>]" >&2
  exit 2
fi

# --allow-stale is an operator override for a specific dispatch act (a manual
# fan-out or an explicit single-node target) — it has no meaning on the fully
# autonomous no-flags-no-node tick, which has no operator present to attest an
# unverified snapshot. Reject that combination here, before any setup below.
if [[ -n "$ALLOW_STALE" && -z "$MANUAL" && -z "$NODE_ARG" ]]; then
  echo "dispatch-tick: --allow-stale requires --manual or an explicit <node-id> (the autonomous tick has no operator to attest an unverified snapshot)" >&2
  echo "usage: dispatch-tick [--manual] [--allow-stale] [<node-id>]" >&2
  exit 2
fi

# --- Synthesize a session identity for the headless tick ---------------------
# The terminal `dispatch` command may or may not run inside a .claude session:
# when invoked from within a Claude session it inherits a stable
# CLAUDE_CODE_SESSION_ID, so the `:-` fallback below never fires for it; when run
# from a plain terminal the env var is absent. A systemd-launched tick likewise
# starts from a clean environment (systemd-run --user forwards only PATH), so it
# inherits no session id — yet dispatch-acquire-lock
# hard-requires one (exit 2 if unset) to key the selection lock on a stable
# holder. Declare a synthetic, stable id here, at the single headless entry
# point, so every sub-script invoked below (dispatch-select-tick →
# dispatch-acquire-lock, the materialize-spawn hold, and the release) sees one
# consistent holder id across the acquire / hold / release of this tick. Derive
# it from the systemd unit's INVOCATION_ID (set by systemd, identical across all
# subprocesses of the unit and unique per tick), falling back to a random token
# (openssl rand -hex 16) when INVOCATION_ID is absent, with the dispatch-tick PID
# ($$) as last resort if openssl is unavailable. The random token (or PID) is
# evaluated once at export time and frozen into the value, so all children see
# the same fixed string. Exported once so all children agree. (#1068)
#
# Placement: this block sits ABOVE the pause sentinel below, not after it,
# because the paused branch now takes the selection lock for its node-lane drain
# (see that branch's own comment). dispatch-acquire-lock hard-requires a holder
# id, and a `headless:*` holder is only resolvable as live through the sentinel
# written here — so a paused tick needs both before it can safely hold the lock.
#
# INVOCATION_ID validation (#1068, same-user threat model): under systemd
# INVOCATION_ID is always 32 lowercase hex chars. A manually-set value containing
# a newline would truncate the recorded holder in the lock file (causing a
# self-release noop → one-tick lock stall); a backslash or control sequence could
# mislead the `awk -F'\t'` comparison in dispatch-acquire-lock or corrupt the
# sentinel path (dispatch-tick-<token>.live). Drop any non-conforming value so
# the random-token fallback fires instead. Hex digits plus hyphen cover both the
# standard 32-hex form and any UUID-style variant.
[[ "${INVOCATION_ID:-}" =~ ^[0-9a-fA-F-]+$ ]] || INVOCATION_ID=""
#
# Headless-liveness sentinel (#1068). A synthetic `headless:*` id is a bash
# string that never appears in `claude agents --json`, so dispatch-acquire-lock's
# resolve_holder_state cannot resolve its liveness through the daemon registry —
# a concurrent tick would read this LIVE holder as dead and reclaim the lock
# mid-selection. To give the headless holder a daemon-independent liveness
# signal, write a sentinel containing this tick's PID alongside the shared lock
# file and install a single EXIT/INT/TERM trap to remove it; resolve_holder_state
# treats the holder as live iff the sentinel exists and its PID is alive. Only a
# synthesized id writes a sentinel — a real inherited session id is governed by
# the daemon path and writes none. $$ is the tick PID, recorded in the sentinel
# content regardless of whether the id token uses it.
#
# Two failure modes, two dispositions (#1068):
#   - The lock-file path cannot be resolved (not in a git repo and
#     DISPATCH_LOCK_FILE unset): skip the sentinel silently. The daemon path
#     still governs real ids, and a headless tick that cannot resolve the lock
#     file also cannot acquire the lock (dispatch-acquire-lock exits 2), so it
#     never reaches selection — there is nothing to serialize.
#   - The path resolves but the sentinel write fails (e.g. an over-long token
#     yielding ENAMETOOLONG while the short dispatch.lock stays writable): fail
#     clear with exit 2. Continuing here would let this tick acquire the lock
#     with no liveness sentinel, so a concurrent tick reads this LIVE holder as
#     dead and reclaims mid-selection — the exact duplicate-spawn defect #1068
#     closes. Per .claude/rules/code-style.md, fail clear rather than degrade
#     the concurrency guarantee silently; the chain self-heals on the next tick.
export CLAUDE_CODE_SESSION_ID="${CLAUDE_CODE_SESSION_ID:-headless:${INVOCATION_ID:-$(openssl rand -hex 16 2>/dev/null || echo "$$")}}"
if [[ "$CLAUDE_CODE_SESSION_ID" == headless:* ]]; then
  if SENTINEL_LOCK_FILE=$(dispatch_lock_file); then
    SENTINEL=$(headless_sentinel_path "$CLAUDE_CODE_SESSION_ID" "$SENTINEL_LOCK_FILE")
    mkdir -p "$(dirname "$SENTINEL")" 2>/dev/null || true
    # The consolidated EXIT/INT/TERM trap installed near the top of this script
    # already covers this write: SENTINEL is set just above, so a partial sentinel
    # is cleared if the write fails and we abort below.
    if ! printf '%s\n' "$$" >"$SENTINEL"; then
      echo "dispatch-tick: ERROR: failed to write headless sentinel '$SENTINEL'; cannot signal liveness — aborting so a concurrent tick does not reclaim this lock mid-selection (#1068)" >&2
      exit 2
    fi
  fi
fi

# refresh_lock — bump the selection lock's mtime (its heartbeat) so a
# legitimately-long paused-branch drain never goes stale under the staleness
# cap (MAX_HOLD_SECONDS, dispatch-acquire-lock:227, default 300). The drain
# below runs graph-auto-merge and reconcile-graph-merged back to back, each
# under its own DISPATCH_PAUSED_DRAIN_TIMEOUT_S budget (default 600), so the
# combined hold can reach 1200s against the 300s default cap — without a
# heartbeat in between, a second paused tick's `--wait` would read the lock as
# stale and reclaim it mid-drain. Call ONLY between the two drain calls, on
# graph-auto-merge's completion, never inside a loop — INVARIANT #2
# (dispatch-acquire-lock:96-103): a refresh inside a poll/wait loop would keep
# the mtime fresh while the holder spins there, defeating the cap. Modelled on
# dispatch-select-tick's refresh_lock (dispatch-select-tick:198-200) and
# graph-select-target's _refresh_lock (graph-select-target:599-601).
# Best-effort: a noop (we no longer hold the lock) or any error is swallowed.
refresh_lock() {
  "$SCRIPT_DIR/dispatch-acquire-lock" --heartbeat >/dev/null 2>&1 || true
}

# --- Pause sentinel: stop autonomous scheduling, keep the node lane draining ---
# When the pause flag file exists, an AUTONOMOUS tick (heartbeat timer, reseed
# timer) SCHEDULES nothing: it never reaches dispatch-select-tick, spawns no
# worker, and arms no follow-up reseed. Already-running workers are separate
# sessions and are left untouched, so they run to completion. This is the
# durable, non-interfering pause: unlike stopping/masking the systemd timers
# (which ensure_heartbeat_units recreates on the next tick), a firing timer here
# becomes a harmless no-op. A manual `dispatch --manual` run OVERRIDES the pause
# (deliberate human action). Resume by removing the flag file. The path is
# overridable for tests.
#
# A paused tick is NOT inert, and if you are pausing during an incident, read
# this literally: before its `exit 0` the branch below reaps the reservation
# ledger, runs the four other sweeps, and DRAINS THE NODE LANE — a reviewed,
# green, unparked node-lane PR is still squash-merged to `main` by
# graph-auto-merge and absorbed by reconcile-graph-merged. The sentinel gates
# worker SPAWNING and scheduling; it does not gate ledger bookkeeping, and it
# does not freeze `main`. To stop code landing as well, remove the `reviewed`
# marker or park the node (`park-node`) — an `office_hours` park is the one
# thing graph-auto-merge will not merge past.
DISPATCH_PAUSE_FLAG="${DISPATCH_PAUSE_FLAG:-${XDG_DATA_HOME:-$HOME/.local/share}/commons-dispatch/paused}"
if [[ -z "$MANUAL" && -e "$DISPATCH_PAUSE_FLAG" ]]; then
  # A dead session's reservation marker must still be reaped even on a paused
  # heartbeat, or it lingers stranded until dispatch resumes. This `exit 0` is the
  # ONLY autonomous tick path that never reaches dispatch-select-tick's own
  # reservation_sweep (dispatch-select-tick:583), so the reap belongs HERE and
  # only here. Sweeping unconditionally ahead of this branch would both duplicate
  # that sweep on every non-paused tick and cost one extra LIVE
  # `claude agents --json` round-trip per heartbeat, because the per-tick registry
  # snapshot that makes select-tick's sweep free (#1452) is not captured until
  # further below.
  if ! declare -f reservation_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-claude-agents.sh"
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-reservation-ledger.sh"
  fi
  # Verify the load explicitly rather than absorbing failures with `|| true`.
  # reservation_sweep's contract is "return 0 — always", so a non-zero status
  # here could only mean the sources above failed (file missing, unreadable,
  # truncated) and the function is an undefined command. This script does not
  # use `set -e`, so a swallowed exit 127 would silently disable ledger
  # reconciliation for the whole pause — indistinguishable from a healthy quiet
  # ledger to dispatch-reclaim-audit, which mines the tick journal for reclaim
  # notes. Fail loud and greppable instead (see .claude/rules/code-style.md).
  if declare -f reservation_sweep >/dev/null 2>&1; then
    reservation_sweep 1>&2
  else
    echo "dispatch-tick: lib-reservation-ledger.sh failed to load; reservation ledger NOT swept this tick" >&2
  fi

  # A stranded stand-down marker (winner session died mid-work, loser waiting
  # forever) must still surface even while dispatch is paused, for the same
  # reason the reservation sweep runs on this branch: this `exit 0` path is the
  # ONLY autonomous tick path that never reaches dispatch-select-tick's own
  # sweeps, so nothing else would ever re-check a stand-down marker while
  # paused. Same conditional-source + verify + loud-failure idiom as
  # reservation_sweep above, applied to lib-standdown-recheck.sh.
  if ! declare -f standdown_recheck_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-standdown-recheck.sh"
  fi
  if declare -f standdown_recheck_sweep >/dev/null 2>&1; then
    standdown_recheck_sweep 1>&2
  else
    echo "dispatch-tick: lib-standdown-recheck.sh failed to load; stand-down re-check NOT run this tick" >&2
  fi

  # A tracked hold that outlived the condition it tracks (tactic-stale-hold-auto-resolve)
  # must still get re-checked even while dispatch is paused — the same reason the
  # stand-down sweep above is here: this `exit 0` path is the ONLY autonomous tick
  # path that never reaches dispatch-select-tick's own sweeps, so nothing else
  # would ever re-check a stale hold while dispatch is paused. Same
  # conditional-source + verify + loud-failure idiom as the sweeps above, applied
  # to lib-stale-hold-recheck.sh.
  if ! declare -f stale_hold_recheck_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-stale-hold-recheck.sh"
  fi
  if declare -f stale_hold_recheck_sweep >/dev/null 2>&1; then
    stale_hold_recheck_sweep 1>&2
  else
    echo "dispatch-tick: lib-stale-hold-recheck.sh failed to load; stale-hold re-check NOT run this tick" >&2
  fi

  # A calendar-scheduled WAIT (attributes.wait_until, tactic-wait-calendar-release)
  # must still get re-checked even while dispatch is paused — the same reason the
  # stale-hold sweep above is here: this `exit 0` path is the ONLY autonomous tick
  # path that never reaches dispatch-select-tick's own sweeps, so a WAIT would
  # otherwise never release while dispatch is paused (a supported standing
  # operating mode, not a degraded one). Same conditional-source + verify +
  # loud-failure idiom as the sweeps above, applied to lib-wait-recheck.sh.
  if ! declare -f wait_recheck_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-wait-recheck.sh"
  fi
  if declare -f wait_recheck_sweep >/dev/null 2>&1; then
    wait_recheck_sweep 1>&2
  else
    echo "dispatch-tick: lib-wait-recheck.sh failed to load; calendar-wait re-check NOT run this tick" >&2
  fi

  # A node frozen at a permission/classifier denial (tactic-denied-command-parks-node)
  # must still surface to office_hours even while dispatch is paused — this is the
  # same "only autonomous path that never reaches select-tick's own sweeps" reason
  # the reservation sweep above is here. Same conditional-source idiom, same
  # loud-failure-instead-of-swallow posture (.claude/rules/code-style.md).
  if ! declare -f frozen_session_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-claude-agents.sh"
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-frozen-session-park.sh"
  fi
  if declare -f frozen_session_sweep >/dev/null 2>&1; then
    frozen_session_sweep 1>&2
  else
    echo "dispatch-tick: lib-frozen-session-park.sh failed to load; frozen-session sweep NOT run this tick" >&2
  fi

  # A worker session whose graph node reached a terminal Claude-agent state
  # without a recorded disposition (tactic-phase-terminal-requires-disposition)
  # must still surface even while dispatch is paused — the same "only autonomous
  # path that never reaches select-tick's own sweeps" reason the frozen-session
  # sweep above is here. Same conditional-source idiom, same loud-failure-instead
  # -of-swallow posture (.claude/rules/code-style.md).
  if ! declare -f terminal_without_disposition_sweep >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-claude-agents.sh"
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib-frozen-session-park.sh"
  fi
  if declare -f terminal_without_disposition_sweep >/dev/null 2>&1; then
    terminal_without_disposition_sweep 1>&2
  else
    echo "dispatch-tick: lib-frozen-session-park.sh failed to load; terminal-disposition sweep NOT run this tick" >&2
  fi

  # Print the paused banner BEFORE the node-lane merge/reconcile drain below so
  # an operator scanning `journalctl --user -t dispatch-tick` reads the pause
  # state first and interprets the following `merge:`/`reconcile-graph:` lines
  # as the paused-branch drain, not as scheduling activity. (`-t`, the syslog
  # identifier this script logs under — there is no dispatch-tick.service, so
  # `-u dispatch-tick` matches nothing.)
  echo "dispatch-tick: paused (sentinel present at $DISPATCH_PAUSE_FLAG); no scheduling this tick; draining node-lane merge/reconcile only"

  # --- Paused-branch node-lane drain ------------------------------------------
  # A reviewed, green node-lane PR must still merge even while dispatch is
  # paused — the pause sentinel gates worker SPAWNING and scheduling (see the
  # block comment above), never ledger bookkeeping or draining, and this exit 0 path is
  # the ONLY autonomous tick path that never reaches dispatch-select-tick's own
  # merge/reconcile calls, so pausing spawning would otherwise also stop
  # already-reviewed green PRs from landing. Run graph-auto-merge (which gates
  # itself on main health — see the note at its call below), then
  # reconcile-graph-merged, so a merge from this tick (or an earlier one) is
  # absorbed to done/main-qa. These are plain
  # subprocess invocations of dispatch-select-tick's own scripts, not sourced
  # library functions, so the conditional-source + verify + loud-failure idiom
  # used for the sweeps above does not apply here.
  #
  # Three preconditions guard the drain, because it is the one thing on this
  # branch that makes an IRREVERSIBLE change to `main` (a squash-merge):
  #
  #   a. The main checkout is synced with origin/main. graph-auto-merge
  #      enumerates its candidate set from the LOCAL working tree
  #      (listNodesStrict("./intentions")) and reads each node's `office_hours`
  #      from it. The routine things that advance that checkout are
  #      dispatch-select-tick's Step 1 sync — which this branch exits before —
  #      and provision-node-worktree's own sync, which only runs when a worker
  #      is being provisioned (i.e. not during a pause). During a
  #      standing pause nothing else would ever refresh it, so the drain would
  #      run forever against the tree as it stood when the pause began: a node
  #      reviewed after the pause is invisible (the drain does nothing), and an
  #      `office_hours` park or `execution.conflict` interrupt landed after the
  #      pause is invisible too (the drain merges straight past the park that
  #      exists to stop it). So sync FIRST, mirroring select-tick's guards
  #      (only on the `main` branch, honoring DISPATCH_TICK_MAIN_WORKTREE), and
  #      SKIP the whole drain loudly when the sync fails. `--ff-only` doubles as
  #      the dirty/diverged-tree guard: reconcile-graph-merged writes node files
  #      into this tree and pushes through graph-commit, so a wedged tree must
  #      not be drained into. Deliberately NOT copied from select-tick: its
  #      sync_repair_* escalation (reseed arming, /commit-merge-push spawn,
  #      dispatch:sync-broken latch). That is select-tick's job; here a failed
  #      sync just skips, and the next tick retries.
  #   b. The selection lock is held. dispatch-select-tick holds
  #      `dispatch-acquire-lock --wait` across these same calls, and neither
  #      graph-auto-merge (nor the `dispatch-graph-main-red-sync --read-only`
  #      read it now makes internally) nor reconcile-graph-merged locks
  #      internally. `dispatch --manual` is permitted during a pause and
  #      the reseed/spawn units are distinct from dispatch-heartbeat.service, so
  #      two ticks can otherwise overlap on this worktree. `busy` (another tick
  #      is draining) skips this drain — the next tick retries.
  #   c. Each drain script runs under `timeout`. dispatch-heartbeat.service is
  #      Type=oneshot, for which systemd disables TimeoutStartSec by default: a
  #      drain hung on an unbounded `gh` call would leave the unit `activating`
  #      forever and every later timer fire would be skipped, silently stopping
  #      the reservation reap and park sweeps for the rest of the pause. Same
  #      bounded-call idiom as lib-frozen-session-park.sh's park-node wrapper
  #      (resolve `timeout` explicitly; a missing binary is a loud skip, not a
  #      silent unbounded call). A timeout is never fatal to the tick: it is
  #      logged and the tick still exits 0.
  DRAIN_MAIN_BRANCH=$(git -C "$MAIN_WORKTREE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  DRAIN_SYNC_OK=0
  if [[ "$DRAIN_MAIN_BRANCH" != "main" ]]; then
    echo "dispatch-tick: WARNING: main checkout '$MAIN_WORKTREE' is on branch '${DRAIN_MAIN_BRANCH:-<unresolved>}', not 'main'; SKIPPING the paused-branch node-lane merge/reconcile drain this tick (a drain against a non-main checkout would merge from a stale candidate set)" >&2
  else
    # sync_main_checkout (lib.sh) is the shared fetch+ff-merge: same two git
    # calls in the same order this branch open-coded, with rc 1 = fetch failed
    # and rc 2 = merge failed so the two warnings below stay distinct. Captured
    # with `|| rc=$?` so a non-zero return is a value here, never a control-flow
    # surprise.
    DRAIN_SYNC_RC=0
    sync_main_checkout "$MAIN_WORKTREE" || DRAIN_SYNC_RC=$?
    if [[ "$DRAIN_SYNC_RC" -eq 1 ]]; then
      echo "dispatch-tick: WARNING: 'git fetch origin main' failed in '$MAIN_WORKTREE'; SKIPPING the paused-branch node-lane merge/reconcile drain this tick (draining against a stale checkout would merge past parks landed since the pause began)" >&2
    elif [[ "$DRAIN_SYNC_RC" -ne 0 ]]; then
      echo "dispatch-tick: WARNING: 'git merge --ff-only origin/main' failed in '$MAIN_WORKTREE' (tree dirty or diverged); SKIPPING the paused-branch node-lane merge/reconcile drain this tick — select-tick's sync-repair escalation does not run while paused, so this tree needs a human" >&2
    else
      DRAIN_SYNC_OK=1
    fi
  fi

  if (( DRAIN_SYNC_OK )); then
    DRAIN_TIMEOUT_BIN=$(command -v timeout 2>/dev/null) || DRAIN_TIMEOUT_BIN=""
    DRAIN_TIMEOUT_S="${DISPATCH_PAUSED_DRAIN_TIMEOUT_S:-600}"
    [[ "$DRAIN_TIMEOUT_S" =~ ^[0-9]+$ ]] || DRAIN_TIMEOUT_S=600
    if [[ -z "$DRAIN_TIMEOUT_BIN" ]]; then
      echo "dispatch-tick: WARNING: \`timeout\` not found; refusing to run an unbounded merge/reconcile drain on a Type=oneshot heartbeat; SKIPPING the paused-branch node-lane drain this tick" >&2
    else
      # Declare the hold to the cleanup handler BEFORE the acquire, not after
      # it. `--wait` polls for up to DISPATCH_LOCK_WAIT_TIMEOUT (default 300s)
      # in a CHILD process, and dispatch-heartbeat.service sets
      # KillMode=process — so a `systemctl --user stop` mid-wait signals only
      # this shell. bash defers the pending trap until the command substitution
      # finishes, by which time the child has ALREADY taken the lock and
      # written our session id into it; a flag raised only afterwards is still
      # 0 when the handler runs, so the handler skips the release and the lock
      # is stranded for MAX_HOLD_SECONDS — exactly the defect TICK_LOCK_HELD
      # exists to prevent. Raising it first is safe because `--release` is a
      # strict self-release (dispatch-acquire-lock's `release)` arm): a silent
      # `noop`, exit 0, whenever the recorded holder is not our session id.
      TICK_LOCK_HELD=1
      DRAIN_LOCK=$("$SCRIPT_DIR/dispatch-acquire-lock" --wait) || DRAIN_LOCK=""
      if [[ "$DRAIN_LOCK" != acquired ]]; then
        # Not ours after all — drop the claim, so no later exit path issues a
        # pointless `--release` for a lock we never held.
        TICK_LOCK_HELD=0
        echo "dispatch-tick: paused-branch node-lane drain SKIPPED; dispatch-acquire-lock reported '${DRAIN_LOCK:-error}' (another tick holds the selection lock); the next tick retries" >&2
      else
        # Everything between here and the unconditional release below runs with
        # the lock held, and a SIGINT/SIGTERM landing anywhere in that window
        # must release it on the way out rather than strand it (see
        # TICK_LOCK_HELD's comment at the trap).
        # No main-health read here: graph-auto-merge performs that admission
        # gate ITSELF (tactic-graph-auto-merge-main-health-gate), calling
        # `dispatch-graph-main-red-sync --read-only` internally and merging
        # nothing when the latch is non-empty, UNKNOWN, or unreadable. This
        # branch used to compute OPEN_MAIN_RED and wrap the call; that caller-side
        # copy is gone, so there is exactly one implementation of the gate.
        #
        # The `--read-only` flag matters especially here: this drain runs while
        # dispatch is PAUSED, and completing the latch nodes is the tick's
        # authoritative act, not a paused drain's.
        #
        # A timeout still needs no branch of its own beyond the 124 warning: the
        # inner script's own gate has already fail-closed on anything it could
        # not read, and a `timeout`-killed graph-auto-merge simply merges
        # nothing this tick.
        DRAIN_RC=0
        GRAPH_MERGE_OUT=$("$DRAIN_TIMEOUT_BIN" "$DRAIN_TIMEOUT_S" "$SCRIPT_DIR/graph-auto-merge" </dev/null) || DRAIN_RC=$?
        if (( DRAIN_RC == 124 )); then
          echo "dispatch-tick: WARNING: graph-auto-merge timed out after ${DRAIN_TIMEOUT_S}s on the paused-branch drain; continuing (the next tick retries)" >&2
        fi
        if [[ -n "$GRAPH_MERGE_OUT" ]]; then
          while IFS= read -r merge_line; do
            [[ -n "$merge_line" ]] && echo "merge: $merge_line"
          done <<< "$GRAPH_MERGE_OUT"
        fi
        # Heartbeat BETWEEN the two drain calls (see refresh_lock's comment
        # above): graph-auto-merge just completed its own up-to-600s budget,
        # and reconcile-graph-merged is about to spend up to another 600s — the
        # combined 1200s worst case exceeds the 300s default staleness cap, so
        # without this refresh a second paused tick could reclaim the lock
        # mid-drain.
        refresh_lock
        DRAIN_RC=0
        RECONCILE_GRAPH_OUT=$("$DRAIN_TIMEOUT_BIN" "$DRAIN_TIMEOUT_S" "$SCRIPT_DIR/reconcile-graph-merged" </dev/null) || DRAIN_RC=$?
        if (( DRAIN_RC == 124 )); then
          echo "dispatch-tick: WARNING: reconcile-graph-merged timed out after ${DRAIN_TIMEOUT_S}s on the paused-branch drain; continuing (the next tick retries)" >&2
        fi
        if [[ -n "$RECONCILE_GRAPH_OUT" ]]; then
          while IFS= read -r graph_line; do
            [[ -n "$graph_line" ]] && echo "reconcile-graph: $graph_line"
          done <<< "$RECONCILE_GRAPH_OUT"
        fi
        # Release unconditionally — including after a timeout — so a wedged
        # drain never leaves the selection lock held for the rest of the pause.
        "$SCRIPT_DIR/dispatch-acquire-lock" --release >/dev/null 2>&1 || true
        TICK_LOCK_HELD=0
      fi
    fi
  fi

  exit 0
fi

# --- Step 0.5: refresh rate-limit telemetry (headless source) ----------------
# The budget reads below (dispatch-select-tick -> dispatch-target-workers) consume
# cached telemetry in rate_limits.json, whose ONLY status-line writer never runs in
# the headless chain (no session renders a status line). When the chain fully pauses
# and its reseed timer later fires, re-reading that frozen snapshot reports the
# still-capped pre-reset state and nothing spawns — the budget reopened but the tick
# cannot observe it (#1127). Refresh telemetry from a non-status-line source FIRST,
# so every budget read this tick (and any reseed it arms) is computed against fresh
# data. Fail-safe: a probe failure (network, expired token, malformed headers) logs
# one note and the tick proceeds on the cached file — a probe outage degrades to the
# prior behavior rather than erroring the tick.
if ! "$SCRIPT_DIR/dispatch-refresh-rate-limits"; then
  echo "dispatch-tick: rate-limit refresh probe failed; proceeding on cached telemetry (#1127)" >&2
fi

# --- Step 0.6: sample capacity telemetry (#1007) ------------------------------
# Append one usage-samples Firestore document for the office-hours Capacity view,
# from the telemetry just refreshed above. Fail-safe: a sampler failure logs one
# note and the tick proceeds — capacity telemetry is best-effort, never gates work.
if ! "$SCRIPT_DIR/dispatch-sample-usage"; then
  echo "dispatch-tick: usage sample failed; proceeding (#1007)" >&2
fi

# --- Snapshot the live-session registry once per tick (#1452) -----------------
# The selection phase below — dispatch-select-tick's concurrency gate — makes
# many machine-wide `claude agents --json` calls (the gate's busy-worker count
# and every worktree_has_live_session probe). Capture ONE snapshot here and
# export its path so dispatch-select-tick's lib-claude-agents.sh reads reuse it
# (DISPATCH_AGENTS_SNAPSHOT) — one daemon query per tick instead of hundreds.
# dispatch-tick already runs the whole headless chain with the sandbox disabled
# (.claude/rules/sandbox.md), so this is the one place the Unix-socket-backed
# `claude agents` call is made. The snapshot lives under the mktemp -d workspace
# the EXIT/INT/TERM trap removes.
#
# The tick captures TWO independent snapshots, one per daemon view (ACTIVE below,
# REGISTERED next) — not one query filtered client-side into both. Reconstructing
# ACTIVE from REGISTERED (or vice versa) means guessing at the daemon's
# terminal-state set client-side, which lib-claude-agents.sh's own header
# ("ACTIVE vs REGISTERED", design rule 1) forbids: ask the daemon for the view you
# want. So this is two daemon queries per tick, not one — still a fixed constant
# instead of hundreds of live per-call round-trips.
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-claude-agents.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-frozen-session-park.sh"
_SNAPSHOT_FILE="$DISPATCH_TICK_WORKSPACE/agents-snapshot.json"
if claude_agents_snapshot_capture "$_SNAPSHOT_FILE"; then
  export DISPATCH_AGENTS_SNAPSHOT="$_SNAPSHOT_FILE"
else
  # Capture failed (daemon momentarily unreachable). Remove any partial file and
  # leave DISPATCH_AGENTS_SNAPSHOT unset so every machine-wide read falls back to
  # its live per-call path and the UNKNOWN fail-safe is preserved bit-for-bit. Do
  # NOT abort the tick — degrade to the pre-#1452 behavior. (#1452)
  rm -f "$_SNAPSHOT_FILE"
  # `unset`, not merely "don't set": the variable may be present in the INHERITED
  # environment (a nested tick, a leftover manual export). Left set, it would
  # point every read at a foreign/stale file instead of degrading to live.
  unset DISPATCH_AGENTS_SNAPSHOT
  echo "dispatch-tick: claude agents snapshot capture failed; selection will use live per-call reads (#1452)" >&2
fi

# Second, independent capture: the REGISTERED (--all) view. This is what
# worktree_has_live_session now reads (tactic-stopped-session-blocks-node Unit 1)
# so a stopped-but-not-removed session still blocks its node/worktree. Without
# this capture, every occupancy probe in the tick would fall through to a live
# `claude agents --json --all` daemon round-trip — hundreds per tick instead of
# one. Independent of the ACTIVE capture above: either may fail without affecting
# the other.
_SNAPSHOT_ALL_FILE="$DISPATCH_TICK_WORKSPACE/agents-snapshot-all.json"
if claude_agents_snapshot_capture_registered "$_SNAPSHOT_ALL_FILE"; then
  export DISPATCH_AGENTS_SNAPSHOT_ALL="$_SNAPSHOT_ALL_FILE"
else
  rm -f "$_SNAPSHOT_ALL_FILE"
  # Same as the ACTIVE branch above: unset an inherited value, or a stale
  # registered snapshot would decide occupancy — a missing row makes a genuinely
  # held node re-selectable, the exact failure this tactic removes.
  unset DISPATCH_AGENTS_SNAPSHOT_ALL
  echo "dispatch-tick: registered (--all) agents snapshot capture failed; occupancy checks will use live per-call reads" >&2
fi

# --- Stand-down winner-liveness re-check sweep --------------------------------
# Placement matters: this runs AFTER the daemon snapshot above (so the sweep's
# machine-wide session-registry reads reuse this tick's single
# DISPATCH_AGENTS_SNAPSHOT instead of an extra round-trip `claude agents --json`
# call) and BEFORE Step 1 target selection below, so that any node the sweep
# parks to `office_hours` lands on `main` before selection runs — this tick's
# own selection already excludes whatever the sweep just parked. Same
# conditional-source + verify + loud-failure idiom as the paused-branch call
# above.
if ! declare -f standdown_recheck_sweep >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-standdown-recheck.sh"
fi
if declare -f standdown_recheck_sweep >/dev/null 2>&1; then
  standdown_recheck_sweep 1>&2
else
  echo "dispatch-tick: lib-standdown-recheck.sh failed to load; stand-down re-check NOT run this tick" >&2
fi

# --- Stale-hold re-check sweep (tactic-stale-hold-auto-resolve) ---------------
# Placement matters, same reasons as the stand-down sweep just above: it runs
# AFTER the daemon snapshot (so the sweep's session-registry reads reuse this
# tick's snapshot instead of an extra round-trip) and BEFORE Step 1 target
# selection, so a hold resolved here has already landed its source's
# `blocked_by` removal on `main` before selection runs — this tick's own
# selection can pick up the just-unblocked source. Same conditional-source +
# verify + loud-failure idiom as the sweep above.
if ! declare -f stale_hold_recheck_sweep >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-stale-hold-recheck.sh"
fi
if declare -f stale_hold_recheck_sweep >/dev/null 2>&1; then
  stale_hold_recheck_sweep 1>&2
else
  echo "dispatch-tick: lib-stale-hold-recheck.sh failed to load; stale-hold re-check NOT run this tick" >&2
fi

# --- Calendar-wait re-check sweep (attributes.wait_until, tactic-wait-calendar-release) ---
# Placement matters, same reasons as the stale-hold sweep just above: it runs
# AFTER the daemon snapshot (so the sweep reuses this tick's single snapshot
# instead of a round-trip per probe, matching why the stale-hold sweep is
# placed there) and BEFORE Step 1 target selection, so a WAIT released this
# tick is already reflected in this tick's own selection. Same
# conditional-source + verify + loud-failure idiom as the sweep above.
if ! declare -f wait_recheck_sweep >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/lib-wait-recheck.sh"
fi
if declare -f wait_recheck_sweep >/dev/null 2>&1; then
  wait_recheck_sweep 1>&2
else
  echo "dispatch-tick: lib-wait-recheck.sh failed to load; calendar-wait re-check NOT run this tick" >&2
fi

# --- Frozen-session sweep (denied-command park, tactic-denied-command-parks-node) ---
# Runs here — after the snapshot capture above, before Step 1's selection below —
# so the sweep reuses this tick's single daemon snapshot (no extra round-trip)
# and any node the sweep parks this tick is excluded from THIS tick's own
# selection: park-node has already landed office_hours on main by the time
# dispatch-select-tick runs. Same guard posture as the paused branch above: a
# load failure is logged loudly and never aborts or skips the rest of the tick —
# the sweep is observability/containment, never a gate.
if declare -f frozen_session_sweep >/dev/null 2>&1; then
  frozen_session_sweep 1>&2
else
  echo "dispatch-tick: lib-frozen-session-park.sh failed to load; frozen-session sweep NOT run this tick" >&2
fi

# --- Terminal-without-disposition sweep (tactic-phase-terminal-requires-disposition) ---
# Runs here — immediately after the frozen-session sweep above, before Step 1's
# selection below — for ONE reason: any node it parks this tick is excluded from
# THIS tick's own selection, because park-node has already landed office_hours on
# main by the time dispatch-select-tick runs. It does NOT ride this tick's daemon
# snapshot: its candidate query is a DIRECT `claude agents --json --all` (the
# snapshot is captured without `--all`, so it cannot carry the terminal rows the
# sweep looks for), which costs one extra round-trip. Same guard posture as the
# paused branch above: a load failure is logged loudly and never aborts or skips
# the rest of the tick — the sweep is observability/containment, never a gate.
if declare -f terminal_without_disposition_sweep >/dev/null 2>&1; then
  terminal_without_disposition_sweep 1>&2
else
  echo "dispatch-tick: lib-frozen-session-park.sh failed to load; terminal-disposition sweep NOT run this tick" >&2
fi

# --- Step 1: select the target ------------------------------------------------
# Capture select-tick's full stdout and echo every line through (jit:/calendar:
# passthrough AND the decision line) so journald and a live relay see it all.
#
# --allow-stale is forwarded to select-tick on BOTH operator lanes, not only
# down the graph-execute path below: select-tick runs FIRST, and on the primary
# checkout its own origin/main fetch + ff-only merge probe is what fails when
# the network is down. Left unforwarded, that probe emits `sync-failed` — a
# terminal disposition routed at Step 2 — so dispatch-graph-execute (where the
# flag is otherwise consumed) is never reached at all, making the override
# unreachable in exactly the offline scenario it exists for.
#
# The bare autonomous `else` branch never carries it: the guard above already
# rejects --allow-stale without --manual or a node id, so that combination
# cannot reach here.
if [[ -n "$MANUAL" ]]; then
  SEL_OUT=$("$SCRIPT_DIR/dispatch-select-tick" --manual ${ALLOW_STALE:+--allow-stale})
elif [[ -n "$NODE_ARG" ]]; then
  SEL_OUT=$("$SCRIPT_DIR/dispatch-select-tick" "$NODE_ARG" ${ALLOW_STALE:+--allow-stale})
else
  SEL_OUT=$("$SCRIPT_DIR/dispatch-select-tick")
fi
SEL_RC=$?
if [[ -n "$SEL_OUT" ]]; then
  printf '%s\n' "$SEL_OUT"
fi
if (( SEL_RC != 0 )); then
  echo "dispatch-tick: dispatch-select-tick exited $SEL_RC" >&2
  exit 2
fi

DECISION=$(printf '%s\n' "$SEL_OUT" | tail -n 1)

# --- Step 2: route the decision line -----------------------------------------
# shellcheck disable=SC2086  # decision fields are intentionally word-split
set -f  # word-split only — disable glob expansion so a field containing *, ?, or
        # [ ] (e.g. a jit `project`/`repo` config value) is not expanded against cwd
set -- $DECISION
set +f
case "${1:-}" in
  busy)
    echo "dispatch-tick: another tick holds the lock (busy); nothing to do" >&2
    exit 0
    ;;
  node-not-selectable)
    node="${2:-}"
    echo "dispatch-tick: node '$node' is not selectable — nothing dispatched" >&2
    exit 1
    ;;
  empty)
    # #1557: an autonomous `empty` tick (work queued, but every reachable open
    # leaf is claimed/parked/excluded while the fleet is below target) spawns
    # no worker and arms no continuation on its own, so the chain dead-ends
    # until an external kick. Route it through the same continuation-guarantor
    # `drain` uses (#1445) — flagged BENIGN (#2445): an `empty` tick is a clean
    # no-work decision, not a tick failure. recover guarantees a continuation
    # (the #2022 durable heartbeat normally carries it; a backstop reseed only if
    # the heartbeat is down) WITHOUT counting toward the consecutive-failure
    # stall cap. Counting benign `empty` ticks as failures was the #2445 false
    # positive: COUNT climbed unbounded (every benign cycle finds no reseed timer)
    # and filed a `dispatch:chain-stalled` latch while the chain was alive.
    # Autonomous-only (mirror the #1453 convergence-reseed guard above): a
    # `--manual` empty is a one-shot human probe, so it must NOT be forced
    # through the backstop.
    echo "dispatch-tick: select-tick disposition 'empty'; nothing spawned" >&2
    if [[ -z "$MANUAL" ]]; then
      DISPATCH_TICK_RECOVER_BENIGN=empty "$SCRIPT_DIR/dispatch-tick-recover" || \
        echo "dispatch-tick: dispatch-tick-recover failed on 'empty' (continuation not guaranteed)" >&2
    fi
    exit 0
    ;;
  concurrency-cap|sync-repair-pending|sync-broken)
    echo "dispatch-tick: select-tick disposition '$1'; nothing spawned" >&2
    exit 0
    ;;
  sync-failed)
    # Sonnet by default: none of the aux jobs below author product code
    # (sync-repair runs /commit-merge-push, whose conflict recovery already
    # escalates to an Opus subagent internally; diagnose-main diagnoses;
    # jit-reminder runs reminder skills including digest). Omitting --model
    # would inherit the session default (Opus). The force-opus config at the
    # dispatch-spawn-job chokepoint still overrides this from above.
    "$SCRIPT_DIR/dispatch-spawn-job" --name sync-repair --cwd "$MAIN_WORKTREE" \
      --model sonnet "/commit-merge-push" \
      || echo "dispatch-tick: WARNING: dispatch-spawn-job (sync-repair) failed; repair job lost" >&2
    exit 0
    ;;
  main-broken)
    sha="${2:-}"
    if [[ -z "$sha" ]]; then
      echo "dispatch-tick: main-broken decision missing <sha>" >&2
      exit 2
    fi
    "$SCRIPT_DIR/dispatch-spawn-job" --name diagnose-main --cwd "$MAIN_WORKTREE" \
      --model sonnet "/dispatch-diagnose-main $sha" \
      || echo "dispatch-tick: WARNING: dispatch-spawn-job (diagnose-main) failed; diagnose job lost" >&2
    exit 0
    ;;
  jit-reminder)
    repo="${2:-}" num="${3:-}" project="${4:-}" item="${5:-}"
    if [[ -z "$repo" || -z "$num" || -z "$project" || -z "$item" ]]; then
      echo "dispatch-tick: jit-reminder decision missing fields" >&2
      exit 2
    fi
    "$SCRIPT_DIR/dispatch-spawn-job" --name "jit-reminder-$num" --cwd "$MAIN_WORKTREE" \
      --model sonnet "/dispatch-jit-reminder $repo $num $project $item" \
      || echo "dispatch-tick: WARNING: dispatch-spawn-job (jit-reminder-$num) failed; reminder job lost" >&2
    exit 0
    ;;
  graph)
    # Graph-lane execute (tactic-graph-router-selector): decision shape is
    # `graph <count> <id:kind:phase>...`. select-tick already wrote the
    # per-node reservation markers and released the lock, so the execute path
    # runs lock-free. dispatch-graph-execute resolves per-phase model/effort
    # and spawns the workflow-native runner per node; its stdout is echoed
    # through so the journal carries the launch narrative.
    count="${2:-}"
    if [[ -z "$count" || $# -lt 3 ]]; then
      echo "dispatch-tick: graph decision missing <count>/<spec>s" >&2
      exit 2
    fi
    shift 2
    GRAPH_EXEC_OUT=$("$SCRIPT_DIR/dispatch-graph-execute" ${ALLOW_STALE:+--allow-stale} "$@")
    GRAPH_EXEC_RC=$?
    if [[ -n "$GRAPH_EXEC_OUT" ]]; then
      printf '%s\n' "$GRAPH_EXEC_OUT"
    fi
    if (( GRAPH_EXEC_RC != 0 )); then
      echo "dispatch-tick: dispatch-graph-execute exited $GRAPH_EXEC_RC" >&2
      exit 2
    fi
    # Mirror the `propagate` arm's convergence safety net (#1453) on the
    # autonomous path: re-count effective-live and arm a short-delay reseed if
    # the fleet is still below target. Best-effort — never wedge the tick.
    if [[ -z "$MANUAL" ]]; then
      "$SCRIPT_DIR/dispatch-schedule-convergence-reseed" \
        || echo "dispatch-tick: convergence reseed arm failed (best-effort)" >&2
    fi
    exit 0
    ;;
  *)
    echo "dispatch-tick: unrecognized select-tick decision line '$DECISION'" >&2
    exit 2
    ;;
esac
