#!/usr/bin/env bash
# graph-auto-merge — the graph-native, marker-keyed PR auto-merger. The
# graph-lane analog of the legacy label-gated dispatch-auto-merge, and the ONLY
# code that merges a node-lane PR.
#
# For every graph-native tactic at phase:review that carries an execution.pr AND
# the `reviewed` completion marker in execution.markers AND no in-flight
# execution.conflict interrupt, it senses the PR and —
# when it is OPEN, MERGEABLE, green on CI, and the node's scope fingerprint is
# fresh — squash-merges it label-free. The `reviewed` marker is the label-free
# replacement for dispatch-auto-merge's `dispatch:reviewed` label check: a
# phase:review node WITHOUT the marker is review-in-progress, not a candidate.
#
# The human has authorized this reconciler to squash-merge reviewed, green,
# conflict-free node-lane PRs; the commands it runs to do so are `gh pr ready`
# and `gh api -X PUT .../pulls/<n>/merge --squash` (via gh_pr_merge_rest). It is
# a single owned-shell sweep with no agent turn inside the merge loop.
#
# Usage: graph-auto-merge [--node <id>]
#
#   --node <id>  Consider ONLY the named node id. A SELECTION FILTER, never a
#                gate bypass — every gate below still applies verbatim, exactly
#                as documented for `graph-select-target --node`. Absent the
#                flag, behavior is byte-identical to the unflagged sweep. This
#                exists so a single-node caller (the /dispatch-ladder driver)
#                can reuse this script rather than re-implementing, or
#                hand-rolling past, the gates it owns.
#
# Sweep-wide admission gates (Step 1, before any enumeration; both no-op the
# WHOLE sweep silently, exit 0):
#   - the auto-merge config kill-switch (`enabled:false`).
#   - MAIN HEALTH. `dispatch-graph-main-red-sync --read-only` reports the open
#     `tactic-main-red-*` latch set; ANY non-empty output (the literal `UNKNOWN`
#     read-failure sentinel included) suppresses the sweep. A merge onto a
#     broken main compounds the breakage, and an unknown main health must fail
#     closed. This is a whole-sweep condition, not a per-candidate hold, so it
#     emits a stderr note and NO `held <id> (...)` line — matching the config
#     kill-switch's silent no-op.
#
#     `--read-only` is MANDATORY here and never optional: completing the open
#     latch nodes is an AUTHORITATIVE act that re-arms the gate and lets PRs
#     land, and that authority belongs to the scheduler's tick alone (see
#     dispatch-graph-main-red-sync:21-47). A non-tick caller that completed them
#     could unblock auto-merge onto a still-broken main.
#
#     DELIBERATE SEMANTIC CHANGE (tactic-graph-auto-merge-main-health-gate):
#     this gate used to be computed by the CALLER and applied around the call
#     site (dispatch-select-tick, dispatch-tick's paused-branch drain), so every
#     downstream consumer within one tick gated on that tick's INITIAL read
#     (dispatch-select-tick Step 1c's stated contract). This script now performs
#     its own, later read. Consequence: a latch completed earlier in the SAME
#     tick permits a merge in that tick rather than the next. That is strictly
#     correct — completion only happens once origin/main is green again — and it
#     is the price of making the gate reusable by a non-tick caller. The tick's
#     Step 1c read still runs UNFLAGGED and still owns the completion.
#
# Per-candidate merge gates, in order (a failed gate SKIPS silently, it never
# demotes):
#   - office_hours park. A non-null node.office_hours HOLDS (emits
#     `held <id> (office-hours)`, no merge) — a parked node awaits a human
#     decision, and merging its PR would ship the code the park is flagging.
#     Never demotes: the node stays at phase:review for a human to drain via
#     office-hours. Evaluated first, before any GitHub sensing, so a parked
#     node needs no PR fetch at all.
#   - PR state OPEN. MERGED/CLOSED are absorbed by reconcile-graph-merged, not
#     here.
#   - mergeable MERGEABLE. A CONFLICTING/UNKNOWN PR is the provision-time
#     conflict path's job, not this sweep's.
#   - no in-flight execution.conflict (applied in the Step 2 enumeration). A
#     resolved conflict can flip the PR back to MERGEABLE before the selector
#     pass self-heals the interrupt and routes the re-review; merging then
#     lands code the completed review never saw.
#   - blocked_by satisfied (applied in the Step 2 enumeration, via the shared
#     `blockersComplete` predicate). A node whose blocker is still open must not
#     land ahead of it — the blocker exists precisely because this PR's code
#     depends on, or must not precede, the blocker's. Silent skip, not a `held`
#     line: the node is simply not a candidate yet.
#   - CI passing. `pending` retries next tick; `failing` belongs to the fix
#     interrupt (do NOT merge, do NOT route the fix here — the next
#     transition-node / selection tick routes it).
#   - BRANCH UP TO DATE with the live origin/main tip
#     (tactic-graph-auto-merge-up-to-date-gate). The LAST gate before merging,
#     evaluated after the freshness hold below so only a candidate that would
#     otherwise merge spends the compare call. `mergeable == MERGEABLE` means
#     only "no textual conflict", and the CI verdict is computed on the PR head
#     oid — so a green PR dozens of commits behind main can merge and turn main
#     RED, which then trips the main-health gate above and suppresses the whole
#     merge lane. The compare (gh_commit_is_ancestor_rest, base=live main tip,
#     head=PR head) must report `ahead` or `identical`; `behind`/`diverged`
#     SYNCS instead of merging — `gh_pr_update_branch_rest` merges main into the
#     PR head, re-triggering CI on the fresh base — emits
#     `synced #<pr> (<id>)`, and defers the merge to a later tick that sees CI
#     green on that now-current base. This gate never routes fix or conflict
#     work: it only updates the branch and defers.
#   - SYNC CAP on that sync arm (tactic-graph-auto-merge-sync-cap). Syncing is
#     self-limiting per HEAD (each sync moves the oid, so the same oid is never
#     synced twice) but NOT per PR: under contention the sync re-triggers CI,
#     main moves again during that 10-20 minute run, and the next tick syncs
#     again. A PR can lose that race indefinitely, paying a full CI run per
#     cycle. So before syncing, count the PR's merge commits whose subject is
#     GitHub's update-branch form, `Merge branch 'main' into <head-ref>` — that
#     count IS the number of times THIS gate has merged main into the head, i.e.
#     its own footprint. The worker's local `git merge origin/main`
#     (commit-merge-push) writes the remote-tracking form and is NOT counted,
#     which would otherwise hold healthy multi-unit PRs that this gate had never
#     synced. At `GRAPH_AUTO_MERGE_SYNC_MAX` (default 3) HOLD
#     instead: `held <id> (sync-cap: <n> syncs)`. A hold, not a silent skip,
#     because a thrashing PR needs a person (rebase it, land it manually, split
#     it), which is exactly what the `held` verdict means here.
#
# Fail-closed freshness gate: before merging, re-check the node's tactic-scope
# fingerprint against origin/main (compute-freshness.ts). scopeStale==true OR a
# missing stamp file HOLDS the node (emits `held <id> (...)`, no merge). A held
# node stays at phase:review — this script only declines to merge, it never
# demotes.
#
# Doctrine: run from a main-based checkout. Sandbox: the CALLER wraps every
# invocation with dangerouslyDisableSandbox, as its blanket convention. This
# script itself asks for nothing sandbox-specific — it makes no graph-commit
# call and no tree-updating git op, and `gh` reaches the allowlisted
# api.github.com fine sandboxed on this host (measured; see
# .claude/skills/review-fix/references/code-review-invocation.md §3.1). This
# script sets NOTHING sandbox-related; that is the caller's responsibility.
#
# Stdout protocol: exactly `merged #<pr> (<id>)` per PR merged,
# `synced #<pr> (<id>)` per PR whose branch was updated against main instead of
# merged, and `held <id> (<reason>)` per hold, where <reason> is one of
# `office-hours`, `missing-stamp`, `scope-stale`, or `sync-cap: <n> syncs`;
# NOTHING for a plain skip
# (an ineligible PR is silently passed over). dispatch-select-tick prefixes
# every line with `merge: `, so a sync surfaces as `merge: synced #<pr> (<id>)`
# with no change needed there.
#
# Exit codes: 0 (including a no-op sweep); 1 if any item hard-errored (node
# enumeration failure, a gh sense/merge error, or a freshness computation
# crash); 2 on a usage error. NOT set -e: a per-PR hard error must not abort the
# sweep — each is captured with `|| rc=$?`, logged to stderr, sets HARD_ERROR=1,
# and `continue`s.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

# ---- Argument parsing -------------------------------------------------------
NODE_FILTER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --node)
      [[ $# -ge 2 && -n "${2:-}" ]] \
        || { echo "graph-auto-merge: --node requires a non-empty id" >&2; exit 2; }
      NODE_FILTER="$2"; shift 2 ;;
    *)
      echo "graph-auto-merge: unknown argument '$1'" >&2
      echo "usage: graph-auto-merge [--node <id>]" >&2
      exit 2 ;;
  esac
done
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
UTIL_SCRIPTS="$REPO_ROOT/packages/intentionsutil/scripts"

# How many times the up-to-date gate may sync one PR before holding it for a
# person. Bound and validated ONCE here, so a malformed override fails loudly at
# startup rather than silently comparing as 0 inside the per-candidate loop
# (bash `[[ abc -ge 3 ]]` resolves `abc` as a variable name → 0 → never holds).
SYNC_MAX="${GRAPH_AUTO_MERGE_SYNC_MAX:-3}"
[[ "$SYNC_MAX" =~ ^[0-9]+$ ]] || {
  echo "graph-auto-merge: GRAPH_AUTO_MERGE_SYNC_MAX must be a non-negative integer (got '$SYNC_MAX')" >&2
  exit 2; }

# The scope-fingerprint stamp lives at the MAIN checkout root
# (provision-node-worktree writes it there). resolve_project_root resolves the
# shared main project root for the stamp path. GRAPH_AUTO_MERGE_MAIN_ROOT is a
# test seam (mirrors reconcile-graph-merged's GRAPH_RECONCILE_NOW idiom).
MAIN_ROOT="${GRAPH_AUTO_MERGE_MAIN_ROOT:-}"
if [[ -z "$MAIN_ROOT" ]]; then
  MAIN_ROOT="$(resolve_project_root)" || {
    echo "graph-auto-merge: could not resolve the main project root" >&2; exit 1; }
fi

# ---- Step 1: config gate (no-op when off) -----------------------------------
# Default ON: an absent config file arms auto-merging. The file exists only as an
# opt-OUT kill-switch (incident response). When present, enabled:false turns the
# reconciler off; enabled:true (the redundant explicit form) keeps it on. This is
# the same auto-merge kill-switch dispatch-auto-merge honors.
CFG=$("$SCRIPT_DIR/dispatch-config-load" auto-merge) || {
  echo "graph-auto-merge: error: dispatch-config-load auto-merge failed" >&2
  exit 1
}
if [[ "$CFG" != "no-config" ]]; then
  ENABLED=$(jq -r '.enabled' <<<"$CFG")
  [[ "$ENABLED" == "false" ]] && exit 0
fi

# ---- Step 1b: main-health admission gate (no-op when main is not known-good) --
# See the DELIBERATE SEMANTIC CHANGE note in the header: this gate used to live
# at each call site, which is why a single-node caller could not reuse this
# script without re-implementing it (or, worse, merging without it).
#
# `--read-only` is mandatory — this caller reads the latch, it never completes
# it. Fail closed on every uncertain reading: non-empty stdout (an open
# `tactic-main-red-*` node), the literal `UNKNOWN` graph-read sentinel, AND a
# non-zero exit. The script's contract is "ALWAYS exit 0", so a non-zero status
# means it did not run as designed (missing, unreadable, killed by a caller's
# `timeout`) and must never be read as "main healthy" — the same disposition
# dispatch-select-tick gives a failed main-health read via `|| OPEN_MAIN_RED=UNKNOWN`.
MAIN_RED_RC=0
OPEN_MAIN_RED=$("$SCRIPT_DIR/dispatch-graph-main-red-sync" --read-only) || MAIN_RED_RC=$?
if [[ "$MAIN_RED_RC" -ne 0 ]]; then
  echo "graph-auto-merge: dispatch-graph-main-red-sync --read-only failed (rc=$MAIN_RED_RC); treating main health as UNKNOWN and merging nothing this sweep" >&2
  exit 0
fi
if [[ -n "$OPEN_MAIN_RED" ]]; then
  echo "graph-auto-merge: main health is not known-good (open main-red latch: $(tr '\n' ' ' <<<"$OPEN_MAIN_RED")); merging nothing this sweep" >&2
  exit 0
fi

# ---- Step 2: enumerate merge candidates from the graph ----------------------
# One node pass: print `<id>\t<pr>` for every kind:tactic node at phase:review
# whose execution.pr is non-null AND execution.markers includes "reviewed". The
# marker is the label-free replacement for dispatch-auto-merge's
# index("dispatch:reviewed") label check; a phase:review node without it is
# review-in-progress, not a candidate.
#
# A node carrying an in-flight `execution.conflict` interrupt is EXCLUDED here
# — the load-bearing copy of the conflict-interrupt merge guard (the copy in
# the legacy label-gated dispatch-auto-merge is defense-in-depth only, since
# node-lane PRs are opened label-free and never reach it). A node can flip
# CONFLICTING → MERGEABLE while `execution.conflict` is STILL set: the conflict
# was resolved by /dispatch-conflict or by any push to the head branch, but the
# per-node selector pass that self-heals the interrupt and routes the re-review
# has not run yet this tick (graph-auto-merge runs BEFORE selection in the
# tick). Merging in that window lands conflict-resolution code the completed
# review never saw, and defeats the re-review path — this sweep runs
# `gh pr ready` first, undoing the `gh pr ready --undo` re-draft the resolution
# path relies on. The check lives in this strict enumeration rather than in a
# second process spawn so it inherits `listNodesStrict`'s fail-closed posture:
# an unreadable store aborts the pass instead of yielding an empty exclusion
# set. It reads the FIRST-CLASS `execution.conflict` field only — never the
# `attributes` squatter path some other readers tolerate.
#
# A node with an UNSATISFIED `blocked_by` blocker is EXCLUDED here too, via the
# shared `blockersComplete` predicate (packages/intentionsutil/src/router.ts) —
# the same completeness rule the selector and the review-stall sweep apply: a
# blocker is complete when ABSENT from the store (prune-on-done makes absence
# completion) or present at `phase: done`. Nothing else in this script reads
# `blocked_by`, so without this an autonomously-merged node could land ahead of
# the very work it declares itself blocked by. It is an added conjunct on the
# enumeration's existing strict read, not a second traversal.
#
# Enumeration is STRICT (`listNodesStrict`): this drives an autonomous merge, so
# a corrupt node file must abort the pass loudly rather than silently vanish
# from the candidate set (or, via a dropped blocker, silently qualify one) —
# the latter is exactly `blockersComplete`'s documented precondition, since it
# reads an absent blocker id as COMPLETE.
#
# `--node <id>` is applied HERE, as the first thing the loop tests: a selection
# filter layered on top of the enumeration, ahead of every gate, so the gates
# below apply unchanged to whatever survives it. The id arrives via process.argv
# (an empty string means "no filter"), not via the environment, so an ambient
# variable can never silently narrow an unflagged sweep.
#
# `DISPATCH_GRAPH_NODE_CACHE` (packages/intentionsutil/src/store-cache.ts) names
# a storage LOCATION for a read-only, content-addressed memo of this same strict
# enumeration — never a node subset, so it cannot change the candidate set — and
# `--node` still arrives via process.argv, so unset or empty simply
# self-enumerates, which is the `/dispatch-ladder` single-node path.
CANDIDATES="$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
  const { listNodesStrictCached } = await import("./packages/intentionsutil/src/store-cache.js");
  const { blockersComplete } = await import("./packages/intentionsutil/src/router.js");
  const nodes = listNodesStrictCached("./intentions", process.env.DISPATCH_GRAPH_NODE_CACHE || "");
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const only = process.argv[1] || "";
  for (const n of nodes) {
    if (only && n.id !== only) continue;
    if (n.kind !== "tactic") continue;
    if (n.phase !== "review") continue;
    const pr = n.execution && n.execution.pr;
    if (pr === null || pr === undefined) continue;
    if (n.execution.conflict !== null && n.execution.conflict !== undefined) continue;
    if (!blockersComplete(n, byId)) continue;
    const markers = (n.execution && n.execution.markers) || [];
    if (!markers.includes("reviewed")) continue;
    process.stdout.write(n.id + "\t" + pr + "\t" + (n.office_hours == null ? "clean" : "parked") + "\n");
  }
' "$NODE_FILTER") )" || { echo "graph-auto-merge: node enumeration failed" >&2; exit 1; }

[[ -z "$CANDIDATES" ]] && exit 0

# ---- Step 3: one origin/main intentions snapshot for the freshness gate ------
# The fingerprint re-check compares each candidate's node against origin/main;
# archive that tree once and reuse it for every candidate (mirror transition-node).
SNAP_DIR="$(mktemp -d)" || { echo "graph-auto-merge: mktemp failed" >&2; exit 1; }
trap 'rm -rf "$SNAP_DIR"' EXIT
# Do NOT fall back to an empty snapshot: compute-freshness against an empty
# origin/main tree finds every candidate absent and returns scopeStale:false,
# which would silently disable the fail-closed freshness gate for the whole
# tick (a fail-open degradation). A transient git failure or missing/unfetched
# origin/main ref must hard-error, not merge.
if ! (cd "$REPO_ROOT" && git archive origin/main intentions 2>/dev/null | tar -x -C "$SNAP_DIR"); then
  echo "graph-auto-merge: git archive origin/main intentions failed (cannot build freshness snapshot)" >&2
  exit 1
fi

# ---- Step 3b: one LIVE origin/main tip read per sweep -----------------------
# The up-to-date gate's compare base. Read ONCE for the whole sweep, and only
# after the `[[ -z "$CANDIDATES" ]] && exit 0` early exit above — an empty sweep
# spends no REST call.
#
# Deliberately the LIVE REST tip, never `git rev-parse origin/main`: a stale
# local ref makes a behind PR look current, so the gate would fail OPEN and
# silently disable itself — the exact failure it exists to prevent. Same
# fail-closed stance the snapshot block above takes: a failed read hard-errors
# rather than merging ungated.
MAIN_SHA=$(gh_retry gh api "repos/{owner}/{repo}/commits/main" | jq -r '.sha') || {
  echo "graph-auto-merge: could not read the live origin/main tip (cannot run the up-to-date gate)" >&2
  exit 1
}
[[ -n "$MAIN_SHA" && "$MAIN_SHA" != "null" ]] || {
  echo "graph-auto-merge: empty origin/main tip sha (cannot run the up-to-date gate)" >&2
  exit 1
}

# ---- Step 4: per-candidate sense + fail-closed freshness gate + merge --------
HARD_ERROR=0
while IFS=$'\t' read -r id pr parked; do
  [[ -n "$id" && -n "$pr" ]] || continue

  # ---- office_hours park gate (fail closed, before any GitHub sensing) -----
  # A parked node awaits a human decision; merging its PR would ship the code
  # the park was flagging. Decline VISIBLY and never demote — same posture as
  # the freshness gate below. Fail closed: anything other than the literal
  # `clean` (an empty third field from a desynced enumeration included) HOLDS.
  if [[ "$parked" != "clean" ]]; then
    echo "held $id (office-hours)"
    continue
  fi

  # ---- Sense the PR (REST) --------------------------------------------------
  rc=0
  PR_JSON=$(gh_pr_view_rest "$pr" 2>/dev/null) || rc=$?
  if [[ "$rc" -ne 0 || -z "$PR_JSON" ]]; then
    echo "graph-auto-merge: gh_pr_view_rest #$pr for $id failed (rc=$rc)" >&2
    HARD_ERROR=1
    continue
  fi

  STATE=$(jq -r '.state' <<<"$PR_JSON")
  [[ "$STATE" == "OPEN" ]] || continue          # MERGED/CLOSED → reconcile-graph-merged

  MERGEABLE=$(jq -r '.mergeable' <<<"$PR_JSON")
  [[ "$MERGEABLE" == "MERGEABLE" ]] || continue # CONFLICTING/UNKNOWN → conflict path

  # ---- CI verdict (REST, memoized) — merge only on passing ------------------
  # pending → in progress, retry next tick; failing → the fix interrupt owns red
  # CI (do NOT merge, do NOT route the fix here). Both skip silently.
  # Bind the head oid ONCE so the up-to-date compare below runs against the
  # SAME oid the CI verdict was computed on.
  HEAD_OID=$(jq -r '.headRefOid' <<<"$PR_JSON")
  rc=0
  VERDICT=$(dispatch_ci_verdict_rest "$HEAD_OID") || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "graph-auto-merge: dispatch_ci_verdict_rest #$pr for $id failed (rc=$rc)" >&2
    HARD_ERROR=1
    continue
  fi
  [[ "$VERDICT" == "passing" ]] || continue

  # ---- Fail-closed tactic-scope fingerprint re-check ------------------------
  # A missing stamp or a scope-stale node HOLDS (declines to merge); it never
  # demotes — the node stays at phase:review for the next selection tick.
  STAMP_FILE="$MAIN_ROOT/.claude/worktrees/$id.scope-fingerprint"
  if [[ ! -f "$STAMP_FILE" ]]; then
    echo "held $id (missing-stamp)"
    continue
  fi
  rc=0
  FRESH=$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/compute-freshness.ts" \
    "$id" --snapshot "$SNAP_DIR/intentions" --stamp "$STAMP_FILE") ) || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "graph-auto-merge: freshness computation failed for $id" >&2
    HARD_ERROR=1
    continue
  fi
  # Hold whenever the freshness comparison did not actually run against a real
  # origin/main node: a missing/empty stamp (stampMissing) or a node absent from
  # the snapshot (nodeOnMain!=true) both leave scopeStale:false without any real
  # chain-of-custody check. Fail closed — these must HOLD, not merge.
  if [[ "$(jq -r '.stampMissing' <<<"$FRESH")" == "true" \
     || "$(jq -r '.nodeOnMain' <<<"$FRESH")" != "true" ]]; then
    echo "held $id (missing-stamp)"
    continue
  fi
  if [[ "$(jq -r '.scopeStale' <<<"$FRESH")" == "true" ]]; then
    echo "held $id (scope-stale)"
    continue
  fi

  # ---- Up-to-date gate: sync a behind branch instead of merging it ----------
  # LAST gate before the merge (tactic-graph-auto-merge-up-to-date-gate): only a
  # candidate that would otherwise merge spends the compare call, and an
  # existing `held` verdict keeps precedence over a sync. Placing it AFTER the
  # CI gate is also load-bearing: a red PR must never be synced — red CI belongs
  # to the fix interrupt, not to this sweep.
  rc=0
  CMP=$(gh_commit_is_ancestor_rest "$MAIN_SHA" "$HEAD_OID") || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "graph-auto-merge: compare origin/main...#$pr head failed for $id (rc=$rc)" >&2
    HARD_ERROR=1
    continue
  fi
  # `continue` inside a `case` continues the enclosing `while` (a `case` is not
  # a loop) — correct and intentional. Every non-up-to-date arm ends in one, so
  # a candidate can never both `synced` and reach the merge PUT.
  case "$CMP" in
    ahead|identical)
      # ahead: main's tip is an ancestor of the head → up to date, merge.
      # identical: head == main tip → up to date (degenerate). Fall through.
      ;;
    behind|diverged)
      # diverged: the ordinary behind-PR case — main has commits the head lacks.
      # behind: the head is an ancestor of the main tip, i.e. its commits already
      #   landed out of band. Rare, and still not up to date, so it takes the
      #   same sync-and-defer path rather than merging; reconcile-graph-merged
      #   absorbs the genuinely-already-merged case on a later tick.
      #
      # --expected-head-sha is a compare-and-swap guard: a head that moved
      # between sensing and syncing yields a 422 rather than a blind update.
      # That is a hard error here, matching how a failed merge is handled below;
      # dispatch-select-tick wraps this script in `|| true`, so a non-zero exit
      # never aborts the tick.
      #
      # A residual race remains — main can advance between the tip read above
      # and this call. It is bounded and accepted; GitHub itself rejects an
      # update or merge that has become impossible.
      #
      # ---- Sync cap (tactic-graph-auto-merge-sync-cap) ---------------------
      # Syncing is self-limiting per HEAD — each sync moves the oid, so the same
      # oid is never synced twice — but NOT per PR. The sync re-triggers CI;
      # main can move again during that 10-20 minute run; the next tick syncs
      # again. Since this is the only autonomous merge path, a PR under
      # contention can lose that race indefinitely, paying a full CI run per
      # cycle. Cap it, and hand a thrashing PR to a person.
      #
      # The counter is THIS GATE's own syncs, not every merge commit on the PR.
      # A multi-parent commit alone does not identify one: commit-merge-push
      # runs `git merge origin/main` at the end of every implement unit and
      # every fix pass, so an ordinary multi-unit PR carries several worker
      # merges that this gate never made. Counting those held healthy PRs at
      # the cap before the gate had synced them even once.
      #
      # The two forms are distinguishable by commit subject, because they are
      # made by different mechanisms:
      #   - GitHub's update-branch API — what gh_pr_update_branch_rest calls
      #     below — writes `Merge branch 'main' into <head-ref>`.
      #   - a local `git merge origin/main` writes git's remote-tracking form,
      #     `Merge remote-tracking branch 'origin/main' into <head-ref>`.
      # So count multi-parent commits whose subject (first line of the message)
      # starts with `Merge branch 'main'`. That count IS how many times THIS
      # gate has merged main into this head: its own footprint, read straight
      # from GitHub, with nothing to persist, sweep, or race, and correct
      # across processes and hosts. The multi-parent predicate is kept as well
      # — a non-merge commit could in principle carry that subject.
      #
      # Two honest caveats:
      #   - a person who runs `git merge main` (the local branch, not
      #     `origin/main`) by hand produces the same subject and is counted. No
      #     script in this repo does that — every scripted merge names
      #     `origin/main` — so it takes a rare human action, and it over-counts,
      #     failing CLOSED: an unnecessary hold, which is that person's call
      #     anyway.
      #   - `per_page=100` bounds the listing (gh_api_array does not paginate),
      #     so a PR with more than 100 commits UNDER-counts and fails OPEN,
      #     permitting another sync. Better than failing closed on a large PR.
      rc=0
      SYNC_COUNT=$(gh_api_array "repos/{owner}/{repo}/pulls/$pr/commits?per_page=100" \
        '[.[] | select((.parents | length > 1)
           and ((.commit.message | split("\n")[0]) | startswith("Merge branch '\''main'\''")))] | length') || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        echo "graph-auto-merge: could not list commits on #$pr for $id (cannot run the sync cap)" >&2
        HARD_ERROR=1
        continue
      fi
      if [[ ! "$SYNC_COUNT" =~ ^[0-9]+$ ]]; then
        echo "graph-auto-merge: non-numeric merge-commit count '$SYNC_COUNT' for #$pr ($id)" >&2
        HARD_ERROR=1
        continue
      fi
      if [[ "$SYNC_COUNT" -ge "$SYNC_MAX" ]]; then
        echo "held $id (sync-cap: $SYNC_COUNT syncs)"
        continue
      fi
      rc=0
      out=$(gh_pr_update_branch_rest "$pr" --expected-head-sha "$HEAD_OID" 2>&1) || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        echo "graph-auto-merge: error: gh_pr_update_branch_rest #$pr failed: $out" >&2
        HARD_ERROR=1
        continue
      fi
      echo "synced #$pr ($id)"
      continue
      ;;
    *)
      # Anything else — including the literal `null` jq prints when the compare
      # response carries no `.status` — fails CLOSED: no merge, no sync.
      echo "graph-auto-merge: unexpected compare status '$CMP' for #$pr ($id)" >&2
      HARD_ERROR=1
      continue
      ;;
  esac

  # ---- Merge label-free -----------------------------------------------------
  # `gh pr ready` is idempotent (no need to gate on draft state — gh_pr_view_rest
  # returns no isDraft field). Then squash-merge via the REST helper with explicit
  # --subject/--body so the non-TTY squash is deterministic and the PR body lands
  # in the squash commit message. No --delete-branch: the repo's
  # delete_branch_on_merge reaps the remote ref.
  gh pr ready "$pr" >/dev/null 2>&1 || true
  TITLE=$(jq -r '.title' <<<"$PR_JSON")
  BODY=$(jq -r '.body // ""' <<<"$PR_JSON")
  rc=0
  out=$(gh_pr_merge_rest "$pr" --squash --subject "$TITLE" --body "$BODY" 2>&1) || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "graph-auto-merge: error: gh_pr_merge_rest #$pr failed: $out" >&2
    HARD_ERROR=1
    continue
  fi
  echo "merged #$pr ($id)"
done <<<"$CANDIDATES"

[[ "$HARD_ERROR" -ne 0 ]] && exit 1
exit 0
