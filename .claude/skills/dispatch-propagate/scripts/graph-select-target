#!/usr/bin/env bash
# graph-select-target — the graph router's selection query (router v2, first
# half: tactic-graph-router-selector). Runs BESIDE the legacy gh selector
# (dispatch-select-target) under the same lock, pace budget, and claimed set;
# dispatch-select-tick consults this selector first and falls back to the
# legacy one. Spec: intentions/tactic-graph-native-dispatch.md §3.1–3.2.
#
# Split of responsibilities:
#   - PURE eligibility + ordering (strategy/tactic gates, soft-freeze,
#     resolved-attention rank outermost, phase ladder within a rank, id
#     tiebreak) lives in packages/intentionsutil/src/router.ts, invoked via
#     scripts/select-targets.ts on a snapshot of the store.
#   - ENVIRONMENTAL gates live here: the origin/main store snapshot, the
#     claimed set (reservation ledger + live node-id sessions), the per-phase
#     sensor gates that need gh (CI verdict before fix/qa/review, PR merged
#     before main-qa), the pace-exempt probe lane, and the selection log.
#
# The store is read at origin/main ONLY (never a branch, never the working
# tree): `git archive origin/main intentions` into a temp dir. Selection makes
# NO graph writes for eligibility/ordering parks (e.g. a strategy at the rounds
# cap) — those are events in the selection log for the transition writer.
#
# The ONE exception is the CI-fix interrupt (tactic-fix-interrupt-orthogonal-state):
# selection is the sole CI-routing authority. On a fix-interruptible ladder phase
# (implement/qa/review) whose PR CI has CONCLUDED-RED and which carries no active
# interrupt, the gate ENTERS the interrupt — UNLESS the PR is also CONFLICTING,
# which is EXCLUDED from the exception (tactic-conflict-outranks-ci-precedence):
# `interruptRoute` (packages/intentionsutil/src/transitions.ts) ranks a merge
# conflict above red CI, so such a node makes NO write here at all — it is emitted
# at its ladder phase and reaches the conflict lane via provision-node-worktree's
# exit 11. The red verdict describes stale pre-merge code, and the fix lane cannot
# run until the conflict clears, so spending a graph write plus one of a limited
# fix-attempt budget on it is pure waste. For the non-conflicting red case the gate
# still enters the interrupt — `apply-fix-state --set-fix` +
# `graph-commit` (a state-only commit on main, mirroring what transition-node
# used to do at the transition seam) — and emits the candidate as `fix` the same
# tick. On CONCLUDED-GREEN of an active interrupt it RESOLVES it — `apply-fix-state
# --clear-fix` (+ the re-review reset when past review) + `graph-commit`, and
# disarms auto-merge (`gh pr ready --undo`) — then emits the resolved ladder
# phase. On a still-red retry that has exhausted the fix-attempt cap (a
# persistently-red PR), the gate instead lands a tracked hold via
# `packages/intentionsutil/scripts/hold-node` (never a park on the source
# node itself: `apply-fix-state --check-cap` reads the cap pure, then
# `hold-node --kind fix-attempt-cap --reset-fix-attempt` writes a born-parked
# hold tactic plus a `blocked_by` edge on the source, in one graph-commit) —
# dropping the node out of the eligible set via that edge rather than
# re-arming another retry forever.
#
# The SECOND exception is the merge-conflict interrupt
# (tactic-graph-router-conflict-routing). A reviewed awaiting-merge node is no
# longer excluded from candidates: the router emits it as `pending-merge`, and
# `_gate_pending_merge` reads the PR's mergeability each tick. On CONFLICTING it
# ENTERS the orthogonal `execution.conflict` interrupt (`apply-conflict-state
# --set-conflict --head-sha <the PR's current head>` + `graph-commit`) and emits
# `conflict`, which
# dispatch-graph-execute routes to `/dispatch-conflict`. On a subsequent tick the
# node arrives as a `conflict` candidate and `_gate_conflict_active` spends one
# attempt per re-dispatch, parks the node once `CONFLICT_ATTEMPT_CAP` is spent
# (a LIFETIME budget — apply-conflict-state persists the spend on
# `execution.attempts.conflict`, so clearing and re-entering the interrupt does
# not refund attempts), or — only when the worker left NO disposition of its own
# — clears the interrupt as a BACKSTOP once GitHub reports the PR MERGEABLE
# again. That backstop is GUARDED (`--clear-conflict-guarded --head-sha`): it
# keeps the `reviewed` marker only when the PR's head is still the sha recorded
# at interrupt entry — the tree review actually examined, mergeable now only
# because main moved — and otherwise clears by INTENTION (strips the marker,
# re-drafts the PR, re-review runs), because a head that advanced is not
# evidence that what would merge is what review approved. `/dispatch-conflict`
# Lane 3 owns the mechanical-vs-intention verdict for a resolution it actually
# performed and declares it explicitly as its terminal act. UNKNOWN mergeability
# is never acted on — GitHub computes it asynchronously.
#
# Every write arm of this lane lands a commit and then returns NOT-SELECTED, so
# `--top` does not bound them: they spend an explicit per-pass budget instead
# (`GRAPH_CONFLICT_COMMIT_BUDGET`, default 2), refreshing the dispatch lock's
# heartbeat after each landing, so one wide conflict fan-out cannot serialize N
# landing-lock waits inside a single lock hold and get the tick's lock reclaimed
# mid-selection. Nodes past the budget are deferred to the next tick — every
# conflict gate is idempotent.
#
# The THIRD write arm is the CI-pending liveness bound
# (tactic-autonomous-ci-pending-liveness-bound). The `qa|review` sensor arm's
# `ci-pending` outcome — `dispatch-ci-ready` exit 1, a draft PR whose CI has
# reported no verdict — used to be an unbounded skip: no counter, no timestamp,
# forever. It is now counted per node in a SIDECAR FILE keyed on the PR's head
# SHA (`ci_pending_strike_bump` / `ci_pending_strike_clear`, lib.sh), and on the
# `DISPATCH_CI_PENDING_STRIKE_CAP`-th consecutive observation of the SAME SHA it
# lands a tracked hold via `hold-node --kind ci-pending-stalled` — the same
# born-parked-hold-plus-`blocked_by`-edge shape as the fix-attempt-cap producer,
# and the same reason: drop the node out of the eligible set via an edge rather
# than skip it forever. Below the cap nothing is written to the graph at all;
# the free retry tier spends cheap ticks, not graph records. An explicit
# `--node` run never counts (a human re-running `dispatch <id>` must not burn
# the autonomous budget), and a concluded verdict clears the ladder.
#
# These graph-commit writes (this script's own via `_graph_commit_fix` /
# `_graph_commit_conflict`, and hold-node's and park-node's own internal
# commits) are the only writes selection makes.
#
# Usage: graph-select-target [--top <n>] [--pace-exempt-only] [--standalone] [--node <id>]
#
#   --top <n>            Print at most <n> selected nodes (default 1).
#   --standalone         Self-contained concurrency safety for manual/emulated
#                        invocation: acquire the shared dispatch lock, apply the
#                        live-worker headroom cap dispatch-select-tick's --manual
#                        branch uses — minus that branch's human-sovereignty
#                        floor-of-1 at HEADROOM==0 and minus its pace-curve
#                        override, so an unattended caller degrades to `empty`
#                        rather than breaching the ceiling OR the pace throttle
#                        (rationale at the (b) block below; --pace-exempt-only
#                        remains the only pace-bypass lane) — claim each selected
#                        node in the reservation ledger, and release the lock —
#                        folding in
#                        the lock+headroom+claim cycle dispatch-select-tick
#                        otherwise wraps around this selector. CLAIM OBLIGATION:
#                        each claim is a budget-consuming marker. A caller that
#                        launches its selections hands the marker to
#                        dispatch-graph-execute, which re-stamps it
#                        `origin=spawned` on a successful spawn kick and lets
#                        reservation_sweep release it once the worker
#                        registers as live (or via the bounded handoff TTL if
#                        it never does); a caller that does NOT launch MUST
#                        `reservation_clear <id>`
#                        for every emitted node. Markers written by this flag carry
#                        `origin=standalone` so reservation_sweep reclaims them
#                        once they age past DISPATCH_RESERVATION_STANDALONE_TTL_S
#                        (default 600s) with no live worker of that name — a
#                        crashed or discard-the-output caller can therefore leak a
#                        slot only for that TTL, not forever. A run that aborts
#                        BEFORE printing its selection (e.g. sensor_gate's exit 2)
#                        rolls back the claims it already wrote, so the obligation
#                        only ever covers nodes the caller was actually handed.
#                        EXPLICIT-NODE DIVERGENCE: --standalone is compatible with
#                        --node, and the headroom/pace ceilings above apply to that
#                        combination too — so `--standalone --node <id>` prints
#                        `empty` (disposition concurrency-cap) at the cap. This is
#                        deliberately UNLIKE dispatch-select-tick's `<node-id>`
#                        lane, which skips the pace curve and the MAX_WORKERS
#                        ceiling outright because a human naming a node is
#                        sovereign; a --standalone caller is unattended, so it is
#                        ceiling-gated like every other --standalone selection.
#                        Human explicit dispatch belongs on dispatch-select-tick
#                        <node-id>, not here. NESTING: this flag
#                        acquires AND unconditionally releases the lock in one
#                        invocation, and its terminal --release is a strict
#                        self-release keyed on CLAUDE_CODE_SESSION_ID. Acquire is
#                        re-entrant (same-session no-op) but release is NOT, so a
#                        nested --standalone call would drop an OUTER hold. Use
#                        --standalone ONLY from standalone/manual callers that do
#                        not already hold dispatch-acquire-lock (no existing call
#                        site passes it: neither dispatch-select-tick's call nor
#                        its --pace-exempt-only probe does).
#   --pace-exempt-only   The probe lane for a paced-to-zero worker target
#                        (strategy clarification 14; legacy `priority` parity):
#                        first consult `dispatch-target-workers --exhausted` —
#                        genuine token exhaustion is a hard stop no flag
#                        overrides (prints `empty`); otherwise consider ONLY
#                        nodes authored `pace_exempt: true`. The caller admits
#                        up to its computed ceiling headroom via `--top` — the
#                        flag bypasses the pace GATE, not the worker count,
#                        the `max_concurrent_workers` ceiling, or the rank
#                        order.
#   --node <id>          Explicit single-node dispatch: bypass rank order and
#                        --top truncation and consider ONLY the named node id.
#                        Every existing environmental gate (claim-safety,
#                        per-phase sensor_gate) still applies verbatim — this
#                        is a selection-order override, not a gate bypass.
#                        Mutually exclusive with --top and --pace-exempt-only
#                        (usage error, exit 2, when combined). Combining it with
#                        --standalone is allowed but IS ceiling-gated — see the
#                        EXPLICIT-NODE DIVERGENCE note under --standalone.
#
# Env:
#   DISPATCH_GRAPH_NODE_CACHE  Tick-scoped directory (created and trap-removed
#                        by dispatch-select-tick) holding materialized node
#                        sets. When set, the origin/main snapshot is memoized at
#                        $DISPATCH_GRAPH_NODE_CACHE/nodes-tree-<sha>.json, keyed
#                        on the `origin/main:intentions` TREE SHA, and a hit
#                        skips `git archive`, `tar` and the YAML parse entirely.
#                        The var names a STORAGE LOCATION only, never a node
#                        subset: unset or empty, the selector self-enumerates on
#                        exactly today's path. The key is the tree object the
#                        archive would have produced, so an entry is a pure
#                        function of the tree being selected over; a corrupt or
#                        unusable entry is deleted and degrades to one fresh
#                        STRICT enumeration, never to a partial set, the tolerant
#                        reader, or a silent `empty`. See the block at
#                        `--- Tree-sha-keyed snapshot cache ---`.
#   GRAPH_CONFLICT_COMMIT_BUDGET  Max graph-commits the merge-conflict lane may
#                        land in ONE selection pass (enter/spend/clear/park —
#                        park-node's own commit counts). Positive integer,
#                        default 2. Candidates past it are skipped with
#                        `conflict-commit-budget-spent` and re-matched next tick.
#                        See the budget block above `_graph_commit_conflict`.
#
# Stdout protocol:
#   node <id> <kind> <phase>   zero to <top> lines, in selection order.
#   empty                      as the only line when nothing is selectable.
#
# Selection log: exactly one JSONL record per invocation — the input
# `tactic-dispatch-lifecycle-sensor` reads — appended (best-effort, non-fatal)
# to ${DISPATCH_SELECTION_LOG_FILE:-${DISPATCH_SELECTION_LOG_DIR:-$HOME/.local/share/commons-dispatch}/graph-selection.jsonl},
# alongside the routing-decisions log, via the shared lib-decision-log.sh
# appender (flock + rotation).
#
# Claimed set (uniform node-id claiming, strategy clarification 13): a node is
# skipped when a reservation-ledger marker named by its node id exists, or a
# live session named by its node id is registered (worktree_has_live_session is
# name-keyed on the worktree basename — a node-id worktree's basename IS the
# node id). Strategy ids claim identically, so an in-flight /align-tactics
# session keeps its strategy unselectable until its tactics land on
# origin/main.
#
# Requires `dangerouslyDisableSandbox: true` when run from a Claude session —
# the sensor gates call `gh`, and the liveness read queries the local Claude
# daemon over a Unix socket (see .claude/rules/sandbox.md).
#
# Exit codes: 0 on `node`/`empty`; 2 on usage or environment errors (a broken
# store snapshot, a failed selector run, dispatch-ci-ready env failure).
#
# NOT set -e: exits are handled explicitly (matching the sibling dispatch
# scripts).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# scripts → dispatch-propagate → skills → .claude → repo root.
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-reservation-ledger.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-claude-agents.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-graph-worktree.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-graph-rollback.sh"

# The selection log reuses the decision-log appender with its own file: the lib
# resolves its target from DISPATCH_DECISION_LOG_FILE at source time.
DISPATCH_DECISION_LOG_FILE="${DISPATCH_SELECTION_LOG_FILE:-${DISPATCH_SELECTION_LOG_DIR:-$HOME/.local/share/commons-dispatch}/graph-selection.jsonl}"
export DISPATCH_DECISION_LOG_FILE
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib-decision-log.sh" 2>/dev/null || true

TOP=1
TOP_SET=""
PACE_EXEMPT_ONLY=""
STANDALONE=""
# STANDALONE_LOCKED gates the _cleanup EXIT trap's lock release: set to 1 only
# once --standalone has actually acquired the lock (step below), so the trap
# never releases a lock this invocation does not hold.
STANDALONE_LOCKED=""
# STANDALONE_CLAIMED / STANDALONE_EMITTED gate the _cleanup EXIT trap's claim
# ROLLBACK. Claims are written per-candidate inside the selection loop, but a
# LATER candidate can abort the whole run before any selection reaches stdout
# (sensor_gate rc==2 — a dispatch-ci-ready environment failure — exits 2 with no
# output). Without rollback those already-written markers are handed to nobody:
# the caller launches nothing, so no dispatch-graph-execute ever clears them, and
# reservation_sweep keeps them until the standalone TTL expires. The trap clears
# every claim this invocation wrote unless the selection was actually emitted.
STANDALONE_CLAIMED=()
STANDALONE_EMITTED=""
NODE_TARGET=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --top)
      [[ $# -ge 2 && "${2:-}" =~ ^[1-9][0-9]*$ ]] \
        || { echo "graph-select-target: --top requires a positive integer" >&2; exit 2; }
      TOP="$2"; TOP_SET=1; shift 2 ;;
    --pace-exempt-only) PACE_EXEMPT_ONLY=1; shift ;;
    # --standalone: acquire the shared lock + apply the live-worker headroom cap
    # + claim each selected node, then unconditionally self-release the lock.
    # Never pass it from a caller already holding dispatch-acquire-lock — the
    # terminal self-release would drop that outer hold (see header comment).
    --standalone) STANDALONE=1; shift ;;
    --node)
      [[ $# -ge 2 && -n "${2:-}" ]] \
        || { echo "graph-select-target: --node requires a non-empty id" >&2; exit 2; }
      NODE_TARGET="$2"; shift 2 ;;
    *)
      echo "graph-select-target: unknown argument '$1'" >&2
      echo "usage: graph-select-target [--top <n>] [--pace-exempt-only] [--standalone] [--node <id>]" >&2
      exit 2 ;;
  esac
done

if [[ -n "$NODE_TARGET" && ( -n "$TOP_SET" || -n "$PACE_EXEMPT_ONLY" ) ]]; then
  echo "graph-select-target: --node is mutually exclusive with --top and --pace-exempt-only" >&2
  echo "usage: graph-select-target [--top <n>] [--pace-exempt-only] [--standalone] [--node <id>]" >&2
  exit 2
fi

# --- Selection-log emitter (best-effort, one record per invocation) ----------
# Accumulators consumed by the EXIT trap. SKIPPED is a JSON array of
# {id, reason} objects; SELECTED a JSON array of ids; EVENTS the pure
# selector's freeze/cap/gate events (JSON array).
MODE=$([[ -n "$NODE_TARGET" ]] && echo "node" || { [[ -n "$PACE_EXEMPT_ONLY" ]] && echo "pace-exempt" || echo "normal"; })
DISPOSITION=""
SELECTED_JSON="[]"
SKIPPED_JSON="[]"
EVENTS_JSON="[]"
ELIGIBLE_COUNT=0

_selection_log_emit() {
  local json
  json=$(jq -c -n \
    --arg ts "$(date -u +%FT%TZ)" \
    --arg site "graph-select-target" \
    --arg mode "$MODE" \
    --arg disposition "$DISPOSITION" \
    --arg top "$TOP" \
    --arg eligible "$ELIGIBLE_COUNT" \
    --argjson selected "$SELECTED_JSON" \
    --argjson skipped "$SKIPPED_JSON" \
    --argjson events "$EVENTS_JSON" \
    '{ts: $ts, site: $site, mode: $mode, disposition: $disposition,
      top: ($top | tonumber), eligible: ($eligible | tonumber),
      selected: $selected, skipped: $skipped, events: $events}' 2>/dev/null) || return 0
  command -v decision_log_append >/dev/null 2>&1 && decision_log_append "$json" || true
}

SNAPSHOT_DIR=""
_cleanup() {
  _selection_log_emit
  [[ -n "$SNAPSHOT_DIR" ]] && rm -rf "$SNAPSHOT_DIR"
  # Standalone claim rollback, BEFORE the lock release so the ledger is restored
  # while this invocation still holds the lock. Fires only when the run ended
  # without printing its selection (any non-`selected` exit: the sensor_gate
  # rc==2 abort, a signal, or any later-added early exit past the first claim).
  # On the success path STANDALONE_EMITTED is set just before the selection is
  # printed, so the caller's claims are left intact for it to hand to
  # dispatch-graph-execute (or release itself — see the CLAIM OBLIGATION note).
  if [[ -z "$STANDALONE_EMITTED" ]] && (( ${#STANDALONE_CLAIMED[@]} > 0 )); then
    local _cid
    for _cid in "${STANDALONE_CLAIMED[@]}"; do
      reservation_clear "$_cid" >/dev/null 2>&1 || true
    done
  fi
  # Standalone lock release (guarded so it fires only once --standalone actually
  # acquired the lock). Living in the EXIT trap covers EVERY exit path between
  # the standalone acquire and the final claim/release — the no-store early exit,
  # mktemp/git-archive/select-targets.ts failures, and any path added later —
  # without a hand-release at each site. Strict self-release; see the --standalone
  # header note on why nesting under an existing hold is forbidden.
  [[ -n "${STANDALONE_LOCKED:-}" ]] && "$SCRIPT_DIR/dispatch-acquire-lock" --release >/dev/null 2>&1
}
trap '_cleanup' EXIT

# --- Pace-exempt probe lane: the exhaustion hard floor ------------------------
# Genuine token exhaustion (the 5-hour or weekly window at ~100% with the reset
# still ahead) is a hard stop NO flag overrides — distinct from "paced to 0",
# the self-imposed throttle this lane exists to bypass. --exhausted fails open
# on missing telemetry (reports `ok`), so absent data never suppresses the lane.
if [[ -n "$PACE_EXEMPT_ONLY" ]]; then
  EXHAUSTED=$("$SCRIPT_DIR/dispatch-target-workers" --exhausted 2>/dev/null) || EXHAUSTED="ok"
  if [[ "$EXHAUSTED" == exhausted ]]; then
    echo "graph-select-target: rate-limit window exhausted; pace-exempt lane closed" >&2
    DISPOSITION="exhausted"
    echo "empty"
    exit 0
  fi
fi

# --- Standalone concurrency safety (--standalone) -----------------------------
# Folds in the SAME lock-acquire -> headroom-check -> (clamp) cycle
# dispatch-select-tick wraps around this selector, so a manual/emulated-tick
# caller gets the same double-dispatch protection. The claim (reservation_write)
# and the release both happen after selection (the release via the _cleanup
# EXIT trap, keyed on STANDALONE_LOCKED). Selector failure degrades to `empty`
# exit 0 — the convention dispatch-select-tick uses at this selector's call site.
if [[ -n "$STANDALONE" ]]; then
  # (a) Acquire the shared dispatch lock. Anything other than `acquired`
  # (busy, lock-error) degrades to empty rather than erroring.
  LOCK=$("$SCRIPT_DIR/dispatch-acquire-lock" --wait) || true
  if [[ "$LOCK" != acquired ]]; then
    DISPOSITION="lock-unavailable"
    echo "empty"
    exit 0
  fi
  STANDALONE_LOCKED=1

  # (b) Live-worker headroom cap. Mirrors dispatch-select-tick's --manual branch
  # ("manual context-dependent fan-out") for the LIVE_COUNT / MAX_WORKERS /
  # EXHAUSTED headroom computation and its busy-read failure guard, but
  # DELIBERATELY omits that branch's SPAWN_N floor-of-1 clamp
  # (dispatch-select-tick lines ~720-728, comment "Floor re-asserts past the
  # ceiling clamp: HEADROOM=0 must still yield one deliberate node"). That floor
  # is the human-dispatch-is-sovereign override — it exists so a literal human
  # keystroke always launches its one node. An automated/emulated --standalone
  # caller (a script, an emulated tick) is NOT sovereign, so at HEADROOM==0
  # --standalone degrades to the concurrency-cap/empty disposition instead of
  # breaching the MAX_WORKERS ceiling by one; breaching it for unattended callers
  # would reintroduce the milder over-subscription this whole tactic exists to
  # prevent. It likewise does NOT inherit that branch's pace-curve OVERRIDE: the
  # pace-curve gap (TARGET_N - LIVE_COUNT) is applied as a second ceiling below,
  # for the same non-sovereignty reason. LIVE_COUNT = busy workers + reservations.
  # Three of the four environmental reads fail OPEN, each to its own safe
  # default: EXHAUSTED → `ok` on missing telemetry; MAX_WORKERS → headroom
  # UNKNOWN on an unreadable or non-numeric ceiling; TARGET_N → pace budget
  # UNKNOWN on the same — converging on the fail-open floor, TOP=1 (the
  # standalone analogue of dispatch-select-tick's "GAP stays 1"), never leaving
  # TOP unclamped when the ceiling is unknown. The FOURTH read — daemon
  # UNKNOWN, busy-worker count failed/uncorroborated — is different: it means
  # true live occupancy can't be determined, not that a config ceiling is
  # unreadable, so it does NOT fail open to TOP=1. It fails CLOSED to the
  # concurrency-cap-style `live-read-unverified` disposition instead (see the
  # busy-read branch below) — assuming headroom while blind to occupancy risks
  # selecting a target an already-running worker owns.
  #
  # The ledger is SWEPT before it is counted, mirroring dispatch-select-tick's
  # autonomous gate. Since the spawn handoff landed, a launched claim is no
  # longer cleared at the kick but re-stamped `origin=spawned` and held until its
  # worker registers — so an unswept count charges a registered worker twice
  # (once busy, once reserved). That matters more here than on the manual lane:
  # this path deliberately omits the floor-of-1 above, so an inflated LIVE_COUNT
  # drives HEADROOM to 0 and the run selects NOTHING while real headroom exists.
  # Sweep rule (a) drops exactly those redundant markers. The dispatch lock is
  # already held (step (a) above), so the sweep cannot race a concurrent tick.
  reservation_sweep 1>&2 || true
  if BUSY=$(claude_agents_count_busy_workers); then
    RESV=$(reservation_count)
    LIVE_COUNT=$(( BUSY + RESV ))
    MAX_WORKERS=$("$SCRIPT_DIR/dispatch-target-workers" --max 2>/dev/null) || MAX_WORKERS=""
    TARGET_N=$("$SCRIPT_DIR/dispatch-target-workers" 2>/dev/null) || TARGET_N=""
    EXHAUSTED=$("$SCRIPT_DIR/dispatch-target-workers" --exhausted 2>/dev/null) || EXHAUSTED="ok"
    # HEADROOM="" is UNKNOWN — the --max read failed or returned a non-numeric
    # ceiling (dispatch config missing, unreadable, or carrying a garbled
    # max_concurrent_workers). Guarding it is what makes this read fail open like
    # its two siblings: unguarded, an EMPTY value makes
    # `$(( MAX_WORKERS - LIVE_COUNT ))` negative, the floor below clamps it to 0,
    # and the run degrades to the concurrency-cap disposition — reporting "fleet
    # saturated" when the truth is "ceiling unreadable", with nothing on stderr to
    # tell the two apart. A word-shaped value is worse: under `set -u` the
    # arithmetic aborts the script mid-run, holding the dispatch lock until the
    # EXIT trap unwinds.
    if [[ "$MAX_WORKERS" =~ ^[0-9]+$ ]]; then
      HEADROOM=$(( MAX_WORKERS - LIVE_COUNT ))
      (( HEADROOM < 0 )) && HEADROOM=0
    else
      echo "graph-select-target: dispatch-target-workers --max returned a non-numeric ceiling ('$MAX_WORKERS'); headroom unknown, failing open to --top 1" >&2
      HEADROOM=""
    fi
    # PACE-CURVE gap budget, the second ceiling. The MAX_WORKERS headroom above is
    # the ABSOLUTE ceiling; the pace curve (bare `dispatch-target-workers`, i.e.
    # TARGET_N) is the throttle the autonomous branch of dispatch-select-tick bounds
    # its fan-out by (`GAP = TARGET_N - LIVE_COUNT`). The --manual branch overrides
    # the pace curve because a human keystroke is sovereign; an unattended
    # --standalone caller is NOT (the same reason the floor-of-1 is dropped above),
    # so it must honor the throttle too — otherwise the documented way to pause the
    # queue (pin the pace curve so TARGET_N drops to 0) would be bypassed by any
    # cron job / emulated tick, spending the very token budget the pause protects.
    # Callers that genuinely need the pace bypass go through --pace-exempt-only.
    # GAP_BUDGET="" is UNKNOWN (read failed or non-numeric), handled like an
    # UNKNOWN ceiling: fail open to the TOP=1 floor, never to unbounded fan-out.
    if [[ "$TARGET_N" =~ ^[0-9]+$ ]]; then
      GAP_BUDGET=$(( TARGET_N - LIVE_COUNT ))
      (( GAP_BUDGET < 0 )) && GAP_BUDGET=0
    else
      echo "graph-select-target: dispatch-target-workers returned a non-numeric pace target ('$TARGET_N'); pace budget unknown, failing open to --top 1" >&2
      GAP_BUDGET=""
    fi
    if [[ "$EXHAUSTED" == exhausted ]] || [[ "$HEADROOM" == 0 ]] || [[ "$GAP_BUDGET" == 0 ]]; then
      # Concurrency-cap disposition (mirror dispatch-select-tick's): nothing to
      # select. The lock is released by the _cleanup EXIT trap. String compares,
      # not `(( HEADROOM == 0 ))`, so UNKNOWN ("") falls through to the fail-open
      # clamp below instead of being read as zero headroom / zero pace budget.
      [[ "$GAP_BUDGET" == 0 ]] && echo "graph-select-target: pace-curve budget exhausted (target $TARGET_N <= $LIVE_COUNT live); standalone selection is paced to zero" >&2
      DISPOSITION="concurrency-cap"
      echo "empty"
      exit 0
    fi

    # (c) Clamp the effective --top to the TIGHTER of the two ceilings — the
    # MAX_WORKERS headroom and the pace-curve gap budget. With EITHER of them
    # UNKNOWN, clamp to the same floor of 1 the busy-read UNKNOWN branch uses.
    if [[ -n "$HEADROOM" && -n "$GAP_BUDGET" ]]; then
      CLAMP=$HEADROOM
      (( GAP_BUDGET < CLAMP )) && CLAMP=$GAP_BUDGET
      (( TOP > CLAMP )) && TOP=$CLAMP
    else
      (( TOP > 1 )) && TOP=1
    fi
  else
    # daemon UNKNOWN (busy-worker read failed/uncorroborated, #lib-claude-agents
    # EMPTY-READ CORROBORATION). Unlike the MAX_WORKERS/TARGET_N config reads
    # above, this is NOT a "ceiling unreadable" case that can safely fail open to
    # TOP=1 — it means true live occupancy is unknown, so assuming any headroom
    # risks selecting a target an already-running worker owns (a duplicate
    # worker). Fail CLOSED: mirror the concurrency-cap disposition above rather
    # than fall through to the TOP=1 floor.
    DISPOSITION="live-read-unverified"
    echo "graph-select-target: busy-worker read unverified (daemon unreachable/uncorroborated); deferring rather than assuming headroom" >&2
    echo "empty"
    exit 0
  fi
fi

# --- Snapshot the store at origin/main ----------------------------------------
# origin/main only, never a branch or the working tree. A repo without an
# intentions/ store at origin/main has no graph work — a legitimate `empty`,
# not an error.
if ! git -C "$REPO_ROOT" cat-file -e origin/main:intentions 2>/dev/null; then
  DISPOSITION="no-store"
  echo "empty"
  exit 0
fi
SNAPSHOT_DIR=$(mktemp -d) || { echo "graph-select-target: mktemp failed" >&2; exit 2; }

# --- Tree-sha-keyed snapshot cache (tactic-done-node-retention-scan-cost) ------
# The snapshot above is a `git archive origin/main intentions | tar -x` into a
# FRESH mktemp dir every invocation (~75 ms), followed by a full YAML parse of
# every node (~300 ms on a 717-node store). Both costs scale with how many nodes
# EXIST rather than with what changed, which is what makes a retained done node
# expensive: it is re-extracted and re-parsed on every selection forever.
#
# DISPATCH_GRAPH_NODE_CACHE names a tick-scoped directory, created, exported and
# trap-removed by dispatch-select-tick exactly as DISPATCH_CI_VERDICT_CACHE is.
# It IS armed: dispatch-select-tick creates both caches side by side and drops
# both in one EXIT trap, so this block is LIVE on the autonomous tick path. (An
# earlier revision of this comment claimed nothing set the variable yet. That
# was already false when it was written — the arming had landed first.)
# It names a STORAGE LOCATION only — never a node subset, never a filter. When
# the var is unset or empty this block does nothing at all and the path below is
# byte-identical to what it has always been, which is the /dispatch-ladder and
# manual-invocation path.
#
# THE KEY IS THE TREE SHA, not a directory fingerprint. `store-cache.ts`'s
# resolved-dir-plus-content key cannot serve this caller: the store lives at a
# different mktemp path every tick, so that key could never hit. The
# `origin/main:intentions` tree sha is a STRONGER key anyway — it is the exact
# tree object `git archive` would have produced, so the entry is a pure function
# of the tree being selected over. One cheap `rev-parse` buys it.
#
# A consequence worth stating so the next reader does not read it as a bypass:
# because the key names origin/main's tree, a corruption in the WORKING TREE
# moves neither the key nor the answer. That is correct, not a hole — selection
# reads origin/main only, and always has. A corrupt node at origin/main does move
# the tree sha, misses, and is refused loudly by select-targets.ts's strict
# enumeration exactly as before.
#
# A corrupt or unusable entry degrades to a fresh STRICT enumeration — never to a
# partial set, never to the tolerant reader, never to a silent `empty`. The entry
# is deleted and the full archive path runs ONCE; there is no retry loop.
#
# "Unusable" is decided by an EXIT CODE, not by "the selector exited non-zero".
# select-targets.ts exits 3 for exactly one reason: the --nodes-json payload
# could not be read as a node array. Any other non-zero exit is a SELECTOR
# failure, and answering that by deleting the entry destroys a valid cache, runs
# the selector twice over identical nodes, republishes the identical array, fails
# anyway, and prints one operator-visible line blaming the cache for a fault in
# the router.
CACHE_DIR="${DISPATCH_GRAPH_NODE_CACHE:-}"
SNAPSHOT_ENTRY=""
# Initialized unconditionally: the archive below reads it, and `set -u` is on.
INTENTIONS_TREE=""
if [[ -n "$CACHE_DIR" ]]; then
  # rev-parse only; a failure here just means no key, so today's path runs.
  INTENTIONS_TREE=$(git -C "$REPO_ROOT" rev-parse origin/main:intentions 2>/dev/null) || INTENTIONS_TREE=""
  [[ -n "$INTENTIONS_TREE" ]] && SNAPSHOT_ENTRY="$CACHE_DIR/nodes-tree-$INTENTIONS_TREE.json"
fi

# --- Run the pure selector -----------------------------------------------------
# select-targets.ts emits {candidates:[...], events:[...]} — eligibility and
# ordering already applied; only environmental gates remain.
SELECTION=""
SELECTION_DONE=""
if [[ -n "$SNAPSHOT_ENTRY" && -f "$SNAPSHOT_ENTRY" ]]; then
  # The hit path: no `git archive`, no `tar`, no YAML parse. SNAPSHOT_DIR is
  # still created above because it also hosts the conflict-commit-budget counter
  # (see CONFLICT_BUDGET_FILE below); mktemp is under a millisecond, and the 75 ms
  # this skips is the archive and the extraction, not the directory.
  _sel_rc=0
  SELECTION=$(cd "$REPO_ROOT" && npx tsx packages/intentionsutil/scripts/select-targets.ts \
    --nodes-json "$SNAPSHOT_ENTRY") || _sel_rc=$?
  if (( _sel_rc == 0 )); then
    SELECTION_DONE=1
  elif (( _sel_rc == 3 )); then
    # 3 is select-targets.ts's ONLY "this payload is unusable" code. Deleting the
    # entry is the correct answer to that, and to nothing else.
    echo "graph-select-target: cache entry $SNAPSHOT_ENTRY unusable, re-snapshotting" >&2
    rm -f "$SNAPSHOT_ENTRY"
    SELECTION=""
  else
    # A SELECTOR failure. Deleting the entry here would destroy a valid cache,
    # run the selector a second time over the same nodes, republish the identical
    # array, fail again anyway — and leave the operator one visible line blaming
    # the cache for a fault in the router. Keep the entry; report the real cause.
    echo "graph-select-target: select-targets.ts failed (exit $_sel_rc) reading $SNAPSHOT_ENTRY — this is a SELECTOR failure, not a cache problem; the entry is kept" >&2
    exit 2
  fi
fi

if [[ -z "$SELECTION_DONE" ]]; then
  # Archive the tree the KEY names, not the ref that key was resolved from.
  # `origin/main` moves: a sibling worktree's `graph-commit` push+fetch landing
  # between the `rev-parse` above and this line — routine in this fleet — would
  # make `--emit-nodes` publish tree B's node array under `nodes-tree-<A>.json`.
  # A later selection that resolves back to tree A is then served B's nodes: a
  # silently wrong phase/`blocked_by` view, with no strictness violation to
  # catch it, breaking the "pure function of the tree being selected over"
  # invariant stated above. Pinning to the tree sha closes that window.
  #
  # `--prefix=intentions/` restores the path component. A tree object carries no
  # path of its own, so `git archive <tree>` emits its entries at the root while
  # `git archive origin/main intentions` emits them under `intentions/`. With
  # the prefix the two extractions are byte-identical (verified with `diff -r`).
  #
  # With no cache dir there is no key and nothing to pin, so that path keeps the
  # original spelling and is unchanged in every respect.
  ARCHIVE_ARGS=(origin/main intentions)
  if [[ -n "$INTENTIONS_TREE" ]]; then
    ARCHIVE_ARGS=(--prefix=intentions/ "$INTENTIONS_TREE")
  fi
  if ! git -C "$REPO_ROOT" archive "${ARCHIVE_ARGS[@]}" | tar -x -C "$SNAPSHOT_DIR"; then
    echo "graph-select-target: failed to snapshot intentions/ from origin/main" >&2
    exit 2
  fi
  if [[ -n "$SNAPSHOT_ENTRY" ]]; then
    SELECTION=$(cd "$REPO_ROOT" && npx tsx packages/intentionsutil/scripts/select-targets.ts \
      --dir "$SNAPSHOT_DIR/intentions" --emit-nodes "$SNAPSHOT_ENTRY") \
      || { echo "graph-select-target: select-targets.ts failed" >&2; exit 2; }
  else
    SELECTION=$(cd "$REPO_ROOT" && npx tsx packages/intentionsutil/scripts/select-targets.ts \
      --dir "$SNAPSHOT_DIR/intentions") \
      || { echo "graph-select-target: select-targets.ts failed" >&2; exit 2; }
  fi
fi

EVENTS_JSON=$(jq -c '.events' <<<"$SELECTION") || EVENTS_JSON="[]"
for evt in $(jq -r '.events[] | @base64' <<<"$SELECTION"); do
  echo "graph-select-target: event $(base64 -d <<<"$evt")" >&2
done

# --- Environmental gates, in selection order -----------------------------------
# The native node-id worktree location (<project-root>/.claude/worktrees/<id>;
# main is checked out at the project root). worktree_has_live_session is
# name-keyed on the basename, so the root resolution is presentational — the
# basename (the node id) is what is matched against live session names.
NATIVE_ROOT=$(resolve_main_worktree "$REPO_ROOT")
NATIVE_ROOT="${NATIVE_ROOT:-$REPO_ROOT}"

skip_note() { # <id> <reason>
  SKIPPED_JSON=$(jq -c --arg id "$1" --arg reason "$2" '. + [{id: $id, reason: $reason}]' \
    <<<"$SKIPPED_JSON") || true
}

# --- CI-fix interrupt helpers (tactic-fix-interrupt-orthogonal-state) ---------
# The store writes land in the MAIN checkout's working tree ($NATIVE_ROOT) and
# are committed to origin/main via graph-commit — the same state-only-commit-on-
# main convention transition-node and hold-node use. NATIVE_ROOT is resolved
# below, before the per-candidate loop that invokes these.

# _apply_fix <id> <mode-flag...> — run apply-fix-state against the main store.
# Its JSON result is on stdout for the caller to capture.
_apply_fix() {
  ( cd "$NATIVE_ROOT" \
    && npx tsx packages/intentionsutil/scripts/apply-fix-state.ts "$@" --dir "$NATIVE_ROOT/intentions" )
}

# _graph_commit_fix <message> <id> — land the on-disk fix-state write on main.
_graph_commit_fix() {
  ( cd "$NATIVE_ROOT" \
    && packages/intentionsutil/scripts/graph-commit -m "$1" "$2" ) >/dev/null 2>&1
}

# --- The write/land rollback -------------------------------------------------
# EVERY interrupt gate below mutates intentions/<id>.md on disk (apply-fix-state
# / apply-conflict-state) and lands it with a SEPARATE graph-commit. When that
# commit does not land, the mutated file is left dirty in the MAIN checkout —
# and graph-commit's assert_clean_outside_ids then refuses to START for every
# other graph writer in that checkout, whatever node it targets, until a human
# clears the file. One gate's failed write becomes a checkout-wide graph-write
# outage.
#
# That is not hypothetical: on 2026-08-13 the `--clear-fix` arm of
# _gate_fix_active left intentions/tactic-attention-namespaced-rank.md dirty
# (`fix: null` + the `reviewed` marker stripped — exactly what --clear-fix
# writes) when its graph-commit was itself refused by a pre-existing dirty
# flake.lock. The residue then re-refused every subsequent graph-commit from the
# main checkout, including this script's own on later ticks — a self-sustaining
# outage, one leaked write per tick.
#
# So: pin HEAD BEFORE the write, and restore to it on any failure. The restore
# is the shared graph_rollback_node_writes (lib-graph-rollback.sh), the same
# primitive reconcile-graph-merged and reconcile-graph-review-stall use — see
# that file's header for why it restores to HEAD rather than to a captured blob,
# and how it tells an ordinary rollback from graph-commit having moved HEAD.

# _arm_node_rollback — echo HEAD, to be captured before a gate's on-disk write.
# Echoes the empty string when HEAD is unreadable; the rollback then skips its
# moved-HEAD classification and does the plain restore, which is still strictly
# better than leaving the write behind.
_arm_node_rollback() {
  git -C "$NATIVE_ROOT" rev-parse HEAD 2>/dev/null || true
}

# _rollback_node_write <head-at-arm> <id> — undo a gate's on-disk write after
# its land failed. Best-effort by contract: the gate's own rc/skip-reason is
# unchanged by whether the rollback succeeded, but the rollback ALWAYS reports
# what it did on stderr (never on stdout — sensor_gate's stdout is captured
# whole as the emitted phase).
_rollback_node_write() {
  graph_rollback_node_writes "$NATIVE_ROOT" "$1" graph-select-target "$2" || true
}

# --- Merge-conflict interrupt helpers (tactic-graph-router-conflict-routing) --
# Structural siblings of _apply_fix/_graph_commit_fix above, for the orthogonal
# `execution.conflict` interrupt entered on a reviewed awaiting-merge node whose
# PR reports mergeable == CONFLICTING.

# _apply_conflict <id> <mode-flag...> — run apply-conflict-state against the
# main store. Its JSON result is on stdout for the caller to capture.
_apply_conflict() {
  ( cd "$NATIVE_ROOT" \
    && npx tsx packages/intentionsutil/scripts/apply-conflict-state.ts "$@" --dir "$NATIVE_ROOT/intentions" )
}

# --- The conflict lane's per-selection graph-commit budget -------------------
# Every write arm of the conflict gates below LANDS A COMMIT (this script's own
# graph-commit, or park-node's internal one) and then returns rc 1 — the node is
# NOT selected, so `--top` does not bound how many of them one selection pass
# runs. Left unbounded, a single push to main that conflicts with N reviewed
# awaiting-merge PRs at once (routine after a wide refactor) makes this loop
# serialize N landing-lock waits inside ONE hold of the dispatch lock:
# graph-commit waits up to LOCK_WAIT_SECONDS (1050s) for the landing lock while
# dispatch-acquire-lock reclaims a holder whose heartbeat is older than
# MAX_HOLD_SECONDS (300s). The tick then loses the lock mid-selection, a second
# tick starts selecting, and both spawn workers for the same nodes — the
# duplicate-worker / double-booked-worktree failure.
#
# So the lane spends an explicit budget of graph-commits per selection pass —
# the same reasoning reconcile-graph-review-stall records for its own ONE-commit
# cap — and the lock heartbeat is refreshed after each landed commit. Nodes past
# the budget are skipped with `conflict-commit-budget-spent` and picked up next
# tick: every conflict gate is idempotent (mergeability is re-read from GitHub,
# the interrupt state from the store), so nothing is lost by deferring.
#
# The counter lives in a FILE, not a variable: the gates run inside
# `emit_phase=$(sensor_gate ...)`, a command substitution, so any increment to a
# shell variable dies with that subshell.
CONFLICT_COMMIT_BUDGET="${GRAPH_CONFLICT_COMMIT_BUDGET:-2}"
if ! [[ "$CONFLICT_COMMIT_BUDGET" =~ ^[0-9]+$ ]] || (( CONFLICT_COMMIT_BUDGET < 1 )); then
  echo "graph-select-target: GRAPH_CONFLICT_COMMIT_BUDGET must be a positive integer, got '$CONFLICT_COMMIT_BUDGET'" >&2
  exit 2
fi
# The counter file lives inside SNAPSHOT_DIR (already created above, and removed
# by the EXIT trap), so the budget is scoped to exactly this selection pass.
CONFLICT_BUDGET_FILE="$SNAPSHOT_DIR/conflict-commit-budget"
printf '0\n' > "$CONFLICT_BUDGET_FILE" 2>/dev/null || true

# _conflict_budget_exhausted — rc 0 when the pass has already spent its budget.
# A missing/garbled counter file reads as 0 spent: the budget is a lock-hold
# safety valve, not an accounting record, and refusing every write on an
# unreadable counter would wedge the lane.
_conflict_budget_exhausted() {
  local spent
  spent=$(cat "$CONFLICT_BUDGET_FILE" 2>/dev/null) || spent=0
  [[ "$spent" =~ ^[0-9]+$ ]] || spent=0
  (( spent >= CONFLICT_COMMIT_BUDGET ))
}

# _conflict_budget_charge — spend one commit against the budget. Charged BEFORE
# the commit is attempted, so a commit that blocks and then fails still counts:
# what the budget bounds is time spent holding the dispatch lock, which a failed
# commit consumes exactly as a successful one does.
_conflict_budget_charge() {
  local spent
  spent=$(cat "$CONFLICT_BUDGET_FILE" 2>/dev/null) || spent=0
  [[ "$spent" =~ ^[0-9]+$ ]] || spent=0
  printf '%s\n' "$(( spent + 1 ))" > "$CONFLICT_BUDGET_FILE" 2>/dev/null || true
}

# _refresh_lock — bump the dispatch lock's heartbeat so a landed commit's wait
# cannot age the CALLER's hold past MAX_HOLD_SECONDS. Strict-owner and
# best-effort: a no-op when this process does not hold the lock (the
# --standalone lane holds it; under dispatch-select-tick the tick does, and
# dispatch-acquire-lock keys the refresh on the session, not the process). This
# is the "between sub-steps" refresh dispatch-select-tick's INVARIANT #2
# permits — it fires after a completed landing, never inside a retry/poll loop.
_refresh_lock() {
  [[ -x "$SCRIPT_DIR/dispatch-acquire-lock" ]] || return 0
  "$SCRIPT_DIR/dispatch-acquire-lock" --heartbeat >/dev/null 2>&1 || true
}

# _graph_commit_conflict <message> <id> — land the on-disk conflict-state write,
# charging the pass's commit budget and refreshing the lock heartbeat around it.
# Callers MUST have checked _conflict_budget_exhausted BEFORE making the on-disk
# apply-conflict-state write: a write with no commit behind it leaves intentions/
# dirty, which trips graph-commit's assert_clean_outside_ids for every graph
# writer in this checkout.
_graph_commit_conflict() {
  local rc=0
  _conflict_budget_charge
  ( cd "$NATIVE_ROOT" \
    && packages/intentionsutil/scripts/graph-commit -m "$1" "$2" ) >/dev/null 2>&1 || rc=$?
  _refresh_lock
  return $rc
}

# CONFLICT_ATTEMPT_CAP mirrors packages/intentionsutil/src/transitions.ts's
# constant of the same name (currently 3) — used only for the park reason's
# diagnostic prose, never for the capped decision itself (that stays
# apply-conflict-state.ts's `--park-if-capped`, the single source of truth for
# the comparison). Keep this literal in sync if the source constant changes.
CONFLICT_ATTEMPT_CAP=3

# FIX_ATTEMPT_CAP mirrors packages/intentionsutil/src/transitions.ts's constant
# of the same name (currently 3) — used only for the hold reason's diagnostic
# prose below, never for the capped decision itself (that stays
# apply-fix-state.ts's `--check-cap`, the single source of truth for the
# comparison). Keep this literal in sync if the source constant changes.
FIX_ATTEMPT_CAP=3

# _hold_node_fix_cap <id> <pr> <consumed> <attempt> <since> — build the
# reason/recommendation files hold-node requires and land a fix-attempt-cap
# hold (+ blocked_by edge on <id>, + a fix-attempt reset), reusing
# tmp/fix-checks-summary.md in <id>'s own worktree (its /fix-checks
# cross-iteration accumulator) as the hold body when it exists — this script
# runs from the MAIN checkout, so that worktree's tmp/ lives at
# $NATIVE_ROOT/.claude/worktrees/<id>/tmp/fix-checks-summary.md, not under
# $NATIVE_ROOT itself. Prints hold-node's stdout line on success; rc mirrors
# hold-node's own exit code.
_hold_node_fix_cap() {
  local id="$1" pr="$2" consumed="$3" attempt="$4" since="$5"
  local tmpdir reason_file rec_file body_file rc
  tmpdir=$(mktemp -d) || return 1
  reason_file="$tmpdir/reason.txt"
  rec_file="$tmpdir/recommendation.txt"
  {
    printf '/fix-checks retry budget exhausted: %s attempts concluded with PR #%s ' \
      "$consumed" "$pr"
    printf 'still red (execution.fix.attempt=%s, since %s) — the %s-attempt cap is exhausted.\n' \
      "$attempt" "$since" "$FIX_ATTEMPT_CAP"
  } > "$reason_file"
  {
    printf 'Review the fix-checks accumulator (tmp/fix-checks-summary.md in the '
    printf "node's worktree, also posted in PR comments; folded into this hold's "
    printf 'body when present) to diagnose why %s automated attempts did not resolve CI. ' \
      "$FIX_ATTEMPT_CAP"
    printf 'Resolve THIS HOLD TACTIC (phase: done, then prune) to unblock %s with a fresh ' "$id"
    printf 'retry budget (attempt was reset to 1), or abandon/redesign the tactic if the '
    printf 'current approach cannot work.\n'
  } > "$rec_file"

  body_file="$NATIVE_ROOT/.claude/worktrees/$id/tmp/fix-checks-summary.md"
  local hold_args=("$id" --kind fix-attempt-cap
    --reason-file "$reason_file" --recommendation-file "$rec_file")
  [[ -f "$body_file" ]] && hold_args+=(--body-file "$body_file")
  hold_args+=(--reset-fix-attempt)

  ( cd "$NATIVE_ROOT" && packages/intentionsutil/scripts/hold-node "${hold_args[@]}" ) \
    >/dev/null 2>&1
  rc=$?
  # Same heartbeat requirement as _hold_node_ci_pending below — this arm had the
  # gap first, and the class is fixed at both sites rather than half of it.
  _refresh_lock
  rm -rf "$tmpdir"
  return $rc
}

# _hold_node_ci_pending <id> <pr> <strikes> <sha> — build the reason and
# recommendation files and land a ci-pending-stalled hold (+ blocked_by edge on
# <id>) for a node whose draft PR's CI verdict has stayed `pending` on ONE head
# SHA for DISPATCH_CI_PENDING_STRIKE_CAP consecutive observations. rc mirrors
# hold-node's own exit code.
#
# No --reset-fix-attempt: this hold has nothing to do with the CI-fix ladder.
# No --body-file: there is no cross-iteration accumulator for this kind.
#
# The `>/dev/null 2>&1` redirect is LOAD-BEARING, not tidiness. sensor_gate is
# invoked in a command substitution (`emit_phase=$(sensor_gate ...)`), so any
# stray stdout from hold-node would be parsed as the emitted phase.
_hold_node_ci_pending() {
  local id="$1" pr="$2" strikes="$3" sha="$4"
  local tmpdir reason_file rec_file rc
  tmpdir=$(mktemp -d) || return 1
  reason_file="$tmpdir/reason.txt"
  rec_file="$tmpdir/recommendation.txt"
  {
    printf "This tactic's draft PR #%s has reported a \`pending\` CI verdict on head " "$pr"
    printf 'SHA %s for %s consecutive autonomous ticks (~%s minutes). Its checks ' \
      "$sha" "$strikes" "$(( strikes * 15 ))"
    printf 'either never started (an empty status-check rollup) or started and never '
    printf 'concluded, so no phase worker can be launched for %s and no verdict can ' "$id"
    printf 'ever arrive on its own.\n'
  } > "$reason_file"
  {
    printf "Inspect the PR's Checks tab. If no workflow run exists at all, re-trigger "
    printf 'one — close and reopen the PR, or push an empty commit to the node'"'"'s branch; '
    printf 'a new head SHA also resets this strike counter. If a run is stuck or was '
    printf 'cancelled by a queue or runner problem, re-run it. Then resolve THIS HOLD '
    printf 'TACTIC to `phase: done` and prune it — clearing `office_hours` alone does '
    printf 'not unblock %s.\n' "$id"
  } > "$rec_file"

  ( cd "$NATIVE_ROOT" && packages/intentionsutil/scripts/hold-node "$id" \
      --kind ci-pending-stalled \
      --reason-file "$reason_file" --recommendation-file "$rec_file" ) \
    >/dev/null 2>&1
  rc=$?
  # hold-node lands its own graph-commit, which can block on the GLOBAL landing
  # lock for far longer than MAX_HOLD_SECONDS (300s) — graph-commit waits up to
  # LOCK_WAIT_SECONDS (1050s). Bump the caller's heartbeat the way
  # _graph_commit_conflict does, so a completed hold cannot age the tick's own
  # dispatch lock out and let a second tick reclaim it and double-book the same
  # candidate set. NOT _conflict_budget_charge: GRAPH_CONFLICT_COMMIT_BUDGET
  # bounds the merge-conflict lane specifically, and spending it here would let
  # a couple of conflicts silently disable ci-pending holds altogether.
  _refresh_lock
  rm -rf "$tmpdir"
  return $rc
}

# _read_pr_ci <pr> — one gh_pr_view_rest + one CI verdict, into globals
# _CI_MERGED / _CI_HEAD / _CI_VERDICT / _CI_MERGEABLE. rc 1 when the PR is
# unreadable. _CI_MERGEABLE is read off the SAME already-fetched PR view (no
# extra gh round-trip): gh_pr_view_rest projects REST's boolean `.mergeable`
# into the porcelain enum MERGEABLE/CONFLICTING/UNKNOWN (lib.sh, the
# `mergeable:` branch of its jq projection).
_read_pr_ci() {
  local pr="$1" pv
  _CI_MERGED=""; _CI_HEAD=""; _CI_VERDICT=""; _CI_MERGEABLE=""
  pv=$(gh_pr_view_rest "$pr" 2>/dev/null) || return 1
  _CI_MERGED=$(jq -r '.mergedAt // empty' <<<"$pv" 2>/dev/null)
  _CI_MERGEABLE=$(jq -r '.mergeable // empty' <<<"$pv" 2>/dev/null)
  _CI_HEAD=$(jq -r '.headRefOid // empty' <<<"$pv" 2>/dev/null)
  [[ -n "$_CI_HEAD" ]] || return 1
  _CI_VERDICT=$(dispatch_ci_verdict_rest "$_CI_HEAD" 2>/dev/null || echo pending)
  return 0
}

# _gate_maybe_interrupt <id> <pr> <phase> — for a fix-interruptible ladder phase
# carrying NO active interrupt: decide whether an interrupt is due, and which lane
# it belongs to, by delegating to `interruptRoute`
# (packages/intentionsutil/src/transitions.ts — the single home of the
# CONFLICTING-outranks-failing-CI precedence rule). Only the `fix` route writes:
# it writes execution.fix and lands it on main.
#   rc 0 — fix interrupt entered (caller emits `fix` this tick).
#   rc 1 — no interrupt is due for this caller (caller falls through to the
#          phase's normal gate and the node is emitted at its ladder phase).
#          This covers BOTH the `null` route and the `conflict` route: a
#          CONFLICTING PR is DECLINED here — no execution.fix write, no
#          graph-commit, no fix attempt consumed — and reaches the conflict lane
#          through provision-node-worktree's exit 11 instead.
#   rc 3 — an interrupt was due but could not be acted on (write/commit failed,
#          an unreadable `.mergeable`, or a failed interruptRoute eval); a short
#          reason token is printed on stdout and the caller skips the node.
#
# STDOUT DISCIPLINE: on rc 1 this function must print NOTHING to stdout. The
# caller's arm falls through to its own `echo "$phase"`, and sensor_gate's whole
# stdout is captured as the emitted phase — so the conflict-decline diagnostic
# (and any future rc-1 note) goes to STDERR only. rc 1/rc 3 stdout tokens are
# recorded as skip reasons; rc 3 is the only rc-1-adjacent path that may print.
_gate_maybe_interrupt() {
  local id="$1" pr="$2" phase="$3"
  [[ "$pr" == "null" || -z "$pr" ]] && return 1
  _read_pr_ci "$pr" || return 1               # unreadable PR → do not interrupt
  [[ -n "$_CI_MERGED" ]] && return 1          # merged-awaiting-reconcile → not an interrupt

  # Cost guard, NOT the routing rule: interruptRoute returns null unless CI is
  # failing or the PR is CONFLICTING, so skip the node subprocess when neither
  # holds (the overwhelmingly common case). This condition MUST stay a
  # superset of interruptRoute's non-null conditions; the transitions.test.ts
  # case named for "the shell pre-filter's superset invariant" pins that.
  if [[ "$_CI_VERDICT" != "failing" && "$_CI_MERGEABLE" != "CONFLICTING" ]]; then
    return 1
  fi

  # Validate at the shell/TypeScript edge before crossing it — interruptRoute
  # takes closed unions, so an unexpected value would silently route to `null`
  # (mirrors reconcile-graph-review-stall's posture on the same fields).
  case "$_CI_MERGEABLE" in
    MERGEABLE|CONFLICTING|UNKNOWN) ;;
    *)
      echo "graph-select-target: unexpected .mergeable '$_CI_MERGEABLE' from gh_pr_view_rest #$pr for $id (projection changed?)" >&2
      echo "mergeable-unreadable"; return 3 ;;
  esac
  # dispatch_ci_verdict_rest emits passing|failing|pending; CiVerdict's third
  # member is "unknown". Normalize, exactly as reconcile-graph-review-stall does.
  local verdict
  case "$_CI_VERDICT" in
    passing|failing) verdict="$_CI_VERDICT" ;;
    *) verdict="unknown" ;;
  esac

  local route
  route=$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { interruptRoute } = await import("./packages/intentionsutil/src/transitions.js");
    process.stdout.write(String(interruptRoute(process.argv[1], process.argv[2], process.argv[3])));
  ' "$phase" "$verdict" "$_CI_MERGEABLE") ) || {
    echo "graph-select-target: interruptRoute eval failed for $id (pr #$pr)" >&2
    echo "route-eval-failed"; return 3
  }

  case "$route" in
    conflict)
      # Conflict outranks failing CI (transitions.ts, interruptRoute). DECLINE the
      # interrupt: no execution.fix write, no graph-commit, no attempt burned. The
      # candidate falls through to its phase's normal gate and is emitted at its
      # ladder phase; provision-node-worktree exit 11 -> dispatch-graph-execute
      # case 11 routes it to /dispatch-conflict Lane 3, which is the only lane
      # that actually resolves the conflict.
      #
      # STDERR ONLY. An rc-1 return falls through to the caller's own
      # `echo "$phase"`, and sensor_gate's stdout is captured whole as the emitted
      # phase — anything printed to stdout here corrupts the selection line.
      echo "graph-select-target: $id PR #$pr is CONFLICTING; conflict outranks failing CI — declining the fix interrupt (provisioning routes it to the conflict lane)" >&2
      return 1 ;;
    fix) ;;                 # fall through to the interrupt write below
    *) return 1 ;;          # "null" or anything else: no interrupt is due
  esac

  # CONCLUDED-RED at an interruptible phase, fix null (guaranteed: the router
  # would have emitted phase `fix` otherwise). Enter the interrupt this tick.
  local head_at_arm
  head_at_arm=$(_arm_node_rollback)
  if _apply_fix "$id" --set-fix >/dev/null 2>&1 \
     && _graph_commit_fix "graph: enter fix-interrupt on $id" "$id"; then
    return 0
  fi
  _rollback_node_write "$head_at_arm" "$id"
  echo "fix-write-failed"
  return 3
}

# _gate_fix_active <id> <pr> <pushed_sha> <fix_since> — the candidate already
# carries an active interrupt (router emitted phase `fix`). Resolve on green,
# guard/retry otherwise. Prints the phase to emit (rc 0), a skip reason
# (rc 1), or an env error (rc 2).
#
# DELIBERATELY CONFLICT-BLIND: this function reads CI only (`_read_pr_ci`'s
# `_CI_VERDICT`) and never consults `_CI_MERGEABLE`. A node that entered `fix`
# BEFORE the conflict appeared keeps retrying and guarding here, and can burn
# fix attempts against a CI verdict that describes stale pre-merge code. That
# is authorized scope residue of the tactic that made `_gate_maybe_interrupt`
# (above, around lines 537-559) conflict-aware at ENTRY — not an oversight:
# the node is not stranded, because `provision-node-worktree` exit 11 (routed
# by `dispatch-graph-execute` case 11 to `/dispatch-conflict` Lane 3) still
# catches it, and that lane is the only one that actually resolves the
# conflict. Closing this asymmetry belongs to a later, separate unification of
# this arm into the ordered `interruptRoute` cascade
# (packages/intentionsutil/src/transitions.ts), and, separately, to
# `tactic-graph-router-conflict-routing`'s `execution.conflict` state — neither
# of which this PR introduces.
_gate_fix_active() {
  local id="$1" pr="$2" pushed_sha="$3" fix_since="$4" out phase head_at_arm
  if [[ "$pr" == "null" || -z "$pr" ]]; then echo "no-pr"; return 1; fi
  if ! _read_pr_ci "$pr"; then echo "pr-state-unknown"; return 1; fi
  if [[ -n "$_CI_MERGED" ]]; then echo "pr-merged-awaiting-reconcile"; return 1; fi
  case "$_CI_VERDICT" in
    passing)
      # Resolution: clear the interrupt (+ the re-review reset when past review),
      # disarm any live auto-merge arm, and emit the resolved ladder phase.
      head_at_arm=$(_arm_node_rollback)
      out=$(_apply_fix "$id" --clear-fix 2>/dev/null) || {
        _rollback_node_write "$head_at_arm" "$id"
        echo "fix-clear-failed"; return 1
      }
      if ! _graph_commit_fix "graph: resolve fix-interrupt on $id" "$id"; then
        # THE observed leak (see the rollback helpers above): --clear-fix has
        # already written `fix: null` + the stripped `reviewed` marker to disk.
        _rollback_node_write "$head_at_arm" "$id"
        echo "fix-clear-commit-failed"; return 1
      fi
      gh pr ready --undo "$pr" >/dev/null 2>&1 || true
      phase=$(jq -r '.phase // "implement"' <<<"$out" 2>/dev/null) || phase="implement"
      echo "$phase"; return 0 ;;
    pending)
      # Pending-CI guard: the fix worker pushed and CI has not reported on that
      # exact sha yet — not ready (never misread a pending pushed-sha as green).
      if [[ -n "$pushed_sha" && "$pushed_sha" != "null" && "$pushed_sha" == "$_CI_HEAD" ]]; then
        echo "pending-ci-guard"; return 1
      fi
      # CI (re)running but not on a recorded push → stay in fix, ready to launch
      # /fix-checks.
      echo "fix"; return 0 ;;
    *)
      # failing again (a fix attempt did not clear CI). Enforce the retry cap
      # before re-arming: once FIX_ATTEMPT_CAP completed passes have concluded
      # red, land a tracked hold via hold-node (a born-parked hold tactic plus
      # a blocked_by edge on this node, NOT an office_hours park on the source
      # itself) and this node leaves the eligible set via that edge;
      # otherwise stay in fix, ready to retry. Do NOT re-clear or re-set the
      # interrupt itself — --check-cap is a pure read, no write.
      out=$(_apply_fix "$id" --check-cap 2>/dev/null) \
        || { echo "fix-cap-check-failed"; return 1; }
      if [[ "$(jq -r '.capped' <<<"$out" 2>/dev/null)" == "true" ]]; then
        local consumed attempt
        consumed=$(jq -r '.consumed' <<<"$out" 2>/dev/null)
        attempt=$(jq -r '.attempt' <<<"$out" 2>/dev/null)
        if ! _hold_node_fix_cap "$id" "$pr" "$consumed" "$attempt" "$fix_since"; then
          echo "fix-cap-hold-failed"; return 1
        fi
        echo "fix-attempt-cap-held"; return 1
      fi
      echo "fix"; return 0 ;;
  esac
}

# _park_conflict_cap <id> <pr> <attempt> — park the source node once the
# automated conflict-resolution budget is exhausted. Unlike the fix lane's
# _hold_node_fix_cap (a tracked hold tactic + blocked_by edge, because a fix
# retry budget is RESETTABLE by resolving the hold), a capped conflict has no
# reset flag to offer — park-node takes <reason> and <recommendation> as plain
# positional arguments (packages/intentionsutil/scripts/park-node's usage line),
# so no reason/recommendation FILES are involved here. rc mirrors park-node's.
_park_conflict_cap() {
  local id="$1" pr="$2" attempt="$3" reason rec
  reason=$(printf 'Automated conflict resolution exhausted: PR #%s still reports mergeable == CONFLICTING after %s lifetime attempt(s) — the %s-attempt cap (CONFLICT_ATTEMPT_CAP) is spent. The count is the node'"'"'s LIFETIME conflict spend (`execution.attempts.conflict`), which clearing and re-entering the interrupt deliberately does not refund.' \
    "$pr" "$attempt" "$CONFLICT_ATTEMPT_CAP")
  rec=$(printf 'Run `/dispatch-conflict %s` by hand, or resolve the merge conflict directly in that node'"'"'s worktree and push the branch. Then clear `office_hours` on %s to return it to the queue; the reviewed marker and its armed auto-merge are untouched, so dispatch-auto-merge lands it once GitHub reports MERGEABLE. Clearing the park alone does NOT hand back automated retries — the lifetime budget stays spent, so a still-conflicting node parks again on the next tick. To grant a fresh automated budget, zero `execution.attempts.conflict` on %s as well.' \
    "$id" "$id" "$id")
  ( cd "$NATIVE_ROOT" && packages/intentionsutil/scripts/park-node "$id" "$reason" "$rec" ) \
    >/dev/null 2>&1
}

# _gate_pending_merge <id> <pr> — the candidate is reviewed and awaiting its
# armed auto-merge (router emitted phase `pending-merge`), carrying NO conflict
# interrupt yet. Read the PR's mergeability and, on CONFLICTING, ENTER the
# interrupt this tick.
#   rc 0 — conflict interrupt entered (caller emits `conflict`).
#   rc 1 — not satisfied; a short skip-reason token is on stdout.
#   rc 3 — an interrupt was due but could not be acted on (write/commit failed,
#          or an unreadable `.mergeable`); a reason token is on stdout and the
#          caller skips the node.
_gate_pending_merge() {
  local id="$1" pr="$2" head_at_arm
  if [[ "$pr" == "null" || -z "$pr" ]]; then echo "no-pr"; return 1; fi
  if ! _read_pr_ci "$pr"; then echo "pr-state-unknown"; return 1; fi
  # A merge landed out of band — the merged-tactic reconciler's job, not this
  # gate's; it absorbs the node to `done` on the next tick.
  if [[ -n "$_CI_MERGED" ]]; then echo "pr-merged-awaiting-reconcile"; return 1; fi
  case "$_CI_MERGEABLE" in
    CONFLICTING)
      # Budget first — the check must precede the on-disk write, or a refused
      # commit would leave intentions/ dirty (see _graph_commit_conflict).
      if _conflict_budget_exhausted; then
        echo "conflict-commit-budget-spent"; return 1
      fi
      # --head-sha records the head the completed review examined. It is the
      # evidence the self-heal below is gated on: a clear that preserves the
      # `reviewed` marker is only safe while the PR still points at THIS tree.
      head_at_arm=$(_arm_node_rollback)
      if _apply_conflict "$id" --set-conflict --head-sha "$_CI_HEAD" >/dev/null 2>&1 \
         && _graph_commit_conflict "graph: enter conflict-interrupt on $id" "$id"; then
        return 0
      fi
      _rollback_node_write "$head_at_arm" "$id"
      echo "conflict-write-failed"; return 3 ;;
    MERGEABLE)
      # Clean: dispatch-auto-merge (a separate tick-wide reconciler) lands it.
      echo "mergeable-clean"; return 1 ;;
    UNKNOWN|"")
      # GitHub computes mergeability asynchronously and self-heals; wait and
      # retry next tick. NEVER route a conflict lane off an UNKNOWN.
      echo "mergeable-unknown"; return 1 ;;
    *)
      echo "graph-select-target: unexpected .mergeable '$_CI_MERGEABLE' from gh_pr_view_rest #$pr for $id (projection changed?)" >&2
      echo "mergeable-unreadable"; return 3 ;;
  esac
}

# _gate_conflict_active <id> <pr> — the candidate ALREADY carries an active
# conflict interrupt (router emitted phase `conflict`). Spend an attempt and
# re-dispatch while the PR is still conflicted, park at the lifetime cap, or —
# as a BACKSTOP for a worker that declared no disposition — clear the interrupt
# once GitHub reports the PR mergeable again.
#   rc 0 — still conflicted, an attempt was spent (caller emits `conflict`).
#   rc 1 — not satisfied; a short skip-reason token is on stdout (including the
#          capped-and-parked and the backstop-cleared paths — neither emits a
#          phase).
#   rc 3 — a due write could not be made; reason token on stdout.
_gate_conflict_active() {
  local id="$1" pr="$2" out capped attempt head_at_arm
  if [[ "$pr" == "null" || -z "$pr" ]]; then echo "no-pr"; return 1; fi
  if ! _read_pr_ci "$pr"; then echo "pr-state-unknown"; return 1; fi
  if [[ -n "$_CI_MERGED" ]]; then echo "pr-merged-awaiting-reconcile"; return 1; fi
  case "$_CI_MERGEABLE" in
    CONFLICTING)
      # Retry cap first: --park-if-capped is a PURE READ (no write, no park of
      # its own), so the park below is this script's to make.
      out=$(_apply_conflict "$id" --park-if-capped 2>/dev/null) \
        || { echo "conflict-cap-check-failed"; return 1; }
      capped=$(jq -r '.capped' <<<"$out" 2>/dev/null) || capped=""
      if [[ "$capped" == "true" ]]; then
        # park-node lands its OWN graph-commit, so it spends the same budget as
        # this script's commits — the lock-hold cost is identical.
        if _conflict_budget_exhausted; then
          echo "conflict-commit-budget-spent"; return 1
        fi
        attempt=$(jq -r '.attempt' <<<"$out" 2>/dev/null)
        _conflict_budget_charge
        if ! _park_conflict_cap "$id" "$pr" "$attempt"; then
          _refresh_lock
          echo "conflict-cap-park-failed"; return 1
        fi
        _refresh_lock
        echo "conflict-capped-parked"; return 1
      fi
      if _conflict_budget_exhausted; then
        echo "conflict-commit-budget-spent"; return 1
      fi
      head_at_arm=$(_arm_node_rollback)
      if _apply_conflict "$id" --spend-attempt >/dev/null 2>&1 \
         && _graph_commit_conflict "graph: spend conflict-interrupt attempt on $id" "$id"; then
        return 0
      fi
      _rollback_node_write "$head_at_arm" "$id"
      echo "conflict-spend-failed"; return 3 ;;
    MERGEABLE)
      # BACKSTOP for an undeclared resolution — never the normal exit from the
      # conflict lane. `/dispatch-conflict` Lane 3 owns the mechanical-vs-
      # intention verdict and declares it as its terminal act
      # (`--clear-conflict-mechanical` / `--clear-conflict-intention` +
      # graph-commit). A declared disposition sets execution.conflict to null, so
      # the router stops emitting `conflict` and this gate is not reached at all:
      # arriving here means the interrupt is STILL set while GitHub says the PR
      # merges — the worker died, was reaped, or never ran, and nobody classified
      # what changed.
      #
      # So the clear is GUARDED (`--clear-conflict-guarded --head-sha`), never
      # the caller's assertion that nothing meaningful changed. The primitive
      # compares the PR's current head against `execution.conflict.head_sha` —
      # the head recorded when the interrupt was entered, i.e. the tree the
      # `reviewed` verdict was earned on — and clears:
      #
      #   - MECHANICALLY (marker preserved) ONLY on an exact head match. Then
      #     nothing about this branch changed at all: the PR became mergeable
      #     because MAIN moved out from under the conflict, and the tree that
      #     will land is byte-identical to the reviewed one. There is no
      #     unreviewed diff to re-review.
      #   - BY INTENTION (marker stripped, phase held at `review`) in EVERY
      #     other case — the head advanced (a resolver rewrite, a force-push, a
      #     fresh commit; this gate cannot and must not try to tell them apart)
      #     or no head was ever recorded (a legacy interrupt). The `reviewed`
      #     verdict was taken against a tree that is no longer what would merge,
      #     and a mechanical clear would re-arm auto-merge on code no review saw.
      #     Re-review is the recoverable error (one wasted review pass); the
      #     alternative is unreviewed code on main.
      #
      # Re-draft the PR FIRST, before the verdict is known, so the legacy label
      # lane's isDraft gate holds across the whole window; the mechanical branch
      # re-readies it below. Best-effort both ways: the LOAD-BEARING disarm is
      # the marker strip (graph-auto-merge gates on the `reviewed` marker and
      # re-readies drafts itself), so a `gh` failure must not block the clear.
      if _conflict_budget_exhausted; then
        echo "conflict-commit-budget-spent"; return 1
      fi
      gh pr ready --undo "$pr" >/dev/null 2>&1 || true
      head_at_arm=$(_arm_node_rollback)
      if out=$(_apply_conflict "$id" --clear-conflict-guarded --head-sha "$_CI_HEAD" 2>/dev/null) \
         && _graph_commit_conflict "graph: guarded-clear undeclared conflict-interrupt on $id" "$id"; then
        if [[ "$(jq -r '.reset' <<<"$out" 2>/dev/null)" == "false" ]]; then
          # Head unchanged: the review verdict still binds, so hand the PR back
          # to the armed auto-merge it was waiting on.
          gh pr ready "$pr" >/dev/null 2>&1 || true
          echo "conflict-cleared-mergeable"; return 1
        fi
        # NOT an emitted phase: the node is now a fresh `review` candidate and
        # the review lane picks it up on a later tick.
        echo "conflict-cleared-rereview"; return 1
      fi
      _rollback_node_write "$head_at_arm" "$id"
      echo "conflict-clear-failed"; return 3 ;;
    UNKNOWN|"")
      echo "mergeable-unknown"; return 1 ;;
    *)
      echo "graph-select-target: unexpected .mergeable '$_CI_MERGEABLE' from gh_pr_view_rest #$pr for $id (projection changed?)" >&2
      echo "mergeable-unreadable"; return 3 ;;
  esac
}

# sensor_gate <id> <phase> <pr> <pushed_sha> — the phase's environmental sensor
# and CI-routing authority (§3.1; tactic-fix-interrupt-orthogonal-state).
#   0 = satisfied, the PHASE TO EMIT is on stdout (may differ from <phase>: a
#       fresh interrupt emits `fix`; a resolved interrupt emits the ladder phase).
#   1 = not satisfied (skip reason on stdout); 2 = environment error.
sensor_gate() {
  local id="$1" phase="$2" pr="$3" pushed_sha="$4" fix_since="$5" rc merged_at
  case "$phase" in
    fix)
      # An active interrupt (router override). Resolve/guard/retry.
      _gate_fix_active "$id" "$pr" "$pushed_sha" "$fix_since"; return $? ;;
    pending-merge)
      # Reviewed, awaiting the armed auto-merge (tactic-graph-router-conflict-
      # routing). CONFLICTING enters the interrupt and emits `conflict`; every
      # other outcome is a skip whose reason token _gate_pending_merge already
      # printed on stdout (rc 1 and rc 3 alike).
      _gate_pending_merge "$id" "$pr"
      case $? in
        0) echo "conflict"; return 0 ;;
      esac
      return 1 ;;
    conflict)
      # An active conflict interrupt (router override). Spend/park/self-heal.
      _gate_conflict_active "$id" "$pr"
      case $? in
        0) echo "conflict"; return 0 ;;
      esac
      return 1 ;;
    align-tactics)
      echo "align-tactics"; return 0 ;;
    implement)
      # Interruptible: a red PR at implement enters fix this tick; else ready
      # (implement has no CI gate of its own).
      _gate_maybe_interrupt "$id" "$pr" "$phase"
      case $? in
        0) echo "fix"; return 0 ;;
        3) return 1 ;;
      esac
      echo "implement"; return 0 ;;
    qa|review)
      # Interruptible: a red PR enters fix this tick; otherwise the existing
      # CI-verdict-present gate.
      _gate_maybe_interrupt "$id" "$pr" "$phase"
      case $? in
        0) echo "fix"; return 0 ;;
        3) return 1 ;;
      esac
      if [[ "$pr" == "null" || -z "$pr" ]]; then echo "no-pr"; return 1; fi
      # Defense in depth (tactic-graph-census-recurrence Unit 1): a merge that
      # lands between the tick's reconcile-graph-merged sweep and this selection
      # within the same tick must NOT be re-selected as a stale review target —
      # reconcile absorbs it to done next tick. REST reports a merged PR as
      # state `closed`, not MERGED; the merged signal is `mergedAt != null`
      # (same field reconcile-graph-merged reads). A read failure is non-fatal:
      # fall through to the CI-verdict check rather than misclassify.
      #
      # One PR read, two fields. The head SHA is what keys the CI-pending
      # strike ladder below, and it comes off the SAME projection as mergedAt —
      # no second REST round-trip. `<<<`, never `echo | jq`: zsh's builtin echo
      # un-escapes \t/\n and corrupts valid JSON (.claude/rules/shell-json.md).
      local pv head_sha=""
      if pv=$(gh_pr_view_rest "$pr" 2>/dev/null); then
        merged_at=$(jq -r '.mergedAt // empty' <<<"$pv" 2>/dev/null)
        head_sha=$(jq -r '.headRefOid // empty' <<<"$pv" 2>/dev/null)
        if [[ -n "$merged_at" ]]; then echo "pr-merged-awaiting-reconcile"; return 1; fi
      fi
      # NOT _CI_HEAD: _gate_maybe_interrupt returns early on a null PR BEFORE
      # _read_pr_ci resets the globals, so _CI_HEAD can still hold a previous
      # candidate's SHA at this point.
      "$SCRIPT_DIR/dispatch-ci-ready" "$id" >/dev/null 2>&1
      rc=$?
      case "$rc" in
        0)
          # CI concluded. Clear the ladder so the count always means
          # CONSECUTIVE pending observations, mirroring dispatch-graph-execute's
          # clear-on-success.
          ci_pending_strike_clear "$NATIVE_ROOT" "$id"
          echo "$phase"; return 0 ;;
        1)
          # ci-pending, now BOUNDED. Two cases keep today's behaviour verbatim:
          # an explicit --node run (a human re-running `dispatch <id>` must not
          # burn the autonomous budget), and an unreadable PR (no head SHA to
          # key the ladder on — counting every unreadable PR under one key would
          # hold an arbitrary node).
          if [[ -n "$NODE_TARGET" || -z "$head_sha" ]]; then
            echo "ci-pending"; return 1
          fi
          local strikes
          strikes=$(ci_pending_strike_bump "$NATIVE_ROOT" "$id" "$head_sha") || {
            echo "ci-pending"; return 1
          }
          if (( strikes < DISPATCH_CI_PENDING_STRIKE_CAP )); then
            echo "ci-pending (strike $strikes/$DISPATCH_CI_PENDING_STRIKE_CAP)"; return 1
          fi
          if _hold_node_ci_pending "$id" "$pr" "$strikes" "$head_sha"; then
            ci_pending_strike_clear "$NATIVE_ROOT" "$id"
            echo "ci-pending-cap-held"; return 1
          fi
          # Hold failed: do NOT clear the sidecar, so the next tick retries the
          # landing at cap — the same posture the fix-attempt-cap producer and
          # dispatch-graph-execute's strike ladder take.
          echo "ci-pending-hold-failed"; return 1 ;;
        *) echo "graph-select-target: dispatch-ci-ready failed (exit $rc) for $id" >&2; return 2 ;;
      esac ;;
    main-qa)
      # PR merged before main-qa (the prod-deploy-landed half of the gate
      # lands with tactic-main-qa-phase; the phase enum does not carry main-qa
      # until that tactic merges, so this arm is forward-compat).
      if [[ "$pr" == "null" || -z "$pr" ]]; then echo "no-pr"; return 1; fi
      # REST reports a merged PR as state `closed`, not MERGED; test the
      # `mergedAt` field (null unless the PR merged) instead of `.state`.
      if ! merged_at=$(gh_pr_view_rest "$pr" 2>/dev/null | jq -r '.mergedAt // empty'); then
        echo "pr-state-unknown"; return 1
      fi
      [[ -n "$merged_at" ]] && { echo "main-qa"; return 0; }
      echo "pr-not-merged"; return 1 ;;
    *)
      echo "unknown-phase"; return 1 ;;
  esac
}

SELECTED_COUNT=0
SELECTED_LINES=""
NODE_PRESENT=0
while IFS=$'\t' read -r id kind phase pr pace_exempt pushed_sha fix_since; do
  [[ -n "$id" ]] || continue
  [[ -n "$NODE_TARGET" ]] && NODE_PRESENT=1
  ELIGIBLE_COUNT=$(( ELIGIBLE_COUNT + 1 ))
  [[ -z "$NODE_TARGET" ]] && { (( SELECTED_COUNT >= TOP )) && continue; }

  if [[ -n "$PACE_EXEMPT_ONLY" && "$pace_exempt" != "true" ]]; then
    continue
  fi

  # Claimed set: reservation-ledger marker or live node-id session (uniform
  # node-id claiming — strategies included). worktree_has_live_session folds
  # daemon-UNKNOWN into occupied (fail-safe: never double-book a node).
  if reservation_exists "$id"; then
    skip_note "$id" "reserved"
    [[ -n "$NODE_TARGET" ]] && echo "graph-select-target: reserved" >&2
    continue
  fi
  # `worktree_occupancy_state` is the granular form of the same check: it makes
  # the same claimed-set decision (everything but `free` is skipped) while
  # naming WHY. `terminal` is an INVALID state — nothing is running, yet the
  # claim survives — and folding it into `live-session`, as this call did
  # before, made it invisible at the exact moment the router noticed it. The
  # node is still skipped in all four cases; this unit adds no routing, no
  # spawn and no graph write. The routing act lives in
  # `dispatch-invalid-state-sweep`, which runs before selection over the same
  # predicate, keeping session spawning out of a script humans invoke standalone.
  # Called DIRECTLY with stdout redirected, not via `$( )`: the evidence
  # globals are set in a subshell by a command substitution and would be lost,
  # so the diagnostic below would name a stale session id. See the CAVEAT in
  # `worktree_occupancy_state`'s header.
  worktree_occupancy_state "$NATIVE_ROOT/.claude/worktrees/$id" >/dev/null
  occupancy="$WORKTREE_OCCUPANCY_STATE"
  case "$occupancy" in
    free)
      : # fall through to the sensor gate
      ;;
    terminal)
      skip_note "$id" "terminal-session"
      if [[ -n "$NODE_TARGET" ]]; then
        echo "graph-select-target: terminal-session — $id is occupied-by-terminal (an INVALID state), not occupied-by-live: session ${WORKTREE_OCCUPANCY_SESSION_ID:-unknown} is registered but no longer running, and the claim survives until it is released" >&2
      fi
      continue
      ;;
    *)
      # `live` (a valid claim) and `unknown` (a daemon read that failed) both
      # report the unchanged `live-session` reason. UNKNOWN must NEVER surface
      # as an invalid state: a daemon hiccup would otherwise manufacture
      # interventions out of healthy nodes.
      skip_note "$id" "live-session"
      [[ -n "$NODE_TARGET" ]] && echo "graph-select-target: live-session" >&2
      continue
      ;;
  esac

  # sensor_gate returns the PHASE TO EMIT on stdout when satisfied — it may
  # differ from the candidate's `phase` (a fresh CI-fix interrupt emits `fix`
  # after writing execution.fix; a resolved interrupt emits the resolved ladder
  # phase after clearing it). On not-satisfied the stdout is the skip reason.
  emit_phase=$(sensor_gate "$id" "$phase" "$pr" "$pushed_sha" "$fix_since")
  rc=$?
  if (( rc == 2 )); then
    exit 2
  elif (( rc == 1 )); then
    skip_note "$id" "$emit_phase"
    [[ -n "$NODE_TARGET" ]] && echo "graph-select-target: $emit_phase" >&2
    continue
  fi

  # --standalone: claim the node in the reservation ledger (uniform node-id
  # claiming) so a concurrent tick sees it reserved. Same call shape (incl. the
  # 1>&2 redirect) dispatch-select-tick's emit_graph_selection uses; a failed
  # ledger write is a budget undercount, not a selection abort. The fail-open is
  # the intended operator contract: a transient ledger write failure must not
  # block manual dispatch, and the cost is bounded to a budget UNDERCOUNT for
  # this one slot (a concurrent tick may not see the node reserved) — matching
  # the failure posture of dispatch-select-tick's own emit_graph_selection call.
  #
  # The `standalone` ORIGIN stamp (4th arg) bounds the claim's lifetime. Unlike a
  # tick claim — handed straight to dispatch-graph-execute, which re-stamps it
  # `origin=spawned` on a successful spawn kick and lets reservation_sweep
  # release it once the worker registers as live (or via the bounded handoff
  # TTL if it never does) — a standalone claim has no guaranteed consumer: a caller that discards
  # the output, crashes, or is interrupted between selection and launch leaves the
  # marker behind, and reservation_sweep's dead-session rule never reclaims it while
  # the (long-lived) calling session stays alive. Markers stamped `origin=standalone`
  # are instead reclaimed by the sweep's TTL rule once they age past
  # DISPATCH_RESERVATION_STANDALONE_TTL_S with no live worker of that name, so a
  # leak costs a slot for one TTL rather than stalling the fleet indefinitely.
  # Callers that do not launch should still `reservation_clear <id>` promptly.
  # Each successful claim is recorded in STANDALONE_CLAIMED so the EXIT trap can
  # roll it back if a LATER candidate aborts the run before the selection is
  # printed (see the trap). A FAILED write is not recorded — there is nothing to
  # roll back.
  if [[ -n "$STANDALONE" ]]; then
    if reservation_write "$id" "$id" "${CLAUDE_CODE_SESSION_ID:-}" standalone 1>&2; then
      STANDALONE_CLAIMED+=("$id")
    else
      echo "graph-select-target: reservation_write failed for $id; proceeding without a ledger entry (budget may undercount this slot)" >&2
    fi
  fi

  SELECTED_LINES+="node $id $kind $emit_phase"$'\n'
  SELECTED_JSON=$(jq -c --arg id "$id" '. + [$id]' <<<"$SELECTED_JSON") || true
  SELECTED_COUNT=$(( SELECTED_COUNT + 1 ))
done < <(jq -r --arg target "$NODE_TARGET" \
  '.candidates[] | (if $target != "" then select(.id == $target) else . end) | [.id, .kind, .phase, (.pr // "null"), (.pace_exempt | tostring), (.fix.pushed_sha // "null"), (.fix.since // "null")] | @tsv' \
  <<<"$SELECTION")

if (( SELECTED_COUNT == 0 )); then
  if [[ -n "$NODE_TARGET" && "$NODE_PRESENT" == "0" ]]; then
    echo "graph-select-target: node $NODE_TARGET is not selectable (not found, done, parked, blocked, or already reviewed — inspect intentions/$NODE_TARGET.md directly for the reason)" >&2
    DISPOSITION="not-found"
  else
    DISPOSITION="empty"
  fi
  echo "empty"
  exit 0
fi

DISPOSITION="selected"
# Past this point the selection IS the caller's: suppress the EXIT trap's claim
# rollback so the emitted nodes stay claimed for the caller to launch.
STANDALONE_EMITTED=1
printf '%s' "$SELECTED_LINES"
exit 0
