#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
ISSUE_NUM=$(resolve_issue_number "${1:-}")
# Lean default covers both hot-path consumers; callers may pass a wider set if ever needed.
FIELDS="${2:-number,state,stateReason}"
[[ $# -lt 2 || -n "$2" ]] || { echo "issue-sub-issues: FIELDS arg must not be empty" >&2; exit 2; }
SUBS=$(gh_api_array "/repos/{owner}/{repo}/issues/$ISSUE_NUM/sub_issues" '.[].number')
for sub in $SUBS; do
  gh_retry gh issue view "$sub" --json "$FIELDS"
done
