#!/usr/bin/env bash
# reconcile-graph-merged — the graph-native reconciler sweep
# (tactic-graph-router-transitions Unit 2). The graph-lane analog of
# dispatch-reconcile-merged: it absorbs out-of-band PR events for open
# graph-native tactics into the graph state.
#
# For every merge-absorbable graph-native tactic (phase set; neither draft, done,
# nor main-qa) that carries an execution.pr, it reads the PR state via gh and
# hands the terminal ones to reconcile-graph.ts, which decides and applies the
# store mutations:
#   - merged, needs-main residue on the node → `main-qa` (verified post-merge),
#     recording the merge evidence (mergedAt + mergeCommitSha) on the node.
#   - a tactic ALREADY at `main-qa` is not enumerated for a merge — EXCEPT while
#     its recorded merge evidence is still absent, which is how a node minted at
#     qa record time is born. Such a node is enumerated purely so a
#     CLOSED-WITHOUT-MERGE source can retire it; a MERGE is still never absorbed
#     into it (reconcile-graph.ts's isMergeAbsorbable refuses, and this sweep
#     writes nothing). A node whose completion.mergedAt is recorded is never
#     enumerated, so the common case costs no gh call at all.
#     A node at `main-qa` has no merge left to absorb: either its merge evidence
#     was already recorded on the transition that put it there, or it was minted
#     directly at `main-qa` and the merge in question is its SOURCE's, recorded
#     on the source node. Re-processing it could only mis-classify it: a node
#     minted at `main-qa` carries `## Verification items`, not a
#     `## needs-main` heading, so it would read as residue-free and be swept to
#     `done`, destroying the verification node before `/qa-main` ever runs.
#     Advancing a `main-qa` node on a MERGE is `/qa-main`'s job, not this
#     sweep's. This exclusion mirrors `isMergeAbsorbable` in reconcile-graph.ts
#     — keep the two in step, along with `isCloseAbsorbable` beside it.
#   - merged without residue, or closed-not-merged → `done`. The node is NO
#     LONGER pruned at the done-transition: it is left present on disk with its
#     phase set to `done` and completion evidence recorded — for a genuine merge,
#     execution.completion.{mergedAt, mergeCommitSha}; for a closed-not-merged
#     PR, NO evidence at all (all three completion fields stay null). A separate
#     future scripted census/cleanup pass verifies the evidence, repairs inbound
#     blocked_by edges, and prunes the node — deletion and edge repair have moved
#     out of this reconciler. The all-null completion of a closed-unmerged
#     transition is a deliberate integrity-defect signal the census step can act
#     on, distinct from silent deletion.
#   - The serving strategy's round is still stamped here, at the done-transition,
#     when its last non-draft child reaches `done`.
# The whole plan (edits only) lands as ONE graph-commit, under a diagnosis-time
# compare-and-swap: each edited id's pre-mutation on-disk blob is pinned and
# passed as `graph-commit --base <id>=<blob>`, so an edit that lands on
# origin/main between this sweep's read and its commit is three-way merged
# rather than silently overwritten. See lib-graph-base-pin.sh (the shared pin
# primitive, extracted from this script) for why the pin is the DISK blob and why
# `hash-object -w` is mandatory, and
# .claude/skills/ref-diagnosis-time-cas/SKILL.md for the doctrine.
#
# Manual completion backfill (office-hours workflow, no script): when a tactic's
# PR is closed-unmerged but its content genuinely landed on `main` out-of-band,
# this reconciler transitions the node to `phase: "done"` with
# execution.completion === null. A human/AI session that judges the work complete
# backfills evidence by hand: discover the sha of the out-of-band commit that
# landed the content (via `git log`/`gh`), set execution.completion.graphCommitSha
# to it, write the node back via packages/intentionsutil/scripts/write-node.ts,
# then `graph-commit`. graphCommitSha is recorded by the authoring session (which
# knows the sha firsthand) — it is never derived automatically, since graph-commit
# prints no sha to stdout on success.
#
# GRACE window: a just-merged PR is not reconciled until it has aged past the
# grace window, so the sweep never races a merge that is still settling.
#
# office_hours: this sweep does NOT gate on a live office_hours park, and never
# should. graph-auto-merge gates on the park because it DECIDES — squash-merging
# is an irreversible autonomous action a park revokes authority for. This
# reconciler only RECORDS REALITY: the PR is already merged or closed on
# GitHub, so refusing to reconcile a parked node would strand it at a stale
# phase while GitHub disagrees with graph state — the exact divergence this
# reconciler exists to prevent. The park is not lost: office_hours is
# frontmatter the phase write never touches, and officeHoursQueue
# (packages/intentionsutil/src/officeHours.ts:48-75) keys only on
# office_hours !== null with no phase filter, so the node stays queued after
# reconciliation.
#
# Doctrine: run from a main-based checkout (the sweep writes state-only commits
# on main). Sandbox: the CALLER wraps every invocation with
# dangerouslyDisableSandbox — graph-commit's `git reset --hard` is a
# tree-updating op that half-applies over the read-only `.claude/**` carve-outs
# (see .claude/rules/sandbox.md and graph-commit's own NOTE (deployment)).
#
# Usage: reconcile-graph-merged [--node <id>]
#
#   --node <id>  Absorb ONLY the named node id. A SELECTION FILTER, never a
#                behavior change — this reconciler records reality and applies
#                no admission gates to change; the filter simply narrows the
#                enumeration, exactly as `graph-auto-merge --node` and
#                `graph-select-target --node` do. Absent the flag, behavior is
#                byte-identical to the unflagged sweep. It exists so a
#                single-node caller (the /dispatch-ladder driver) can absorb its
#                own merge without sweeping — and without racing the tick's
#                sweep across unrelated nodes.
#
# Stdout protocol: exactly `reconciled <id> -> <target>` per tactic acted on,
# and `deferred <id> (<reason>)` per deferred one; NOTHING for a skip.
#
# Exit codes: 0 (including a no-op sweep); 1 if any item hard-errored or the
# graph-commit failed; 2 on a usage error.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
# graph_rollback_node_writes — the shared roll-a-failed-node-write-back-to-HEAD
# primitive, extracted from THIS script so its siblings stop re-deriving it.
source "$SCRIPT_DIR/lib-graph-rollback.sh"
# The durable writer identity graph-commit stamps onto every commit it makes for
# this sweep, and the string graph_rollback_node_writes below compares each
# unpushed commit's `Graph-Writer:` trailer against — so a CONCURRENT writer's
# commit is recognised as not-ours and kept. It MUST stay identical to the
# <label> argument passed at the call site (see lib-graph-rollback.sh's header).
export GRAPH_WRITER=reconcile-graph-merged
# node_id_is_safe / require_safe_node_id / pin_base_blob — the shared
# diagnosis-time compare-and-swap pin, likewise extracted from THIS script.
source "$SCRIPT_DIR/lib-graph-base-pin.sh"

# ---- Argument parsing -------------------------------------------------------
NODE_FILTER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --node)
      [[ $# -ge 2 && -n "${2:-}" ]] \
        || { echo "reconcile-graph-merged: --node requires a non-empty id" >&2; exit 2; }
      NODE_FILTER="$2"; shift 2 ;;
    *)
      echo "reconcile-graph-merged: unknown argument '$1'" >&2
      echo "usage: reconcile-graph-merged [--node <id>]" >&2
      exit 2 ;;
  esac
done
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
UTIL_SCRIPTS="$REPO_ROOT/packages/intentionsutil/scripts"
GRAPH_COMMIT="$UTIL_SCRIPTS/graph-commit"

GRACE=${GRAPH_RECONCILE_GRACE:-600}
NOW=${GRAPH_RECONCILE_NOW:-$(date -u +%s)}

# --- Enumerate merge-absorbable graph-native tactics carrying a PR -----------
# One node pass: print `<id>\t<pr>` for every merge-absorbable tactic (phase set,
# not draft/done/main-qa) whose execution.pr is non-null.
# Enumeration is STRICT (`listNodesStrict`): a corrupt node file dropped by the
# tolerant reader would silently never be reconciled, stranding its merged PR at
# a stale phase. Abort the pass loudly instead.
#
# The id shape is validated HERE, at the point unvalidated frontmatter strings
# first enter the sweep, because the tab/newline-delimited `read` loops below
# cannot see the difference between a multi-line id and two records. See
# lib-graph-base-pin.sh for why an id carrying `=`, whitespace, or a control
# character is unsafe downstream (it silently re-keys graph-commit's
# `--base <id>=<sha>` pin). Refuse the sweep rather than reconcile the node with
# a broken or mis-keyed compare-and-swap base.
#
# `--node <id>` is applied HERE, as the first thing the loop tests (the id
# arrives via process.argv; an empty string means "no filter", so an ambient
# variable can never silently narrow an unflagged sweep). It is deliberately
# ahead of the id-shape validation below: that check guards the `--base <id>=<sha>`
# pin keys this run will write, and a node the filter excludes is never read,
# never edited, and never pinned — so it cannot mis-key anything. Validating a
# filtered-out sibling would abort a single-node absorb over a corruption with
# no bearing on it.
#
# `DISPATCH_GRAPH_NODE_CACHE` (packages/intentionsutil/src/store-cache.ts) names
# a storage LOCATION for a read-only, content-addressed memo of this same strict
# enumeration — never a node subset, so it cannot change the candidate set — and
# `--node` still arrives via process.argv, so unset or empty simply
# self-enumerates, which is the `/dispatch-ladder` single-node path.
OPEN_TACTICS="$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
  const { listNodesStrictCached } = await import("./packages/intentionsutil/src/store-cache.js");
  // Merge-absorbable phases. `main-qa` is deliberately ABSENT: it is an open
  // phase, but a node sitting at it has no merge of its own left to absorb.
  // Mirrors `isMergeAbsorbable` in reconcile-graph.ts.
  const absorbable = new Set(["implement","fix","qa","review"]);
  const idOk = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
  const only = process.argv[1] || "";
  // A main-qa node is enumerated ONLY while it carries no recorded merge
  // evidence — the shape a record-time mint is born with. Its PR state is
  // fetched so a closed-WITHOUT-merge source can retire it (reconcile-graph.ts
  // isCloseAbsorbable); a merged one is enumerated but written by nothing,
  // since isMergeAbsorbable still refuses.
  //
  // That last part has a standing cost, stated here because the obvious
  // reading of the line above is the opposite. Nothing in this sweep stamps
  // `completion.mergedAt` on a main-qa node, so a record-time mint whose PR
  // has merged never acquires the field that would drop it out of
  // `unprovenMainQa`. It is re-enumerated and re-fetched from gh on EVERY
  // sweep for its whole life at `main-qa`. The sweep is therefore not
  // self-limiting, and its gh cost grows with the number of merged main-qa
  // nodes rather than with the number of unverified ones.
  const unprovenMainQa = (n) =>
    n.phase === "main-qa" &&
    !(n.execution && n.execution.completion && n.execution.completion.mergedAt);
  for (const n of listNodesStrictCached("./intentions", process.env.DISPATCH_GRAPH_NODE_CACHE || "")) {
    if (only && n.id !== only) continue;
    if (n.kind !== "tactic") continue;
    if (n.phase === null) continue;
    if (!absorbable.has(n.phase) && !unprovenMainQa(n)) continue;
    const pr = n.execution && n.execution.pr;
    if (pr === null || pr === undefined) continue;
    if (!idOk.test(n.id)) {
      process.stderr.write("unsafe node id " + JSON.stringify(n.id) +
        " (must match /^[A-Za-z0-9][A-Za-z0-9._-]*$/)\n");
      process.exit(1);
    }
    process.stdout.write(n.id + "\t" + pr + "\n");
  }
' "$NODE_FILTER") )" || { echo "reconcile-graph-merged: node enumeration failed" >&2; exit 1; }

[[ -z "$OPEN_TACTICS" ]] && exit 0

# --- Resolve each PR's terminal state, honoring the grace window -------------
STATES="{}"
HARD_ERROR=0
while IFS=$'\t' read -r id pr; do
  [[ -n "$id" && -n "$pr" ]] || continue
  rc=0
  PR_JSON=$(gh_pr_view_rest "$pr" 2>/dev/null) || rc=$?
  if [[ "$rc" -ne 0 || -z "$PR_JSON" ]]; then
    echo "reconcile-graph-merged: gh_pr_view_rest #$pr for $id failed (rc=$rc)" >&2
    HARD_ERROR=1
    continue
  fi
  STATE=$(jq -r '.state' <<<"$PR_JSON")
  MERGED_AT=$(jq -r '.mergedAt // empty' <<<"$PR_JSON")
  MERGE_SHA=$(jq -r '.mergeCommitSha // empty' <<<"$PR_JSON")
  # Enumerate the states explicitly. REST reports a merged PR as CLOSED (never
  # MERGED — see the byte-compat test in test-dispatch-scripts.sh), so the
  # merged/closed discriminator inside the terminal arm is `mergedAt` presence,
  # NOT the state string. An unrecognized state must NOT fall through to the
  # terminal arm: that would drive a `done` transition on a live in-flight
  # tactic. Fail loudly instead (clear error over a silent, destructive default).
  case "$STATE" in
    OPEN) : ;;  # nothing to reconcile
    CLOSED|MERGED)
      if [[ -n "$MERGED_AT" ]]; then
        AGE=$(( NOW - $(date -u -d "$MERGED_AT" +%s) ))
        [[ "$AGE" -ge "$GRACE" ]] || continue   # still settling — next sweep
        STATES=$(jq -c --arg id "$id" --arg ma "$MERGED_AT" --arg sha "$MERGE_SHA" \
          '. + {($id): {state:"merged", mergedAt:$ma, mergeCommitSha:$sha}}' <<<"$STATES")
      else
        STATES=$(jq -c --arg id "$id" '. + {($id): {state:"closed"}}' <<<"$STATES")
      fi ;;
    *)
      echo "reconcile-graph-merged: unexpected PR state '$STATE' for $id (#$pr) — not reconciled" >&2
      HARD_ERROR=1 ;;
  esac
done <<<"$OPEN_TACTICS"

# Nothing terminal this sweep.
if [[ "$STATES" == "{}" ]]; then
  [[ "$HARD_ERROR" -ne 0 ]] && exit 1
  exit 0
fi

# --- Decide + apply the store mutations --------------------------------------
# Plan-then-apply: a --no-apply run yields the plan's exact edit id set WITHOUT
# touching disk; we pin each of those ids' pre-mutation on-disk blob, THEN run
# the real apply. Both runs read the same unmutated intentions/ dir (nothing
# else writes it between them), so the plan is deterministic — the pinned ids
# match the ids the apply run mutates.
#
# The pinned blob is the diagnosis-time compare-and-swap base handed to
# graph-commit as --base <id>=<blob>. Without it, graph-commit's
# check_base_freshness() short-circuits on its first line and the sweep lands
# whatever reconcile-graph.ts's writeNode put on disk, silently overwriting any
# edit that landed on origin/main between this sweep's read and its commit.
# That lost update is bug X: writeNode rewrites the WHOLE node from the
# in-memory read, so a live office_hours park landed by another writer inside
# that window was erased with `phase` left untouched.
#
# Ruling 31, read side vs write side — do NOT "simplify" this pin away as
# redundant with the read-side ungating. This sweep deliberately stays UNGATED
# on office_hours for its phase/merge decisions: it must keep advancing and
# merging parked nodes. The pin governs the WRITE side only. It makes the sweep
# skip nothing; it makes graph-commit merge a concurrently landed field instead
# of clobbering it. Both properties hold at once.
#
# graph-commit MERGES rather than refuses on drift: on a stale base it runs the
# structural three-way merge (base = the pinned blob, ours = our on-disk edit,
# theirs = origin/main's landed content) and parks only when a divergence is
# genuinely unresolvable. office_hours is a SCALAR_FIELD this sweep never
# touches, so ours == base and scalarMerge takes theirs — the concurrent park
# survives — while our phase/completion edits take the "theirs unchanged → take
# ours" leg. Absorbing the park beats refusing the whole sweep.
STATES_FILE="$(mktemp)" || { echo "reconcile-graph-merged: mktemp failed" >&2; exit 1; }
declare -A BASE_BLOB=()
RESTORE_ON_FAILURE=0
# HEAD as of the moment the rollback is armed — the exact commit the apply run's
# disk mutation sits on top of, and the only commit `git checkout --` can be
# trusted to restore to. Captured in Step 3; read by restore_node_files().
HEAD_AT_ARM=""

# The id-shape gate lives in lib-graph-base-pin.sh — see that file's header for
# WHY an id carrying `=`, whitespace, or a control character is unsafe as a
# `--base <id>=<sha>` pair key. This sweep uses the hard-error form
# (require_safe_node_id): a planned edit id it cannot pin is a real error, not a
# skip, because a skipped pin is an UNPROTECTED write.

# WRITTEN_IDS — the ids this sweep has actually mutated on disk, and the ONE
# source restore_node_files() arms the rollback from. It is deliberately not
# `${!BASE_BLOB[@]}`, which is the Step 2 PIN set: the two are equal only while
# the two reconcile-graph.ts runs agree, and this script already hard-errors on
# their disagreement in the opposite direction (the missing-pin check at the
# --base loop below). Reading the pins here made the disarm-free empty-plan exit
# unsound: the emptiness test reads the APPLY run's `.edit[]`, while the
# rollback's no-ids guard was reading Step 2's keys, so a plan that drifted to
# EMPTY between the two runs left a non-empty id set on a zero-write path — and
# the sweep announced "rolled the node write(s) back to HEAD" for a sweep that
# wrote nothing, the exact false claim the no-ids guard exists to eliminate.
#
# The two assignments below are the whole contract, and both are exact:
#   - Before the apply run, the pin set is the only bound available, and it is
#     the correct conservative one — a mid-run failure may have written any
#     prefix of it.
#   - After the apply run returns, `.edit[]` IS the written set. Every
#     writeNode() in reconcile-graph.ts is immediately followed by an
#     editSet.add() of the same id (reconcile-graph.ts:269-270, 301-302,
#     324-325) and `--no-apply` skips only the writeNode half, so `.edit[]`
#     enumerates exactly the files the apply run touched — no more (a pinned id
#     the apply dropped was never written) and no less (an id the apply added
#     without a pin is written, and gets rolled back rather than stranded).
declare -a WRITTEN_IDS=()
# The rollback itself lives in lib-graph-rollback.sh — see that file's header
# for WHY it restores to HEAD rather than to a captured blob, and how it tells
# an ordinary rollback from graph-commit having moved HEAD (a landed park vs. an
# un-landed, stranded commit). This wrapper only supplies the ids.
restore_node_files() {
  graph_rollback_node_writes "$REPO_ROOT" "$HEAD_AT_ARM" reconcile-graph-merged \
    "${WRITTEN_IDS[@]}"
}
# Single EXIT trap (bash traps REPLACE on a signal, not stack): always drop the
# temp file, and roll the write back when a post-pin step armed the flag.
trap 'rc=$?; rm -f "$STATES_FILE"; [[ "$RESTORE_ON_FAILURE" -ne 0 ]] && restore_node_files; exit $rc' EXIT
printf '%s' "$STATES" > "$STATES_FILE"

# Step 1: plan-only run (no disk mutation) to learn the id set to pin.
PLAN_ONLY="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/reconcile-graph.ts" --pr-states "$STATES_FILE" --no-apply) )" || {
  echo "reconcile-graph-merged: reconcile-graph.ts --no-apply failed" >&2; exit 1; }

# Step 2: pin every planned edit id's diagnosis-time base blob — the blob of the
# ON-DISK file, which is exactly the content reconcile-graph.ts's readNode reads
# in Step 3. pin_base_blob (lib-graph-base-pin.sh) holds the two properties an
# implementer must not lose: `-w` is mandatory, and the blob pinned is the DISK
# blob and never origin/main's. See that file's header for both.
#
# pin_base_blob RETURNS non-zero rather than exiting, so each caller picks its
# posture. This sweep keeps the hard error (.claude/rules/code-style.md: clear
# errors over fallbacks) — a hash-object failure on a planned edit id is a real
# error, not a skip. The diagnostic is already printed; supply only the exit.
while IFS= read -r sid; do
  [[ -n "$sid" ]] || continue
  require_safe_node_id reconcile-graph-merged "$sid"
  blob=$(pin_base_blob "$REPO_ROOT" reconcile-graph-merged "$sid") || exit 1
  BASE_BLOB[$sid]="$blob"
done < <(jq -r '.edit[]?' <<<"$PLAN_ONLY")

# Step 3: real apply run — mutates disk; its stdout drives the rest of the
# script. Arm the rollback: any failure from here through graph-commit restores.
# Pin HEAD first: it is the commit the mutation sits on, and restore_node_files()
# compares against it to tell an ordinary rollback from graph-commit having moved
# HEAD (landed park vs. un-landed, stranded commit). Only the rollback path
# reports what it actually did — the failure sites below name the CAUSE only, and
# never claim the write was rolled back.
HEAD_AT_ARM="$(git -C "$REPO_ROOT" rev-parse HEAD)" || {
  echo "reconcile-graph-merged: cannot read HEAD before the apply run (no rollback reference point)" >&2; exit 1; }
# The conservative bound, for a failure INSIDE the apply run: it may have
# written any prefix of the planned set before dying, and the pins are the only
# enumeration of that set available before its stdout is read. Narrowed to the
# exact written set the moment the plan is parsed, below.
WRITTEN_IDS=("${!BASE_BLOB[@]}")
RESTORE_ON_FAILURE=1
PLAN="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/reconcile-graph.ts" --pr-states "$STATES_FILE") )" || {
  echo "reconcile-graph-merged: reconcile-graph.ts failed" >&2; exit 1; }

# Report deferrals. Nothing in reconcile-graph.ts pushes to `deferred` anymore —
# its only producer was a main-qa schema-migration guard that has since landed —
# but the key stays part of the stable output contract, so keep draining it. A
# node routed to `main-qa` is handed off to /qa-main's node lane, which owns
# advancing it from there; this sweep never touches it again.
while IFS= read -r d; do
  [[ -n "$d" ]] || continue
  did=$(jq -r '.id' <<<"$d"); dreason=$(jq -r '.reason' <<<"$d")
  echo "deferred $did ($dreason)"
done < <(jq -c '.deferred[]?' <<<"$PLAN")

# --- Land the plan as one graph-commit ---------------------------------------
mapfile -t EDIT < <(jq -r '.edit[]?' <<<"$PLAN")
# The apply run returned, so its `.edit[]` is now the EXACT written set (see
# WRITTEN_IDS' declaration). Narrowing here is what makes the empty-plan exit
# below sound: with no edits, the rollback is armed with no ids and its no-ids
# guard genuinely fires, rather than firing only when the pins happen to agree.
WRITTEN_IDS=("${EDIT[@]}")
if [[ "${#EDIT[@]}" -eq 0 ]]; then
  # NO HAND-DISARM HERE, and that is a deliberate retirement rather than an
  # omission. An empty apply plan means the apply run mutated nothing, so the
  # EXIT trap's restore_node_files() is a zero-write call — and a
  # `RESTORE_ON_FAILURE=0` used to sit here to keep it from running at all,
  # because the shared rollback did two harmful things on that path:
  #
  #   1. it logged "rolled the node write(s) back to HEAD" for a sweep that
  #      wrote nothing, which is simply false in the journal;
  #   2. it compared HEAD against HEAD_AT_ARM, read a CONCURRENT graph writer's
  #      commit landed during our planning window as OUR stranded write, and
  #      `git reset --mixed`ed away a commit this sweep never made.
  #
  # Both are now fixed where they were caused, in lib-graph-rollback.sh: (1) by
  # the no-ids guard at the top of graph_rollback_node_writes, which returns
  # silently rather than claiming a rollback it did not perform, and (2) by the
  # `Graph-Writer:` attribution, which classifies a peer writer's commit as not
  # ours and keeps it. A caller-side flag could only ever have covered harm (2)
  # on the paths that remembered to set it — never the ARMED path, and never
  # graph-select-target, which has no such flag at all.
  #
  # An empty plan is ROUTINE, not exceptional: unprovenMainQa enumerates a
  # merged record-time mint on every sweep and isMergeAbsorbable then refuses
  # it, so this path is reached often. That is why it is pinned by a test
  # (test-graph-write-rollback.sh case 9b) rather than left to reasoning.
  #
  # The no-ids guard really does fire here, and it does so UNCONDITIONALLY
  # rather than as a consequence of the two runs agreeing. Every writeNode() in
  # reconcile-graph.ts is paired with an editSet.add(), so an empty `.edit[]`
  # means no node file was written — and WRITTEN_IDS was narrowed to `.edit[]`
  # immediately above, so the rollback is armed with an EMPTY id set on exactly
  # the paths that wrote nothing. Arming it from the Step 2 pins instead made
  # this reasoning conditional on plan stability between the --no-apply and
  # apply runs, which is precisely the drift the --base loop below hard-errors
  # on in the other direction.
  [[ "$HARD_ERROR" -ne 0 ]] && exit 1
  exit 0
fi

GC_ARGS=(-C "$REPO_ROOT" -m "graph: reconcile terminal tactics (record completion)")
# Thread the diagnosis-time pins as repeated --base flags. graph-commit accepts
# both a manifest file and repeated flags; the repeated form drops straight into
# the existing edit-id loop. The <id>=<sha> PAIR form (never a bare sha) is
# required for a multi-id call and is a free correctness guard — graph-commit
# die()s on a malformed pair. Every planned edit id was pinned in Step 2 from
# the same deterministic plan, so a missing pin means the plan drifted between
# the two runs: hard-error rather than land an unprotected write.
#
# Re-gate the id shape here too, at the exact point the `<id>=<sha>` pair is
# built: graph-commit splits the pair at the FIRST `=`, so an id carrying one
# would be silently re-keyed onto a different node (see lib-graph-base-pin.sh).
for id in "${EDIT[@]}"; do
  require_safe_node_id reconcile-graph-merged "$id"
  [[ -n "${BASE_BLOB[$id]:-}" ]] || {
    echo "reconcile-graph-merged: no pinned base blob for planned edit id $id (plan drifted between the --no-apply and apply runs)" >&2
    exit 1; }
  GC_ARGS+=(--base "$id=${BASE_BLOB[$id]}")
done
for id in "${EDIT[@]}"; do GC_ARGS+=("$id"); done

if ! "$GRAPH_COMMIT" "${GC_ARGS[@]}"; then
  # No rollback claim here — restore_node_files() (EXIT trap) inspects HEAD and
  # reports what it actually did, since graph-commit can fail with the write
  # already committed locally (rc 11, busy main) or with a park landed.
  echo "reconcile-graph-merged: graph-commit failed" >&2
  exit 1
fi
# Landed — disarm the rollback so the clean exit keeps the committed state.
RESTORE_ON_FAILURE=0

# Report what was reconciled.
while IFS= read -r r; do
  [[ -n "$r" ]] || continue
  rid=$(jq -r '.id' <<<"$r"); rtarget=$(jq -r '.target' <<<"$r")
  echo "reconciled $rid -> $rtarget"
done < <(jq -c '.reconciled[]?' <<<"$PLAN")

[[ "$HARD_ERROR" -ne 0 ]] && exit 1
exit 0
