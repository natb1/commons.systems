#!/usr/bin/env bash
# reconcile-graph-merged — the graph-native reconciler sweep
# (tactic-graph-router-transitions Unit 2). The graph-lane analog of
# dispatch-reconcile-merged: it absorbs out-of-band PR events for open
# graph-native tactics into the graph state.
#
# For every open graph-native tactic (phase set, neither draft nor done) that
# carries an execution.pr, it reads the PR state via gh and hands the terminal
# ones to reconcile-graph.ts, which decides and applies the store mutations:
#   - merged, needs-main residue on the node → `main-qa` (verified post-merge),
#     recording the merge evidence (mergedAt + mergeCommitSha) on the node.
#   - merged without residue, or closed-not-merged → `done`. The node is NO
#     LONGER pruned at the done-transition: it is left present on disk with its
#     phase set to `done` and completion evidence recorded — for a genuine merge,
#     execution.completion.{mergedAt, mergeCommitSha}; for a closed-not-merged
#     PR, NO evidence at all (all three completion fields stay null). A separate
#     future scripted census/cleanup pass verifies the evidence, repairs inbound
#     blocked_by edges, and prunes the node — deletion and edge repair have moved
#     out of this reconciler. The all-null completion of a closed-unmerged
#     transition is a deliberate integrity-defect signal the census step can act
#     on, distinct from silent deletion.
#   - The serving strategy's round is still stamped here, at the done-transition,
#     when its last non-draft child reaches `done`.
# The whole plan (edits only) lands as ONE graph-commit.
#
# Manual completion backfill (office-hours workflow, no script): when a tactic's
# PR is closed-unmerged but its content genuinely landed on `main` out-of-band,
# this reconciler transitions the node to `phase: "done"` with
# execution.completion === null. A human/AI session that judges the work complete
# backfills evidence by hand: discover the sha of the out-of-band commit that
# landed the content (via `git log`/`gh`), set execution.completion.graphCommitSha
# to it, write the node back via packages/intentionsutil/scripts/write-node.ts,
# then `graph-commit`. graphCommitSha is recorded by the authoring session (which
# knows the sha firsthand) — it is never derived automatically, since graph-commit
# prints no sha to stdout on success.
#
# GRACE window: a just-merged PR is not reconciled until it has aged past the
# grace window, so the sweep never races a merge that is still settling.
#
# Doctrine: run from a main-based checkout (the sweep writes state-only commits
# on main). Sandbox: the CALLER wraps every invocation with
# dangerouslyDisableSandbox — gh needs network + TLS, and node --import tsx/esm
# needs the npm cache (see .claude/rules/sandbox.md).
#
# Stdout protocol: exactly `reconciled <id> -> <target>` per tactic acted on,
# and `deferred <id> (<reason>)` per deferred one; NOTHING for a skip.
#
# Exit codes: 0 (including a no-op sweep); 1 if any item hard-errored or the
# graph-commit failed.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
UTIL_SCRIPTS="$REPO_ROOT/packages/intentionsutil/scripts"
GRAPH_COMMIT="$UTIL_SCRIPTS/graph-commit"

GRACE=${GRAPH_RECONCILE_GRACE:-600}
NOW=${GRAPH_RECONCILE_NOW:-$(date -u +%s)}

# --- Enumerate open graph-native tactics carrying a PR -----------------------
# One node pass: print `<id>\t<pr>` for every open tactic (phase set, not
# draft/done) whose execution.pr is non-null.
OPEN_TACTICS="$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
  const { listNodes } = await import("./packages/intentionsutil/src/store.js");
  const open = new Set(["implement","fix","qa","review","main-qa"]);
  for (const n of listNodes("./intentions")) {
    if (n.kind !== "tactic") continue;
    if (n.phase === null || !open.has(n.phase)) continue;
    const pr = n.execution && n.execution.pr;
    if (pr === null || pr === undefined) continue;
    process.stdout.write(n.id + "\t" + pr + "\n");
  }
') )" || { echo "reconcile-graph-merged: node enumeration failed" >&2; exit 1; }

[[ -z "$OPEN_TACTICS" ]] && exit 0

# --- Resolve each PR's terminal state, honoring the grace window -------------
STATES="{}"
HARD_ERROR=0
while IFS=$'\t' read -r id pr; do
  [[ -n "$id" && -n "$pr" ]] || continue
  rc=0
  PR_JSON=$(gh_pr_view_rest "$pr" 2>/dev/null) || rc=$?
  if [[ "$rc" -ne 0 || -z "$PR_JSON" ]]; then
    echo "reconcile-graph-merged: gh_pr_view_rest #$pr for $id failed (rc=$rc)" >&2
    HARD_ERROR=1
    continue
  fi
  STATE=$(jq -r '.state' <<<"$PR_JSON")
  MERGED_AT=$(jq -r '.mergedAt // empty' <<<"$PR_JSON")
  MERGE_SHA=$(jq -r '.mergeCommitSha // empty' <<<"$PR_JSON")
  case "$STATE" in
    OPEN) : ;;  # nothing to reconcile
    *)          # terminal (REST reports merged PRs as CLOSED, never MERGED)
      if [[ -n "$MERGED_AT" ]]; then
        AGE=$(( NOW - $(date -u -d "$MERGED_AT" +%s) ))
        [[ "$AGE" -ge "$GRACE" ]] || continue   # still settling — next sweep
        STATES=$(jq -c --arg id "$id" --arg ma "$MERGED_AT" --arg sha "$MERGE_SHA" \
          '. + {($id): {state:"merged", mergedAt:$ma, mergeCommitSha:$sha}}' <<<"$STATES")
      else
        STATES=$(jq -c --arg id "$id" '. + {($id): {state:"closed"}}' <<<"$STATES")
      fi ;;
  esac
done <<<"$OPEN_TACTICS"

# Nothing terminal this sweep.
if [[ "$STATES" == "{}" ]]; then
  [[ "$HARD_ERROR" -ne 0 ]] && exit 1
  exit 0
fi

# --- Decide + apply the store mutations --------------------------------------
# Plan-then-apply for a rollback path: a --no-apply run yields the plan's exact
# edit∪prune id set WITHOUT touching disk; we snapshot each of those ids from
# origin/main, THEN run the real apply. Both runs read the same unmutated
# intentions/ dir (nothing else writes it between them), so the plan is
# deterministic — the snapshotted ids match the ids the apply run mutates. On
# any failure of the apply run or the graph-commit, RESTORE_ON_FAILURE dumps
# each snapshot blob back over its file (rewriting edits and recreating pruned
# deletions), leaving intentions/ clean rather than tripping graph-commit's
# assert_clean_outside_ids guard for every other node.
STATES_FILE="$(mktemp)" || { echo "reconcile-graph-merged: mktemp failed" >&2; exit 1; }
declare -A SNAPSHOT=()
RESTORE_ON_FAILURE=0
restore_snapshot() {
  local sid blob
  for sid in "${!SNAPSHOT[@]}"; do
    blob="${SNAPSHOT[$sid]}"
    git -C "$REPO_ROOT" show "$blob" > "$REPO_ROOT/intentions/$sid.md"
  done
}
# Single EXIT trap (bash traps REPLACE on a signal, not stack): always drop the
# temp file, and roll the write back when a post-snapshot step armed the flag.
trap 'rc=$?; rm -f "$STATES_FILE"; [[ "$RESTORE_ON_FAILURE" -ne 0 ]] && restore_snapshot; exit $rc' EXIT
printf '%s' "$STATES" > "$STATES_FILE"

# Step 1: plan-only run (no disk mutation) to learn the id set to snapshot.
PLAN_ONLY="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/reconcile-graph.ts" --pr-states "$STATES_FILE" --no-apply) )" || {
  echo "reconcile-graph-merged: reconcile-graph.ts --no-apply failed" >&2; exit 1; }

# Step 2: snapshot every planned id (edit ∪ prune) from origin/main. All planned
# ids are landed nodes present on origin/main; a rev-parse miss is a hard error —
# that id can't be safely mutated without a rollback path.
while IFS= read -r sid; do
  [[ -n "$sid" ]] || continue
  blob=$(git -C "$REPO_ROOT" rev-parse "origin/main:intentions/$sid.md" 2>/dev/null) || {
    echo "reconcile-graph-merged: cannot snapshot $sid from origin/main (no rollback path)" >&2; exit 1; }
  SNAPSHOT[$sid]="$blob"
done < <(jq -r '.edit[]?' <<<"$PLAN_ONLY")

# Step 3: real apply run — mutates disk; its stdout drives the rest of the
# script. Arm the rollback: any failure from here through graph-commit restores.
RESTORE_ON_FAILURE=1
PLAN="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/reconcile-graph.ts" --pr-states "$STATES_FILE") )" || {
  echo "reconcile-graph-merged: reconcile-graph.ts failed (write rolled back)" >&2; exit 1; }

# Report deferrals (residue→main-qa, inert until tactic-main-qa-phase).
while IFS= read -r d; do
  [[ -n "$d" ]] || continue
  did=$(jq -r '.id' <<<"$d"); dreason=$(jq -r '.reason' <<<"$d")
  echo "deferred $did ($dreason)"
done < <(jq -c '.deferred[]?' <<<"$PLAN")

# --- Land the plan as one graph-commit ---------------------------------------
mapfile -t EDIT < <(jq -r '.edit[]?' <<<"$PLAN")
if [[ "${#EDIT[@]}" -eq 0 ]]; then
  [[ "$HARD_ERROR" -ne 0 ]] && exit 1
  exit 0
fi

GC_ARGS=(-m "graph: reconcile terminal tactics (record completion)")
for id in "${EDIT[@]}"; do GC_ARGS+=("$id"); done

if ! "$GRAPH_COMMIT" "${GC_ARGS[@]}"; then
  echo "reconcile-graph-merged: graph-commit failed (write rolled back)" >&2
  exit 1
fi
# Landed — disarm the rollback so the clean exit keeps the committed state.
RESTORE_ON_FAILURE=0

# Report what was reconciled.
while IFS= read -r r; do
  [[ -n "$r" ]] || continue
  rid=$(jq -r '.id' <<<"$r"); rtarget=$(jq -r '.target' <<<"$r")
  echo "reconciled $rid -> $rtarget"
done < <(jq -c '.reconciled[]?' <<<"$PLAN")

[[ "$HARD_ERROR" -ne 0 ]] && exit 1
exit 0
