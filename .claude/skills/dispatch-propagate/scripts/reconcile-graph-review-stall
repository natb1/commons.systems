#!/usr/bin/env bash
# reconcile-graph-review-stall — the review-stall recovery sweep
# (tactic-graph-review-exclusion-stall-recovery Unit 2). Sibling of
# reconcile-graph-merged: it absorbs out-of-band PR events for open
# graph-native tactics that are STUCK in phase:review with the `reviewed`
# marker (armed auto-merge), rather than terminal ones.
#
# A phase:review + reviewed tactic is excluded from selector candidates
# entirely (router.ts's REVIEWED_MARKER exclusion), so the normal
# graph-select-target CI-red gate — which only runs on candidates the
# selector already emits — never gets a chance to run on it. If the armed
# merge cannot complete (CI turns red, or the PR goes CONFLICTING), the node
# would otherwise be stranded forever. This sweep independently polls each
# such node's PR and routes a detected regression to the lane that can
# actually clear it (transitions.ts's `reviewStallRoute`):
#
#   fix      — CI concluded red. Enter the CI-fix interrupt directly (the same
#              execution.fix write graph-select-target's _gate_maybe_interrupt
#              would have made), which the router.ts fix-aware carve-out
#              (tactic-graph-review-exclusion-stall-recovery) then re-surfaces
#              as a `fix` candidate on the next selection tick.
#
#   ci-stall — CI never CONCLUDED at all (tactic-autonomous-ci-pending-liveness-bound).
#              A `pending` verdict is not a regression, so `reviewStallRoute`
#              maps it to null and this sweep used to do nothing — forever, on a
#              node whose armed auto-merge can never fire and which no other
#              surface observes. It is now counted per node in a SHA-keyed
#              sidecar shared with graph-select-target, and on the
#              DISPATCH_CI_PENDING_STRIKE_CAP-th consecutive `pending`
#              observation of the SAME head SHA this sweep lands a `--kind
#              ci-pending-stalled` hold. The resulting `blocked_by` edge is what
#              makes it terminate: the enumeration below and the selector both
#              skip a node with an open blocker, so each stalled node is held
#              ONCE. Nothing is written to the graph below the cap.
#
# CONFLICTING detection is NO LONGER this sweep's job
# (tactic-graph-router-conflict-routing): the selector now surfaces every
# reviewed awaiting-merge node as a `pending-merge` candidate and enters the
# orthogonal `execution.conflict` interrupt from its own sensor gate, every tick,
# through the normal selection path. Acting on it here too would double-handle
# the same PR (a `hold-node` here racing an `execution.conflict` interrupt
# there). So a CONFLICTING candidate is now SKIPPED outright, before the CI
# fetch and before the route evaluation — it is not routed and then discarded.
# See the short-circuit in the per-candidate loop for why that is sound.
#
# A still-OPEN PR with no regression, or one whose mergeability is still
# UNKNOWN (GitHub computes it asynchronously and self-heals), is a no-op —
# not a signal this sweep should act on. A merged/closed PR is
# reconcile-graph-merged's job, not this sweep's. A node already carrying an
# open blocker (typically the conflict hold a previous sweep landed) is
# likewise skipped, so a persisting conflict is held ONCE, not once per tick.
#
# Doctrine: run from a main-based checkout (the sweep writes state-only
# commits on main). Sandbox: the CALLER wraps every invocation with
# dangerouslyDisableSandbox — graph-commit's `git reset --hard` is a
# tree-updating op that half-applies over the read-only `.claude/**` carve-outs
# (see .claude/rules/sandbox.md and graph-commit's own NOTE (deployment)).
#
# Usage: reconcile-graph-review-stall [--node <id>]
#
#   --node <id>  Consider ONLY the named node id. A SELECTION FILTER, never a
#                gate bypass — every route decision below still applies
#                verbatim, exactly as documented for `graph-select-target
#                --node`. Absent the flag, behavior is byte-identical to the
#                unflagged sweep. It exists so a single-node caller (the
#                /dispatch-ladder driver) can absorb its own review-stall
#                recovery without sweeping — and without racing the tick's
#                sweep across unrelated nodes.
#
# Stdout protocol, one line per tactic acted on; NOTHING for a skip:
#   recovered <id> -> fix (ci=<verdict> merge=<state>)
#   held <id> -> ci-stalled via <hold-id> (sha=<sha> strikes=<n>)
#
# Exit codes: 0 always (including a no-op sweep and any per-node error —
# best-effort, matching reconcile-graph-merged's doctrine); 1 only for a hard
# failure that prevents the sweep from running at all (e.g. the enumeration
# one-liner itself erroring).
#
# Rollback: every `--set-fix` write is staged on disk before it is landed, so
# HEAD is pinned first and any failure restores every staged write back to it
# (RESTORE_ON_FAILURE / restore_staged_writes, over the shared
# graph_rollback_node_writes reconcile-graph-merged uses). The sweep never exits
# leaving intentions/ dirty — a leaked write would trip graph-commit's
# assert_clean_outside_ids for EVERY graph writer in this checkout, not just
# this one.
#
# Lock budget: the caller (dispatch-select-tick) holds the dispatch lock across
# this sweep, and dispatch-acquire-lock reclaims a holder whose heartbeat is
# older than MAX_HOLD_SECONDS (default 300s). A graph-commit can block far
# longer than that (it waits on the global landing lock for up to
# LOCK_WAIT_SECONDS, default 1050s), so this sweep runs AT MOST ONE
# graph-commit PLUS AT MOST ONE `hold-node` per tick: every `fix`-routed node's
# `--set-fix` write is batched into ONE commit (exactly as
# reconcile-graph-merged batches its plan), and the ci-stall route lands the
# FIRST entry of CI_STALL_IDS and no more, leaving the rest for the next sweep
# (they still match the enumeration, and their strike counts are already at
# cap). The hold is a second landing, so the stated budget really did go from
# one to two — but it is bounded at two, and that bound is what the caller's
# 300s heartbeat reasoning rests on. The hold lands AFTER the batched commit,
# never inside the loop: hold-node runs its own graph-commit, whose
# assert_clean_outside_ids would trip on the loop's still-uncommitted
# `--set-fix` writes.
# Per-tick actions are
# additionally capped (GRAPH_REVIEW_STALL_CAP), and the lock heartbeat is
# refreshed between candidates so the per-PR polling loop cannot age the lock
# out on its own.
#
# Env:
#   GRAPH_REVIEW_STALL_CAP  Max nodes acted on per sweep.
#                           Positive integer. Default: 3. Excess candidates are
#                           left for the next tick (the sweep is idempotent —
#                           they still match).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
# graph_rollback_node_writes — the shared roll-a-failed-node-write-back-to-HEAD
# primitive this sweep shares with reconcile-graph-merged.
source "$SCRIPT_DIR/lib-graph-rollback.sh"
# The durable writer identity graph-commit stamps onto every commit it makes for
# this sweep, and the string graph_rollback_node_writes below compares each
# unpushed commit's `Graph-Writer:` trailer against — so a CONCURRENT writer's
# commit is recognised as not-ours and kept. It MUST stay identical to the
# <label> argument passed at the call site (see lib-graph-rollback.sh's header).
export GRAPH_WRITER=reconcile-graph-review-stall
# node_id_is_safe / require_safe_node_id / pin_base_blob — the shared
# diagnosis-time compare-and-swap pin this sweep shares with
# reconcile-graph-merged. Rollback-on-failure and compare-and-swap-on-land are
# separate remedies; this sweep needs both.
source "$SCRIPT_DIR/lib-graph-base-pin.sh"
# resolve_main_worktree — so this sweep and graph-select-target key the
# CI-pending strike sidecar on the SAME root, and therefore on the same file
# per node. Two surfaces observing one stalled node must share one counter.
source "$SCRIPT_DIR/lib-graph-worktree.sh"

# ---- Argument parsing -------------------------------------------------------
NODE_FILTER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --node)
      [[ $# -ge 2 && -n "${2:-}" ]] \
        || { echo "reconcile-graph-review-stall: --node requires a non-empty id" >&2; exit 2; }
      NODE_FILTER="$2"; shift 2 ;;
    *)
      echo "reconcile-graph-review-stall: unknown argument '$1'" >&2
      echo "usage: reconcile-graph-review-stall [--node <id>]" >&2
      exit 2 ;;
  esac
done
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
# Soft fallback (the shape graph-select-target's NATIVE_ROOT two-liner uses):
# only the strike sidecar's location depends on this, and a sweep run from a
# checkout with no `main` worktree still counts correctly against its own root.
MAIN_ROOT=$(resolve_main_worktree "$REPO_ROOT"); MAIN_ROOT="${MAIN_ROOT:-$REPO_ROOT}"
UTIL_SCRIPTS="$REPO_ROOT/packages/intentionsutil/scripts"
GRAPH_COMMIT="$UTIL_SCRIPTS/graph-commit"

# Positive-integer validation before the value reaches any `(( ))` context —
# bash arithmetic evaluates array-index command substitution, so a hostile env
# override must be rejected as a literal-integer check first (mirrors
# dispatch-tick-recover:~130-150). CAP=0 would make the sweep a permanent no-op.
CAP="${GRAPH_REVIEW_STALL_CAP:-3}"
if ! [[ "$CAP" =~ ^[0-9]+$ ]] || [[ "$CAP" -lt 1 ]]; then
  echo "reconcile-graph-review-stall: GRAPH_REVIEW_STALL_CAP must be a positive integer, got '$CAP'" >&2
  exit 1
fi

# refresh_lock — bump the dispatch lock's heartbeat (strict-owner; a noop when
# we do not hold it) so a multi-candidate polling loop cannot age the caller's
# lock past MAX_HOLD_SECONDS and get it reclaimed mid-sweep.
refresh_lock() {
  [[ -x "$SCRIPT_DIR/dispatch-acquire-lock" ]] || return 0
  "$SCRIPT_DIR/dispatch-acquire-lock" --heartbeat >/dev/null 2>&1 || true
}

# --- Rollback path for the staged --set-fix writes ---------------------------
# apply-fix-state mutates intentions/<id>.md on disk BEFORE anything is landed.
# A write left behind by a failed land is not just this sweep's problem:
# graph-commit's assert_clean_outside_ids refuses to start whenever a tracked
# file outside the call's own node set is dirty, so one leaked write blocks
# every other graph writer in this checkout until a human runs `git checkout
# --`. So the rollback restores every staged write on every failure path.
#
# It restores to HEAD, via the shared graph_rollback_node_writes — NOT to a blob
# captured from origin/main before the write. This sweep used to do the latter,
# and it is wrong in two ways that both leave the tree dirty rather than clean:
# origin/main is a LOCAL tracking ref that can lag HEAD (the restore then writes
# stale bytes over a newer HEAD version), and graph-commit's park path moves HEAD
# under the writer (the restore then re-erases the park it just landed). See
# lib-graph-rollback.sh's header for the full classification.
WRITTEN_IDS=()
RESTORE_ON_FAILURE=0
# HEAD as of the moment the rollback is armed — the commit the staged writes sit
# on top of, and the only commit `git checkout --` can be trusted to restore to.
HEAD_AT_ARM=""
# id -> the diagnosis-time base blob pinned for that id, threaded onto the
# landing graph-commit as `--base <id>=<blob>`. Populated per candidate in the
# `fix` arm below, BEFORE apply-fix-state mutates the file.
declare -A BASE_BLOB=()
restore_staged_writes() {
  [[ "${#WRITTEN_IDS[@]}" -gt 0 ]] || return 0
  graph_rollback_node_writes "$REPO_ROOT" "$HEAD_AT_ARM" reconcile-graph-review-stall \
    "${WRITTEN_IDS[@]}"
}
# EXIT trap: roll the staged writes back when a failure armed the flag, so this
# sweep never exits leaving intentions/ dirty.
trap 'rc=$?; [[ "$RESTORE_ON_FAILURE" -ne 0 ]] && restore_staged_writes; exit $rc' EXIT

# --- Enumerate stranded review+reviewed tactics ------------------------------
# One node pass: print `<id>\t<pr>` for every tactic at phase:review carrying
# the `reviewed` marker, with no interrupt already active (defensive — should
# always hold given the selector exclusion, but skip rather than double-enter
# if it doesn't) and a non-null execution.pr.
#
# A parked node (office_hours set) is NEVER swept: a human owns its state while
# it is parked, and the fix interrupt this sweep writes could not be undone
# autonomously — selectGraphTargets skips every tactic with `office_hours !==
# null` (router.ts:294), so the node would never surface as a `fix` candidate
# and `--clear-fix` would never run. The exclusion mirrors that selector gate.
#
# A node with an OPEN blocker is likewise skipped (`blockersComplete`, the same
# rule the selector applies): that is how a conflict hold this sweep already
# landed stops it from re-holding the same conflict on every subsequent tick —
# the hold stays open until /dispatch-conflict resolves it.
#
# Enumeration is STRICT (`listNodesStrict`): `blockersComplete` reads a
# `blocked_by` id ABSENT from `byId` as COMPLETE, so under the tolerant reader a
# corrupt blocker file would silently satisfy the open-blocker gate above and
# let this sweep re-hold a node whose conflict hold is still open.
#
# `--node <id>` is applied HERE, as the first thing the loop tests: a selection
# filter layered on top of the enumeration, ahead of every gate, so the gates
# below apply unchanged to whatever survives it. The id arrives via process.argv
# (an empty string means "no filter"), not via the environment, so an ambient
# variable can never silently narrow an unflagged sweep.
#
# `DISPATCH_GRAPH_NODE_CACHE` (packages/intentionsutil/src/store-cache.ts) names
# a storage LOCATION for a read-only, content-addressed memo of this same strict
# enumeration — never a node subset, so it cannot change the candidate set — and
# `--node` still arrives via process.argv, so unset or empty simply
# self-enumerates, which is the `/dispatch-ladder` single-node path.
CANDIDATES="$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
  const { listNodesStrictCached } = await import("./packages/intentionsutil/src/store-cache.js");
  const { REVIEWED_MARKER } = await import("./packages/intentionsutil/src/transitions.js");
  const { blockersComplete } = await import("./packages/intentionsutil/src/router.js");
  const nodes = listNodesStrictCached("./intentions", process.env.DISPATCH_GRAPH_NODE_CACHE || "");
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const only = process.argv[1] || "";
  for (const n of nodes) {
    if (only && n.id !== only) continue;
    if (n.kind !== "tactic") continue;
    if (n.phase !== "review") continue;
    if (n.office_hours != null) continue;
    if (!n.execution || !n.execution.markers.includes(REVIEWED_MARKER)) continue;
    if (n.execution.fix != null) continue;
    if (!blockersComplete(n, byId)) continue;
    const pr = n.execution.pr;
    if (pr === null || pr === undefined) continue;
    process.stdout.write(n.id + "\t" + pr + "\n");
  }
' "$NODE_FILTER") )" || { echo "reconcile-graph-review-stall: node enumeration failed" >&2; exit 1; }

[[ -z "$CANDIDATES" ]] && exit 0

# --- Per candidate: poll the PR, decide, and stage its fix-state write -------
# Writes only; nothing is landed inside the loop (see the lock budget above).
RECOVERED_IDS=()
RECOVERED_MSGS=()
# Nodes whose CI-pending strike ladder hit the cap this sweep, recorded in the
# loop and landed after the batched graph-commit. Declared here, above the loop,
# because the script runs `set -uo pipefail` and an unset array expansion aborts.
CI_STALL_IDS=()
declare -A CI_STALL_SHA=()
declare -A CI_STALL_COUNT=()
ACTED=0
while IFS=$'\t' read -r id pr; do
  [[ -n "$id" && -n "$pr" ]] || continue
  # At cap — leave the rest for the next tick rather than stretching this
  # tick's lock hold (they still match the enumeration next sweep).
  [[ "$ACTED" -ge "$CAP" ]] && break
  # Each iteration issues network polls; keep the caller's lock heartbeat fresh.
  refresh_lock

  PR_JSON=$(gh_pr_view_rest "$pr" 2>/dev/null) || {
    echo "reconcile-graph-review-stall: gh_pr_view_rest #$pr for $id failed" >&2
    continue
  }
  [[ -n "$PR_JSON" ]] || {
    echo "reconcile-graph-review-stall: gh_pr_view_rest #$pr for $id returned empty" >&2
    continue
  }

  STATE=$(jq -r '.state' <<<"$PR_JSON")
  if [[ "$STATE" != "OPEN" ]]; then
    continue   # merged/closed — reconcile-graph-merged's job
  fi

  MERGEABLE=$(jq -r '.mergeable' <<<"$PR_JSON")
  # Validate at the shell/TypeScript edge rather than letting an unexpected
  # value fall through: reviewStallRoute takes a closed union, so anything
  # outside it (a changed gh_pr_view_rest projection, a jq-stringified null)
  # would silently route to `null` and the sweep would stop recovering with no
  # signal at all. Report it loudly and skip this node instead.
  case "$MERGEABLE" in
    MERGEABLE|CONFLICTING|UNKNOWN) ;;
    *)
      echo "reconcile-graph-review-stall: unexpected .mergeable '$MERGEABLE' from gh_pr_view_rest #$pr for $id (projection changed?)" >&2
      continue ;;
  esac

  # Cost short-circuit for a CONFLICTING candidate. `interruptRoute`
  # (packages/intentionsutil/src/transitions.ts — the delegate behind
  # `reviewStallRoute`) opens with `if (mergeable === "CONFLICTING") return
  # "conflict";`, BEFORE it consults CI at all, so no CI verdict can change the
  # outcome for this candidate and fetching one cannot inform anything. That
  # superset property is documented in `interruptRoute`'s own doc comment and
  # pinned by the transitions.test.ts case named for "the shell pre-filter's
  # superset invariant" (packages/intentionsutil/test/transitions.test.ts:295),
  # so this pre-filter is sanctioned rather than a re-derivation of the routing
  # rule in bash.
  #
  # And the `conflict` route it would have produced is a retired no-op
  # (tactic-graph-router-conflict-routing): the selector's
  # `pending-merge`/`conflict` candidate path handles CONFLICTING on every tick
  # through `execution.conflict`, so this sweep must NOT also land a competing
  # `provision-conflict` hold on the same PR. Nothing is lost by never computing
  # the route.
  #
  # What the skip saves is real, not marginal: `dispatch_ci_verdict_rest`'s memo
  # is per-tick — created and exported by dispatch-select-tick's tick-scoped
  # CI-verdict memoisation block (#1601) and removed by its combined EXIT trap,
  # while dispatch-ladder-run unsets the variable outright before every
  # reconciler call — so the `check-runs` fetch below is a STRUCTURAL cache miss
  # on the paths that matter, paid in full for every CONFLICTING candidate on
  # every sweep, unbounded by CAP (which counts only candidates ACTED on).
  #
  # Silent by contract: no stdout (the header's "NOTHING for a skip" protocol),
  # no stderr (the retired arm was silent too), ACTED not incremented, and
  # `continue` rather than `break` so a genuinely red candidate later in the
  # enumeration is still recovered.
  if [[ "$MERGEABLE" == "CONFLICTING" ]]; then
    continue
  fi

  HEAD_SHA=$(jq -r '.headRefOid' <<<"$PR_JSON")

  RAW_VERDICT=$(dispatch_ci_verdict_rest "$HEAD_SHA" 2>/dev/null) || RAW_VERDICT=""
  case "$RAW_VERDICT" in
    passing|failing) VERDICT="$RAW_VERDICT" ;;
    *) VERDICT="unknown" ;;   # pending or a call failure — not a regression
  esac

  # --- CI-pending liveness bound (tactic-autonomous-ci-pending-liveness-bound)
  #
  # PLACEMENT IS LOAD-BEARING: this sits ABOVE the cost guard below, and must.
  # A pending candidate folds to VERDICT="unknown" on a MERGEABLE PR, so the
  # guard `continue`s first and anything placed below it would be dead code for
  # this block's ENTIRE target population. Widening the guard is not the
  # alternative — it is a binding superset of reviewStallRoute's non-null
  # conditions, pinned by transitions.test.ts. Sit upstream of it instead.
  #
  # This is why the block reads RAW_VERDICT rather than VERDICT: `pending` is
  # not a ROUTE, it is a liveness observation, and reviewStallRoute stays a pure
  # closed-union function over passing|failing|unknown. Widening its signature
  # would force every caller to handle a state that has no lane.
  #
  # Why this surface needs the bound at all, over and above the selector's:
  # a tactic at phase `review` carrying the `reviewed` marker is excluded from
  # selection entirely, so graph-select-target's own ci-pending ladder never
  # sees it. THIS SWEEP IS ITS ONLY OBSERVER, and a `pending` verdict folds to
  # `unknown`, which reviewStallRoute maps to null — a silent no-op. Such a node
  # has an armed auto-merge that can never fire, forever.
  #
  # A non-pending candidate must FALL THROUGH, never `continue`: the guard and
  # the routing below still have to run for it.
  #
  # Note one accepted gap: a candidate that goes CONFLICTING never reaches this
  # point at all (the short-circuit above skips it before the CI fetch), so it
  # keeps any strike file it was carrying. That is harmless — the counter is
  # SHA-keyed and only ever bumps on `pending`, so a stale count cannot escalate
  # on its own — and it is recorded here rather than fixed with a second clear.
  if [[ -n "$RAW_VERDICT" ]]; then
    if [[ "$RAW_VERDICT" == "pending" ]]; then
      # HEAD_SHA is a bare `jq -r '.headRefOid'`, so it is the four-character
      # string `null` when the field is missing. ci_pending_strike_bump refuses
      # both empty and `null`; a non-zero return means "do not count", and the
      # candidate falls through to the guard untouched.
      # AN EXPLICIT --node RUN NEVER COUNTS, exactly as graph-select-target's
      # NODE_TARGET guard does — and the two surfaces share ONE sidecar, so an
      # exemption on only one of them is no exemption at all. dispatch-ladder-run
      # calls this script with --node from inside its ci-wait poll (once per
      # `sleep $POLL_S`, 60s by default), which would walk a healthy node to the
      # cap in ~8 minutes of ordinary CI runtime.
      if [[ -z "$NODE_FILTER" ]] &&
         CI_STALL_STRIKES=$(ci_pending_strike_bump "$MAIN_ROOT" "$id" "$HEAD_SHA"); then
        if (( CI_STALL_STRIKES < DISPATCH_CI_PENDING_STRIKE_CAP )); then
          # A sidecar write is free, so it must NOT consume the ACTED budget —
          # ACTED/CAP exist to bound LOCK-HOLDING work, and nothing here holds a
          # lock. The next sweep re-enumerates this node unchanged.
          continue
        fi
        # At or above the cap: RECORDED, not landed. hold-node refreshes from
        # origin/main and lands its own graph-commit, whose
        # assert_clean_outside_ids would trip on the --set-fix writes this loop
        # may still have staged uncommitted. The landing happens after the
        # batched commit has cleaned the tree; see the block near the tail.
        # A hold IS lock-holding work, so the one that will actually be landed
        # does spend ACTED — but ONLY that one. The tail block lands
        # CI_STALL_IDS[0] and no more, so charging every at-cap candidate would
        # spend the whole budget on recordings that this sweep never acts on:
        # with the default CAP of 3, three at-cap pending nodes would `break`
        # the loop after landing a single hold, starving the `fix` route for a
        # genuinely red-CI node later in the enumeration.
        if [[ "${#CI_STALL_IDS[@]}" -eq 0 ]]; then
          CI_STALL_IDS+=("$id")
          CI_STALL_SHA["$id"]="$HEAD_SHA"
          CI_STALL_COUNT["$id"]="$CI_STALL_STRIKES"
          ACTED=$(( ACTED + 1 ))
        fi
        continue
      fi
    else
      # A CONCLUDED verdict. Clear the ladder so the count always means
      # CONSECUTIVE pending observations, then fall through — this candidate
      # still has to be guarded and routed exactly as before.
      ci_pending_strike_clear "$MAIN_ROOT" "$id"
    fi
  fi
  # RAW_VERDICT empty (the dispatch_ci_verdict_rest call itself failed) reaches
  # here having neither counted nor cleared. A failed fetch is not evidence
  # either way, and treating it as a pending observation would let a gh outage
  # walk every reviewed node to its cap.

  # Cost guard, NOT the routing rule: reviewStallRoute (interruptRoute at the
  # fixed phase "review") returns null unless CI is failing or the PR is
  # CONFLICTING, so skip the node subprocess when neither holds — the
  # overwhelmingly common case, since a reviewed node waiting on auto-merge
  # reads green and MERGEABLE on every tick until something regresses. This
  # condition MUST stay a superset of reviewStallRoute's non-null conditions;
  # the transitions.test.ts case named for "the shell pre-filter's superset
  # invariant" pins that. Deliberately NOT narrowed to `ci == failing` even
  # though the CONFLICTING clause is unreachable on this path today (the
  # short-circuit above skips CONFLICTING before the CI fetch): that
  # short-circuit is local and reversible (tactic-review-stall-conflict-lane
  # proposes un-retiring the conflict arm), while the superset is the
  # documented, test-pinned property. Verbatim sibling of
  # graph-select-target's _gate_maybe_interrupt guard — keep the two in step.
  if [[ "$VERDICT" != "failing" && "$MERGEABLE" != "CONFLICTING" ]]; then
    continue
  fi

  ROUTE=$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { reviewStallRoute } = await import("./packages/intentionsutil/src/transitions.js");
    const ci = process.argv[1];
    const mergeable = process.argv[2];
    process.stdout.write(String(reviewStallRoute(ci, mergeable)));
  ' "$VERDICT" "$MERGEABLE") ) || {
    echo "reconcile-graph-review-stall: reviewStallRoute eval failed for $id" >&2
    continue
  }

  case "$ROUTE" in
    fix)
      # Arm the rollback BEFORE staging the write, so any later failure (this
      # write, or the batched land below) restores a clean tree. HEAD is pinned
      # once, at the first write: every staged write in this sweep sits on that
      # same commit, and nothing between here and the land moves it. A candidate
      # whose file is not tracked at HEAD has nothing to `checkout --` back to —
      # skip it rather than stage a write nothing can revert.
      if [[ -z "$HEAD_AT_ARM" ]]; then
        HEAD_AT_ARM=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null) || {
          echo "reconcile-graph-review-stall: cannot read HEAD (no rollback reference point) — aborting the sweep" >&2
          exit 1
        }
      fi
      git -C "$REPO_ROOT" cat-file -e "HEAD:intentions/$id.md" 2>/dev/null || {
        echo "reconcile-graph-review-stall: intentions/$id.md is not tracked at HEAD (no rollback path) — skipping $id" >&2
        continue
      }
      # Pin the diagnosis-time base blob HERE — after the tracked-at-HEAD guard,
      # and BEFORE apply-fix-state runs below. The ordering is the whole point:
      # apply-fix-state reads the node and rewrites the WHOLE file from that
      # in-memory read, so the compare-and-swap base must be the PRE-mutation
      # blob. Pinning after the write would pin the sweep's own output, and
      # check_base_freshness would compare the sweep's edit against itself — the
      # change would look correct and protect nothing.
      #
      # Failure posture here is a per-candidate SKIP, not an abort — deliberately
      # the opposite of reconcile-graph-merged, whose ids come from a
      # deterministic plan it must honour whole. Reasons, in order:
      #   - a per-candidate skip is this loop's established contract (the
      #     tracked-at-HEAD guard immediately above does exactly this);
      #   - nothing is staged for this id yet, so there is nothing to roll back;
      #   - the sweep is idempotent — the next tick re-enumerates this node and
      #     tries again;
      #   - aborting would trip the EXIT trap and roll back EARLIER candidates'
      #     legitimate staged writes, turning one bad id into a lost sweep;
      #   - the skip is LOUD (stderr), not silent, and it never lands an
      #     unprotected write — which is the invariant that actually matters.
      node_id_is_safe "$id" || {
        echo "reconcile-graph-review-stall: unsafe node id $(printf '%q' "$id") — ids must match ^[A-Za-z0-9][A-Za-z0-9._-]*\$ (no '=', whitespace, or control characters) to be a valid --base pair key — skipping $id" >&2
        continue
      }
      BASE_BLOB[$id]=$(pin_base_blob "$REPO_ROOT" reconcile-graph-review-stall "$id") || continue
      WRITTEN_IDS+=("$id")
      RESTORE_ON_FAILURE=1
      if ! node --import tsx/esm "$UTIL_SCRIPTS/apply-fix-state.ts" "$id" --set-fix --dir "$REPO_ROOT/intentions" >/dev/null; then
        echo "reconcile-graph-review-stall: apply-fix-state --set-fix failed for $id (write rolled back)" >&2
        git -C "$REPO_ROOT" checkout -- "intentions/$id.md" || true
        continue
      fi
      RECOVERED_IDS+=("$id")
      RECOVERED_MSGS+=("recovered $id -> fix (ci=$VERDICT merge=$MERGEABLE)")
      ACTED=$(( ACTED + 1 ))
      ;;
    *)
      continue   # null — no regression; nothing to route
      ;;
  esac
done <<<"$CANDIDATES"

# BOTH arrays, not just RECOVERED_IDS. RECOVERED_IDS collects only `fix`-routed
# nodes, so a tick whose sole finding is a ci-pending-stalled node leaves this
# loop with CI_STALL_IDS non-empty and RECOVERED_IDS empty — and a
# RECOVERED_IDS-only guard would exit here, building the array and then throwing
# it away. That is not an edge case: the ci-stall route is the only route that
# populates CI_STALL_IDS without also populating RECOVERED_IDS, so it is this
# route's MAIN path, and the hold block below would be dead code on exactly the
# sweeps it exists to serve.
#
# Widening here needs no other change: the batched `--set-fix` land below is
# already guarded independently by `if [[ "${#RECOVERED_IDS[@]}" -gt 0 ]]`, so a
# ci-stall-only tick falls straight through it and cannot produce an empty
# graph-commit.
[[ "${#RECOVERED_IDS[@]}" -eq 0 && "${#CI_STALL_IDS[@]}" -eq 0 ]] && exit 0

# --- Land every staged fix-state write as ONE graph-commit -------------------
# The land carries a diagnosis-time compare-and-swap: each recovered id's
# PRE-mutation on-disk blob, pinned in the `fix` arm above, is passed as
# `graph-commit --base <id>=<blob>`. Without it check_base_freshness
# short-circuits on its first line and this sweep lands whatever is on disk —
# and that disk content is a whole-node rewrite from apply-fix-state's in-memory
# read, so any field another writer landed on origin/main between this sweep's
# enumeration and this commit is silently overwritten. That lost update is bug X,
# measured at 8 office_hours park erasures across 5 nodes in one 24h window on
# the sibling call site (reconcile-graph-merged) before it was pinned.
#
# Ruling 31, read side vs write side — do NOT "simplify" this pin away as
# redundant with the enumeration's `office_hours != null` exclusion. Those are
# different mechanisms answering different questions, and both hold at once:
#   - the READ-side exclusion says a node ALREADY parked when this sweep
#     enumerated is a human's to move, so the sweep never picks it up;
#   - the WRITE-side pin says a park that lands AFTER enumeration — inside the
#     window the read-side gate cannot see — must be MERGED IN rather than
#     erased.
# The pin makes the sweep skip nothing; it makes graph-commit merge a
# concurrently landed field instead of clobbering it.
#
# graph-commit MERGES rather than refuses on drift: on a stale base it runs the
# structural three-way merge (base = the pinned blob, ours = our on-disk edit,
# theirs = origin/main's landed content) and parks only when a divergence is
# genuinely unresolvable. office_hours is a SCALAR_FIELD this sweep never
# touches, so ours == base and scalarMerge takes THEIRS — the concurrent park
# survives — while execution.fix is unchanged on origin (theirs == base) so it
# takes OURS. Absorbing the park beats refusing the whole sweep.
#
# `-C "$REPO_ROOT"` is mandatory: graph-commit resolves the repo to commit from
# its caller's cwd, never from its own on-disk location, while the --set-fix
# writes above targeted "$REPO_ROOT/intentions". Without -C, a caller invoked
# from a different main-branch checkout would have graph-commit inspect that
# other tree, find nothing dirty, commit nothing, exit 0 — and this sweep would
# print `recovered` for state left stranded uncommitted. (Same reason
# reconcile-graph-merged passes -C.)
#
# WHAT A REFUSED --base COSTS THE REST OF THE BATCH. Threading --base here makes
# check_base_freshness()'s fail-closed park reachable for this sweep for the
# first time: before this change the sweep passed no pins, so the guard
# short-circuited on an empty manifest and could never park.
#
# The cost is now confined to the node that actually diverged. park_and_exit()
# partitions ALL_IDS per id (graph-commit:3499-3537): an id in the conflicted
# set parks, and every other id takes the BYSTANDER path -- re-applied after the
# park's reset and landed with the park commit -- when it is either a --prune id
# or an ordinary edit id whose --base pin still matches the tip the park
# re-fetched (base_pin_still_fresh(), graph-commit:2975). This sweep pins EVERY
# id it commits, so one node's unresolvable execution.fix divergence parks that
# node and lands the rest. graph-commit signals that outcome with rc 1, so the
# failure branch below reports it WITHOUT claiming "nothing landed" — on this
# path something did. Keep the two in step: a claim made here that the branch
# below contradicts is worse than either alone, because the log line is the one
# a reader actually sees.
#
# THAT DEPENDS ON THE PIN, so do not drop it. An id committed with no --base
# entry has no evidence behind it -- "unchanged since this writer read it" is
# unanswerable -- and park_and_exit() fails closed on it, which is the old
# whole-batch park all over again. The `continue` above that SKIPS a candidate
# which cannot be pinned is what keeps that from happening here: an unpinnable
# id never reaches the invocation at all.
#
# Why it mattered: the collateral never self-healed. The enumeration above skips
# any node with `office_hours != null`, and the selector excludes on
# REVIEWED_MARKER, so a wrongly-parked node left this sweep's candidate set
# entirely. A later tick did NOT pick it back up; it needed an office-hours park
# clear by hand.
#
# The diverged node itself is still fail-closed, deliberately -- refusing beats
# landing over a stale base. The other way out, pinning and landing per node,
# would still break the "AT MOST ONE graph-commit per tick" lock budget stated
# in the header above, so it stays rejected.
#
# The idempotency note further up is a DIFFERENT path and remains true: it
# justifies the per-candidate SKIP taken when an id fails node_id_is_safe or
# fails to pin. Nothing is staged for a skipped id, so the next tick really does
# re-enumerate it. Do not read that sentence as covering the park above.
if [[ "${#RECOVERED_IDS[@]}" -gt 0 ]]; then
  refresh_lock
  GC_ARGS=(-C "$REPO_ROOT" -m "graph: enter fix-interrupt on stalled reviews (${#RECOVERED_IDS[@]} node(s))")
  # graph-commit accepts both a manifest file and repeated `--base <id>=<sha>`
  # flags; the repeated form drops straight into this id loop. The <id>=<sha>
  # PAIR form (never a bare sha) is required for a multi-id call and is a free
  # correctness guard — graph-commit die()s on a malformed pair.
  #
  # Re-gate the id shape HERE too, at the exact point the pair is built, even
  # though the same id passed node_id_is_safe before it was pinned: this is the
  # line whose output graph-commit splits at the FIRST `=`, so an id carrying one
  # would be silently re-keyed onto a different node. Defense in depth costs one
  # regex.
  #
  # A missing pin is an INVARIANT BREAK, not a transient, so it hard-errors
  # rather than skipping: every id in RECOVERED_IDS was pinned two statements
  # before it was appended, so an absent entry means the two lists have drifted
  # and nothing here can say what base is correct. RESTORE_ON_FAILURE is 1 at
  # this point, so the EXIT trap rolls every staged write back and the tree is
  # left clean for the next graph writer.
  for id in "${RECOVERED_IDS[@]}"; do
    require_safe_node_id reconcile-graph-review-stall "$id"
    [[ -n "${BASE_BLOB[$id]:-}" ]] || {
      echo "reconcile-graph-review-stall: no pinned base blob for recovered id $id (pin and recovery lists drifted)" >&2
      exit 1; }
    GC_ARGS+=(--base "$id=${BASE_BLOB[$id]}")
  done
  for id in "${RECOVERED_IDS[@]}"; do GC_ARGS+=("$id"); done

  if ! "$GRAPH_COMMIT" "${GC_ARGS[@]}"; then
    # NOT "nothing landed". graph-commit's own caller contract says in so many
    # words that rc 1 does not mean that (graph-commit:269), and the --base note
    # above describes exactly the path where it does not: park_and_exit() lands
    # an office_hours park for the diverged node AND re-applies every bystander
    # id's fix-interrupt edit onto the park commit, pushes, and exits non-zero.
    # On that path a park landed and other ids' edits landed with it, so the old
    # wording was false on the one path this sweep newly reaches.
    #
    # It cannot be replaced by the opposite assertion either: the other rc-1
    # shapes (rc 11's committed-but-unpushed write, an argument-validation
    # refusal raised before any git write, and a park whose OWN push failed —
    # `could not land the parking write ... office_hours set locally but not
    # pushed to main`, graph-commit:3734, still rc 1, park commit left an
    # unpushed local orphan) really did land nothing. This line
    # has no way to tell them apart, so it asserts NEITHER outcome and names
    # the two places that do know — graph-commit's own stderr just above, and
    # the graph_rollback_node_writes classification line the EXIT trap prints
    # just below.
    echo "reconcile-graph-review-stall: graph-commit did not report success for ${RECOVERED_IDS[*]} — what landed is NOT uniformly 'nothing': if it printed a 'verdict: parked' line an office_hours park DID land for the diverged node, with the other ids' fix-interrupt edits riding along as bystanders; if it instead reported 'could not land the parking write', the park path was taken but its push failed, leaving the park commit an unpushed local orphan and no change at all on main; read graph-commit's stderr above and the rollback line below for which happened" >&2
    # The EXIT trap restores every staged write that did NOT land, leaving
    # intentions/ clean for the next graph writer. A landed park MOVED HEAD, and
    # graph_rollback_node_writes classifies that case and deliberately KEEPS it
    # rather than re-erasing the park (lib-graph-rollback.sh's header).
    #
    # Re-detection is therefore NOT uniform either. An id whose edit was rolled
    # back is re-enumerated next tick — it still matches. An id that PARKED is
    # not: the enumeration above skips any node with `office_hours != null`, so
    # for that node the park is terminal for this sweep and waits on an
    # office-hours clear, exactly as the --base note above says.
    #
    # RECOVERED_MSGS stays suppressed here, deliberately. The stdout protocol is
    # one `recovered <id> -> fix` line per node actually acted on, consumed
    # verbatim by dispatch-select-tick behind a `review-stall: ` prefix. On the
    # park path the set is SPLIT — the bystanders got their fix interrupt, the
    # diverged one got a park instead — and nothing here can partition it
    # without parsing graph-commit's prose park clause. Emitting the whole set
    # would tell the tick a fix interrupt is active on a node now sitting in
    # office_hours, which is a worse lie than silence; emitting none loses only
    # a record that graph-commit's own stderr already carries. So silence stays,
    # and the line above is what points a reader at the truth.
    exit 0
  fi
  # Landed — disarm the rollback so the clean exit keeps the committed state.
  RESTORE_ON_FAILURE=0
  refresh_lock

  for msg in "${RECOVERED_MSGS[@]}"; do echo "$msg"; done
fi

# --- Land ONE recorded ci-stall hold -----------------------------------------
# AFTER the batched graph-commit above, not before, and that ordering is the
# whole reason this block is down here rather than inline in the loop. The
# batched commit is what clears the staged `--set-fix` writes from the tree, and
# hold-node runs its own graph-commit, which refuses to start while a tracked
# file outside its own node set is dirty (assert_clean_outside_ids). When
# RECOVERED_IDS is empty nothing was staged and the hold can land immediately;
# when it is non-empty the commit had to land first. Sitting after the `fi`
# satisfies both without a branch.
#
# ONE hold per run. The ci-stall route is this sweep's ONLY hold producer, so
# there is no shared slot to negotiate — landing the first entry and leaving the
# rest for the next sweep is enough. A skipped node still matches the
# enumeration next tick and its strike count is already at cap.
#
# NATURAL TERMINATION: once the hold lands, the source gains a `blocked_by`
# edge, and this sweep's own enumeration already skips any node with an open
# blocker (blockersComplete) — exactly as it does for a conflict hold's
# successor. The same edge removes the node from graph-select-target's candidate
# set. So each stalled node is held ONCE, not once per tick.
if [[ "${#CI_STALL_IDS[@]}" -gt 0 ]]; then
  refresh_lock
  ci_stall_id="${CI_STALL_IDS[0]}"
  ci_stall_sha="${CI_STALL_SHA[$ci_stall_id]}"
  ci_stall_n="${CI_STALL_COUNT[$ci_stall_id]}"
  if ci_stall_tmp=$(mktemp -d); then
    ci_stall_reason="$ci_stall_tmp/reason.txt"
    ci_stall_rec="$ci_stall_tmp/recommendation.txt"
    {
      printf 'This tactic completed review and its auto-merge is armed, so the '
      printf "selector's reviewed-marker exclusion means NO worker lane observes it — "
      printf 'this sweep is its only observer. Its PR has reported a `pending` CI '
      printf 'verdict on head SHA %s for %s consecutive sweeps: the checks either ' \
        "$ci_stall_sha" "$ci_stall_n"
      printf 'never started (an empty status-check rollup) or started and never '
      printf 'concluded. The armed merge can therefore never fire, and no verdict can '
      printf 'arrive on its own.\n'
    } > "$ci_stall_reason"
    {
      printf "Inspect the PR's Checks tab. If no workflow run exists at all, re-trigger "
      printf 'one — close and reopen the PR, or push an empty commit to the branch; a '
      printf 'new head SHA also resets this strike counter. If a run is stuck or was '
      printf 'cancelled by a queue or runner problem, re-run it.\n\n'
      printf 'Do NOT route this through the CI-fix interrupt. That path strips the '
      printf '`reviewed` marker and re-drafts the PR, discarding a completed review '
      printf 'verdict — see the rationale in transitions.ts and above this script'"'"'s '
      printf '`fix` arm. The problem here is a missing verdict, not a red one.\n\n'
      printf 'Then resolve THIS HOLD TACTIC to `phase: done` and prune it — clearing '
      printf '`office_hours` alone does not unblock %s.\n' "$ci_stall_id"
    } > "$ci_stall_rec"
    # CAPTURE stdout, redirect only stderr: the hold id is parsed off hold-node's
    # own output line for the `held ... via <hold-id>` protocol line below.
    # (graph-select-target's _hold_node_fix_cap discards stdout instead — it runs
    # inside a command substitution whose value is contractual. This does not.)
    if ci_stall_out=$( (cd "$REPO_ROOT" && "$UTIL_SCRIPTS/hold-node" "$ci_stall_id" \
        --kind ci-pending-stalled \
        --reason-file "$ci_stall_reason" \
        --recommendation-file "$ci_stall_rec") 2>/dev/null ); then
      ci_pending_strike_clear "$MAIN_ROOT" "$ci_stall_id"
      echo "held $ci_stall_id -> ci-stalled via $(awk '{print $2}' <<<"$ci_stall_out") (sha=$ci_stall_sha strikes=$ci_stall_n)"
    else
      # The sidecar is deliberately NOT cleared: the next sweep re-observes the
      # node at cap and retries the landing, the same posture the selector's
      # producer and dispatch-graph-execute's ladder take.
      echo "reconcile-graph-review-stall: hold-node --kind ci-pending-stalled failed for $ci_stall_id" >&2
    fi
    # AFTER the hold, on BOTH arms — the refresh above this block only covers
    # the walk INTO it. hold-node lands its own graph-commit, which waits up to
    # LOCK_WAIT_SECONDS (1050s) for the GLOBAL landing lock, far past the
    # MAX_HOLD_SECONDS (300s) after which dispatch-acquire-lock reclaims a
    # holder. dispatch-select-tick invokes this sweep while holding its dispatch
    # lock and then runs hundreds more lines, so without this a contended
    # landing leaves the tick's lock reclaimable and a second tick double-books
    # the same candidate set. Every sibling landing brackets the same way —
    # graph-select-target's _graph_commit_conflict, _hold_node_fix_cap and
    # _hold_node_ci_pending, and this script's own batched graph-commit above.
    # The FAILURE arm needs it too: a hold-node that blocked on the landing lock
    # and then failed has aged the caller's heartbeat exactly as much as one
    # that succeeded.
    refresh_lock
    rm -rf "$ci_stall_tmp"
  else
    echo "reconcile-graph-review-stall: mktemp failed for the $ci_stall_id ci-stall hold" >&2
  fi
fi

exit 0
