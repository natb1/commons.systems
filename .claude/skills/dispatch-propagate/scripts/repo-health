#!/usr/bin/env bash
# repo-health — the standalone graph-native repo-health sensor for the dispatch
# harness. It owns the two "the repo itself is not safe to build on" recovery
# latches — main-broken (origin/main's HEAD CI is red) and sync-broken (local
# main cannot ff-merge origin/main) — and persists their LATCH STATE in a durable
# JSON record that carries NO GitHub `dispatch:*` label. This is the first unit of
# migrating the live dispatch harness off the legacy selector/label surface: the
# two-source main-broken CI probe used to live inside `dispatch-select-target`
# (the legacy selector) and the sync-broken latch used to be read from an open
# `dispatch:sync-broken` GitHub issue inline in `dispatch-select-tick`. Both now
# resolve here.
#
# WHY a sensor: latch STATE is dispatch machinery, not user intent. A consumer
# deciding "is the repo healthy enough to start work?" must be able to answer WITHOUT
# a `gh` round-trip and without reading a GitHub label. The read modes below
# (--main-broken-latched / --sync-broken-latched) touch only the local JSON record
# — no network, no `gh`.
#
# ---- Persistence choice: durable JSON record (NOT a graph attribute, NOT a label)
#
# The latch state lives in a single small JSON record, resolved to
# <project-root>/tmp/repo-health.json (override: REPO_HEALTH_STATE_FILE, for
# tests). This mirrors the sync-repair attempt-counter primitive
# (sync_repair_attempts_file in lib.sh): repo-health state is RUNTIME state, not
# user config, so it belongs beside dispatch.lock / sync-repair-attempts in the
# shared project-root tmp/ (shared across worktrees, git-ignored), not in
# dispatch.config/ (which holds user-authored config the `dispatch-config-load`
# schema loader validates). A JSON record — rather than a graph node attribute —
# keeps the sensor self-contained and readable with zero graph/tsx/npm dependency
# on the hot path; the record is the durable, label-free home the greenfield
# target calls for.
#
# Record shape (all keys optional; an absent key or an absent file both mean
# "that latch is CLEAR" — i.e. healthy):
#   {
#     "main_broken": { "latched": true, "sha": "<origin/main HEAD sha>", "since": "<iso8601>" },
#     "sync_broken": { "latched": true, "reason": "merge-failed|fetch-failed", "since": "<iso8601>" }
#   }
# A MISSING file is a legitimate "healthy" state, NOT an error (no latch has ever
# been set). A PRESENT-but-malformed file IS an error (a corrupt record must be
# surfaced, per .claude/rules/code-style.md — never silently treated as healthy).
#
# ---- Announcement surface decision (explicit, per the tactic brief)
#
# The human-visibility ANNOUNCEMENT surface STAYS gh-based and is NOT moved by
# this unit. dispatch-diagnose-main still files the find-or-create
# `dispatch:main-broken` issue, and dispatch-escalate-sync-broken still files the
# find-or-create `dispatch:sync-broken` issue — those labeled issues remain the
# dispatchable, human-readable record of a red episode. What moves here is only
# the LATCH STATE the selector reads to decide recovery: that is now the durable
# label-free record above, so no consumer needs `gh` or a label to answer "am I
# already latched?". The announcement label and the durable latch are kept in
# sync at the two write sites (escalate → --set-sync-broken; recover →
# --clear-sync-broken), so the labeled issue stays a pure human-visibility mirror
# of the durable state, no longer its source of truth.
#
# ---- Modes
#
#   --main-broken-sha
#       Probe origin/main's HEAD CI (the two-source aggregation lifted verbatim
#       from dispatch-select-target's main_broken_sha) and print the broken HEAD
#       SHA, or nothing when main is green. AS A SIDE EFFECT it reconciles the
#       durable main_broken latch: red → set/refresh (records the sha), green →
#       clear. This is the live probe (needs `gh`) and the durable writer in one;
#       it is the drop-in replacement for `dispatch-select-target --main-broken-sha`.
#       Exits non-zero (empty stdout) if the CI probe itself fails — the caller
#       treats that as UNKNOWN and must not read it as "green".
#
#   --main-broken-latched
#       READ-ONLY, no `gh`, no network. Print `latched` when the durable record
#       marks main broken, else `clear`.
#
#   --sync-broken-latched
#       READ-ONLY, no `gh`, no network. Print `latched` when the durable record
#       marks the local-main sync wedged, else `clear`.
#
#   --set-sync-broken --reason <merge-failed|fetch-failed>
#       Set (or refresh) the durable sync_broken latch. Preserves the original
#       `since` timestamp across refreshes. Writes nothing to stdout.
#
#   --clear-sync-broken
#       Clear the durable sync_broken latch (idempotent — clearing an unset latch
#       is a no-op). Writes nothing to stdout.
#
# ---- Sandbox
#
# --main-broken-sha calls `gh` (network + TLS), so a caller must invoke this
# script with `dangerouslyDisableSandbox: true` for that mode (see
# .claude/rules/sandbox.md). The read/write modes touch only the local JSON
# record and need no sandbox override.
#
# ---- Exit codes
#   0   success (mode ran; stdout carries the mode's result).
#   1   an operation failed (CI probe error, malformed record, unresolvable state
#       path) — surfaced on stderr, clear error, no fallback.
#   2   usage error.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# lib.sh provides gh_retry (transient-failure retry) and resolve_project_root
# (the shared project-root resolver the state-file path is anchored to).
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib.sh"

# ---- Durable latch record ---------------------------------------------------

# Print the latch-record path. An explicit REPO_HEALTH_STATE_FILE is
# authoritative and bypasses the git lookup (tests rely on this). Otherwise the
# record lives at the shared project-root tmp/ so concurrent ticks in different
# worktrees read/write one record — the same rationale as sync_repair_attempts_file.
state_file() {
  if [[ -n "${REPO_HEALTH_STATE_FILE:-}" ]]; then
    printf '%s\n' "$REPO_HEALTH_STATE_FILE"
    return 0
  fi
  local root
  root=$(resolve_project_root) || {
    echo "repo-health: not in a git repo and REPO_HEALTH_STATE_FILE is unset" >&2
    return 1
  }
  printf '%s\n' "$root/tmp/repo-health.json"
}

# Echo the current record as JSON. An ABSENT file is the healthy default and
# echoes `{}` (a legitimate state, not an error). A PRESENT-but-malformed file is
# an error (clear-errors: a corrupt record must never be read as healthy).
read_state() {
  local f
  f=$(state_file) || return 1
  if [[ ! -e "$f" ]]; then
    printf '%s\n' '{}'
    return 0
  fi
  local parsed
  if ! parsed=$(jq '.' "$f" 2>&1); then
    echo "repo-health: $f: invalid JSON latch record: $parsed" >&2
    return 1
  fi
  if [[ -z "$parsed" ]]; then
    echo "repo-health: $f: latch record is empty or contains no JSON value" >&2
    return 1
  fi
  printf '%s\n' "$parsed"
}

# Atomically overwrite the record with the JSON passed as $1 (write temp + mv).
write_state() {
  local content="$1" f dir tmp
  f=$(state_file) || return 1
  dir=$(dirname "$f")
  mkdir -p "$dir"
  tmp=$(mktemp "$f.XXXXXX") || { echo "repo-health: could not create temp file next to $f" >&2; return 1; }
  printf '%s\n' "$content" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$f"
}

# Print `latched` when the record's <key>.latched is true, else `clear`. Reader —
# no gh, no network.
latch_status() {
  local key="$1" state
  state=$(read_state) || return 1
  if jq -e --arg k "$key" '.[$k].latched == true' <<<"$state" >/dev/null; then
    echo "latched"
  else
    echo "clear"
  fi
}

# ---- main-broken CI probe (two-source aggregation) --------------------------
# Lifted verbatim from dispatch-select-target's main_broken_sha: origin/main's CI
# state spans two sources that must both be aggregated —
#   - check-runs    (CodeQL default-setup analyses)      — /commits/{sha}/check-runs
#   - workflow runs (Production Deploy, Firestore rules) — gh run list --branch main
# The legacy combined-status API is intentionally not used (it reports "pending"
# for commits with no classic statuses). Prints origin/main's HEAD SHA when a
# check has failed; prints nothing when main is healthy or only has in-progress
# checks. gh calls route through gh_retry (transient-failure retry).
main_broken_sha() {
  local sha cr_fail wf_fail
  # CI conclusions that count as a failing check; both gh sources report
  # conclusions in lowercase.
  local fail='["failure","timed_out","cancelled","action_required","startup_failure","stale"]'
  sha=$(gh_retry gh api "repos/{owner}/{repo}/commits/main" | jq -r '.sha')

  cr_fail=$(gh_retry gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
    | jq --argjson fail "$fail" \
        '[.check_runs[] | select(.conclusion as $c | $fail | index($c))] | length')

  # --commit scopes the query to main's HEAD (the default 20-run window could
  # otherwise miss it); the headSha filter is a defense-in-depth guard so a
  # stale run can never trip the gate.
  wf_fail=$(gh_retry gh run list --branch main --commit "$sha" \
    --json headSha,conclusion \
    | jq --arg sha "$sha" --argjson fail "$fail" \
        '[.[] | select(.headSha == $sha)
              | select(.conclusion as $c | $fail | index($c))] | length')

  if [[ "$cr_fail" -gt 0 || "$wf_fail" -gt 0 ]]; then
    printf '%s\n' "$sha"
  fi
}

# ---- Mode dispatch ----------------------------------------------------------

MODE=""
REASON=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --main-broken-sha|--main-broken-latched|--sync-broken-latched|--set-sync-broken|--clear-sync-broken)
      if [[ -n "$MODE" ]]; then
        echo "repo-health: only one mode may be given (already have $MODE, got $1)" >&2
        exit 2
      fi
      MODE="$1"
      shift
      ;;
    --reason)
      REASON="${2:-}"
      shift 2
      ;;
    *)
      echo "repo-health: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$MODE" ]]; then
  echo "repo-health: a mode is required (--main-broken-sha | --main-broken-latched | --sync-broken-latched | --set-sync-broken --reason <r> | --clear-sync-broken)" >&2
  exit 2
fi

case "$MODE" in
  --main-broken-sha)
    # Live CI probe. Reconcile the durable main_broken latch as a side effect,
    # then print the broken SHA (empty when green). A probe failure aborts under
    # set -e BEFORE the latch write, so an errored probe never mutates the latch.
    SHA=$(main_broken_sha)
    NOW=$(date -u +%FT%TZ)
    if [[ -n "$SHA" ]]; then
      NEW=$(read_state | jq --arg s "$SHA" --arg ts "$NOW" \
        '.main_broken = {latched: true, sha: $s, since: (.main_broken.since // $ts)}')
    else
      NEW=$(read_state | jq 'del(.main_broken)')
    fi
    write_state "$NEW"
    [[ -n "$SHA" ]] && printf '%s\n' "$SHA"
    exit 0
    ;;
  --main-broken-latched)
    latch_status main_broken
    exit 0
    ;;
  --sync-broken-latched)
    latch_status sync_broken
    exit 0
    ;;
  --set-sync-broken)
    case "$REASON" in
      merge-failed|fetch-failed) ;;
      *)
        echo "repo-health: --set-sync-broken requires --reason merge-failed|fetch-failed (got '$REASON')" >&2
        exit 2
        ;;
    esac
    NOW=$(date -u +%FT%TZ)
    NEW=$(read_state | jq --arg r "$REASON" --arg ts "$NOW" \
      '.sync_broken = {latched: true, reason: $r, since: (.sync_broken.since // $ts)}')
    write_state "$NEW"
    exit 0
    ;;
  --clear-sync-broken)
    NEW=$(read_state | jq 'del(.sync_broken)')
    write_state "$NEW"
    exit 0
    ;;
esac
