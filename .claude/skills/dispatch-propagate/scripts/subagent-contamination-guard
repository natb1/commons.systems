#!/usr/bin/env bash
# subagent-contamination-guard — baseline-before / check-after contamination
# guard bracketing each Agent-tool subagent launch.
#
# The Agent tool can pin a spawned subagent's cwd to the primary checkout
# instead of the launching worktree, so a subagent using relative paths can
# silently write into the wrong checkout while the launching worktree's git
# status stays clean. This script snapshots the primary checkout's
# `git status --porcelain` before the subagent launches (`baseline <label>`)
# and diffs it after (`check <label>`), flagging any newly-dirty paths there
# as contamination.
#
# State must persist to a FILE, not a shell variable: shell state does not
# survive across separate Bash tool calls, and the Agent-tool subagent launch
# sits between the "before" and "after" invocations.
#
# An optional third positional argument names the "launching worktree" (CUR)
# explicitly, overriding the default `git rev-parse --show-toplevel` of the
# invoking shell's cwd. This exists because some callers' own session cwd IS
# the primary checkout (e.g. dispatch-conflict Lane 3, whose session runs
# with --cwd pinned to the primary checkout while it actually operates on a
# node's own worktree) — for those callers, deriving CUR from cwd would
# always equal PRIMARY and the guard would go permanently vacuous (SKIP)
# exactly where the contamination hazard is highest. Pass the real worktree
# path in that case so the guard stays live.
#
# That argument is validated, not trusted. It must name the ROOT of a
# registered worktree that is NOT the primary checkout; anything else is a
# hard error (exit 2), never a SKIP. A path that merely sits *inside* the
# primary checkout — e.g. a leftover plain directory at
# `.claude/worktrees/<id>` after a reaped or partially-removed worktree —
# resolves through `rev-parse --show-toplevel` to the primary checkout itself,
# which would re-arm exactly the vacuous SKIP the argument exists to prevent
# (red-team-3). Failing loud there is the whole point: when the caller names a
# path that resolves to the primary checkout, the guard cannot tell
# contamination from legitimate writes, so it must refuse rather than report a
# clean pass.
#
# `baseline` and `check` MUST be passed the identical worktree-path argument
# (or both omit it): the snapshot filename (SNAP, below) is keyed on the
# resolved CUR, so a mismatched or missing argument on one side makes `check`
# look for a baseline that was never written and exit 2 (missing baseline) —
# it does not silently fall back to cwd.
#
# Usage:
#   subagent-contamination-guard baseline <label> [worktree-path]
#   subagent-contamination-guard check <label> [worktree-path]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-graph-worktree.sh
source "$SCRIPT_DIR/lib-graph-worktree.sh"

usage() {
  echo "Usage: subagent-contamination-guard baseline <label> [worktree-path]" >&2
  echo "       subagent-contamination-guard check <label> [worktree-path]" >&2
  echo "  [worktree-path] names the launching worktree explicitly when the" >&2
  echo "  invoking shell's own cwd is the primary checkout (e.g. a session" >&2
  echo "  --cwd-pinned there). Omitting it derives it from cwd instead. Pass" >&2
  echo "  the SAME [worktree-path] (or omit it) to both baseline and check —" >&2
  echo "  the snapshot is keyed on it." >&2
}

SUBCOMMAND="${1:-}"
LABEL="${2:-}"
WORKTREE_PATH="${3:-}"

if [[ "$SUBCOMMAND" != "baseline" && "$SUBCOMMAND" != "check" ]]; then
  usage
  exit 2
fi

if [[ -z "$LABEL" ]]; then
  usage
  exit 2
fi

if [[ -n "$WORKTREE_PATH" ]]; then
  if [[ ! -d "$WORKTREE_PATH" ]]; then
    echo "subagent-contamination-guard: worktree-path '$WORKTREE_PATH' does not exist." >&2
    usage
    exit 2
  fi
  CUR="$(git -C "$WORKTREE_PATH" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$CUR" ]]; then
    echo "subagent-contamination-guard: worktree-path '$WORKTREE_PATH' is not inside a git repository." >&2
    usage
    exit 2
  fi

  # An explicitly-passed path that resolves to the primary checkout is an
  # ERROR, not a SKIP. The caller passed it precisely because its own cwd is
  # the primary checkout and cwd-derived CUR would be vacuous; if the path
  # resolves there too (a leftover plain directory inside the primary checkout
  # is the common way this happens), the guard cannot distinguish subagent
  # contamination from the session's own legitimate writes. Refuse loudly
  # instead of silently disabling the guard for the whole run (red-team-3).
  ARG_PRIMARY="$(resolve_main_worktree 2>/dev/null || true)"
  if [[ -n "$ARG_PRIMARY" && -d "$ARG_PRIMARY" && "$ARG_PRIMARY" -ef "$CUR" ]]; then
    echo "subagent-contamination-guard: worktree-path '$WORKTREE_PATH' resolves to the primary checkout '$ARG_PRIMARY' — either it IS the primary checkout, or it is a path inside it (e.g. a leftover plain directory where a worktree used to be). The guard cannot distinguish subagent contamination from legitimate writes there, so it refuses rather than reporting a clean pass. Pass the launching worktree's own root, or recreate the missing worktree." >&2
    exit 2
  fi

  # The path must also name the ROOT of a registered worktree of this repo —
  # not merely some directory inside one. A subdirectory resolves upward to its
  # enclosing worktree, which silently guards a different tree than the caller
  # named.
  CUR_REGISTERED=""
  while IFS= read -r wt_line; do
    [[ "$wt_line" == "worktree "* ]] || continue
    wt_dir="${wt_line#worktree }"
    if [[ -d "$wt_dir" && "$wt_dir" -ef "$CUR" ]]; then
      CUR_REGISTERED=1
      break
    fi
  done < <(git -C "$CUR" worktree list --porcelain 2>/dev/null || true)

  if [[ ! "$WORKTREE_PATH" -ef "$CUR" || -z "$CUR_REGISTERED" ]]; then
    echo "subagent-contamination-guard: worktree-path '$WORKTREE_PATH' is not the root of a registered git worktree (it resolves to '$CUR'; see 'git worktree list'). Pass the launching worktree's own root." >&2
    exit 2
  fi
else
  CUR="$(git rev-parse --show-toplevel)"
fi

# The baseline snapshot must be unique to THIS session's baseline/check pair.
# CLAUDE_CODE_SESSION_ID is a stable UUID exported into every .claude session's
# environment (the same guarantee dispatch-acquire-lock relies on): constant
# across the separate Bash tool calls that run `baseline` then `check`, and
# distinct per session. Scoping the filename by it means a leftover snapshot
# from a DIFFERENT session can never satisfy `check`'s existence test for this
# session, so a run whose `baseline` step was skipped correctly hits the
# missing-baseline exit 2 (Case 5) instead of silently diffing against an
# unrelated prior session's snapshot and masking real contamination
# (red-team-1). Fail loud if it is unset rather than degrade to a collidable
# filename.
SESSION_ID="${CLAUDE_CODE_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo "subagent-contamination-guard: CLAUDE_CODE_SESSION_ID is unset — cannot scope the baseline snapshot to this session, so a stale snapshot from another run could mask contamination. Run inside a .claude session." >&2
  exit 2
fi

SNAP="$TMPDIR/contamination-${SESSION_ID}-$(printf '%s' "$CUR" | tr '/' '_')-${LABEL}.baseline"

if [[ "$SUBCOMMAND" == "baseline" ]]; then
  PRIMARY="$(resolve_main_worktree 2>/dev/null || true)"

  if [[ -z "$PRIMARY" ]] || [[ "$PRIMARY" -ef "$CUR" ]]; then
    # No primary checkout resolvable, or we ARE the primary checkout —
    # contamination is impossible (also covers a future harness fix that
    # correctly pins subagent cwd to the launching worktree).
    printf 'SKIP\n' >"$SNAP"
    exit 0
  fi

  git -C "$PRIMARY" status --porcelain >"$SNAP"
  exit 0
fi

# check
if [[ ! -f "$SNAP" ]]; then
  echo "subagent-contamination-guard: no baseline found at '$SNAP' for label '$LABEL' — baseline never ran (a wiring bug). Run 'subagent-contamination-guard baseline $LABEL' before the subagent launch." >&2
  exit 2
fi

# Consume the baseline: read its contents, then delete the file immediately so
# it can never linger to be mistaken for a later run's baseline. Combined with
# the session-scoped filename above, this guarantees a run whose `baseline` step
# was skipped hits the missing-baseline exit 2 above rather than silently
# diffing against a stale snapshot left by a prior run (red-team-1).
BASELINE="$(cat "$SNAP")"
rm -f "$SNAP"

if [[ "$(head -n1 <<<"$BASELINE")" == "SKIP" ]]; then
  exit 0
fi

PRIMARY="$(resolve_main_worktree 2>/dev/null || true)"

# The baseline reached this diffing path only because it snapshotted a real,
# non-empty primary checkout (an empty/self primary writes SKIP and check
# returns above). So the primary MUST still resolve now. If it does not, refuse
# to pass: an empty PRIMARY here would make `git -C ""` fail inside the command
# substitution (where set -e does not fire), leave AFTER empty, and silently
# report "no contamination" — a false-negative in a guard whose whole job is
# catching lost work. Fail loud instead of degrading to a clean pass.
if [[ -z "$PRIMARY" || ! -d "$PRIMARY" ]]; then
  echo "subagent-contamination-guard: the primary checkout could not be resolved at check time (resolve_main_worktree returned '$PRIMARY') though the baseline snapshotted a real one — cannot inspect it for contamination. Refusing to report a clean pass." >&2
  exit 2
fi

AFTER="$(git -C "$PRIMARY" status --porcelain)"
NEW="$(comm -13 <(sort <<<"$BASELINE") <(sort <<<"$AFTER"))"

if [[ -z "$NEW" ]]; then
  exit 0
fi

{
  echo "subagent-contamination-guard: INVARIANT VIOLATED — subagent writes landed in the primary checkout '$PRIMARY' instead of the launching worktree '$CUR'. Contaminating paths:"
  echo "$NEW"
  echo "  Repair: manually move each listed file into the launching worktree '$CUR' and re-run the unit — do not auto-relocate."
} >&2

exit 1
