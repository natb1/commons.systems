#!/usr/bin/env bash
# transition-node — the graph-native forward phase-transition writer
# (tactic-graph-router-transitions Unit 1). The graph lane's replacement for the
# legacy label edits at dispatch-complete-phase / dispatch-finalize-phase: at
# the seam where a phase worker finishes, it consults the phase's sensors and
# the freshness gates, then lands the phase / marker / attempt / pr write on
# origin/main through graph-commit.
#
# Spec: intentions/tactic-graph-native-dispatch.md §1.1, §2.4; strategy
# clarifications 10, 18, 22. The DECISION (unconditional forward ladder edge,
# residue→main-qa, freshness holds) lives in the pure `transitions` module,
# applied via apply-node-transition.ts; this wrapper owns only the environmental
# parts: the origin/main snapshot, the fingerprint gates, arming gh auto-merge,
# and refreshing the phase-start stamp.
#
# The forward transition is CI-BLIND: it never reads a CI verdict and never
# routes a tactic into `fix`. A CI-fix interrupt is carried orthogonally on
# `execution.fix` and routed by the selector, leaving `phase` at its real ladder
# position — so this wrapper has no CI sensor.
#
# Doctrine: the transition is a STATE-ONLY commit on main, never on the work PR
# branch (strategy clarification 15). Run this from a main-based checkout; from
# a PR-branch worktree the caller applies the reset-dance graph-commit needs
# (same constraint as park-node).
#
# Freshness gates (compute-freshness.ts over the origin/main snapshot):
#   - scope-stale → delegate to demote-node-to-implement (the backward
#     transition owns its own provenance commit + PR comment).
#   - broken evidence chain (review only) → delegate to
#     demote-node-to-implement. At the review→merge seam an earlier phase's
#     completion marker may be BOUND to a scope the tactic has since moved off
#     (tactic-phase-evidence-fingerprint-bound Unit 3); that evidence no longer
#     certifies the scope about to merge. A demote, not a hold, because it is
#     self-clearing: the re-selected implement worker re-establishes custody,
#     where a hold would stall forever with nothing able to refresh the binding.
#   - strategy-stale → hold at the completed phase (the selector queues the
#     re-evaluation; a confirm re-stamps and the next tick advances).
#   - missing stamp at the review→merge ARMING point → fail closed: hold, do
#     NOT arm merge. Elsewhere a missing stamp fails open.
#
# Usage: transition-node <node-id> [--set-pr <n>]
#
# Stdout: exactly one outcome line —
#   transitioned <id> <prev> -> <new>
#   armed-merge <id> (review complete)
#   demoted <id> -> implement (scope drift)
#   demoted <id> -> implement (broken evidence chain: <names>)
#   held <id> at <phase> (<reason>)
#
# Exit codes: 0 landed; 1 write/graph-commit failure; 2 usage/environment error.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
# The scope-fingerprint stamp lives at the MAIN checkout root (provision-node-worktree
# writes it there). REPO_ROOT resolves to the current worktree — wrong when we run from a
# nested PR-branch worktree — so resolve the shared main root for the stamp path only.
MAIN_ROOT="$(resolve_project_root)" || { echo "transition-node: could not resolve the main project root" >&2; exit 2; }
UTIL_SCRIPTS="$REPO_ROOT/packages/intentionsutil/scripts"
GRAPH_COMMIT="$UTIL_SCRIPTS/graph-commit"

NODE_ID="${1:-}"
if [[ -z "$NODE_ID" ]]; then
  echo "usage: transition-node <node-id> [--set-pr <n>]" >&2
  exit 2
fi
shift || true
SET_PR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --set-pr)
      SET_PR="${2:-}"
      if [[ ! "$SET_PR" =~ ^[0-9]+$ ]]; then
        echo "transition-node: --set-pr requires a non-negative integer" >&2
        exit 2
      fi
      shift 2 ;;
    *) echo "transition-node: unexpected argument '$1'" >&2; exit 2 ;;
  esac
done

# Read the whole local node frontmatter as JSON once, for field extraction.
read_node_json() {
  (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { readNode } = await import("./packages/intentionsutil/src/store.js");
    process.stdout.write(JSON.stringify(readNode("./intentions", process.argv[1])));
  ' "$NODE_ID")
}

# Refresh the phase-start stamp to the post-write scope fingerprint + the new
# origin/main sha, so machinery body appends do not later trip the custody gate.
refresh_stamp() {
  local stamp_file="$MAIN_ROOT/.claude/worktrees/$NODE_ID.scope-fingerprint"
  local sha fp
  sha="$( (cd "$REPO_ROOT" && git rev-parse origin/main 2>/dev/null) )" || return 0
  fp="$( (cd "$REPO_ROOT" && node --import tsx/esm -e '
    const { readNode, readNodeBody } = await import("./packages/intentionsutil/src/store.js");
    const { tacticScopeFingerprint } = await import("./packages/intentionsutil/src/router.js");
    const id = process.argv[1];
    process.stdout.write(tacticScopeFingerprint(readNode("./intentions", id).statement, readNodeBody("./intentions", id)));
  ' "$NODE_ID" 2>/dev/null) )" || return 0
  [[ -n "$fp" && -n "$sha" ]] || return 0
  mkdir -p "$(dirname "$stamp_file")" 2>/dev/null || true
  printf '%s %s\n' "$fp" "$sha" > "$stamp_file" 2>/dev/null || true
}

# --- Read the current phase + PR --------------------------------------------
NODE_JSON="$(read_node_json)" || { echo "transition-node: could not read node $NODE_ID" >&2; exit 2; }
PHASE="$(jq -r '.phase // "implement"' <<<"$NODE_JSON")"
PR="$SET_PR"
[[ -z "$PR" ]] && PR="$(jq -r '.execution.pr // empty' <<<"$NODE_JSON")"

# --- Freshness gates over an origin/main snapshot ----------------------------
SNAP_DIR="$(mktemp -d)" || { echo "transition-node: mktemp failed" >&2; exit 2; }
# MUTATED gates the rollback below: only restore intentions/$NODE_ID.md from
# origin/main if this script actually wrote to it (the apply-node-transition.ts
# call further down). A pre-mutation failure (freshness gate computation, node
# read, etc.) must not trigger a restore of a file this script never touched.
MUTATED=0
trap '
  rc=$?
  rm -rf "$SNAP_DIR"
  if [[ "$MUTATED" == 1 && $rc -ne 0 ]]; then
    # Restore from the immutable blob SHA captured before the mutation, not the
    # moving origin/main ref (a concurrent fetch may have pruned/relocated the
    # node). Write to a temp file and mv into place only on success, so a failed
    # git-show never truncates the node file to zero bytes.
    if git -C "$REPO_ROOT" show "$FRESH_BLOB" > "$REPO_ROOT/intentions/$NODE_ID.md.rollback"; then
      mv "$REPO_ROOT/intentions/$NODE_ID.md.rollback" "$REPO_ROOT/intentions/$NODE_ID.md"
    else
      rm -f "$REPO_ROOT/intentions/$NODE_ID.md.rollback"
    fi
  fi
' EXIT
if ! (cd "$REPO_ROOT" && git archive origin/main intentions 2>/dev/null | tar -x -C "$SNAP_DIR"); then
  mkdir -p "$SNAP_DIR/intentions"
fi
STAMP_FILE="$MAIN_ROOT/.claude/worktrees/$NODE_ID.scope-fingerprint"
FRESH="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/compute-freshness.ts" \
  "$NODE_ID" --snapshot "$SNAP_DIR/intentions" --stamp "$STAMP_FILE") )" || {
  echo "transition-node: freshness gate computation failed for $NODE_ID" >&2; exit 2; }
SCOPE_STALE="$(jq -r '.scopeStale' <<<"$FRESH")"
STRATEGY_STALE="$(jq -r '.strategyStale' <<<"$FRESH")"
STAMP_MISSING="$(jq -r '.stampMissing' <<<"$FRESH")"
STAMPED_FP="$(jq -r '.stampedFingerprint // empty' <<<"$FRESH")"
STAMPED_SHA="$(jq -r '.stampedSha // empty' <<<"$FRESH")"

# --- Scope-stale → delegate to the demotion primitive ------------------------
# main-qa is post-merge by definition (check-node-selection.ts:242), so scope
# chaining excludes it (SCOPE_CHAINED_PHASES = {fix,qa,review}, check-node-selection.ts:61;
# decideTransition's scope-stale branch is pre-merge only, transitions.ts:176-179). Don't
# demote a scope-stale main-qa node — fall through to the normal transition below.
if [[ "$SCOPE_STALE" == "true" && "$PHASE" != "main-qa" ]]; then
  if "$UTIL_SCRIPTS/demote-node-to-implement" "$NODE_ID"; then
    echo "demoted $NODE_ID -> implement (scope drift)"
    exit 0
  fi
  echo "transition-node: demotion of $NODE_ID failed" >&2
  exit 1
fi

# --- Broken evidence chain at the review seam → demote -----------------------
# A `review` completion is the ratification point: the earlier phases' markers
# are about to be treated as standing evidence for the scope that merges. When
# one of them is BOUND to a different scope fingerprint than the tactic now
# carries, that evidence certifies a scope that no longer exists, so the chain
# is broken and the ladder must re-run.
#
# Gated on PHASE == review (the phase being completed), NOT on the post-apply
# ARM_MERGE variable, deliberately: this check must sit strictly BEFORE the
# apply-node-transition.ts mutation below, so it can never involve the rollback
# trap. Nothing has been written when it fires.
#
# Demote rather than hold: a hold has no clearing event (no worker re-binds a
# marker at a held phase) and would stall the node forever, while the demotion
# clears markers and the re-selected implement worker re-establishes custody.
STALE_CHAIN="$(jq -r '(.staleChainMarkers // []) | join(", ")' <<<"$FRESH")"
if [[ "$PHASE" == "review" && -n "$STALE_CHAIN" ]]; then
  if "$UTIL_SCRIPTS/demote-node-to-implement" "$NODE_ID"; then
    echo "demoted $NODE_ID -> implement (broken evidence chain: $STALE_CHAIN)"
    exit 0
  fi
  echo "transition-node: demotion of $NODE_ID (broken evidence chain: $STALE_CHAIN) failed" >&2
  exit 1
fi

# --- Apply the forward/hold decision to the local store ----------------------
APPLY_FLAGS=("$NODE_ID")
[[ "$STRATEGY_STALE" == "true" ]] && APPLY_FLAGS+=("--strategy-stale")
[[ -n "$SET_PR" ]] && APPLY_FLAGS+=("--set-pr" "$SET_PR")
# Bind a newly-written completion marker to the STAMP's fingerprint, not a
# fresh recompute — the stamp is the scope the phase worker actually ran
# against. The forward path below is only reached when SCOPE_STALE is false
# (the scope-stale branch above delegates to demote-node-to-implement and
# exits), so on a clean forward transition the stamp and a fresh recompute
# agree; where they could differ (e.g. a machinery body append after the
# worker started but before this write), the stamp is the honest value — it
# is what the worker verified against, not what is true right now. Bind
# nothing when the stamp is missing (STAMPED_FP/STAMPED_SHA empty): the
# worker's actual verified scope is unknown, and inventing the current
# fingerprint would record a falsehood.
if [[ -n "$STAMPED_FP" && -n "$STAMPED_SHA" ]]; then
  APPLY_FLAGS+=("--evidence-fingerprint" "$STAMPED_FP" "--evidence-sha" "$STAMPED_SHA")
fi
FRESH_BLOB="$(git -C "$REPO_ROOT" rev-parse "origin/main:intentions/$NODE_ID.md" 2>/dev/null)" || {
  echo "transition-node: intentions/$NODE_ID.md does not exist on origin/main — cannot transition a node that is not landed" >&2
  exit 1
}
MUTATED=1
if ! RESULT="$( (cd "$REPO_ROOT" && node --import tsx/esm "$UTIL_SCRIPTS/apply-node-transition.ts" "${APPLY_FLAGS[@]}") )"; then
  echo "transition-node: apply-node-transition failed for $NODE_ID" >&2
  exit 1
fi
NEW_PHASE="$(jq -r '.phase' <<<"$RESULT")"
ARM_MERGE="$(jq -r '.armMerge' <<<"$RESULT")"
HOLD="$(jq -r '.hold' <<<"$RESULT")"

# Missing-stamp fail-closed at the arming point (worker-start has landed).
if [[ "$ARM_MERGE" == "true" && "$STAMP_MISSING" == "true" ]]; then
  echo "transition-node: $NODE_ID review complete but the phase-start stamp is missing — holding (arming requires the stamp)" >&2
  echo "held $NODE_ID at review (missing-stamp)"
  exit 0
fi

# --- Land the state-only write on main ---------------------------------------
if ! "$GRAPH_COMMIT" -C "$REPO_ROOT" -m "graph: transition $NODE_ID to $NEW_PHASE" "$NODE_ID"; then
  echo "transition-node: graph-commit failed for $NODE_ID" >&2
  exit 1
fi

refresh_stamp

# --- Arm auto-merge at clean review completion -------------------------------
if [[ "$ARM_MERGE" == "true" ]]; then
  if [[ -n "$PR" ]]; then
    gh pr ready "$PR" >/dev/null 2>&1 || true
    "$SCRIPT_DIR/dispatch-auto-merge" >/dev/null 2>&1 || true
  fi
  echo "armed-merge $NODE_ID (review complete)"
  exit 0
fi

if [[ "$HOLD" == "true" ]]; then
  echo "held $NODE_ID at $NEW_PHASE (strategy-fingerprint freeze)"
  exit 0
fi

echo "transitioned $NODE_ID $PHASE -> $NEW_PHASE"
exit 0
