#!/usr/bin/env bash
# dispatch-project-due-write — set a project item's date field (e.g. Due).
#
# Resolves a project from the local dispatch config (via dispatch-config-load),
# resolves the project node id, locates the named date field, and writes the
# given YYYY-MM-DD date to that field on the given project item.
#
# Usage:
#   dispatch-project-due-write <project-key> <item-id> <YYYY-MM-DD>
#
# Arguments:
#   <project-key>   key of an entry in dispatch.config/projects.json.
#   <item-id>       project item id, e.g. PVTI_lADO... (as returned by
#                   dispatch-project-item-add).
#   <YYYY-MM-DD>    the date to write to the project's date field.
#
# The field name is read from the project's optional `dueField` config entry
# (defaults to "Due").
#
# Exit codes:
#   0  date applied.
#   1  no config present, project key absent, the date field is not found, or
#      gh failure.
#   2  usage error.
#
# Dependency: invokes the `gh` CLI. Per .claude/rules/sandbox.md, callers must
# wrap this script with dangerouslyDisableSandbox — gh's TLS validation is
# blocked by the sandbox. This script does not alter its behavior for the
# sandbox; that is the caller's responsibility.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---- Step 0: parse arguments ------------------------------------------------

if [[ $# -ne 3 ]]; then
  echo "error: usage: dispatch-project-due-write <project-key> <item-id> <YYYY-MM-DD>" >&2
  exit 2
fi
PROJECT_KEY="$1"
ITEM_ID="$2"
DUE_DATE="$3"
if [[ -z "$PROJECT_KEY" || -z "$ITEM_ID" || -z "$DUE_DATE" ]]; then
  echo "error: usage: dispatch-project-due-write <project-key> <item-id> <YYYY-MM-DD>" >&2
  exit 2
fi

# ---- Step 1: resolve the project from local config -------------------------

PROJECTS=$("$SCRIPT_DIR/dispatch-config-load" projects)
if [[ "$PROJECTS" == "no-config" ]]; then
  echo "error: no projects.json config present; cannot resolve project '$PROJECT_KEY'" >&2
  exit 1
fi

PROJECT=$(printf '%s' "$PROJECTS" | jq -c --arg key "$PROJECT_KEY" \
  '.projects[] | select(.key == $key)')
if [[ -z "$PROJECT" ]]; then
  echo "error: project key '$PROJECT_KEY' not found in projects.json" >&2
  exit 1
fi

OWNER=$(printf '%s' "$PROJECT" | jq -r '.owner')
NUMBER=$(printf '%s' "$PROJECT" | jq -r '.number')
DUE_FIELD=$(printf '%s' "$PROJECT" | jq -r '.dueField // "Due"')

# ---- Step 2: resolve the project node id -----------------------------------

PROJECT_VIEW=$(gh project view "$NUMBER" --owner "$OWNER" --format json)
PROJECT_NODE_ID=$(printf '%s' "$PROJECT_VIEW" | jq -r '.id')

# ---- Step 3: resolve the date field id -------------------------------------

FIELDS=$(gh project field-list "$NUMBER" --owner "$OWNER" --format json)

FIELD=$(printf '%s' "$FIELDS" | jq -c --arg name "$DUE_FIELD" \
  '.fields[] | select(.name == $name)')
if [[ -z "$FIELD" ]]; then
  echo "error: date field '$DUE_FIELD' not found on project '$PROJECT_KEY'" >&2
  exit 1
fi
FIELD_ID=$(printf '%s' "$FIELD" | jq -r '.id')

# ---- Step 4: write the date ------------------------------------------------

gh project item-edit --id "$ITEM_ID" --project-id "$PROJECT_NODE_ID" \
  --field-id "$FIELD_ID" --date "$DUE_DATE" >/dev/null

echo "set $DUE_FIELD to '$DUE_DATE' for item $ITEM_ID"
