# syncOfficeHours config for the commons-systems project (see functions/src/office-hours-sync.ts).
#
# firebase-tools requires every defineString param to resolve to a value at
# deploy time — in non-interactive CI it aborts the deploy otherwise, even for
# params that carry an in-code default. This file supplies those values.
#
# In CI the values are NOT taken from this file: the functions-deploy workflow's
# "Write office-hours function config" step overwrites it from repository Variables
# (Settings -> Secrets and variables -> Actions -> Variables) so the real,
# non-secret config never enters git. These committed keys are empty, which is
# the fallback for an unconfigured environment (and for a manual local deploy):
# an empty OFFICE_HOURS_GROUP_REPO trips the function's first runtime guard, so
# syncOfficeHours deploys dormant and skips every run (one cheap log line, no GitHub
# API calls). Two values are secrets resolved from Secret Manager at runtime, not
# from this file — they never enter git. Each is set once out-of-band via:
#   firebase functions:secrets:set OFFICE_HOURS_GITHUB_APP_PRIVATE_KEY
#   firebase functions:secrets:set OFFICE_HOURS_MEMBER_EMAILS
# OFFICE_HOURS_MEMBER_EMAILS must NOT be declared here: as a defineSecret param it
# would overlap a non-secret env var of the same name and the Cloud Run deploy
# would reject it ("Secret environment variable overlaps non secret environment
# variable").
OFFICE_HOURS_GITHUB_APP_ID=
OFFICE_HOURS_GITHUB_APP_INSTALLATION_ID=
OFFICE_HOURS_GROUP_REPO=
OFFICE_HOURS_FIRESTORE_NAMESPACE=office-hours/prod
# sampleDispatchQueueMetrics config (see functions/src/dispatch-queue-metrics.ts).
# It reuses the syncOfficeHours GitHub-App auth and member-emails/namespace params
# above. These two keys are empty here so the sampler deploys dormant: an empty
# DISPATCH_METRICS_QUEUE_REPO (or OFFICE_HOURS_GROUP_ID) trips the first runtime
# guard, so the function logs one line and returns without any GitHub call. CI
# overwrites them from repository Variables, the same as the keys above.
DISPATCH_METRICS_QUEUE_REPO=
OFFICE_HOURS_GROUP_ID=
