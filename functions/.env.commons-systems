# syncAgenda config for the commons-systems project (see functions/src/agenda-sync.ts).
#
# firebase-tools requires every defineString param to resolve to a value at
# deploy time — in non-interactive CI it aborts the deploy otherwise, even for
# params that carry an in-code default. This file supplies those values.
#
# In CI the values are NOT taken from this file: the functions-deploy workflow's
# "Write agenda function config" step overwrites it from repository Variables
# (Settings -> Secrets and variables -> Actions -> Variables) so the real,
# non-secret config never enters git. These committed keys are empty, which is
# the fallback for an unconfigured environment (and for a manual local deploy):
# an empty AGENDA_GROUP_REPO trips the function's first runtime guard, so
# syncAgenda deploys dormant and skips every run (one cheap log line, no GitHub
# API calls). The private key is the only secret and lives in Secret Manager:
#   firebase functions:secrets:set AGENDA_GITHUB_APP_PRIVATE_KEY
AGENDA_GITHUB_APP_ID=
AGENDA_GITHUB_APP_INSTALLATION_ID=
AGENDA_GROUP_REPO=
AGENDA_MEMBER_EMAILS=
AGENDA_FIRESTORE_NAMESPACE=agenda/prod
