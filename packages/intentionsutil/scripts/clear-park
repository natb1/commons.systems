#!/usr/bin/env bash
# clear-park — clear one intention node's office_hours park via the graph
# write (strategy-graph-native-dispatch, clarification 65). The scripted
# inverse of park-node: a future drain-lane skill
# (tactic-office-hours-self-modification-skill) invokes this as its mandatory
# terminal park disposition on green CI, since park-node currently has no
# scripted inverse — a park is cleared today only by an incidental commit
# side-effect or a hand-rolled inline sequence, which is unreliable for the
# drain lane whose fix commit lands on the PR branch and never touches the
# node frontmatter.
#
# Content is written through store.ts's readNode → writeNode (the validated
# writer — frontmatter serialized correctly, tactic bodies preserved); this
# script authors no markdown. The commit/stamp/fast-forward mechanics are
# graph-commit's.
#
# Fresh-origin/main invariant (mirrors park-node:60-77,
# tactic-park-node-fresh-main-clobber-fix): the read-modify-write below
# operates on origin/main's CURRENT content, never the possibly-stale local
# on-disk copy — the invocation routinely comes from a far-behind PR-branch
# worktree, and the drain lane calls this at the END of a long session, by
# which time origin/main has usually advanced. So this script fetches
# origin/main, overwrites the local node file with origin/main's version,
# THEN reads/mutates/writes it, and passes graph-commit a `--base`
# compare-and-swap token pinned to the blob it read. Without the guard a stale
# copy's small office_hours diff applies cleanly onto a since-advanced
# origin/main and silently reverts unrelated body/frontmatter changes landed
# in between; with it, graph-commit refuses (exit 1) instead.
#
# If the node's office_hours is already null ON ORIGIN/MAIN (the refresh above
# is what makes this check test landed truth rather than a stale local copy),
# this is a deliberate idempotent no-op: print an informative note and exit 0
# without calling graph-commit. Because the refresh itself rewrites the local
# node file, that no-op path restores the pre-refresh copy before exiting (see
# the rollback below) — an idempotent invocation must not leave the tree dirty.
#
# Write-failure rollback (mirrors park-node:82-101, the invariant asserted by
# .claude/skills/dispatch-propagate/scripts/test-graph-write-rollback.sh): every
# exit path that does NOT land a commit restores intentions/<node-id>.md to the
# state this script found it in — from the pre-refresh copy captured below, so
# the restore is exact even in the far-behind worktree this script normally runs
# from (a FRESH_BLOB restore would leave origin/main's content behind as a
# modification there). A leaked dirty node file would trip graph-commit's
# assert_clean_outside_ids guard for every other unrelated node in that
# worktree.
#
# Landing signal (tactic-graph-commit-landing-signal-unreliable, Unit 4):
# graph-commit's own exit code is NOT trusted as the verdict on whether the
# clear landed. graph-commit can report failure over a write that actually
# reached origin/main (Direction B), or success over one that didn't. After
# every graph-commit invocation below — success or failure — this script asks
# the sibling `verify-landed` primitive directly, in BLOB mode, pinned to the
# exact bytes this run produced: `verify-landed -C "$REPO_ROOT" --node
# "$NODE_ID" --blob "$EXPECT_BLOB"`. Its three-valued verdict (landed/
# not-landed/unknown), not graph-commit's rc, decides clear-park's own exit and
# whether the pre-clear local copy is restored.
#
# Blob mode, NOT the field predicate `--jq '.office_hours == null'`. In jq mode
# verify-landed hands an ABSENT node to the filter as the JSON literal `null`
# (its node_json_at_main prints `null` when readNodeAtRef finds nothing at the
# ref), and `null | .office_hours == null` evaluates TRUE — so a node that is
# not on origin/main AT ALL verifies as `landed`. Under that predicate a node
# pruned by a concurrent writer, a graph-commit that never created the node,
# or simply a mistyped id would all be reported as "cleared and landed on
# main": MUTATED would be zeroed so the EXIT trap declines to restore the
# pre-clear local copy, and this script would exit 0 — forging the release of
# the very gate that keeps autonomous dispatch off a node the human has not
# released, while leaving the local file mutated with no rollback and no
# error. `--blob <blobsha>` cannot be satisfied by an absent node (verify-landed
# observes the literal `absent`, which never equals a 40-hex sha) and, unlike
# any predicate over arbitrary JSON, proves THIS clear's content is what is on
# origin/main. It is the form dispatch-fleet-alarm's verify_landed() already
# uses.
#
# The tradeoff runs the safe way. A concurrent writer landing a DIFFERENT edit
# to the same node — including graph-commit's own layers-1-3 auto-merge
# resolving this clear against a same-node advance — leaves origin/main holding
# content that is not EXPECT_BLOB, so the check reports not-landed even where
# the park may in fact be gone. That direction is fail-safe and self-healing:
# the caller re-runs, and a re-run over an already-cleared node is the
# idempotent exit-0 no-op above. The forged-success direction is neither.
# (park-node keeps a coarse `.office_hours != null` predicate for a reason
# that does not apply here: graph-commit's own auto-park fallback lands a
# park, which genuinely satisfies park-node's goal. No fallback of
# graph-commit's ever CLEARS a park, so clear-park has nothing to gain from
# the coarse form.)
#
# Repo targeting (strategy-graph-native-dispatch clarification 194, ADOPTED;
# clarification 242 scopes the conversion to validate-graph.ts / write-node.ts /
# dump-node.ts / clear-park): `-C <repo-root>` is REQUIRED and has no default.
# This script used to derive the checkout it read and wrote from SCRIPT_DIR --
# its own on-disk location -- so the tree it touched was a property of WHICH
# COPY of the script ran rather than of what the caller asked for. Callers
# routinely invoke the main checkout's copy by absolute path from inside a
# worktree, and under the old shape that silently retargeted the whole
# read-modify-write at the main checkout. Naming the repo explicitly is the same
# contract graph-commit already carries (clarification 86), and it is the value
# passed straight through to graph-commit's own `-C` below, so the two can no
# longer disagree. SCRIPT_DIR still resolves this script's SIBLINGS (graph-commit,
# verify-landed, src/store.js) -- that is script co-location, not tree targeting.
#
# Usage: clear-park -C <repo-root> [--base <blobsha>|<id>=<blobsha>|<manifest-file>] <node-id> [note]
#
# Exit codes: 0 cleared and landed on main, per verify-landed's blob-pinned
# check (or already-clear no-op); 1 the write or the origin/main refresh failed
# before graph-commit ever ran, OR verify-landed's post-graph-commit check came
# back not-landed or unknown (see the distinct stderr messages at each call
# site — an unknown verdict never claims a rollback happened); 2 usage error
# (including a malformed or unresolvable --base); 3 the supplied --base no
# longer matches origin/main (stale-diagnosis) — nothing was written.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The store implementation this script executes travels WITH the script (a
# sibling of graph-commit and verify-landed, resolved the same way). The tree it
# operates ON comes from the required `-C` below -- see the header note.
STORE_MODULE="$SCRIPT_DIR/../src/store.js"

USAGE="usage: clear-park -C <repo-root> [--base <blobsha>|<id>=<blobsha>|<manifest-file>] <node-id> [note]"

# Leading-flags-only parse: consume the recognized flags (`-C`/`--repo`,
# `--base`) while they lead; the first non-flag argument ends flag parsing and
# every remaining argument is positional VERBATIM (no re-scan for flags —
# <node-id> and <note> are free text that may start with `-`).
BASE_ARG=""
# Flag PRESENCE is tracked separately from the flag's VALUE: an explicitly
# supplied but empty base (`--base ''` / `--base=`) must be a usage error, not
# a silent degradation to an unpinned clear. Gating the resolver on
# `-n "$BASE_ARG"` alone would make that case indistinguishable from omitting
# the flag, quietly dropping the compare-and-swap guarantee the caller asked
# for (.claude/skills/ref-diagnosis-time-cas/SKILL.md).
BASE_SUPPLIED=0
# The repo root is a REQUIRED flag with no fallback (header note). Tracked as a
# raw string here and resolved to an absolute path after the loop, so a
# non-existent path is a usage error rather than a silently-empty REPO_ROOT.
REPO_ARG=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C|--repo)
      shift
      if [[ $# -eq 0 ]]; then
        echo "$USAGE" >&2
        exit 2
      fi
      REPO_ARG="$1"
      shift
      ;;
    --repo=*)
      REPO_ARG="${1#--repo=}"
      shift
      ;;
    --base)
      shift
      if [[ $# -eq 0 ]]; then
        echo "$USAGE" >&2
        exit 2
      fi
      BASE_ARG="$1"
      BASE_SUPPLIED=1
      shift
      ;;
    --base=*)
      BASE_ARG="${1#--base=}"
      BASE_SUPPLIED=1
      shift
      ;;
    --*)
      echo "$USAGE" >&2
      exit 2
      ;;
    *)
      # First non-flag argument: stop flag parsing, take everything verbatim.
      ARGS=("$@")
      break
      ;;
  esac
done

if [[ -z "$REPO_ARG" ]]; then
  echo "clear-park: -C <repo-root> is required and has no default -- name the checkout whose intentions/ store is to be read, mutated and committed. It is passed straight through to graph-commit's own -C, so this script and graph-commit can never target different trees." >&2
  echo "$USAGE" >&2
  exit 2
fi
if ! REPO_ROOT="$(cd "$REPO_ARG" 2>/dev/null && pwd)"; then
  echo "clear-park: -C '$REPO_ARG' is not a directory" >&2
  exit 2
fi
INTENTIONS_DIR="$REPO_ROOT/intentions"
if [[ ! -d "$INTENTIONS_DIR" ]]; then
  echo "clear-park: -C '$REPO_ARG' has no intentions/ directory ($INTENTIONS_DIR) -- that is not an intention-graph checkout" >&2
  exit 2
fi
# -C must be the git TOPLEVEL, not merely some directory that happens to hold an
# intentions/. This script spells the same node file two ways: arg-relative
# ("$INTENTIONS_DIR/$NODE_ID.md", written below, and the `hash-object --` that
# produces EXPECT_BLOB) and repo-root-relative (the `origin/main:intentions/...`
# that `rev-parse` and `show` read, which git resolves from the toplevel and NOT
# from -C). Those two spellings name the same file only when -C IS the toplevel.
# Given a nested -C holding its own intentions/, every check above passes, the
# refresh reads the OUTER store, the write and hash target the INNER one, and
# graph-commit -- which resolves its own toplevel -- stages the outer. --expect
# still fails that closed, but late and confusingly. Reject it here as the usage
# error it is, which is the residue clarification 242's required-`-C` contract
# exists to close.
if ! GIT_TOPLEVEL="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null)"; then
  echo "clear-park: -C '$REPO_ARG' is not inside a git repository -- the store must be committable" >&2
  exit 2
fi
GIT_TOPLEVEL="$(cd "$GIT_TOPLEVEL" && pwd)"
if [[ "$GIT_TOPLEVEL" != "$REPO_ROOT" ]]; then
  echo "clear-park: -C '$REPO_ARG' is not the git toplevel (that is '$GIT_TOPLEVEL') -- pass the checkout root, or this script and graph-commit resolve the same intentions/<id>.md to two different files" >&2
  exit 2
fi

NODE_ID="${ARGS[0]:-}"
# Optional 2nd arg: free-text note folded into the commit message.
NOTE="${ARGS[1]:-}"
if [[ ${#ARGS[@]} -lt 1 || ${#ARGS[@]} -gt 2 || -z "$NODE_ID" ]]; then
  echo "$USAGE" >&2
  exit 2
fi

# The node id is interpolated into a path, a graph-commit --base/--expect pair,
# and (via verify-landed) a landing check, so it is validated in FULL here — the
# same charset verify-landed enforces. src/store.ts's assertPathSafeId rejects
# only `/`, `\`, `.` and `..`, which leaves `@`, `#` and whitespace legal
# upstream; this is the gate that keeps such an id from reaching a downstream
# parser at all.
if [[ ! "$NODE_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "clear-park: malformed node id '$NODE_ID' — ids must match ^[A-Za-z0-9._-]+\$" >&2
  exit 2
fi

# Resolve --base (if supplied) to a 40-hex blob sha, before any network call,
# so a malformed base is a cheap usage error rather than a mid-flight failure.
# Shared with park-node via lib-base-pin.sh (see that file for the full
# branch-by-branch description); resolve_base_pin exits 2 itself on any usage
# error, using "clear-park:" as the message prefix.
# The source is checked: this script runs under `set -uo pipefail` with no
# `-e`, so an unchecked `source` of a missing file would print an ENOENT, carry
# on past an ignored `resolve_base_pin: command not found`, do the origin/main
# fetch and refresh, and only die at the `-n "$PINNED_BASE"` compare below with
# an opaque `unbound variable` — turning the cheap pre-network usage error this
# block promises into a mid-flight failure. A missing sibling is a real case:
# every harness that clones these scripts must copy lib-base-pin.sh too.
source "$SCRIPT_DIR/lib-base-pin.sh" || {
  echo "clear-park: could not source $SCRIPT_DIR/lib-base-pin.sh — the --base pin resolver is missing from this checkout; nothing was written" >&2
  exit 1
}
resolve_base_pin "clear-park" "$NODE_ID"

TMPTS="$(mktemp --suffix=.mts)" \
  || { echo "clear-park: could not create temp file for the clearing write" >&2; exit 1; }
# TMPORIG holds the node file exactly as this script found it, captured BEFORE
# the origin/main refresh below overwrites it. Every non-landing exit path
# restores from it (restore_node), so a failed or idempotent invocation leaves
# `git status --porcelain intentions/` as it was.
TMPORIG="$(mktemp)" \
  || { echo "clear-park: could not create temp file for the pre-refresh node copy" >&2; exit 1; }
ORIG_EXISTED=0
if [[ -f "$INTENTIONS_DIR/$NODE_ID.md" ]]; then
  if ! cp "$INTENTIONS_DIR/$NODE_ID.md" "$TMPORIG"; then
    echo "clear-park: could not capture the pre-refresh copy of intentions/$NODE_ID.md" >&2
    rm -f "$TMPTS" "$TMPORIG"
    exit 1
  fi
  ORIG_EXISTED=1
fi

# restore_node — put intentions/$NODE_ID.md back to its pre-refresh state.
# Copies to a temp sibling and mv's into place only on success, so a failed copy
# never truncates the node file to zero bytes. When the file did not exist
# before (a worktree branch predating the node), the restore is a delete.
restore_node() {
  if [[ "$ORIG_EXISTED" == 1 ]]; then
    if cp "$TMPORIG" "$INTENTIONS_DIR/$NODE_ID.md.rollback"; then
      mv "$INTENTIONS_DIR/$NODE_ID.md.rollback" "$INTENTIONS_DIR/$NODE_ID.md"
    else
      rm -f "$INTENTIONS_DIR/$NODE_ID.md.rollback"
    fi
  else
    rm -f "$INTENTIONS_DIR/$NODE_ID.md"
  fi
}

# MUTATED gates the rollback: only restore if this script actually wrote to the
# node file (the refresh below is the first such write). A pre-mutation failure
# — the fetch or the origin/main blob lookup — must not restore a file this
# script never touched.
MUTATED=0
trap '
  rc=$?
  if [[ "$MUTATED" == 1 && $rc -ne 0 ]]; then
    restore_node
  fi
  rm -f "$TMPTS" "$TMPORIG"
' EXIT

# Refresh the LOCAL node file from origin/main BEFORE reading it, so the
# office_hours clear lands on top of the current landed content rather than a
# stale worktree copy. An unreachable origin/main or a node absent from
# origin/main is genuine environment breakage — fail with a clear error, never
# fall back to the local copy (code-style.md).
if ! git -C "$REPO_ROOT" fetch origin main >&2; then
  echo "clear-park: could not fetch origin/main to refresh $NODE_ID before clearing" >&2
  exit 1
fi
if ! FRESH_BLOB="$(git -C "$REPO_ROOT" rev-parse "origin/main:intentions/$NODE_ID.md" 2>/dev/null)"; then
  echo "clear-park: intentions/$NODE_ID.md does not exist on origin/main — cannot clear a park on a node that is not landed" >&2
  exit 1
fi

# The pin check runs before ANY mutation — before the local-file overwrite
# below and before MUTATED is set to 1. The temp files and the EXIT trap
# already exist at this point (mktemp'd above, before the fetch), but the
# trap's restore is a no-op while MUTATED is still 0, and the node file itself
# has not been touched, so a stale pin has zero side effects to roll back.
if [[ -n "$PINNED_BASE" && "$PINNED_BASE" != "$FRESH_BLOB" ]]; then
  echo "clear-park: stale-diagnosis — intentions/$NODE_ID.md on origin/main is now $FRESH_BLOB but the pinned --base is $PINNED_BASE; the node changed between diagnosis and execution. Re-read the node, re-decide the disposition, and retry with a freshly captured base. Nothing was written." >&2
  exit 3
fi

MUTATED=1
if ! git -C "$REPO_ROOT" show "origin/main:intentions/$NODE_ID.md" > "$INTENTIONS_DIR/$NODE_ID.md"; then
  echo "clear-park: could not refresh intentions/$NODE_ID.md from origin/main" >&2
  exit 1
fi

cat >"$TMPTS" <<'TS'
// argv: <storeModule> <intentionsDir> <id>
const [storePath, intentionsDir, id] = process.argv.slice(2);
const { readNode, writeNode } = await import(storePath);
const node = readNode(intentionsDir, id);
if (node.office_hours == null) {
  process.stderr.write(`clear-park: ${id} is not parked (office_hours already null)\n`);
  process.exit(3);
}
node.office_hours = null;
writeNode(intentionsDir, node);
process.stderr.write(`clear-park: cleared office_hours on ${id}\n`);
TS

npx_status=0
(cd "$REPO_ROOT" && npx tsx "$TMPTS" "$STORE_MODULE" "$INTENTIONS_DIR" "$NODE_ID" >&2) || npx_status=$?

if [[ $npx_status -eq 3 ]]; then
  # Idempotent no-op: nothing lands, so undo the refresh's overwrite before
  # exiting 0. The EXIT trap only restores on a non-zero rc, so restore here
  # explicitly and clear MUTATED so it is not attempted twice.
  restore_node
  MUTATED=0
  echo "clear-park: $NODE_ID is not parked (office_hours already null); nothing to do" >&2
  exit 0
elif [[ $npx_status -ne 0 ]]; then
  echo "clear-park: failed to clear the office_hours record for $NODE_ID" >&2
  exit 1
fi

# EXPECT_BLOB captures the blob this script just wrote to intentions/$NODE_ID.md
# under its OWN REPO_ROOT. It serves twice: as graph-commit's --expect guard
# below, and as the verify-landed spec that decides this script's exit status
# (see the "Landing signal" header note). Hashing failure is genuine
# environment breakage — fail loudly rather than omitting --expect and
# degrading the landing check to a predicate an absent node can satisfy
# (code-style.md).
if ! EXPECT_BLOB="$(git -C "$REPO_ROOT" hash-object -- "intentions/$NODE_ID.md" 2>/dev/null)"; then
  echo "clear-park: could not hash intentions/$NODE_ID.md after the office_hours clear" >&2
  exit 1
fi

if [[ -n "$NOTE" ]]; then
  MESSAGE="graph: clear office_hours park on $NODE_ID ($NOTE)"
else
  MESSAGE="graph: clear office_hours park on $NODE_ID"
fi

# -C "$REPO_ROOT" is mandatory, not cosmetic. REPO_ROOT is this script's own
# required -C argument (header note), and every write above -- the origin/main
# refresh and the office_hours clear -- targets "$INTENTIONS_DIR" under THAT
# repo. graph-commit resolves its repo from -C if given, else from cwd, so
# forwarding the same value is what keeps the two from ever disagreeing: without
# it the edit is written to the named repo while graph-commit inspects the
# caller's cwd repo, finds nothing staged for the id and its HEAD blob equal to
# origin/main, takes the benign "no new changes to stage" branch, and prints
# "landed ... on main" / exits 0 having committed nothing -- leaving the real
# edit dirty and unpushed in the other checkout. Mirrors park-node, which already
# passes -C for the same reason (park-node still derives its own root from
# SCRIPT_DIR; clarification 242 scopes this conversion to clear-park).
#
# --expect does NOT add a second, independent check on -C from this call site:
# EXPECT_BLOB is hashed under the same "$REPO_ROOT" that is passed as -C, so
# the assertion is self-satisfying whenever -C resolves to the tree this script
# wrote. What it buys here is narrower: it asserts graph-commit's
# `git rev-parse --show-toplevel` resolution of -C lands on the same tree this
# script wrote to (they can differ if REPO_ROOT is not itself a git toplevel),
# and it guards against a concurrent writer touching intentions/$NODE_ID.md
# between the hash above and graph-commit's staging. See park-node's fuller
# note at the same call site.
GC_RC=0
"$SCRIPT_DIR/graph-commit" -C "$REPO_ROOT" --base "$NODE_ID=$FRESH_BLOB" --expect "$NODE_ID=$EXPECT_BLOB" -m "$MESSAGE" "$NODE_ID" || GC_RC=$?

# graph-commit's rc is discarded as the landing signal (see the header note).
# Ask verify-landed directly, unconditionally — including when GC_RC is 0 —
# because a reported success is exactly as untrustworthy as a reported
# failure until origin/main itself confirms it.
#
# The spec is blob mode pinned to EXPECT_BLOB — the bytes this run wrote —
# never `--jq '.office_hours == null'`: an absent node reaches a jq filter as
# the literal `null`, satisfies that predicate, and would forge a `landed`
# verdict over a node that is not on origin/main at all. See the "Landing
# signal" header note.
VL_OUT="$("$SCRIPT_DIR/verify-landed" -C "$REPO_ROOT" --node "$NODE_ID" --blob "$EXPECT_BLOB" 2>&1)"; VL_RC=$?
echo "$VL_OUT" >&2

case "$VL_RC" in
  0)
    # Landed, per origin/main itself, regardless of graph-commit's own exit
    # code. The clear is really there — restoring the pre-clear local copy
    # over it (the EXIT trap's job on a non-zero rc) would silently look like
    # an undo of a landed clear, so make MUTATED=0 so the trap declines.
    MUTATED=0
    exit 0
    ;;
  4)
    echo "clear-park: office_hours clear for $NODE_ID did NOT land on origin/main (graph-commit exit=$GC_RC, verify-landed verdict=not-landed) — origin/main:intentions/$NODE_ID.md is not the blob $EXPECT_BLOB this run wrote: it is absent, still parked, or holds another writer's content. The node stays parked as far as this script can prove; re-read it from origin/main and retry." >&2
    exit 1
    ;;
  *)
    echo "clear-park: could not determine whether the office_hours clear for $NODE_ID landed on origin/main (graph-commit exit=$GC_RC, verify-landed verdict=unknown) — re-read $NODE_ID from origin/main before any retry; this is NOT a confirmed rollback, only an unresolved check" >&2
    exit 1
    ;;
esac
