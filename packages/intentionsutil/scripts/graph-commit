#!/usr/bin/env bash
#
# graph-commit — the single write primitive that lands one or more intention
# node edits on `main`.
#
# Every graph writer (skills, router, reconciler, sensors) writes a node's
# content first via `packages/intentionsutil/scripts/write-node.ts` (the single
# validation gate), then calls this script with the node id(s). graph-commit
# never authors node content itself (except the office_hours parking fallback
# below, which goes through store.ts's writeNode, not raw text): it stages
# exactly `intentions/<id>.md` for each id, commits, stamps the commit's SHA
# with the four required checks via a throwaway `graph/**` scratch branch, and
# fast-forwards that SHA onto `main` directly (no PR) with a bounded
# rebase-retry loop.
#
# Why the stamp step is required: `main`'s branch-protection ruleset requires
# four status checks (`acceptance`, `preview-and-smoke`, `lint`, `unit-tests`)
# to already be green ON THE EXACT SHA before it will accept a push of that SHA
# — checks attach to the SHA, not the branch. A brand-new local commit has zero
# check runs, so `git push origin HEAD:main` on it is deterministically
# rejected. The repo's `graph/**` CI fast path
# (.github/workflows/graph-fast-path.yml) is what stamps those four checks on an
# intentions/-only SHA: pushing the commit to a `graph/**` branch triggers it
# (~30-60s), after which the SAME SHA can be fast-forwarded onto `main`. So each
# attempt of the push loop runs:
#   commit → pull --rebase origin main → push HEAD:graph/<id>-<pid> →
#   poll the four checks green on the SHA → push <sha>:main.
# The scratch branch is throwaway (this process owns it, force-pushes it across
# retries, and deletes it on every exit path).
#
# Usage:
#   graph-commit [-C <repo-path>] [-m <message>] [--prune <id>]... [--base <id>=<blobsha>|<manifest-file>]... [--expect <id>=<blobsha>|<manifest-file>]... <node-id> [<node-id> ...]
#   graph-commit -m 'graph: seed dispatch state' tactic-graph-commit
#   graph-commit -C /path/to/worktree -m 'graph: land edit' tactic-foo
#
# -C <path> (alias --repo <path>): the checkout whose intentions/ this
#   invocation commits. The repo root is resolved from this path (else cwd) via
#   `git rev-parse --show-toplevel` — NEVER from this script's own on-disk
#   location. `-C` is the canonical spelling; pass it when graph-commit is not
#   run from inside the target repo (e.g. invoked by absolute path from a worktree).
#   graph-commit -m 'graph: prune done tactics' --prune tactic-foo --prune tactic-bar
#   graph-commit --base tactic-foo=3f1a9c... tactic-foo
#
# --prune <id> (repeatable, mixable with ordinary positional ids): land a
#   deletion. The caller must have already deleted intentions/<id>.md on disk;
#   the existence guard inverts (file absent on disk, present in HEAD).
#
# --base <id>=<blobsha> (repeatable) or --base <manifest-file> (one <id>=<sha>
#   pair per line): optional compare-and-swap freshness check. If any entry's
#   blob no longer matches origin/main after a fetch, the write is refused
#   before any local commit is made. Omit entirely to keep pre-CAS behavior.
#
# --expect <id>=<blobsha> (repeatable) or --expect <manifest-file> (one
#   <id>=<sha> pair per line): optional wrong-repo assertion. The sha is the
#   blob of the content the caller WROTE — `git hash-object -- intentions/<id>.md`
#   run in the caller's OWN checkout after its edit. Before any tree mutation,
#   graph-commit hashes the same path in the repo it resolved (-C/--repo, else
#   cwd) and refuses to land on a mismatch.
#
#   --base and --expect assert different things and are not interchangeable:
#   --base asserts the PRE-edit blob against origin/main (a freshness /
#   compare-and-swap check about concurrent writers), while --expect asserts the
#   POST-edit blob against the resolved checkout (a targeting check about WHICH
#   repo this invocation is committing). Only --expect can catch a wrong-repo
#   invocation whose blob happens to equal origin/main: the nothing-staged guard
#   below only fires when the wrong repo's blob DIFFERS from origin/main, so a
#   wrong repo that is merely in sync with origin/main slips through it and
#   reports a false "landed" while the caller's real edit sits dirty elsewhere.
#   Omit entirely to keep pre-assertion behavior.
#
# Exit status — four observable outcomes across rc 0 and rc 1:
#   0  the edit landed on main. Two sub-cases, distinguished only by a log line
#      (same exit code):
#        landed                 — no concurrent-edit divergence; no special log.
#        landed-after-resolution — a concurrent-edit divergence was auto-merged
#          by layer 2 (rebase-conflict field merge) or layer 3 (stale --base
#          re-read), then landed. The final log line carries the
#          "(layer 2/3 auto-resolved a concurrent-edit divergence)" suffix.
#   1  push could not land. Two distinct rc-1 sub-cases:
#        busy-main — busy main after all attempts, the required checks never
#          stamped green within the poll window, a required check CONCLUDED
#          non-success (deterministic content failure — no retry), or check-run
#          polling itself failed 3 consecutive times (gh auth/rate-limit/network,
#          surfaced verbatim). NO park is written in this case.
#        mechanical-unresolved-parked — a concurrent-edit CONFLICT that layers
#          1-3 could not auto-merge. Fails closed: this writer's content is NOT
#          landed (no automatic overwrite of the other writer's already-landed
#          edit); the node is parked via office_hours on top of fresh
#          origin/main and this writer's unlanded content is preserved on disk
#          for a manual merge. When the park carries field-level divergence
#          detail, office_hours.reason contains the stable marker
#          "mechanical-unresolved" and office_hours.recommendation holds a
#          per-diverged-field breakdown; a park with no captured field detail
#          keeps the plain "concurrent-edit conflict — manual merge needed"
#          reason and no recommendation.
#   2  usage error.
#
# Conventions: mirrors the bounded-retry shape/logging of `gh_retry` in
# .claude/skills/dispatch-propagate/scripts/lib.sh. Per .claude/rules/code-style.md
# it prefers clear errors over silent fallbacks. Per .claude/rules/shell-json.md
# it never pipes a captured variable through `echo` into `jq` — it uses
# `gh api ... --jq` (gh runs jq on its in-memory JSON) for check-run polling.

set -euo pipefail

# --- Paths -----------------------------------------------------------------
# SCRIPT_DIR locates this script's SIBLING scripts/modules on disk — store.js
# (the parking fallback's tsx import) and merge-node.ts (the layer-2 auto-merge
# CLI). Those always live alongside the installed script, so they are resolved
# from SCRIPT_DIR regardless of which checkout the caller is committing.
#
# REPO_ROOT — the checkout whose intentions/ this invocation commits — is
# deliberately NOT derived from SCRIPT_DIR. It is resolved from the CALLER (the
# -C/--repo argument, else cwd) inside main() via `git rev-parse --show-toplevel`
# so graph-commit always commits the caller's checkout, never the checkout this
# script file happens to live in. Deriving it from the script's own location was
# the incident bug: a ../../../-climbing relative invocation from inside a
# worktree resolved to the PRIMARY checkout's copy of this script, silently
# committed the primary checkout, and printed a false "landed" success.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# store.ts is imported by the parking fallback via tsx (.js → .ts resolution).
STORE_MODULE="$SCRIPT_DIR/../src/store.js"
# merge-node.ts is the layer-2 field-level auto-merge CLI (run_merge_node()).
MERGE_NODE_SCRIPT="$SCRIPT_DIR/merge-node.ts"
# REPO_ROOT / INTENTIONS_DIR are caller-derived and set inside main() AFTER
# option parsing (they depend on the parsed -C/--repo argument, so they cannot
# be top-of-file constants resolved before main() runs).

# Total commit → rebase → stamp → push attempts before a pure (conflict-free)
# rejection is declared a busy-main failure. Overridable for tests.
MAX_PUSH_ATTEMPTS="${GRAPH_COMMIT_MAX_ATTEMPTS:-5}"

# Fast-path check-run polling: how often to poll and how long to wait for the
# four required contexts to stamp green on a scratch SHA before treating this
# attempt as failed (and rebasing/retrying). Overridable for tests.
CHECK_POLL_SECONDS="${GRAPH_COMMIT_CHECK_POLL_SECONDS:-7}"
CHECK_TIMEOUT_SECONDS="${GRAPH_COMMIT_CHECK_TIMEOUT_SECONDS:-180}"

# Landing-lock tunables (see "# --- Landing lock" below). LOCK_REF is a fixed
# constant, not overridable. LOCK_TTL_SECONDS is how long a claim stays live
# before a waiter may steal it — one full check-stamp window plus a margin
# (default 240s). LOCK_POLL_SECONDS is the poll interval while waiting on a live
# foreign holder. LOCK_WAIT_SECONDS bounds the total time a writer waits to
# acquire before giving up (default 1050s = MAX_PUSH_ATTEMPTS full attempts).
LOCK_REF="refs/graph/landing-lock"
LOCK_TTL_SECONDS="${GRAPH_COMMIT_LOCK_TTL_SECONDS:-$((CHECK_TIMEOUT_SECONDS + 60))}"
LOCK_POLL_SECONDS="${GRAPH_COMMIT_LOCK_POLL_SECONDS:-5}"
LOCK_WAIT_SECONDS="${GRAPH_COMMIT_LOCK_WAIT_SECONDS:-$((MAX_PUSH_ATTEMPTS * (CHECK_TIMEOUT_SECONDS + 30)))}"

# --- Globals set by main() -------------------------------------------------
# IDS         — the node ids to commit (positional args) — ordinary edits whose
#               new content already exists on disk.
# PRUNE_IDS   — ids passed via --prune: tracked in HEAD, must NOT exist on
#               disk; staging them stages a deletion.
# ALL_IDS     — IDS + PRUNE_IDS, computed once in main() after validation.
#               Every helper that needs "every id in this invocation"
#               regardless of edit-vs-prune iterates this, not IDS directly.
# BASE        — optional --base compare-and-swap manifest: node id -> the blob
#               SHA the caller read it at (git hash-object at read time).
#               Empty unless --base was passed; empty means skip the check.
# EXPECT_BLOB — optional --expect assertion manifest: node id -> the blob SHA of
#               the content the caller WROTE (git hash-object after its edit).
#               Empty unless --expect was passed.
# EXPECTED    — associative set of the exact staged paths we permit.
# SNAP_DIR    — tempdir holding the on-disk node content we are trying to land.
# KEEP_SNAP   — 1 when SNAP_DIR must survive exit (the fail-closed conflict
#               path discards the writer's local commit, so the snapshot is the
#               only remaining copy of the writer's content).
# CURRENT_MSG — the commit message commit_files() commits with.
declare -a IDS=()
declare -a PRUNE_IDS=()
declare -a ALL_IDS=()
declare -A BASE=()
declare -A EXPECT_BLOB=()
declare -A EXPECTED=()
SNAP_DIR=""
KEEP_SNAP=0
CURRENT_MSG=""
# SCRATCH_BRANCH — the throwaway `graph/**` branch name used to stamp SHAs.
# SCRATCH_PUSHED — 1 once we have pushed it at least once, so cleanup() knows to
#                  delete it on the remote on exit.
SCRATCH_BRANCH=""
SCRATCH_PUSHED=0
# Landing-lock globals (see "# --- Landing lock" below).
# LOCK_HOLDER_ID    — this process's unique claim identity, computed once at
#                     script load: short hostname + PID + two $RANDOM draws.
# LOCK_SHA          — the SHA of the lock commit this process currently believes
#                     it owns (set when a claim/renew/steal push succeeds).
# LOCK_HELD         — 1 iff this process currently holds the lock.
# LOCK_WAIT_DEADLINE — absolute unix-epoch deadline for lock_claim_or_renew() to
#                     give up; set once per try_land() invocation by its caller
#                     (a later unit), not here.
LOCK_HOLDER_ID="${GRAPH_COMMIT_LOCK_HOLDER_ID:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)-$$-$RANDOM$RANDOM}"
LOCK_SHA=""
LOCK_HELD=0
LOCK_WAIT_DEADLINE=0
# ORIG_HEAD / RESTORE_HEAD — set by ensure_intentions_only_base() when the
# worktree HEAD is a far-ahead branch (a PR-branch checkout carrying commits
# that touch non-intentions/ files). To land an intentions/-only SHA the write
# is rebuilt on top of origin/main, which moves the worktree off its original
# HEAD; cleanup() restores ORIG_HEAD on every exit path so the worktree returns
# to its PR tip. Empty/0 for the common case (main checkout or a clean/
# intentions-only worktree), where the in-place path is used unchanged.
ORIG_HEAD=""
RESTORE_HEAD=0
# RESOLVED_VIA_MERGE — set to 1 the moment any layer-2 (structural field-level
# merge, run_merge_node()) or later layer-3 auto-merge actually resolves a
# concurrent-edit divergence. Read once at the final "landed" log line to append
# a distinct suffix; this is the SAME rc-0 landed exit as a plain landed
# outcome, distinguished only by the log message — no new exit code.
RESOLVED_VIA_MERGE=0
# CONFLICT_FIELDS_JSON — path to a tempfile (created inside SNAP_DIR the first
# time it is needed) holding a JSON ARRAY of unresolved-field objects
# accumulated across every id this invocation could not fully resolve
# (shape: {"id","field","ours","theirs"} for a real field conflict, or a
# {"id","note"} sentinel for a crash / prune-vs-edit). Empty string means the
# file has not been created yet (no captured conflicts). Appends read-modify-
# rewrite via jq so the file stays valid JSON throughout (a pushable array, not
# JSONL). Unit 3/4 also read/write it.
CONFLICT_FIELDS_JSON=""

die() {
  echo "error: graph-commit: $*" >&2
  exit 1
}

usage() {
  echo "usage: graph-commit [-C <repo-path>] [-m <message>] [--prune <id>]... [--base <id>=<blobsha>|<manifest-file>]... [--expect <id>=<blobsha>|<manifest-file>]... <node-id> [<node-id> ...]" >&2
}

# --- Prune / base id helpers -------------------------------------------------
# Shared character/traversal validation for both ordinary and --prune ids.
validate_id_chars() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "error: graph-commit: empty node id" >&2; exit 2
  fi
  # Reject path separators, and `.`/`..` as EXACT ids. `..` as a substring
  # cannot traverse once `/` and `\` are banned (the id is only ever used as
  # the single path component intentions/<id>.md), so ids like
  # `v1..v2-migration` are legal.
  case "$id" in
    */*|*'\'*)
      echo "error: graph-commit: invalid node id '$id' (path separators not allowed)" >&2
      exit 2 ;;
    .|..)
      echo "error: graph-commit: invalid node id '$id' ('.' and '..' are reserved path names)" >&2
      exit 2 ;;
  esac
}

# Record one <id>=<blobsha> pair into the named associative array (BASE for
# --base, EXPECT_BLOB for --expect). The target array is passed BY NAME and
# bound with a bash nameref (requires bash 4.3; the script already requires
# bash 4 for `declare -A`), so --base and --expect share one parser instead of
# maintaining two copies that can drift.
add_blob_pair() { # <array-name> <flag-name> <pair>
  local -n _target="$1"
  local flag="$2" pair="$3" id sha
  id="${pair%%=*}"
  sha="${pair#*=}"
  if [[ -z "$id" || "$id" == "$pair" || -z "$sha" ]]; then
    die "invalid $flag entry '$pair' (expected <id>=<blobsha>)"
  fi
  _target["$id"]="$sha"
}

# A --base/--expect argument is either a literal <id>=<blobsha> pair or, when it
# names an existing file, a manifest of such pairs (one per line, blank lines
# ignored) — so a caller holding a whole dump's worth of blob shas can pass one
# flag instead of one flag per node.
parse_blob_arg() { # <array-name> <flag-name> <arg>
  local arr="$1" flag="$2" arg="$3"
  if [[ -f "$arg" ]]; then
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" ]] && continue
      add_blob_pair "$arr" "$flag" "$line"
    done <"$arg"
  else
    add_blob_pair "$arr" "$flag" "$arg"
  fi
}

# --- Wrong-repo assertion (--expect) ----------------------------------------
# Assert that the repo this invocation RESOLVED actually holds the content the
# caller wrote. The caller computes `git hash-object -- intentions/<id>.md` in
# its OWN checkout after its edit and passes it as --expect <id>=<sha>; here we
# hash the same path in REPO_ROOT and compare.
#
# Why this exists on top of the nothing-staged guard in main(): that guard only
# fires when the wrongly-targeted repo's blob DIFFERS from origin/main. When the
# wrong repo happens to be in sync with origin/main — the common case for an
# idle checkout — both blobs are equal, the guard passes, and graph-commit
# reports a false "landed" while the caller's real edit sits dirty in a
# different checkout. --expect closes that hole because it asserts the caller's
# POST-edit content, independent of any pre-edit or origin/main state.
#
# Ordering is load-bearing: this must run before check_base_freshness (layer 3's
# auto-merge overwrites $INTENTIONS_DIR/$id.md on disk) and before
# ensure_intentions_only_base (which can `git reset --hard` the tree). Later
# would hash content graph-commit itself rewrote, not the caller's.
#
# Opt-in: no --expect means no behavior change for existing callers.
assert_expected_content() {
  [[ "${#EXPECT_BLOB[@]}" -eq 0 ]] && return 0
  local id
  # Pass 1 — validation. A --prune is a deletion: there is no content to
  # assert, so pinning one is a usage error (exit 2, like the other argument
  # validators; die() would exit 1). Keys naming neither an ordinary id nor a
  # prune id are ignored, matching --base manifest semantics where one batch
  # manifest may cover more nodes than a given invocation commits.
  for id in "${!EXPECT_BLOB[@]}"; do
    if is_prune_id "$id"; then
      echo "error: graph-commit: --expect $id=... names a --prune id — a deletion has no content to assert" >&2
      exit 2
    fi
  done
  # Pass 2 — assertion over the ordinary edit ids only. main() has already
  # cd'd to REPO_ROOT, so the repo-relative path is correct.
  local sha actual
  for id in "${IDS[@]}"; do
    sha="${EXPECT_BLOB[$id]:-}"
    [[ -z "$sha" ]] && continue
    actual="$(git hash-object -- "intentions/$id.md")" \
      || die "could not hash intentions/$id.md in the resolved repo ($REPO_ROOT)"
    if [[ "$actual" != "$sha" ]]; then
      die "the resolved repo ($REPO_ROOT) does not hold the content the caller asserted for intentions/$id.md (--expect $sha, on disk $actual) — the edit was made in a DIFFERENT checkout: mis-pointed -C/--repo (or cwd targeting the wrong checkout). Refusing to land."
    fi
  done
}

# Reconcile each --base entry against origin/main after a fetch. If an entry's
# blob no longer matches origin/main, a concurrent writer landed an edit to the
# same node since this writer read it. Rather than refusing outright (the old
# behavior — a hard die), attempt a structural three-way merge of the writer's
# intended edit against the freshly-landed content (layer 3), using the same
# run_merge_node() primitive as the rebase-conflict path. There is no git
# rebase-stage inversion here — these are plain file reads, so base/ours/theirs
# map directly: base = the blob the writer read (BASE[$id]), ours = the writer's
# current on-disk edit, theirs = origin/main's landed content (FETCH_HEAD:path).
# A fully-merged node is rewritten on disk so the normal commit+land flow
# proceeds against the fresh origin/main content. A divergence run_merge_node
# cannot resolve is recorded (CONFLICT_FIELDS_JSON); after every entry is
# checked, an unresolved divergence parks the node(s) via park_and_exit() — the
# same structured park an unresolvable rebase conflict takes. This requires
# SNAP_DIR and the EXIT trap to already exist, so main() now sets them BEFORE
# calling this. The 2026-07-06 near-miss motivated the check: a stale dump of a
# live node avoided a textual conflict and nearly clobbered concurrent state.
# Sessions that pass no --base see no change in behavior (opt-in, per
# code-style.md: clear error over a silent fallback).
check_base_freshness() {
  [[ "${#BASE[@]}" -eq 0 ]] && return 0
  echo "graph-commit: checking --base freshness for ${#BASE[@]} node(s) against origin/main" >&2
  git fetch origin main >&2
  local id sha origin_sha path STALE_BASE_UNRESOLVED=0
  for id in "${!BASE[@]}"; do
    sha="${BASE[$id]}"
    path="intentions/$id.md"
    if git cat-file -e "FETCH_HEAD:$path" 2>/dev/null; then
      origin_sha="$(git rev-parse "FETCH_HEAD:$path")"
    else
      origin_sha="<absent>"
    fi
    [[ "$origin_sha" == "$sha" ]] && continue

    # origin/main's copy of this node diverged from the blob the writer read.
    # Attempt a structural three-way merge instead of refusing. base/ours/theirs
    # map directly to plain file reads (no rebase-stage inversion):
    #   base   = the blob the writer originally read (BASE[$id])
    #   ours   = the writer's current intended content (on disk, pre-snapshot)
    #   theirs = origin/main's freshly-landed content (FETCH_HEAD:$path), or the
    #            empty string when the node is now absent on origin/main.
    local base_f theirs_f out_f
    base_f="$SNAP_DIR/.base-merge-$id.base"
    out_f="$SNAP_DIR/.base-merge-$id.out"
    if ! git cat-file -p "$sha" >"$base_f" 2>/dev/null; then
      die "base blob $sha for '$id' is unreadable in the local object database — cannot attempt automatic reconciliation of the stale base"
    fi
    if [[ "$origin_sha" == "<absent>" ]]; then
      theirs_f=""
    else
      theirs_f="$SNAP_DIR/.base-merge-$id.theirs"
      git show "FETCH_HEAD:$path" >"$theirs_f"
    fi
    if run_merge_node "$id" "$base_f" "$INTENTIONS_DIR/$id.md" "$theirs_f" "$out_f"; then
      # Fully resolved: overwrite the on-disk node with the merged content so the
      # write proceeds against exactly origin_sha. RESOLVED_VIA_MERGE is already
      # set to 1 by run_merge_node().
      cp -- "$out_f" "$INTENTIONS_DIR/$id.md"
      continue
    fi
    # run_merge_node() already appended the unresolved fields to
    # CONFLICT_FIELDS_JSON. Record the divergence but keep checking every
    # remaining --base id so the eventual park names them all.
    STALE_BASE_UNRESOLVED=1
  done

  if [[ "${STALE_BASE_UNRESOLVED:-0}" -eq 1 ]]; then
    park_and_exit   # Unit 2's extracted fail-closed park — never returns
  fi
}

# --- Cleanup (EXIT trap) ---------------------------------------------------
# Remove the snapshot tempdir and delete the throwaway `graph/**` scratch branch
# on the remote. Runs on every exit path (success, busy-main, parking fallback,
# or an unexpected die). The remote delete is best-effort — a leftover scratch
# branch is harmless and would be overwritten by the next same-PID run — so its
# failure never masks the real exit status.
cleanup() {
  local rc=$?
  # Restore the original (far-ahead) HEAD if ensure_intentions_only_base() moved
  # the worktree onto origin/main to land an intentions/-only SHA. The intended
  # edit is already on main by this point (or failed to land); either way the
  # worktree returns to the PR tip it started on. Best-effort — a restore
  # failure must not mask the real exit status, and origin/<branch> still holds
  # the tip regardless.
  if [[ "$RESTORE_HEAD" -eq 1 && -n "$ORIG_HEAD" ]]; then
    git reset --hard "$ORIG_HEAD" >&2 || true
  fi
  if [[ -n "$SNAP_DIR" && "$KEEP_SNAP" -eq 0 ]]; then
    rm -rf "$SNAP_DIR"
  fi
  if [[ "$SCRATCH_PUSHED" -eq 1 && -n "$SCRATCH_BRANCH" ]]; then
    git push origin --delete "$SCRATCH_BRANCH" >&2 || true
  fi
  # Best-effort backstop: in the common paths try_land() already released the
  # lock and reset LOCK_HELD=0, so this is a no-op there. It only does real
  # work when the script dies before reaching try_land()'s own release calls
  # (the two die() paths, or any other unexpected die()).
  if [[ "$LOCK_HELD" -eq 1 ]]; then
    lock_release
  fi
  return "$rc"
}

# --- Guard -----------------------------------------------------------------
# Defense in depth: assert the staged set is a SUBSET of the requested
# intentions/<id>.md paths — nothing outside intentions/, and no node file
# other than the ones named on the command line. Its one job is to catch a
# stray or cross-contaminated staged path; it does NOT decide whether there is
# anything to commit. An empty staged set is tolerated here (returns cleanly) —
# main() gates commit_files() behind id_files_dirty(), so this guard is
# only reached when there is genuinely something to stage. Treating "empty" as
# an error here was the bug that broke idempotent re-invocation after a partial
# failure (a local commit that never pushed left the tree clean, so the re-run's
# `git add` staged nothing and this guard wrongly diagnosed "already at the
# desired state" instead of "already committed, still needs to push").
assert_staged_safe() {
  local staged
  staged="$(git diff --cached --name-only)"
  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ -z "${EXPECTED[$path]:-}" ]]; then
      echo "error: graph-commit: refusing to commit — staged path outside the requested node set: '$path'" >&2
      echo "       graph-commit stages exactly intentions/<id>.md for the given ids; nothing else." >&2
      exit 1
    fi
  done <<<"$staged"
}

# --- Snapshot ----------------------------------------------------------------
# The desired on-disk content of each node (written by write-node.ts) is
# captured to SNAP_DIR before landing. On the fail-closed conflict path the
# writer's local conflicting commit is discarded (reset --hard to fresh
# origin/main), so this snapshot becomes the only surviving copy of the
# writer's content — cleanup() keeps SNAP_DIR on that path (KEEP_SNAP=1) and
# the park message points at it for the manual merge.
snapshot() {
  local id
  for id in "${IDS[@]}"; do
    cp -- "$INTENTIONS_DIR/$id.md" "$SNAP_DIR/$id.md"
  done
  # PRUNE_IDS are deliberately skipped: a prune id has no on-disk file to
  # copy, and there is no writer-authored content to preserve for it — the
  # deletion is fully recorded by the commit that lands (or fails to land).
}

# --- Layer-2 conflict accumulation ------------------------------------------
# CONFLICT_FIELDS_JSON holds a JSON ARRAY of unresolved-field objects (see the
# globals block). We keep it a valid JSON array throughout — appending is a
# read-modify-rewrite via jq, not a JSONL append — so any later reader (Unit
# 3/4) can `jq` it directly. The file lives inside SNAP_DIR, which exists for
# the lifetime of any run that reaches try_land().

# Lazily create the accumulator file as an empty array the first time it's used.
init_conflict_fields() {
  if [[ -z "$CONFLICT_FIELDS_JSON" ]]; then
    CONFLICT_FIELDS_JSON="$SNAP_DIR/conflict-fields.json"
    printf '[]' >"$CONFLICT_FIELDS_JSON"
  fi
}

# Append a JSON array of objects (compact JSON passed on $1) onto
# CONFLICT_FIELDS_JSON, rewriting the whole file so it stays a valid array.
append_conflicts() {
  local arr="$1" tmp
  init_conflict_fields
  tmp="$(mktemp "$SNAP_DIR/.cf.XXXXXX")" || die "could not create temp file for conflict-fields append"
  jq --argjson add "$arr" '. + $add' "$CONFLICT_FIELDS_JSON" >"$tmp"
  mv -- "$tmp" "$CONFLICT_FIELDS_JSON"
}

# --- Layer 2: structural field-level auto-merge -----------------------------
# run_merge_node <id> <base-file-or-empty> <ours-file> <theirs-file-or-empty> <out-file>
# Invokes MERGE_NODE_SCRIPT (merge-node.ts) to three-way merge one node's
# frontmatter fields. On full resolution: <out-file> holds the valid merged
# content when this returns 0, and RESOLVED_VIA_MERGE is set to 1. On partial /
# no resolution, OR a tool crash (non-zero exit / unparsable stdout): appends
# one entry per unresolved field (or one generic "could not attempt structural
# merge" sentinel on a crash) to CONFLICT_FIELDS_JSON and returns 1. NEVER dies
# — a per-node content divergence is expected, recoverable state, not a broken
# environment. Per shell-json.md, stdout is captured into a variable FIRST, then
# parsed via a here-string (`jq <<<"$var"`), never `echo "$var" | jq`.
run_merge_node() {
  local id="$1" base="$2" ours="$3" theirs="$4" out="$5"
  local captured rc=0
  # merge-node.ts prints one line of JSON on stdout for BOTH the resolved and
  # the unresolved outcomes, and NO JSON (non-zero exit, stderr only) on a
  # genuine crash. Capture stdout; let stderr flow through for visibility.
  captured="$(npx tsx "$MERGE_NODE_SCRIPT" --base "$base" --ours "$ours" --theirs "$theirs" --out "$out")" || rc=$?

  # A crash (non-zero exit) or stdout that is not valid JSON is NOT a content
  # divergence we can enumerate — record a generic sentinel and report
  # unresolved, but never die.
  if [[ "$rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$captured"; then
    append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "could not attempt structural merge"}]')"
    return 1
  fi

  if [[ "$(jq -r '.resolved' <<<"$captured")" == "true" ]]; then
    # merge-node.ts wrote <out>; the merged content is ready for the caller.
    RESOLVED_VIA_MERGE=1
    return 0
  fi

  # resolved==false: one {id, field, ours, theirs} entry per unresolved field.
  append_conflicts "$(jq -c --arg id "$id" '[.conflicts[] | {id: $id, field, ours, theirs}]' <<<"$captured")"
  return 1
}

# --- Far-ahead worktree: rebuild the edit on an intentions/-only base --------
# The `graph/**` fast path stamps the four required checks only on an
# intentions/-only SHA — its guard (.github/workflows/graph-fast-path.yml)
# fails the scratch push if `git diff --name-only origin/main...HEAD` names any
# path outside intentions/. When graph-commit runs inside a PR-branch worktree
# whose HEAD carries the PR's code diff, a commit made on top of that HEAD is
# NOT intentions/-only, so the scratch push is rejected, the checks never
# stamp, and the land times out. Callers used to hand-roll a "reset dance"
# around graph-commit (save HEAD, reset --hard origin/main, re-apply the node,
# commit, restore) to avoid this; park-node and the Stop-hook node-lane
# escalation seam did not, so an escalation-park from a far-ahead worktree
# silently failed and the node looped.
#
# This makes graph-commit far-ahead-safe at the source: when HEAD is ahead of
# origin/main with non-intentions changes, rebuild the intended edit on top of
# fresh origin/main — reset the tree to origin/main, re-materialize the
# snapshotted node content (edits) and deletions (prunes) — so the normal
# commit+land flow runs on an intentions/-only base. cleanup() restores the
# original HEAD on exit. A worktree already at/behind origin/main, or ahead
# with only intentions/ commits, needs no rebuild and is left untouched (the
# in-place path is unchanged for the main-checkout and clean-worktree callers).
#
# NOTE (deployment): `git reset --hard` is a tree-updating op; when this script
# is driven through the sandboxed Bash tool it needs dangerouslyDisableSandbox
# if origin/main advanced read-only paths (.claude/skills/**, config/) — see
# .claude/rules/sandbox.md. That is a caller concern (every graph-commit caller
# already sets it), not resolved here. Must run AFTER snapshot() so SNAP_DIR
# holds the writer's content before the reset overwrites the working tree.
ensure_intentions_only_base() {
  git fetch origin main >&2
  local base_sha nonint
  base_sha="$(git rev-parse FETCH_HEAD)"
  # Same diff spec the fast-path guard uses: three-dot (changes on HEAD's side
  # of the merge-base), name-only, then drop everything under intentions/.
  nonint="$(git diff --name-only "$base_sha"...HEAD | grep -v '^intentions/' || true)"
  [[ -z "$nonint" ]] && return 0
  echo "graph-commit: worktree HEAD is ahead of origin/main with non-intentions changes — rebuilding the edit on an intentions/-only base (HEAD restored on exit)" >&2
  ORIG_HEAD="$(git rev-parse HEAD)"
  RESTORE_HEAD=1
  git reset --hard "$base_sha" >&2
  local id
  for id in "${IDS[@]}"; do
    cp -- "$SNAP_DIR/$id.md" "$INTENTIONS_DIR/$id.md"
  done
  for id in "${PRUNE_IDS[@]}"; do
    rm -f -- "$INTENTIONS_DIR/$id.md"
  done
}

# --- Is there anything new to commit? --------------------------------------
# Return 0 iff at least one intentions/<id>.md differs from HEAD (either a
# working-tree change or an already-staged one). This is the state discriminator
# that makes graph-commit safely re-invocable after a partial failure:
#   - dirty   → there is new content to stage → commit_files() then land().
#   - clean   → nothing new to stage; the id file(s) already match the last
#               commit. Either HEAD already equals origin/main (truly nothing to
#               do) OR a prior attempt already committed the desired content and
#               only failed to push. Both collapse to the same action: skip
#               commit_files() and land whatever HEAD already is — try_land()
#               trivially no-ops when HEAD == origin/main, or pushes the pending
#               local commit(s) forward when HEAD is ahead.
# Scoped strictly to the requested id paths, so incidental dirt elsewhere in the
# tree (e.g. an unrelated package-lock.json diff) never flips this to "dirty".
id_files_dirty() {
  local id paths=()
  for id in "${ALL_IDS[@]}"; do
    paths+=("intentions/$id.md")
  done
  [[ -n "$(git status --porcelain -- "${paths[@]}")" ]]
}

# --- Commit ----------------------------------------------------------------
# Stage exactly our id files (edits AND prunes — `git add -- <path>` stages a
# deletion for a tracked file that is missing from the working tree just as
# readily as it stages new/changed content), run the guard, then commit with
# CURRENT_MSG.
commit_files() {
  local id
  for id in "${ALL_IDS[@]}"; do
    git add -- "intentions/$id.md"
  done
  assert_staged_safe
  git commit -q -m "$CURRENT_MSG"
}

# --- Rebase-state detection ------------------------------------------------
# Distinguish a rebase CONFLICT from a fetch/refuse fatal after `git pull
# --rebase` returns non-zero. This checkout is a `.bare` common-dir + worktree
# layout where `.git` is a file and the rebase state dirs live under the
# per-worktree git dir, so resolve them via `git rev-parse --git-path` rather
# than hardcoding `.git/rebase-*` (which would misclassify every conflict here).
rebase_in_progress() {
  local rm ra
  rm="$(git rev-parse --git-path rebase-merge)"
  ra="$(git rev-parse --git-path rebase-apply)"
  [[ -d "$rm" || -d "$ra" ]]
}

# --- Fast-path check stamping ----------------------------------------------
# Poll the branch-protection ruleset's four required contexts on <sha> until all
# report a successful conclusion, keyed on the check-run NAME (mirrors the four
# jobs in .github/workflows/graph-fast-path.yml). Only the fast path fires on a
# `graph/**` push (unit-tests.yml ignores graph/**, pr-checks.yml is PR-only),
# so there is no same-named run to race. Uses `gh api ... --jq` so gh runs jq on
# its in-memory JSON — never an `echo "$VAR" | jq` round-trip (shell-json.md).
# Returns:
#   0  all four contexts green.
#   1  the timeout elapsed with the checks still pending (transient — the
#      caller rebases and retries this whole cycle).
#   2  a required check CONCLUDED non-success (deterministic — the commit
#      content itself fails CI; the caller must not retry).
# Dies after 3 CONSECUTIVE gh poll failures, surfacing gh's captured stderr —
# an auth/rate-limit/network error is a broken environment, not a pending
# check, so collapsing it into "still polling" until the generic timeout
# would hide the real cause (clear error over fallback, code-style.md).
await_checks() {
  local sha="$1"
  local deadline counts nsucc nfail gh_stderr gh_fails=0
  # gh's stderr is captured per poll inside SNAP_DIR, which already exists for
  # the lifetime of the run and is removed by cleanup() on non-park exits.
  local errfile="$SNAP_DIR/.gh-poll-stderr"
  deadline=$(( $(date +%s) + CHECK_TIMEOUT_SECONDS ))
  nsucc=0
  while :; do
    # For the four required names on this SHA, count how many concluded
    # success and how many concluded non-success, keyed off .conclusion alone
    # (null = pending, non-null = concluded) rather than requiring
    # status=="completed" too — GitHub sometimes leaves a check-run's status
    # stuck at in_progress even after its conclusion is already populated (a
    # known check-runs desync). Mirrors dispatch_classify_rollup's
    # `(.conclusion // "")` idiom (lib.sh) fixed for the same desync. Extra
    # check runs (e.g. CodeQL `Analyze (*)`, `guard`) are ignored by the name
    # filter.
    if counts="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
      --jq '[.check_runs[]
             | select(.name=="acceptance" or .name=="preview-and-smoke"
                      or .name=="lint" or .name=="unit-tests")]
            | "\([.[]|select((.conclusion // "") == "success")]|length) \([.[]|select(((.conclusion // "") != "") and (.conclusion != "success"))]|length)"' \
      2>"$errfile")"; then
      gh_fails=0
      [[ -n "$counts" ]] || counts="0 0"
      read -r nsucc nfail <<<"$counts"
      if [[ "$nsucc" -eq 4 ]]; then
        return 0
      fi
      if [[ "${nfail:-0}" -gt 0 ]]; then
        echo "graph-commit: a required check concluded non-success for $sha ($nsucc/4 green, $nfail failed)" >&2
        return 2
      fi
    else
      gh_stderr="$(cat "$errfile" 2>/dev/null || true)"
      gh_fails=$((gh_fails + 1))
      echo "graph-commit: check-run poll failed ($gh_fails/3 consecutive) for $sha: ${gh_stderr:-<no stderr>}" >&2
      if [[ "$gh_fails" -ge 3 ]]; then
        die "check-run polling failed 3 consecutive times for $sha — last gh error: ${gh_stderr:-<no stderr>}"
      fi
    fi
    if [[ "$(date +%s)" -ge "$deadline" ]]; then
      echo "graph-commit: required checks not green within ${CHECK_TIMEOUT_SECONDS}s for $sha (last seen ${nsucc:-0}/4 green)" >&2
      return 1
    fi
    sleep "$CHECK_POLL_SECONDS"
  done
}

# --- Prune-id membership ----------------------------------------------------
# Return 0 iff <id> is one of the --prune ids (a deletion, not an edit).
is_prune_id() {
  local id="$1" p
  for p in "${PRUNE_IDS[@]}"; do
    [[ "$p" == "$id" ]] && return 0
  done
  return 1
}

# --- Layer 2: field-level auto-merge of a textual rebase conflict ------------
# Called with a rebase in progress (conflicted paths staged as unmerged) after
# `git pull --rebase origin main` hit a textual CONFLICT, BEFORE aborting and
# parking. For each conflicted intentions/<id>.md, attempt an automatic
# field-level merge via run_merge_node(). Returns 0 iff EVERY conflicted id
# fully resolved AND `git rebase --continue` then succeeded — the caller falls
# through to the normal post-pull stamping/push path exactly as if the pull had
# succeeded outright. Returns 1 on any unresolved id (the caller aborts the
# rebase and returns 10 → parks); unresolved fields accumulate in
# CONFLICT_FIELDS_JSON. Dies only on the broken-invariant case (a conflicted
# path outside this invocation's node set).
try_layer2_resolve() {
  local conflicted path id all_resolved=1
  conflicted="$(git diff --name-only --diff-filter=U)"
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    id="${path#intentions/}"
    id="${id%.md}"
    # Defensive: only requested paths are ever staged by this writer, so a
    # conflicted path outside ALL_IDS (EXPECTED holds exactly ALL_IDS's paths)
    # is a broken invariant, not a content divergence — die, do not continue.
    if [[ -z "${EXPECTED[$path]:-}" ]]; then
      die "unexpected conflicted path '$path' not in this invocation's node set — broken staging invariant"
    fi
    # A prune (deletion) has no content to structurally merge against — record a
    # sentinel and mark unresolved for this id without calling run_merge_node.
    if is_prune_id "$id"; then
      append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "prune vs. concurrent edit"}]')"
      all_resolved=0
      continue
    fi
    # GIT-REBASE STAGE NUMBERING (do NOT get this backwards — documented here so
    # future readers don't invert it): during `git rebase`, HEAD is replayed
    # ONTO the upstream tip, so
    #   stage :1: = merge-base                                (this plan's "base")
    #   stage :2: = UPSTREAM / already-landed content         (this plan's "theirs")
    #   stage :3: = the patch being replayed / this writer's
    #               intended content                         (this plan's "ours")
    # This is the OPPOSITE of `git merge`'s numbering, where stage 2 is ours and
    # stage 3 is theirs. run_merge_node() takes (<id> <base> <ours> <theirs>
    # <out>) by the merge primitive's SEMANTIC naming, so we pass stage 3 as
    # "ours" and stage 2 as "theirs" even though the raw git stage numbers are
    # swapped from that.
    local base_arg ours_arg theirs_arg out_f
    out_f="$SNAP_DIR/.merge-$id.out"
    base_arg="$(stage_file_or_empty 1 "$path" "$SNAP_DIR/.merge-$id.base")"
    theirs_arg="$(stage_file_or_empty 2 "$path" "$SNAP_DIR/.merge-$id.theirs")"
    ours_arg="$(stage_file_or_empty 3 "$path" "$SNAP_DIR/.merge-$id.ours")"
    if run_merge_node "$id" "$base_arg" "$ours_arg" "$theirs_arg" "$out_f"; then
      # Resolved: install the merged content at the real repo path and stage it.
      cp -- "$out_f" "$path"
      git add -- "$path"
    else
      all_resolved=0
    fi
  done <<<"$conflicted"

  [[ "$all_resolved" -eq 1 ]] || return 1

  # Every conflicted id resolved and staged — continue the rebase. If it
  # unexpectedly fails (a stage we did not enumerate, a hook, etc.), treat it as
  # unresolved so the caller aborts and parks — do not assume infallibility.
  # GIT_EDITOR=true (scoped to this call only) keeps the implicit
  # commit-message-edit step non-interactive: it reuses the replayed commit
  # message instead of trying to open an editor, which fails in
  # non-interactive environments (e.g. CI) with no EDITOR/VISUAL/core.editor
  # configured and TERM=dumb.
  GIT_EDITOR=true git rebase --continue >&2 || return 1
  return 0
}

# Write stage <n> of <path> into <dest>; echo <dest> when the stage exists, or
# the empty string when it does not (an add/add or delete/modify conflict leaves
# a stage absent). merge-node.ts reads an empty-string arg as "this side did not
# exist" rather than parsing an empty file, so a missing stage must map to "".
stage_file_or_empty() {
  local stage="$1" path="$2" dest="$3"
  if git show ":$stage:$path" >"$dest" 2>/dev/null; then
    printf '%s' "$dest"
  else
    rm -f -- "$dest"
    printf '%s'
  fi
}


# --- Landing lock (distributed CAS lock with TTL steal) --------------------
# Serializes the rebase → stamp → push critical section across concurrent
# graph-commit invocations, so a losing writer waits/backs off cheaply instead
# of burning a full CI-stamp cycle (30–180s) it is very likely to lose.
#
# There is no shared filesystem or coordination server across the machines that
# run graph-commit — the only shared, atomically-updatable medium is the git
# remote itself. So the lock IS a git ref: refs/graph/landing-lock, whose value
# is an orphan (parentless) commit object encoding the current holder's identity
# and an expiry timestamp. Mutual exclusion rides on git's own server-side
# compare-and-swap on ref updates:
#   - Claiming a free lock is a non-force push to a ref that does not yet exist.
#     git rejects it if a concurrent writer created the ref first — that is an
#     atomic CAS on "still absent".
#   - Renewing our own claim, or stealing an expired foreign one, is a
#     --force-with-lease push that only lands if the remote ref still equals the
#     exact SHA we observed — an atomic CAS on "unchanged since we looked".
# A losing CAS never corrupts anything; the loser simply re-observes and loops.
#
# TTL steal keeps a crashed holder (one that dies without releasing) from
# freezing the lock forever: each claim carries expiry = now + LOCK_TTL_SECONDS,
# and once that passes any waiter may steal the ref (again via the leased CAS,
# so two simultaneous stealers can't both win). LOCK_WAIT_DEADLINE (set by the
# caller) bounds how long a writer waits before giving up entirely.
#
# Payload encoding — a lock claim is a single orphan commit whose tree is git's
# universal empty-tree object (4b825dc642cb6eb9a060e54bf8d69288fbee4904) and
# whose message is exactly two lines:
#     graph-commit-lock v1
#     holder=<LOCK_HOLDER_ID> expiry=<unix_epoch_seconds>
# Author/committer identity is whatever git commit-tree picks up from ambient
# user.name/user.email — no special identity handling.

# build_lock_commit <expiry_unix_ts> -> prints a new orphan commit SHA.
build_lock_commit() {
  local expiry="$1"
  git commit-tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -m "graph-commit-lock v1" \
    -m "holder=$LOCK_HOLDER_ID expiry=$expiry"
}

# read_lock_payload <ref-or-sha> — read an already-fetched ref/sha's message and
# set LOCK_OBS_HOLDER / LOCK_OBS_EXPIRY from its second line (parsed with bash's
# own [[ =~ ]], no external grep/sed). Two distinct failure shapes, handled
# differently:
#   - The object is not (yet) in this clone's local object database: `git show`
#     fails and we `return 1` on that line itself, quietly — this is the normal,
#     expected case the first time a given lock SHA is observed, and the caller
#     recovers by fetching. It must NOT fall through to the parse-failure die.
#   - The object IS readable but its message does not parse as a lock payload:
#     that is a broken-environment condition, so die() rather than silently skip
#     (per code-style.md's clear-errors-over-fallbacks convention).
read_lock_payload() {
  local ref="$1" body line2
  body="$(git show -s --format=%B "$ref" 2>/dev/null)" || return 1
  line2="$(printf '%s\n' "$body" | tail -n1)"
  if [[ "$line2" =~ ^holder=([^[:space:]]+)\ expiry=([0-9]+)$ ]]; then
    LOCK_OBS_HOLDER="${BASH_REMATCH[1]}"
    LOCK_OBS_EXPIRY="${BASH_REMATCH[2]}"
  else
    die "malformed landing-lock payload on $ref: '$line2'"
  fi
}

# lock_claim_or_renew — no arguments. Loops until this process holds a live
# claim (sets LOCK_SHA + LOCK_HELD=1 and returns 0), or until LOCK_WAIT_DEADLINE
# (set by the caller before the first call, a later unit) passes without
# acquiring, in which case it returns 1.
#
# Note: `git ls-remote` returning a SHA does NOT guarantee the corresponding
# commit object is already in the LOCAL object database — `git clone`/`git
# fetch` never pull refs/graph/** by default — hence the fetch fallback around
# read_lock_payload. And even if the ref moves again between the ls-remote and
# that fetch (so FETCH_HEAD names something newer than $remote_sha), every
# subsequent write below leases against $remote_sha specifically — the original
# ls-remote observation — never against whatever FETCH_HEAD resolved to. So a
# stale read only ever wastes a loop iteration; it can never cause an incorrect
# write.
lock_claim_or_renew() {
  local remote_sha now expiry new_sha
  while :; do
    remote_sha="$(git ls-remote origin "$LOCK_REF" | cut -f1)"
    now="$(date +%s)"
    # Deadline check up front, before any branch below — covers every
    # `continue` path (lost create race, lost renew/steal race, live
    # foreign holder), not just the live-holder wait. Without this, a
    # pathological run of repeated lost create/steal races would spin
    # with no sleep and no exit condition.
    if [[ "$now" -ge "$LOCK_WAIT_DEADLINE" ]]; then
      return 1
    fi

    if [[ -z "$remote_sha" ]]; then
      # No one holds it: try to CREATE it. A non-force push to a ref that
      # does not yet exist is git's own atomic CAS on "still absent" — it
      # is rejected if a concurrent writer created the ref first, in which
      # case we fall through and re-observe as "exists".
      new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
      if git push origin "$new_sha:$LOCK_REF" >&2; then
        LOCK_SHA="$new_sha"; LOCK_HELD=1
        return 0
      fi
      # Rejected: almost always a lost create race — re-observe as "exists"
      # on the next loop pass. Left un-redirected (not `2>/dev/null`) so a
      # genuine non-race failure (auth/network) is visible in the log rather
      # than silently swallowed — per code-style.md's clear-errors-over-fallbacks.
      continue
    fi

    # read_lock_payload returns 1 (quietly) when the object named by
    # $remote_sha is not yet in this clone's local object database — the
    # normal case the FIRST time this process observes a given lock SHA,
    # since `git clone`/`git fetch` never pull refs/graph/** by default.
    # It only `die`s if the object IS readable but fails to parse.
    read_lock_payload "$remote_sha" || {
      git fetch -q origin "$LOCK_REF" >&2
      read_lock_payload FETCH_HEAD
    }

    if [[ "$LOCK_OBS_HOLDER" == "$LOCK_HOLDER_ID" ]]; then
      # Renewing our own still-recorded claim.
      new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
      if git push --force-with-lease="$LOCK_REF:$remote_sha" origin "$new_sha:$LOCK_REF" >&2; then
        LOCK_SHA="$new_sha"; LOCK_HELD=1
        return 0
      fi
      # Lease rejected: we were slow enough that someone else already
      # reclaimed it out from under us. Re-observe from scratch.
      continue
    fi

    if [[ "$LOCK_OBS_EXPIRY" -gt "$now" ]]; then
      # Live, foreign holder: wait, don't steal.
      sleep "$LOCK_POLL_SECONDS"
      continue
    fi

    # Expired: steal, atomically, only if the ref still equals what we
    # just observed (guards a simultaneous-steal race against another
    # waiter that observed the same expiry).
    new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
    if git push --force-with-lease="$LOCK_REF:$remote_sha" origin "$new_sha:$LOCK_REF" >&2; then
      LOCK_SHA="$new_sha"; LOCK_HELD=1
      return 0
    fi
    continue
  done
}

# lock_release — no-op unless we currently hold the lock; best-effort. The
# --force-with-lease on the delete refspec is atomic ("delete only if the remote
# ref still equals $LOCK_SHA"), so this process never deletes a lock it no
# longer owns — e.g. after losing a steal race, or after its own
# LOCK_WAIT_SECONDS timeout let another writer reclaim the ref. Always
# non-fatal (|| true) so a release failure never masks the caller's real exit
# status, mirroring the scratch-branch delete's discipline in cleanup().
lock_release() {
  [[ "$LOCK_HELD" -eq 1 ]] || return 0
  git push --force-with-lease="$LOCK_REF:$LOCK_SHA" origin ":$LOCK_REF" >&2 || true
  LOCK_HELD=0
  LOCK_SHA=""
}

# --- Bounded rebase + stamp + push loop ------------------------------------
# Runs up to MAX_PUSH_ATTEMPTS of:
#   pull --rebase origin main → push HEAD:graph/<scratch> → await checks →
#   push <sha>:main.
# A fresh SHA must first carry the four required contexts (checks attach to the
# SHA, not the branch), so each attempt stamps the SHA via the `graph/**` fast
# path before fast-forwarding it onto main.
# Returns:
#   0  pushed.
#   10 a rebase CONFLICT occurred that layer 2 (try_layer2_resolve) could NOT
#      fully resolve — the rebase is aborted and the caller fails closed and
#      parks. A conflict that layer 2 DOES resolve is continued in place and
#      falls through to the normal push path (returning 0), never surfacing as
#      10.
#   11 every attempt failed with no conflict (busy main, or the checks never
#      stamped green within the poll window).
# Dies on a non-conflict rebase/fetch failure (broken environment), and on a
# CONCLUDED check failure — a concluded non-success is a property of the
# commit content, not of contention, so every retry would reproduce it; the
# remaining attempts are not burned (clear error over a fallback, per
# code-style.md).
try_land() {
  local attempt sha ck
  LOCK_WAIT_DEADLINE=$(( $(date +%s) + LOCK_WAIT_SECONDS ))
  for (( attempt=1; attempt<=MAX_PUSH_ATTEMPTS; attempt++ )); do
    # Serialize concurrent invocations on the landing lock so a losing writer
    # waits/backs off instead of burning a full CI-stamp cycle only to lose
    # the final push to main anyway.
    if ! lock_claim_or_renew; then
      break
    fi

    if ! git pull --rebase origin main >&2; then
      if ! rebase_in_progress; then
        die "'git pull --rebase origin main' failed and left no rebase in progress (fetch failure or another unexpected git error — an unrelated dirty tracked file would have been caught by the pre-flight check)"
      fi
      echo "graph-commit: rebase conflict on attempt $attempt/$MAX_PUSH_ATTEMPTS (concurrent edit to the same node); attempting layer-2 field-level auto-merge before parking" >&2
      if ! try_layer2_resolve; then
        # Layer 2 could not fully resolve every conflicted field — abort the
        # rebase and park (return 10, which land() maps to 12).
        git rebase --abort >&2 || true
        lock_release
        return 10
      fi
      # Layer 2 resolved every conflicted id and `git rebase --continue`
      # succeeded — fall through to the normal stamping/push path below exactly
      # as if `git pull --rebase` had succeeded outright the first time.
      echo "graph-commit: layer-2 auto-merge resolved all conflicted node(s) on attempt $attempt/$MAX_PUSH_ATTEMPTS; continuing" >&2
    fi

    # The exact SHA we intend to land; the required checks stamp onto it.
    sha="$(git rev-parse HEAD)"

    # Stamp the SHA: push it to the `graph/**` scratch branch so the fast-path
    # workflow runs and stamps the four required contexts. Plain --force (not
    # --force-with-lease): the scratch branch is reused across attempts within
    # this invocation and we never fetch its remote-tracking ref, so a lease
    # expectation would go stale and spuriously reject the second push. It is a
    # PID-scoped branch this process owns and deletes, so a blind force is safe.
    if ! git push --force origin "HEAD:refs/heads/$SCRATCH_BRANCH" >&2; then
      echo "graph-commit: scratch push to $SCRATCH_BRANCH failed on attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying" >&2
      continue
    fi
    SCRATCH_PUSHED=1

    # Wait for the fast path to stamp the four required checks green on this SHA.
    ck=0
    await_checks "$sha" || ck=$?
    if [[ "$ck" -eq 2 ]]; then
      # Deterministic failure: a required check CONCLUDED non-success, so the
      # content itself is broken — rebasing and re-stamping would reproduce
      # the same failure on every remaining attempt.
      die "a required check concluded non-success for $sha — the commit content fails CI; not retrying (fix the content and re-run)"
    fi
    if [[ "$ck" -ne 0 ]]; then
      echo "graph-commit: checks did not go green for $sha on attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying" >&2
      continue
    fi

    # The SHA now carries the four passing contexts — fast-forward it onto main.
    if [[ "$(git ls-remote origin "$LOCK_REF" | cut -f1)" != "$LOCK_SHA" ]]; then
      echo "graph-commit: landing lock no longer held (stolen after expiry) before the main push on attempt $attempt/$MAX_PUSH_ATTEMPTS; re-claiming and retrying" >&2
      LOCK_HELD=0
      continue
    fi
    if git push origin "$sha:main" >&2; then
      lock_release
      return 0
    fi
    echo "graph-commit: push of $sha to main rejected (main advanced), attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying" >&2
  done
  lock_release
  local ran=$attempt
  (( ran > MAX_PUSH_ATTEMPTS )) && ran=$MAX_PUSH_ATTEMPTS
  echo "error: graph-commit: could not land on main after $ran/$MAX_PUSH_ATTEMPTS attempts — main busy (landing-lock contention or required checks never stamped green); retry later" >&2
  return 11
}

# --- Land: fail closed on an unresolvable conflict --------------------------
# A rebase conflict means a concurrent writer landed an OVERLAPPING edit to the
# same node while this one was in flight. try_land() first attempts an automatic
# field-level merge (layer 2, try_layer2_resolve): when every conflicted field
# merges cleanly the rebase is continued in place and the write lands normally
# (rc 0). Only when layer 2 CANNOT resolve every conflicted field does the
# conflict map to the parking outcome — replaying this writer's whole-file
# snapshot over the other writer's landed content would silently discard that
# edit (the entire file, not just the conflicting hunk) while still exiting 0,
# so an unresolvable conflict parks rather than retries or overwrites.
# Returns:
#   0  landed (possibly after a layer-2 auto-merge resolved the conflict).
#   11 pure rejection exhausted with NO conflict (busy main — fail loudly, do
#      not park; this is not a semantic conflict).
#   12 a rebase CONFLICT layer 2 could not fully resolve (the caller parks).
land() {
  local rc=0
  try_land || rc=$?
  case "$rc" in
    0) return 0 ;;
    11) return 11 ;;
    10) return 12 ;;
    *)
      die "unexpected land status $rc"
      ;;
  esac
}

# --- Recommendation text for a mechanical-unresolved park -------------------
# Render CONFLICT_FIELDS_JSON (the layer-2/3 unresolved-field accumulator) into a
# human-readable, per-conflict breakdown for office_hours.recommendation. Handles
# BOTH entry shapes present in the array:
#   {id, field, ours, theirs}  — a real diverged field. `ours` is this session's
#                                value, `theirs` is origin/main's; each renders
#                                raw when it is already a string, else as compact
#                                JSON (an array/object field).
#   {id, note}                 — a generic sentinel (merge-node crash, or a
#                                prune-vs-concurrent-edit) with no field detail.
# One block per entry, blank-line separated. Emitted on stdout.
build_recommendation() {
  local jqprog="$SNAP_DIR/.park-recommendation.jq"
  cat >"$jqprog" <<'JQ'
def render_value: if type == "string" then . else tojson end;
map(
  if has("field") then
    "Diverged field '\(.field)' on \(.id):\n  this session's value: \(.ours|render_value)\n  origin/main's value: \(.theirs|render_value)"
  else
    "Unresolved conflict on \(.id): \(.note // "no field-level detail captured")"
  end
) | join("\n\n")
JQ
  jq -rf "$jqprog" "$CONFLICT_FIELDS_JSON"
}

# --- Parking fallback ------------------------------------------------------
# A genuine semantic conflict: set office_hours on each target node via store.ts
# (readNode → set office_hours → writeNode) so the frontmatter is serialized
# correctly and — for a tactic — its authoritative body is preserved. Uses a
# throwaway tsx module rather than hand-editing YAML.
#
# office_hours.recommendation is composed ADDITIVELY from two independently
# planned layers (tactic-graph-commit-auto-serialization Unit 4 appends to,
# never replaces, tactic-graph-commit-park-context's text):
#   - BASE (park-context): a per-id recovery recommendation the tsx helper sets
#     for EVERY parked node — snapshot pointer, mailbox discipline, and a
#     prune-vs-edit distinction.
#   - APPENDED (this tactic, layers 1-3): keyed on whether the layer-2/3
#     accumulator (CONFLICT_FIELDS_JSON) captured field-level divergence detail.
#     Has entries → office_hours.reason is upgraded to the stable
#     "mechanical-unresolved" marker (a contract a future dispatch-conflict skill
#     greps for) plus the count of diverged fields, and build_recommendation()'s
#     per-conflict field breakdown is appended after the base recovery text.
#     Empty/absent (unset global, missing file, or a `[]` array — a park
#     unrelated to a mechanical-merge attempt) → the plain concurrent-edit reason
#     and the base recovery recommendation only, with no field breakdown.
park_write() {
  local since reason tmpts prune_csv rec_file=""
  since="$(date -u +%Y-%m-%d)"
  reason="graph-commit: concurrent-edit conflict — manual merge needed"

  # Layers 1-3 (this tactic): if the layer-2/3 accumulator captured field-level
  # divergence, upgrade the reason to the greppable "mechanical-unresolved"
  # marker and render build_recommendation()'s per-conflict field breakdown to a
  # file. It is passed OUT OF BAND via GRAPH_COMMIT_RECOMMENDATION_FILE (a path
  # to a tempfile), not argv: it can be a long, multi-line string, and keeping it
  # off argv both dodges argv length/shell-quoting limits AND preserves the
  # helper's positional-argument contract. The helper appends it after each
  # node's base recovery recommendation. Unset/empty → base recovery text only.
  if [[ -n "$CONFLICT_FIELDS_JSON" && -s "$CONFLICT_FIELDS_JSON" ]]; then
    local n
    n="$(jq 'length' "$CONFLICT_FIELDS_JSON")"
    if [[ "${n:-0}" -gt 0 ]]; then
      reason="graph-commit: mechanical-unresolved — ${n} field(s) diverged across concurrent writes and could not be auto-merged (layers 1-3 exhausted)"
      rec_file="$SNAP_DIR/park-recommendation.txt"
      build_recommendation >"$rec_file"
    fi
  fi

  # Comma-join PRUNE_IDS (from tactic-graph-commit-park-context, already
  # populated by main()'s arg parsing) so the tsx helper can tell a prune id (no
  # on-disk snapshot — a deletion has nothing to preserve) from an ordinary edit
  # id (snapshotted to SNAP_DIR/<id>.md by snapshot(), graph-commit:272-280) when
  # composing each node's base recovery recommendation.
  prune_csv="$(IFS=,; echo "${PRUNE_IDS[*]:-}")"
  tmpts="$(mktemp --suffix=.mts)" || die "could not create temp file for the parking write"
  cat >"$tmpts" <<'TS'
// argv: <storeModule> <intentionsDir> <since> <reason> <snapDir> <pruneCsv> <id...>
// Composes office_hours.recommendation additively (tactic-graph-commit-auto-
// serialization Unit 4 appends to, never replaces, park-context's text): the
// per-id BASE recovery recommendation below (snapshot pointer / mailbox
// discipline / prune-vs-edit) always applies, and this tactic's field-level
// breakdown — passed OUT OF BAND via GRAPH_COMMIT_RECOMMENDATION_FILE — is
// appended after it when a mechanical merge left field divergence
// (unset/empty env var → base recovery text only).
import { readFileSync } from "node:fs";
const [storePath, intentionsDir, since, reason, snapDir, pruneCsv, ...ids] = process.argv.slice(2);
const pruneSet = new Set(pruneCsv ? pruneCsv.split(",") : []);
const recFile = process.env.GRAPH_COMMIT_RECOMMENDATION_FILE || "";
const fieldBreakdown = recFile ? readFileSync(recFile, "utf8").trimEnd() : "";
const { readNode, writeNode } = await import(storePath);
// Two-pass for atomicity: read every node up front so an unreadable id fails
// BEFORE any write — a single read-modify-write loop that threw mid-way would
// leave the earlier ids mutated on disk, uncommitted.
const nodes = ids.map((id) => readNode(intentionsDir, id));
for (let i = 0; i < nodes.length; i++) {
  const node = nodes[i];
  const id = ids[i];
  const base = pruneSet.has(id)
    ? "A concurrent writer landed an overlapping edit to this node while this " +
      "session's prune was in flight; the prune was NOT landed (a deletion has " +
      "no content snapshot). Recommended: the losing writer re-reads the " +
      "current origin/main content, decides whether the prune still applies, " +
      "and re-runs graph-commit (--prune, or a fresh edit) on the reconciled " +
      "result — that same commit clears this office_hours park. A third " +
      "session encountering this park while the loser is still working should " +
      "wait rather than attempt its own merge (the mailbox discipline)."
    : `A concurrent writer landed an overlapping edit to this node while this ` +
      `session's edit was in flight; this writer's content was NOT landed. ` +
      `This session's unlanded content is preserved at ${snapDir}/${id}.md ` +
      `(this machine only — may not survive past this session). Recommended: ` +
      `the losing writer re-reads the current origin/main content, manually ` +
      `merges in its intended edit, and re-runs graph-commit on the merged ` +
      `result — that same commit clears this office_hours park. A third ` +
      `session encountering this park while the loser is still working should ` +
      `wait rather than attempt its own merge (the mailbox discipline).`;
  const recommendation = fieldBreakdown ? `${base}\n\n${fieldBreakdown}` : base;
  node.office_hours = { reason, since, recommendation };
  writeNode(intentionsDir, node);
  process.stderr.write(`graph-commit: set office_hours on ${id} (since=${since})\n`);
}
TS
  if ! GRAPH_COMMIT_RECOMMENDATION_FILE="$rec_file" \
       npx tsx "$tmpts" "$STORE_MODULE" "$INTENTIONS_DIR" "$since" "$reason" "$SNAP_DIR" "$prune_csv" "${ALL_IDS[@]}" >&2; then
    rm -f "$tmpts"
    die "failed to write the office_hours parking record"
  fi
  rm -f "$tmpts"
}

# --- Shared fail-closed park path (never returns) ---------------------------
# The concurrent-edit conflict fail-closed sequence, extracted from main()'s
# rc-12 tail so a second call site (Unit 3, before any commit exists) can invoke
# the identical park without duplicating fetch/reset/park_write/re-commit/land
# logic. Self-contained: relies only on globals (ALL_IDS, SNAP_DIR, KEEP_SNAP)
# and the committed helpers, never on state that exists only after
# try_land()/land() ran — it does its own fetch/reset. Always calls exit 1.
park_and_exit() {
  local park_msg="graph: park ${ALL_IDS[*]} (concurrent-edit conflict)"
  # Fail closed: discard this writer's local conflicting commit, park the node as
  # it exists on fresh origin/main (the other writer's already-landed content
  # wins), and preserve this writer's unlanded content in SNAP_DIR for the
  # manual merge.
  KEEP_SNAP=1
  echo "graph-commit: concurrent-edit conflict on ${ALL_IDS[*]}; parking node(s) — this writer's content is NOT landed" >&2
  echo "graph-commit: this writer's unlanded content is preserved at $SNAP_DIR for the manual merge" >&2
  # Sync to fresh origin/main. Both callers reach here with the writer's content
  # already captured in SNAP_DIR by snapshot() (run before check_base_freshness),
  # so the reset is safe to run regardless of what it discards:
  #   - rc-12 (layer-2) caller: the tree is clean of tracked modifications (the
  #     conflicting rebase could only start on a clean tree and was aborted), so
  #     the reset discards exactly the local conflicting commit — nothing else.
  #   - layer-3 caller (from inside check_base_freshness): no rebase ran and the
  #     tree still holds the writer's uncommitted node edits; the reset discards
  #     them, but SNAP_DIR already preserves them for the manual merge.
  # NOTE (deployment): `git reset --hard` is a tree-updating op; when this
  # script is driven through the sandboxed Bash tool it needs
  # dangerouslyDisableSandbox if origin/main advanced read-only paths
  # (.claude/skills/**, config/) — see .claude/rules/sandbox.md. That is a
  # caller concern, not resolved here.
  git fetch origin main >&2
  git reset --hard FETCH_HEAD >&2
  park_write
  CURRENT_MSG="$park_msg"
  if id_files_dirty; then
    commit_files
  fi
  local prc=0
  land || prc=$?
  if [[ "$prc" -eq 0 ]]; then
    echo "graph-commit: parked ${ALL_IDS[*]} (office_hours set on the origin/main content) and pushed the parking write to main" >&2
  else
    echo "error: graph-commit: could not land the parking write for ${ALL_IDS[*]} — office_hours set locally but not pushed to main" >&2
  fi
  exit 1
}

# --- Pre-flight: refuse on unrelated dirty tracked files --------------------
# try_land()'s `git pull --rebase origin main` refuses outright when ANY
# tracked file is dirty, including files entirely unrelated to this call's
# node set (observed: a modified flake.lock in a freshly-provisioned
# worktree). Left unchecked, that refusal surfaces as try_land()'s generic
# "dirty tree or fetch failure" die() — indistinguishable from a genuine
# environment problem, and it never names the offending paths. Catch it here,
# before ANY tree mutation — in particular before ensure_intentions_only_base()
# could run a `git reset --hard` that would silently discard the very dirt
# this is trying to surface — scoped to exclude exactly the paths this call is
# about to write (those are expected to be dirty; that is the point). Ignores
# untracked (`??`) entries: only a dirty TRACKED file blocks `git pull
# --rebase`, per the observed failure mode (code-style.md: clear error over a
# silent fallback such as --autostash, which would hide rather than surface
# the anomaly).
# Heuristic fingerprint check for a single offending path: does its diff from
# HEAD touch ONLY frontmatter marker fields (office_hours / phase / their
# nested block lines)? This is the exact shape left behind by a failed-write
# leak (park-node, transition-node, etc. interrupted mid-flight after editing
# the marker fields but before graph-commit landed the change) — as opposed to
# an unrelated file that happens to be dirty for some other reason. Not a full
# YAML parser: a body edit, a frontmatter edit to any other field, or a diff
# that can't be classified all correctly fall through to "not residue" (the
# safe direction — the caller still lists the file under the generic
# unrelated-dirty-file path with the blanket 'git stash -u' suggestion).
_offending_path_is_marker_only_residue() {
  local path="$1"
  [[ "$path" == intentions/*.md ]] || return 1
  local diff
  diff="$(git diff HEAD -- "$path" 2>/dev/null)"
  [[ -n "$diff" ]] || return 1
  local dline sign content trimmed in_marker_block=0 saw_change=0
  while IFS= read -r dline; do
    [[ "$dline" == '+++'* || "$dline" == '---'* || "$dline" == '@@'* || "$dline" == '\ '* ]] && continue
    [[ "$dline" == [+-]* ]] || continue
    sign="${dline:0:1}"
    content="${dline:1}"
    trimmed="${content#"${content%%[![:space:]]*}"}"
    [[ -z "$trimmed" ]] && continue
    saw_change=1
    if [[ "$content" == [[:space:]]* ]]; then
      # Indented line: only acceptable as a continuation inside a marker
      # block (e.g. office_hours: {reason: ..., cleared_at: ...} spread over
      # lines) opened by a prior top-level line in this same diff.
      [[ "$in_marker_block" == 1 ]] || return 1
      continue
    fi
    # Top-level (unindented) changed line: must be exactly a marker field.
    case "$trimmed" in
      office_hours:*|execution:*) in_marker_block=1 ;;
      phase:*) in_marker_block=0 ;;
      *) return 1 ;;
    esac
  done <<<"$diff"
  [[ "$saw_change" == 1 ]]
}

assert_clean_outside_ids() {
  local dirty
  # Reconcile the index's cached stat data with the working tree before reading
  # status. A preceding `git reset --hard` (e.g. park_and_exit's re-fetch, or an
  # earlier ensure_intentions_only_base) rewrites tracked files and the index in
  # the same sub-second; under load that hits git's "racy clean" window, where
  # `git status --porcelain` distrusts the equal mtimes and can momentarily
  # report an unchanged file as ` M`. `--refresh` re-stats and clears those
  # false positives (a genuinely different-content file still stays flagged and
  # is reported below), so the guard trips only on real dirt, not on a racy
  # stat. `|| true`: --refresh exits non-zero precisely when it leaves such a
  # genuinely-modified file flagged, which is not an error here.
  git update-index -q --refresh >/dev/null 2>&1 || true
  dirty="$(git status --porcelain)"
  [[ -z "$dirty" ]] && return 0
  local -A ours=()
  local id
  for id in "${ALL_IDS[@]}"; do
    ours["intentions/$id.md"]=1
  done
  local offending="" line path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$line" == '??'* ]] && continue
    path="${line:3}"
    [[ -n "${ours[$path]:-}" ]] && continue
    offending+="$line"$'\n'
  done <<<"$dirty"
  if [[ -n "$offending" ]]; then
    echo "error: graph-commit: refusing to start — unrelated dirty tracked file(s) outside this call's node set:" >&2
    printf '%s' "$offending" >&2
    local residue_line residue_path generic="" residue=""
    while IFS= read -r residue_line; do
      [[ -z "$residue_line" ]] && continue
      residue_path="${residue_line:3}"
      if _offending_path_is_marker_only_residue "$residue_path"; then
        residue+="$residue_line"$'\n'
      else
        generic+="$residue_line"$'\n'
      fi
    done <<<"$offending"
    if [[ -n "$residue" ]]; then
      echo "       LIKELY LEAKED-WRITE RESIDUE (diff touches only office_hours/phase marker fields — the fingerprint of a park-node/transition-node/etc. write that was interrupted before its graph-commit landed). Clear it directly:" >&2
      while IFS= read -r residue_line; do
        [[ -z "$residue_line" ]] && continue
        residue_path="${residue_line:3}"
        echo "         git -C \"$REPO_ROOT\" checkout -- $residue_path" >&2
      done <<<"$residue"
    fi
    if [[ -n "$generic" ]]; then
      echo "       stash or commit these first (e.g. 'git stash -u'), then re-run graph-commit — it resumes safely (a prior partial local commit is detected and just pushed forward)." >&2
    fi
    exit 1
  fi
}

# --- Main ------------------------------------------------------------------
main() {
  local msg="" REPO_ARG=""
  # Parse [-m <msg>] [-C <path>] and positional ids. `--` ends option parsing.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message) [[ $# -ge 2 ]] || { usage; die "-m requires a message argument"; }
                    msg="$2"; shift 2 ;;
      -C|--repo) [[ $# -ge 2 ]] || { usage; die "-C requires a repo path argument"; }
                 REPO_ARG="$2"; shift 2 ;;
      --prune) [[ $# -ge 2 ]] || { usage; die "--prune requires a node id argument"; }
               PRUNE_IDS+=("$2"); shift 2 ;;
      --base) [[ $# -ge 2 ]] || { usage; die "--base requires an <id>=<blobsha> argument or a manifest file path"; }
              parse_blob_arg BASE --base "$2"; shift 2 ;;
      --expect) [[ $# -ge 2 ]] || { usage; die "--expect requires an <id>=<blobsha> argument or a manifest file path"; }
                parse_blob_arg EXPECT_BLOB --expect "$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; while [[ $# -gt 0 ]]; do IDS+=("$1"); shift; done ;;
      -*) usage; echo "error: graph-commit: unknown option '$1'" >&2; exit 2 ;;
      *) IDS+=("$1"); shift ;;
    esac
  done

  # Resolve the repo to commit from the CALLER (the -C/--repo argument when
  # given, else cwd), never from this script's own on-disk location. SCRIPT_DIR
  # still locates sibling scripts (store.js, merge-node.ts) above; only the
  # committed checkout is caller-derived. Fail loudly rather than falling back to
  # the script's own checkout when the resolved-from path is not inside a git
  # repo (code-style.md: clear error over a silent fallback).
  local RESOLVE_FROM="${REPO_ARG:-$(pwd)}"
  if ! REPO_ROOT="$(git -C "$RESOLVE_FROM" rev-parse --show-toplevel 2>/dev/null)"; then
    die "'$RESOLVE_FROM' is not inside a git repository — graph-commit commits the CALLER's checkout (resolved from -C/--repo, else the current directory), never this script's own location. Pass -C <path> when not running from inside the target repo."
  fi
  INTENTIONS_DIR="$REPO_ROOT/intentions"
  cd "$REPO_ROOT"

  if [[ "${#IDS[@]}" -eq 0 && "${#PRUNE_IDS[@]}" -eq 0 ]]; then
    usage
    echo "error: graph-commit: at least one node id is required" >&2
    exit 2
  fi

  # Validate ordinary (edit) ids: each must already exist on disk — write-node.ts
  # is the sole place that authors node content; graph-commit only lands what's
  # already there.
  local id
  for id in "${IDS[@]}"; do
    validate_id_chars "$id"
    if [[ ! -f "$INTENTIONS_DIR/$id.md" ]]; then
      die "intentions/$id.md does not exist — write the node via write-node.ts before graph-commit"
    fi
    EXPECTED["intentions/$id.md"]=1
  done

  # Validate prune ids: the existence guard INVERTS relative to an ordinary
  # edit — the caller has already deleted intentions/<id>.md on disk (there is
  # no new content to author for a deletion), but the id must still name a
  # real tracked node (present in HEAD) rather than a typo that was never
  # landed.
  for id in "${PRUNE_IDS[@]}"; do
    validate_id_chars "$id"
    if [[ -f "$INTENTIONS_DIR/$id.md" ]]; then
      die "intentions/$id.md still exists on disk — delete the file before passing --prune $id"
    fi
    if ! git cat-file -e "HEAD:intentions/$id.md" 2>/dev/null; then
      die "intentions/$id.md does not exist in HEAD — nothing to prune for '$id'"
    fi
    EXPECTED["intentions/$id.md"]=1
  done

  ALL_IDS=("${IDS[@]}" "${PRUNE_IDS[@]}")

  # The throwaway stamping branch: named for the primary id and scoped to this
  # PID so concurrent graph-commit invocations never collide. cleanup() (the
  # EXIT trap) deletes it on the remote on every exit path — success, busy-main,
  # or the parking fallback — once it has been pushed at least once.
  # The id is sanitized for the ref name only (the name is cosmetic — PID
  # provides uniqueness): valid node ids like `v1..v2-migration` contain
  # sequences git refuses in a ref (`..`), so every non-[A-Za-z0-9-] char maps
  # to `-`. Use ALL_IDS (not just IDS) so a pure-prune commit (no ordinary
  # ids) still gets a valid scratch-branch name.
  # Computed here (before check_base_freshness) because it depends only on
  # ALL_IDS/ref_id, and layer 3's park path (park_and_exit) relies on cleanup()
  # already knowing the scratch-branch name.
  local ref_id="${ALL_IDS[0]//[!A-Za-z0-9-]/-}"
  SCRATCH_BRANCH="graph/$ref_id-$$"

  # SNAP_DIR and the EXIT trap must exist BEFORE check_base_freshness runs:
  # layer 3's stale-base auto-merge (inside check_base_freshness) uses
  # run_merge_node()'s tempfiles and CONFLICT_FIELDS_JSON — both rooted in
  # SNAP_DIR — and an unresolved divergence reaches park_and_exit(), which
  # relies on the EXIT trap's cleanup(). None of these existed here before this
  # block was moved ahead of the freshness check.
  SNAP_DIR="$(mktemp -d)" || die "could not create snapshot tempdir"
  trap cleanup EXIT
  # An EXIT trap does not reliably fire on INT/TERM in all shells; convert
  # those signals into a normal exit so cleanup() (snapshot removal, remote
  # scratch-branch delete) always runs on signal death.
  trap 'exit 130' INT TERM

  # Pre-flight (tactic-graph-commit-park-context): refuse when an unrelated
  # tracked file is dirty, BEFORE the first tree mutation. In this tactic's
  # layered design check_base_freshness runs the layer-3 stale-base auto-merge,
  # which overwrites node files on disk and can reach park_and_exit()'s
  # `git reset --hard`; the guard must run ahead of it so a stray dirty file is
  # surfaced (and named) rather than silently discarded.
  assert_clean_outside_ids

  # Wrong-repo assertion (opt-in via --expect). MUST run here: before
  # check_base_freshness (whose layer-3 auto-merge rewrites node files on disk)
  # and before ensure_intentions_only_base (which can `git reset --hard` the
  # tree). Running it any later would hash content graph-commit itself wrote.
  assert_expected_content

  # Capture the writer's intended on-disk content BEFORE check_base_freshness.
  # Layer 3's stale-base park (park_and_exit, reached from inside
  # check_base_freshness on an unresolvable same-field divergence) runs
  # `git reset --hard FETCH_HEAD`, which discards the writer's uncommitted node
  # edits. snapshot() is the only surviving copy of that content on every
  # fail-closed park path, and cleanup() keeps SNAP_DIR (KEEP_SNAP=1) so the park
  # message can point at it for the manual merge. Running it here — rather than
  # after the freshness check — makes the layer-3 park preserve the writer's
  # content just as the layer-2 rc-12 park does; otherwise the reset destroys it
  # and the "preserved at $SNAP_DIR" message is a false claim.
  snapshot

  check_base_freshness

  # Default commit message (the parking commit message is derived inside
  # park_and_exit()).
  if [[ -z "$msg" ]]; then
    msg="graph: ${ALL_IDS[*]}"
  fi

  # Capture the writer's on-disk content, then commit-and-land it.
  # Three states, discriminated by id_files_dirty():
  #   - dirty: normal case — stage + commit the new content, then land it.
  #   - clean: nothing new to stage — either the desired content is already on
  #     origin/main (truly nothing to do) or a prior attempt already committed it
  #     locally and only failed to push. Both are handled by skipping
  #     commit_files() and landing whatever HEAD already is, which makes the same
  #     invocation safe to just retry after any partial failure between
  #     commit_files() and a successful push.
  CURRENT_MSG="$msg"
  # If this is a far-ahead PR-branch worktree, rebuild the edit on an
  # intentions/-only base so the fast path can stamp it (cleanup() restores the
  # original HEAD). No-op for the main checkout and clean/intentions-only
  # worktrees. Runs after snapshot() (taken above, before check_base_freshness)
  # so the writer's content is captured before the reset overwrites the tree.
  ensure_intentions_only_base
  if id_files_dirty; then
    commit_files
  else
    # Nothing staged for any id. Under the caller-derived repo resolution above,
    # a "clean" tree has two possible meanings, and they must be told apart:
    #   - benign: this id already matches origin/main (already landed
    #     out-of-band, or a prior attempt committed but did not push) → land the
    #     current HEAD (a trivial no-op push when HEAD == origin/main).
    #   - MIS-POINTED -C: the resolved repo holds content for this id that
    #     DIFFERS from origin/main yet nothing is staged. Before caller-derived
    #     resolution this could not happen; now it can only mean the wrong
    #     checkout was targeted (a bad -C, or cwd pointing at another repo).
    #     Emitting the "landed" success here would repeat the incident bug — a
    #     false success for a tree that was never going to change origin/main.
    # Compare per id against origin/main using the FETCH_HEAD already populated
    # by ensure_intentions_only_base()'s fetch above (do NOT fetch again). Both
    # blobs absent/empty (id absent both places) is benign (equal empty strings).
    local id local_blob main_blob
    for id in "${ALL_IDS[@]}"; do
      local_blob="$(git rev-parse "HEAD:intentions/$id.md" 2>/dev/null || true)"
      main_blob="$(git rev-parse "FETCH_HEAD:intentions/$id.md" 2>/dev/null || true)"
      if [[ "$local_blob" != "$main_blob" ]]; then
        die "the resolved repo ($REPO_ROOT) holds intentions/$id.md content differing from origin/main but has nothing staged to commit. Under graph-commit's caller-derived repo resolution this can only mean a mis-pointed -C/--repo (or cwd targeting the wrong checkout) — refusing to emit a false 'landed' for a tree that was never going to change origin/main (HEAD blob=${local_blob:-<absent>}, origin/main blob=${main_blob:-<absent>})"
      fi
    done
    echo "graph-commit: no new changes to stage for ${ALL_IDS[*]} — landing current HEAD (nothing to commit, or a prior attempt already committed but did not push)" >&2
  fi

  local rc=0
  land || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    # Same rc-0 landed outcome whether or not a layer-2/3 auto-merge was needed;
    # RESOLVED_VIA_MERGE only distinguishes the log line (no new exit code).
    local landed_msg="graph-commit: landed ${ALL_IDS[*]} on main"
    if [[ "$RESOLVED_VIA_MERGE" -eq 1 ]]; then
      landed_msg+=" (layer 2/3 auto-resolved a concurrent-edit divergence)"
    fi
    echo "$landed_msg" >&2
    exit 0
  fi
  if [[ "$rc" -eq 11 ]]; then
    # Busy main, no semantic conflict — already errored loudly. No parking.
    exit 1
  fi

  # rc == 12: concurrent-edit conflict layer 2 could not fully resolve — fail
  # closed via the shared park path.
  park_and_exit
}

# Run main only when executed directly; when sourced (e.g. for unit-testing the
# guard/snapshot helpers) the functions are defined but nothing runs.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
