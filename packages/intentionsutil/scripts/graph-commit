#!/usr/bin/env bash
#
# graph-commit — the single write primitive that lands one or more intention
# node edits on `main`.
#
# Every graph writer (skills, router, reconciler, sensors) writes a node's
# content first via `packages/intentionsutil/scripts/write-node.ts` (the single
# validation gate), then calls this script with the node id(s). graph-commit
# never authors node content itself (except the office_hours parking fallback
# below, which goes through store.ts's writeNode, not raw text): it stages
# exactly `intentions/<id>.md` for each id, commits, stamps the commit's SHA
# with the four checks this loop waits on via a throwaway `graph/**` scratch
# branch (three of them required by main's ruleset — see below), and
# fast-forwards that SHA onto `main` directly (no PR) with a bounded
# rebase-retry loop.
#
# Why the stamp step is required: `main`'s branch-protection ruleset requires
# three status checks (`acceptance`, `lint`, `unit-tests`; this loop also waits
# on `preview-and-smoke`) already green ON THE EXACT SHA before it accepts it
# — checks attach to the SHA, not the branch. A brand-new local commit has zero
# check runs, so `git push origin HEAD:main` on it is deterministically
# rejected. The repo's `graph/**` CI fast path
# (.github/workflows/graph-fast-path.yml) is what stamps those four checks on an
# intentions/-only SHA: pushing the commit to a `graph/**` branch triggers it
# (~30-60s), after which the SAME SHA can be fast-forwarded onto `main`. So each
# attempt of the push loop runs:
#   commit → pull --rebase origin main → push HEAD:graph/<id>-<pid> →
#   poll the four checks green on the SHA → push <sha>:main.
# The scratch branch is throwaway (this process owns it, force-pushes it across
# retries, and deletes it on every exit path).
#
# Usage:
#   graph-commit [-C <repo-path>] [-m <message>] [--prune <id>]... [--base <id>=<blobsha>|<manifest-file>]... [--expect <id>=<blobsha>|<manifest-file>]... <node-id> [<node-id> ...]
#   graph-commit -m 'graph: seed dispatch state' tactic-graph-commit
#   graph-commit -C /path/to/worktree -m 'graph: land edit' tactic-foo
#
# -C <path> (alias --repo <path>): the checkout whose intentions/ this
#   invocation commits. The repo root is resolved from this path (else cwd) via
#   `git rev-parse --show-toplevel` — NEVER from this script's own on-disk
#   location. `-C` is the canonical spelling; pass it when graph-commit is not
#   run from inside the target repo (e.g. invoked by absolute path from a worktree).
#   graph-commit -m 'graph: prune done tactics' --prune tactic-foo --prune tactic-bar
#   graph-commit --base tactic-foo=3f1a9c... tactic-foo
#
# --prune <id> (repeatable, mixable with ordinary positional ids): land a
#   deletion. The caller must have already deleted intentions/<id>.md on disk;
#   the existence guard inverts (file absent on disk, present in HEAD).
#
# --base <id>=<blobsha> (repeatable) or --base <manifest-file> (one <id>=<sha>
#   pair per line): optional compare-and-swap freshness check. If any entry's
#   blob no longer matches origin/main after a fetch, the write is refused
#   before any local commit is made. Omit entirely to keep pre-CAS behavior.
#
# --expect <id>=<blobsha> (repeatable) or --expect <manifest-file> (one
#   <id>=<sha> pair per line): optional wrong-repo assertion. The sha is the
#   blob of the content the caller WROTE — `git hash-object -- intentions/<id>.md`
#   run in the caller's OWN checkout after its edit. Before any tree mutation,
#   graph-commit hashes the same path in the repo it resolved (-C/--repo, else
#   cwd) and refuses to land on a mismatch.
#
#   --base and --expect assert different things and are not interchangeable:
#   --base asserts the PRE-edit blob against origin/main (a freshness /
#   compare-and-swap check about concurrent writers), while --expect asserts the
#   POST-edit blob against the resolved checkout (a targeting check about WHICH
#   repo this invocation is committing). Only --expect can catch a wrong-repo
#   invocation whose blob happens to equal origin/main: the nothing-staged guard
#   below only fires when the wrong repo's blob DIFFERS from origin/main, so a
#   wrong repo that is merely in sync with origin/main slips through it and
#   exits 0 (as the nothing-to-push sub-case below, or as a "landed" that landed
#   nothing) while the caller's real edit sits dirty elsewhere.
#   Omit entirely to keep pre-assertion behavior.
#
# ORPHANED LOCAL COMMITS — THE RECOVERY RULE
# ------------------------------------------
# An ORPHAN is a commit this checkout carries that origin/main does not: what a
# graph-commit run leaves behind when it is killed after making its local commit
# and before that commit reaches main. The sequence commit → stamp → push is not
# atomic and CANNOT be made atomic — git has no commit-and-push primitive — so
# the window is NARROWED, never closed:
#
#   - The local commit is made inside try_land(), after the landing lock is
#     acquired and immediately before the rebase. The lock wait (up to
#     LOCK_WAIT_SECONDS on a contended lock) is therefore OUTSIDE the window; a
#     kill there leaves nothing committed at all. That wait is where the observed
#     incidents died.
#   - The residual window is commit → stamp → push. A kill inside it still leaves
#     an orphan. There is no trap-based defense for it: a SIGKILL fires no trap
#     (see cleanup()), and `trap 'exit 130' INT TERM` covers only INT/TERM.
#
# So the defense is DETECTION plus a stated recovery, not prevention:
#   - At startup (after MAIN_SHA is pinned), detect_pre_existing_orphan() prints
#     a `graph-commit: orphan-detected: ...` line on EVERY path — the dirty-tree
#     path as well as the nothing-staged one.
#   - At a terminal `not-landed`/`unknown` verdict, print_orphan_recovery_line()
#     names the commit left behind (`graph-commit: orphan=<sha> ...`).
#
# THE RECOVERY IS TO RE-RUN THE SAME INVOCATION, from the same repo, with the
# same argv. It is safe and idempotent: id_files_dirty() finds the id files
# clean (their content is already in the local commit), main() takes the
# nothing-staged branch, and land() rebases HEAD onto fresh origin/main and
# pushes it — which is exactly the orphan being landed. (Per the rc-1 caller
# contract below, an already-landed `--prune <id>` must be dropped from the
# retry argv; nothing else about the argv changes.)
#
# That branch's DIVERGED-AND-NOTHING-STAGED wrong-repo refusal is scoped, per
# id, to a divergence NO unpushed commit of this script's own explains, so it
# cannot fire on this recovery — it used to fire on every orphan (an orphan's
# whole point is that HEAD's blob differs from origin/main's), which made the
# documented recovery unreachable. The exemption is deliberately not a bare
# "the checkout has some unpushed commit": that is true of any stale worktree,
# and would hand the refusal's whole job away (see
# id_divergence_is_own_orphan()).
#
# `git reset --hard origin/main` is NOT a prerequisite for that retry, and the
# older tribal advice to run it first is retired: it DISCARDS the orphan, which
# is the right move only when the intent is to ABANDON the write. Retry to land
# the write; reset to abandon it.
#
# NEVER `git push` an orphan to main by hand. It bypasses the rebase, the
# layer-2/3 merge ladder, and the landing lock, so it can silently clobber a
# concurrent writer's landed edit — the exact failure the fail-closed park path
# exists to prevent.
#
# THE VERDICT LINE — THE CALLER CONTRACT
# --------------------------------------
# Every terminal path prints exactly one line of this shape to stderr, and that
# line — not the exit code, not any other log text — is what a caller reads to
# learn what happened to origin/main:
#
#   graph-commit: verdict: <status> ids=<csv> pushed=<sha|none> main=<sha> context=<context>
#
# optionally followed by ` — <reason phrase>`. Fields:
#   <status>   one of landed | landed-equivalent | parked | not-landed |
#              refused | unknown (see below).
#   ids        comma-joined ALL_IDS (ordinary edits + --prune ids), or empty
#              when the invocation was refused before any id was validated.
#   pushed     the sha this process pushed (or last attempted to push) to main,
#              or `none` when it never reached a push.
#   main       origin/main's tip AS READ AFTER the push (a fresh fetch), or
#              `unknown` when that read failed.
#   context    which terminal path emitted it: push-reported-success |
#              busy-exhausted | noop | park | die.
#
# The status is derived from a POST-PUSH READ OF origin/main, never from this
# process's own push return code. Both directions of that local signal have
# been observed lying — a non-zero exit over a write that DID land, and a clean
# exit over a write that did NOT.
#
#   landed             origin/main contains the sha this process pushed (or, on
#                      the nothing-to-push path, HEAD already IS origin/main).
#   landed-equivalent  the pushed sha is not on origin/main, but origin/main
#                      already carries byte-identical content for every id and
#                      every --prune id is absent there. A peer landed the same
#                      content; the caller's intent is satisfied.
#   parked             the park path only: the PARKING commit is on origin/main,
#                      or — on the idempotent retry, where the node already
#                      carried a byte-identical office_hours block so there was
#                      nothing to commit or push — origin/main already carries
#                      exactly this park's office_hours content for every parked
#                      id. Like `landed-equivalent`, that second arm is decided
#                      by CONTENT rather than ancestry; unlike it, it still
#                      exits 1, because this writer's own content was not landed.
#   not-landed         the read succeeded and none of the above holds.
#   refused            the invocation died before any id was validated, so no
#                      write was ever attempted. No fetch is performed.
#   unknown            the post-push fetch or a git read failed. Nothing is
#                      claimed either way; `unknown` NEVER exits 0.
#
# Exit mapping: landed and landed-equivalent exit 0; every other status exits
# 1 — EXCEPT that usage errors keep exit 2 and --base staleness keeps exit 3.
# One deliberate asymmetry: a die() whose write nonetheless landed prints
# `verdict: landed` and STILL exits 1 (see die()).
#
# This is the same three-valued discipline `verify-landed` (a sibling script)
# exposes to callers that need to ask the question independently; graph-commit
# answers it in-process because it already holds the fetched sha.
#
# Exit status — six observable outcomes across rc 0 and rc 1:
#   0  nothing needed to land, or the edit landed on main. Three sub-cases,
#      distinguished only by a log line (same exit code):
#        nothing-to-push        — every target id already matches origin/main
#          AND HEAD is already origin/main, so nothing this run holds could
#          change main. The landing cycle (lock, scratch push, check poll, push
#          to main) is skipped entirely and NO "landed" line is printed; the
#          log line ends "nothing to push; skipping the landing cycle".
#        landed                 — no concurrent-edit divergence; no special log.
#        landed-after-resolution — a concurrent-edit divergence was auto-merged
#          by layer 2 (rebase-conflict field merge) or layer 3 (stale --base
#          re-read), then landed. The final log line carries the
#          "(layer 2/3 auto-resolved a concurrent-edit divergence)" suffix.
#   1  push could not land, OR the invocation was refused before any write.
#      Three distinct rc-1 sub-cases:
#        busy-main — busy main after all attempts, the required checks never
#          stamped green within the poll window, a required check CONCLUDED
#          non-success (deterministic content failure — no retry), or check-run
#          polling itself failed 3 consecutive times (gh auth/rate-limit/network,
#          surfaced verbatim). NO park is written in this case.
#        mechanical-unresolved-parked — a concurrent-edit CONFLICT that layers
#          1-3 could not auto-merge. Fails closed: this writer's content is NOT
#          landed (no automatic overwrite of the other writer's already-landed
#          edit); the node is parked via office_hours on top of fresh
#          origin/main and this writer's unlanded content is preserved on disk
#          for a manual merge. When the park carries field-level divergence
#          detail, office_hours.reason contains the stable marker
#          "mechanical-unresolved" and office_hours.recommendation holds a
#          per-diverged-field breakdown; a park with no captured field detail
#          keeps the plain "concurrent-edit conflict — manual merge needed"
#          reason and no recommendation. A delete/modify divergence (a
#          concurrent writer's already-landed change deleted the node while
#          this session's edit was in flight) keeps the LANDED DELETION: the
#          node is re-materialized from this session's snapshot only in the
#          local worktree — untracked, never staged, never pushed — carrying
#          the park text, and origin/main still shows it deleted. Nothing is
#          parked ON MAIN for such an id (there is no node there to park), so
#          the stderr says exactly that and deliberately omits the landed-park
#          confirmation substring; a human decides between overriding the
#          deletion and confirming it (see the `deletedSet`-branch
#          recommendation text for the exact two options). Resurrecting a
#          deleted node onto main autonomously would push unreviewed content
#          past the PR/CI gate on the strength of a losing writer's stale
#          --base — e.g. silently reverting a redaction.
#          Carve-out: a --prune id that is NOT itself part of the conflicted
#          set is a bystander — its deletion is independent of whatever id(s)
#          failed to resolve, so it is re-applied and lands WITH the park
#          commit rather than parking (see park_and_exit()). Only a prune id
#          that IS part of the conflicted set keeps this "content is NOT
#          landed" fate. The park commit subject (and, on a failed land, the
#          unlanded-park error) names the parked set and the landed-deletion
#          set separately, so a bystander prune is never described as parked.
#        refused-by-die — a die() call (see `die()` below) prints
#          `error: graph-commit: <msg>` to stderr and exits 1. This sub-case is
#          the PRE-WRITE validation refusals specifically: the existence guards
#          (the ordinary-edit "does not exist — write the node via
#          write-node.ts" guard and both --prune guards), the --expect
#          wrong-repo refusal, the malformed `<id>=<blobsha>` refusal for
#          --base/--expect, the missing-flag-argument checks (-m/-C/--prune/
#          --base/--expect with no value), the not-a-git-repo refusal, the
#          rebase-already-in-progress refusal, and the GRAPH_COMMIT_WRITER
#          refusal for an unrecognized value (see that variable's block below;
#          both accepted values land). All of those run before main()
#          touches the tree: nothing is committed, nothing is pushed, and NO
#          park is written.
#          die() is NOT exclusive to those guards, so `rc 1` plus an
#          `error: graph-commit:` line does not by itself license a caller to
#          assume nothing happened — the stderr text is the discriminator, not
#          the exit code. The die() sites that fire AFTER the tree, the index,
#          or the remote was already mutated:
#            - inside try_land(): the concluded-non-success die and the
#              check-run-polling die — a local commit exists and a `graph/**`
#              scratch branch was already pushed. Both belong to the busy-main
#              sub-case above, which already owns them; they are named here
#              only so the enumeration is not read as exhaustive.
#            - "unexpected land status" on that same path, likewise after the
#              local commit.
#            - check_base_freshness()'s unreadable-base-blob die and
#              try_layer2_resolve()'s broken-staging-invariant die, both of
#              which run after layer 2/3 may have rewritten node files on disk.
#            - park_write()'s "failed to write the office_hours parking record"
#              die, reached from park_and_exit() AFTER
#              `git reset --hard FETCH_HEAD` discarded this writer's tree. That
#              is the one die() that leaves NO park recorded while the writer's
#              content is already gone from the worktree — SNAP_DIR is the only
#              surviving copy.
#        Caller contract: rc 1 does not mean "nothing landed". When the
#          invocation mixed --prune ids with other ids, a bystander prune's
#          deletion may have landed on main together with the park commit. A
#          caller that retries after rc 1 must NOT replay the same argv
#          blindly. Per --prune id, re-derive whether the deletion is still
#          outstanding by asking origin/main directly:
#            git fetch origin main
#            git cat-file -e origin/main:intentions/<id>.md
#          rc 0 = the file is still present on origin/main, the prune is still
#          outstanding — keep `--prune <id>` in the retry argv. rc non-zero =
#          the deletion already landed — DROP `--prune <id>` from the retry
#          argv. (`git cat-file -e` is the quiet existence test, and is the
#          same idiom the script's own prune guard uses.)
#          If an already-landed `--prune <id>` IS re-passed, that guard refuses
#          the retry with rc 1 (not rc 2 — it goes through die()) and this
#          exact stderr line:
#            error: graph-commit: intentions/<id>.md does not exist in HEAD — nothing to prune for '<id>'
#          That rc 1 is an argument-validation refusal raised before any git
#          write: no park is written, no `office_hours` line appears on any
#          node, and no snapshot dir is preserved. It must NOT be misread as a
#          second concurrent-edit conflict. The discriminator an agent can use
#          is that message text plus the ABSENCE of any
#          "graph-commit: parked ..." stderr line.
#          Precondition on that guard: it tests `HEAD:intentions/<id>.md` —
#          the LOCAL checkout's HEAD, NOT origin/main. So it only protects a
#          retry that runs from a repo already synced past the park commit.
#          The park path itself (park_and_exit()) leaves the writer's OWN
#          worktree in exactly that state, since it resets to FETCH_HEAD,
#          commits the deletion, and pushes. But a retry issued from a STALE
#          checkout whose HEAD still contains the node's file passes this
#          guard even though the deletion already landed on origin/main —
#          which is exactly why the `git fetch origin main` step above is
#          mandatory before any retry, not merely a suggestion.
#          The stderr lines above distinguish the parked set from the landed
#          bystander-prune set, and so does the park commit subject; those are
#          the authoritative record of what happened. No in-repo caller
#          currently passes --prune programmatically — pruning is agent-driven
#          via the owed-prune census, not script-driven — so this contract is
#          documented for the agent reading it before a retry, not enforced by
#          a caller check.
#   2  usage error — reserved for the paths that call `exit 2` directly: an
#      unknown `-*` option, no node ids given at all, an id rejected by
#      validate_id_chars (empty, containing a path separator or a comma, or
#      exactly `.` or `..`), and `--expect <id>=...` naming a --prune id. rc 2 does NOT
#      cover every argument problem: the die()-based validation refusals listed
#      under rc 1 above exit 1.
#
# Conventions: mirrors the bounded-retry shape/logging of `gh_retry` in
# .claude/skills/dispatch-propagate/scripts/lib.sh. Per .claude/rules/code-style.md
# it prefers clear errors over silent fallbacks. Per .claude/rules/shell-json.md
# it never pipes a captured variable through `echo` into `jq` — it uses
# `gh api ... --jq` (gh runs jq on its in-memory JSON) for check-run polling.

set -euo pipefail

# --- Paths -----------------------------------------------------------------
# SCRIPT_DIR locates this script's SIBLING scripts/modules on disk — store.js
# (the parking fallback's tsx import) and merge-node.ts (the layer-2 auto-merge
# CLI). Those always live alongside the installed script, so they are resolved
# from SCRIPT_DIR regardless of which checkout the caller is committing.
#
# REPO_ROOT — the checkout whose intentions/ this invocation commits — is
# deliberately NOT derived from SCRIPT_DIR. It is resolved from the CALLER (the
# -C/--repo argument, else cwd) inside main() via `git rev-parse --show-toplevel`
# so graph-commit always commits the caller's checkout, never the checkout this
# script file happens to live in. Deriving it from the script's own location was
# the incident bug: a ../../../-climbing relative invocation from inside a
# worktree resolved to the PRIMARY checkout's copy of this script, silently
# committed the primary checkout, and printed a false "landed" success.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# store.ts is imported by the parking fallback via tsx (.js → .ts resolution).
STORE_MODULE="$SCRIPT_DIR/../src/store.js"
# merge-node.ts is the layer-2 field-level auto-merge CLI (run_merge_node()).
MERGE_NODE_SCRIPT="$SCRIPT_DIR/merge-node.ts"
# REPO_ROOT / INTENTIONS_DIR are caller-derived and set inside main() AFTER
# option parsing (they depend on the parsed -C/--repo argument, so they cannot
# be top-of-file constants resolved before main() runs).

# Total commit → rebase → stamp → push attempts before a pure (conflict-free)
# rejection is declared a busy-main failure. Overridable for tests.
MAX_PUSH_ATTEMPTS="${GRAPH_COMMIT_MAX_ATTEMPTS:-5}"

# How many times try_land() may answer an ORPHANED required check row
# (await_checks rc 3) by deleting the `graph/**` scratch ref and pushing the SHA
# again to buy it a fresh stamping run. Deliberately its OWN budget, small and
# separate from MAX_PUSH_ATTEMPTS: an orphan is recognised at the FIRST poll, so
# one re-stamp costs a push plus a poll — seconds — whereas reading the orphan as
# `pending` burned all MAX_PUSH_ATTEMPTS full CHECK_TIMEOUT_SECONDS green-waits
# and held the graph store's only write path shut for the duration
# (tactic-orphaned-check-run-pins-pending-ci-guard). Charging the re-stamp to the
# landing budget instead would also misreport a GitHub-side orphan as a busy
# main. Overridable for tests.
MAX_ORPHAN_RESTAMPS="${GRAPH_COMMIT_MAX_ORPHAN_RESTAMPS:-2}"

# Fast-path check-run polling: how often to poll and how long to wait for the
# four required contexts to stamp green on a scratch SHA before treating this
# attempt as failed (and rebasing/retrying). Overridable for tests.
CHECK_POLL_SECONDS="${GRAPH_COMMIT_CHECK_POLL_SECONDS:-7}"
CHECK_TIMEOUT_SECONDS="${GRAPH_COMMIT_CHECK_TIMEOUT_SECONDS:-180}"

# Landing-lock tunables (see "# --- Landing lock" below). LOCK_REF is a fixed
# constant, not overridable. LOCK_TTL_SECONDS is how long a claim stays live
# before a waiter may steal it — one full check-stamp window plus a margin
# (default 240s). LOCK_POLL_SECONDS is the poll interval while waiting on a live
# foreign holder. LOCK_WAIT_SECONDS bounds the total time a writer waits to
# acquire before giving up (default 1050s = MAX_PUSH_ATTEMPTS full attempts).
LOCK_REF="refs/graph/landing-lock"
LOCK_TTL_SECONDS="${GRAPH_COMMIT_LOCK_TTL_SECONDS:-$((CHECK_TIMEOUT_SECONDS + 60))}"
LOCK_POLL_SECONDS="${GRAPH_COMMIT_LOCK_POLL_SECONDS:-5}"
LOCK_WAIT_SECONDS="${GRAPH_COMMIT_LOCK_WAIT_SECONDS:-$((MAX_PUSH_ATTEMPTS * (CHECK_TIMEOUT_SECONDS + 30)))}"

# Which primitive BUILDS the commit that lands. Two accepted values:
#
#   worktree  (THE DEFAULT, and what every caller that does not set this
#             variable gets) — commit_files() stages `intentions/<id>.md` into
#             the checkout's own index with `git add` and runs `git commit`, so
#             the commit is HEAD of the checkout graph-commit was pointed at.
#             This is why such a caller must first provision a throwaway
#             checkout whose HEAD is origin/main, and why the run refuses up
#             front when any unrelated tracked file is dirty: the landing loop's
#             `git pull --rebase origin main` refuses outright on a dirty tree.
#   plumbing  — build_commit_plumbing() builds the SAME tree with
#             read-tree/update-index/write-tree against a THROWAWAY index and
#             seals it with `git commit-tree`, touching neither the working
#             tree nor the repo's own .git/index. It needs no checkout at all,
#             which is what eventually removes the provision/remove dance.
#
# BOTH ARE WIRED IN. try_land() runs ONE loop; only the step that produces the
# attempt's SHA differs:
#   worktree  — commit_files(), then `git pull --rebase origin main` (layer 2
#               resolves a textual conflict in place), then `git rev-parse HEAD`.
#   plumbing  — fetch origin/main, reconcile this invocation's nodes against the
#               fresh base (reconcile_plumbing_base(), which routes a SAME-NODE
#               concurrent edit through the same field-level merge layer 2 uses),
#               then build_commit_plumbing() on that base. There is no rebase to
#               conflict, so a push rejected because main advanced is answered by
#               REBUILDING on the new base rather than by replaying a commit.
# Everything downstream of the SHA — the `graph/**` scratch push, await_checks(),
# the landing lock, PUSHED_SHA-before-push, the verdict — is shared verbatim.
#
# The plumbing writer additionally SKIPS three tree-mutating steps the worktree
# writer needs: the unrelated-dirty-tracked-file pre-flight refusal
# (assert_clean_outside_ids — nothing it protects against can happen when no
# rebase runs), the far-ahead rebuild (ensure_intentions_only_base — the commit's
# parent is origin/main by construction, never the checkout's HEAD), and
# park_and_exit()'s whole-tree `git reset --hard`, which becomes a path-scoped
# sync of exactly this invocation's node files. That is the point of the writer:
# a caller's unrelated dirt (a modified flake.lock, say) neither blocks the write
# nor gets destroyed by it.
#
# THE DEFAULT DELIBERATELY STAYS `worktree`. Flipping every caller is a separate
# decision with a separate blast radius; today only
# .claude/skills/dispatch-propagate/scripts/dispatch-eval-finding opts in.
# Unset (the overwhelmingly common case) is exactly `worktree`, so no existing
# caller's control flow is touched by this variable's existence.
GRAPH_COMMIT_WRITER="${GRAPH_COMMIT_WRITER:-worktree}"

# --- Globals set by main() -------------------------------------------------
# IDS         — the node ids to commit (positional args) — ordinary edits whose
#               new content already exists on disk.
# PRUNE_IDS   — ids passed via --prune: tracked in HEAD, must NOT exist on
#               disk; staging them stages a deletion.
# ALL_IDS     — IDS + PRUNE_IDS, computed once in main() after validation.
#               Every helper that needs "every id in this invocation"
#               regardless of edit-vs-prune iterates this, not IDS directly.
# BASE        — optional --base compare-and-swap manifest: node id -> the blob
#               SHA the caller read it at (git hash-object at read time).
#               Empty unless --base was passed; empty means skip the check.
# EXPECT_BLOB — optional --expect assertion manifest: node id -> the blob SHA of
#               the content the caller WROTE (git hash-object after its edit).
#               Empty unless --expect was passed.
# EXPECTED    — associative set of the exact staged paths we permit.
# SNAP_DIR    — tempdir holding this invocation's node content. Per id it holds
#               <id>.md, the writer's FROZEN pre-merge original, and — only when
#               a layer-2/3 merge resolved — <id>.merged.md, graph-commit's own
#               merge output. snap_intended_file() picks between them; see the
#               SNAP_DIR path contract next to snapshot().
# KEEP_SNAP   — 1 when SNAP_DIR must survive exit (the fail-closed conflict
#               path discards the writer's local commit, so the snapshot is the
#               only remaining copy of the writer's content on the DIE paths
#               below; on the ordinary park path the landed office_hours
#               recommendation now carries that content too — park_write()'s
#               ownContentEmbed() — and SNAP_DIR is the convenience copy). Set by
#               park_and_exit(), and by the fail-closed DIE paths that name
#               SNAP_DIR in their message — assert_noop_matches_intent()'s
#               dropped-edit die and run_merge_node()'s "the merge tool could
#               not be executed" die. Never reset to 0: every writer of it is on
#               a terminal path.
# CURRENT_MSG — the commit message commit_files() commits with.
# PARK_CONTENT_DIR — empty until park_write() runs; then a dir holding each
#               parked node's POST-park-write content (origin/main's content
#               plus the office_hours block). It is what a park INTENDS to put
#               on origin/main, and is therefore what print_verdict()'s
#               content-equivalence fallback compares against on the park path.
#               Deliberately NOT SNAP_DIR: that must keep holding the writer's
#               unlanded pre-park edit (and any partial merge of it), which the
#               park recommendation points a human at for the manual merge.
declare -a IDS=()
declare -a PRUNE_IDS=()
declare -a ALL_IDS=()
declare -A BASE=()
declare -A EXPECT_BLOB=()
declare -A EXPECTED=()
SNAP_DIR=""
KEEP_SNAP=0
CURRENT_MSG=""
# TMP_INDEX_DIR — tempdir holding the THROWAWAY index build_commit_plumbing()
# builds its tree in (exported as GIT_INDEX_FILE for exactly those git calls).
# Never the repo's own .git/index, which that writer must not touch. Non-empty
# only for the duration of one build_commit_plumbing() call: that function
# removes the dir on its success path and, via plumb_die(), on every failure
# path. cleanup() removes it again, but only as a backstop for a call made
# directly in this shell — see plumb_die() for why that is not the usual case.
TMP_INDEX_DIR=""
# PLUMB_BASE — the commit this invocation's ON-DISK node content is currently
# reconciled against, and therefore the parent build_commit_plumbing() builds
# on. GRAPH_COMMIT_WRITER=plumbing only.
#
# Seeded on the first attempt to `git merge-base HEAD origin/main` — the fork
# point the writer's edit was actually derived from, which is exactly the base
# `git pull --rebase` would three-way against for the worktree writer. Advanced
# to the fresh origin/main tip on every later attempt, but only AFTER
# reconcile_plumbing_base() has compared each node's blob at the old base with
# its blob at the new one: that comparison is what a rebase conflict used to be,
# and it is the whole same-node-concurrent-edit detection.
#
# Re-pointed at the freshly fetched tip by park_and_exit(), whose own re-fetch
# and path-scoped sync make every earlier base stale: the park content is
# derived from THAT tip, so leaving the old base set would three-way the PARK
# against a base it was never derived from.
PLUMB_BASE=""
# ATTEMPT_SHA — the commit prepare_plumbing_sha() built for the current attempt.
# A global rather than a return value because a bash function can only return a
# status, and that status has to stay free to carry the park signal (10).
ATTEMPT_SHA=""
PARK_CONTENT_DIR=""
# SCRATCH_BRANCH — the throwaway `graph/**` branch name used to stamp SHAs.
# SCRATCH_PUSHED — 1 once we have pushed it at least once, so cleanup() knows to
#                  delete it on the remote on exit.
SCRATCH_BRANCH=""
SCRATCH_PUSHED=0
# LAST_CHECK_DETAIL — a human-readable per-context snapshot of the most recent
# successful check-run poll (e.g. "acceptance=success(3 rows), lint=pending(1
# row), ..."). Written by await_checks(), read by try_land()'s retry and
# terminal messages so a failed landing names the state it actually observed
# instead of guessing at contention (Defect 3).
# LAST_CHECK_SHA — the provenance of that snapshot: the commit it was observed
# on. Written in the SAME statement group as LAST_CHECK_DETAIL and never reset,
# so a later attempt that ends BEFORE any poll (lock wait exhausted, scratch
# push failed, lock stolen) still carries an EARLIER attempt's snapshot for an
# EARLIER commit. Every message therefore renders the pair through
# check_state_phrase(), which compares this against the SHA it is describing so
# a stale snapshot is never presented as a current observation of that SHA.
LAST_CHECK_DETAIL=""
LAST_CHECK_SHA=""
# LAST_LAND_REASON — a short human phrase naming why the last try_land()
# attempt ended, set at each of that loop's exit branches. The terminal exit-11
# message names it as the cause, so the reader is told what actually happened
# rather than being handed a "checks bad, or else lock contention" disjunction
# the code already knows the answer to.
LAST_LAND_REASON=""
# Landing-lock globals (see "# --- Landing lock" below).
# LOCK_HOLDER_ID    — this process's unique claim identity, computed once at
#                     script load: short hostname + PID + two $RANDOM draws.
# LOCK_SHA          — the SHA of the lock commit this process currently believes
#                     it owns (set when a claim/renew/steal push succeeds).
# LOCK_HELD         — 1 iff this process currently holds the lock.
# LOCK_WAIT_DEADLINE — absolute unix-epoch deadline for lock_claim_or_renew() to
#                     give up; set once per try_land() invocation by its caller
#                     (a later unit), not here.
LOCK_HOLDER_ID="${GRAPH_COMMIT_LOCK_HOLDER_ID:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)-$$-$RANDOM$RANDOM}"
LOCK_SHA=""
LOCK_HELD=0
LOCK_WAIT_DEADLINE=0
# ORIG_HEAD / RESTORE_HEAD — set by ensure_intentions_only_base() when the
# worktree HEAD is a far-ahead branch (a PR-branch checkout carrying commits
# that touch non-intentions/ files). To land an intentions/-only SHA the write
# is rebuilt on top of origin/main, which moves the worktree off its original
# HEAD; cleanup() restores ORIG_HEAD on every exit path so the worktree returns
# to its PR tip. Empty/0 for the common case (main checkout or a clean/
# intentions-only worktree), where the in-place path is used unchanged.
ORIG_HEAD=""
RESTORE_HEAD=0
# MAIN_SHA — the SINGLE origin/main tip this invocation reconciles against.
# main() fetches origin/main exactly once (right after the dirty-tree pre-flight,
# before snapshot()) and pins the resulting sha here; every pre-land step —
# check_base_freshness()'s --base CAS, ensure_intentions_only_base()'s far-ahead
# rebuild and its three-way replay, and main()'s nothing-staged blob comparison —
# reads THIS value rather than re-fetching and re-reading FETCH_HEAD. Pinning it
# matters for correctness, not just cost: with independent fetches, the far-ahead
# rebuild could reset onto a main tip NEWER than the one the freshness check
# reconciled against, so an edge landed in between would be reconciled against by
# nobody. The one deliberate exception is park_and_exit(), which re-fetches on
# purpose — the park must land on the freshest main, not on a tip observed
# before the conflict was diagnosed.
MAIN_SHA=""
# RESOLVED_VIA_MERGE — set to 1 the moment any layer-2 (structural field-level
# merge, run_merge_node()) or later layer-3 auto-merge actually resolves a
# concurrent-edit divergence. Read once at the final "landed" log line to append
# a distinct suffix; this is the SAME rc-0 landed exit as a plain landed
# outcome, distinguished only by the log message — no new exit code.
RESOLVED_VIA_MERGE=0
# CONFLICT_FIELDS_JSON — path to a tempfile (created inside SNAP_DIR the first
# time it is needed) holding a JSON ARRAY of unresolved-field objects
# accumulated across every id this invocation could not fully resolve
# (shape: {"id","field","ours","theirs"} for a real field conflict, or a
# {"id","note"} sentinel for a crash / prune-vs-edit). Empty string means the
# file has not been created yet (no captured conflicts). Appends read-modify-
# rewrite via jq so the file stays valid JSON throughout (a pushable array, not
# JSONL). Unit 3/4 also read/write it.
CONFLICT_FIELDS_JSON=""
# PUSHED_SHA — the sha this process pushed (or last ATTEMPTED to push) to main,
# set in try_land() immediately BEFORE `git push origin "$sha:main"`. It is set
# before the push, not after it, precisely because the push's own return code is
# not trustworthy: a process that survives a lying push (either direction) still
# knows which sha it meant to land, and can ask origin/main about that sha.
# Empty means no push was ever attempted.
PUSHED_SHA=""
# VERDICT_EMITTED / LAST_VERDICT — the once-only guard and the computed status
# for the terminal verdict line (see "THE VERDICT LINE" in the header block and
# print_verdict() below). The guard exists because die() itself emits a verdict,
# and die() is reachable from inside the verdict path's own callees.
VERDICT_EMITTED=0
LAST_VERDICT=""
# SNAPSHOT_TAKEN — 1 once snapshot() has run. Everything before it (option
# parsing, the id existence guards, the dirty pre-flight, the --expect
# wrong-repo assertion, the single origin/main fetch) mutates neither the tree,
# the index, nor the remote, so a death there attempted no write at all — which
# is the `refused` verdict, not a content comparison this run has no captured
# intent to make.
SNAPSHOT_TAKEN=0

# RESURRECTED_IDS — the ids park_write() re-materialized on disk from SNAP_DIR
# because a concurrent writer's ALREADY-LANDED change deleted them from
# origin/main (the delete/modify divergence). Populated out of band by the tsx
# helper (GRAPH_COMMIT_RESURRECTED_FILE, NUL-delimited) and empty on every other
# path. These ids are deliberately EXCLUDED from commit_files()' `git add` set:
# the already-landed deletion wins, exactly as the already-landed edit wins
# everywhere else on the fail-closed park path. Re-materialization exists only so
# readNode/writeNode can compose the office_hours record over the writer's real
# authored body and leave it on disk for the human — it is a LOCAL, untracked
# artifact, never content this script pushes back onto main.
RESURRECTED_IDS=()

# True iff <id> was re-materialized by park_write() (see RESURRECTED_IDS).
is_resurrected_id() { # <id>
  local want="$1" got
  for got in ${RESURRECTED_IDS[@]+"${RESURRECTED_IDS[@]}"}; do
    [[ "$got" == "$want" ]] && return 0
  done
  return 1
}

die() {
  echo "error: graph-commit: $*" >&2
  # Emit the verdict before exiting, so the caller learns whether this failure
  # left anything on origin/main.
  #
  # DELIBERATE ASYMMETRY: a die() whose write nonetheless LANDED prints
  # `verdict: landed` and STILL exits 1. A die is an environment failure the
  # caller must see — swallowing it because the content happened to reach main
  # would hide a broken environment — while the verdict line is what tells the
  # caller whether a retry would be a no-op. The two answer different questions,
  # so they are allowed to disagree here and only here.
  print_verdict die
  exit 1
}

usage() {
  echo "usage: graph-commit [-C <repo-path>] [-m <message>] [--prune <id>]... [--base <id>=<blobsha>|<manifest-file>]... [--expect <id>=<blobsha>|<manifest-file>]... <node-id> [<node-id> ...]" >&2
}

# --- Prune / base id helpers -------------------------------------------------
# Shared character/traversal validation for both ordinary and --prune ids.
validate_id_chars() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "error: graph-commit: empty node id" >&2; exit 2
  fi
  # Reject path separators, and `.`/`..` as EXACT ids. `..` as a substring
  # cannot traverse once `/` and `\` are banned (the id is only ever used as
  # the single path component intentions/<id>.md), so ids like
  # `v1..v2-migration` are legal.
  #
  # A comma is rejected for a DELIMITER reason, not a path reason: park_write()
  # carries PRUNE_IDS to its tsx helper as a comma-joined argv value, and the
  # helper decides prune-vs-edit (and therefore whether a missing target file is
  # expected) by membership in that split set. An id containing a comma splits
  # into fragments, the membership test misses, and a prune is misclassified as
  # an edit on the park path — where the misclassification is not merely wrong
  # prose but a failed park. Banning the character at the edge keeps the split
  # total; the helper re-asserts it defensively.
  case "$id" in
    */*|*'\'*)
      echo "error: graph-commit: invalid node id '$id' (path separators not allowed)" >&2
      exit 2 ;;
    *,*)
      echo "error: graph-commit: invalid node id '$id' (commas are not allowed — ids are carried over a comma-delimited channel internally)" >&2
      exit 2 ;;
    .|..)
      echo "error: graph-commit: invalid node id '$id' ('.' and '..' are reserved path names)" >&2
      exit 2 ;;
  esac
}

# Record one <id>=<blobsha> pair into the named associative array (BASE for
# --base, EXPECT_BLOB for --expect). The target array is passed BY NAME and
# bound with a bash nameref (requires bash 4.3; the script already requires
# bash 4 for `declare -A`), so --base and --expect share one parser instead of
# maintaining two copies that can drift.
add_blob_pair() { # <array-name> <flag-name> <pair>
  local -n _target="$1"
  local flag="$2" pair="$3" id sha
  id="${pair%%=*}"
  sha="${pair#*=}"
  if [[ -z "$id" || "$id" == "$pair" || -z "$sha" ]]; then
    die "invalid $flag entry '$pair' (expected <id>=<blobsha>)"
  fi
  _target["$id"]="$sha"
}

# A --base/--expect argument is either a literal <id>=<blobsha> pair or, when it
# names an existing file, a manifest of such pairs (one per line, blank lines
# ignored) — so a caller holding a whole dump's worth of blob shas can pass one
# flag instead of one flag per node.
parse_blob_arg() { # <array-name> <flag-name> <arg>
  local arr="$1" flag="$2" arg="$3"
  if [[ -f "$arg" ]]; then
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" ]] && continue
      add_blob_pair "$arr" "$flag" "$line"
    done <"$arg"
  else
    add_blob_pair "$arr" "$flag" "$arg"
  fi
}

# --- Wrong-repo assertion (--expect) ----------------------------------------
# Assert that the repo this invocation RESOLVED actually holds the content the
# caller wrote. The caller computes `git hash-object -- intentions/<id>.md` in
# its OWN checkout after its edit and passes it as --expect <id>=<sha>; here we
# hash the same path in REPO_ROOT and compare.
#
# Why this exists on top of the nothing-staged guard in main(): that guard only
# fires when the wrongly-targeted repo's blob DIFFERS from origin/main. When the
# wrong repo happens to be in sync with origin/main — the common case for an
# idle checkout — both blobs are equal, the guard passes, and graph-commit
# reports a false "landed" while the caller's real edit sits dirty in a
# different checkout. --expect closes that hole because it asserts the caller's
# POST-edit content, independent of any pre-edit or origin/main state.
#
# Ordering is load-bearing: this must run before check_base_freshness (layer 3's
# auto-merge overwrites $INTENTIONS_DIR/$id.md on disk) and before
# ensure_intentions_only_base (which can `git reset --hard` the tree). Later
# would hash content graph-commit itself rewrote, not the caller's.
#
# Opt-in: no --expect means no behavior change for existing callers.
assert_expected_content() {
  [[ "${#EXPECT_BLOB[@]}" -eq 0 ]] && return 0
  local id
  # Pass 1 — validation. A --prune is a deletion: there is no content to
  # assert, so pinning one is a usage error (exit 2, like the other argument
  # validators; die() would exit 1). Keys naming neither an ordinary id nor a
  # prune id are ignored, matching --base manifest semantics where one batch
  # manifest may cover more nodes than a given invocation commits.
  for id in "${!EXPECT_BLOB[@]}"; do
    if is_prune_id "$id"; then
      echo "error: graph-commit: --expect $id=... names a --prune id — a deletion has no content to assert" >&2
      exit 2
    fi
  done
  # Pass 2 — assertion over the ordinary edit ids only. main() has already
  # cd'd to REPO_ROOT, so the repo-relative path is correct.
  local sha actual
  for id in "${IDS[@]}"; do
    sha="${EXPECT_BLOB[$id]:-}"
    [[ -z "$sha" ]] && continue
    actual="$(git hash-object -- "intentions/$id.md")" \
      || die "could not hash intentions/$id.md in the resolved repo ($REPO_ROOT)"
    if [[ "$actual" != "$sha" ]]; then
      die "the resolved repo ($REPO_ROOT) does not hold the content the caller asserted for intentions/$id.md (--expect $sha, on disk $actual) — the edit was made in a DIFFERENT checkout: mis-pointed -C/--repo (or cwd targeting the wrong checkout). Refusing to land."
    fi
  done
}

# Reconcile each --base entry against origin/main as pinned by main()'s single
# fetch ($MAIN_SHA — this function no longer fetches itself). If an entry's
# blob no longer matches origin/main, a concurrent writer landed an edit to the
# same node since this writer read it. Rather than refusing outright (the old
# behavior — a hard die), attempt a structural three-way merge of the writer's
# intended edit against the freshly-landed content (layer 3), using the same
# run_merge_node() primitive as the rebase-conflict path. There is no git
# rebase-stage inversion here — these are plain file reads, so base/ours/theirs
# map directly: base = the blob the writer read (BASE[$id]), ours = the writer's
# current on-disk edit, theirs = origin/main's landed content ($MAIN_SHA:path).
# A fully-merged node is rewritten on disk so the normal commit+land flow
# proceeds against the fresh origin/main content. A divergence run_merge_node
# cannot resolve is recorded (CONFLICT_FIELDS_JSON); after every entry is
# checked, an unresolved divergence parks the node(s) via park_and_exit() — the
# same structured park an unresolvable rebase conflict takes. This requires
# SNAP_DIR and the EXIT trap to already exist, so main() now sets them BEFORE
# calling this. The 2026-07-06 near-miss motivated the check: a stale dump of a
# live node avoided a textual conflict and nearly clobbered concurrent state.
# Sessions that pass no --base see no change in behavior (opt-in, per
# code-style.md: clear error over a silent fallback).
check_base_freshness() {
  [[ "${#BASE[@]}" -eq 0 ]] && return 0
  echo "graph-commit: checking --base freshness for ${#BASE[@]} node(s) against origin/main" >&2
  local id sha origin_sha path STALE_BASE_UNRESOLVED=0
  for id in "${!BASE[@]}"; do
    sha="${BASE[$id]}"
    path="intentions/$id.md"
    if git cat-file -e "$MAIN_SHA:$path" 2>/dev/null; then
      origin_sha="$(git rev-parse "$MAIN_SHA:$path")"
    else
      origin_sha="<absent>"
    fi
    [[ "$origin_sha" == "$sha" ]] && continue

    # A prune id has no on-disk content to three-way merge, and
    # $INTENTIONS_DIR/$id.md is absent by contract (main() refuses otherwise
    # when a --prune id also names an ordinary edit). Handing merge-node.ts a
    # nonexistent --ours throws ENOENT, which merge-node.ts reports as its exit-3
    # "ran and rejected these inputs" failure and run_merge_node() then records
    # as the generic "the field-level merge tool ran and rejected these inputs"
    # sentinel — the wrong diagnosis, and a doomed merge-tool spawn. Mirror
    # try_layer2_resolve()'s
    # prune early-out instead: record an accurate, prune-specific sentinel and
    # park rather than resolve, so a stale --base on a prune id fails closed
    # instead of resurrecting the pruned file.
    if is_prune_id "$id"; then
      append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "prune base moved — the node changed on origin/main since this writer read it"}]')"
      STALE_BASE_UNRESOLVED=1
      continue
    fi

    # origin/main's copy of this node diverged from the blob the writer read.
    # Attempt a structural three-way merge instead of refusing. base/ours/theirs
    # map directly to plain file reads (no rebase-stage inversion):
    #   base   = the blob the writer originally read (BASE[$id])
    #   ours   = the writer's current intended content (on disk, pre-snapshot)
    #   theirs = origin/main's freshly-landed content ($MAIN_SHA:$path), or the
    #            empty string when the node is now absent on origin/main.
    local base_f theirs_f out_f
    base_f="$SNAP_DIR/.base-merge-$id.base"
    out_f="$SNAP_DIR/.base-merge-$id.out"
    if ! git cat-file -p "$sha" >"$base_f" 2>/dev/null; then
      die "base blob $sha for '$id' is unreadable in the local object database — cannot attempt automatic reconciliation of the stale base"
    fi
    if [[ "$origin_sha" == "<absent>" ]]; then
      theirs_f=""
    else
      theirs_f="$SNAP_DIR/.base-merge-$id.theirs"
      git show "$MAIN_SHA:$path" >"$theirs_f"
    fi
    if run_merge_node "$id" "$base_f" "$INTENTIONS_DIR/$id.md" "$theirs_f" "$out_f"; then
      # Fully resolved: overwrite the on-disk node with the merged content so the
      # write proceeds against exactly origin_sha. RESOLVED_VIA_MERGE is already
      # set to 1 by run_merge_node().
      #
      # The merge output is recorded BESIDE the snapshot, at
      # $SNAP_DIR/$id.merged.md — never over $SNAP_DIR/$id.md, which stays the
      # writer's frozen pre-merge original (see the SNAP_DIR path contract).
      # Downstream steps that want what this run intends to land read it through
      # snap_intended_file(), so ensure_intentions_only_base()'s later
      # re-materialization replays THIS reconciliation rather than reverting it.
      # The split matters on the park path: a batch fails closed as a unit, so a
      # resolved merge here can still end up parked next to an unresolved sibling
      # id, and the losing writer must be handed its own content — not this
      # blend of its content with the concurrent writer's landed edit.
      cp -- "$out_f" "$INTENTIONS_DIR/$id.md"
      cp -- "$out_f" "$(snap_merged_file "$id")"
      continue
    fi
    # run_merge_node() already appended the unresolved fields to
    # CONFLICT_FIELDS_JSON. Record the divergence but keep checking every
    # remaining --base id so the eventual park names them all.
    STALE_BASE_UNRESOLVED=1
  done

  if [[ "${STALE_BASE_UNRESOLVED:-0}" -eq 1 ]]; then
    park_and_exit   # Unit 2's extracted fail-closed park — never returns
  fi
}

# --- Cleanup (EXIT trap) ---------------------------------------------------
# Remove the snapshot tempdir and delete the throwaway `graph/**` scratch branch
# on the remote. Runs on every exit path (success, busy-main, parking fallback,
# or an unexpected die). The remote delete is best-effort — a leftover scratch
# branch is harmless and would be overwritten by the next same-PID run — so its
# failure never masks the real exit status.
cleanup() {
  local rc=$?
  # Abort a rebase this run stranded. main() refuses to start at all when a
  # rebase is ALREADY in progress (see the pre-flight check there, which
  # deliberately runs BEFORE this trap is installed), so any rebase still in
  # progress here was necessarily started by THIS run's `git pull --rebase` —
  # that is the load-bearing premise for aborting unconditionally, with no
  # separate "did we start it" flag.
  #
  # This MUST precede the RESTORE_HEAD `git reset --hard` below: a reset --hard
  # inside a live rebase moves the tree but leaves the rebase state dir behind,
  # which is exactly the mid-operation residue this is meant to clear.
  #
  # Deliberately incomplete: a SIGKILL fires no trap at all, so this cannot be
  # the only defense. provision-node-worktree's precondition guard (which
  # detects and repairs an abandoned rebase before handing a worktree to a
  # session) is the primary one; this is the secondary, cheap backstop.
  # Best-effort (|| true), on the same footing as the lock release and the
  # scratch-branch delete below — its failure must never mask the real exit
  # status, which this function still returns as $rc.
  if rebase_in_progress; then
    git rebase --abort >&2 || true
  fi
  # Restore the original (far-ahead) HEAD if ensure_intentions_only_base() moved
  # the worktree onto origin/main to land an intentions/-only SHA. The intended
  # edit is already on main by this point (or failed to land); either way the
  # worktree returns to the PR tip it started on. Best-effort — a restore
  # failure must not mask the real exit status, and origin/<branch> still holds
  # the tip regardless.
  if [[ "$RESTORE_HEAD" -eq 1 && -n "$ORIG_HEAD" ]]; then
    git reset --hard "$ORIG_HEAD" >&2 || true
  fi
  if [[ -n "$SNAP_DIR" && "$KEEP_SNAP" -eq 0 ]]; then
    rm -rf "$SNAP_DIR"
  fi
  # Backstop for build_commit_plumbing()'s throwaway index dir. That function
  # removes it itself on success and, via plumb_die(), on every failure path,
  # so this only does real work if some future path unwinds past both.
  # Integrated here rather than behind a second trap: a competing EXIT trap
  # would REPLACE this one, silently disabling the snapshot removal, the
  # scratch-branch delete and the lock release.
  # NOTE this backstop only sees the variable when the builder ran in THIS
  # shell. Its documented contract is to print the commit sha on stdout, so a
  # caller invokes it as `$(…)` and the assignment stays in that subshell —
  # which is precisely why plumb_die(), not this line, is the real guarantee.
  # A no-op whenever GRAPH_COMMIT_WRITER is left at its `worktree` default,
  # which never sets this variable.
  if [[ -n "$TMP_INDEX_DIR" ]]; then
    rm -rf "$TMP_INDEX_DIR"
  fi
  if [[ "$SCRATCH_PUSHED" -eq 1 && -n "$SCRATCH_BRANCH" ]]; then
    git push origin --delete "$SCRATCH_BRANCH" >&2 || true
  fi
  # Best-effort backstop: in the common paths try_land() already released the
  # lock and reset LOCK_HELD=0, so this is a no-op there. It only does real
  # work when the script dies before reaching try_land()'s own release calls
  # (the two die() paths, or any other unexpected die()).
  if [[ "$LOCK_HELD" -eq 1 ]]; then
    lock_release
  fi
  return "$rc"
}

# --- Guard -----------------------------------------------------------------
# Defense in depth: assert the staged set is a SUBSET of the requested
# intentions/<id>.md paths — nothing outside intentions/, and no node file
# other than the ones named on the command line. Its one job is to catch a
# stray or cross-contaminated staged path; it does NOT decide whether there is
# anything to commit. An empty staged set is tolerated here (returns cleanly) —
# main() gates commit_files() behind id_files_dirty(), so this guard is
# only reached when there is genuinely something to stage. Treating "empty" as
# an error here was the bug that broke idempotent re-invocation after a partial
# failure (a local commit that never pushed left the tree clean, so the re-run's
# `git add` staged nothing and this guard wrongly diagnosed "already at the
# desired state" instead of "already committed, still needs to push").
assert_staged_safe() {
  local staged
  staged="$(git diff --cached --name-only)"
  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ -z "${EXPECTED[$path]:-}" ]]; then
      echo "error: graph-commit: refusing to commit — staged path outside the requested node set: '$path'" >&2
      echo "       graph-commit stages exactly intentions/<id>.md for the given ids; nothing else." >&2
      exit 1
    fi
  done <<<"$staged"
}

# --- Snapshot ----------------------------------------------------------------
# The desired on-disk content of each node (written by write-node.ts) is
# captured to SNAP_DIR before landing. On the fail-closed conflict path the
# writer's local conflicting commit is discarded (reset --hard to fresh
# origin/main), so this snapshot becomes the only surviving copy of the
# writer's content — cleanup() keeps SNAP_DIR on that path (KEEP_SNAP=1) and
# the park message points at it for the manual merge.
#
# SNAP_DIR/<id>.md IS a frozen pre-merge copy: snapshot() writes it once, here,
# and no later step rewrites it. It is this session's own content as it stood on
# disk when the invocation began, which is what a park must be able to hand back
# to the losing writer. A merge result never lands on top of it — it goes to
# <id>.merged.md beside it (see the SNAP_DIR path contract below).
snapshot() {
  local id
  for id in "${IDS[@]}"; do
    cp -- "$INTENTIONS_DIR/$id.md" "$SNAP_DIR/$id.md"
  done
  # Marks the boundary print_verdict() uses to tell "died before attempting any
  # write" (refused) from "attempted a write whose fate must be read off
  # origin/main".
  SNAPSHOT_TAKEN=1
  # PRUNE_IDS are deliberately skipped: a prune id has no on-disk file to
  # copy, and there is no writer-authored content to preserve for it. The
  # deletion is re-applied after each re-sync to fresh origin/main instead —
  # ensure_intentions_only_base() re-deletes every PRUNE_IDS file, and
  # park_and_exit() re-deletes every PRUNE_IDS file NOT itself implicated in
  # the conflict (see conflicted_ids()) — so a bystander prune still lands.
}

# --- SNAP_DIR path contract --------------------------------------------------
# TWO files can exist under SNAP_DIR for one id, and they answer two different
# questions. Keep them straight:
#
#   <id>.md         the writer's FROZEN pre-merge original, written once by
#                   snapshot() (before check_base_freshness() runs) and never
#                   rewritten. On a park it is the only surviving copy of this
#                   session's own content, which is what the park recommendation
#                   points a human at for the manual merge.
#   <id>.merged.md  graph-commit's OWN merge output for that id, written only
#                   when a layer-2/3 merge RESOLVED — by check_base_freshness()
#                   (stale --base reconciliation), replay_snapshot_onto_base()
#                   (the far-ahead rebuild's three-way replay) and
#                   reconcile_plumbing_base() (the plumbing writer's fresh-base
#                   reconciliation). It carries the writer's delta merged with a
#                   concurrent writer's landed content, so it is neither purely
#                   this session's content nor anything that has landed: on the
#                   park path the batch fails closed and lands nothing.
#
# Every reader that means "what this run INTENDS TO LAND" goes through
# snap_intended_file() — the merged file when it exists, else the frozen
# original. That preference is load-bearing on the far-ahead rebuild, which
# re-materializes each node from SNAP_DIR after resetting the tree to fresh
# origin/main: replaying the frozen original there would silently revert a
# reconciliation this run already performed (test-graph-commit.sh case 48).
#
# NAMING ASSUMPTION: the two files share a directory, so a batch holding both an
# id X and an id literally named "X.merged" would have X's merge output land on
# X.merged's frozen original. No id in the graph is shaped that way, and the
# collision is named here rather than guarded so the assumption is visible if it
# ever stops holding.
#
# The one reader that means "the writer's OWN content" is park_write()'s
# recommendation text, and it names BOTH paths and labels which is which — a
# losing writer must be able to tell its own edit from graph-commit's partial
# merge of it. Deciding which content a human is pointed at lives THERE, in one
# place, not spread across that function's branches.
snap_merged_file() { printf '%s' "$SNAP_DIR/$1.merged.md"; }
snap_intended_file() {
  local merged="$SNAP_DIR/$1.merged.md"
  if [[ -f "$merged" ]]; then
    printf '%s' "$merged"
  else
    printf '%s' "$SNAP_DIR/$1.md"
  fi
}

# --- Layer-2 conflict accumulation ------------------------------------------
# CONFLICT_FIELDS_JSON holds a JSON ARRAY of unresolved-field objects (see the
# globals block). We keep it a valid JSON array throughout — appending is a
# read-modify-rewrite via jq, not a JSONL append — so any later reader (Unit
# 3/4) can `jq` it directly. The file lives inside SNAP_DIR, which exists for
# the lifetime of any run that reaches try_land().

# Lazily create the accumulator file as an empty array the first time it's used.
init_conflict_fields() {
  if [[ -z "$CONFLICT_FIELDS_JSON" ]]; then
    CONFLICT_FIELDS_JSON="$SNAP_DIR/conflict-fields.json"
    printf '[]' >"$CONFLICT_FIELDS_JSON"
  fi
}

# Append a JSON array of objects (compact JSON passed on $1) onto
# CONFLICT_FIELDS_JSON, rewriting the whole file so it stays a valid array.
append_conflicts() {
  local arr="$1" tmp
  init_conflict_fields
  tmp="$(mktemp "$SNAP_DIR/.cf.XXXXXX")" || die "could not create temp file for conflict-fields append"
  jq --argjson add "$arr" '. + $add' "$CONFLICT_FIELDS_JSON" >"$tmp"
  mv -- "$tmp" "$CONFLICT_FIELDS_JSON"
}

# --- Layer 2: structural field-level auto-merge -----------------------------
# run_merge_node <id> <base-file-or-empty> <ours-file> <theirs-file-or-empty> <out-file>
# Invokes MERGE_NODE_SCRIPT (merge-node.ts) to three-way merge one node's
# frontmatter fields, and routes its THREE-way exit contract (see the header of
# merge-node.ts) to three different destinations:
#
#   exit 0 + parsable JSON — the tool ran and reached a verdict. Fully resolved:
#     <out-file> holds the valid merged content, RESOLVED_VIA_MERGE is set to 1,
#     returns 0. Partially/not resolved: appends one entry per unresolved field
#     to CONFLICT_FIELDS_JSON and returns 1.
#   exit 3 — the tool ran and REJECTED THESE INPUTS (unparseable frontmatter, an
#     unreadable path). That is a content-shaped outcome: appends one generic
#     sentinel to CONFLICT_FIELDS_JSON and returns 1, so the caller fails closed
#     and parks exactly as it does for an enumerable divergence.
#   anything else — the tool COULD NOT BE EXECUTED (an unresolvable `tsx`, a
#     sandbox denial, a broken interpreter), or it ran and broke its own stdout
#     contract. Sets KEEP_SNAP=1 and DIES with the captured stderr.
#
# CONTRACT (this replaced an earlier "NEVER dies"): this function never dies for
# a CONTENT outcome — a per-node divergence is expected, recoverable state — and
# ALWAYS dies when the merge tool could not be executed. A broken environment is
# a clear error (code-style.md), not graph state: parking it would write a
# durable, human-visible office_hours block onto main blaming a divergence that
# never happened. Misclassification is deliberately biased toward die, never
# toward a spurious park. Dying from here is safe at every call site: cleanup()
# is the EXIT trap, and ensure_intentions_only_base() sets ORIG_HEAD/RESTORE_HEAD
# BEFORE its `git reset --hard`, so a non-return still restores the PR tip.
#
# Per shell-json.md, stdout is captured into a variable FIRST, then parsed via a
# here-string (`jq <<<"$var"`), never `echo "$var" | jq`.
run_merge_node() {
  local id="$1" base="$2" ours="$3" theirs="$4" out="$5"
  local captured rc=0 err_f="$SNAP_DIR/.merge-stderr-$id"
  # merge-node.ts prints one line of JSON on stdout for BOTH the resolved and
  # the unresolved outcomes, and NO JSON (stderr only) on every failure. Capture
  # stdout into a variable and stderr into a file under SNAP_DIR (cleanup()
  # removes it, and KEEP_SNAP=1 preserves it alongside the writer's content on
  # the die path) so the die message below can quote it verbatim.
  captured="$( (cd "$SCRIPT_DIR" && node --import tsx/esm "$MERGE_NODE_SCRIPT" \
      --base "$base" --ours "$ours" --theirs "$theirs" --out "$out") 2>"$err_f" )" || rc=$?
  # Still let it reach the terminal: capturing must not SWALLOW the diagnostics
  # a human watching the run relies on.
  if [[ -s "$err_f" ]]; then
    cat -- "$err_f" >&2
  fi

  # The tool ran and rejected these inputs: enumerable-or-not, it is a content
  # outcome. Record the generic sentinel and report unresolved, do not die.
  if [[ "$rc" -eq 3 ]]; then
    append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "the field-level merge tool ran and rejected these inputs"}]')"
    return 1
  fi

  # Any other non-zero status, or rc 0 with stdout that is not valid JSON: the
  # tool never started, or it broke its stdout contract. Neither is a divergence
  # to park — see the CONTRACT note above.
  if [[ "$rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$captured"; then
    # The writer's only surviving copy of its unlanded content can be SNAP_DIR
    # (the far-ahead path has already reset the tree), so keep it past this exit
    # exactly as park_and_exit() does.
    KEEP_SNAP=1
    die "the field-level merge tool could not be executed for '$id' (exit $rc, no parsable JSON on stdout) — this is a broken execution environment, NOT a content divergence, so NO office_hours park was written and NOTHING was pushed to main. This writer's unlanded content is preserved at $SNAP_DIR. merge tool stderr: $(cat -- "$err_f" 2>/dev/null || true)"
  fi

  if [[ "$(jq -r '.resolved' <<<"$captured")" == "true" ]]; then
    # merge-node.ts wrote <out>; the merged content is ready for the caller.
    RESOLVED_VIA_MERGE=1
    return 0
  fi

  # resolved==false: one {id, field, ours, theirs} entry per unresolved field.
  append_conflicts "$(jq -c --arg id "$id" '[.conflicts[] | {id: $id, field, ours, theirs}]' <<<"$captured")"
  return 1
}

# --- Far-ahead worktree: rebuild the edit on an intentions/-only base --------
# The `graph/**` fast path stamps the four required checks only on an
# intentions/-only SHA — its guard (.github/workflows/graph-fast-path.yml)
# fails the scratch push if `git diff --name-only origin/main...HEAD` names any
# path outside intentions/. When graph-commit runs inside a PR-branch worktree
# whose HEAD carries the PR's code diff, a commit made on top of that HEAD is
# NOT intentions/-only, so the scratch push is rejected, the checks never
# stamp, and the land times out. Callers used to hand-roll a "reset dance"
# around graph-commit (save HEAD, reset --hard origin/main, re-apply the node,
# commit, restore) to avoid this; park-node and the Stop-hook node-lane
# escalation seam did not, so an escalation-park from a far-ahead worktree
# silently failed and the node looped.
#
# This makes graph-commit far-ahead-safe at the source: when HEAD is ahead of
# origin/main with non-intentions changes, rebuild the intended edit on top of
# fresh origin/main — reset the tree to $MAIN_SHA, then REPLAY the snapshotted
# node content (edits) and deletions (prunes) onto it — so the normal
# commit+land flow runs on an intentions/-only base. cleanup() restores the
# original HEAD on exit. A worktree already at/behind origin/main, or ahead
# with only intentions/ commits, needs no rebuild and is left untouched (the
# in-place path is unchanged for the main-checkout and clean-worktree callers).
#
# The replay is a THREE-WAY MERGE, not a blind copy. Its base is the merge-base
# of HEAD and $MAIN_SHA — the fork point the writer's edit was actually derived
# from — computed BEFORE the reset moves HEAD. Per id:
#   - the fork blob equals origin/main's blob → origin/main has not touched this
#     node since the fork, so the snapshot is still a valid replay and is copied
#     in verbatim (no merge invoked: the common far-ahead case stays merge-free);
#   - they differ → another writer landed an edit to this node after the fork,
#     so the snapshot is three-way merged against it (run_merge_node, base = the
#     fork blob, ours = what this run intends to land per snap_intended_file(),
#     theirs = origin/main's blob). A resolved merge is written to the working
#     tree and to SNAP_DIR/<id>.merged.md, never over the frozen
#     SNAP_DIR/<id>.md — see the SNAP_DIR path contract.
# A prune is guarded the same way: main carrying a post-fork edit to a node this
# invocation means to delete is a prune-vs-concurrent-edit conflict, not a
# deletion to force through. Any divergence the merge cannot resolve parks the
# node(s) via park_and_exit() rather than silently overwriting the other
# writer's landed edit — the fail-closed discipline layers 1-3 already follow.
# The blind `cp` this replaced was a silent-revert hole: any landing between
# snapshot() and the fetch was overwritten with no conflict, park, or diagnostic.
#
# NOTE (deployment): `git reset --hard` is a tree-updating op; when this script
# is driven through the sandboxed Bash tool it needs dangerouslyDisableSandbox
# if origin/main advanced read-only paths (.claude/skills/**, config/) — see
# .claude/rules/sandbox.md. That is a caller concern (every graph-commit caller
# already sets it), not resolved here. Must run AFTER snapshot() so SNAP_DIR
# holds the writer's content before the reset overwrites the working tree.
# blob_sha_or_empty <commit-ish> <id> — print the blob sha of intentions/<id>.md
# at <commit-ish>, or the EMPTY STRING when the file does not exist there. Same
# existence idiom check_base_freshness() uses (cat-file -e to test, rev-parse to
# read), with "absent" encoded as "" so callers can compare two sides directly
# and pass the result straight through to merge-node.ts's empty-arg convention
# (mirrors stage_file_or_empty()).
blob_sha_or_empty() {
  local rev="$1" id="$2"
  if git cat-file -e "$rev:intentions/$id.md" 2>/dev/null; then
    git rev-parse "$rev:intentions/$id.md"
  else
    printf '%s'
  fi
}

# replay_snapshot_onto_base <id> <fork-sha> — re-materialize one snapshotted node
# onto the freshly-reset $MAIN_SHA tree, reconciling with anything origin/main
# landed for that node since <fork-sha> (the merge-base of the writer's HEAD and
# $MAIN_SHA). Returns 0 when the working-tree copy now holds this invocation's
# intended content, 1 when the divergence was unresolvable (run_merge_node has
# already recorded the unresolved fields in CONFLICT_FIELDS_JSON, and
# RESOLVED_VIA_MERGE is set by it on the resolving path). All tempfiles live
# under SNAP_DIR so cleanup() removes them.
replay_snapshot_onto_base() {
  local id="$1" fork_sha="$2"
  local fork_blob main_blob
  fork_blob="$(blob_sha_or_empty "$fork_sha" "$id")"
  main_blob="$(blob_sha_or_empty "$MAIN_SHA" "$id")"

  # Fast path: origin/main has not touched this node since the fork point
  # (including "absent at both"), so the snapshot is still a valid replay. What
  # gets replayed is what this run intends to land — an earlier layer-3 merge's
  # output when there was one, else the frozen snapshot (SNAP_DIR path contract).
  if [[ "$fork_blob" == "$main_blob" ]]; then
    cp -- "$(snap_intended_file "$id")" "$INTENTIONS_DIR/$id.md"
    return 0
  fi

  # Divergent: another writer landed an edit (or a deletion) to this node after
  # the fork point. Three-way merge rather than overwrite. An absent side is
  # passed as the empty string, merge-node.ts's "this side did not exist".
  local base_f="" theirs_f="" out_f="$SNAP_DIR/.replay-$id.out"
  if [[ -n "$fork_blob" ]]; then
    base_f="$SNAP_DIR/.replay-$id.base"
    git cat-file -p "$fork_blob" >"$base_f"
  fi
  if [[ -n "$main_blob" ]]; then
    theirs_f="$SNAP_DIR/.replay-$id.theirs"
    git cat-file -p "$main_blob" >"$theirs_f"
  fi
  if run_merge_node "$id" "$base_f" "$(snap_intended_file "$id")" "$theirs_f" "$out_f"; then
    cp -- "$out_f" "$INTENTIONS_DIR/$id.md"
    # Record the merge output beside the snapshot, not over it: $SNAP_DIR/$id.md
    # stays the writer's frozen original for the park recommendation, and this
    # file becomes what snap_intended_file() hands to every later reader that
    # asks what this invocation intends to land.
    cp -- "$out_f" "$(snap_merged_file "$id")"
    return 0
  fi
  return 1
}

ensure_intentions_only_base() {
  local nonint
  # Same diff spec the fast-path guard uses: three-dot (changes on HEAD's side
  # of the merge-base), name-only, then drop everything under intentions/.
  nonint="$(git diff --name-only "$MAIN_SHA"...HEAD | grep -v '^intentions/' || true)"
  [[ -z "$nonint" ]] && return 0
  echo "graph-commit: worktree HEAD is ahead of origin/main with non-intentions changes — rebuilding the edit on an intentions/-only base (HEAD restored on exit)" >&2
  # Set the HEAD-restore state BEFORE the reset below, so a park taken from
  # inside this function — an unresolvable replay, or a --prune racing a
  # concurrent edit — still returns the worktree to its PR tip via cleanup().
  ORIG_HEAD="$(git rev-parse HEAD)"
  RESTORE_HEAD=1
  # The fork point MUST be computed before the reset — `git reset --hard` moves
  # HEAD to $MAIN_SHA, after which merge-base HEAD $MAIN_SHA is just $MAIN_SHA
  # and every replay would look like a no-op fast path. Clear error, no fallback
  # (code-style.md): without a real fork point the replay has no base to
  # three-way against, and guessing one is exactly the silent-revert hole this
  # replaced.
  local fork_sha
  fork_sha="$(git merge-base HEAD "$MAIN_SHA")" \
    || die "could not compute the merge-base of HEAD and origin/main ($MAIN_SHA) — the far-ahead rebuild has no fork point to replay this invocation's snapshot against"
  git reset --hard "$MAIN_SHA" >&2
  local id unresolved=0
  for id in "${IDS[@]}"; do
    replay_snapshot_onto_base "$id" "$fork_sha" || unresolved=1
  done
  local prune_fork prune_main
  for id in "${PRUNE_IDS[@]}"; do
    prune_fork="$(blob_sha_or_empty "$fork_sha" "$id")"
    prune_main="$(blob_sha_or_empty "$MAIN_SHA" "$id")"
    # A deletion has nothing to three-way merge, so guard it instead: when
    # origin/main still holds this node AND its content moved since the fork
    # point, another writer landed an edit this prune never saw. Forcing the
    # `rm -f` through would destroy that edit exactly as the old blind copy did.
    # Same sentinel shape layer 2 records for a prune-vs-edit rebase conflict.
    if [[ -n "$prune_main" && "$prune_main" != "$prune_fork" ]]; then
      append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "prune vs. concurrent edit"}]')"
      unresolved=1
      continue
    fi
    # Unchanged since the fork, or already deleted on main too — safe to delete.
    rm -f -- "$INTENTIONS_DIR/$id.md"
  done
  # Fail closed. ORIG_HEAD/RESTORE_HEAD are already set above, so cleanup() still
  # returns the worktree to its PR tip on this park path.
  if [[ "$unresolved" -eq 1 ]]; then
    park_and_exit   # never returns
  fi
}

# --- Is there anything new to commit? --------------------------------------
# Return 0 iff at least one intentions/<id>.md differs from HEAD (either a
# working-tree change or an already-staged one). This is the state discriminator
# that makes graph-commit safely re-invocable after a partial failure:
#   - dirty   → there is new content to stage → commit_files() then land().
#   - clean   → nothing new to stage; the id file(s) already match the last
#               commit. Either HEAD already equals origin/main (truly nothing to
#               do) OR a prior attempt already committed the desired content and
#               only failed to push. Both collapse to the same action: skip
#               commit_files() and land whatever HEAD already is — try_land()
#               trivially no-ops when HEAD == origin/main, or pushes the pending
#               local commit(s) forward when HEAD is ahead.
# Scoped strictly to the requested id paths, so incidental dirt elsewhere in the
# tree (e.g. an unrelated package-lock.json diff) never flips this to "dirty".
# Resurrected ids (park_write()'s delete/modify re-materialization) are excluded
# for the same reason commit_files() refuses to stage them: their on-disk file is
# a local artifact that must never be committed, and counting it as "dirty" here
# would send commit_files() into a `git commit` with an empty index (which fails
# under `set -e`) whenever it is the only dirty path.
id_files_dirty() {
  local id paths=()
  for id in "${ALL_IDS[@]}"; do
    is_resurrected_id "$id" && continue
    paths+=("intentions/$id.md")
  done
  # Nothing committable at all (every id was resurrected): explicitly not dirty.
  # `git status --porcelain --` with no pathspec would scan the WHOLE tree.
  [[ "${#paths[@]}" -gt 0 ]] || return 1
  [[ -n "$(git status --porcelain -- "${paths[@]}")" ]]
}

# --- No-op integrity: the caller's INTENT vs. what origin/main carries -------
# The last gate before main() reports `noop`, and the only guard on that path
# that reads what the CALLER meant to land. Every other one compares two views
# of the REPOSITORY to each other — HEAD's blob against origin/main's (the
# nothing-staged die in main()), the tree against HEAD (id_files_dirty) — and
# none of them ever asks whether either view still carries the caller's edit.
#
# That is exactly the invariant the far-ahead rebuild breaks:
# ensure_intentions_only_base() runs `git reset --hard "$MAIN_SHA"`, after which
# HEAD:intentions/<id>.md and $MAIN_SHA:intentions/<id>.md are equal BY
# CONSTRUCTION, for every id, always. The wrong-repo die can no longer fire, the
# tree reads clean, HEAD == origin/main — and `noop` reports success for a run
# whose edit was dropped somewhere between the writer and the tree. The incident
# this was written for (2026-08-14) printed
# `verdict: landed ids=… pushed=none main=4666cf8a context=noop` while
# origin/main still held the pre-edit body
# (tactic-eval-finding-noop-verdict-hides-dropped-node-edit).
#
# So assert the one thing nothing else asserts: for every id this run captured
# an intent for, the content it INTENDS TO LAND is byte-identical to what
# origin/main carries. Equal → the no-op is genuine and main() proceeds.
# Different → the caller's edit is not on main and this run is not going to put
# it there, so refuse rather than report a landing. `noop` is thereby
# unreachable on any path that reset the tree out from under the edit.
#
# WHICH content is "intended" is snap_intended_file()'s call, not this
# function's (SNAP_DIR path contract): a layer-2/3 merge that RESOLVED for an id
# makes its output the intent, and comparing the frozen pre-merge original
# instead would refuse the legitimate case where the merge concluded this
# writer's whole delta is already on origin/main.
#
# DIE, not park. A park is for a two-writer content divergence a human can
# reconcile from both sides; it lands an office_hours record on the node and
# needs the conflict detail CONFLICT_FIELDS_JSON carries, which this path has
# none of. What this detects is this run's own tree no longer carrying the
# caller's edit — an environment/targeting failure whose fix is to re-run from
# the checkout that holds the edit, exactly like the sibling refusal in the same
# block. die() still routes through print_verdict, which re-reads origin/main
# and reports `not-landed`, so the caller gets the honest answer on the same
# contract line.
#
# Skipped, per id, only where there is genuinely no intent to compare:
#   - a --prune id: snapshot() captures no file for it and its intent is
#     ABSENCE, already answered by main()'s per-id blob loop.
#   - an id snapshot() never captured: nothing to compare (print_verdict calls
#     that `unknown`).
assert_noop_matches_intent() {
  local id intended_file intended observed base_note
  for id in "${ALL_IDS[@]}"; do
    is_prune_id "$id" && continue
    [[ -n "$SNAP_DIR" && -f "$SNAP_DIR/$id.md" ]] || continue
    intended_file="$(snap_intended_file "$id")"
    intended="$(git hash-object "$intended_file")" \
      || die "could not hash this invocation's intended content for '$id' ($intended_file) — refusing to report a no-op without comparing what this run meant to land against origin/main"
    observed="$(git rev-parse -q --verify "$MAIN_SHA:intentions/$id.md" 2>/dev/null || true)"
    [[ "$intended" == "$observed" ]] && continue
    # A --base entry for an id that ALREADY EXISTS on origin/main is the most
    # suspicious shape of all: the caller read that blob, edited it, and told
    # graph-commit which blob it was editing — it demonstrably believed it was
    # changing something. Say so, rather than leaving the reader to infer it.
    base_note=""
    if [[ -n "${BASE[$id]:-}" && -n "$observed" ]]; then
      base_note=" This invocation passed --base $id=${BASE[$id]} for a node that already exists on origin/main, so the caller demonstrably believed it was changing something."
    fi
    # The writer's content may exist nowhere else: on the far-ahead rebuild path
    # the `git reset --hard` already discarded the on-disk edit, and cleanup()
    # would delete SNAP_DIR on the way out. Keep it and name it, the same way
    # the park path does.
    KEEP_SNAP=1
    die "this run intended to land content for intentions/$id.md that is NOT what origin/main carries, yet nothing was staged and nothing this tree holds could land it (every id already matches origin/main, and HEAD is at or behind it — or, for the plumbing writer, HEAD is not the subject at all) — so nothing is going to land it (intended blob=$intended from $intended_file, origin/main blob=${observed:-<absent>} at ${MAIN_SHA:0:8}). The caller's edit was dropped between the writer and this tree: the far-ahead rebuild's 'git reset --hard' makes HEAD and origin/main equal for every id, so the nothing-staged wrong-repo guard cannot see this, and the no-op short-circuit would otherwise report a false 'landed' for an edit that never reached main.$base_note This invocation's content is preserved at $SNAP_DIR — re-run graph-commit from the checkout that holds the edit, or re-apply it from that directory. Refusing to emit a false 'landed' for a run whose intended content is not on origin/main."
  done
}

# --- Pre-existing orphan detection ------------------------------------------
# An ORPHAN is a local commit this repo carries that origin/main does not: the
# residue of an EARLIER graph-commit run killed between its local commit and a
# successful push (see the ORPHAN-WINDOW CONTAINMENT comment in try_land()).
# Announce it at startup, on EVERY path — the dirty-tree path as much as the
# nothing-staged one. The nothing-staged branch used to be the only place that
# said anything about unpushed local commits, so a run that also had new content
# to stage landed the orphan silently and the operator never learned it had
# existed (and, not knowing the sanctioned recovery, was liable to hand-push it).
#
# Called once from main(), right after MAIN_SHA is pinned.
#
# Deliberately silent for a far-ahead PR-branch checkout (HEAD ahead of
# origin/main with NON-intentions commits): that is a legitimate worktree state
# ensure_intentions_only_base() rebuilds against and cleanup() restores, not an
# abandoned write. Only an intentions/-only ahead-ness can be this script's own
# residue.
detect_pre_existing_orphan() {
  local count nonint shas
  count="$(git rev-list --count "$MAIN_SHA..HEAD" 2>/dev/null || echo 0)"
  [[ "${count:-0}" -gt 0 ]] || return 0
  nonint="$(git diff --name-only "$MAIN_SHA"...HEAD | grep -v '^intentions/' || true)"
  [[ -z "$nonint" ]] || return 0
  shas="$(git rev-list --abbrev-commit "$MAIN_SHA..HEAD" 2>/dev/null | tr '\n' ' ')"
  shas="${shas% }"
  echo "graph-commit: orphan-detected: $count local commit(s) not on origin/main ($shas) — re-running this invocation rebases and lands them; do NOT git push them by hand" >&2
}

# --- Is THIS id's divergence explained by an orphan THIS SCRIPT made? --------
# Answers the one question the nothing-staged branch's wrong-repo backstop turns
# on, per id: HEAD's blob for $id differs from origin/main's and nothing is
# staged — is that difference the residue of a killed graph-commit run (the
# sanctioned orphan recovery, which must PROCEED), or content this script never
# wrote (a mis-pointed -C/--repo or a stale worktree, which must DIE)?
#
# A bare `rev-list --count $MAIN_SHA..HEAD > 0` cannot tell those apart: it is
# true of ANY unpushed commit in the checkout, including an old one for a
# different node, a hand-made commit, or a stale worktree's leftovers. Trusting
# it would let land() rebase and push that unrelated content onto main —
# reverting edits other writers already landed — and then report `landed`,
# because print_verdict compares main against the same stale content. So the
# exemption is narrowed to a divergence the local commits actually EXPLAIN, and
# only when they look like this script's own work:
#   - at least one unpushed commit touches intentions/$id.md (path-scoped
#     rev-list — an unpushed commit for some OTHER node explains nothing here);
#   - every such commit is non-merge and intentions/-only (graph-commit stages
#     nothing else, and rebases rather than merges);
#   - every such commit's subject is one this script writes: exactly this
#     invocation's message (the sanctioned recovery re-runs the same argv, so
#     the orphan carries CURRENT_MSG) or the default `graph: …` shape.
# Anything else keeps the die().
#
# Callers: main()'s nothing-staged branch only. Requires MAIN_SHA pinned and
# CURRENT_MSG set.
id_divergence_is_own_orphan() {
  local id="$1" shas sha subject parents nonint
  shas="$(git rev-list "$MAIN_SHA..HEAD" -- "intentions/$id.md" 2>/dev/null || true)"
  [[ -n "$shas" ]] || return 1
  while IFS= read -r sha; do
    [[ -n "$sha" ]] || continue
    # Merge commits: not something graph-commit produces (it rebases), and
    # a name-only listing reports no paths for them, so the intentions/-only
    # check below would pass vacuously. Reject explicitly. (`rev-list --parents
    # -n 1` prints "<sha> <parent>…", so a word count of 2 is exactly one
    # parent; a root commit counts 1 and is rejected too — origin/main is its
    # ancestor here, so it cannot be one.)
    parents="$(git rev-list --parents -n 1 "$sha" | wc -w)"
    [[ "$parents" -eq 2 ]] || return 1
    subject="$(git log -1 --format=%s "$sha" 2>/dev/null || true)"
    if [[ "$subject" != "$CURRENT_MSG" && "$subject" != graph:\ * ]]; then
      return 1
    fi
    nonint="$(git diff-tree --no-commit-id --name-only -r "$sha" | grep -v '^intentions/' || true)"
    [[ -z "$nonint" ]] || return 1
  done <<<"$shas"
  return 0
}

# --- Commit ----------------------------------------------------------------
# Stage exactly our id files (edits AND prunes — `git add -- <path>` stages a
# deletion for a tracked file that is missing from the working tree just as
# readily as it stages new/changed content), run the guard, then commit with
# CURRENT_MSG.
#
# One exclusion: an id in RESURRECTED_IDS. park_write() re-materializes a node
# another writer's already-landed change DELETED from origin/main, and staging
# that path would push the deleted node's content straight back onto main — no
# PR, no CI, no review — silently reverting a landed deletion (a redaction, a
# retraction) on the strength of a losing writer's stale --base. The landed
# deletion wins; the re-materialized file stays local and untracked.
commit_files() {
  local id
  for id in "${ALL_IDS[@]}"; do
    is_resurrected_id "$id" && continue
    git add -- "intentions/$id.md"
  done
  assert_staged_safe
  git commit -q -m "$CURRENT_MSG"
}

# --- Commit, without a working tree (GRAPH_COMMIT_WRITER=plumbing) -----------
# node_file_mode <base-commit> <path> -> prints the 6-digit index mode.
#
# The plumbing writer must record the SAME mode `git add` would, or its tree
# SHA diverges from the working-tree writer's on identical content — and the
# tree SHA is the whole equivalence claim. So this reproduces git's own rule
# (read-cache.c's ce_mode_from_stat):
#   - core.fileMode true (the default, and every Linux checkout this repo runs
#     in): the mode comes from the file's own executable bit.
#   - core.fileMode false (a filesystem whose exec bit is not trustworthy —
#     e.g. a Windows share): git PRESERVES the mode already recorded for the
#     path, falling back to 0644 for a path it has never seen.
# Every one of the repo's 659 intentions/*.md files is 100644 today, and
# write-node.ts creates them non-executable, so both arms agree in practice —
# this exists so they keep agreeing if that ever stops being true.
#
# Symlinks and other non-regular files are refused rather than guessed at: a
# node file is authored by write-node.ts as a regular file, so anything else is
# a broken environment, not a case to paper over (code-style.md).
node_file_mode() { # <base-commit> <path>
  local base="$1" path="$2" trust_exec base_entry base_mode=""
  if [[ -L "$path" ]]; then
    die "intentions path '$path' is a symlink — graph-commit lands regular node files only"
  fi
  if [[ ! -f "$path" ]]; then
    die "intentions path '$path' is not a regular file — nothing to hash for the plumbing writer"
  fi
  trust_exec="$(git config --bool core.fileMode 2>/dev/null || true)"
  # Unset means git's built-in default, which is true (environment.c:
  # `int trust_executable_bit = 1`).
  [[ -n "$trust_exec" ]] || trust_exec=true
  if [[ "$trust_exec" == "true" ]]; then
    if [[ -x "$path" ]]; then printf '100755\n'; else printf '100644\n'; fi
    return 0
  fi
  base_entry="$(git ls-tree "$base" -- "$path" 2>/dev/null || true)"
  base_mode="${base_entry%% *}"
  case "$base_mode" in
    100644|100755) printf '%s\n' "$base_mode" ;;
    *) printf '100644\n' ;;
  esac
}

# plumb_die <msg…> — die(), but remove the throwaway index dir on the way out.
#
# EVERY failure path after build_commit_plumbing()'s mktemp must go through it,
# because cleanup()'s TMP_INDEX_DIR backstop CANNOT be relied on there: the
# builder returns its result on stdout, so every caller invokes it as `$(…)`,
# and the TMP_INDEX_DIR assignment then happens inside a command-substitution
# SUBSHELL that the parent shell — the one running the EXIT trap — never sees.
# (Bash also does not run an inherited EXIT trap when such a subshell exits, so
# there is no trap-side rescue either.) cleanup()'s backstop still covers the
# one remaining case, a call made directly in the parent shell; this covers the
# case that actually occurs.
plumb_die() { # <msg…>
  if [[ -n "$TMP_INDEX_DIR" ]]; then
    rm -rf "$TMP_INDEX_DIR"
    TMP_INDEX_DIR=""
  fi
  die "$@"
}

# build_commit_plumbing <base-commit> -> prints the new commit SHA on stdout.
#
# Builds this invocation's commit with git's tree plumbing instead of a working
# tree: the base commit's tree is read into a THROWAWAY index, exactly this
# invocation's node paths are added (edits) or removed (prunes) on top of it,
# the result is sealed with `git write-tree` + `git commit-tree`, and the index
# is deleted. Neither the checkout nor the repo's own .git/index is touched, and
# the resulting commit is reachable from no ref until a caller pushes it.
#
# It is the exact plumbing twin of commit_files() and MUST stay so, including
# the RESURRECTED_IDS exclusion below. Same inputs -> same tree SHA; that
# equivalence is what test-graph-commit.sh's plumbing cases assert directly.
# The `-p <base>` single parent and CURRENT_MSG message mirror the worktree
# writer's `git commit` on a checkout sitting at <base>.
#
# Everything in the base tree that this invocation does not name is carried
# through untouched — read-tree seeds the index with the WHOLE base tree, and
# only the named paths are then mutated.
#
# Style follows build_lock_commit() above, which already builds a commit in
# this repo with no index and no checkout (against the universal empty tree).
#
# Called once per attempt by prepare_plumbing_sha() (see below) when
# GRAPH_COMMIT_WRITER=plumbing, always with the fresh origin/main tip as the
# base — which is what makes the eventual push to main a fast-forward.
build_commit_plumbing() { # <base-commit>
  local base="$1" base_sha base_date id path blob mode tree sha idx
  [[ -n "$base" ]] || die "build_commit_plumbing: no base commit given"
  base_sha="$(git rev-parse --verify "$base^{commit}" 2>/dev/null)" \
    || die "build_commit_plumbing: '$base' does not resolve to a commit in this repo"

  # A dedicated tempdir, not a bare temp FILE: `git read-tree` writes its index
  # plus a sibling lock file (index.lock) next to it, so it needs a directory it
  # can own. Registered in TMP_INDEX_DIR first so plumb_die() (and, for a call
  # made outside a command substitution, cleanup()) can remove it when any
  # failure below unwinds past this function.
  TMP_INDEX_DIR="$(mktemp -d)" || die "build_commit_plumbing: could not create the throwaway index dir"
  idx="$TMP_INDEX_DIR/index"

  GIT_INDEX_FILE="$idx" git read-tree "$base_sha" \
    || plumb_die "build_commit_plumbing: could not read $base_sha's tree into the throwaway index"

  for id in "${ALL_IDS[@]}"; do
    # THE RESURRECTED_IDS EXCLUSION — identical in force and in reason to
    # commit_files()' (see its comment block above). park_write() re-materializes
    # a node another writer's ALREADY-LANDED change DELETED from origin/main;
    # putting that path back into the tree would push the deleted node's content
    # straight onto main with no PR, no CI and no review, silently reverting a
    # landed deletion (a redaction, a retraction). The landed deletion wins; the
    # re-materialized file stays local and untracked.
    is_resurrected_id "$id" && continue
    path="intentions/$id.md"
    if is_prune_id "$id"; then
      # A prune lands a DELETION: the caller already removed the file from disk
      # (the existence guard inverts), so there is nothing to hash — the path is
      # dropped from the tree, exactly as `git add -- <path>` stages a deletion
      # for a tracked file missing from the working tree.
      #
      # --force-remove would silently succeed on a path the base tree does not
      # carry, which `git add` would instead reject as an unmatched pathspec.
      # Refuse loudly rather than emit a commit that silently pruned nothing.
      if ! git cat-file -e "$base_sha:$path" 2>/dev/null; then
        plumb_die "build_commit_plumbing: --prune $id names a path absent from base commit $base_sha — nothing to delete"
      fi
      GIT_INDEX_FILE="$idx" git update-index --force-remove -- "$path" \
        || plumb_die "build_commit_plumbing: could not remove $path from the throwaway index"
      continue
    fi
    blob="$(git hash-object -w -- "$path")" \
      || plumb_die "build_commit_plumbing: could not hash-object $path"
    # `|| plumb_die` is not decoration: node_file_mode() dies inside its own
    # command substitution, so its exit only fails THIS assignment. Errexit is
    # suppressed whenever the builder itself runs in a `$(…)` that is part of an
    # `||`/`if` (which is how its callers and tests invoke it), so without this
    # the loop would carry on with an empty mode and blame the next command.
    mode="$(node_file_mode "$base_sha" "$path")" \
      || plumb_die "build_commit_plumbing: could not determine the index mode for $path"
    GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "$mode,$blob,$path" \
      || plumb_die "build_commit_plumbing: could not stage $path ($mode,$blob) into the throwaway index"
  done

  tree="$(GIT_INDEX_FILE="$idx" git write-tree)" \
    || plumb_die "build_commit_plumbing: could not write the tree from the throwaway index"

  # Pin author/committer date to the base commit's own committer date, set
  # for this one commit-tree invocation only (not exported process-wide).
  # With no date pinned git stamps the wall clock, so rebuilding against an
  # UNCHANGED base mints a new SHA every time and a checks-timeout retry
  # restarts CI from zero instead of reusing the prior run. Pinning to the
  # base's date makes the built commit a pure function of (base, tree,
  # message): the SAME base with the same content and message yields the
  # SAME SHA (so a retry re-pushes the identical commit), while a DIFFERENT
  # base yields a different SHA regardless, since the parent is itself part
  # of the commit object. Trade-off, taken deliberately: landed graph
  # commits' dates track their base's committer date, not the wall clock at
  # land time.
  base_date="$(git log -1 --format=%cI "$base_sha")" \
    || plumb_die "build_commit_plumbing: could not read $base_sha's committer date"
  sha="$(GIT_AUTHOR_DATE="$base_date" GIT_COMMITTER_DATE="$base_date" git commit-tree "$tree" -p "$base_sha" -m "$CURRENT_MSG")" \
    || plumb_die "build_commit_plumbing: could not commit-tree $tree onto $base_sha"

  rm -rf "$TMP_INDEX_DIR"
  TMP_INDEX_DIR=""
  printf '%s\n' "$sha"
}

# --- Plumbing writer: same-node concurrent-edit detection -------------------
# reconcile_plumbing_base <prev-base> <new-base> — the plumbing writer's
# replacement for a rebase conflict.
#
# The worktree writer discovers a concurrent edit by replaying its commit onto
# the fresh tip and letting git report a textual conflict. A plumbing build has
# no replay: it re-reads the node files off disk and stamps them onto whatever
# base it is handed, so a peer's edit landed since <prev-base> would be
# OVERWRITTEN with no conflict, no park and an exit 0 — the exact silent-revert
# shape park_and_exit() exists to prevent. So the detection is made explicit and
# per node: compare each id's blob at <prev-base> with its blob at <new-base>.
#   equal   — origin/main did not touch this node between the two bases, so the
#             on-disk content is still a valid write against the new base.
#             Nothing to do (the overwhelmingly common case, and it costs one
#             `git rev-parse` per node — no merge process is spawned).
#   differs — a concurrent writer landed something for this node. Three-way
#             merge instead of overwriting, through the SAME run_merge_node()
#             primitive layer 2 and layer 3 use. Mapping is direct (no rebase
#             stage inversion here — these are plain file reads):
#               base   = the node at <prev-base>  (what this content was derived from)
#               ours   = the on-disk node file    (this invocation's intent)
#               theirs = the node at <new-base>   (the peer's landed content)
#             A resolved merge is written to the working tree (so the next
#             build_commit_plumbing() picks it up) and to SNAP_DIR/<id>.merged.md
#             (what this run intends to land), never over SNAP_DIR/<id>.md — see
#             the SNAP_DIR path contract.
#
# Returns 0 when every id reconciled, 1 when any did not. The caller returns 10,
# which land() maps to 12 and main() turns into park_and_exit() — the same
# fail-closed park an unresolvable rebase conflict takes. Unresolved fields are
# already in CONFLICT_FIELDS_JSON (run_merge_node appends them), so the park
# recommendation reads identically whichever writer produced it.
#
# Two id classes are handled without a merge:
#   - a RESURRECTED id is skipped outright, for the reason commit_files() and
#     build_commit_plumbing() skip it: its on-disk file is a local artifact that
#     must never reach main.
#   - a --prune id has no content to structurally merge, so a moved blob is
#     recorded with try_layer2_resolve()'s own prune sentinel and parks. That is
#     conservative in one edge: a prune whose node a PEER already deleted also
#     reads as "moved" and parks, where a rebase would have seen both sides
#     delete and carried on. Fail-closed is the right direction, and the plumbing
#     writer's one opt-in caller today never prunes.
reconcile_plumbing_base() { # <prev-base> <new-base>
  local prev="$1" new="$2" id prev_blob new_blob unresolved=0
  local base_f theirs_f out_f
  for id in "${ALL_IDS[@]}"; do
    is_resurrected_id "$id" && continue
    prev_blob="$(blob_sha_or_empty "$prev" "$id")"
    new_blob="$(blob_sha_or_empty "$new" "$id")"
    [[ "$prev_blob" == "$new_blob" ]] && continue

    if is_prune_id "$id"; then
      append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "prune vs. concurrent edit"}]')"
      unresolved=1
      continue
    fi

    echo "graph-commit: origin/main advanced with a concurrent edit to $id since this write's base; attempting the field-level auto-merge before parking" >&2
    base_f=""; theirs_f=""; out_f="$SNAP_DIR/.plumb-merge-$id.out"
    if [[ -n "$prev_blob" ]]; then
      base_f="$SNAP_DIR/.plumb-merge-$id.base"
      git cat-file -p "$prev_blob" >"$base_f" \
        || die "base blob $prev_blob for '$id' is unreadable in the local object database — cannot attempt automatic reconciliation against the fresh base"
    fi
    if [[ -n "$new_blob" ]]; then
      theirs_f="$SNAP_DIR/.plumb-merge-$id.theirs"
      git cat-file -p "$new_blob" >"$theirs_f" \
        || die "origin/main blob $new_blob for '$id' is unreadable in the local object database — cannot attempt automatic reconciliation against the fresh base"
    fi
    if run_merge_node "$id" "$base_f" "$INTENTIONS_DIR/$id.md" "$theirs_f" "$out_f"; then
      cp -- "$out_f" "$INTENTIONS_DIR/$id.md"
      cp -- "$out_f" "$(snap_merged_file "$id")"
      continue
    fi
    unresolved=1
  done
  [[ "$unresolved" -eq 0 ]]
}

# id_files_differ_from_rev <rev> — the plumbing writer's "is there anything to
# land?" discriminator, and the counterpart to id_files_dirty().
#
# id_files_dirty() asks whether the node files differ from HEAD, which is the
# right question only for a writer whose commit is made on top of HEAD. The
# plumbing writer builds on origin/main regardless of what HEAD carries, so a
# checkout merely behind origin/main would report "dirty" for content already
# landed, and "clean" for content that still needs to land. Compare the ON-DISK
# blob against <rev> instead.
#
# Resurrected ids are excluded for the reason build_commit_plumbing() excludes
# them: their on-disk file is a local artifact that is never committed, so
# counting it here would claim a landing was needed when nothing committable
# exists.
id_files_differ_from_rev() { # <rev>
  local rev="$1" id path disk rev_blob
  for id in "${ALL_IDS[@]}"; do
    is_resurrected_id "$id" && continue
    path="intentions/$id.md"
    rev_blob="$(blob_sha_or_empty "$rev" "$id")"
    if [[ -f "$path" ]]; then
      disk="$(git hash-object -- "$path")" \
        || die "could not hash $path to decide whether it differs from $rev"
    else
      disk=""
    fi
    [[ "$disk" == "$rev_blob" ]] || return 0
  done
  return 1
}

# sync_ids_to_rev <rev> — bring exactly this invocation's node files to <rev>'s
# content, touching nothing else. The plumbing writer's stand-in for
# park_and_exit()'s `git reset --hard <rev>`.
#
# Deliberately writes the working tree only, never the index: `git checkout
# <rev> -- <path>` would stage the path, mutating the caller's .git/index, and
# the plumbing writer commits through a throwaway index anyway. A node absent at
# <rev> (a peer landed its deletion) is removed rather than left behind, which
# is what the reset would have done and what park_write()'s delete/modify
# detection then reads.
sync_ids_to_rev() { # <rev>
  local rev="$1" id path
  for id in "${ALL_IDS[@]}"; do
    path="intentions/$id.md"
    if git cat-file -e "$rev:$path" 2>/dev/null; then
      git show "$rev:$path" >"$path" \
        || die "could not restore $path from $rev — the park cannot be written against fresh origin/main"
    else
      rm -f -- "$path"
    fi
  done
}

# prepare_plumbing_sha — produce this attempt's landing SHA for the plumbing
# writer, and set ATTEMPT_SHA to it.
#
# Rebuild-on-fresh-base, in place of the worktree writer's commit + rebase:
#   1. fetch origin/main and take its tip as the base;
#   2. reconcile the on-disk content against it (reconcile_plumbing_base above)
#      — this is where a same-node concurrent edit is caught;
#   3. build the commit on that base with the tree plumbing.
# Because the parent IS origin/main as of step 1, the eventual `git push origin
# <sha>:main` is a fast-forward by construction. When it is rejected anyway
# (main advanced between the fetch and the push, or during the check-stamp
# window), the next attempt simply repeats all three steps against the newer
# tip — there is no commit to replay and so nothing to conflict.
#
# Returns 0 with ATTEMPT_SHA set, or 10 when the reconciliation found a
# concurrent edit it could not merge (the caller parks). Dies on a broken
# environment (a failed fetch, an unbuildable commit) rather than falling back.
prepare_plumbing_sha() {
  local new_base
  ATTEMPT_SHA=""
  git fetch origin main >&2 || die "'git fetch origin main' failed — the plumbing writer cannot choose a base to build on"
  new_base="$(git rev-parse FETCH_HEAD)" \
    || die "could not resolve FETCH_HEAD after fetching origin main"
  if [[ -z "$PLUMB_BASE" ]]; then
    # First attempt. The fork point, not HEAD: it is the commit the writer's
    # on-disk content was actually derived from, and it is precisely what `git
    # pull --rebase` would three-way against for the worktree writer.
    PLUMB_BASE="$(git merge-base HEAD "$new_base")" \
      || die "could not compute the merge-base of HEAD and origin/main ($new_base) — the plumbing writer has no fork point to reconcile this write against"
  fi
  if [[ "$new_base" != "$PLUMB_BASE" ]]; then
    reconcile_plumbing_base "$PLUMB_BASE" "$new_base" || return 10
    PLUMB_BASE="$new_base"
  fi
  ATTEMPT_SHA="$(build_commit_plumbing "$PLUMB_BASE")" \
    || die "could not build the commit for ${ALL_IDS[*]} on $PLUMB_BASE — nothing was pushed"
  return 0
}

# --- Rebase-state detection ------------------------------------------------
# Distinguish a rebase CONFLICT from a fetch/refuse fatal after `git pull
# --rebase` returns non-zero. This checkout is a `.bare` common-dir + worktree
# layout where `.git` is a file and the rebase state dirs live under the
# per-worktree git dir, so resolve them via `git rev-parse --git-path` rather
# than hardcoding `.git/rebase-*` (which would misclassify every conflict here).
rebase_in_progress() {
  local rm ra
  rm="$(git rev-parse --git-path rebase-merge)"
  ra="$(git rev-parse --git-path rebase-apply)"
  [[ -d "$rm" || -d "$ra" ]]
}

# check_suite_concluded <suite-id> — has the row's PARENT check suite already
# finished? Returns 0 when the suite reports `status: completed`, 1 otherwise.
#
# A check suite cannot conclude while one of its own jobs is still running, so a
# required check row carrying NO conclusion under a completed suite is orphaned:
# GitHub will never move it, and `gh run rerun` refuses it ("This workflow run
# cannot be retried"). Waiting is futile — and waiting is exactly what burned
# every green-wait attempt on 2026-08-11, exiting busy-exhausted and leaving an
# orphan local commit while the graph store's only write path stayed shut
# (tactic-orphaned-check-run-pins-pending-ci-guard).
#
# Deliberately three-valued in effect: an UNREADABLE suite is a non-observation,
# not evidence of an orphan, so a failed/empty lookup returns 1 and the caller
# keeps polling. That is the safe direction — a non-observation can only cost
# the caller the existing pending timeout (rc 1), never a green verdict.
#
# Uses `gh api ... --jq` so gh runs jq on its in-memory JSON (shell-json.md).
#
# Memoised PER POLL, never across polls. The four required contexts routinely
# share ONE check suite (the fixtures in test-graph-commit.sh are the real
# shape: all four rows carry check_suite 85480333626), so an un-memoised lookup
# costs one extra REST call per pending row per poll — with a 7s poll over a
# 180s timeout across 5 attempts that is ~4x the green-wait's whole API budget.
# The cache is reset at the top of every poll iteration in await_checks: a
# suite's status is a statement about a moment, and a `not concluded` answer
# cached across polls would hide the very transition this predicate watches for.
# A FAILED lookup is not cached at all — it is a non-observation, not an answer.
declare -A SUITE_CONCLUDED_CACHE=()
check_suite_concluded() { # <suite-id>
  local suite_id="$1" status
  [[ -n "$suite_id" && "$suite_id" != "-" && "$suite_id" != "null" ]] || return 1
  # PRESENCE, not non-emptiness: a successful lookup that returned no `.status`
  # at all caches the empty string, and an `-n` test would read that answer as a
  # cache MISS and re-query the same suite for every remaining row sharing it —
  # exactly the per-row fan-out the memo exists to prevent. A failed lookup is
  # still never cached (it returns before the assignment below).
  if [[ -n "${SUITE_CONCLUDED_CACHE[$suite_id]+set}" ]]; then
    [[ "${SUITE_CONCLUDED_CACHE[$suite_id]}" == "completed" ]]
    return
  fi
  # stdin is closed explicitly: this runs inside await_checks' `while read`
  # loop, which is fed by a here-string, and a subprocess that read stdin would
  # swallow the remaining rows (the same hazard lib-frozen-session-park.sh
  # drains its candidate list into an array to avoid).
  status="$(gh api "repos/{owner}/{repo}/check-suites/$suite_id" \
    --jq '.status // ""' 2>/dev/null </dev/null)" || return 1
  SUITE_CONCLUDED_CACHE["$suite_id"]="$status"
  [[ "$status" == "completed" ]]
}

# --- Fast-path check stamping ----------------------------------------------
# Poll the branch-protection ruleset's four required contexts on <sha> until all
# report a successful conclusion, keyed on the check-run NAME (mirrors the four
# STAMPING jobs in .github/workflows/graph-fast-path.yml; that workflow also
# carries non-required stubs — hook-tests, typecheck, test-integrity,
# graph-validate — which this filter ignores by name). Gating is per DISTINCT
# required context, not per check-run row: a SHA re-stamped by several pushes
# accumulates one row per workflow run per name, so a row count of the green
# rows can exceed four and an `== 4` row gate can never fire, leaving an
# already-green SHA permanently unlandable. Instead each required name is
# resolved to the conclusion of its NEWEST GitHub-Actions-authored run (highest
# server-assigned `id`; rows from any other App are ignored outright), and the
# gate fires when all four distinct names resolve to success. Uses
# `gh api ... --jq` so gh runs jq
# on its in-memory JSON — never an `echo "$VAR" | jq` round-trip
# (shell-json.md).
# Returns:
#   0  all four contexts green.
#   1  the timeout elapsed with the checks still pending (transient — the
#      caller rebases and retries this whole cycle).
#   2  a required check CONCLUDED non-success (deterministic — the commit
#      content itself fails CI; the caller must not retry).
#   3  a required check is ORPHANED — no conclusion, and its parent check suite
#      has already finished, so no verdict will ever arrive (see
#      check_suite_concluded). This says nothing about the commit content: it is
#      a GitHub-side condition, and the caller answers it by re-stamping the SHA
#      on a fresh scratch push under its own small cap (MAX_ORPHAN_RESTAMPS),
#      never by waiting and never by charging the landing budget.
# 2 and 3 are separate because the caller must do opposite things with them, and
# 2 outranks 3 when a single poll sees both: a concluded non-success is a
# property of the content that no re-stamp can change, so it is the answer the
# operator needs first.
# Dies after 3 CONSECUTIVE gh poll failures, surfacing gh's captured stderr —
# an auth/rate-limit/network error is a broken environment, not a pending
# check, so collapsing it into "still polling" until the generic timeout
# would hide the real cause (clear error over fallback, code-style.md).
await_checks() {
  local sha="$1"
  local deadline counts ngreen nbad norphan cname cconc crows csuite detail gh_stderr gh_fails=0
  # gh's stderr is captured per poll inside SNAP_DIR, which already exists for
  # the lifetime of the run and is removed by cleanup() on non-park exits.
  local errfile="$SNAP_DIR/.gh-poll-stderr"
  deadline=$(( $(date +%s) + CHECK_TIMEOUT_SECONDS ))
  while :; do
    # Emit exactly one line per required name, in a fixed order, shaped
    # `<name> <latest-conclusion> <row-count>`; a name with no rows at all
    # emits `absent 0`.
    #
    # Producer filter FIRST, ordering second — this gate is the one code path
    # that pushes straight to a protected branch, so both must be
    # forgery-resistant:
    #
    #   - Only rows authored by GitHub Actions (`.app.slug == "github-actions"`,
    #     the App that runs .github/workflows/graph-fast-path.yml) are
    #     considered. Any principal holding `checks: write` — a workflow's
    #     GITHUB_TOKEN, an installed App, a leaked PAT — can POST a check run
    #     with an arbitrary `name` and `conclusion: "success"` onto the
    #     `graph/**` scratch SHA. Rows from any other App are dropped before a
    #     winner is picked, so a foreign row can neither satisfy a required
    #     context nor supersede the genuine one.
    #   - The winner is `max_by(.id)` and NOTHING else. `id` is server-assigned
    #     and monotonic per repository; `started_at` is caller-supplied on
    #     `POST /repos/{owner}/{repo}/check-runs` and rewritable by `PATCH`, so
    #     ordering on it would let a row claiming `started_at:
    #     "9999-01-01T00:00:00Z"` sort above a genuine failure. Ordering on `id`
    #     alone still resolves the real case this gate exists for: a SHA
    #     re-stamped by several pushes, where the newer run's row has the higher
    #     id and supersedes the stale failed one.
    #
    # The gate stays fail-closed: the selected row for each required name must
    # itself conclude success, and any non-success selected row is a hard
    # refusal (return 2, no retry).
    #
    # Keying off .conclusion alone (null = pending, non-null = concluded)
    # rather than requiring status=="completed" too is deliberate — GitHub
    # sometimes leaves a check-run's status stuck at in_progress even after its
    # conclusion is already populated (a known check-runs desync, #2457).
    # Mirrors dispatch_classify_rollup's `(.conclusion // "")` idiom (lib.sh)
    # fixed for the same desync. Extra check runs (e.g. CodeQL `Analyze (*)`,
    # the fast path's `guard` job) stay excluded by the name filter.
    #
    # The complementary desync — no conclusion at all, on a row whose PARENT
    # check suite has already concluded — is the ORPHAN case, and `.conclusion`
    # cannot see it. So the filter also emits the winning row's
    # `.check_suite.id` (or `-`) as a fourth field, which the loop below resolves
    # via check_suite_concluded(). The two conditions coexist and must not be
    # collapsed: #2457 is a populated conclusion behind a stale status, this is
    # no conclusion at all.
    if counts="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
      --jq '["acceptance","preview-and-smoke","lint","unit-tests"] as $req
            | (.check_runs // []) as $all
            | $req[] as $name
            | [$all[]
               | select(.name == $name)
               | select((.app.slug // "") == "github-actions")] as $rows
            | if ($rows | length) == 0 then "\($name) absent 0 -"
              else ($rows | max_by(.id // 0)) as $latest
                | "\($name) \($latest.conclusion // "pending") \($rows | length) \($latest.check_suite.id // "-")"
              end' \
      2>"$errfile")"; then
      gh_fails=0
      ngreen=0; nbad=0; norphan=0; detail=""
      # Per-poll suite-status memo (see check_suite_concluded): rows sharing a
      # suite cost one lookup, and nothing is carried into the next poll.
      SUITE_CONCLUDED_CACHE=()
      while read -r cname cconc crows csuite; do
        [[ -n "$cname" ]] || continue
        # An unconcluded row under an already-concluded suite is never going to
        # report. Promote it out of `pending` BEFORE the detail string is built,
        # so the operator's message names the orphan for what it is rather than
        # as a slow check. Counted in its OWN accumulator, not in nbad: an orphan
        # and a concluded non-success are different findings that the caller
        # answers differently (rc 3 vs rc 2), so collapsing them here would
        # re-create the false "the commit content fails CI" accusation.
        if [[ "$cconc" == "pending" ]] && check_suite_concluded "$csuite"; then
          detail+="${detail:+, }$cname=orphaned(no conclusion, but parent check suite $csuite already concluded — GitHub will never report this row; ${crows} row(s))"
          norphan=$((norphan + 1))
          continue
        fi
        # `absent` means GitHub never created a check-run row for this name at
        # all — a different thing from a row that exists but has not concluded
        # (`pending`), and the parenthetical says so rather than printing a
        # bare "(0 row(s))" the reader has to decode.
        if [[ "$cconc" == "absent" ]]; then
          detail+="${detail:+, }$cname=absent(no check-run rows created)"
        else
          detail+="${detail:+, }$cname=$cconc(${crows} row(s))"
        fi
        case "$cconc" in
          success)         ngreen=$((ngreen + 1)) ;;
          pending|absent)  ;;
          *)               nbad=$((nbad + 1)) ;;
        esac
      done <<<"$counts"
      # Snapshot and its provenance always move together: a detail string
      # without the SHA it was read on cannot be attributed by a later message.
      LAST_CHECK_DETAIL="$detail"
      LAST_CHECK_SHA="$sha"
      if [[ "$ngreen" -eq 4 ]]; then
        return 0
      fi
      if [[ "$nbad" -gt 0 ]]; then
        echo "graph-commit: a required check concluded non-success for $sha — $detail" >&2
        return 2
      fi
      # Checked AFTER nbad: when one poll sees both, the concluded failure is the
      # verdict that matters (see the rc contract above).
      if [[ "$norphan" -gt 0 ]]; then
        echo "graph-commit: a required check is orphaned on $sha (GitHub-side; no verdict will ever arrive) — $detail" >&2
        return 3
      fi
    else
      gh_stderr="$(cat "$errfile" 2>/dev/null || true)"
      gh_fails=$((gh_fails + 1))
      echo "graph-commit: check-run poll failed ($gh_fails/3 consecutive) for $sha: ${gh_stderr:-<no stderr>}" >&2
      if [[ "$gh_fails" -ge 3 ]]; then
        die "check-run polling failed 3 consecutive times for $sha — last gh error: ${gh_stderr:-<no stderr>}"
      fi
    fi
    if [[ "$(date +%s)" -ge "$deadline" ]]; then
      echo "graph-commit: required checks not green within ${CHECK_TIMEOUT_SECONDS}s for $sha — $(check_state_phrase "$sha")" >&2
      return 1
    fi
    sleep "$CHECK_POLL_SECONDS"
  done
}

# check_state_phrase <sha> — render, on stdout, what this run actually knows
# about the required checks ON <sha>, for interpolation into a failure message.
# Three distinct things a reader must be able to tell apart:
#   - we never observed any check state at all (no poll completed in this run);
#   - we never observed <sha>'s state, and the snapshot we do hold belongs to a
#     DIFFERENT commit (an earlier attempt's) — named as such, never passed off
#     as <sha>'s current state;
#   - we observed <sha>'s state, and here it is.
# The degenerate cases are worded as non-observations rather than dropped into
# the slot where a check state goes, so "we could not see the checks" never
# reads as "the checks are not green".
check_state_phrase() {
  local sha="$1"
  if [[ -z "$LAST_CHECK_SHA" ]]; then
    echo "no check-run poll completed in this run, so the required-check state was never observed (this is a non-observation, not a check state)"
    return 0
  fi
  if [[ "$LAST_CHECK_SHA" != "$sha" ]]; then
    echo "no check-run poll completed for ${sha:0:8}, so ITS required-check state was never observed; the most recent observation was of a DIFFERENT commit ${LAST_CHECK_SHA:0:8}, which reported: $LAST_CHECK_DETAIL"
    return 0
  fi
  echo "required-check state observed on ${sha:0:8}: $LAST_CHECK_DETAIL"
}

# --- Terminal verdict (the caller contract) ---------------------------------
# print_verdict <context> — derive what actually happened to origin/main from a
# POST-PUSH READ of origin/main, print the single contract line documented in
# the header block, and leave the status in LAST_VERDICT. Once-only: the second
# and later calls are no-ops that leave LAST_VERDICT untouched, which is what
# makes it safe for die() to call this from inside the verdict path's own
# callees.
#
# It deliberately does NOT shell out to the sibling `verify-landed`: that script
# would run its own `git fetch`, and this process is already standing in the
# repo with the fetched sha in hand. The predicate logic is the same
# (three-valued, `unknown` never collapsed into either answer) — only the
# subprocess and its redundant fetch are dropped.
#
# It must never die(): die() calls back into here, and a verdict that cannot be
# computed is exactly what the `unknown` status is for. Every git invocation
# below is therefore individually guarded.
print_verdict() { # <context>
  [[ "$VERDICT_EMITTED" -eq 1 ]] && return 0
  VERDICT_EMITTED=1
  local context="$1"
  local ids_csv verdict reason="" main_sha="unknown"
  ids_csv="$(IFS=,; echo "${ALL_IDS[*]:-}")"

  # No id was ever validated, so no write was attempted and there is nothing on
  # origin/main to read about. Skip the fetch entirely — a usage/pre-flight
  # death must stay cheap.
  if [[ "${#ALL_IDS[@]}" -eq 0 ]]; then
    _emit_verdict_line refused "$ids_csv" "$main_sha" "$context" \
      "the invocation was refused before any id was validated — no write was attempted"
    return 0
  fi

  # Same thing one step later: the ids validated, but the run died before
  # snapshot() and before any push, so nothing was staged, committed, or
  # pushed. Reading origin/main here would compare against content this run
  # never captured an intent for. Also skips the fetch.
  if [[ -z "$PUSHED_SHA" && "$SNAPSHOT_TAKEN" -eq 0 ]]; then
    _emit_verdict_line refused "$ids_csv" "$main_sha" "$context" \
      "the invocation was refused before it staged, committed, or pushed anything — no write was attempted"
    return 0
  fi

  # Mandatory re-fetch: this process's OWN push (or a peer's) made the pinned
  # $MAIN_SHA stale, so reconciling against it would answer about the tip
  # observed BEFORE the write rather than after it. A fetch failure is
  # `unknown`, never `not-landed` — an unreachable remote says nothing about
  # what is on it.
  if ! git fetch --quiet origin main >&2; then
    _emit_verdict_line unknown "$ids_csv" "$main_sha" "$context" \
      "could not fetch origin/main after the write — the outcome is undetermined"
    return 0
  fi
  if ! main_sha="$(git rev-parse FETCH_HEAD 2>/dev/null)"; then
    _emit_verdict_line unknown "$ids_csv" "unknown" "$context" \
      "could not resolve origin/main after the fetch — the outcome is undetermined"
    return 0
  fi

  # 1. Ancestry: origin/main contains the sha this process pushed. On the park
  #    path that sha IS the parking commit (park_and_exit clears PUSHED_SHA
  #    before its own land, so a pre-park push attempt can never answer "did the
  #    PARK land"), so the same test yields `parked` there.
  if [[ -n "$PUSHED_SHA" ]] \
     && git merge-base --is-ancestor "$PUSHED_SHA" FETCH_HEAD 2>/dev/null; then
    if [[ "$context" == "park" ]]; then
      _emit_verdict_line parked "$ids_csv" "$main_sha" "$context" \
        "the parking commit ${PUSHED_SHA:0:8} is on origin/main"
    else
      _emit_verdict_line landed "$ids_csv" "$main_sha" "$context" \
        "${PUSHED_SHA:0:8} is an ancestor of origin/main"
    fi
    return 0
  fi

  # 2. Nothing-to-push: no push was attempted because HEAD already IS
  #    origin/main, so there was never anything this run could change.
  #
  #    Scoped to the `noop` context DELIBERATELY, not applied wherever HEAD
  #    happens to equal origin/main. HEAD equals origin/main transiently in
  #    states that are the opposite of "landed" — most sharply mid-rebase, where
  #    `git pull --rebase` has already moved HEAD onto the upstream tip and the
  #    writer's commit is not yet replayed. A die() there would read as `landed`
  #    off a coincidence of HEAD, which is exactly the class of false success
  #    this verdict exists to end. Every other context falls through to the
  #    content comparison below, which asks about the CONTENT rather than the
  #    ref.
  #
  #    The ref test stays STRICT equality on purpose — do NOT relax it to
  #    `git merge-base --is-ancestor HEAD FETCH_HEAD` to cover the checkout that
  #    is merely BEHIND origin/main (main()'s widened no-op short-circuit). That
  #    would manufacture a false `landed`. This function RE-FETCHES origin/main,
  #    so a peer can land a DIFFERENT edit to one of our ids between main()'s
  #    fetch and that re-fetch: HEAD is still an ancestor of the new tip, while
  #    the tip no longer carries this run's intended content. An ancestry test
  #    would answer `landed` and return before the content comparison that
  #    catches it. Strictness is what makes this step self-limiting — it fires
  #    only where HEAD IS the freshly-read tip, so "nothing to push" is a fact
  #    about the current main rather than an inference from an old one. The
  #    behind case belongs to step 3 precisely because step 3 is content-based
  #    and reads that fresh tip; it resolves there as `landed-equivalent`, which
  #    exits 0 just the same
  #    (tactic-graph-commit-noop-shortcircuit-head-behind, Unit 2).
  local head_sha=""
  head_sha="$(git rev-parse HEAD 2>/dev/null || true)"
  if [[ "$context" == "noop" && -z "$PUSHED_SHA" && -n "$head_sha" && "$head_sha" == "$main_sha" ]]; then
    _emit_verdict_line landed "$ids_csv" "$main_sha" "$context" \
      "no push was needed — HEAD is already origin/main"
    return 0
  fi

  # 3. Content equivalence. Ancestry is false, but a PEER may have landed
  #    byte-identical content, in which case the caller's intent is satisfied
  #    and a retry would be a no-op. Compare, per id, the content this run
  #    INTENDED to land against origin/main; an id whose intended content
  #    cannot be read is `unknown`, and unknown wins outright over unsatisfied
  #    — it is the absence of an answer, not a weak answer.
  #
  #    WHICH content is "intended" depends on the path:
  #      - ordinary landing: snap_intended_file() — SNAP_DIR/<id>.merged.md when
  #        a layer-2/3 merge resolved for this id, else the frozen
  #        SNAP_DIR/<id>.md — and a --prune id is satisfied by ABSENCE on main.
  #      - park (PARK_CONTENT_DIR set by park_write): the intent is no longer
  #        this writer's edit at all. A park lands origin/main's content PLUS
  #        the office_hours block, and SNAP_DIR deliberately keeps holding the
  #        writer's UNLANDED pre-park edit and any partial merge of it (the
  #        recommendation text points a human at both), so SNAP_DIR is
  #        guaranteed to mismatch here. The same
  #        flip applies to a PARKED --prune id: the deletion was not landed, so
  #        absence on main is the wrong question — the office_hours record is
  #        the intent. A bystander prune (never passed to park_write, so absent
  #        from PARK_CONTENT_DIR) keeps the absence test, which is right: it WAS
  #        re-applied and landed.
  #    Load-bearing on the idempotent-retry path, where park_and_exit() found
  #    the node already carrying a byte-identical office_hours block, committed
  #    and pushed nothing, and left PUSHED_SHA empty — so ancestry cannot answer
  #    and this comparison is the whole verdict.
  local id intended observed unsatisfied=0 indeterminate=0 intended_file
  for id in "${ALL_IDS[@]}"; do
    intended_file=""
    if [[ -n "$PARK_CONTENT_DIR" && -f "$PARK_CONTENT_DIR/$id.md" ]]; then
      intended_file="$PARK_CONTENT_DIR/$id.md"
    elif is_prune_id "$id"; then
      if git cat-file -e "FETCH_HEAD:intentions/$id.md" 2>/dev/null; then
        unsatisfied=1
      fi
      continue
    elif [[ -n "$SNAP_DIR" && -f "$SNAP_DIR/$id.md" ]]; then
      # -f on the frozen snapshot answers "did snapshot() capture this id?";
      # WHICH file holds the intended content is snap_intended_file()'s call.
      intended_file="$(snap_intended_file "$id")"
    else
      # The run died before snapshot() captured this id, so what it intended to
      # land is not recoverable here.
      indeterminate=1
      continue
    fi
    if ! intended="$(git hash-object "$intended_file" 2>/dev/null)"; then
      indeterminate=1
      continue
    fi
    observed="$(git rev-parse -q --verify "FETCH_HEAD:intentions/$id.md" 2>/dev/null || true)"
    [[ "$observed" == "$intended" ]] || unsatisfied=1
  done

  if [[ "$indeterminate" -eq 1 ]]; then
    verdict="unknown"
    reason="origin/main was read, but this run's intended content for at least one id could not be determined — the outcome is undetermined"
  elif [[ "$unsatisfied" -eq 0 && "$context" == "park" ]]; then
    # A park whose office_hours content is already on origin/main byte for byte
    # IS parked — the record a park exists to put there is there. Reported as
    # `parked` rather than `landed-equivalent` for the same reason ancestry does
    # in step 1: this writer's own content was NOT landed, and `landed*` are the
    # only statuses that exit 0.
    verdict="parked"
    # Same PUSHED_SHA-empty honesty split the `landed-equivalent` arm below
    # makes, applied here too: park_and_exit()'s idempotent retry finds the node
    # already parked byte-identically, commits and pushes NOTHING, and leaves
    # PUSHED_SHA empty — so "${PUSHED_SHA:-no push} did not reach origin/main"
    # reads as a failed push that never happened.
    if [[ -z "$PUSHED_SHA" ]]; then
      reason="no push was attempted, and origin/main already carries exactly this park's office_hours content for every parked id (the node was already parked byte-identically — nothing needed pushing)"
    else
      reason="$PUSHED_SHA did not reach origin/main, but origin/main already carries exactly this park's office_hours content for every parked id (the node was already parked byte-identically — nothing needed pushing)"
    fi
  elif [[ "$unsatisfied" -eq 0 ]]; then
    verdict="landed-equivalent"
    # Same status either way — the caller's intent IS on origin/main — but the
    # two ways of getting here are different events and the reason phrase must
    # not conflate them. With PUSHED_SHA empty no push was ever attempted (the
    # nothing-staged no-op short-circuit, including the widened behind-main arm,
    # and park_and_exit()'s idempotent retry), so crediting "a peer" would name
    # an actor that did nothing.
    if [[ -z "$PUSHED_SHA" ]]; then
      reason="no push was attempted, and origin/main already carries exactly this invocation's intended content for every id — there was nothing to land"
    else
      reason="$PUSHED_SHA did not reach origin/main, but origin/main already carries exactly this invocation's intended content for every id (a peer landed identical content)"
    fi
  else
    verdict="not-landed"
    reason="origin/main does not carry this invocation's intended content"
  fi
  _emit_verdict_line "$verdict" "$ids_csv" "$main_sha" "$context" "$reason"
}

# _emit_verdict_line <status> <ids-csv> <main-sha> <context> [<reason>] — the
# single place the contract line is formatted, in the established cause-then-
# evidence shape try_land()'s terminal message already uses. Also records
# LAST_VERDICT for the exit mapping and for park_and_exit()'s branch.
_emit_verdict_line() {
  local status="$1" ids_csv="$2" main_sha="$3" context="$4" reason="${5:-}"
  LAST_VERDICT="$status"
  echo "graph-commit: verdict: $status ids=$ids_csv pushed=${PUSHED_SHA:-none} main=${main_sha:-unknown} context=$context${reason:+ — $reason}" >&2
}

# print_orphan_recovery_line — on a terminal verdict that did NOT put this
# invocation's content on origin/main, say whether a commit was nonetheless
# left behind, and how to recover it. Printed as its own line immediately
# after the verdict line rather than appended to it: the verdict line is the
# parsed caller contract and several paths (die(), park_and_exit()) have
# already emitted it by the time this runs, so there is no single line still
# open to append to.
#
# Scoped to `not-landed` / `unknown` — the two statuses that leave the question
# open. `landed` / `landed-equivalent` / `parked` all mean origin/main carries
# the intent, and `refused` means no commit was ever made.
#
# WORKTREE WRITER: the question is "did HEAD move ahead of origin/main and stay
# there" — answered by counting commits and reading the sha off HEAD.
#
# PLUMBING WRITER: that writer never moves HEAD (build_commit_plumbing() builds
# a commit reachable from no ref — see the ORPHAN-WINDOW comment above
# try_land()), so a HEAD-vs-origin/main commit count answers nothing here: it
# would be silent on a genuine stranded commit (HEAD never moved, so the count
# is always 0) and would misattribute an unrelated local commit the user made
# to graph-commit if HEAD happened to be ahead for some other reason. The
# question this writer needs answered is instead "did prepare_plumbing_sha()
# build and push a commit that a terminal not-landed/unknown verdict never
# confirmed reached origin/main" — answered by PUSHED_SHA (set immediately
# before the push to main, per the comment at its assignment site), not HEAD.
# By the time this runs, cleanup() has deleted the scratch branch
# ($SCRATCH_BRANCH) that was the commit's only ref, so a non-empty PUSHED_SHA
# here names a commit reachable from no ref at all.
#
# Silent when the far-ahead rebuild is in play (RESTORE_HEAD=1): cleanup() is
# about to `git reset --hard "$ORIG_HEAD"`, so the commit that is currently
# ahead of origin/main will not survive this process and calling it an orphan
# left on disk would be false. Vacuous under the plumbing writer — RESTORE_HEAD
# is set only inside ensure_intentions_only_base(), which main() calls only
# when GRAPH_COMMIT_WRITER=worktree — but checked unconditionally so this stays
# correct if that ever changes.
print_orphan_recovery_line() {
  case "$LAST_VERDICT" in
    not-landed|unknown) ;;
    *) return 0 ;;
  esac
  [[ "$RESTORE_HEAD" -eq 1 ]] && return 0

  if [[ "$GRAPH_COMMIT_WRITER" == "plumbing" ]]; then
    [[ -n "$PUSHED_SHA" ]] || return 0
    echo "graph-commit: orphan=$PUSHED_SHA — a commit was built but is reachable from no ref (this writer never moves HEAD) and is NOT on origin/main. Recovery: re-run this same graph-commit invocation from $REPO_ROOT; it rebuilds the commit from the on-disk node files against the fresh origin/main tip and lands it. NEVER git push this commit to main by hand — it bypasses the rebase/layer-2 merge ladder and can clobber a concurrent landing." >&2
    return 0
  fi

  local base count sha
  base="$(git rev-parse FETCH_HEAD 2>/dev/null || true)"
  [[ -n "$base" ]] || base="$MAIN_SHA"
  [[ -n "$base" ]] || return 0
  count="$(git rev-list --count "$base..HEAD" 2>/dev/null || echo 0)"
  [[ "${count:-0}" -gt 0 ]] || return 0
  sha="$(git rev-parse HEAD 2>/dev/null || true)"
  [[ -n "$sha" ]] || return 0
  echo "graph-commit: orphan=$sha — committed locally, NOT on origin/main. Recovery: re-run this same graph-commit invocation from $REPO_ROOT; it rebases onto origin/main and lands it. NEVER git push this commit to main by hand — it bypasses the rebase/layer-2 merge ladder and can clobber a concurrent landing." >&2
}

# emit_verdict_and_exit <context> — print the verdict (if not already printed)
# and exit on it. `landed` and `landed-equivalent` are the ONLY statuses that
# exit 0; `unknown` never does. Usage errors (exit 2) and --base staleness
# (exit 3) do not route through here and keep their own codes. On the two
# statuses that leave the outcome unsatisfied, name any local commit left
# behind and its recovery before exiting.
emit_verdict_and_exit() { # <context>
  print_verdict "$1"
  case "$LAST_VERDICT" in
    landed|landed-equivalent) exit 0 ;;
  esac
  print_orphan_recovery_line
  exit 1
}

# --- Prune-id membership ----------------------------------------------------
# Return 0 iff <id> is one of the --prune ids (a deletion, not an edit).
is_prune_id() {
  local id="$1" p
  for p in "${PRUNE_IDS[@]}"; do
    [[ "$p" == "$id" ]] && return 0
  done
  return 1
}

# --- Layer 2: field-level auto-merge of a textual rebase conflict ------------
# Called with a rebase in progress (conflicted paths staged as unmerged) after
# `git pull --rebase origin main` hit a textual CONFLICT, BEFORE aborting and
# parking. For each conflicted intentions/<id>.md, attempt an automatic
# field-level merge via run_merge_node(). Returns 0 iff EVERY conflicted id
# fully resolved AND `git rebase --continue` then succeeded — the caller falls
# through to the normal post-pull stamping/push path exactly as if the pull had
# succeeded outright. Returns 1 on any unresolved id (the caller aborts the
# rebase and returns 10 → parks); unresolved fields accumulate in
# CONFLICT_FIELDS_JSON. Dies only on the broken-invariant case (a conflicted
# path outside this invocation's node set).
try_layer2_resolve() {
  local conflicted path id all_resolved=1
  conflicted="$(git diff --name-only --diff-filter=U)"
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    id="${path#intentions/}"
    id="${id%.md}"
    # Defensive: only requested paths are ever staged by this writer, so a
    # conflicted path outside ALL_IDS (EXPECTED holds exactly ALL_IDS's paths)
    # is a broken invariant, not a content divergence — die, do not continue.
    if [[ -z "${EXPECTED[$path]:-}" ]]; then
      die "unexpected conflicted path '$path' not in this invocation's node set — broken staging invariant"
    fi
    # A prune (deletion) has no content to structurally merge against — record a
    # sentinel and mark unresolved for this id without calling run_merge_node.
    if is_prune_id "$id"; then
      append_conflicts "$(jq -cn --arg id "$id" '[{id: $id, note: "prune vs. concurrent edit"}]')"
      all_resolved=0
      continue
    fi
    # GIT-REBASE STAGE NUMBERING (do NOT get this backwards — documented here so
    # future readers don't invert it): during `git rebase`, HEAD is replayed
    # ONTO the upstream tip, so
    #   stage :1: = merge-base                                (this plan's "base")
    #   stage :2: = UPSTREAM / already-landed content         (this plan's "theirs")
    #   stage :3: = the patch being replayed / this writer's
    #               intended content                         (this plan's "ours")
    # This is the OPPOSITE of `git merge`'s numbering, where stage 2 is ours and
    # stage 3 is theirs. run_merge_node() takes (<id> <base> <ours> <theirs>
    # <out>) by the merge primitive's SEMANTIC naming, so we pass stage 3 as
    # "ours" and stage 2 as "theirs" even though the raw git stage numbers are
    # swapped from that.
    local base_arg ours_arg theirs_arg out_f
    out_f="$SNAP_DIR/.merge-$id.out"
    base_arg="$(stage_file_or_empty 1 "$path" "$SNAP_DIR/.merge-$id.base")"
    theirs_arg="$(stage_file_or_empty 2 "$path" "$SNAP_DIR/.merge-$id.theirs")"
    ours_arg="$(stage_file_or_empty 3 "$path" "$SNAP_DIR/.merge-$id.ours")"
    if run_merge_node "$id" "$base_arg" "$ours_arg" "$theirs_arg" "$out_f"; then
      # Resolved: install the merged content at the real repo path and stage it.
      cp -- "$out_f" "$path"
      git add -- "$path"
    else
      all_resolved=0
    fi
  done <<<"$conflicted"

  [[ "$all_resolved" -eq 1 ]] || return 1

  # Every conflicted id resolved and staged — continue the rebase. If it
  # unexpectedly fails (a stage we did not enumerate, a hook, etc.), treat it as
  # unresolved so the caller aborts and parks — do not assume infallibility.
  # GIT_EDITOR=true (scoped to this call only) keeps the implicit
  # commit-message-edit step non-interactive: it reuses the replayed commit
  # message instead of trying to open an editor, which fails in
  # non-interactive environments (e.g. CI) with no EDITOR/VISUAL/core.editor
  # configured and TERM=dumb.
  GIT_EDITOR=true git rebase --continue >&2 || return 1
  return 0
}

# Write stage <n> of <path> into <dest>; echo <dest> when the stage exists, or
# the empty string when it does not (an add/add or delete/modify conflict leaves
# a stage absent). merge-node.ts reads an empty-string arg as "this side did not
# exist" rather than parsing an empty file, so a missing stage must map to "".
stage_file_or_empty() {
  local stage="$1" path="$2" dest="$3"
  if git show ":$stage:$path" >"$dest" 2>/dev/null; then
    printf '%s' "$dest"
  else
    rm -f -- "$dest"
    printf '%s'
  fi
}


# --- Landing lock (distributed CAS lock with TTL steal) --------------------
# Serializes the rebase → stamp → push critical section across concurrent
# graph-commit invocations, so a losing writer waits/backs off cheaply instead
# of burning a full CI-stamp cycle (30–180s) it is very likely to lose.
#
# There is no shared filesystem or coordination server across the machines that
# run graph-commit — the only shared, atomically-updatable medium is the git
# remote itself. So the lock IS a git ref: refs/graph/landing-lock, whose value
# is an orphan (parentless) commit object encoding the current holder's identity
# and an expiry timestamp. Mutual exclusion rides on git's own server-side
# compare-and-swap on ref updates:
#   - Claiming a free lock is a non-force push to a ref that does not yet exist.
#     git rejects it if a concurrent writer created the ref first — that is an
#     atomic CAS on "still absent".
#   - Renewing our own claim, or stealing an expired foreign one, is a
#     --force-with-lease push that only lands if the remote ref still equals the
#     exact SHA we observed — an atomic CAS on "unchanged since we looked".
# A losing CAS never corrupts anything; the loser simply re-observes and loops.
#
# TTL steal keeps a crashed holder (one that dies without releasing) from
# freezing the lock forever: each claim carries expiry = now + LOCK_TTL_SECONDS,
# and once that passes any waiter may steal the ref (again via the leased CAS,
# so two simultaneous stealers can't both win). LOCK_WAIT_DEADLINE (set by the
# caller) bounds how long a writer waits before giving up entirely.
#
# Payload encoding — a lock claim is a single orphan commit whose tree is git's
# universal empty-tree object (4b825dc642cb6eb9a060e54bf8d69288fbee4904) and
# whose message is exactly two lines:
#     graph-commit-lock v1
#     holder=<LOCK_HOLDER_ID> expiry=<unix_epoch_seconds>
# Author/committer identity is whatever git commit-tree picks up from ambient
# user.name/user.email — no special identity handling.

# build_lock_commit <expiry_unix_ts> -> prints a new orphan commit SHA.
build_lock_commit() {
  local expiry="$1"
  git commit-tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -m "graph-commit-lock v1" \
    -m "holder=$LOCK_HOLDER_ID expiry=$expiry"
}

# read_lock_payload <ref-or-sha> — read an already-fetched ref/sha's message and
# set LOCK_OBS_HOLDER / LOCK_OBS_EXPIRY from its second line (parsed with bash's
# own [[ =~ ]], no external grep/sed). Two distinct failure shapes, handled
# differently:
#   - The object is not (yet) in this clone's local object database: `git show`
#     fails and we `return 1` on that line itself, quietly — this is the normal,
#     expected case the first time a given lock SHA is observed, and the caller
#     recovers by fetching. It must NOT fall through to the parse-failure die.
#   - The object IS readable but its message does not parse as a lock payload:
#     that is a broken-environment condition, so die() rather than silently skip
#     (per code-style.md's clear-errors-over-fallbacks convention).
read_lock_payload() {
  local ref="$1" body line2
  body="$(git show -s --format=%B "$ref" 2>/dev/null)" || return 1
  line2="$(printf '%s\n' "$body" | tail -n1)"
  if [[ "$line2" =~ ^holder=([^[:space:]]+)\ expiry=([0-9]+)$ ]]; then
    LOCK_OBS_HOLDER="${BASH_REMATCH[1]}"
    LOCK_OBS_EXPIRY="${BASH_REMATCH[2]}"
  else
    die "malformed landing-lock payload on $ref: '$line2'"
  fi
}

# lock_claim_or_renew — no arguments. Loops until this process holds a live
# claim (sets LOCK_SHA + LOCK_HELD=1 and returns 0), or until LOCK_WAIT_DEADLINE
# (set by the caller before the first call, a later unit) passes without
# acquiring, in which case it returns 1.
#
# Note: `git ls-remote` returning a SHA does NOT guarantee the corresponding
# commit object is already in the LOCAL object database — `git clone`/`git
# fetch` never pull refs/graph/** by default — hence the fetch fallback around
# read_lock_payload. And even if the ref moves again between the ls-remote and
# that fetch (so FETCH_HEAD names something newer than $remote_sha), every
# subsequent write below leases against $remote_sha specifically — the original
# ls-remote observation — never against whatever FETCH_HEAD resolved to. So a
# stale read only ever wastes a loop iteration; it can never cause an incorrect
# write.
lock_claim_or_renew() {
  local remote_sha now expiry new_sha
  while :; do
    remote_sha="$(git ls-remote origin "$LOCK_REF" | cut -f1)"
    now="$(date +%s)"
    # Deadline check up front, before any branch below — covers every
    # `continue` path (lost create race, lost renew/steal race, live
    # foreign holder), not just the live-holder wait. Without this, a
    # pathological run of repeated lost create/steal races would spin
    # with no sleep and no exit condition.
    if [[ "$now" -ge "$LOCK_WAIT_DEADLINE" ]]; then
      return 1
    fi

    if [[ -z "$remote_sha" ]]; then
      # No one holds it: try to CREATE it. A non-force push to a ref that
      # does not yet exist is git's own atomic CAS on "still absent" — it
      # is rejected if a concurrent writer created the ref first, in which
      # case we fall through and re-observe as "exists".
      new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
      if git push origin "$new_sha:$LOCK_REF" >&2; then
        LOCK_SHA="$new_sha"; LOCK_HELD=1
        return 0
      fi
      # Rejected: almost always a lost create race — re-observe as "exists"
      # on the next loop pass. Left un-redirected (not `2>/dev/null`) so a
      # genuine non-race failure (auth/network) is visible in the log rather
      # than silently swallowed — per code-style.md's clear-errors-over-fallbacks.
      continue
    fi

    # read_lock_payload returns 1 (quietly) when the object named by
    # $remote_sha is not yet in this clone's local object database — the
    # normal case the FIRST time this process observes a given lock SHA,
    # since `git clone`/`git fetch` never pull refs/graph/** by default.
    # It only `die`s if the object IS readable but fails to parse.
    read_lock_payload "$remote_sha" || {
      git fetch -q origin "$LOCK_REF" >&2
      read_lock_payload FETCH_HEAD
    }

    if [[ "$LOCK_OBS_HOLDER" == "$LOCK_HOLDER_ID" ]]; then
      # Renewing our own still-recorded claim.
      new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
      if git push --force-with-lease="$LOCK_REF:$remote_sha" origin "$new_sha:$LOCK_REF" >&2; then
        LOCK_SHA="$new_sha"; LOCK_HELD=1
        return 0
      fi
      # Lease rejected: we were slow enough that someone else already
      # reclaimed it out from under us. Re-observe from scratch.
      continue
    fi

    if [[ "$LOCK_OBS_EXPIRY" -gt "$now" ]]; then
      # Live, foreign holder: wait, don't steal.
      sleep "$LOCK_POLL_SECONDS"
      continue
    fi

    # Expired: steal, atomically, only if the ref still equals what we
    # just observed (guards a simultaneous-steal race against another
    # waiter that observed the same expiry).
    new_sha="$(build_lock_commit "$((now + LOCK_TTL_SECONDS))")"
    if git push --force-with-lease="$LOCK_REF:$remote_sha" origin "$new_sha:$LOCK_REF" >&2; then
      LOCK_SHA="$new_sha"; LOCK_HELD=1
      return 0
    fi
    continue
  done
}

# lock_release — no-op unless we currently hold the lock; best-effort. The
# --force-with-lease on the delete refspec is atomic ("delete only if the remote
# ref still equals $LOCK_SHA"), so this process never deletes a lock it no
# longer owns — e.g. after losing a steal race, or after its own
# LOCK_WAIT_SECONDS timeout let another writer reclaim the ref. Always
# non-fatal (|| true) so a release failure never masks the caller's real exit
# status, mirroring the scratch-branch delete's discipline in cleanup().
lock_release() {
  [[ "$LOCK_HELD" -eq 1 ]] || return 0
  git push --force-with-lease="$LOCK_REF:$LOCK_SHA" origin ":$LOCK_REF" >&2 || true
  LOCK_HELD=0
  LOCK_SHA=""
}

# --- Bounded build + stamp + push loop -------------------------------------
# Runs up to MAX_PUSH_ATTEMPTS of:
#   <produce this attempt's SHA> → push <sha>:graph/<scratch> → await checks →
#   push <sha>:main.
# A fresh SHA must first carry the four required contexts (checks attach to the
# SHA, not the branch), so each attempt stamps the SHA via the `graph/**` fast
# path before fast-forwarding it onto main.
#
# ONLY the first step differs by GRAPH_COMMIT_WRITER (see that variable's block
# near the top of this file):
#   worktree  — commit_files(), then `git pull --rebase origin main` (layer 2
#               resolves a textual conflict in place), then `git rev-parse HEAD`.
#               A rejected push to main is answered by rebasing and retrying.
#   plumbing  — prepare_plumbing_sha(): fetch origin/main, reconcile the on-disk
#               nodes against that fresh base, build the commit on it. A rejected
#               push to main is answered by REBUILDING on the newer base.
# Everything after the SHA exists is shared verbatim by both.
#
# Returns:
#   0  pushed.
#   10 a CONCURRENT EDIT to one of this invocation's own nodes could NOT be
#      fully resolved by the field-level merge — surfaced as a rebase conflict
#      layer 2 (try_layer2_resolve) declined for the worktree writer, or as a
#      moved blob reconcile_plumbing_base() declined for the plumbing writer.
#      The caller fails closed and parks. A divergence the merge DOES resolve
#      falls through to the normal push path (returning 0), never surfacing
#      as 10.
#   11 every attempt failed with no conflict (busy main, or the checks never
#      stamped green within the poll window).
# Dies on a non-conflict rebase/fetch/build failure (broken environment), and on
# a CONCLUDED check failure — a concluded non-success is a property of the
# commit content, not of contention, so every retry would reproduce it; the
# remaining attempts are not burned (clear error over a fallback, per
# code-style.md).
#
# An ORPHANED required row (await_checks rc 3) is neither of those: it is a
# GitHub-side artifact that says nothing about the content. It is answered by
# deleting and re-pushing the `graph/**` scratch ref to stamp the SHA again,
# up to MAX_ORPHAN_RESTAMPS times, on a budget of its own — the landing attempt
# counter is rolled back, so no orphan can consume a landing attempt or be
# reported as a busy main. Past that cap the run dies with a message that names
# the GitHub-side cause; it never silently falls back to the content-failure
# accusation (code-style.md).
try_land() {
  # sha is initialized (not merely declared) because the terminal message below
  # reads it on the path where the loop ended before any attempt reached the
  # `git rev-parse HEAD` that assigns it.
  local attempt ck sha="" orphan_restamps=0
  LOCK_WAIT_DEADLINE=$(( $(date +%s) + LOCK_WAIT_SECONDS ))
  for (( attempt=1; attempt<=MAX_PUSH_ATTEMPTS; attempt++ )); do
    # Serialize concurrent invocations on the landing lock so a losing writer
    # waits/backs off instead of burning a full CI-stamp cycle only to lose
    # the final push to main anyway.
    if ! lock_claim_or_renew; then
      LAST_LAND_REASON="the landing lock was not acquired within the ${LOCK_WAIT_SECONDS}s wait window (another writer held it)"
      break
    fi

    # ORPHAN-WINDOW CONTAINMENT: the local commit is made HERE — after the lock
    # is held and immediately before the rebase — not in main() before land().
    # A wrapper killed while this process blocks in lock_claim_or_renew() (up to
    # LOCK_WAIT_SECONDS on a contended lock) would otherwise die with a local
    # commit already made and never pushed, leaving an orphan; that lock-wait
    # window is where the observed incidents died. Committing after the wait
    # removes the whole window from the interval a kill can orphan in. The
    # residual commit → stamp → push window CANNOT be removed (git has no atomic
    # commit-and-push), so an orphan is narrower, not impossible — see the
    # header block's recovery rule.
    #
    # Idempotent by the same discriminator main() used: once the commit exists
    # the id files are clean against HEAD, so every retry iteration (and
    # park_and_exit()'s own land(), which commits the parking write before
    # calling it) finds nothing to stage and no-ops here.
    #
    # `|| die` is load-bearing HERE in a way it was not in main(): land() calls
    # this function as `try_land || rc=$?`, which suppresses errexit for its
    # whole body, so a failing commit_files would otherwise fall through and
    # this attempt would go on to stamp and push a SHA that does not carry the
    # writer's content (clear error over a silent fallback, code-style.md).
    #
    # ALL OF THE ABOVE IS ABOUT THE WORKTREE ARM (the `else` below), which is
    # where the local commit is made. The plumbing arm has no local commit and
    # therefore no orphan window at all: it builds a commit reachable from no
    # ref, and a kill at any point before the push leaves the repository
    # byte-identical to how it found it.
    if [[ "$GRAPH_COMMIT_WRITER" == "plumbing" ]]; then
      # No local commit, no rebase, no tree mutation: fetch, reconcile the
      # on-disk nodes against the fresh origin/main, and build the commit on it
      # with the tree plumbing. The `|| prc=$?` (not `|| die`) is load-bearing
      # for the same reason the worktree arm's is: land() calls this function as
      # `try_land || rc=$?`, so errexit is suppressed for this whole body and a
      # silent fall-through would stamp and push a SHA nobody built.
      local prc=0
      prepare_plumbing_sha || prc=$?
      if [[ "$prc" -eq 10 ]]; then
        # A same-node concurrent edit the field-level merge could not resolve —
        # park (return 10, which land() maps to 12), exactly as an unresolvable
        # rebase conflict does on the worktree arm. Nothing to abort: no rebase
        # was started and the checkout was never touched.
        lock_release
        return 10
      fi
      [[ "$prc" -eq 0 && -n "$ATTEMPT_SHA" ]] \
        || die "the plumbing writer produced no commit for ${ALL_IDS[*]} (status $prc) — nothing was pushed"
      sha="$ATTEMPT_SHA"
    else
      if id_files_dirty; then
        commit_files || die "could not create the local commit for ${ALL_IDS[*]} — nothing was pushed"
      fi

      if ! git pull --rebase origin main >&2; then
        if ! rebase_in_progress; then
          die "'git pull --rebase origin main' failed and left no rebase in progress (fetch failure or another unexpected git error — an unrelated dirty tracked file would have been caught by the pre-flight check)"
        fi
        echo "graph-commit: rebase conflict on attempt $attempt/$MAX_PUSH_ATTEMPTS (concurrent edit to the same node); attempting layer-2 field-level auto-merge before parking" >&2
        if ! try_layer2_resolve; then
          # Layer 2 could not fully resolve every conflicted field — abort the
          # rebase and park (return 10, which land() maps to 12).
          git rebase --abort >&2 || true
          lock_release
          return 10
        fi
        # Layer 2 resolved every conflicted id and `git rebase --continue`
        # succeeded — fall through to the normal stamping/push path below exactly
        # as if `git pull --rebase` had succeeded outright the first time.
        echo "graph-commit: layer-2 auto-merge resolved all conflicted node(s) on attempt $attempt/$MAX_PUSH_ATTEMPTS; continuing" >&2
      fi

      # The exact SHA we intend to land; the required checks stamp onto it.
      sha="$(git rev-parse HEAD)"
    fi

    # Stamp the SHA: push it to the `graph/**` scratch branch so the fast-path
    # workflow runs and stamps the four required contexts. Plain --force (not
    # --force-with-lease): the scratch branch is reused across attempts within
    # this invocation and we never fetch its remote-tracking ref, so a lease
    # expectation would go stale and spuriously reject the second push. It is a
    # PID-scoped branch this process owns and deletes, so a blind force is safe.
    # The refspec names $sha explicitly rather than HEAD: for the worktree writer
    # the two are the same object (HEAD was read into $sha one line ago), and for
    # the plumbing writer the commit is reachable from no ref at all.
    if ! git push --force origin "$sha:refs/heads/$SCRATCH_BRANCH" >&2; then
      LAST_LAND_REASON="the scratch push to the graph scratch branch $SCRATCH_BRANCH failed"
      echo "graph-commit: scratch push to $SCRATCH_BRANCH failed on attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying" >&2
      continue
    fi
    SCRATCH_PUSHED=1

    # Wait for the fast path to stamp the four required checks green on this SHA.
    ck=0
    await_checks "$sha" || ck=$?
    if [[ "$ck" -eq 2 ]]; then
      # Deterministic failure: a required check CONCLUDED non-success, so the
      # content itself is broken — rebasing and re-stamping would reproduce
      # the same failure on every remaining attempt.
      die "a required check concluded non-success for $sha — the commit content fails CI; not retrying (fix the content and re-run)"
    fi
    if [[ "$ck" -eq 3 ]]; then
      # ORPHANED required row: it carries no conclusion and its parent check
      # suite has already concluded, so GitHub will never report it. That is a
      # statement about GitHub, not about this commit — so the remedy is a fresh
      # stamping run for the same SHA, not an accusation and not a wait.
      #
      # Deleting the scratch ref is load-bearing, not tidiness: the remote ref
      # already points at $sha, so a bare `git push --force` of the same SHA is
      # "Everything up-to-date" — no push event, no workflow run, no new check
      # rows. Deleting first makes the next iteration's push a branch-CREATING
      # push, byte-for-byte the same event shape as this run's first stamp, which
      # is what runs .github/workflows/graph-fast-path.yml again.
      #
      # LIMIT ON THE EVIDENCE: test-graph-commit.sh's fixtures model GitHub's API
      # RESPONSES, and a fixture mode replays one payload for every poll. The
      # suite can therefore prove the routing, the cap, the rolled-back attempt
      # counter and the terminal message — it CANNOT prove that real GitHub
      # answers a re-stamped SHA with a reporting check suite rather than
      # replaying the orphaned row. That is an untested assumption, stated here
      # rather than implied. What the remedy does NOT rest on is check-suite
      # identity: await_checks resolves each required name by max_by(.id), so any
      # newly created row wins over the orphan whether GitHub files it under a
      # fresh suite or re-opens the old one.
      orphan_restamps=$(( orphan_restamps + 1 ))
      if (( orphan_restamps > MAX_ORPHAN_RESTAMPS )); then
        die "a required check for $sha is still ORPHANED after $MAX_ORPHAN_RESTAMPS re-stamp(s) — $(check_state_phrase "$sha"). This is a GitHub-side condition, NOT broken commit content: the check-run row carries no conclusion while its parent check suite has already concluded, so no verdict for it will ever arrive and 'gh run rerun' refuses the run. The content was never judged and nothing was pushed to main. Check https://www.githubstatus.com and re-run graph-commit to stamp a fresh run; raise GRAPH_COMMIT_MAX_ORPHAN_RESTAMPS only when GitHub is known to be recovering"
      fi
      echo "graph-commit: required check ORPHANED on $sha (GitHub-side, not a content failure); deleting scratch $SCRATCH_BRANCH and re-stamping — re-stamp $orphan_restamps/$MAX_ORPHAN_RESTAMPS, landing attempt $attempt/$MAX_PUSH_ATTEMPTS not consumed" >&2
      # No `|| true` here, unlike cleanup()'s best-effort delete: if the ref
      # survives, the next push is the no-op described above and the re-stamp is
      # a lie. Fail loudly instead (code-style.md).
      git push origin --delete "$SCRATCH_BRANCH" >&2 \
        || die "could not delete the graph scratch branch $SCRATCH_BRANCH to re-stamp orphaned checks on $sha — without the delete the re-push is a no-op and no fresh check run would start; nothing was pushed to main"
      SCRATCH_PUSHED=0
      LAST_LAND_REASON="a required check row was orphaned by GitHub (no conclusion under an already-concluded check suite)"
      # Roll the attempt back: this iteration bought a fresh stamp, it did not
      # spend a landing attempt. orphan_restamps is monotone across the whole
      # call, so the loop still terminates.
      attempt=$(( attempt - 1 ))
      continue
    fi
    if [[ "$ck" -ne 0 ]]; then
      LAST_LAND_REASON="the required checks did not report green within the ${CHECK_TIMEOUT_SECONDS}s poll window"
      echo "graph-commit: checks did not go green for $sha on attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying — $(check_state_phrase "$sha")" >&2
      continue
    fi

    # The SHA now carries the four passing contexts — fast-forward it onto main.
    if [[ "$(git ls-remote origin "$LOCK_REF" | cut -f1)" != "$LOCK_SHA" ]]; then
      LAST_LAND_REASON="the landing lock was stolen after expiry before the main push"
      echo "graph-commit: landing lock no longer held (stolen after expiry) before the main push on attempt $attempt/$MAX_PUSH_ATTEMPTS; re-claiming and retrying" >&2
      LOCK_HELD=0
      continue
    fi
    # Record the intended landing sha BEFORE the push, never after: the push's
    # own return code is the signal that cannot be trusted, so a process that
    # survives a lying push must still know which sha to ask origin/main about
    # (see PUSHED_SHA in the globals block and print_verdict()).
    PUSHED_SHA="$sha"
    if git push origin "$sha:main" >&2; then
      lock_release
      return 0
    fi
    LAST_LAND_REASON="the push to main was rejected because main advanced"
    echo "graph-commit: push of $sha to main rejected (main advanced), attempt $attempt/$MAX_PUSH_ATTEMPTS; rebasing and retrying" >&2
  done
  lock_release
  local ran=$attempt
  (( ran > MAX_PUSH_ATTEMPTS )) && ran=$MAX_PUSH_ATTEMPTS
  # Cause, then evidence. LAST_LAND_REASON is what ended the LAST attempt —
  # known exactly, never guessed at — and check_state_phrase() attributes the
  # check snapshot to the commit it was actually read on (or says plainly that
  # no such observation exists), so an earlier attempt's snapshot can never be
  # mistaken for a current reading of this failure.
  echo "error: graph-commit: could not land on main after $ran/$MAX_PUSH_ATTEMPTS attempts — cause: ${LAST_LAND_REASON:-<no attempt reached an exit branch>}; $(check_state_phrase "$sha"); retry later" >&2
  return 11
}

# --- Land: fail closed on an unresolvable conflict --------------------------
# A rebase conflict means a concurrent writer landed an OVERLAPPING edit to the
# same node while this one was in flight. try_land() first attempts an automatic
# field-level merge (layer 2, try_layer2_resolve): when every conflicted field
# merges cleanly the rebase is continued in place and the write lands normally
# (rc 0). Only when layer 2 CANNOT resolve every conflicted field does the
# conflict map to the parking outcome — replaying this writer's whole-file
# snapshot over the other writer's landed content would silently discard that
# edit (the entire file, not just the conflicting hunk) while still exiting 0,
# so an unresolvable conflict parks rather than retries or overwrites.
# Returns:
#   0  landed (possibly after a layer-2 auto-merge resolved the conflict).
#   11 pure rejection exhausted with NO conflict (busy main — fail loudly, do
#      not park; this is not a semantic conflict).
#   12 a rebase CONFLICT layer 2 could not fully resolve (the caller parks).
land() {
  local rc=0
  try_land || rc=$?
  case "$rc" in
    0) return 0 ;;
    11) return 11 ;;
    10) return 12 ;;
    *)
      die "unexpected land status $rc"
      ;;
  esac
}

# --- Recommendation text for a mechanical-unresolved park -------------------
# Render CONFLICT_FIELDS_JSON (the layer-2/3 unresolved-field accumulator) into a
# human-readable, per-conflict breakdown for office_hours.recommendation. Handles
# BOTH entry shapes present in the array:
#   {id, field, ours, theirs}  — a real diverged field. `ours` is this session's
#                                value, `theirs` is origin/main's; each renders
#                                raw when it is already a string, else as compact
#                                JSON (an array/object field).
#   {id, note}                 — a generic sentinel (merge-node crash, or a
#                                prune-vs-concurrent-edit) with no field detail.
# One block per entry, blank-line separated. Emitted on stdout.
build_recommendation() {
  local jqprog="$SNAP_DIR/.park-recommendation.jq"
  cat >"$jqprog" <<'JQ'
def render_value: if type == "string" then . else tojson end;
map(
  if has("field") then
    "Diverged field '\(.field)' on \(.id):\n  this session's value: \(.ours|render_value)\n  origin/main's value: \(.theirs|render_value)"
  else
    "Unresolved conflict on \(.id): \(.note // "no field-level detail captured")"
  end
) | join("\n\n")
JQ
  jq -rf "$jqprog" "$CONFLICT_FIELDS_JSON"
}

# --- Conflicted-id set -------------------------------------------------------
# CONFLICT_FIELDS_JSON's every entry (both the {id,field,ours,theirs} shape and
# the {id,note} sentinel shape) carries an `id` key — it is the authoritative
# registry of which ids this invocation could not resolve. Emits the distinct
# ids, one per line, on stdout; returns 1 (no output) when the accumulator was
# never created or is empty, which park_and_exit() treats as "could not
# determine the conflicted set" and falls back to parking every id.
# `-s` alone is not emptiness: the accumulator is created holding the two-byte
# literal `[]` (init_conflict_fields()), and an append of a zero-length array
# leaves it that way — so the id list itself, not the file size, decides. This
# matches park_write()'s reader, which gates on `jq 'length'` for the same file.
conflicted_ids() {
  [[ -n "$CONFLICT_FIELDS_JSON" && -s "$CONFLICT_FIELDS_JSON" ]] || return 1
  local ids
  ids="$(jq -r '.[].id' "$CONFLICT_FIELDS_JSON" | sort -u)"
  [[ -n "$ids" ]] || return 1
  printf '%s\n' "$ids"
}

# --- Parking fallback ------------------------------------------------------
# A genuine semantic conflict: set office_hours on each target node via store.ts
# (readNode → set office_hours → writeNode) so the frontmatter is serialized
# correctly and — for a tactic — its authoritative body is preserved. Uses a
# throwaway tsx module rather than hand-editing YAML.
#
# office_hours.recommendation is composed ADDITIVELY from two independently
# planned layers (tactic-graph-commit-auto-serialization Unit 4 appends to,
# never replaces, tactic-graph-commit-park-context's text):
#   - BASE (park-context): a per-id recovery recommendation the tsx helper sets
#     for EVERY parked node — snapshot pointer, mailbox discipline, and a
#     prune-vs-edit distinction.
#   - APPENDED (this tactic, layers 1-3): keyed on whether the layer-2/3
#     accumulator (CONFLICT_FIELDS_JSON) captured field-level divergence detail.
#     Has entries → office_hours.reason is upgraded to the stable
#     "mechanical-unresolved" marker (a contract a future dispatch-conflict skill
#     greps for) plus the count of diverged fields, and build_recommendation()'s
#     per-conflict field breakdown is appended after the base recovery text.
#     Empty/absent (unset global, missing file, or a `[]` array — a park
#     unrelated to a mechanical-merge attempt) → the plain concurrent-edit reason
#     and the base recovery recommendation only, with no field breakdown.
#   - CARRIED CONTENT (tactic-graph-commit-park-content-durability): the losing
#     writer's frozen original, embedded VERBATIM last, capped. Before it, a park
#     recorded that content only as a path into SNAP_DIR — a bare `mktemp -d`
#     that KEEP_SNAP=1 protects from cleanup() but not from the host, the tmp
#     reaper, or the container. The recommendation is the one part of an ordinary
#     park that lands on origin/main, so carrying the bytes there is what makes
#     the preservation durable. Absent for a --prune id (no snapshot exists).
#     See ownContentEmbed() in the helper for the cap and the truncation notice.
park_write() {
  local since reason tmpts prune_csv rec_file=""
  since="$(date -u +%Y-%m-%d)"
  reason="graph-commit: concurrent-edit conflict — manual merge needed"

  # Layers 1-3 (this tactic): if the layer-2/3 accumulator captured field-level
  # divergence, upgrade the reason to the greppable "mechanical-unresolved"
  # marker and render build_recommendation()'s per-conflict field breakdown to a
  # file. It is passed OUT OF BAND via GRAPH_COMMIT_RECOMMENDATION_FILE (a path
  # to a tempfile), not argv: it can be a long, multi-line string, and keeping it
  # off argv both dodges argv length/shell-quoting limits AND preserves the
  # helper's positional-argument contract. The helper appends it after each
  # node's base recovery recommendation. Unset/empty → base recovery text only.
  if [[ -n "$CONFLICT_FIELDS_JSON" && -s "$CONFLICT_FIELDS_JSON" ]]; then
    local n
    n="$(jq 'length' "$CONFLICT_FIELDS_JSON")"
    if [[ "${n:-0}" -gt 0 ]]; then
      reason="graph-commit: mechanical-unresolved — ${n} field(s) diverged across concurrent writes and could not be auto-merged (layers 1-3 exhausted)"
      rec_file="$SNAP_DIR/park-recommendation.txt"
      build_recommendation >"$rec_file"
    fi
  fi

  # Comma-join PRUNE_IDS (from tactic-graph-commit-park-context, already
  # populated by main()'s arg parsing) so the tsx helper can tell a prune id (no
  # on-disk snapshot — a deletion has nothing to preserve) from an ordinary edit
  # id (snapshotted to SNAP_DIR/<id>.md by snapshot(), graph-commit:272-280) when
  # composing each node's base recovery recommendation — and, more load-bearing,
  # whether a MISSING target file is expected (prune) or a delete/modify
  # divergence (edit). The split is total because validate_id_chars() rejects a
  # comma in any id; the helper re-asserts that rather than trusting it.
  prune_csv="$(IFS=,; echo "${PRUNE_IDS[*]:-}")"
  tmpts="$(mktemp --suffix=.mts)" || die "could not create temp file for the parking write"
  cat >"$tmpts" <<'TS'
// argv: <storeModule> <intentionsDir> <since> <reason> <snapDir> <pruneCsv> <id...>
// Composes office_hours.recommendation additively (tactic-graph-commit-auto-
// serialization Unit 4 appends to, never replaces, park-context's text): the
// per-id BASE recovery recommendation below (snapshot pointer / mailbox
// discipline / prune-vs-edit) always applies, and this tactic's field-level
// breakdown — passed OUT OF BAND via GRAPH_COMMIT_RECOMMENDATION_FILE — is
// appended after it when a mechanical merge left field divergence
// (unset/empty env var → base recovery text only). ownContentEmbed()'s verbatim
// copy of the losing writer's frozen original is appended last of all, so the
// landed record carries the content and not merely a path into snapDir.
import { readFileSync, writeFileSync, lstatSync, unlinkSync } from "node:fs";
import { join } from "node:path";
const [storePath, intentionsDir, since, reason, snapDir, pruneCsv, ...ids] = process.argv.slice(2);
const pruneSet = new Set(pruneCsv ? pruneCsv.split(",") : []);
const recFile = process.env.GRAPH_COMMIT_RECOMMENDATION_FILE || "";
const fieldBreakdown = recFile ? readFileSync(recFile, "utf8").trimEnd() : "";
// Out-of-band report back to the shell: the ids re-materialized below, NUL-
// delimited. park_and_exit() reads it into RESURRECTED_IDS and excludes those
// ids from the park commit's `git add` set.
const resurrectedFile = process.env.GRAPH_COMMIT_RESURRECTED_FILE || "";
const { readNode, writeNode } = await import(storePath);
// lstat, never stat: it does NOT follow symlinks, so a symlink (dangling or
// not) at the target path is seen as a symlink rather than as its target's
// existence. `null` means "no entry at all".
const lstatOrNull = (p) => { try { return lstatSync(p); } catch { return null; } };
// --- SNAP_DIR path contract (the shell side is snap_intended_file()) --------
// snapDir holds up to TWO files per id: <id>.md, the writer's FROZEN pre-merge
// original, and <id>.merged.md, graph-commit's own merge output, written only
// when a layer-2/3 merge resolved for that id. The helpers below are the ONE
// place that decides which content a human is pointed at, which content the
// record CARRIES, and how the two files are described — every recovery branch
// below calls preservedContent(id) rather than composing its own path wording.
const snapOriginal = (id) => join(snapDir, `${id}.md`);
const snapMerged = (id) => {
  const p = join(snapDir, `${id}.merged.md`);
  const st = lstatOrNull(p);
  return st && st.isFile() ? p : "";
};
// What this run INTENDED to land for the id: the merge output when there is
// one, else the frozen original.
const snapIntended = (id) => snapMerged(id) || snapOriginal(id);
// --- The park must CARRY the losing writer's content, not point at it -------
// snapDir is a bare `mktemp -d`. park_and_exit() sets KEEP_SNAP=1 so cleanup()
// spares it, which survives the PROCESS — not the host, the tmp reaper, or the
// container. A park whose only record of the losing writer's edit is a path
// into that directory preserves nothing durable.
// office_hours.recommendation is the one part of an ordinary park that lands on
// origin/main, so the frozen original goes in there VERBATIM. The snapDir paths
// stay in the text as a convenience for a human still on the machine that wrote
// them, no longer as the sole copy.
// (The delete/modify branch calls the same helpers, and its record is local
// only for a reason stated in its own text — that branch's durability is not
// this seam's to fix, and its control flow is unchanged.)
//
// Capped on purpose. A park embeds whatever the losing writer had on disk; on a
// SECOND park that file can already carry the FIRST park's embedded copy, which
// without a cap nests without bound. Over the cap the block carries the leading
// EMBED_LIMIT bytes, cut at a line boundary — or, when the window holds no line
// boundary at all, at a UTF-8 codepoint boundary — and states exactly how many
// bytes were omitted and where the whole file is — never a silent truncation.
const EMBED_LIMIT = 65536;
const embedCache = new Map();
// Largest byte index <= `end` that does NOT fall inside a multi-byte UTF-8
// sequence. Walk back over continuation bytes (10xxxxxx) to the lead byte that
// governs them, and keep that whole sequence only when it finishes at or before
// `end`; otherwise cut in front of it.
//
// This exists because a naive byte slice can split a codepoint, and Node then
// decodes the dangling bytes to a 3-byte U+FFFD. Measuring THAT decoded string
// reports a byte count the file never had, so the truncation note would state a
// wrong "N of M bytes omitted" — see utf8CutEnd's caller.
const utf8CutEnd = (buf, end) => {
  let i = end - 1;
  while (i >= 0 && (buf[i] & 0xc0) === 0x80) i--;
  if (i < 0) return end; // nothing but continuation bytes in the window
  const lead = buf[i];
  const len =
    (lead & 0x80) === 0x00 ? 1 :
    (lead & 0xe0) === 0xc0 ? 2 :
    (lead & 0xf0) === 0xe0 ? 3 :
    (lead & 0xf8) === 0xf0 ? 4 :
    0; // not a valid lead byte — the file is not UTF-8 here; cut where asked
  if (len === 0) return end;
  return i + len <= end ? end : i;
};
// { block, truncated, total } for an id that has a frozen original, else null.
// null is the ordinary answer for a --prune id: a deletion has no snapshot and
// therefore no content to carry (snapshot() skips prunes).
const ownContentEmbed = (id) => {
  if (embedCache.has(id)) return embedCache.get(id);
  const path = snapOriginal(id);
  const st = lstatOrNull(path);
  let result = null;
  if (st && st.isFile()) {
    const raw = readFileSync(path);
    const total = raw.length;
    const truncated = total > EMBED_LIMIT;
    // The cut is decided in BYTES, on `raw`, and `omitted` is derived from that
    // byte index — never from Buffer.byteLength() of the decoded string. The
    // whole point of the cap is that truncation is loud and the byte figure in
    // the landed record is exact; a figure measured after a lossy decode is not.
    let end = total;
    if (truncated) {
      // First land on a codepoint boundary, so the embed never ends in a
      // replacement character.
      end = utf8CutEnd(raw, EMBED_LIMIT);
      // Then prefer a whole-line cut, when the window holds a line boundary at
      // all. A single very long line (a YAML-folded scalar, say) has none —
      // that case keeps the codepoint boundary above rather than the old
      // `lastIndexOf("\n") <= 0` no-op that left a split codepoint in place.
      // `end` is at least EMBED_LIMIT - 3 here (utf8CutEnd only ever backs off
      // by less than one 4-byte sequence), so the byteOffset below is never
      // negative — which in Buffer.lastIndexOf would mean "count from the end".
      const lastNewline = raw.lastIndexOf(0x0a, end - 1);
      if (lastNewline > 0) end = lastNewline + 1;
    }
    const text = raw.subarray(0, end).toString("utf8");
    const omitted = total - end;
    const note = omitted > 0
      ? `----- TRUNCATED: ${omitted} of ${total} bytes omitted at the ` +
        `${EMBED_LIMIT}-byte embed cap; the whole file is at ${path}, on this ` +
        `machine only -----\n`
      : "";
    const block =
      `----- BEGIN this session's unlanded content for ${id} (verbatim) -----\n` +
      `${text}${text.endsWith("\n") ? "" : "\n"}${note}` +
      `----- END this session's unlanded content for ${id} -----`;
    result = { block, truncated: omitted > 0, total };
  }
  embedCache.set(id, result);
  return result;
};
// Names every preserved copy of this node and labels which is which. A losing
// writer must be able to tell its own edit from graph-commit's partial merge of
// it: the merge blends this session's delta with the concurrent writer's landed
// edit, and the batch failed closed, so it is neither this session's content nor
// anything that landed.
const preservedContent = (id) => {
  const merged = snapMerged(id);
  const embed = ownContentEmbed(id);
  // The "may not survive" caveat belongs to every copy that exists ONLY under
  // snapDir — a bare `mktemp -d` that a reboot, a tmp reaper or a container exit
  // destroys for free. It is attached to those paths and to NOTHING else: the
  // embedded copy lives inside this recommendation, which lands on origin/main,
  // and labelling that one perishable would be exactly backwards.
  const localOnly = "on this machine only — it may not survive past this session";
  // Three states, because an embed is NOT guaranteed: snapMerged() can exist
  // with no frozen original beside it (snapIntended() then resolves to the merge
  // output, so the "cannot park" throw in pass 1 does not fire). Promising a
  // carried copy in that state points a human at a block that is not there.
  const own = !embed
    ? `This session's OWN pre-merge content was NOT preserved: no frozen ` +
      `original exists at ${snapOriginal(id)}, so this record carries no ` +
      `verbatim copy of what this session meant to write.`
    : embed.truncated
    ? `This session's OWN unlanded content is preserved at ${snapOriginal(id)} ` +
      `(${localOnly}) — a frozen pre-merge copy, written once and never ` +
      `rewritten. Its leading bytes are carried VERBATIM at the end of this ` +
      `recommendation — the file is ${embed.total} bytes, over the embed cap, ` +
      `and the carried block states exactly how much was omitted; only those ` +
      `omitted bytes depend on that directory surviving.`
    : `This session's OWN unlanded content is preserved at ${snapOriginal(id)} ` +
      `(${localOnly}) — a frozen pre-merge copy, written once and never ` +
      `rewritten. A VERBATIM copy of it is carried at the end of this ` +
      `recommendation, so this record holds the content itself and does not ` +
      `depend on that directory outliving this session.`;
  if (!merged) return own;
  return `${own} graph-commit's PARTIAL MERGE of this session's delta with ` +
    `the concurrent writer's landed edit is at ${merged} (${localOnly}) — ` +
    `that file is neither this session's content nor anything that landed ` +
    `(this batch landed nothing); treat it as a starting point only` +
    (embed
      ? `, and the carried copy at the end of this recommendation as the ` +
        `record of what this session meant to write.`
      : `. Nothing verbatim was carried, so that partial merge is the only ` +
        `surviving artifact of this session's edit — and it survives only on ` +
        `this machine.`);
};
// PASS 1 — classification and reads only. Performs NO writes to intentionsDir,
// so an id that fails validation here fails BEFORE anything on disk changed.
//
// Delete/modify divergence: park_and_exit() reset --hard to fresh origin/main
// BEFORE calling us, so a node another writer's already-landed change deleted
// is ABSENT on disk here. A naive readNode() would throw ENOENT and crash the
// park before it records office_hours. For a non-prune id whose target file is
// missing (a prune id genuinely has no snapshot) we re-materialize this
// session's in-flight edit from its snapshot at the TARGET path so readNode
// succeeds AND writeNode's body-preservation (readExistingBody reads
// intentionsDir/<id>.md) sees the writer's real authored body instead of
// falling back to a generated placeholder — avoiding silent body loss. That
// file is LOCAL ONLY: commit_files() refuses to stage a resurrected id, so the
// other writer's landed deletion still stands on main.
const pending = new Map(); // id -> snapshot bytes to materialize (read here, written in pass 2)
for (const id of ids) {
  // Defense in depth: validate_id_chars() bans a comma at the edge precisely so
  // pruneCsv's split is total. Re-assert it — a comma here would silently
  // misclassify a prune as an edit and turn this into a hard park failure.
  if (id.includes(",")) {
    throw new Error(`graph-commit: node id '${id}' contains a comma — ids are carried over a comma-delimited channel and cannot contain one`);
  }
  const target = join(intentionsDir, `${id}.md`);
  const st = lstatOrNull(target);
  if (st && !st.isFile()) {
    // A concurrent writer can land ANY blob at intentions/<id>.md, including a
    // symlink pointing outside the repo (git stores the link text verbatim).
    // existsSync() reports false for a DANGLING symlink and copyFileSync()
    // follows a link at its destination, which together would write this node's
    // markdown to an attacker-chosen absolute path. Refuse instead.
    throw new Error(`graph-commit: refusing to park '${id}': ${target} exists but is not a regular file (symlink or other special entry)`);
  }
  if (st) continue; // present on fresh origin/main — ordinary read below
  // Re-materialize what this run INTENDED to land (the merge output when a
  // layer-2/3 merge resolved for this id, else the frozen original) — that is
  // the file a human reviews and may re-land, and what writeNode's
  // body-preservation reads. The frozen original is named separately in the
  // recovery text below; it is not overwritten by this.
  const snap = snapIntended(id);
  const sst = lstatOrNull(snap);
  if (!sst || !sst.isFile()) {
    // No target and no snapshot. Either a --prune id (snapshot() deliberately
    // skips prunes — a deletion has no content to preserve) that the other
    // writer also deleted, or a classification miss. Name both paths: a raw
    // ENOENT out of readNode here would abort the park AFTER park_and_exit()
    // already reset --hard, losing the local commit and the office_hours record.
    throw new Error(`graph-commit: cannot park '${id}': it is absent from origin/main and no snapshot exists at ${snap}${pruneSet.has(id) ? " (it is a --prune id, which by design has no snapshot — the concurrent writer appears to have deleted it too)" : " (this session captured no content for it — check its prune-vs-edit classification)"}`);
  }
  // Belt and braces: a --prune id is never resurrected (it reached the missing-
  // snapshot throw above), so only an EDIT id can ever enter `pending`.
  if (!pruneSet.has(id)) pending.set(id, readFileSync(snap));
}
// PASS 2 — materialize, then read. Every file created here is tracked in
// `materialized` and unlinked if ANY later step throws, so a failed park never
// leaves an untracked resurrection behind: such a file is invisible to the
// unrelated-dirty-TRACKED-file preflight and a later `graph-commit <id>` would
// land it as an ordinary edit, reverting the landed deletion with no park and
// no office_hours marker anywhere.
const deletedSet = new Set();
const materialized = [];
try {
  for (const [id, bytes] of pending) {
    // 'wx' — exclusive create, and it never follows a symlink at the target.
    // Fails loudly if anything appeared at the path since pass 1.
    writeFileSync(join(intentionsDir, `${id}.md`), bytes, { flag: "wx" });
    materialized.push(join(intentionsDir, `${id}.md`));
    deletedSet.add(id);
  }
  // Read every node up front so an unreadable id fails BEFORE any writeNode — a
  // single read-modify-write loop that threw mid-way would leave the earlier ids
  // mutated on disk, uncommitted.
  const nodes = ids.map((id) => readNode(intentionsDir, id));
  writeParked(nodes);
} catch (err) {
  for (const p of materialized) { try { unlinkSync(p); } catch { /* best effort */ } }
  throw err;
}
if (resurrectedFile) {
  writeFileSync(resurrectedFile, [...deletedSet].map((id) => `${id}\0`).join(""));
}

function writeParked(nodes) {
for (let i = 0; i < nodes.length; i++) {
  const node = nodes[i];
  const id = ids[i];
  const base = pruneSet.has(id)
    ? "A concurrent writer landed an overlapping edit to this node while this " +
      "session's prune was in flight; the prune was NOT landed (a deletion has " +
      "no content snapshot). Recommended: the losing writer re-reads the " +
      "current origin/main content, decides whether the prune still applies, " +
      "and re-runs graph-commit (--prune, or a fresh edit) on the reconciled " +
      "result — that same commit clears this office_hours park. A third " +
      "session encountering this park while the loser is still working should " +
      "wait rather than attempt its own merge (the mailbox discipline)."
    : deletedSet.has(id)
    ? `This is a delete/modify divergence: a concurrent writer's already-landed ` +
      `change DELETED this node from origin/main while this session's edit was ` +
      `in flight. The landed deletion WINS: nothing about this node was pushed ` +
      `to main, and this office_hours record itself is LOCAL ONLY — it exists ` +
      `nowhere on origin/main, because the node does not. This session's edit ` +
      `was re-materialized at ${intentionsDir}/${id}.md as an untracked local ` +
      `file (with its authored body preserved). ${preservedContent(id)}\n` +
      `Recommended: a human picks ONE of two intents — no autonomous session ` +
      `may override a landed deletion.\n` +
      `(1) OVERRIDE the deletion (this session's edit is intentional and should ` +
      `win): review the re-materialized file, delete its office_hours block, ` +
      `then re-run \`graph-commit ${id}\` — that re-lands the node explicitly.\n` +
      `(2) CONFIRM the other writer's deletion (this session's edit is ` +
      `obsolete): \`rm ${intentionsDir}/${id}.md\`. origin/main already has the ` +
      `node deleted, so nothing needs to be committed.\n` +
      `A third session encountering this state while the loser is still working ` +
      `should wait rather than attempt its own merge (the mailbox discipline).`
    : `A concurrent writer landed an overlapping edit to this node while this ` +
      `session's edit was in flight; this writer's content was NOT landed. ` +
      `${preservedContent(id)} Recommended: ` +
      `the losing writer re-reads the current origin/main content, manually ` +
      `merges in its intended edit, and re-runs graph-commit on the merged ` +
      `result — that same commit clears this office_hours park. A third ` +
      `session encountering this park while the loser is still working should ` +
      `wait rather than attempt its own merge (the mailbox discipline).`;
  // Third composition layer (durability): the losing writer's own content,
  // carried verbatim so the landed record does not depend on snapDir surviving.
  // Appended LAST, after the prose and the field breakdown, so a human reads the
  // instructions before the payload. Absent for a --prune id, which has no
  // snapshot to carry.
  const embed = ownContentEmbed(id);
  const parts = [base];
  if (fieldBreakdown) parts.push(fieldBreakdown);
  if (embed) parts.push(embed.block);
  const recommendation = parts.join("\n\n");
  node.office_hours = { reason, since, recommendation };
  writeNode(intentionsDir, node);
  process.stderr.write(
    deletedSet.has(id)
      ? `graph-commit: set office_hours on ${id} LOCALLY ONLY (since=${since}) — the node is deleted on origin/main and is not re-landed\n`
      : `graph-commit: set office_hours on ${id} (since=${since})\n`
  );
}
}
TS
  local resurrected_file="$SNAP_DIR/resurrected-ids"
  : >"$resurrected_file"
  if ! ( cd "$SCRIPT_DIR" \
         && GRAPH_COMMIT_RECOMMENDATION_FILE="$rec_file" \
            GRAPH_COMMIT_RESURRECTED_FILE="$resurrected_file" \
            node --import tsx/esm "$tmpts" "$STORE_MODULE" "$INTENTIONS_DIR" \
              "$since" "$reason" "$SNAP_DIR" "$prune_csv" "$@" ) >&2; then
    rm -f "$tmpts"
    die "failed to write the office_hours parking record"
  fi
  rm -f "$tmpts"

  # Read back the delete/modify divergences the helper re-materialized (NUL-
  # delimited, so no id character can split a record). commit_files() /
  # id_files_dirty() consult this set and refuse to stage those paths — the
  # other writer's landed deletion is never reverted by this park.
  RESURRECTED_IDS=()
  if [[ -s "$resurrected_file" ]]; then
    local rid
    while IFS= read -r -d '' rid; do
      [[ -n "$rid" ]] && RESURRECTED_IDS+=("$rid")
    done <"$resurrected_file"
  fi

  # Record what this park INTENDS to put on origin/main — origin/main's content
  # with the office_hours block just written — for print_verdict()'s
  # content-equivalence fallback. SNAP_DIR is NOT that content and must not be
  # overwritten with it: it holds this writer's unlanded pre-park edit (and, per
  # the SNAP_DIR path contract, any partial merge of it), which the
  # recommendation text and the "preserved at $SNAP_DIR" message point a human
  # at for the manual merge. Resurrected ids are copied too, deliberately:
  # their node no longer exists on origin/main, so the comparison correctly
  # answers "not on main" for them.
  PARK_CONTENT_DIR="$SNAP_DIR/.parked"
  mkdir -p "$PARK_CONTENT_DIR" || die "could not create the parked-content dir"
  local pid
  for pid in "$@"; do
    cp -- "$INTENTIONS_DIR/$pid.md" "$PARK_CONTENT_DIR/$pid.md" \
      || die "could not record the parked content for $pid"
  done
}

# --- Shared fail-closed park path (never returns) ---------------------------
# The concurrent-edit conflict fail-closed sequence, extracted from main()'s
# rc-12 tail so other call sites can invoke the identical park without
# duplicating fetch/reset/park_write/re-commit/land logic. Self-contained:
# relies only on globals (ALL_IDS, SNAP_DIR, KEEP_SNAP) and the committed
# helpers, never on state that exists only after try_land()/land() ran — it does
# its own fetch/reset. Always calls exit 1.
#
# Three call sites:
#   1. main()'s rc-12 tail — a rebase conflict layer 2 could not resolve.
#   2. check_base_freshness() — a stale --base (layer 3) whose divergence
#      run_merge_node() could not resolve.
#   3. ensure_intentions_only_base() — the far-ahead rebuild's three-way replay
#      found a node (or a --prune id) that advanced on origin/main since this
#      checkout's fork point and could not reconcile it. This one parks with no
#      local commit yet in existence; ORIG_HEAD/RESTORE_HEAD are set before the
#      rebuild's own `git reset --hard "$MAIN_SHA"`, so cleanup() still returns
#      the worktree to its PR tip.
#
# Bystander prunes: a --prune id that is NOT itself part of the conflicted set
# (per conflicted_ids()) is independent of whatever id(s) failed to resolve, so
# its deletion is re-applied after the reset and lands with the park commit —
# it does not park. A prune id that IS in the conflicted set keeps parking
# exactly as before (Cases 17/23): re-deleting a conflicted prune would blind-
# overwrite the other writer's just-landed edit, which is exactly the
# fail-closed contract above forbids. When the conflicted set cannot be
# determined (conflicted_ids() fails/empty — e.g. try_layer2_resolve() returned
# 1 with nothing appended), or when it names no id this invocation is actually
# committing (so the partition would park nothing at all), fall back to the
# conservative default: every id parks, no prune is re-applied.
park_and_exit() {
  # Fail closed: discard this writer's local conflicting commit, park the node as
  # it exists on fresh origin/main (the other writer's already-landed content
  # wins), and preserve this writer's unlanded content in SNAP_DIR for the
  # manual merge.
  KEEP_SNAP=1
  echo "graph-commit: this writer's unlanded content is preserved at $SNAP_DIR for the manual merge" >&2
  # Sync to fresh origin/main. Both callers reach here with the writer's content
  # already captured in SNAP_DIR by snapshot() (run before check_base_freshness),
  # so the reset is safe to run regardless of what it discards:
  #   - rc-12 (layer-2) caller: the tree is clean of tracked modifications (the
  #     conflicting rebase could only start on a clean tree and was aborted), so
  #     the reset discards exactly the local conflicting commit — nothing else.
  #   - layer-3 caller (from inside check_base_freshness): no rebase ran and the
  #     tree still holds the writer's uncommitted node edits; the reset discards
  #     them, but SNAP_DIR already preserves them for the manual merge.
  # NOTE (deployment): `git reset --hard` is a tree-updating op; when this
  # script is driven through the sandboxed Bash tool it needs
  # dangerouslyDisableSandbox if origin/main advanced read-only paths
  # (.claude/skills/**, config/) — see .claude/rules/sandbox.md. That is a
  # caller concern, not resolved here.
  #
  # PLUMBING WRITER: path-scoped sync instead of the whole-tree reset. That
  # writer never made a local commit to discard and never promised the caller a
  # clean tree, so resetting everything would destroy exactly the unrelated dirt
  # it exists to tolerate. Bringing this invocation's own node paths to fresh
  # origin/main is all park_write() needs, and it leaves every other tracked
  # path — dirty or not — alone.
  git fetch origin main >&2
  if [[ "$GRAPH_COMMIT_WRITER" == "plumbing" ]]; then
    sync_ids_to_rev FETCH_HEAD
    # Re-base the plumbing writer on the tip just synced to. Every base this run
    # reconciled against is stale now — the node files on disk hold origin/main's
    # content plus the office_hours block park_write is about to add, and that
    # content is derived from THIS tip. Leaving the old base set would send the
    # park's own land() back through reconcile_plumbing_base() to three-way the
    # park against a base it was never derived from; clearing it to "" would only
    # re-derive the same stale fork point from HEAD, which the plumbing writer
    # never moved.
    PLUMB_BASE="$(git rev-parse FETCH_HEAD)" \
      || die "could not resolve FETCH_HEAD after the park's re-fetch — the parking write has no base to build on"
  else
    git reset --hard FETCH_HEAD >&2
  fi

  # Partition: bystander prunes (re-applied and landed) vs. park_ids (parked).
  local conflicted park_ids=() bystander_prunes=() id
  if conflicted="$(conflicted_ids)"; then
    declare -A _conflicted_set=()
    while IFS= read -r id; do
      [[ -n "$id" ]] && _conflicted_set["$id"]=1
    done <<<"$conflicted"
    for id in "${PRUNE_IDS[@]}"; do
      if [[ -z "${_conflicted_set[$id]:-}" ]]; then
        bystander_prunes+=("$id")
      fi
    done
    for id in "${ALL_IDS[@]}"; do
      local is_bystander=0 b
      for b in "${bystander_prunes[@]}"; do
        [[ "$b" == "$id" ]] && { is_bystander=1; break; }
      done
      [[ "$is_bystander" -eq 0 ]] && park_ids+=("$id")
    done
  else
    # Could not determine the conflicted set — conservative fallback: every id
    # parks, no prune is re-applied.
    park_ids=("${ALL_IDS[@]}")
  fi

  # Degenerate partition: every id in this invocation was classified a bystander
  # prune, so nothing would park. Reachable when the unresolved conflict is on a
  # --base id OUTSIDE this invocation's node set — check_base_freshness()
  # iterates every BASE key, and a batch manifest may cover more nodes than the
  # invocation commits (see assert_expected_content()'s note on that manifest
  # semantics) — while every id actually being committed is a bystander prune.
  # Parking nothing while the stderr and the exit status announce a park is the
  # silent-loss shape this whole path exists to prevent, so route it to the same
  # conservative default as an undeterminable conflicted set: every id parks, no
  # prune is re-applied. The prune is then re-derivable by the caller from
  # origin/main (see the rc-1 caller contract in the header).
  if [[ "${#park_ids[@]}" -eq 0 ]]; then
    echo "graph-commit: the unresolved conflict names no id in this invocation's node set — parking every id and re-applying no prune (conservative fallback)" >&2
    park_ids=("${ALL_IDS[@]}")
    bystander_prunes=()
  fi

  local park_msg
  if [[ "${#bystander_prunes[@]}" -gt 0 ]]; then
    park_msg="graph: park ${park_ids[*]} (concurrent-edit conflict); prune ${bystander_prunes[*]}"
    # ANNOUNCEMENT ONLY — not a landing claim. This prints BEFORE the parking
    # write is pushed, and that push can still fail (see the post-`land` branch
    # below). Nothing downstream may treat this line as evidence that a park
    # reached main; land-align-round deliberately keys its `park` terminal
    # marker on the `graph-commit: verdict: parked` line print_verdict() emits
    # after a post-push READ of origin/main confirms it, not on this line.
    echo "graph-commit: concurrent-edit conflict on ${park_ids[*]}; parking node(s) — this writer's content is NOT landed" >&2
    echo "graph-commit: re-applying and landing bystander prune(s) not implicated in the conflict: ${bystander_prunes[*]}" >&2
    for id in "${bystander_prunes[@]}"; do
      rm -f -- "$INTENTIONS_DIR/$id.md"
    done
  else
    park_msg="graph: park ${ALL_IDS[*]} (concurrent-edit conflict)"
    # ANNOUNCEMENT ONLY — see the note on the identical emission above: this
    # precedes the parking push and is not evidence that a park reached main.
    echo "graph-commit: concurrent-edit conflict on ${park_ids[*]}; parking node(s) — this writer's content is NOT landed" >&2
  fi

  park_write "${park_ids[@]}"

  # Delete/modify divergence (RESURRECTED_IDS, set by park_write): those nodes
  # no longer exist on origin/main, so nothing about them is committed or pushed
  # — their office_hours record lives only in the local untracked file. Report
  # them separately and drop them from the "parked on main" set, so neither the
  # human nor land-align-round's needle below can read a landed park where there
  # is none.
  local landed_park_ids=() pid
  for pid in "${park_ids[@]}"; do
    is_resurrected_id "$pid" && continue
    landed_park_ids+=("$pid")
  done
  if [[ "${#RESURRECTED_IDS[@]}" -gt 0 ]]; then
    echo "graph-commit: delete/modify divergence on ${RESURRECTED_IDS[*]} — a concurrent writer's already-landed change DELETED these node(s) from origin/main; the deletion STANDS (their content is not re-pushed to main)" >&2
    echo "graph-commit: their office_hours record is LOCAL ONLY, in the untracked re-materialized file(s) under $INTENTIONS_DIR (unlanded content also at $SNAP_DIR); a human must decide whether to override the deletion" >&2
  fi

  CURRENT_MSG="$park_msg"
  # `committed` means "there is something for land() to push", not literally "a
  # local commit exists". The plumbing writer builds its commit inside try_land()
  # from the on-disk content, so making one here would only move the caller's
  # HEAD for nothing — and its "is there anything to land" question is asked
  # against fresh origin/main (the base it builds on), not against HEAD.
  local committed=0
  if [[ "$GRAPH_COMMIT_WRITER" == "plumbing" ]]; then
    if id_files_differ_from_rev FETCH_HEAD; then
      committed=1
    fi
  elif id_files_dirty; then
    commit_files
    committed=1
  fi
  # The park path's verdict asks one specific question — "is the PARKING commit
  # on origin/main?" — so a sha left in PUSHED_SHA by a pre-park push attempt
  # must not be allowed to answer it. Clear it; the park's own try_land() sets
  # it again if it reaches a push.
  PUSHED_SHA=""
  # committed=0 → nothing to push: this function reset --hard to FETCH_HEAD, so
  # HEAD IS origin/main and land() would burn a full stamp cycle only to no-op
  # (or, if main advanced meanwhile, be REJECTED and report a landing failure
  # for a write that never existed). Reachable when every park id was a
  # delete/modify divergence (its file is deliberately unstaged) or when the
  # nodes already carry byte-identical office_hours on main.
  local prc=0 park_confirmed=0
  if [[ "$committed" -eq 1 ]]; then
    land || prc=$?
    # VERIFY BEFORE CLAIMING. `prc` is this process's own view of its own push,
    # which is exactly the signal that has been observed lying in both
    # directions. The confirmation below is gated on a post-push READ of
    # origin/main (print_verdict's LAST_VERDICT), not on prc.
    print_verdict park
    [[ "$LAST_VERDICT" == "parked" ]] && park_confirmed=1
  else
    # Nothing was committed, so nothing was pushed and there is no parking
    # commit for a verdict to confirm — `land` never ran, prc stays 0, and the
    # verdict line is left for emit_verdict_and_exit() at the end. What is (or
    # is not) on main is decided entirely by the partition computed above: an
    # empty landed_park_ids means every id was a delete/modify divergence and
    # NOTHING was parked on main; a non-empty one means main already carries
    # this park's office_hours byte-identically. The same three-way branch
    # below reports both, so take it.
    park_confirmed=1
  fi
  if [[ "$park_confirmed" -eq 1 ]]; then
    # The two `parked ...` confirmations below share the literal
    # "(office_hours set on the origin/main content)". As of
    # tactic-graph-commit-landing-signal-unreliable Unit 5, land-align-round
    # (the /align-tactics landing wrapper) — the only consumer that ever parsed
    # this text — gates on the `graph-commit: verdict: parked` line
    # print_verdict() emits instead, so the substring is no longer that
    # wrapper's needle and this prose is human-readable context. It IS still
    # asserted on by test-graph-commit.sh's delete/modify-divergence case,
    # which requires the every-id-resurrected arm below to NOT carry it —
    # nothing reached main there — so keep the literal on exactly the two arms
    # that follow a confirmed park, and off the third.
    if [[ "${#landed_park_ids[@]}" -eq 0 ]]; then
      # Every id was a delete/modify divergence, so NOTHING was parked on main.
      # Deliberately omits the shared substring: this is not a terminal park
      # disposition, it is an escalation that needs a human.
      echo "error: graph-commit: nothing was parked ON MAIN — every parked id in this invocation (${RESURRECTED_IDS[*]}) is a delete/modify divergence whose node no longer exists on origin/main; the office_hours record is local only" >&2
      if [[ "${#bystander_prunes[@]}" -gt 0 ]]; then
        echo "graph-commit: landed bystander prune deletion(s) for ${bystander_prunes[*]}; pushed to main" >&2
      fi
    elif [[ "${#bystander_prunes[@]}" -gt 0 ]]; then
      echo "graph-commit: parked ${landed_park_ids[*]} (office_hours set on the origin/main content); landed bystander prune deletion(s) for ${bystander_prunes[*]}; pushed to main" >&2
    else
      echo "graph-commit: parked ${landed_park_ids[*]} (office_hours set on the origin/main content) and pushed the parking write to main" >&2
    fi
  else
    # Not confirmed on origin/main (`not-landed`, or `unknown` when the
    # post-push read itself failed — the verdict line above says which, and
    # `land`'s own view was prc=$prc).
    if [[ "${#bystander_prunes[@]}" -gt 0 ]]; then
      echo "error: graph-commit: could not land the parking write for ${park_ids[*]} — office_hours set locally but not pushed to main; the bystander prune deletion for ${bystander_prunes[*]} also did not land — it is committed locally but unpushed, same as the park" >&2
    else
      echo "error: graph-commit: could not land the parking write for ${park_ids[*]} — office_hours set locally but not pushed to main" >&2
    fi
  fi
  emit_verdict_and_exit park
}

# --- Pre-flight: refuse on unrelated dirty tracked files --------------------
# try_land()'s `git pull --rebase origin main` refuses outright when ANY
# tracked file is dirty, including files entirely unrelated to this call's
# node set (observed: a modified flake.lock in a freshly-provisioned
# worktree). Left unchecked, that refusal surfaces as try_land()'s generic
# "dirty tree or fetch failure" die() — indistinguishable from a genuine
# environment problem, and it never names the offending paths. Catch it here,
# before ANY tree mutation — in particular before ensure_intentions_only_base()
# could run a `git reset --hard` that would silently discard the very dirt
# this is trying to surface — scoped to exclude exactly the paths this call is
# about to write (those are expected to be dirty; that is the point). Ignores
# untracked (`??`) entries: only a dirty TRACKED file blocks `git pull
# --rebase`, per the observed failure mode (code-style.md: clear error over a
# silent fallback such as --autostash, which would hide rather than surface
# the anomaly).
# Heuristic fingerprint check for a single offending path: does its diff from
# HEAD touch ONLY frontmatter marker fields (office_hours / phase / their
# nested block lines)? This is the exact shape left behind by a failed-write
# leak (park-node, transition-node, etc. interrupted mid-flight after editing
# the marker fields but before graph-commit landed the change) — as opposed to
# an unrelated file that happens to be dirty for some other reason. Not a full
# YAML parser: a body edit, a frontmatter edit to any other field, or a diff
# that can't be classified all correctly fall through to "not residue" (the
# safe direction — the caller still lists the file under the generic
# unrelated-dirty-file path with the blanket 'git stash -u' suggestion).
_offending_path_is_marker_only_residue() {
  local path="$1"
  [[ "$path" == intentions/*.md ]] || return 1
  local diff
  diff="$(git diff HEAD -- "$path" 2>/dev/null)"
  [[ -n "$diff" ]] || return 1
  local dline sign content trimmed in_marker_block=0 saw_change=0
  while IFS= read -r dline; do
    [[ "$dline" == '+++'* || "$dline" == '---'* || "$dline" == '@@'* || "$dline" == '\ '* ]] && continue
    [[ "$dline" == [+-]* ]] || continue
    sign="${dline:0:1}"
    content="${dline:1}"
    trimmed="${content#"${content%%[![:space:]]*}"}"
    [[ -z "$trimmed" ]] && continue
    saw_change=1
    if [[ "$content" == [[:space:]]* ]]; then
      # Indented line: only acceptable as a continuation inside a marker
      # block (e.g. office_hours: {reason: ..., cleared_at: ...} spread over
      # lines) opened by a prior top-level line in this same diff.
      [[ "$in_marker_block" == 1 ]] || return 1
      continue
    fi
    # Top-level (unindented) changed line: must be exactly a marker field.
    case "$trimmed" in
      office_hours:*|execution:*) in_marker_block=1 ;;
      phase:*) in_marker_block=0 ;;
      *) return 1 ;;
    esac
  done <<<"$diff"
  [[ "$saw_change" == 1 ]]
}

assert_clean_outside_ids() {
  local dirty
  # Reconcile the index's cached stat data with the working tree before reading
  # status. A preceding `git reset --hard` (e.g. park_and_exit's re-fetch, or an
  # earlier ensure_intentions_only_base) rewrites tracked files and the index in
  # the same sub-second; under load that hits git's "racy clean" window, where
  # `git status --porcelain` distrusts the equal mtimes and can momentarily
  # report an unchanged file as ` M`. `--refresh` re-stats and clears those
  # false positives (a genuinely different-content file still stays flagged and
  # is reported below), so the guard trips only on real dirt, not on a racy
  # stat. `|| true`: --refresh exits non-zero precisely when it leaves such a
  # genuinely-modified file flagged, which is not an error here.
  git update-index -q --refresh >/dev/null 2>&1 || true
  dirty="$(git status --porcelain)"
  [[ -z "$dirty" ]] && return 0
  local -A ours=()
  local id
  for id in "${ALL_IDS[@]}"; do
    ours["intentions/$id.md"]=1
  done
  local offending="" line path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$line" == '??'* ]] && continue
    path="${line:3}"
    [[ -n "${ours[$path]:-}" ]] && continue
    offending+="$line"$'\n'
  done <<<"$dirty"
  if [[ -n "$offending" ]]; then
    echo "error: graph-commit: refusing to start — unrelated dirty tracked file(s) outside this call's node set:" >&2
    printf '%s' "$offending" >&2
    local residue_line residue_path generic="" residue=""
    while IFS= read -r residue_line; do
      [[ -z "$residue_line" ]] && continue
      residue_path="${residue_line:3}"
      if _offending_path_is_marker_only_residue "$residue_path"; then
        residue+="$residue_line"$'\n'
      else
        generic+="$residue_line"$'\n'
      fi
    done <<<"$offending"
    if [[ -n "$residue" ]]; then
      echo "       LIKELY LEAKED-WRITE RESIDUE (diff touches only office_hours/phase marker fields — the fingerprint of a park-node/transition-node/etc. write that was interrupted before its graph-commit landed). Clear it directly:" >&2
      while IFS= read -r residue_line; do
        [[ -z "$residue_line" ]] && continue
        residue_path="${residue_line:3}"
        echo "         git -C \"$REPO_ROOT\" checkout -- $residue_path" >&2
      done <<<"$residue"
    fi
    if [[ -n "$generic" ]]; then
      echo "       stash or commit these first (e.g. 'git stash -u'), then re-run graph-commit — it resumes safely (a prior partial local commit is detected and just pushed forward)." >&2
    fi
    exit 1
  fi
}

# --- Main ------------------------------------------------------------------
main() {
  local msg="" REPO_ARG=""
  # Parse [-m <msg>] [-C <path>] and positional ids. `--` ends option parsing.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message) [[ $# -ge 2 ]] || { usage; die "-m requires a message argument"; }
                    msg="$2"; shift 2 ;;
      -C|--repo) [[ $# -ge 2 ]] || { usage; die "-C requires a repo path argument"; }
                 REPO_ARG="$2"; shift 2 ;;
      --prune) [[ $# -ge 2 ]] || { usage; die "--prune requires a node id argument"; }
               PRUNE_IDS+=("$2"); shift 2 ;;
      --base) [[ $# -ge 2 ]] || { usage; die "--base requires an <id>=<blobsha> argument or a manifest file path"; }
              parse_blob_arg BASE --base "$2"; shift 2 ;;
      --expect) [[ $# -ge 2 ]] || { usage; die "--expect requires an <id>=<blobsha> argument or a manifest file path"; }
                parse_blob_arg EXPECT_BLOB --expect "$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; while [[ $# -gt 0 ]]; do IDS+=("$1"); shift; done ;;
      -*) usage; echo "error: graph-commit: unknown option '$1'" >&2; exit 2 ;;
      *) IDS+=("$1"); shift ;;
    esac
  done

  # Resolve the repo to commit from the CALLER (the -C/--repo argument when
  # given, else cwd), never from this script's own on-disk location. SCRIPT_DIR
  # still locates sibling scripts (store.js, merge-node.ts) above; only the
  # committed checkout is caller-derived. Fail loudly rather than falling back to
  # the script's own checkout when the resolved-from path is not inside a git
  # repo (code-style.md: clear error over a silent fallback).
  local RESOLVE_FROM="${REPO_ARG:-$(pwd)}"
  if ! REPO_ROOT="$(git -C "$RESOLVE_FROM" rev-parse --show-toplevel 2>/dev/null)"; then
    die "'$RESOLVE_FROM' is not inside a git repository — graph-commit commits the CALLER's checkout (resolved from -C/--repo, else the current directory), never this script's own location. Pass -C <path> when not running from inside the target repo."
  fi
  INTENTIONS_DIR="$REPO_ROOT/intentions"
  cd "$REPO_ROOT"

  # Refuse to run on a mid-operation worktree. A clear error at a system edge,
  # not a fallback: a rebase in progress means someone (or something) else owns
  # this checkout's HEAD right now, and graph-commit's own rebase/reset flow
  # would compound the damage.
  #
  # Placement is load-bearing — this must run BEFORE `trap cleanup EXIT` is
  # installed further down. cleanup() aborts any rebase in progress on exit; if
  # this refusal ran after the trap were armed, the very die() below would abort
  # the caller's own rebase — including an `edit`-stopped one, which leaves a
  # CLEAN tree and would otherwise slip past assert_clean_outside_ids entirely.
  # Refusing before the trap exists is what makes cleanup()'s unconditional
  # abort provably safe: any rebase seen there was started by this run.
  if rebase_in_progress; then
    die "a rebase is already in progress in $REPO_ROOT — graph-commit will not run on a mid-operation worktree; finish or 'git rebase --abort' it first"
  fi

  # GRAPH_COMMIT_WRITER gate. Placed alongside the refusal above, and for the
  # same reason: before `trap cleanup EXIT` is installed, so a refusal here
  # attempts no write and disturbs no checkout. Unset resolves to `worktree`,
  # so the default path reaches the `worktree` arm and falls straight through —
  # this block is inert for every caller that does not set the variable. An
  # unknown value is still refused rather than defaulted: a config knob that
  # quietly does something other than what it was asked is worse than one that
  # errors (code-style.md).
  case "$GRAPH_COMMIT_WRITER" in
    worktree|plumbing) : ;;
    *)
      die "GRAPH_COMMIT_WRITER must be 'worktree' or 'plumbing', got '$GRAPH_COMMIT_WRITER'" ;;
  esac

  if [[ "${#IDS[@]}" -eq 0 && "${#PRUNE_IDS[@]}" -eq 0 ]]; then
    usage
    echo "error: graph-commit: at least one node id is required" >&2
    exit 2
  fi

  # Validate ordinary (edit) ids: each must already exist on disk — write-node.ts
  # is the sole place that authors node content; graph-commit only lands what's
  # already there.
  local id
  for id in "${IDS[@]}"; do
    validate_id_chars "$id"
    if [[ ! -f "$INTENTIONS_DIR/$id.md" ]]; then
      die "intentions/$id.md does not exist — write the node via write-node.ts before graph-commit"
    fi
    EXPECTED["intentions/$id.md"]=1
  done

  # Validate prune ids: the existence guard INVERTS relative to an ordinary
  # edit — the caller has already deleted intentions/<id>.md on disk (there is
  # no new content to author for a deletion), but the id must still name a
  # real tracked node (present in HEAD) rather than a typo that was never
  # landed.
  for id in "${PRUNE_IDS[@]}"; do
    validate_id_chars "$id"
    if [[ -f "$INTENTIONS_DIR/$id.md" ]]; then
      die "intentions/$id.md still exists on disk — delete the file before passing --prune $id"
    fi
    if ! git cat-file -e "HEAD:intentions/$id.md" 2>/dev/null; then
      die "intentions/$id.md does not exist in HEAD — nothing to prune for '$id'"
    fi
    EXPECTED["intentions/$id.md"]=1
  done

  ALL_IDS=("${IDS[@]}" "${PRUNE_IDS[@]}")

  # The throwaway stamping branch: named for the primary id and scoped to this
  # PID so concurrent graph-commit invocations never collide. cleanup() (the
  # EXIT trap) deletes it on the remote on every exit path — success, busy-main,
  # or the parking fallback — once it has been pushed at least once.
  # The id is sanitized for the ref name only (the name is cosmetic — PID
  # provides uniqueness): valid node ids like `v1..v2-migration` contain
  # sequences git refuses in a ref (`..`), so every non-[A-Za-z0-9-] char maps
  # to `-`. Use ALL_IDS (not just IDS) so a pure-prune commit (no ordinary
  # ids) still gets a valid scratch-branch name.
  # Computed here (before check_base_freshness) because it depends only on
  # ALL_IDS/ref_id, and layer 3's park path (park_and_exit) relies on cleanup()
  # already knowing the scratch-branch name.
  local ref_id="${ALL_IDS[0]//[!A-Za-z0-9-]/-}"
  SCRATCH_BRANCH="graph/$ref_id-$$"

  # SNAP_DIR and the EXIT trap must exist BEFORE check_base_freshness runs:
  # layer 3's stale-base auto-merge (inside check_base_freshness) uses
  # run_merge_node()'s tempfiles and CONFLICT_FIELDS_JSON — both rooted in
  # SNAP_DIR — and an unresolved divergence reaches park_and_exit(), which
  # relies on the EXIT trap's cleanup(). None of these existed here before this
  # block was moved ahead of the freshness check.
  SNAP_DIR="$(mktemp -d)" || die "could not create snapshot tempdir"
  trap cleanup EXIT
  # An EXIT trap does not reliably fire on INT/TERM in all shells; convert
  # those signals into a normal exit so cleanup() (snapshot removal, remote
  # scratch-branch delete) always runs on signal death.
  trap 'exit 130' INT TERM

  # Pre-flight (tactic-graph-commit-park-context): refuse when an unrelated
  # tracked file is dirty, BEFORE the first tree mutation. In this tactic's
  # layered design check_base_freshness runs the layer-3 stale-base auto-merge,
  # which overwrites node files on disk and can reach park_and_exit()'s
  # `git reset --hard`; the guard must run ahead of it so a stray dirty file is
  # surfaced (and named) rather than silently discarded.
  #
  # WORKTREE WRITER ONLY. The refusal exists because that writer's `git pull
  # --rebase origin main` refuses outright on ANY dirty tracked file, and
  # because the tree-updating steps downstream of it would discard the dirt
  # rather than report it. The plumbing writer runs no rebase, never resets the
  # whole tree (park_and_exit() syncs only this invocation's node paths for it),
  # and builds its commit against a throwaway index — an unrelated modified
  # flake.lock is simply not its business. Keeping the refusal there would have
  # made every ledger write fail for a file the write never reads
  # (tactic-eval-finding-eval-write-blocked-by-unrelated-main-dirt).
  if [[ "$GRAPH_COMMIT_WRITER" == "worktree" ]]; then
    assert_clean_outside_ids
  fi

  # Wrong-repo assertion (opt-in via --expect). MUST run here: before
  # check_base_freshness (whose layer-3 auto-merge rewrites node files on disk)
  # and before ensure_intentions_only_base (which can `git reset --hard` the
  # tree). Running it any later would hash content graph-commit itself wrote.
  # It reads only the caller's on-disk content, so it is independent of
  # $MAIN_SHA and runs ahead of the fetch below.
  assert_expected_content

  # Fetch origin/main ONCE and pin its tip. Every pre-land step below reconciles
  # against this exact sha (see the MAIN_SHA global): the --base freshness check,
  # the far-ahead rebuild and its three-way replay, and the nothing-staged blob
  # comparison. Independent fetches would let those steps disagree about which
  # main they are reconciling against, leaving a concurrent landing in between
  # checked by none of them. park_and_exit() deliberately re-fetches — the park
  # must land on the freshest main, not on this pre-diagnosis observation.
  git fetch origin main >&2
  MAIN_SHA="$(git rev-parse FETCH_HEAD)"

  # Announce any pre-existing orphan (an earlier run's local commit that never
  # reached origin/main) on every path, not just the nothing-staged one, and
  # state the sanctioned recovery: this very invocation lands it.
  detect_pre_existing_orphan

  # Capture the writer's intended on-disk content BEFORE check_base_freshness.
  # Layer 3's stale-base park (park_and_exit, reached from inside
  # check_base_freshness on an unresolvable same-field divergence) runs
  # `git reset --hard FETCH_HEAD`, which discards the writer's uncommitted node
  # edits. snapshot() is the only surviving copy of that content on every
  # fail-closed park path, and cleanup() keeps SNAP_DIR (KEEP_SNAP=1) so the park
  # message can point at it for the manual merge. Running it here — rather than
  # after the freshness check — makes the layer-3 park preserve the writer's
  # content just as the layer-2 rc-12 park does; otherwise the reset destroys it
  # and the "preserved at $SNAP_DIR" message is a false claim.
  snapshot

  check_base_freshness

  # Default commit message (the parking commit message is derived inside
  # park_and_exit()).
  if [[ -z "$msg" ]]; then
    msg="graph: ${ALL_IDS[*]}"
  fi

  # Two states, discriminated by id_files_dirty():
  #   - dirty: normal case — land it; try_land() stages and commits the new
  #     content itself, once it holds the landing lock.
  #   - clean: nothing new to stage — either the desired content is already on
  #     origin/main (truly nothing to do) or a prior attempt already committed it
  #     locally and only failed to push (an ORPHAN). Both are handled by landing
  #     whatever HEAD already is, which makes the same invocation safe to just
  #     retry after any partial failure between the local commit and a
  #     successful push — the sanctioned orphan recovery (header block).
  CURRENT_MSG="$msg"
  # If this is a far-ahead PR-branch worktree, rebuild the edit on an
  # intentions/-only base so the fast path can stamp it (cleanup() restores the
  # original HEAD). No-op for the main checkout and clean/intentions-only
  # worktrees. Runs after snapshot() (taken above, before check_base_freshness)
  # so the writer's content is captured before the reset overwrites the tree.
  #
  # WORKTREE WRITER ONLY, and not merely as an optimization: the rebuild exists
  # because that writer's commit is made ON TOP OF the checkout's HEAD, so a
  # far-ahead HEAD produces a non-intentions/-only SHA the `graph/**` fast path
  # refuses to stamp. The plumbing writer's parent is origin/main by
  # construction (prepare_plumbing_sha), so its SHA is always intentions/-only
  # no matter what HEAD carries — and running the rebuild anyway would reset the
  # caller's whole tree, which is precisely what that writer promises not to do.
  if [[ "$GRAPH_COMMIT_WRITER" == "worktree" ]]; then
    ensure_intentions_only_base
  fi
  # NOTE: the dirty branch no longer commits here. try_land() makes the local
  # commit itself, after it holds the landing lock and immediately before the
  # rebase, so a kill during the lock wait cannot leave an orphaned local commit
  # (see the ORPHAN-WINDOW CONTAINMENT comment there). What remains here is the
  # CLEAN branch's diagnosis, which must still run before land().
  if ! id_files_dirty; then
    # Nothing staged for any id. Under the caller-derived repo resolution above,
    # a "clean" tree has two possible meanings, and they must be told apart:
    #   - benign: this id already matches origin/main (already landed
    #     out-of-band, or a prior attempt committed but did not push) → land the
    #     current HEAD (a trivial no-op push when HEAD == origin/main).
    #   - DIVERGED-AND-NOTHING-STAGED: the resolved repo holds content for this
    #     id that DIFFERS from origin/main yet nothing is staged. TWO causes
    #     produce it — a mis-pointed -C/--repo (the caller's edit lives in
    #     another checkout), or a PRIOR RUN OF THIS SCRIPT killed after it
    #     created the local commit (HEAD carries it, so the tree is clean and
    #     there is nothing left to stage: an ORPHAN). Naming only the first is
    #     what misdirected an earlier diagnosis.
    #
    # The two are told apart PER ID, by whether an unpushed local commit that
    # THIS SCRIPT made actually explains that id's divergent blob
    # (id_divergence_is_own_orphan(), which spells out the test):
    #   - explained → the ORPHAN case. THIS IS THE SANCTIONED RECOVERY PATH
    #     (see the header block's recovery rule): re-running the same invocation
    #     rebases HEAD onto fresh origin/main and pushes it, which lands the
    #     orphan. It must therefore PROCEED, not die. It used to die on every
    #     orphan (an orphan's whole point is that HEAD's blob differs from
    #     origin/main's), so the documented recovery was unreachable and an
    #     operator following it got a wrong-repo accusation instead.
    #   - NOT explained → nothing this script wrote accounts for the divergence,
    #     so it still dies. That covers both the stale/mis-pointed checkout at
    #     or behind origin/main (no local commit at all) AND — the reason the
    #     test is per id rather than a bare unpushed-commit count — a checkout
    #     that happens to carry SOME unrelated unpushed commit: an old one for a
    #     different node, a hand-made commit, a stale worktree's leftovers. A
    #     bare count > 0 exemption would let land() rebase and push that content
    #     onto main, reverting edits other writers landed, and print_verdict()
    #     would then compare main against the same stale content and say
    #     `landed`. (--expect is the robust check for wrong-repo targeting; this
    #     stays as the no-flag backstop.)
    local head_sha main_sha unpushed
    head_sha="$(git rev-parse HEAD)"
    main_sha="$(git rev-parse FETCH_HEAD)"
    unpushed="$(git rev-list --count "$main_sha..$head_sha")"

    # Compare per id against origin/main as pinned by main()'s single fetch
    # ($MAIN_SHA, taken above — do NOT fetch again). Both blobs absent/empty (id
    # absent both places) is benign (equal empty strings).
    local id local_blob main_blob why all_ids_match_main=1
    for id in "${ALL_IDS[@]}"; do
      local_blob="$(git rev-parse "HEAD:intentions/$id.md" 2>/dev/null || true)"
      main_blob="$(git rev-parse "$MAIN_SHA:intentions/$id.md" 2>/dev/null || true)"
      [[ "$local_blob" == "$main_blob" ]] && continue
      all_ids_match_main=0
      id_divergence_is_own_orphan "$id" && continue
      if [[ "$unpushed" -eq 0 ]]; then
        why="'git -C $REPO_ROOT rev-list --count $MAIN_SHA..HEAD' is 0, so HEAD is at or behind origin/main and there is no local commit at all that could explain it"
      else
        why="HEAD carries $unpushed local commit(s) not on origin/main, but NONE of them is one this script made for this id — a commit that touches intentions/$id.md, is a non-merge intentions/-only commit, and carries this invocation's message ('$CURRENT_MSG') or a 'graph: …' subject. Unrelated unpushed commits (an old write for another node, a hand-made commit, a stale worktree's leftovers) do not explain this blob"
      fi
      die "the resolved repo ($REPO_ROOT) holds intentions/$id.md content differing from origin/main but has nothing staged to commit, and no unpushed local commit of this script's own explains it (HEAD blob=${local_blob:-<absent>}, origin/main blob=${main_blob:-<absent>}; $why). That rules out the killed-prior-run cause — an orphan this script made, which it detects and simply lands — and leaves a mis-pointed -C/--repo (or a cwd targeting the wrong checkout, e.g. a STALE worktree), so the edit the caller made lives in a DIFFERENT checkout. Landing this HEAD would rebase and push the stale content onto main, over whatever other writers already landed. Refusing to emit a false 'landed' for a tree that was never going to carry the caller's edit."
    done

    # Nothing is staged AND every id already matches origin/main, so the whole
    # land() cycle (landing lock, graph/** scratch push, await_checks, push to
    # main) is pure cost on content main already carries. Exit success here
    # rather than buying a stamp cycle that cannot change main
    # (tactic-graph-commit-noop-landing-false-failure, Defect 1;
    # tactic-graph-commit-noop-shortcircuit-head-behind).
    #
    # Content parity ($all_ids_match_main) is the load-bearing test. It is
    # NECESSARY on both arms: a run whose ids differ from main has something to
    # land, whatever HEAD looks like. What the second clause adds is the reason
    # HEAD cannot supply that something either:
    #
    #   - $unpushed -eq 0 — HEAD is contained in origin/main, so it carries no
    #     commit main lacks. land() would fetch, rebase HEAD onto the fresh tip
    #     (a fast-forward), and push a ref that is already there. Nothing this
    #     tree holds can reach main, so the cycle cannot change it. Applies to
    #     BOTH writers; it is what makes the default worktree writer skip a
    #     landing on a checkout merely BEHIND origin/main.
    #   - plumbing — HEAD is not that writer's subject at all: it builds from
    #     the ON-DISK content onto origin/main (prepare_plumbing_sha), so parity
    #     alone settles it however far ahead HEAD is. Without this arm a clean
    #     checkout behind origin/main would build a commit whose tree equals its
    #     parent's and push that empty no-op onto main.
    #
    # The old `head_sha == main_sha` arm is gone, strictly subsumed rather than
    # dropped: HEAD == origin/main implies $unpushed -eq 0, and reaching here
    # with $unpushed -eq 0 already implies parity — a mismatched id cannot get
    # past the loop above, because id_divergence_is_own_orphan() reads
    # MAIN_SHA..HEAD and that range is empty, so the die() fires.
    #
    # Accepted behavior change: a behind-but-clean worktree-writer run no longer
    # fast-forwards the caller's checkout as a side effect of land()'s rebase.
    # graph-commit is a writer, not a tree-sync primitive — sync_main_checkout()
    # in lib.sh, or an explicit fetch + reset --hard, is the sync path. Do not
    # add a compensating fast-forward.
    #
    # Downstream, the behind case is confirmed by print_verdict()'s step 3
    # (content equivalence against a freshly fetched main), NOT step 2 — step 2
    # stays a strict ref test on purpose; see the comment there.
    if [[ "$all_ids_match_main" -eq 1 ]] \
       && { [[ "$unpushed" -eq 0 ]] || [[ "$GRAPH_COMMIT_WRITER" == "plumbing" ]]; }; then
      # Every test above is repository-vs-repository, and on the far-ahead
      # rebuild path they are true BY CONSTRUCTION (see
      # assert_noop_matches_intent). Compare this run's INTENT against
      # origin/main before claiming there was nothing to do: a mismatch dies
      # here rather than reaching the `noop` verdict below.
      assert_noop_matches_intent
      echo "graph-commit: no new changes to stage for ${ALL_IDS[*]} and the content is already on origin/main (HEAD ${head_sha:0:8}, origin/main ${main_sha:0:8}) — nothing to push; skipping the landing cycle" >&2
      # Still route through the verdict rather than a bare `exit 0`: the reading
      # above is of the tip pinned BEFORE this run, and a peer can have moved
      # main since. The verdict re-reads origin/main and answers about the
      # current tip.
      emit_verdict_and_exit noop
    fi

    # Reaching here means the short-circuit did not fire, and exactly one shape
    # can do that: HEAD carries unpushed local commits ($unpushed -gt 0). The
    # behind/at-main shapes are all handled above — $unpushed -eq 0 forces
    # parity (a mismatched id dies in the loop, since
    # id_divergence_is_own_orphan() finds nothing in an empty MAIN_SHA..HEAD),
    # and parity plus $unpushed -eq 0 is precisely the widened guard. So this is
    # the orphan-recovery path: a prior run of this script committed and was
    # killed before it pushed, and re-running the same invocation rebases and
    # lands that commit.
    echo "graph-commit: no new changes to stage for ${ALL_IDS[*]} — landing current HEAD ($unpushed local commit(s) not on origin/main: a prior attempt already committed but did not push — this is the sanctioned orphan recovery; see the orphan-detected line above)" >&2
  fi

  local rc=0
  land || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    # `rc` is this process's own view of its own push — the signal that has been
    # observed lying in both directions. Verify against origin/main BEFORE
    # printing any "landed" claim, and let the verdict, not rc, pick the exit.
    print_verdict push-reported-success
    if [[ "$LAST_VERDICT" == "landed" || "$LAST_VERDICT" == "landed-equivalent" ]]; then
      # Same rc-0 landed outcome whether or not a layer-2/3 auto-merge was needed;
      # RESOLVED_VIA_MERGE only distinguishes the log line (no new exit code).
      local landed_msg="graph-commit: landed ${ALL_IDS[*]} on main"
      if [[ "$RESOLVED_VIA_MERGE" -eq 1 ]]; then
        landed_msg+=" (layer 2/3 auto-resolved a concurrent-edit divergence)"
      fi
      echo "$landed_msg" >&2
    else
      echo "error: graph-commit: the push to main reported success, but a read of origin/main does not confirm it for ${ALL_IDS[*]} — see the verdict line above; NOT reporting a landing" >&2
    fi
    emit_verdict_and_exit push-reported-success
  fi
  if [[ "$rc" -eq 11 ]]; then
    # Busy main, no semantic conflict — try_land() already errored loudly. No
    # parking. But exhaustion is only this process's view of its own pushes: if
    # the content IS on origin/main (this run's own push landed despite
    # reporting failure, or a peer landed identical content), the verdict says
    # so and this exits 0.
    emit_verdict_and_exit busy-exhausted
  fi

  # rc == 12: concurrent-edit conflict layer 2 could not fully resolve — fail
  # closed via the shared park path.
  park_and_exit
}

# Run main only when executed directly; when sourced (e.g. for unit-testing the
# guard/snapshot helpers) the functions are defined but nothing runs.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
