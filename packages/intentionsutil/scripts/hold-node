#!/usr/bin/env bash
# hold-node — land a "tracked hold" for a source node that hit a mechanical
# retry state (tactic-mechanical-park-producers, unit 2). The LANDING half of
# the decision/land split whose DECISION half is the network-free
# `hold-node-decide.ts` (this script makes no decisions of its own: it refreshes
# from origin/main, asks that tool what to do, writes what it says, and lands
# it).
#
# Doctrine: a park (`office_hours`) means "no autonomous path exists, a human is
# required". A merge-conflict retry against a moving main, or fix-attempt-cap
# exhaustion, is NOT that — so the SOURCE node is never parked. Instead a small
# born-parked HOLD TACTIC carries the park and the source gains an idempotent
# `blocked_by` edge naming it. **The source's own `office_hours` is never
# written by this script** — it does not appear anywhere below, and that absence
# is load-bearing.
#
# The hold node and the source's edge land in ONE `graph-commit` (the doctrine's
# "the hold and the edge clear in the same graph-commit" requirement): both ids
# are passed positionally to a single invocation.
#
# Fresh-origin/main invariant (mirrors park-node): every read-modify-write below
# operates on origin/main's CURRENT content, never a possibly-stale local
# worktree copy. This script fetches origin/main, overwrites the local node
# file(s) with origin/main's version, THEN reads/mutates/writes, and passes
# graph-commit a `--base <id>=<blobsha>` compare-and-swap token per PRE-EXISTING
# file. If origin/main advances again before the land, graph-commit refuses the
# write (hold-node exits 1) rather than silently reverting newer landed content.
# The hold node's own file gets the same treatment when it already exists; when
# it does not, absence is the EXPECTED born-fresh case (the inverted probe
# dispatch-graph-census uses), not an error — and no `--base` token is emitted
# for it.
#
# Usage:
#   hold-node <source-node-id>
#             --kind <provision-conflict|fix-attempt-cap|worktree-residue|ci-pending-stalled>
#             --reason-file <f> --recommendation-file <f>
#             [--body-file <f>] [--reset-fix-attempt] [--reset-fix-cycle]
#
# --reason-file / --recommendation-file are FILES (not inline strings): both are
#   multi-line diagnostic text, passed through to hold-node-decide.ts verbatim.
# --body-file <f>: optional extra diagnosis prose folded into the hold body.
# --reset-fix-attempt: additionally reset the SOURCE's `execution.fix.attempt`
#   counter (see the call site below for why it must happen here, not in the
#   caller).
# --reset-fix-cycle: additionally reset the SOURCE's LIFETIME
#   `execution.attempts[FIX_CYCLE_ATTEMPT_KEY]` cross-cycle counter (distinct
#   from --reset-fix-attempt's in-episode counter — see apply-fix-state.ts's
#   `--reset-cycle`). Called by `reconcile-graph-review-stall` when it lands a
#   cross-cycle-cap hold, so resolving the hold gives the node a fresh
#   lifetime budget rather than leaving it permanently capped.
#
# Stdout: exactly one line — `held <hold-id> (<disposition>)`, where
# <disposition> is NONE (born fresh) | EXISTING (re-entry on an open hold) |
# REOPENED (re-entry on a hold already resolved to phase done).
#
# Exit codes (park-node's scheme): 0 held and landed on main; 1 the write or
# graph-commit failed (including a refused compare-and-swap because origin/main
# advanced, or an unreachable/absent-node origin/main); 2 usage error.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
INTENTIONS_DIR="$REPO_ROOT/intentions"
DECIDE_TS="$SCRIPT_DIR/hold-node-decide.ts"
WRITE_NODE_TS="$SCRIPT_DIR/write-node.ts"
DUMP_NODE_TS="$SCRIPT_DIR/dump-node.ts"
APPLY_FIX_TS="$SCRIPT_DIR/apply-fix-state.ts"
GRAPH_COMMIT="$SCRIPT_DIR/graph-commit"

USAGE="usage: hold-node <source-node-id> --kind <provision-conflict|fix-attempt-cap|worktree-residue|ci-pending-stalled> --reason-file <f> --recommendation-file <f> [--body-file <f>] [--reset-fix-attempt] [--reset-fix-cycle]"

SOURCE_ID=""
KIND=""
REASON_FILE=""
RECOMMENDATION_FILE=""
BODY_FILE=""
RESET_FIX_ATTEMPT=0
RESET_FIX_CYCLE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --kind) KIND="${2:-}"; shift 2 || { echo "$USAGE" >&2; exit 2; } ;;
    --reason-file) REASON_FILE="${2:-}"; shift 2 || { echo "$USAGE" >&2; exit 2; } ;;
    --recommendation-file) RECOMMENDATION_FILE="${2:-}"; shift 2 || { echo "$USAGE" >&2; exit 2; } ;;
    --body-file) BODY_FILE="${2:-}"; shift 2 || { echo "$USAGE" >&2; exit 2; } ;;
    --reset-fix-attempt) RESET_FIX_ATTEMPT=1; shift ;;
    --reset-fix-cycle) RESET_FIX_CYCLE=1; shift ;;
    -*) echo "hold-node: unknown option \"$1\"" >&2; echo "$USAGE" >&2; exit 2 ;;
    *)
      if [[ -n "$SOURCE_ID" ]]; then
        echo "hold-node: unexpected extra positional argument \"$1\"" >&2
        echo "$USAGE" >&2
        exit 2
      fi
      SOURCE_ID="$1"; shift
      ;;
  esac
done

if [[ -z "$SOURCE_ID" || -z "$KIND" || -z "$REASON_FILE" || -z "$RECOMMENDATION_FILE" ]]; then
  echo "$USAGE" >&2
  exit 2
fi
for f in "$REASON_FILE" "$RECOMMENDATION_FILE" ${BODY_FILE:+"$BODY_FILE"}; do
  [[ -f "$f" ]] || { echo "hold-node: no such file: $f" >&2; exit 2; }
done

DECIDE_ARGS=(--source "$SOURCE_ID" --kind "$KIND"
             --reason-file "$REASON_FILE" --recommendation-file "$RECOMMENDATION_FILE")
[[ -n "$BODY_FILE" ]] && DECIDE_ARGS+=(--body-file "$BODY_FILE")

# Sets DECIDE_OUT to the decision JSON. Deliberately NOT a command-substitution
# helper: it exits on failure, and an `exit` inside `$(...)` would only kill the
# substitution subshell, leaving the caller running with an empty decision.
DECIDE_OUT=""
run_decide() {
  DECIDE_OUT="$( (cd "$REPO_ROOT" && node --import tsx/esm "$DECIDE_TS" "${DECIDE_ARGS[@]}") )"
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    # hold-node-decide.ts exits 2 on its own usage errors (bad --kind, missing
    # flag); anything else is an environment/read failure. Preserve the
    # distinction so a caller sees the same 2-means-usage contract.
    echo "hold-node: hold-node-decide failed for $SOURCE_ID (rc=$rc)" >&2
    exit $(( rc == 2 ? 2 : 1 ))
  fi
}

# --- Fresh-origin/main refresh (source) --------------------------------------
# Refresh the LOCAL source file from origin/main BEFORE reading it, so the
# blocked_by mutation lands on top of the current landed content rather than a
# stale worktree copy (the invocation typically comes from a far-behind
# PR-branch worktree). An unreachable origin/main or a source absent from
# origin/main is genuine environment breakage — fail with a clear error, never
# fall back to the local copy (code-style.md).
if ! git -C "$REPO_ROOT" fetch origin main >&2; then
  echo "hold-node: could not fetch origin/main to refresh $SOURCE_ID before holding" >&2
  exit 1
fi
if ! SOURCE_BLOB="$(git -C "$REPO_ROOT" rev-parse "origin/main:intentions/$SOURCE_ID.md" 2>/dev/null)"; then
  echo "hold-node: intentions/$SOURCE_ID.md does not exist on origin/main — cannot hold a node that is not landed" >&2
  exit 1
fi
if ! git -C "$REPO_ROOT" show "origin/main:intentions/$SOURCE_ID.md" > "$INTENTIONS_DIR/$SOURCE_ID.md"; then
  echo "hold-node: could not refresh intentions/$SOURCE_ID.md from origin/main" >&2
  exit 1
fi

# --- Fresh-origin/main refresh (hold) ----------------------------------------
# The hold id is DETERMINISTIC but derived by hold-node-decide.ts (the kind ->
# slug map lives there, and duplicating it here would be a second source of
# truth). So run the decision once purely to learn the id, refresh that file
# from origin/main, then run it AGAIN for the decision that is actually acted
# on — the second run is the one that reads fresh hold state (present/absent,
# phase done or not), which is exactly the read a stale worktree would get
# wrong.
run_decide
HOLD_ID="$(jq -r '.hold_id' <<<"$DECIDE_OUT")"
[[ -n "$HOLD_ID" && "$HOLD_ID" != "null" ]] || {
  echo "hold-node: could not derive the hold id for $SOURCE_ID" >&2; exit 1; }

# Inverted absent-node probe (dispatch-graph-census:96-101): here absence is the
# EXPECTED born-fresh case and presence is the re-entry case. HOLD_BLOB set ⇒
# emit a --base token for it and restore it on rollback; HOLD_BLOB unset ⇒ no
# --base token, and rollback deletes the freshly born file.
HOLD_BLOB=""
if git -C "$REPO_ROOT" rev-parse -q --verify "origin/main:intentions/$HOLD_ID.md" >/dev/null 2>&1; then
  HOLD_BLOB="$(git -C "$REPO_ROOT" rev-parse "origin/main:intentions/$HOLD_ID.md")"
  if ! git -C "$REPO_ROOT" show "origin/main:intentions/$HOLD_ID.md" > "$INTENTIONS_DIR/$HOLD_ID.md"; then
    echo "hold-node: could not refresh intentions/$HOLD_ID.md from origin/main" >&2
    exit 1
  fi
elif [[ -f "$INTENTIONS_DIR/$HOLD_ID.md" ]]; then
  # Present locally, absent on origin/main: an unlanded/stray hold file. Acting
  # on it would either clobber it or read a disposition origin/main does not
  # have. Clear error, no fallback.
  echo "hold-node: intentions/$HOLD_ID.md exists locally but not on origin/main — resolve that unlanded file first" >&2
  exit 1
fi

run_decide
DECISION="$DECIDE_OUT"
DISPOSITION="$(jq -r '.disposition' <<<"$DECISION")"
SOURCE_EDGE_NEEDED="$(jq -r '.source_edge_needed' <<<"$DECISION")"

# Consistency guard: the on-origin/main probe and the decision must agree about
# whether the hold pre-exists. A disagreement means the store and origin/main
# have drifted; fail rather than emit a wrong --base token set.
if [[ -n "$HOLD_BLOB" && "$DISPOSITION" == "NONE" ]] \
   || [[ -z "$HOLD_BLOB" && "$DISPOSITION" != "NONE" ]]; then
  echo "hold-node: disposition $DISPOSITION disagrees with origin/main presence of $HOLD_ID" >&2
  exit 1
fi

TMPDIR_HOLD="$(mktemp -d)" || { echo "hold-node: mktemp -d failed" >&2; exit 1; }
# MUTATED gates the rollback: only undo the on-disk writes if this script
# actually began writing (armed immediately before the first mutation below). A
# pre-mutation failure must not touch files this script never wrote. A failed
# land must leave NO dirty intentions/*.md — otherwise graph-commit's
# assert_clean_outside_ids guard trips for every OTHER unrelated node on the
# next run.
MUTATED=0
# Bash traps REPLACE (not stack) on the same signal, so this single EXIT trap
# owns the temp cleanup AND both files' rollback: restore each pre-existing file
# from the immutable blob SHA captured before the mutation (not the moving
# origin/main ref), and delete a hold file that was born fresh in this run.
trap '
  rc=$?
  rm -rf "$TMPDIR_HOLD"
  if [[ "$MUTATED" == 1 && $rc -ne 0 ]]; then
    if git -C "$REPO_ROOT" show "$SOURCE_BLOB" > "$INTENTIONS_DIR/$SOURCE_ID.md.rollback"; then
      mv "$INTENTIONS_DIR/$SOURCE_ID.md.rollback" "$INTENTIONS_DIR/$SOURCE_ID.md"
    else
      rm -f "$INTENTIONS_DIR/$SOURCE_ID.md.rollback"
    fi
    if [[ -n "$HOLD_BLOB" ]]; then
      if git -C "$REPO_ROOT" show "$HOLD_BLOB" > "$INTENTIONS_DIR/$HOLD_ID.md.rollback"; then
        mv "$INTENTIONS_DIR/$HOLD_ID.md.rollback" "$INTENTIONS_DIR/$HOLD_ID.md"
      else
        rm -f "$INTENTIONS_DIR/$HOLD_ID.md.rollback"
      fi
    else
      rm -f "$INTENTIONS_DIR/$HOLD_ID.md"
    fi
  fi
' EXIT

MUTATED=1

# --- Optional: reset the source's fix-attempt counter ------------------------
# Run AFTER the fresh-main refresh above, deliberately: the refresh overwrites
# intentions/<source>.md wholesale from origin/main, so a reset performed by the
# CALLER before invoking hold-node would be silently clobbered by it. The reset
# has to happen inside this script, on the refreshed file, and ride along in the
# same graph-commit as the hold + edge.
# NOTE: `--reset-attempt` is added to apply-fix-state.ts by a sibling unit of
# this plan; this is the wiring of its call site only.
SOURCE_CHANGED=0
if [[ "$RESET_FIX_ATTEMPT" == 1 ]]; then
  if ! (cd "$REPO_ROOT" && node --import tsx/esm "$APPLY_FIX_TS" "$SOURCE_ID" --reset-attempt) >/dev/null; then
    echo "hold-node: apply-fix-state --reset-attempt failed for $SOURCE_ID" >&2
    exit 1
  fi
  SOURCE_CHANGED=1
fi
if [[ "$RESET_FIX_CYCLE" == 1 ]]; then
  if ! (cd "$REPO_ROOT" && node --import tsx/esm "$APPLY_FIX_TS" "$SOURCE_ID" --reset-cycle) >/dev/null; then
    echo "hold-node: apply-fix-state --reset-cycle failed for $SOURCE_ID" >&2
    exit 1
  fi
  SOURCE_CHANGED=1
fi

# --- Write the hold node -----------------------------------------------------
HOLD_MD="$INTENTIONS_DIR/$HOLD_ID.md"
if [[ "$DISPOSITION" != "EXISTING" ]]; then
  # NONE and REOPENED both carry a full node object; write-node.ts is the single
  # validation gate (frontmatter only).
  jq -c '.node' <<<"$DECISION" > "$TMPDIR_HOLD/node.json"
  if ! (cd "$REPO_ROOT" && node --import tsx/esm "$WRITE_NODE_TS" --dir "$INTENTIONS_DIR" --file "$TMPDIR_HOLD/node.json") >/dev/null; then
    echo "hold-node: write-node failed for $HOLD_ID" >&2
    exit 1
  fi
fi
if [[ ! -f "$HOLD_MD" ]]; then
  echo "hold-node: expected $HOLD_MD after the hold write, not found" >&2
  exit 1
fi

if [[ "$DISPOSITION" == "NONE" ]]; then
  # Replace the body WHOLESALE. writeNode does not leave a new node body-less:
  # it generates a `# <statement>` placeholder body (store.ts's
  # readExistingTacticBody returns null for a not-yet-existing file). Appending
  # here would produce a malformed two-H1 body (the placeholder H1 followed by
  # the hold body's own H1). So keep the frontmatter through the closing `---`
  # fence, drop the generated placeholder, and write the real hold body directly
  # after the fence (the store's node-file convention: the body starts on the
  # line after the closing fence, no blank line).
  FRONTMATTER=$(awk '{print} /^---$/{c++; if(c==2) exit}' "$HOLD_MD")
  if [[ "$(tail -n1 <<<"$FRONTMATTER")" != "---" ]]; then
    echo "hold-node: could not locate closing frontmatter fence in $HOLD_MD" >&2
    exit 1
  fi
  { printf '%s\n' "$FRONTMATTER"; jq -r '.node_body' <<<"$DECISION"; } > "$HOLD_MD"
else
  # EXISTING / REOPENED: APPEND the dated occurrence stanza — never replace. The
  # existing body is the hold's accumulated history, and writeNode already
  # preserved it verbatim on the REOPENED frontmatter write above.
  jq -r '.node_body_append' <<<"$DECISION" >> "$HOLD_MD"
fi

# --- Write the source's blocked_by edge --------------------------------------
# Idempotent by construction: hold-node-decide.ts emits source_blocked_by
# already containing the hold id exactly once, and source_edge_needed is false
# when the edge is already present (so no write happens at all).
#
# This goes through write-node.ts + graph-commit, NOT transition-node: that
# script only handles `phase`/`--set-pr` and has no blocked_by support.
if [[ "$SOURCE_EDGE_NEEDED" == "true" ]]; then
  # dump-node.ts reads the node through readNode (post-reset, so a
  # --reset-fix-attempt write above is preserved, not clobbered) and emits the
  # exact JSON shape write-node.ts consumes.
  if ! (cd "$REPO_ROOT" && node --import tsx/esm "$DUMP_NODE_TS" --dir "$INTENTIONS_DIR" --out-dir "$TMPDIR_HOLD/src" "$SOURCE_ID") >/dev/null; then
    echo "hold-node: dump-node failed for $SOURCE_ID" >&2
    exit 1
  fi
  if ! jq --argjson bb "$(jq -c '.source_blocked_by' <<<"$DECISION")" \
        '.blocked_by = $bb' "$TMPDIR_HOLD/src/$SOURCE_ID.json" > "$TMPDIR_HOLD/src-edge.json"; then
    echo "hold-node: could not compose the blocked_by edit for $SOURCE_ID" >&2
    exit 1
  fi
  if ! (cd "$REPO_ROOT" && node --import tsx/esm "$WRITE_NODE_TS" --dir "$INTENTIONS_DIR" --file "$TMPDIR_HOLD/src-edge.json") >/dev/null; then
    echo "hold-node: write-node failed for $SOURCE_ID (blocked_by edge)" >&2
    exit 1
  fi
  SOURCE_CHANGED=1
fi

# --- Land the hold AND the edge in ONE graph-commit ---------------------------
# Both ids go into a single invocation (multi-id and repeatable --base are both
# supported — graph-commit:32,37-41), satisfying the doctrine's requirement that
# the hold and the edge clear in the same graph-commit. A --base token is
# emitted only for a file that PRE-EXISTED on origin/main: the source always,
# the hold only on EXISTING/REOPENED (a born-fresh NONE hold has no prior blob
# to compare against).
COMMIT_ARGS=()
IDS=()
if [[ "$SOURCE_CHANGED" == 1 ]]; then
  COMMIT_ARGS+=(--base "$SOURCE_ID=$SOURCE_BLOB")
  IDS+=("$SOURCE_ID")
fi
if [[ -n "$HOLD_BLOB" ]]; then
  COMMIT_ARGS+=(--base "$HOLD_ID=$HOLD_BLOB")
fi
IDS+=("$HOLD_ID")

if ! (cd "$REPO_ROOT" && "$GRAPH_COMMIT" "${COMMIT_ARGS[@]}" \
        -m "graph: hold $SOURCE_ID on $HOLD_ID ($KIND)" "${IDS[@]}"); then
  echo "hold-node: graph-commit failed for $HOLD_ID; the hold and edge writes were rolled back" >&2
  exit 1
fi

echo "held $HOLD_ID ($DISPOSITION)"
exit 0
