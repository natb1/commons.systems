#!/usr/bin/env bash
# mark-node-terminal — record that THIS node worker's pass reached a terminal
# disposition, so its Stop hook may reap the job.
#
# Usage: mark-node-terminal <node-id> <disposition>
#
# `Stop` fires whenever the model yields the turn, not only on terminal exit. A
# node worker that posts an interim message and waits on a background subagent
# yields — and, before this marker existed, dispatch-self-close reaped the job
# out from under the still-running subagents (confirmed incident 2026-07-28,
# node tactic-graph-ref-split, session 36e64744). The invariant this marker
# carries: a session may only be reaped when it PROGRESSED (advance), retried by
# design (fix-attempt), or PARKED. Absent that positive evidence,
# dispatch-self-close holds the job alive instead of reaping it.
#
# Marker contents (byte format MUST be preserved — read by dispatch-self-close,
# which greps ^node= only; disposition= is diagnostic):
#
#   node=<node-id>
#   disposition=<disposition>
#
# <disposition> is one of:
#   advance      transition-node landed a forward phase write
#   demote       transition-node delegated to demote-node-to-implement
#   park         park-node landed an office_hours record
#   fix-attempt  a fix-checks pass spent an attempt (retry by design)
#   align-round  align-tactics landed a decomposition round
#   no-claim     the session held no claim and did nothing (safe to reap)
#
# Ownership gate: the marker is written ONLY when $CLAUDE_JOB_DIR/state.json's
# `.name` equals <node-id>. This is what makes it safe for park-node to call
# unconditionally — an office-hours drain parking three OTHER nodes, or an
# align-tactics run landing child tactics, cannot authorize its own reap.
#
# When CLAUDE_JOB_DIR is unset/empty or not a directory the script is running
# interactively (not under a dispatch job): it prints a diagnostic and no-ops
# (exit 0), so the same call is harmless in an interactive run.
#
# A missing argument, a malformed node id, or an unknown disposition is a clear
# error, not a fallback (exit 2).
#
# NOT related to dispatch-mark-complete / the `phase-completed` marker — that is
# the legacy gh-issue lane and is untouched by this script.
set -euo pipefail

USAGE="usage: mark-node-terminal <node-id> <disposition>"

if [[ $# -ne 2 ]]; then
  echo "mark-node-terminal: expected exactly 2 arguments, got $#" >&2
  echo "$USAGE" >&2
  exit 2
fi

NODE_ID="$1"
DISPOSITION="$2"

# Mirror the node-id validation at dispatch-graph-execute:138 (which mirrors
# provision-node-worktree:52). The slug regex excludes numeric-prefixed (legacy
# gh lane) names.
if [[ ! "$NODE_ID" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
  echo "mark-node-terminal: invalid node id: $NODE_ID" >&2
  echo "$USAGE" >&2
  exit 2
fi

case "$DISPOSITION" in
  advance|demote|park|fix-attempt|align-round|no-claim) ;;
  *)
    echo "mark-node-terminal: unknown disposition: $DISPOSITION (expected advance, demote, park, fix-attempt, align-round, or no-claim)" >&2
    exit 2
    ;;
esac

# CLAUDE_JOB_DIR guard: an interactive run (no dispatch job) is a no-op.
if [[ -z "${CLAUDE_JOB_DIR:-}" || ! -d "$CLAUDE_JOB_DIR" ]]; then
  echo "mark-node-terminal: CLAUDE_JOB_DIR unset or not a directory; interactive run, skipping marker write" >&2
  exit 0
fi

# Ownership gate. A missing state.json, a jq failure, or a name that is not this
# node id all collapse to "not my job" — diagnostic, exit 0, NO write.
# shell-json.md: jq reads the file directly; never `echo "$VAR" | jq`.
STATE_JSON="$CLAUDE_JOB_DIR/state.json"
JOB_NAME=""
if [[ -f "$STATE_JSON" ]]; then
  JOB_NAME=$(jq -r '.name // ""' "$STATE_JSON" 2>/dev/null) || JOB_NAME=""
fi
if [[ "$JOB_NAME" != "$NODE_ID" ]]; then
  echo "mark-node-terminal: this job is '${JOB_NAME:-<none>}', not '$NODE_ID'; skipping marker write (a session may only authorize its own reap)" >&2
  exit 0
fi

# Atomic write: tempfile + mv. The exact byte format is read by
# dispatch-self-close, which greps ^node= only.
f="$CLAUDE_JOB_DIR/node-terminal"
printf 'node=%s\ndisposition=%s\n' "$NODE_ID" "$DISPOSITION" > "$f.tmp"
mv "$f.tmp" "$f"
