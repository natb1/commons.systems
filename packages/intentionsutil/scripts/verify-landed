#!/usr/bin/env bash
# verify-landed — the one place that answers "did this actually land on
# origin/main?" (tactic-graph-commit-landing-signal-unreliable).
#
# WHY IT EXISTS. A writer's own exit code and log text are not evidence.
# graph-commit can exit 0 after a push that never made it, and can exit
# non-zero after a park write that DID land; every caller that reads those
# signals as a verdict inherits the defect. This primitive replaces all of
# them with the only authority there is: the content of origin/main. Callers
# ask a question about origin/main and get one of three answers — landed,
# not-landed, or unknown — and the three are never collapsed into two.
#
#   exit 0  landed      every spec is satisfied at origin/main
#   exit 4  not-landed  the read SUCCEEDED and at least one spec is
#                       definitively unsatisfied
#   exit 1  unknown     could not determine (fetch failed, git error, tsx or
#                       jq failure) — nothing is claimed either way
#   exit 2  usage error
#
# The 0/4/1 split is the whole point. Collapsing `unknown` into `landed`
# reports success for a write that may not exist; collapsing it into
# `not-landed` triggers retries and rollbacks against a graph that may already
# be correct. Both are the defect this script was written to end. A caller
# that cannot handle three answers should park, not guess.
#
# Usage:
#   verify-landed [-C <repo-path>] [--no-fetch] [--json] <spec> [<spec>...]
#
# Spec forms:
#   <id>=<blobsha>    origin/main:intentions/<id>.md must be exactly <blobsha>
#   <id>=absent       the node must be ABSENT from origin/main (a landed prune)
#   <id>@<jq-filter>  the jq filter over the node's JSON as of origin/main must
#                     evaluate true, e.g. 'tactic-foo@.office_hours != null'
#
# When a spec contains both `=` and `@`, the delimiter that appears FIRST wins
# (a jq filter may legitimately contain `=`, as in `.phase == "done"`).
#
# Repo resolution: `-C <path>` when given, else the current directory, run
# through `git rev-parse --show-toplevel` — identical to graph-commit's own
# main() resolution, and for the same reason. Resolving from THIS SCRIPT's
# on-disk location would answer about whichever checkout the script was
# invoked from by absolute path (routinely the main checkout) rather than the
# caller's, which is the staleness-silent-revert defect all over again.
#
# It never writes. No fetch-into-worktree, no `git show > file`, no index
# touch, no node file rewritten — only `git fetch` (which updates a
# remote-tracking ref, not the tree) and read-only plumbing. This is also why
# it cannot be built on dump-node.ts: that tool resolves its intentionsDir
# from its OWN file location (dump-node.ts:37-40), so it can only ever read
# the script's checkout's WORKING TREE — the wrong repo and the wrong
# revision. The `@<jq-filter>` mode goes through readNodeAtRef
# (lib-store-at-ref.ts) instead, which takes the repo root as a parameter and
# reads at a ref.
#
# Cost: the `=<blobsha>` and `=absent` modes are pure git plumbing — no node,
# no tsx — so the hot path (the one every writer runs after every land) costs
# a fetch and a rev-parse. Only `@<jq-filter>` pays for a tsx start-up.
#
# FILE DESCRIPTORS. Callers holding a flock fd across their write (see
# dispatch-fleet-alarm's `9>&-` discipline, :485-487) must close it across
# this call: `verify-landed ... 9>&-`. `git fetch` forks a credential helper
# that can outlive this process and would pin an inherited fd, holding the
# caller's mutex open long after the caller released it. verify-landed itself
# holds no locks and needs no inherited descriptors.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_STORE_AT_REF="$SCRIPT_DIR/lib-store-at-ref.ts"

USAGE="usage: verify-landed [-C <repo-path>] [--no-fetch] [--json] <spec> [<spec>...]
  spec: <id>=<blobsha> | <id>=absent | <id>@<jq-filter>"

usage_error() {
  echo "$USAGE" >&2
  [[ $# -gt 0 ]] && echo "error: verify-landed: $1" >&2
  exit 2
}

REPO_ARG=""
DO_FETCH=1
AS_JSON=0
SPECS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C|--repo) [[ $# -ge 2 ]] || usage_error "-C requires a repo path argument"
               REPO_ARG="$2"; shift 2 ;;
    -C=*|--repo=*) REPO_ARG="${1#*=}"; shift ;;
    --no-fetch) DO_FETCH=0; shift ;;
    --json) AS_JSON=1; shift ;;
    -h|--help) echo "$USAGE"; exit 0 ;;
    --) shift; while [[ $# -gt 0 ]]; do SPECS+=("$1"); shift; done ;;
    -*) usage_error "unknown option '$1'" ;;
    *) SPECS+=("$1"); shift ;;
  esac
done

[[ ${#SPECS[@]} -gt 0 ]] || usage_error "at least one spec is required"

# --- Parse the specs up front -------------------------------------------------
# A malformed spec is a caller bug, so it must be a cheap exit 2 BEFORE any
# network call — never a `not-landed` verdict, which would read as a real
# answer about the graph.
IDS=()
MODES=()
EXPECTED=()
for spec in "${SPECS[@]}"; do
  eq_head="${spec%%=*}"
  at_head="${spec%%@*}"
  has_eq=0; has_at=0
  [[ "$spec" == *=* ]] && has_eq=1
  [[ "$spec" == *@* ]] && has_at=1

  if [[ $has_eq -eq 1 && ( $has_at -eq 0 || ${#eq_head} -lt ${#at_head} ) ]]; then
    id="$eq_head"; mode="blob"; want="${spec#*=}"
  elif [[ $has_at -eq 1 ]]; then
    id="$at_head"; mode="jq"; want="${spec#*@}"
  else
    usage_error "spec '$spec' has neither '=' nor '@' — see the spec forms above"
  fi

  [[ -n "$id" ]] || usage_error "spec '$spec' has an empty node id"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || usage_error "spec '$spec' has a malformed node id '$id'"
  [[ -n "$want" ]] || usage_error "spec '$spec' has an empty expectation"
  if [[ "$mode" == "blob" && "$want" != "absent" && ! "$want" =~ ^[0-9a-f]{40}$ ]]; then
    usage_error "spec '$spec': expected a 40-hex blob sha or the literal 'absent', got '$want'"
  fi

  IDS+=("$id"); MODES+=("$mode"); EXPECTED+=("$want")
done

# --- Resolve the repo from the CALLER, never from this script's location -----
RESOLVE_FROM="${REPO_ARG:-$(pwd)}"
if ! REPO_ROOT="$(git -C "$RESOLVE_FROM" rev-parse --show-toplevel 2>/dev/null)"; then
  usage_error "'$RESOLVE_FROM' is not inside a git repository — verify-landed reads the CALLER's checkout (resolved from -C, else the current directory), never this script's own location"
fi

ID_CSV="$(IFS=,; echo "${IDS[*]}")"

# report <verdict> <main-sha> — emit the single terminal line (plus the --json
# object) and exit with the verdict's code. The terminal line's `verdict=` word
# is the machine-readable answer; nothing else on stdout is.
STATUSES=()
OBSERVED=()
report() {
  local verdict="$1" main_sha="$2" code
  case "$verdict" in
    landed) code=0 ;;
    not-landed) code=4 ;;
    *) code=1 ;;
  esac
  echo "verify-landed: verdict=$verdict ids=$ID_CSV main=${main_sha:-unknown}"
  if [[ $AS_JSON -eq 1 ]]; then
    local args=(--arg verdict "$verdict" --arg main "${main_sha:-}")
    local filter='{verdict: $verdict, main: (if $main == "" then null else $main end), specs: []}'
    local i
    for i in "${!IDS[@]}"; do
      args+=(--arg "id$i" "${IDS[$i]}" --arg "mode$i" "${MODES[$i]}"
             --arg "status$i" "${STATUSES[$i]:-unknown}"
             --arg "observed$i" "${OBSERVED[$i]:-}" --arg "expected$i" "${EXPECTED[$i]}")
      filter+=" | .specs += [{id: \$id$i, mode: \$mode$i, status: \$status$i,"
      filter+=" observed: (if \$observed$i == \"\" then null else \$observed$i end),"
      filter+=" expected: \$expected$i}]"
    done
    jq -n "${args[@]}" "$filter"
  fi
  exit "$code"
}

# --- Refresh origin/main ------------------------------------------------------
# A fetch failure yields `unknown`, NEVER `not-landed`: an unreachable remote
# says nothing about what is on it. `9>&-` inside this script would be a lie —
# the discipline belongs to the CALLER (see the header), which owns the lock.
if [[ $DO_FETCH -eq 1 ]]; then
  if ! git -C "$REPO_ROOT" fetch --quiet origin main >&2; then
    echo "verify-landed: could not fetch origin/main in $REPO_ROOT — the outcome is undetermined" >&2
    report unknown ""
  fi
fi

if ! MAIN_SHA="$(git -C "$REPO_ROOT" rev-parse origin/main 2>/dev/null)"; then
  echo "verify-landed: could not resolve origin/main in $REPO_ROOT — the outcome is undetermined" >&2
  report unknown ""
fi

# --- Evaluate each spec -------------------------------------------------------
# Reduce over the specs: any `unknown` wins outright (it is the absence of an
# answer, not a weak answer); otherwise any `unsatisfied` decides.
ANY_UNKNOWN=0
ANY_UNSATISFIED=0

# node_json_at_main <id> — print the node's JSON as of origin/main via
# readNodeAtRef, or the literal `null` when the node is absent there. Runs
# from SCRIPT_DIR (not REPO_ROOT) so `npx tsx` and the tsx loader resolve
# against THIS checkout's node_modules; the repo under inspection is passed as
# an argument, exactly as readNodeAtRef's contract requires.
# The tsx entry itself is a heredoc temp module (park-node:345-362 uses the
# same shape) rather than a committed sibling script: it is four lines of glue
# with no independent callers, and the library it delegates to — and its
# tests — are the real surface.
TMPTS=""
cleanup_tmpts() { [[ -n "$TMPTS" ]] && rm -f "$TMPTS"; }
trap cleanup_tmpts EXIT

node_json_at_main() {
  local id="$1"
  if [[ -z "$TMPTS" ]]; then
    TMPTS="$(mktemp --suffix=.mts)" || return 1
    cat >"$TMPTS" <<'TS'
// argv: <libPath> <repoRoot> <ref> <id>
const [libPath, repoRoot, ref, id] = process.argv.slice(2);
const { readNodeAtRef } = await import(libPath);
process.stdout.write(JSON.stringify(readNodeAtRef(repoRoot, ref, id) ?? null));
TS
  fi
  # `node --import tsx/esm` (resolve-hold's form), not `npx tsx`: the tsx CLI
  # opens an IPC unix socket at start-up, which a sandboxed caller cannot do
  # (EPERM) — turning every jq-mode verification into a spurious `unknown`.
  # The loader form needs no socket.
  (cd "$SCRIPT_DIR" && node --import tsx/esm "$TMPTS" "$LIB_STORE_AT_REF" "$REPO_ROOT" "origin/main" "$id")
}

for i in "${!IDS[@]}"; do
  id="${IDS[$i]}"; mode="${MODES[$i]}"; want="${EXPECTED[$i]}"
  status="unknown"; observed=""

  case "$mode" in
    blob)
      if blob="$(git -C "$REPO_ROOT" rev-parse -q --verify "origin/main:intentions/$id.md" 2>/dev/null)"; then
        observed="$blob"
      else
        observed="absent"
      fi
      if [[ "$observed" == "$want" ]]; then status="satisfied"; else status="unsatisfied"; fi
      ;;
    jq)
      if ! node_json="$(node_json_at_main "$id")"; then
        echo "verify-landed: could not read $id at origin/main (readNodeAtRef failed) — the outcome is undetermined" >&2
        status="unknown"
      else
        # `jq -e`: 0 the filter produced a truthy value, 1 false/null, anything
        # else (5) is a jq error — an error is `unknown`, not a false.
        # Here-string, never `echo "$node_json" | jq` (.claude/rules/shell-json.md).
        jq_out="$(jq -e "$want" <<<"$node_json" 2>/dev/null)"; jq_rc=$?
        observed="$jq_out"
        case "$jq_rc" in
          0) status="satisfied" ;;
          1) status="unsatisfied"; observed="${jq_out:-false}" ;;
          *) echo "verify-landed: jq filter '$want' failed on $id — the outcome is undetermined" >&2
             status="unknown"; observed="" ;;
        esac
      fi
      ;;
  esac

  STATUSES+=("$status")
  OBSERVED+=("$observed")
  echo "verify-landed: $id mode=$mode status=$status expected=$want observed=${observed:-unknown}"
  [[ "$status" == "unknown" ]] && ANY_UNKNOWN=1
  [[ "$status" == "unsatisfied" ]] && ANY_UNSATISFIED=1
done

if [[ $ANY_UNKNOWN -eq 1 ]]; then
  report unknown "$MAIN_SHA"
elif [[ $ANY_UNSATISFIED -eq 1 ]]; then
  report not-landed "$MAIN_SHA"
fi
report landed "$MAIN_SHA"
